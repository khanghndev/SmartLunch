{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Sinks.MySQL"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/smartlunch-backend-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MySQL",
        "Args": {
          "connectionString": "Server=localhost;Port=3307;Database=SmartLunch;User=root;Password=DevMySQLRoot@SmartLunch2026;",
          "tableName": "system_logs"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SmartLunch-Backend-Service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartLunchDatabase": "Server=localhost;Port=3307;Database=SmartLunch;User=root;Password=DevMySQLRoot@SmartLunch2026;"
  },
  "Database": {
    "ConnectionString": "",
    "AutoMigrate": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 30,
    "EnableQuerySplitting": true,
    "PoolSize": 128,
    "EnableHealthChecks": true,
    "HealthCheckInterval": 5
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyForJWTTokenGenerationMustBeAtLeast32CharactersLong",
    "Issuer": "SmartLunch-API",
    "Audience": "SmartLunch-Users",
    "TokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "QueueName": "smartlunch.backend"
  },
  "Redis": {
    "Configuration": "localhost:6379,password=DevRedis@SmartLunch2026,abortConnect=false",
    "InstanceName": "smartlunch:"
  },
  "Firebase": {
    "ConfigPath": "smartlunch-2b5a7-firebase-adminsdk-fbsvc-93e6045e22.json",
    "ProjectId": "smartlunch-2b5a7",
    "StorageBucket": ""
  },
  "Appwrite": {
    "Endpoint": "https://syd.cloud.appwrite.io/v1",
    "ProjectId": "69bab7660023ca1dd830",
    "BucketId": "69bfa6de000fdacda87d",
    "ApiKey": "standard_0b339e8363452bfa4f19b257b466f629cc81806d0e60758f3e47e97eaa2934330811c8fd1451896ce231516677f2af546d6925679ef58ef15c19c6854d711c6fc8f9f9fac053c38ae678e01a58d7eeae5f5275c06987490198fc67853f667afc1ea3fb1f8fe7a550c4f836a7135239ab2c6ed7c0f6d909a7879ec0c24dbbc928"
  },
  "CartCache": {
    "KeyPrefix": "cart",
    "TtlDays": 30
  },
  "RateLimiting": {
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 0,
    "MediaUploadPermitLimit": 20,
    "MediaUploadWindowSeconds": 60
  },
  "DatabaseBackup": {
    "Enabled": false,
    "Cron": "0 0 2 * * *",
    "OutputDirectory": "Backups",
    "FilePrefix": "smartlunch",
    "FileExtension": "sql",
    "RetentionDays": 7,
    "ToolsDirectory": "",
    "UseDocker": true,
    "DockerContainerName": "smart-lunch-mysql"
  },
  "Media": {
    "SignedUrlExpireMinutes": 10,
    "DownloadUrlExpireMinutes": 15,
    "MaxImageBytes": 10485760,
    "MaxVideoBytes": 209715200
  },
  "PayOS": {
    "Enabled": false,
    "BaseUrl": "https://api-merchant.payos.vn",
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "PartnerCode": "",
    "DefaultReturnUrl": "https://localhost:3000/finance/payment/success",
    "DefaultCancelUrl": "https://localhost:3000/finance/payment/cancel"
  }
}
