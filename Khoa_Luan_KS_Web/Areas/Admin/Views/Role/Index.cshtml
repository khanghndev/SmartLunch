@{
    ViewData["Title"] = "Phân quyền (Roles & Permissions)";
    Layout = "_LayoutAdmin";

    var allRoles = ViewBag.Roles as List<Khoa_Luan_KS_Web.Services.RoleDto> ?? new();
    var allPermissions = ViewBag.Permissions as List<Khoa_Luan_KS_Web.Services.PermissionDto> ?? new();

    // Group permissions into modules
    var modules = new Dictionary<string, string[]>
    {
        { "Hệ thống", new[] { "users", "roles", "permissions", "user_roles", "user_permissions", "role_permissions", "user_tokens", "media_files", "systems" } },
        { "Tổ chức & Đối tác", new[] { "organizations", "user_organizations", "partners", "contracts", "partner_payments" } },
        { "Kho & Nguyên liệu", new[] { "ingredients", "ingredient_sources", "inventory", "internal_stock_issues", "internal_stock_issue_lines", "ingredient_intake_proposals", "ingredient_intake_proposal_lines", "ingredient_actual_intakes", "ingredient_actual_intake_lines" } },
        { "Thực đơn & Món ăn", new[] { "dishes", "dish_ingredients", "weekly_menus", "menu_schedule", "menu_suggestions" } },
        { "Kinh doanh & Đơn hàng", new[] { "orders", "order_items", "deliveries", "payments", "transactions" } },
        { "Chăm sóc Khách hàng", new[] { "reviews", "sentiments", "complaints", "chatbot_logs" } }
    };

    // Find all unique actions to build columns
    var allActions = allPermissions.Select(p => p.Action).Distinct().OrderBy(a => a == "list" ? 1 : a == "read" ? 2 : a == "create" ? 3 : a == "update" ? 4 : a == "delete" ? 5 : 6).ToList();
}

<div class="space-y-6" x-data="roleManager()">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý Phân quyền (Roles)</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Thiết lập quyền truy cập cho từng nhóm người dùng trong hệ thống.</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="px-5 py-2.5 admin-gradient text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:shadow-green-600/50 transition-all text-sm flex items-center gap-2">
                <i class="fas fa-plus"></i> Tạo Role Mới
            </button>
        </div>
    </div>

    <!-- Main Content Split -->
    <div class="flex flex-col lg:flex-row gap-6">
        
        <!-- Left: Roles List -->
        <div class="w-full lg:w-1/3 flex flex-col gap-4">
            <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm overflow-hidden flex flex-col h-[calc(100vh-200px)]">
                <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <h2 class="font-black text-lg text-slate-800">Danh sách Roles</h2>
                    <span class="bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded-lg">@allRoles.Count Roles</span>
                </div>
                
                <div class="p-3 border-b border-slate-100">
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" x-model="searchRole" placeholder="Tìm Role..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-sm font-medium outline-none focus:border-green-500 transition-colors" />
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto custom-scrollbar p-2">
                    <template x-for="role in filteredRoles" :key="role.id">
                        <div @@click="selectRole(role)" 
                             class="p-4 rounded-xl cursor-pointer transition-all border mb-2 group"
                             :class="selectedRole && selectedRole.id === role.id ? 'bg-green-50 border-green-200 shadow-sm' : 'bg-white border-transparent hover:bg-slate-50 hover:border-slate-200'">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 transition-colors"
                                         :class="selectedRole && selectedRole.id === role.id ? 'bg-green-500 text-white shadow-md shadow-green-500/30' : 'bg-slate-100 text-slate-500 group-hover:bg-white group-hover:text-green-600'">
                                        <i class="fas" :class="role.isSystemRole ? 'fa-shield-alt' : 'fa-users'"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-sm transition-colors"
                                            :class="selectedRole && selectedRole.id === role.id ? 'text-green-800' : 'text-slate-700 group-hover:text-green-600'" 
                                            x-text="role.name"></h3>
                                        <p class="text-xs text-slate-500 mt-0.5 line-clamp-1" x-text="role.description || 'Không có mô tả'"></p>
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right text-xs transition-transform"
                                   :class="selectedRole && selectedRole.id === role.id ? 'text-green-500 translate-x-1' : 'text-slate-300 opacity-0 group-hover:opacity-100'"></i>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <!-- Right: Permission Matrix -->
        <div class="w-full lg:w-2/3">
            <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm overflow-hidden flex flex-col h-[calc(100vh-200px)] relative">
                
                <!-- Loading Overlay -->
                <div x-show="isLoading" class="absolute inset-0 bg-white/80 backdrop-blur-sm z-20 flex flex-col items-center justify-center" style="display:none;">
                    <div class="w-12 h-12 border-4 border-slate-200 border-t-green-500 rounded-full animate-spin mb-3"></div>
                    <p class="text-sm font-bold text-slate-500">Đang tải phân quyền...</p>
                </div>

                <div x-show="!selectedRole" class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-slate-50/50">
                    <div class="w-20 h-20 bg-white rounded-full shadow-sm flex items-center justify-center text-slate-300 text-4xl mb-4">
                        <i class="fas fa-hand-pointer"></i>
                    </div>
                    <h3 class="text-lg font-black text-slate-700">Chưa chọn Role</h3>
                    <p class="text-sm text-slate-500 mt-1">Vui lòng chọn một Role bên trái để xem và cấu hình phân quyền.</p>
                </div>

                <!-- Detail Header -->
                <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center" x-show="selectedRole" style="display:none;">
                    <div>
                        <h2 class="font-black text-xl text-slate-800 flex items-center gap-2">
                            Chi tiết quyền: <span class="text-green-600" x-text="selectedRole ? selectedRole.name : ''"></span>
                            <span x-show="selectedRole && selectedRole.isSystemRole" class="px-2 py-0.5 bg-slate-800 text-white text-[10px] uppercase tracking-widest rounded shadow-sm relative -top-0.5">System</span>
                        </h2>
                    </div>
                </div>

                <!-- Tabs -->
                <div class="px-5 pt-3 border-b border-slate-200 bg-white overflow-x-auto custom-scrollbar" x-show="selectedRole" style="display:none;">
                    <div class="flex gap-6 min-w-max">
                        @foreach (var module in modules.Keys)
                        {
                            <button @@click="activeTab = '@module'"
                                    class="pb-3 text-sm font-bold border-b-2 transition-all"
                                    :class="activeTab === '@module' ? 'border-green-500 text-green-600' : 'border-transparent text-slate-500 hover:text-slate-800'">
                                @module
                            </button>
                        }
                    </div>
                </div>

                <!-- Matrix Content -->
                <div class="flex-1 overflow-y-auto bg-slate-50/30 relative" x-show="selectedRole" style="display:none;">
                    @foreach (var module in modules)
                    {
                        var moduleResources = module.Value;
                        
                        <div x-show="activeTab === '@module.Key'" class="p-0 animate-[fadeIn_0.3s_ease-out]">
                            <table class="w-full text-left border-collapse">
                                <thead class="sticky top-0 bg-white shadow-sm z-10 outline outline-1 outline-slate-200">
                                    <tr class="text-[11px] uppercase tracking-widest text-slate-500 font-black">
                                        <th class="p-4 pl-6 border-r border-slate-100 bg-slate-50">Resource (Tài nguyên)</th>
                                        @foreach (var action in allActions)
                                        {
                                            <th class="p-4 text-center min-w-[80px]">
                                                <div class="flex flex-col items-center gap-1">
                                                    @{
                                                        var icon = action switch {
                                                            "read" => "fa-eye text-blue-500",
                                                            "create" => "fa-plus-circle text-green-500",
                                                            "update" => "fa-edit text-orange-500",
                                                            "delete" => "fa-trash text-red-500",
                                                            "list" => "fa-list text-purple-500",
                                                            _ => "fa-cog text-slate-400"
                                                        };
                                                    }
                                                    <i class="fas @icon"></i>
                                                    @action
                                                </div>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 text-sm bg-white">
                                    @foreach (var resource in moduleResources)
                                    {
                                        <tr class="hover:bg-slate-50/80 transition-colors group">
                                            <td class="p-4 pl-6 border-r border-slate-100 font-bold text-slate-700 bg-slate-50/30 group-hover:bg-slate-100/50">
                                                @resource
                                            </td>
                                            @foreach (var action in allActions)
                                            {
                                                var permission = allPermissions.FirstOrDefault(p => p.Resource == resource && p.Action == action);
                                                <td class="p-4 text-center">
                                                    @if (permission != null)
                                                    {
                                                        <label class="relative inline-flex items-center cursor-pointer">
                                                            <input type="checkbox" class="sr-only peer" 
                                                                   :checked="hasPermission(@permission.Id)"
                                                                   @@change="togglePermission(@permission.Id, $event.target.checked)"
                                                                   :disabled="selectedRole.isSystemRole">
                                                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500"
                                                                 :class="selectedRole.isSystemRole ? 'opacity-50 cursor-not-allowed' : ''"></div>
                                                        </label>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-slate-200"><i class="fas fa-minus"></i></span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                
                <div class="p-4 border-t border-slate-200 bg-yellow-50 flex items-center gap-3 text-sm text-yellow-800" x-show="selectedRole && selectedRole.isSystemRole" style="display:none;">
                    <i class="fas fa-lock text-yellow-600"></i>
                    <strong>Role Hệ thống:</strong> Bạn không thể thay đổi quyền của Role này.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('roleManager', () => ({
                roles: @Html.Raw(Json.Serialize(allRoles.Select(r => new { r.Id, r.Name, r.Description, r.IsSystemRole }))),
                searchRole: '',
                selectedRole: null,
                activeTab: '@modules.Keys.First()',
                isLoading: false,
                rolePermissions: [], // array of permission IDs

                get filteredRoles() {
                    if (!this.searchRole) return this.roles;
                    const query = this.searchRole.toLowerCase();
                    return this.roles.filter(r => r.name.toLowerCase().includes(query));
                },

                async selectRole(role) {
                    this.selectedRole = role;
                    this.isLoading = true;
                    try {
                        const res = await fetch(`/Admin/Role/GetRolePermissions?roleId=${role.id}`);
                        const data = await res.json();
                        if (data.success) {
                            this.rolePermissions = data.permissionIds;
                        } else {
                            toastr.error('Lỗi tải quyền: ' + data.message);
                        }
                    } catch (e) {
                        toastr.error('Không thể kết nối đến server.');
                    } finally {
                        this.isLoading = false;
                    }
                },

                hasPermission(permissionId) {
                    return this.rolePermissions.includes(permissionId);
                },

                async togglePermission(permissionId, isGranted) {
                    if (!this.selectedRole) return;
                    
                    // Optimistic update
                    if (isGranted) {
                        this.rolePermissions.push(permissionId);
                    } else {
                        this.rolePermissions = this.rolePermissions.filter(id => id !== permissionId);
                    }

                    try {
                        const res = await fetch('/Admin/Role/TogglePermission', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                roleId: this.selectedRole.id,
                                permissionId: permissionId,
                                grant: isGranted
                            })
                        });
                        const data = await res.json();
                        if (!data.success) {
                            throw new Error(data.message);
                        }
                        toastr.success(isGranted ? 'Đã cấp quyền thành công.' : 'Đã thu hồi quyền thành công.');
                    } catch (e) {
                        // Revert optimistic update
                        if (!isGranted) {
                            this.rolePermissions.push(permissionId);
                        } else {
                            this.rolePermissions = this.rolePermissions.filter(id => id !== permissionId);
                        }
                        toastr.error('Lỗi lưu quyền: ' + e.message);
                        
                        // Force alpine to re-evaluate the checkbox checked state
                        this.rolePermissions = [...this.rolePermissions];
                    }
                }
            }));
        });
    </script>
}
