@model Khoa_Luan_KS_Web.Areas.Admin.Models.RolePermissionIndexViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    ViewData["Title"] = "Phân quyền (Roles & Permissions)";
    Layout = "_LayoutAdmin";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
    };

    var rolesJson = JsonSerializer.Serialize(Model.Roles, jsonOptions);
    var modulesJson = JsonSerializer.Serialize(Model.Modules, jsonOptions);
    var actionsJson = JsonSerializer.Serialize(Model.Actions, jsonOptions);
    var permissionMapJson = JsonSerializer.Serialize(Model.PermissionMap, jsonOptions);
    var firstModule = Model.Modules.FirstOrDefault()?.Name ?? "";
}

<div class="space-y-6" x-data="roleManager()" x-cloak>
    <div x-show="toast.show" x-transition
         class="fixed bottom-6 right-6 z-50 max-w-sm rounded-2xl border px-4 py-3 shadow-xl flex items-start gap-3"
         :class="toast.type === 'success' ? 'bg-white border-green-200 text-green-800' : 'bg-white border-red-200 text-red-800'">
        <i class="fas mt-0.5" :class="toast.type === 'success' ? 'fa-check-circle text-green-500' : 'fa-exclamation-circle text-red-500'"></i>
        <p class="text-sm font-semibold leading-snug" x-text="toast.message"></p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
            <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["Error"]
        </div>
    }

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý phân quyền</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Gán quyền API (resource × action) cho từng vai trò trong hệ thống.</p>
        </div>
        <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
            <span class="px-3 py-1.5 rounded-lg bg-slate-100">@Model.Roles.Count vai trò</span>
            <span class="px-3 py-1.5 rounded-lg bg-green-100 text-green-700">@Model.PermissionMap.Count tài nguyên</span>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
        <div class="w-full lg:w-1/3">
            <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm overflow-hidden flex flex-col h-[calc(100vh-200px)]">
                <div class="p-5 border-b border-slate-100 bg-slate-50/50">
                    <h2 class="font-black text-lg text-slate-800">Danh sách vai trò</h2>
                </div>
                <div class="p-3 border-b border-slate-100">
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" x-model="searchRole" placeholder="Tìm vai trò..."
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-sm font-medium outline-none focus:border-green-500" />
                    </div>
                </div>
                <div class="flex-1 overflow-y-auto custom-scrollbar p-2">
                    <template x-if="filteredRoles.length === 0">
                        <p class="text-center text-sm text-slate-400 py-8">Không có vai trò phù hợp.</p>
                    </template>
                    <template x-for="role in filteredRoles" :key="role.id">
                        <button type="button" @@click="selectRole(role)"
                                class="w-full text-left p-4 rounded-xl transition-all border mb-2"
                                :class="selectedRole?.id === role.id ? 'bg-green-50 border-green-200 shadow-sm' : 'bg-white border-transparent hover:bg-slate-50 hover:border-slate-200'">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                                         :class="selectedRole?.id === role.id ? 'bg-green-500 text-white' : 'bg-slate-100 text-slate-500'">
                                        <i class="fas" :class="role.isSystemRole ? 'fa-shield-alt' : 'fa-users'"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2">
                                            <h3 class="font-bold text-sm truncate" x-text="role.name"></h3>
                                            <span x-show="!role.isActive" class="text-[10px] px-1.5 py-0.5 rounded bg-red-100 text-red-600 font-bold">OFF</span>
                                        </div>
                                        <p class="text-xs text-slate-500 mt-0.5 line-clamp-1" x-text="role.description || 'Không có mô tả'"></p>
                                    </div>
                                </div>
                                <span class="text-[10px] font-black text-slate-400 shrink-0" x-show="selectedRole?.id === role.id"
                                      x-text="rolePermissionCount + ' quyền'"></span>
                            </div>
                        </button>
                    </template>
                </div>
            </div>
        </div>

        <div class="w-full lg:w-2/3">
            <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm overflow-hidden flex flex-col h-[calc(100vh-200px)] relative">
                <div x-show="isLoading" class="absolute inset-0 bg-white/80 backdrop-blur-sm z-20 flex flex-col items-center justify-center">
                    <div class="w-12 h-12 border-4 border-slate-200 border-t-green-500 rounded-full animate-spin mb-3"></div>
                    <p class="text-sm font-bold text-slate-500">Đang tải phân quyền...</p>
                </div>

                <template x-if="!selectedRole">
                    <div class="flex-1 flex flex-col items-center justify-center bg-slate-50/50 p-8 text-center">
                        <div class="w-20 h-20 bg-white rounded-full shadow-sm flex items-center justify-center text-slate-300 text-4xl mb-4">
                            <i class="fas fa-hand-pointer"></i>
                        </div>
                        <h3 class="text-lg font-black text-slate-700">Chọn một vai trò</h3>
                        <p class="text-sm text-slate-500 mt-1 max-w-xs">Chọn vai trò bên trái để xem và bật/tắt quyền.</p>
                    </div>
                </template>

                <template x-if="selectedRole">
                    <div class="flex flex-col flex-1 min-h-0">
                        <div class="p-5 border-b border-slate-100 bg-slate-50/50">
                            <h2 class="font-black text-xl text-slate-800 flex flex-wrap items-center gap-2">
                                <span>Quyền của</span>
                                <span class="text-green-600" x-text="selectedRole.name"></span>
                                <span x-show="selectedRole.isSystemRole"
                                      class="px-2 py-0.5 bg-slate-800 text-white text-[10px] uppercase tracking-widest rounded">Vai trò hệ thống</span>
                            </h2>
                            <p class="text-xs text-slate-500 mt-1 font-medium">Bật/tắt từng ô để gán hoặc thu hồi quyền.</p>
                        </div>

                        <div class="px-5 pt-3 border-b border-slate-200 bg-white overflow-x-auto custom-scrollbar shrink-0">
                            <div class="flex gap-4 min-w-max">
                                <template x-for="mod in modules" :key="mod.name">
                                    <button type="button" @@click="activeTab = mod.name"
                                            class="pb-3 text-sm font-bold border-b-2 transition-all whitespace-nowrap"
                                            :class="activeTab === mod.name ? 'border-green-500 text-green-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                            x-text="mod.name"></button>
                                </template>
                            </div>
                        </div>

                        <div class="flex-1 overflow-y-auto bg-slate-50/30 min-h-0">
                            <template x-for="mod in modules" :key="'panel-' + mod.name">
                                <div x-show="activeTab === mod.name" class="p-0">
                                    <table class="w-full text-left border-collapse">
                                        <thead class="sticky top-0 bg-white shadow-sm z-10 outline outline-1 outline-slate-200">
                                            <tr class="text-[11px] uppercase tracking-widest text-slate-500 font-black">
                                                <th class="p-4 pl-6 border-r border-slate-100 bg-slate-50 min-w-[200px]">Resource</th>
                                                <template x-for="action in actions" :key="action">
                                                    <th class="p-3 text-center min-w-[72px]" x-text="action"></th>
                                                </template>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 text-sm bg-white">
                                            <template x-for="resource in mod.resources" :key="resource">
                                                <tr class="hover:bg-slate-50/80">
                                                    <td class="p-3 pl-6 border-r border-slate-100 font-bold text-slate-700 bg-slate-50/30 text-xs" x-text="resource"></td>
                                                    <template x-for="action in actions" :key="resource + '-' + action">
                                                        <td class="p-2 text-center">
                                                            <template x-if="getPermissionId(resource, action)">
                                                                <label class="relative inline-flex items-center cursor-pointer"
                                                                       :class="isSaving ? 'pointer-events-none opacity-60' : ''">
                                                                    <input type="checkbox" class="sr-only peer"
                                                                           :checked="hasPermission(getPermissionId(resource, action))"
                                                                           @@change="togglePermission(getPermissionId(resource, action), $event.target.checked)" />
                                                                    <div class="w-10 h-5 bg-slate-200 rounded-full peer peer-checked:bg-green-500
                                                                         after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                                                                         after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all
                                                                         peer-checked:after:translate-x-5"></div>
                                                                </label>
                                                            </template>
                                                            <template x-if="!getPermissionId(resource, action)">
                                                                <span class="text-slate-200 text-xs">—</span>
                                                            </template>
                                                        </td>
                                                    </template>
                                                </tr>
                                            </template>
                                        </tbody>
                                    </table>
                                </div>
                            </template>
                        </div>

                        <div class="p-3 border-t border-slate-200 bg-slate-50 text-xs text-slate-600 flex items-center gap-2 shrink-0">
                            <i class="fas fa-info-circle text-green-600"></i>
                            <span>Vai trò hệ thống không thể xóa, nhưng vẫn chỉnh sửa được quyền gán.</span>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('roleManager', () => ({
                roles: @Html.Raw(rolesJson),
                modules: @Html.Raw(modulesJson),
                actions: @Html.Raw(actionsJson),
                permissionMap: @Html.Raw(permissionMapJson),
                searchRole: '',
                selectedRole: null,
                activeTab: @Html.Raw(JsonSerializer.Serialize(firstModule, jsonOptions)),
                isLoading: false,
                isSaving: false,
                rolePermissions: [],
                toast: { show: false, message: '', type: 'success' },

                get filteredRoles() {
                    const q = (this.searchRole || '').trim().toLowerCase();
                    if (!q) return this.roles;
                    return this.roles.filter(r =>
                        (r.name || '').toLowerCase().includes(q) ||
                        (r.description || '').toLowerCase().includes(q));
                },

                get rolePermissionCount() {
                    return this.rolePermissions.length;
                },

                getPermissionId(resource, action) {
                    const res = this.permissionMap[resource];
                    if (!res) return null;
                    const id = res[action];
                    return id ? Number(id) : null;
                },

                hasPermission(permissionId) {
                    const pid = Number(permissionId);
                    return this.rolePermissions.some(id => Number(id) === pid);
                },

                showToast(message, type = 'success') {
                    this.toast = { show: true, message, type };
                    clearTimeout(this._toastTimer);
                    this._toastTimer = setTimeout(() => { this.toast.show = false; }, 3200);
                },

                async selectRole(role) {
                    this.selectedRole = role;
                    this.isLoading = true;
                    this.rolePermissions = [];
                    try {
                        const res = await fetch(`/Admin/Role/GetRolePermissions?roleId=${role.id}`);
                        const data = await res.json();
                        if (data.success) {
                            this.rolePermissions = (data.permissionIds || []).map(id => Number(id));
                        } else {
                            this.showToast(data.message || 'Không tải được quyền.', 'error');
                        }
                    } catch {
                        this.showToast('Không kết nối được máy chủ.', 'error');
                    } finally {
                        this.isLoading = false;
                    }
                },

                async togglePermission(permissionId, isGranted) {
                    if (!this.selectedRole || this.isSaving) return;
                    const pid = Number(permissionId);
                    const prev = [...this.rolePermissions];

                    if (isGranted) {
                        if (!this.hasPermission(pid)) this.rolePermissions.push(pid);
                    } else {
                        this.rolePermissions = this.rolePermissions.filter(id => Number(id) !== pid);
                    }

                    this.isSaving = true;
                    try {
                        const res = await fetch('/Admin/Role/TogglePermission', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                roleId: this.selectedRole.id,
                                permissionId: pid,
                                grant: isGranted
                            })
                        });
                        const data = await res.json();
                        if (!data.success) throw new Error(data.message || 'Lưu thất bại');
                        this.showToast(data.message || (isGranted ? 'Đã cấp quyền.' : 'Đã thu hồi quyền.'), 'success');
                    } catch (e) {
                        this.rolePermissions = prev;
                        this.showToast(e.message || 'Lỗi lưu quyền.', 'error');
                    } finally {
                        this.isSaving = false;
                    }
                }
            }));
        });
    </script>
}
