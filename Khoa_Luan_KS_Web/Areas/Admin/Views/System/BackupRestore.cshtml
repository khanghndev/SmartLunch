@model Khoa_Luan_KS_Web.Services.GetSystemBackupsResponse
@{
    ViewData["Title"] = "Backup & Restore";
    Layout = "_LayoutAdmin";
}

<div class="space-y-8" x-data="backupManager()">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Backup & Disaster Recovery</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Quản lý các bản sao lưu Database, đồng bộ Cloud Storage và Khôi phục dữ liệu hệ thống.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <form method="post" action="/Admin/System/CreateBackup">
                <button type="submit" class="px-5 py-2.5 admin-gradient text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:shadow-green-600/50 transition-all text-sm flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Tạo Bản Sao lưu mới ngay
                </button>
            </form>
        </div>
    </div>

    <!-- Status Overview -->
    <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm overflow-hidden relative">
        <div class="absolute inset-0 bg-gradient-to-r from-green-50/50 to-transparent pointer-events-none"></div>
        <div class="p-6 md:p-8 flex flex-col md:flex-row items-center gap-8 relative z-10">
            <div class="w-32 h-32 rounded-full border-8 border-green-100 flex items-center justify-center shrink-0 relative">
                <div class="absolute inset-0 rounded-full border-8 border-green-500 border-t-transparent animate-[spin_3s_linear_infinite]"></div>
                <i class="fas fa-cloud-upload-alt text-4xl text-green-600 relative z-10"></i>
            </div>
            
            <div class="flex-1 space-y-4 text-center md:text-left">
                <div>
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-100 text-green-700 text-[10px] font-black uppercase tracking-widest rounded-lg border border-green-200 mb-2">
                        <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div> Auto-Sync Active
                    </div>
                    <h2 class="text-2xl font-black text-slate-800">Bảo vệ dữ liệu đang hoạt động tốt</h2>
                    <p class="text-sm font-medium text-slate-500 mt-1">Hệ thống đang tự động sao lưu Database (SQL Server) và File Uploads (Assets) lên Amazon S3 mỗi 12 giờ.</p>
                </div>
                
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-slate-200">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Bản Backup cuối</p>
                        <p class="text-sm font-black text-slate-800">Hôm nay, 03:00 AM</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Tổng kích thước</p>
                        <p class="text-sm font-black text-slate-800">45.2 GB</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Điểm sao lưu</p>
                        <p class="text-sm font-black text-slate-800">AWS S3 (ap-southeast-1)</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Chu kỳ tiếp theo</p>
                        <p class="text-sm font-black text-green-600">Trong 5 giờ tới</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Backup History Table -->
    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 class="font-black text-lg text-slate-800">Lịch sử Sao lưu (Backup Points)</h3>
            <div class="flex gap-2">
                <span class="px-3 py-1 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-600 shadow-sm">Lưu trữ: 30 ngày gần nhất</span>
            </div>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-widest text-slate-400 font-black">
                        <th class="p-5 pl-6">Phiên bản / Mã Hash</th>
                        <th class="p-5">Loại Backup</th>
                        <th class="p-5 text-right">Kích thước</th>
                        <th class="p-5">Thời điểm tạo</th>
                        <th class="p-5">Trạng thái</th>
                        <th class="p-5 pr-6 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 text-sm">
                    <template x-for="item in backups" :key="item.id">
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="p-5 pl-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-green-50 text-green-600 flex items-center justify-center shrink-0 border border-green-100">
                                        <i class="fas fa-file-archive text-lg"></i>
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800" x-text="item.filename"></div>
                                        <div class="text-[11px] font-medium text-slate-400 font-mono mt-0.5" x-text="'MD5: ' + item.hash"></div>
                                    </div>
                                </div>
                            </td>
                            
                            <td class="p-5">
                                <span class="px-2 py-1 text-[10px] font-bold rounded uppercase tracking-wider" 
                                      :class="item.type === 'Tự động' ? 'bg-slate-100 text-slate-600' : 'bg-blue-100 text-blue-700'" 
                                      x-text="item.type"></span>
                            </td>
                            
                            <td class="p-5 text-right font-bold text-slate-700" x-text="item.size"></td>
                            
                            <td class="p-5">
                                <div class="font-medium text-slate-800" x-text="item.date"></div>
                                <div class="text-[10px] font-medium text-slate-400" x-text="item.time"></div>
                            </td>
                            
                            <td class="p-5">
                                <div class="flex items-center gap-1.5">
                                    <i class="fas fa-check-circle text-green-500 text-xs"></i>
                                    <span class="font-bold text-slate-700 text-xs">Thành công</span>
                                </div>
                            </td>
                            
                            <td class="p-5 pr-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <form method="post" action="/Admin/System/DeleteBackup" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản sao lưu này?');">
                                        <input type="hidden" name="id" :value="item.id" />
                                        <input type="hidden" name="deleteFile" value="true" />
                                        <button type="submit" class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-500 font-bold hover:text-red-600 hover:border-red-300 hover:bg-red-50 transition-all text-xs flex items-center gap-1.5" title="Xóa bản sao lưu">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                    <button @@click="openRestoreModal(item)" class="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 font-bold hover:bg-red-100 transition-all text-xs flex items-center gap-1.5 border border-red-100">
                                        <i class="fas fa-history"></i> Khôi phục
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- MODAL: RESTORE CONFIRMATION -->
    <div x-show="isRestoreModalOpen" style="display: none;" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="isRestoreModalOpen" 
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" 
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm transition-opacity" @@click="closeRestoreModal()"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="isRestoreModalOpen" 
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md border border-red-100" @@click.stop>
                    
                    <div class="px-6 py-6 border-b border-slate-100 text-center relative overflow-hidden">
                        <div class="absolute inset-0 bg-red-50 opacity-50"></div>
                        <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-3 relative z-10 shadow-sm border border-red-200">
                            <i class="fas fa-exclamation-triangle text-2xl"></i>
                        </div>
                        <h3 class="text-xl font-black text-slate-800 relative z-10">Xác nhận Khôi phục Hệ thống</h3>
                        <p class="text-sm text-slate-500 font-medium mt-2 relative z-10">Hành động này sẽ ghi đè toàn bộ Database hiện tại.</p>
                    </div>
                    
                    <div class="p-6 space-y-4">
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-center gap-4">
                            <i class="fas fa-file-archive text-2xl text-green-400"></i>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Điểm khôi phục (Restore Point)</p>
                                <p class="text-sm font-black text-slate-800" x-text="selectedBackup ? selectedBackup.filename : ''"></p>
                                <p class="text-xs text-slate-500 font-medium mt-0.5" x-text="selectedBackup ? selectedBackup.date + ' ' + selectedBackup.time : ''"></p>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Nhập mã xác thực Admin</label>
                            <input type="password" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-red-500 focus:ring-1 focus:ring-red-500 shadow-sm" placeholder="Nhập mật khẩu của bạn để xác nhận..." />
                        </div>
                        
                        <div class="bg-yellow-50 text-yellow-800 text-xs p-3 rounded-xl border border-yellow-200 flex gap-2">
                            <i class="fas fa-info-circle mt-0.5 shrink-0"></i>
                            <p>Hệ thống sẽ bảo trì trong khoảng 5-10 phút trong quá trình Restore. Tất cả người dùng sẽ bị đăng xuất.</p>
                        </div>
                    </div>
                    
                    <form id="restoreForm" method="post" action="/Admin/System/RestoreBackup">
                        <input type="hidden" name="id" :value="selectedBackup ? selectedBackup.id : ''" />
                    <div class="px-6 py-5 bg-slate-50 border-t border-slate-100 flex justify-end gap-3 rounded-b-[32px]">
                        <button type="button" @@click="closeRestoreModal()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-white border border-slate-200 transition-colors text-sm">Hủy bỏ</button>
                        <button type="submit" class="px-6 py-2.5 rounded-xl bg-red-600 text-white font-bold hover:bg-red-700 shadow-lg shadow-red-600/30 transition-all text-sm flex items-center gap-2">
                            <i class="fas fa-exclamation"></i> Tiến hành Khôi phục
                        </button>
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('backupManager', () => ({
                isRestoreModalOpen: false,
                selectedBackup: null,
                
                backups: @Html.Raw(Json.Serialize(Model.Items.Select(b => new {
                    id = b.Id,
                    filename = b.FileName,
                    hash = "N/A",
                    type = "Thủ công",
                    size = (b.SizeBytes / 1024.0 / 1024.0).ToString("0.00") + " MB",
                    date = b.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy"),
                    time = b.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")
                }))),
                
                openRestoreModal(item) {
                    this.selectedBackup = item;
                    this.isRestoreModalOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                
                closeRestoreModal() {
                    this.isRestoreModalOpen = false;
                    document.body.style.overflow = '';
                }
            }));
        });
    </script>
}
