@model Khoa_Luan_KS_Web.Areas.Admin.Models.BackupRestorePageVm
@using System.Globalization
@{
    ViewData["Title"] = "Backup & Restore";
    Layout = "_LayoutAdmin";
    var vi = new CultureInfo("vi-VN");
    string FmtSize(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024.0:0.##} KB"
        : $"{bytes / 1024.0 / 1024.0:0.##} MB";
    string FmtDt(DateTime? dt) => dt.HasValue ? dt.Value.ToString("dd/MM/yyyy HH:mm", vi) : "—";
    var schedule = Model.Schedule;
    var backups = Model.Backups;
    var totalPages = backups.PageSize > 0 ? (int)Math.Ceiling(backups.TotalCount / (double)backups.PageSize) : 1;
    if (totalPages < 1) totalPages = 1;
    var dailyTime = string.IsNullOrWhiteSpace(schedule.TimeOfDay) ? "21:00" : schedule.TimeOfDay;
}

<div class="space-y-8" x-data="backupManager()">
    <div>
        <h1 class="text-3xl font-black text-slate-800 tracking-tight">Backup & Khôi phục</h1>
        <p class="text-slate-500 mt-1 font-medium text-sm">Hai cách sao lưu: <strong>nhấn nút ngay</strong> hoặc <strong>đặt lịch hàng ngày</strong> (chạy đúng một lần vào giờ đã chọn).</p>
    </div>

    <!-- Hai lựa chọn rõ ràng -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 1. Backup thủ công -->
        <div class="bg-white rounded-[24px] border-2 border-blue-100 shadow-sm p-6 md:p-8 flex flex-col">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                    <i class="fas fa-bolt text-xl"></i>
                </div>
                <div>
                    <h2 class="text-lg font-black text-slate-800">1. Sao lưu ngay</h2>
                    <p class="text-xs text-slate-500 font-medium">Tạo bản backup và upload lên Appwrite ngay lập tức</p>
                </div>
            </div>
            <p class="text-sm text-slate-600 flex-1 mb-6">Dùng khi cần snapshot dữ liệu trước khi cập nhật hệ thống hoặc thử nghiệm. Không ảnh hưởng lịch tự động.</p>
            <form method="post" action="/Admin/System/CreateBackup" onsubmit="return confirm('Tạo bản sao lưu database ngay bây giờ?');">
                <button type="submit" class="w-full px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/25 transition-all text-sm flex items-center justify-center gap-2">
                    <i class="fas fa-database"></i>
                    Backup dữ liệu ngay
                </button>
            </form>
        </div>

        <!-- 2. Lịch hàng ngày -->
        <div class="bg-white rounded-[24px] border-2 border-green-100 shadow-sm p-6 md:p-8 flex flex-col">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                    <i class="fas fa-clock text-xl"></i>
                </div>
                <div>
                    <h2 class="text-lg font-black text-slate-800">2. Đặt lịch hàng ngày</h2>
                    <p class="text-xs text-slate-500 font-medium">Hệ thống chỉ chạy backup <strong>một lần</strong> mỗi ngày đúng giờ</p>
                </div>
            </div>
            <form method="post" action="/Admin/System/SaveBackupSchedule" class="space-y-4 flex-1 flex flex-col">
                <input type="hidden" name="scheduleMode" value="Daily" />
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="isEnabled" value="true" class="rounded border-slate-300 text-green-600 focus:ring-green-500"
                           @(schedule.IsEnabled ? "checked" : "") />
                    <span class="text-sm font-bold text-slate-700">Bật sao lưu tự động mỗi ngày</span>
                </label>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Giờ chạy (giờ Việt Nam)</label>
                    <input type="time" name="timeOfDay" value="@dailyTime"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-medium" required />
                    <p class="text-[11px] text-slate-400 mt-1">Ví dụ: 21:00 — backup chỉ chạy lúc 21h tối, không lặp liên tục.</p>
                </div>
                @if (schedule.IsEnabled && schedule.NextRunAt.HasValue)
                {
                    <p class="text-xs text-green-700 bg-green-50 border border-green-100 rounded-lg px-3 py-2">
                        <i class="fas fa-calendar-check mr-1"></i>
                        Lần chạy tiếp theo: <strong>@FmtDt(schedule.NextRunAt)</strong>
                    </p>
                }
                @if (schedule.LastRunAt.HasValue)
                {
                    <p class="text-xs text-slate-500">Lần chạy gần nhất: @FmtDt(schedule.LastRunAt)</p>
                }
                <button type="submit" class="w-full mt-auto py-3 rounded-xl admin-gradient text-white font-bold text-sm shadow-md">
                    <i class="fas fa-save mr-1"></i> Lưu lịch
                </button>
            </form>
        </div>
    </div>

    <!-- Trạng thái -->
    <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm p-6 md:p-8 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-green-50/60 to-transparent pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-green-100 text-green-600 flex items-center justify-center shrink-0 border border-green-200">
                <i class="fas fa-cloud text-2xl"></i>
            </div>
            <div class="flex-1 space-y-3">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest border
                    @(schedule.IsEnabled ? "bg-green-100 text-green-700 border-green-200" : "bg-slate-100 text-slate-500 border-slate-200")">
                    @if (schedule.IsEnabled)
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                        <span>Lịch @dailyTime hàng ngày: Bật</span>
                    }
                    else
                    {
                        <span>Chỉ backup thủ công</span>
                    }
                </div>
                <p class="text-sm text-slate-500">File dump MySQL lưu trên Appwrite dạng <code class="text-xs bg-slate-100 px-1 rounded">.bak</code> (bucket không cho phép .sql).</p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-2 border-t border-slate-100">
                    <div>
                        <p class="text-[10px] font-bold uppercase text-slate-400">Backup gần nhất</p>
                        <p class="text-sm font-black text-slate-800">@FmtDt(schedule.LatestBackupAt)</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold uppercase text-slate-400">Tổng dung lượng</p>
                        <p class="text-sm font-black text-slate-800">@FmtSize(schedule.TotalBackupBytes)</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold uppercase text-slate-400">Số bản lưu</p>
                        <p class="text-sm font-black text-slate-800">@schedule.TotalBackupCount</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold uppercase text-slate-400">Lần chạy tiếp theo</p>
                        <p class="text-sm font-black text-green-600">@(schedule.IsEnabled ? FmtDt(schedule.NextRunAt) : "—")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng backup -->
    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-50/50">
            <h3 class="font-black text-lg text-slate-800">Điểm khôi phục (Backup Points)</h3>
            <form method="get" action="/Admin/System/BackupRestore" class="flex flex-wrap items-end gap-2">
                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase">Từ ngày</label>
                    <input type="date" name="from" value="@(Model.FilterFrom?.ToString("yyyy-MM-dd"))"
                           class="block rounded-lg border border-slate-200 px-2 py-1.5 text-xs" />
                </div>
                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase">Đến ngày</label>
                    <input type="date" name="to" value="@(Model.FilterTo?.ToString("yyyy-MM-dd"))"
                           class="block rounded-lg border border-slate-200 px-2 py-1.5 text-xs" />
                </div>
                <button type="submit" class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50">Lọc</button>
                <a href="/Admin/System/BackupRestore" class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:underline">Xóa lọc</a>
            </form>
        </div>

        @if (!backups.Items.Any())
        {
            <div class="p-12 text-center text-slate-400">
                <i class="fas fa-inbox text-4xl mb-3 opacity-40"></i>
                <p class="font-medium">Chưa có bản sao lưu. Dùng <strong>Backup dữ liệu ngay</strong> hoặc bật lịch hàng ngày.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-widest text-slate-400 font-black">
                            <th class="p-5 pl-6">Tệp / ID</th>
                            <th class="p-5">Nguồn</th>
                            <th class="p-5 text-right">Kích thước</th>
                            <th class="p-5">Thời điểm tạo</th>
                            <th class="p-5">Trạng thái</th>
                            <th class="p-5 pr-6 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 text-sm">
                        <template x-for="item in backups" :key="item.id">
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="p-5 pl-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-green-50 text-green-600 flex items-center justify-center border border-green-100">
                                            <i class="fas fa-file-archive"></i>
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-800" x-text="item.filename"></div>
                                            <div class="text-[11px] text-slate-400 font-mono" x-text="'#' + item.id"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-5">
                                    <span class="px-2 py-1 text-[10px] font-bold rounded uppercase"
                                          :class="item.type === 'Tự động' ? 'bg-slate-100 text-slate-600' : 'bg-blue-100 text-blue-700'"
                                          x-text="item.type"></span>
                                </td>
                                <td class="p-5 text-right font-bold text-slate-700" x-text="item.size"></td>
                                <td class="p-5">
                                    <div class="font-medium text-slate-800" x-text="item.date"></div>
                                    <div class="text-[10px] text-slate-400" x-text="item.time"></div>
                                </td>
                                <td class="p-5">
                                    <span class="text-xs font-bold" :class="item.statusClass" x-text="item.status"></span>
                                </td>
                                <td class="p-5 pr-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a :href="'/Admin/System/DownloadBackup?id=' + item.id"
                                           class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 text-xs"
                                           title="Tải file backup">
                                            <i class="fas fa-download"></i>
                                        </a>
                                        <form method="post" action="/Admin/System/DeleteBackup" style="display:inline;"
                                              onsubmit="return confirm('Xóa bản sao lưu này trên Appwrite?');">
                                            <input type="hidden" name="id" :value="item.id" />
                                            <input type="hidden" name="deleteFile" value="true" />
                                            <button type="submit" class="px-3 py-1.5 rounded-lg border border-slate-200 text-slate-500 hover:text-red-600 text-xs">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                        <button type="button" @@click="openRestoreModal(item)"
                                                class="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 font-bold border border-red-100 hover:bg-red-100 text-xs">
                                            <i class="fas fa-history"></i> Khôi phục
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="p-4 border-t border-slate-100 flex justify-center gap-2">
                    @if (Model.Page > 1)
                    {
                        <a href="/Admin/System/BackupRestore?page=@(Model.Page - 1)@(Model.FilterFrom.HasValue ? $"&from={Model.FilterFrom:yyyy-MM-dd}" : "")@(Model.FilterTo.HasValue ? $"&to={Model.FilterTo:yyyy-MM-dd}" : "")"
                           class="px-4 py-2 rounded-lg border text-sm font-bold text-slate-600">← Trước</a>
                    }
                    <span class="px-4 py-2 text-sm font-medium text-slate-500">Trang @Model.Page / @totalPages</span>
                    @if (Model.Page < totalPages)
                    {
                        <a href="/Admin/System/BackupRestore?page=@(Model.Page + 1)@(Model.FilterFrom.HasValue ? $"&from={Model.FilterFrom:yyyy-MM-dd}" : "")@(Model.FilterTo.HasValue ? $"&to={Model.FilterTo:yyyy-MM-dd}" : "")"
                           class="px-4 py-2 rounded-lg border text-sm font-bold text-slate-600">Sau →</a>
                    }
                </div>
            }
        }
    </div>

    <!-- Modal khôi phục -->
    <div x-show="isRestoreModalOpen" style="display: none;" class="relative z-50" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm" @@click="closeRestoreModal()"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-4">
            <div class="relative w-full max-w-md rounded-[32px] bg-white shadow-2xl border border-red-100" @@click.stop>
                <div class="px-6 py-6 border-b text-center bg-red-50/50">
                    <div class="w-14 h-14 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-2">
                        <i class="fas fa-exclamation-triangle text-xl"></i>
                    </div>
                    <h3 class="text-lg font-black text-slate-800">Khôi phục cơ sở dữ liệu</h3>
                    <p class="text-sm text-slate-500 mt-1">Ghi đè toàn bộ DB hiện tại bằng bản đã chọn.</p>
                </div>
                <div class="p-6">
                    <div class="bg-slate-50 border rounded-xl p-4 mb-4">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Điểm khôi phục</p>
                        <p class="font-black text-slate-800" x-text="selectedBackup?.filename"></p>
                        <p class="text-xs text-slate-500" x-text="selectedBackup ? (selectedBackup.date + ' ' + selectedBackup.time) : ''"></p>
                    </div>
                </div>
                <form method="post" action="/Admin/System/RestoreBackup">
                    <input type="hidden" name="id" :value="selectedBackup?.id ?? ''" />
                    <div class="px-6 py-4 bg-slate-50 border-t flex justify-end gap-2 rounded-b-[32px]">
                        <button type="button" @@click="closeRestoreModal()" class="px-4 py-2 rounded-xl border font-bold text-sm text-slate-600">Hủy</button>
                        <button type="submit" class="px-5 py-2 rounded-xl bg-red-600 text-white font-bold text-sm hover:bg-red-700">Xác nhận khôi phục</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('backupManager', () => ({
                isRestoreModalOpen: false,
                selectedBackup: null,
                backups: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(backups.Items.Select(b => {
                    var local = b.CreatedAtUtc;
                    var typeLabel = string.Equals(b.BackupSource, "Scheduled", StringComparison.OrdinalIgnoreCase) ? "Tự động" : "Thủ công";
                    var status = b.RestoredAtUtc.HasValue ? "Đã khôi phục" : (b.IsDeleted ? "Đã xóa" : "Sẵn sàng");
                    var statusClass = b.RestoredAtUtc.HasValue ? "text-blue-600" : (b.IsDeleted ? "text-slate-400" : "text-green-600");
                    return new {
                        id = b.Id,
                        filename = b.FileName,
                        type = typeLabel,
                        size = b.SizeBytes < 1048576
                            ? $"{b.SizeBytes / 1024.0:0.##} KB"
                            : $"{b.SizeBytes / 1024.0 / 1024.0:0.##} MB",
                        date = local.ToString("dd/MM/yyyy"),
                        time = local.ToString("HH:mm:ss"),
                        status,
                        statusClass
                    };
                }))),

                openRestoreModal(item) {
                    this.selectedBackup = item;
                    this.isRestoreModalOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                closeRestoreModal() {
                    this.isRestoreModalOpen = false;
                    document.body.style.overflow = '';
                }
            }));
        });
    </script>
}
