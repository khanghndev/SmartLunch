@model Khoa_Luan_KS_Web.Services.OrganizationChatbotAdminConfigClientDto
@{
    ViewData["Title"] = "Cấu hình AI Chatbot CSKH";
    Layout = "_LayoutAdmin";
    var loadError = TempData["Error"]?.ToString();
}

<script type="application/json" id="chatbot-ai-config-json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>

<div class="space-y-6" x-data="chatbotAiConfig" x-init="init()">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Cấu hình AI Chatbot CSKH</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">
                Xem cấu hình đang chạy và chỉnh API Key, model, quy tắc cho <strong>HuitMeal Assistant</strong>.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" @@click="reloadConfig()" :disabled="loading"
                    class="px-4 py-2.5 bg-white text-slate-700 font-bold rounded-xl border border-slate-200 hover:bg-slate-50 transition-all text-sm flex items-center gap-2 disabled:opacity-50">
                <i class="fas fa-sync-alt" :class="loading && 'fa-spin'"></i>
                Tải lại
            </button>
            <button type="button" @@click="testConnection()" :disabled="testing"
                    class="px-5 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-xl border border-slate-200 hover:bg-slate-200 transition-all text-sm flex items-center gap-2 disabled:opacity-50">
                <i class="fas fa-plug" :class="testing && 'fa-spin'"></i>
                <span x-text="testing ? 'Đang test...' : 'Test kết nối'"></span>
            </button>
            <button type="button" @@click="saveConfig()" :disabled="saving"
                    class="px-6 py-2.5 admin-gradient text-white font-bold rounded-xl shadow-lg shadow-green-600/30 transition-all text-sm flex items-center gap-2 disabled:opacity-50">
                <i class="fas fa-save"></i>
                <span x-text="saving ? 'Đang lưu...' : 'Lưu cấu hình'"></span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <div class="rounded-xl border border-red-200 bg-red-50 text-red-700 px-4 py-3 text-sm font-medium">@loadError</div>
    }

    <div x-show="loadError" x-cloak class="rounded-xl border border-red-200 bg-red-50 text-red-700 px-4 py-3 text-sm font-medium" x-text="loadError"></div>

    <div x-show="flash" x-cloak class="rounded-xl border px-4 py-3 text-sm font-medium"
         :class="flashOk ? 'border-green-200 bg-green-50 text-green-700' : 'border-amber-200 bg-amber-50 text-amber-800'"
         x-text="flash"></div>

    <!-- Cấu hình đang áp dụng -->
    <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-[24px] p-6 text-white shadow-xl border border-slate-700/50">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
            <div class="flex-1">
                <p class="text-[11px] font-bold uppercase tracking-widest text-green-400 mb-2">Cấu hình đang áp dụng (runtime)</p>
                <h2 class="text-xl font-black mb-4" x-text="llmModeLabel || (loading ? 'Đang tải cấu hình...' : 'Chưa có dữ liệu cấu hình')"></h2>
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
                    <div>
                        <dt class="text-slate-400 text-xs font-bold uppercase">API Key đang dùng</dt>
                        <dd class="font-mono text-green-300 mt-0.5 text-base" x-text="hasApiKey ? apiKeyMasked : '— Chưa cấu hình —'"></dd>
                    </div>
                    <div>
                        <dt class="text-slate-400 text-xs font-bold uppercase">Provider / Model</dt>
                        <dd class="font-bold mt-0.5"><span x-text="provider"></span> · <span x-text="model"></span></dd>
                    </div>
                    <div>
                        <dt class="text-slate-400 text-xs font-bold uppercase">Temperature / Max tokens</dt>
                        <dd class="font-bold mt-0.5"><span x-text="temperature"></span> · <span x-text="maxOutputTokens"></span></dd>
                    </div>
                    <div>
                        <dt class="text-slate-400 text-xs font-bold uppercase">Nguồn lưu cấu hình</dt>
                        <dd class="font-medium mt-0.5 text-slate-300 text-xs" x-text="configSource"></dd>
                    </div>
                    <div>
                        <dt class="text-slate-400 text-xs font-bold uppercase">System prompt</dt>
                        <dd class="font-medium mt-0.5" x-text="useDefaultSystemPrompt ? 'Mặc định hệ thống' : 'Tùy chỉnh admin'"></dd>
                    </div>
                    <div>
                        <dt class="text-slate-400 text-xs font-bold uppercase">Quy tắc bổ sung</dt>
                        <dd class="font-medium mt-0.5" x-text="customRules?.trim() ? 'Có (' + customRules.split('\n').filter(Boolean).length + ' dòng)' : 'Không'"></dd>
                    </div>
                </dl>
            </div>
            <div class="shrink-0 flex flex-col items-start gap-2">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold"
                      :class="{
                        'bg-green-500/20 text-green-300 border border-green-500/30': status === 'online',
                        'bg-amber-500/20 text-amber-200 border border-amber-500/30': status === 'warning',
                        'bg-slate-500/20 text-slate-300 border border-slate-500/30': status === 'disabled' || status === 'offline'
                      }">
                    <span class="w-2 h-2 rounded-full"
                          :class="status === 'online' ? 'bg-green-400 animate-pulse' : status === 'warning' ? 'bg-amber-400' : 'bg-slate-400'"></span>
                    <span x-text="statusLabel"></span>
                </span>
                <p class="text-xs text-slate-400" x-show="updatedAt">Cập nhật: <span x-text="formatDate(updatedAt)"></span></p>
                <p class="text-xs text-slate-400" x-show="lastTestLatencyMs">Test: <span x-text="lastTestLatencyMs + ' ms'"></span></p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="space-y-6">
            <!-- Quy tắc xử lý cố định -->
            <div class="bg-white rounded-[24px] p-6 border border-slate-100 shadow-sm">
                <h3 class="font-black text-lg text-slate-800 mb-1 flex items-center gap-2">
                    <i class="fas fa-list-check text-green-500"></i> Quy tắc xử lý
                </h3>
                <p class="text-xs text-slate-500 mb-4">Pipeline cố định — admin không tắt được.</p>
                <ul class="space-y-3">
                    <template x-for="(rule, i) in processingRules" :key="i">
                        <li class="flex gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                            <i class="fas fa-lock text-slate-400 text-xs mt-1 shrink-0"></i>
                            <div>
                                <p class="text-sm font-bold text-slate-800" x-text="rule.title"></p>
                                <p class="text-xs text-slate-500 mt-0.5 leading-relaxed" x-text="rule.description"></p>
                            </div>
                        </li>
                    </template>
                </ul>
            </div>

            <!-- API Key -->
            <div class="bg-white rounded-[24px] p-6 border border-slate-100 shadow-sm">
                <h3 class="font-black text-lg text-slate-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-key text-green-500"></i> Provider & API Key
                </h3>
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <input type="checkbox" id="enabled" x-model="enabled" class="rounded border-slate-300 text-green-600 focus:ring-green-500">
                        <label for="enabled" class="text-sm font-bold text-slate-700">Bật chatbot AI</label>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Provider</label>
                        <select x-model="provider" class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none focus:border-green-500">
                            <option value="Gemini">Google Gemini</option>
                            <option value="None">Tắt LLM (chỉ rule + DB)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Model</label>
                        <select x-model="model" class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none focus:border-green-500">
                            <option value="gemini-2.5-flash">gemini-2.5-flash (khuyến nghị)</option>
                            <option value="gemini-2.0-flash">gemini-2.0-flash</option>
                            <option value="gemini-2.0-flash-lite">gemini-2.0-flash-lite</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Đổi API Key</label>
                        <div class="relative">
                            <input :type="showKey ? 'text' : 'password'" x-model="apiKeyInput"
                                   :placeholder="hasApiKey ? ('Đang dùng: ' + apiKeyMasked) : 'Dán key từ Google AI Studio'"
                                   class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-mono focus:border-green-500 shadow-sm" />
                            <button type="button" @@click="showKey = !showKey" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-green-600">
                                <i class="fas" :class="showKey ? 'fa-eye-slash' : 'fa-eye'"></i>
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-500 mt-1.5">Để trống khi lưu nếu giữ key hiện tại.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50">
                    <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                        <i class="fas fa-sliders-h text-green-500"></i> Tham số model
                    </h3>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div>
                        <div class="flex justify-between items-end mb-2">
                            <label class="text-sm font-bold text-slate-700">Temperature</label>
                            <span class="text-sm font-black text-green-600" x-text="temperature"></span>
                        </div>
                        <input type="range" min="0" max="1" step="0.05" x-model.number="temperature" class="w-full accent-green-600">
                    </div>
                    <div>
                        <div class="flex justify-between items-end mb-2">
                            <label class="text-sm font-bold text-slate-700">Max output tokens</label>
                            <span class="text-sm font-black text-green-600" x-text="maxOutputTokens"></span>
                        </div>
                        <input type="range" min="256" max="4096" step="128" x-model.number="maxOutputTokens" class="w-full accent-green-600">
                    </div>
                </div>
            </div>

            <!-- Quy tắc bổ sung admin -->
            <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50">
                    <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                        <i class="fas fa-gavel text-green-500"></i> Quy tắc bổ sung (admin)
                    </h3>
                    <p class="text-xs text-slate-500 mt-1">Nối vào cuối system prompt khi gọi Gemini — VD: giọng điệu, cấm nội dung, ưu tiên trả lời thanh toán…</p>
                </div>
                <div class="p-6">
                    <textarea rows="5" x-model="customRules" placeholder="VD:&#10;• Luôn xưng Quý khách.&#10;• Ưu tiên trả lời câu hỏi thanh toán trước.&#10;• Không hướng dẫn đặt món ngoài web HuitMeal."
                              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-green-500 shadow-sm leading-relaxed"></textarea>
                </div>
            </div>

            <!-- System prompt -->
            <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-wrap justify-between items-center gap-3">
                    <div>
                        <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                            <i class="fas fa-terminal text-green-500"></i> System prompt lõi
                        </h3>
                    </div>
                    <div class="flex items-center gap-3">
                        <label class="flex items-center gap-2 text-sm font-bold text-slate-600 cursor-pointer">
                            <input type="checkbox" x-model="useDefaultSystemPrompt" class="rounded text-green-600">
                            Dùng prompt mặc định
                        </label>
                        <button type="button" @@click="resetCorePrompt()" class="text-xs font-bold text-slate-500 hover:text-green-600 px-3 py-1.5 rounded-lg border border-slate-200">
                            Khôi phục mặc định
                        </button>
                    </div>
                </div>
                <div class="p-6 space-y-4">
                    <textarea rows="12" x-model="systemPrompt" :disabled="useDefaultSystemPrompt"
                              :class="useDefaultSystemPrompt ? 'opacity-60 bg-slate-100' : ''"
                              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-mono focus:border-green-500 shadow-sm leading-relaxed disabled:cursor-not-allowed"
                              spellcheck="false"></textarea>
                    <details class="rounded-xl border border-slate-200 bg-slate-50">
                        <summary class="px-4 py-3 text-sm font-bold text-slate-600 cursor-pointer">Xem prompt hiệu lực (gửi Gemini)</summary>
                        <pre class="px-4 pb-4 text-xs font-mono text-slate-600 whitespace-pre-wrap leading-relaxed max-h-64 overflow-y-auto" x-text="effectivePreview"></pre>
                    </details>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function readChatbotAiInitialConfig() {
            try {
                const el = document.getElementById('chatbot-ai-config-json');
                if (!el?.textContent?.trim()) return {};
                return JSON.parse(el.textContent);
            } catch (e) {
                console.error('Parse chatbot config JSON failed', e);
                return {};
            }
        }

        document.addEventListener('alpine:init', () => {
            const boot = readChatbotAiInitialConfig();
            Alpine.data('chatbotAiConfig', () => ({
                enabled: boot.enabled ?? true,
                provider: boot.provider ?? 'Gemini',
                model: boot.model ?? 'gemini-2.5-flash',
                apiKeyInput: '',
                apiKeyMasked: boot.apiKeyMasked ?? '',
                hasApiKey: boot.hasApiKey ?? false,
                temperature: boot.temperature ?? 0.15,
                maxOutputTokens: boot.maxOutputTokens ?? 1024,
                useDefaultSystemPrompt: boot.useDefaultSystemPrompt ?? true,
                systemPrompt: boot.storedSystemPrompt || boot.defaultSystemPrompt || '',
                defaultSystemPrompt: boot.defaultSystemPrompt ?? '',
                customRules: boot.customRules ?? '',
                effectiveSystemPrompt: boot.effectiveSystemPrompt ?? '',
                llmModeLabel: boot.llmModeLabel ?? '',
                configSource: boot.configSource ?? '',
                processingRules: boot.processingRules ?? [],
                status: boot.status ?? 'offline',
                updatedAt: boot.updatedAt ?? null,
                lastTestLatencyMs: boot.lastTestLatencyMs ?? null,
                lastTestMessage: boot.lastTestMessage ?? '',
                showKey: false,
                saving: false,
                testing: false,
                loading: false,
                loadError: @Html.Raw(string.IsNullOrEmpty(loadError) ? "''" : System.Text.Json.JsonSerializer.Serialize(loadError)),
                flash: '',
                flashOk: true,

                async init() {
                    if (this.llmModeLabel || this.processingRules?.length) return;
                    await this.reloadConfig(false);
                },

                async reloadConfig(showFlash = true) {
                    this.loading = true;
                    this.loadError = '';
                    try {
                        const res = await fetch('/Admin/System/GetChatbotAiConfig', { credentials: 'same-origin' });
                        const cfg = await res.json().catch(() => null);
                        if (!res.ok) throw new Error(cfg?.error || 'Không tải được cấu hình từ backend.');
                        this.applyConfig(cfg);
                        if (showFlash) {
                            this.flashOk = true;
                            this.flash = 'Đã tải lại cấu hình.';
                        }
                    } catch (e) {
                        this.loadError = e.message || 'Không tải được cấu hình.';
                    } finally {
                        this.loading = false;
                    }
                },

                get statusLabel() {
                    return ({ online: 'Online', warning: 'Cảnh báo', disabled: 'AI tắt', offline: 'Chưa sẵn sàng' })[this.status] || this.status;
                },

                get effectivePreview() {
                    let core = this.useDefaultSystemPrompt ? this.defaultSystemPrompt : (this.systemPrompt || this.defaultSystemPrompt);
                    if (this.customRules?.trim())
                        return core + '\n\nQUY TẮC BỔ SUNG (admin):\n' + this.customRules.trim();
                    return core;
                },

                applyConfig(cfg) {
                    if (!cfg) return;
                    this.enabled = cfg.enabled;
                    this.provider = cfg.provider;
                    this.model = cfg.model;
                    this.apiKeyMasked = cfg.apiKeyMasked || '';
                    this.hasApiKey = cfg.hasApiKey;
                    this.temperature = cfg.temperature;
                    this.maxOutputTokens = cfg.maxOutputTokens;
                    this.useDefaultSystemPrompt = cfg.useDefaultSystemPrompt;
                    this.systemPrompt = cfg.storedSystemPrompt || cfg.defaultSystemPrompt || this.defaultSystemPrompt;
                    this.defaultSystemPrompt = cfg.defaultSystemPrompt || this.defaultSystemPrompt;
                    this.customRules = cfg.customRules || '';
                    this.effectiveSystemPrompt = cfg.effectiveSystemPrompt || '';
                    this.llmModeLabel = cfg.llmModeLabel || '';
                    this.configSource = cfg.configSource || '';
                    this.processingRules = cfg.processingRules || [];
                    this.status = cfg.status;
                    this.updatedAt = cfg.updatedAt;
                    this.lastTestLatencyMs = cfg.lastTestLatencyMs;
                    this.lastTestMessage = cfg.lastTestMessage || '';
                    this.apiKeyInput = '';
                },

                formatDate(iso) {
                    if (!iso) return '';
                    try { return new Date(iso).toLocaleString('vi-VN'); } catch { return iso; }
                },

                resetCorePrompt() {
                    this.useDefaultSystemPrompt = true;
                    this.systemPrompt = this.defaultSystemPrompt;
                },

                async saveConfig() {
                    this.saving = true;
                    this.flash = '';
                    try {
                        const res = await fetch('/Admin/System/SaveChatbotAiConfig', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'same-origin',
                            body: JSON.stringify({
                                enabled: this.enabled,
                                provider: this.provider,
                                model: this.model,
                                apiKey: this.apiKeyInput.trim() || null,
                                temperature: Number(this.temperature),
                                maxOutputTokens: Number(this.maxOutputTokens),
                                useDefaultSystemPrompt: this.useDefaultSystemPrompt,
                                systemPrompt: this.useDefaultSystemPrompt ? null : this.systemPrompt,
                                customRules: this.customRules?.trim() || null
                            })
                        });
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok) throw new Error(data.error || 'Lưu thất bại');
                        this.applyConfig(data.config);
                        this.flashOk = true;
                        this.flash = data.message || 'Đã lưu — chatbot dùng cấu hình mới ngay.';
                    } catch (e) {
                        this.flashOk = false;
                        this.flash = e.message || 'Lỗi lưu cấu hình.';
                    } finally {
                        this.saving = false;
                    }
                },

                async testConnection() {
                    this.testing = true;
                    this.flash = '';
                    try {
                        const res = await fetch('/Admin/System/TestChatbotAiConnection', {
                            method: 'POST', credentials: 'same-origin',
                            headers: { 'Content-Type': 'application/json' }, body: '{}'
                        });
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok) throw new Error(data.error || 'Test thất bại');
                        this.lastTestLatencyMs = data.latencyMs;
                        this.lastTestMessage = data.message;
                        this.status = data.success ? 'online' : 'warning';
                        this.flashOk = data.success;
                        this.flash = data.message;
                    } catch (e) {
                        this.flashOk = false;
                        this.flash = e.message || 'Test kết nối thất bại.';
                    } finally {
                        this.testing = false;
                    }
                }
            }));
        });
    </script>
}
