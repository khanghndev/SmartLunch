@{
    ViewData["Title"] = "AI Configuration";
    Layout = "_LayoutAdmin";
}

<div class="space-y-8" x-data="aiConfig()">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Cấu hình Hệ thống AI (Core Engine)</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Quản lý API Keys, tham số mô hình và prompt hệ thống cho tính năng "Gợi ý Thực đơn AI".</p>
        </div>
        
        <div class="flex items-center gap-3">
            <button @@click="saveConfig()" class="px-6 py-2.5 admin-gradient text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:shadow-green-600/50 transition-all text-sm flex items-center gap-2">
                <i class="fas fa-save"></i>
                Lưu toàn bộ Cấu hình
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Col: Status & Core Settings -->
        <div class="space-y-6">
            <!-- AI Status Card -->
            <div class="bg-white rounded-[24px] p-6 border border-slate-100 shadow-sm relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-32 h-32 bg-green-50 rounded-full mix-blend-multiply opacity-50"></div>
                <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-blue-50 rounded-full mix-blend-multiply opacity-50"></div>
                
                <div class="relative z-10 flex items-start gap-4">
                    <div class="w-14 h-14 rounded-2xl admin-gradient flex items-center justify-center shadow-lg shadow-green-600/20 shrink-0">
                        <i class="fas fa-brain text-2xl text-white"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-black text-slate-800">Trạng thái Kết nối</h3>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
                            <span class="text-sm font-bold text-green-600">Online & Active</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-2 font-medium">Model hiện tại: <span class="font-bold text-slate-700">gpt-4-turbo</span></p>
                        <p class="text-xs text-slate-500 mt-0.5 font-medium">Độ trễ trung bình: <span class="font-bold text-slate-700">1.2s</span></p>
                    </div>
                </div>
            </div>

            <!-- API Keys Config -->
            <div class="bg-white rounded-[24px] p-6 border border-slate-100 shadow-sm">
                <h3 class="font-black text-lg text-slate-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-key text-green-500"></i> Provider & API Keys
                </h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Nhà cung cấp (Provider)</label>
                        <select class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none focus:border-green-500">
                            <option>OpenAI (ChatGPT)</option>
                            <option>Google (Gemini Pro)</option>
                            <option>Anthropic (Claude 3)</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">API Key (Secret)</label>
                        <div class="relative">
                            <input :type="showKey ? 'text' : 'password'" value="sk-proj-xyz1234567890abcdefghijklmnopqrstuvwxyz" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-mono focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" />
                            <button @@click="showKey = !showKey" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-green-600">
                                <i class="fas" :class="showKey ? 'fa-eye-slash' : 'fa-eye'"></i>
                            </button>
                        </div>
                    </div>
                    
                    <button class="w-full py-2.5 bg-slate-100 text-slate-700 font-bold rounded-xl hover:bg-slate-200 transition-colors text-sm flex justify-center items-center gap-2 border border-slate-200">
                        <i class="fas fa-plug"></i> Test Connection
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Col: Model Parameters & Prompts -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                        <i class="fas fa-sliders-h text-green-500"></i> Model Parameters
                    </h3>
                </div>
                
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <!-- Slider 1 -->
                    <div>
                        <div class="flex justify-between items-end mb-2">
                            <label class="block text-sm font-bold text-slate-700">Temperature (Tính sáng tạo)</label>
                            <span class="text-sm font-black text-green-600" x-text="temperature"></span>
                        </div>
                        <input type="range" min="0" max="1" step="0.1" x-model="temperature" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-green-600">
                        <div class="flex justify-between text-[10px] font-bold text-slate-400 mt-1 uppercase">
                            <span>Chính xác (Logic)</span>
                            <span>Sáng tạo (Random)</span>
                        </div>
                    </div>
                    
                    <!-- Slider 2 -->
                    <div>
                        <div class="flex justify-between items-end mb-2">
                            <label class="block text-sm font-bold text-slate-700">Max Tokens (Độ dài tối đa)</label>
                            <span class="text-sm font-black text-green-600" x-text="maxTokens"></span>
                        </div>
                        <input type="range" min="500" max="4000" step="100" x-model="maxTokens" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-green-600">
                        <div class="flex justify-between text-[10px] font-bold text-slate-400 mt-1 uppercase">
                            <span>500 (Ngắn gọn)</span>
                            <span>4000 (Chi tiết)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                        <i class="fas fa-terminal text-green-500"></i> System Prompts (Hướng dẫn AI)
                    </h3>
                </div>
                
                <div class="p-6 space-y-5">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Ngữ cảnh cốt lõi (Core Context)</label>
                        <textarea rows="3" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-mono text-slate-700 focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm leading-relaxed" spellcheck="false">Bạn là chuyên gia dinh dưỡng và lập kế hoạch thực đơn của HuitMeal. Nhiệm vụ của bạn là tạo ra các thực đơn suất ăn công nghiệp (25,000đ - 35,000đ) đáp ứng đủ calo (700-800 Kcal/suất) và đảm bảo an toàn vệ sinh thực phẩm.</textarea>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Định dạng Output (JSON Schema)</label>
                        <textarea rows="5" class="w-full bg-slate-900 rounded-xl border border-slate-800 px-4 py-3 text-xs font-mono text-green-400 focus:border-green-500 shadow-inner leading-relaxed" spellcheck="false">
{
  "menu_name": "Tên thực đơn",
  "total_calo": 750,
  "dishes": [
    {
      "dish_name": "Gà kho sả ớt",
      "type": "Món mặn",
      "ingredients": ["Gà: 100g", "Sả: 10g"]
    }
  ]
}</textarea>
                        <p class="text-[11px] text-slate-500 mt-2"><i class="fas fa-info-circle mr-1"></i> Bắt buộc AI trả về định dạng JSON này để hệ thống phần mềm có thể tự động đọc và lưu vào Database.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('aiConfig', () => ({
                showKey: false,
                temperature: 0.7,
                maxTokens: 1500,
                
                saveConfig() {
                    alert('Đã lưu cấu hình AI thành công. Hệ thống sẽ áp dụng ngay lập tức cho các truy vấn Gợi ý thực đơn tiếp theo.');
                }
            }));
        });
    </script>
}
