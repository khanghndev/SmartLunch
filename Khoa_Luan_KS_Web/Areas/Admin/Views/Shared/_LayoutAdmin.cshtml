@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HuitMeal SuperAdmin</title>
    <link rel="icon" type="image/png" href="/assets/images/Logo_tròn.png" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        [x-cloak] { display: none !important; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 6px; }
        .custom-scrollbar:hover::-webkit-scrollbar-thumb { background: #94a3b8; }
        /* Custom green Theme for Admin */
        .admin-gradient { background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%); }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden bg-slate-50 text-slate-800 font-sans" x-data="{ sidebarOpen: false }">
    
    <!-- HEADER -->
    <header class="bg-white shadow-sm border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between z-20 relative shrink-0">
        <div class="flex items-center gap-4">
            <!-- Mobile Toggle -->
            <button class="md:hidden p-2 text-green-600 rounded-xl hover:bg-green-50 transition-colors" x-on:click="sidebarOpen = !sidebarOpen">
                <i class="fas fa-bars"></i>
            </button>
            
            <a href="/Admin" class="block hover:opacity-90 transition-opacity">
                <img src="/assets/images/Logo.jpg" alt="HUIT MEAL" class="h-10 w-auto object-contain rounded" />
            </a>
            
            <div class="hidden sm:flex items-center gap-2 ml-2">
                <span class="px-2 py-1 bg-green-100 text-green-700 text-[10px] font-black uppercase tracking-widest rounded">SuperAdmin</span>
            </div>
        </div>
        
        <div class="flex items-center gap-3 sm:gap-5 relative" x-data="{ profileOpen: false }">
            <button class="relative p-2 text-slate-400 hover:text-green-600 transition-colors">
                <i class="fas fa-bell"></i>
                <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border border-white"></span>
            </button>
            
            <button x-on:click="profileOpen = !profileOpen" class="flex items-center gap-2.5 p-1 pr-3 rounded-full hover:bg-slate-100 transition-colors border border-transparent hover:border-slate-200">
                <div class="w-8 h-8 rounded-full admin-gradient flex items-center justify-center text-white font-bold shadow-sm">
                    SA
                </div>
                <div class="hidden md:block text-left">
                    <p class="text-sm font-bold text-slate-700 leading-none">System Admin</p>
                    <p class="text-[10px] font-medium text-slate-500 mt-1">IT Operations</p>
                </div>
                <i class="fas fa-chevron-down text-slate-400 text-xs ml-1"></i>
            </button>
            
            <!-- Dropdown -->
            <div x-show="profileOpen" x-on:click.outside="profileOpen = false" x-cloak 
                 x-transition:enter="transition ease-out duration-100" x-transition:enter-start="transform opacity-0 scale-95" x-transition:enter-end="transform opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-75" x-transition:leave-start="transform opacity-100 scale-100" x-transition:leave-end="transform opacity-0 scale-95"
                 class="absolute right-0 top-full mt-2 w-56 bg-white shadow-xl border border-slate-100 rounded-2xl py-2 z-50 overflow-hidden">
                <div class="px-4 py-2 border-b border-slate-100 mb-1 bg-slate-50">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Tài khoản</p>
                </div>
                <a href="#" class="block px-4 py-2 text-sm font-medium text-slate-600 hover:bg-green-50 hover:text-green-700 flex items-center gap-3 transition-colors">
                    <i class="fas fa-user-shield w-4 text-center"></i> Bảo mật tài khoản
                </a>
                <a href="/Auth/LogOut" class="block px-4 py-2 text-sm font-bold text-red-600 hover:bg-red-50 flex items-center gap-3 transition-colors mt-1 border-t border-slate-100 pt-2">
                    <i class="fas fa-power-off w-4 text-center"></i> Đăng xuất an toàn
                </a>
            </div>
        </div>
    </header>

    <div class="flex flex-1 flex-col md:flex-row overflow-hidden relative">
        <!-- OVERLAY MOBILE -->
        <div x-show="sidebarOpen" x-on:click="sidebarOpen = false" x-cloak class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-30 md:hidden transition-opacity"></div>

        <!-- SIDEBAR -->
        <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'" class="fixed inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-100 shadow-xl transform transition-transform duration-300 md:relative md:translate-x-0 overflow-y-auto custom-scrollbar flex flex-col">
            <nav class="flex flex-col gap-1.5 p-4 flex-1 text-[14px]">
                <div class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-2 px-3 mt-1">Bảng Điều Khiển</div>
                
                <a href="/Admin/Home/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all @(controller == "Home" ? "bg-green-50 text-green-700 font-bold" : "text-gray-500 hover:text-green-700 hover:bg-gray-50 font-medium")">
                    <i class="fas fa-server w-5 text-center @(controller == "Home" ? "text-green-600" : "text-gray-400")"></i>
                    <span>System Status</span>
                </a>
                
                <div class="mt-4 mb-2 text-[11px] font-bold text-gray-400 uppercase tracking-widest px-3">Quản trị & Cấu hình</div>

                <a href="/Admin/User/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all @(controller == "User" ? "bg-green-50 text-green-700 font-bold" : "text-gray-500 hover:text-green-700 hover:bg-gray-50 font-medium")">
                    <i class="fas fa-users-cog w-5 text-center @(controller == "User" ? "text-green-600" : "text-gray-400")"></i>
                    <span>Quản lý Identity (SSO)</span>
                </a>

                <a href="/Admin/Role/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all @(controller == "Role" ? "bg-green-50 text-green-700 font-bold" : "text-gray-500 hover:text-green-700 hover:bg-gray-50 font-medium")">
                    <i class="fas fa-user-shield w-5 text-center @(controller == "Role" ? "text-green-600" : "text-gray-400")"></i>
                    <span>Phân quyền (Roles)</span>
                </a>
                
                <a href="/Admin/System/BackupRestore" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all @(action == "BackupRestore" ? "bg-green-50 text-green-700 font-bold" : "text-gray-500 hover:text-green-700 hover:bg-gray-50 font-medium")">
                    <i class="fas fa-database w-5 text-center @(action == "BackupRestore" ? "text-green-600" : "text-gray-400")"></i>
                    <span>Backup & Disaster Rec.</span>
                </a>
                
                <a href="/Admin/System/ActivityLog" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all @(action == "ActivityLog" ? "bg-green-50 text-green-700 font-bold" : "text-gray-500 hover:text-green-700 hover:bg-gray-50 font-medium")">
                    <i class="fas fa-shield-alt w-5 text-center @(action == "ActivityLog" ? "text-green-600" : "text-gray-400")"></i>
                    <span>Security Audit Log</span>
                </a>
                
                <a href="/Admin/System/AiConfig" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all @(action == "AiConfig" ? "bg-green-50 text-green-700 font-bold" : "text-gray-500 hover:text-green-700 hover:bg-gray-50 font-medium")">
                    <i class="fas fa-brain w-5 text-center @(action == "AiConfig" ? "text-green-600" : "text-gray-400")"></i>
                    <span>Cấu hình AI Core</span>
                </a>
            </nav>
            
            <div class="p-4 border-t border-gray-100 bg-white">
                <a href="/Customer" target="_blank" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all text-gray-500 hover:text-green-700 hover:bg-green-50 font-medium justify-center group border border-gray-200">
                    <span>Vào Cổng Khách Hàng</span>
                    <i class="fas fa-external-link-alt text-xs group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
                </a>
                <p class="text-center text-[10px] text-gray-400 mt-4 font-medium uppercase tracking-widest">HuitMeal OS v2.0</p>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="flex-1 p-4 md:p-8 overflow-y-auto bg-slate-50 custom-scrollbar relative">
            <div class="max-w-7xl mx-auto">
                <!-- Notifications -->
                @if (TempData["Error"] != null)
                {
                    <div x-data="{ show: true }" x-show="show" x-init="setTimeout(() => show = false, 5000)" class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-exclamation-circle text-red-500"></i>
                            <span class="font-bold text-sm">@TempData["Error"]</span>
                        </div>
                        <button @@click="show = false" class="text-red-400 hover:text-red-600"><i class="fas fa-times"></i></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div x-data="{ show: true }" x-show="show" x-init="setTimeout(() => show = false, 5000)" class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-check-circle text-green-500"></i>
                            <span class="font-bold text-sm">@TempData["Success"]</span>
                        </div>
                        <button @@click="show = false" class="text-green-400 hover:text-green-600"><i class="fas fa-times"></i></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
