@model Khoa_Luan_KS_Web.Services.AdminGetUsersResponse
@using System.Text.Json
@{
    ViewData["Title"] = "SSO Identity";
    Layout = "_LayoutAdmin";

    var curPage = (int)(ViewBag.CurrentPage ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var serverSearch = ViewBag.SearchTerm as string ?? "";
    var roleFilter = ViewBag.RoleName as string ?? "";
    var pagination = ViewBag.Pagination as Khoa_Luan_KS_Web.Areas.Manager.Models.ManagerPaginationVm
        ?? new Khoa_Luan_KS_Web.Areas.Manager.Models.ManagerPaginationVm
        {
            Area = "Admin",
            Controller = "User",
            Action = "Index",
            Page = curPage,
            PageSize = pageSize,
            TotalCount = Model.TotalCount,
            ItemCount = Model.Items.Count,
            SearchTerm = serverSearch,
            RoleName = roleFilter
        };

    var allRoles = new[] { "Admin", "Manager", "WarehouseStaff", "ChefStaff", "SalesStaff", "Shipper", "Organization", "Customer" };

    string PrimaryRole(IReadOnlyList<string> roles) => roles.FirstOrDefault() ?? "No Role";

    string AvatarClass(string role) => role switch
    {
        "Admin" => "bg-green-600",
        "Manager" => "bg-blue-600",
        "WarehouseStaff" => "bg-purple-600",
        "ChefStaff" => "bg-orange-500",
        "SalesStaff" => "bg-cyan-600",
        "Shipper" => "bg-amber-600",
        _ => "bg-slate-500"
    };

    string RoleBadgeClass(string role) => role switch
    {
        "Admin" => "bg-green-50 text-green-700 border-green-200",
        "Manager" => "bg-blue-50 text-blue-700 border-blue-200",
        "WarehouseStaff" => "bg-purple-50 text-purple-700 border-purple-200",
        "ChefStaff" => "bg-orange-50 text-orange-700 border-orange-200",
        "SalesStaff" => "bg-cyan-50 text-cyan-700 border-cyan-200",
        "Shipper" => "bg-amber-50 text-amber-700 border-amber-200",
        "Organization" => "bg-indigo-50 text-indigo-700 border-indigo-200",
        "Customer" => "bg-orange-50 text-orange-700 border-orange-200",
        _ => "bg-slate-50 text-slate-600 border-slate-200"
    };

    string InitialLetter(Khoa_Luan_KS_Web.Services.AdminUserDto u)
    {
        if (!string.IsNullOrWhiteSpace(u.FullName)) return u.FullName.Trim()[0].ToString().ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(u.Email)) return u.Email[0].ToString().ToUpperInvariant();
        return "?";
    }
}

<div class="space-y-8" x-data="userManager()">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý Định danh (Identity & SSO)</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Quản lý tài khoản người dùng, phân quyền truy cập (Role-based Access Control) toàn hệ thống.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" @@click="openModal()" class="px-5 py-2 admin-gradient text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:shadow-green-600/50 transition-all text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
                Cấp tài khoản mới
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="text-sm text-green-700 bg-green-50 border border-green-100 rounded-xl px-4 py-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="text-sm text-red-700 bg-red-50 border border-red-100 rounded-xl px-4 py-3">@TempData["Error"]</div>
    }

    <form method="get" asp-area="Admin" asp-controller="User" asp-action="Index"
          class="grid grid-cols-1 md:grid-cols-4 gap-4 items-stretch">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <div class="md:col-span-2 relative">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <input type="text" name="searchTerm" value="@serverSearch" placeholder="Tìm Email, tên, SĐT, mã ID..."
                   class="w-full h-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-3 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all shadow-sm" />
        </div>
        <select name="roleName" class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none focus:border-green-500 shadow-sm">
            @if (string.IsNullOrEmpty(roleFilter)) { <option value="" selected>Tất cả Roles</option> } else { <option value="">Tất cả Roles</option> }
            @foreach (var role in allRoles)
            {
                if (roleFilter == role)
                {
                    <option value="@role" selected>@role</option>
                }
                else
                {
                    <option value="@role">@role</option>
                }
            }
        </select>
        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold rounded-xl text-sm shadow-sm transition px-4">
            <i class="fas fa-filter mr-1"></i> Lọc
        </button>
    </form>

    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between">
        <div class="text-sm font-bold text-slate-500 uppercase tracking-wider">Tổng người dùng (theo bộ lọc)</div>
        <div class="bg-green-50 text-green-700 px-4 py-1.5 rounded-lg font-black text-xl">@Model.TotalCount</div>
    </div>

    <form id="lockForm" method="post" asp-area="Admin" asp-controller="User" asp-action="Lock" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="lockId" />
        <input type="hidden" name="page" value="@curPage" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="searchTerm" value="@serverSearch" />
        <input type="hidden" name="roleName" value="@roleFilter" />
    </form>
    <form id="unlockForm" method="post" asp-area="Admin" asp-controller="User" asp-action="Unlock" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="unlockId" />
        <input type="hidden" name="page" value="@curPage" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="searchTerm" value="@serverSearch" />
        <input type="hidden" name="roleName" value="@roleFilter" />
    </form>
    <form id="resetPasswordForm" method="post" asp-area="Admin" asp-controller="User" asp-action="ResetPassword" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="resetId" />
        <input type="hidden" name="newPassword" id="resetNewPassword" />
        <input type="hidden" name="page" value="@curPage" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="searchTerm" value="@serverSearch" />
        <input type="hidden" name="roleName" value="@roleFilter" />
    </form>

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-widest text-slate-500 font-black">
                        <th class="p-5 pl-6">Người dùng (Identity)</th>
                        <th class="p-5">Vai trò (Role)</th>
                        <th class="p-5">Liên hệ</th>
                        <th class="p-5">Trạng thái</th>
                        <th class="p-5">Đăng nhập cuối</th>
                        <th class="p-5 pr-6 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="p-12 text-center">
                                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
                                    <i class="fas fa-search text-2xl"></i>
                                </div>
                                <h3 class="text-lg font-black text-slate-800">Không tìm thấy kết quả</h3>
                                <p class="text-sm text-slate-500 mt-1">Không có tài khoản nào phù hợp với bộ lọc hiện tại.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var u in Model.Items)
                    {
                        var role = PrimaryRole(u.RoleNames);
                        var userJson = JsonSerializer.Serialize(new
                        {
                            id = u.Id,
                            firstName = u.FirstName ?? "",
                            lastName = u.LastName ?? "",
                            name = string.IsNullOrWhiteSpace(u.FullName) ? u.Email : u.FullName,
                            email = u.Email,
                            phone = u.PhoneNumber ?? "N/A",
                            role,
                            status = u.IsActive ? "Active" : "Locked",
                            isActive = u.IsActive
                        });
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <td class="p-5 pl-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold shadow-sm @AvatarClass(role)">@InitialLetter(u)</div>
                                    <div>
                                        <div class="font-black text-slate-800">@(string.IsNullOrWhiteSpace(u.FullName) ? u.Email : u.FullName)</div>
                                        <div class="text-xs font-medium text-slate-500">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-5">
                                <span class="px-2.5 py-1 text-[10px] font-black uppercase tracking-widest rounded-lg border @RoleBadgeClass(role)">@role</span>
                            </td>
                            <td class="p-5">
                                <div class="font-medium text-slate-700">@(u.PhoneNumber ?? "—")</div>
                            </td>
                            <td class="p-5">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full @(u.IsActive ? "bg-green-500" : "bg-red-500")"></div>
                                    <span class="font-bold text-slate-700">@(u.IsActive ? "Active" : "Locked")</span>
                                </div>
                            </td>
                            <td class="p-5 text-slate-500 font-medium text-xs">@(u.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</td>
                            <td class="p-5 pr-6 text-right">
                                <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button type="button" class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-blue-600 hover:border-blue-300 hover:bg-blue-50 flex items-center justify-center transition-all" title="Đặt lại mật khẩu" @@click="resetPassword(@u.Id)">
                                        <i class="fas fa-key text-xs"></i>
                                    </button>
                                    <button type="button" class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-green-600 hover:border-green-300 hover:bg-green-50 flex items-center justify-center transition-all" title="Sửa thông tin" @@click='openModal(@Html.Raw(userJson))'>
                                        <i class="fas fa-edit text-xs"></i>
                                    </button>
                                    @if (u.IsActive && role != "Admin")
                                    {
                                        <button type="button" @@click="lockUser(@u.Id)" class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-red-600 hover:border-red-300 hover:bg-red-50 flex items-center justify-center transition-all" title="Khóa tài khoản">
                                            <i class="fas fa-lock text-xs"></i>
                                        </button>
                                    }
                                    @if (!u.IsActive)
                                    {
                                        <button type="button" @@click="unlockUser(@u.Id)" class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-green-600 hover:border-green-300 hover:bg-green-50 flex items-center justify-center transition-all" title="Mở khóa tài khoản">
                                            <i class="fas fa-lock-open text-xs"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Areas/Manager/Views/Shared/_PaginationBar.cshtml" model="pagination" />
    </div>

    <!-- MODAL: ADD/EDIT USER -->
    <div x-show="isModalOpen" style="display: none;" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="isModalOpen"
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="closeModal()"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="isModalOpen"
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-xl" @@click.stop>

                    <form id="userForm" method="post" :action="currentUser ? '/Admin/User/Update/' + currentUser.id : '/Admin/User/Create'">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="page" value="@curPage" />
                        <input type="hidden" name="pageSize" value="@pageSize" />
                        <input type="hidden" name="searchTerm" value="@serverSearch" />
                        <input type="hidden" name="roleName" value="@roleFilter" />

                    <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h3 class="text-xl font-black text-slate-800" x-text="currentUser ? 'Chỉnh sửa Tài khoản' : 'Cấp Tài khoản mới'"></h3>
                        <button type="button" @@click="closeModal()" class="text-slate-400 hover:text-slate-600 bg-slate-200/50 hover:bg-slate-200 p-1.5 rounded-full transition-colors">
                            <i class="fas fa-times w-4 text-center"></i>
                        </button>
                    </div>

                    <div class="p-6 space-y-5">
                        <div class="grid grid-cols-2 gap-5">
                            <div class="col-span-2 sm:col-span-1">
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Họ (Tùy chọn)</label>
                                <input type="text" name="LastName" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" placeholder="VD: Nguyễn Văn" :value="currentUser ? currentUser.lastName : ''" />
                            </div>
                            <div class="col-span-2 sm:col-span-1">
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tên (Tùy chọn)</label>
                                <input type="text" name="FirstName" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" placeholder="VD: A" :value="currentUser ? currentUser.firstName : ''" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số điện thoại</label>
                            <input type="text" name="PhoneNumber" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" placeholder="VD: 0901234567" :value="currentUser ? currentUser.phone : ''" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Email đăng nhập / Username (Identity)</label>
                            <input type="email" name="Email" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" placeholder="VD: admin@huitmeal.com" :value="currentUser ? currentUser.email : ''" :readonly="currentUser != null" />
                            <input type="hidden" name="Username" :value="currentUser ? currentUser.email : ''" x-ref="usernameHidden" />
                            <p class="text-[11px] text-slate-500 mt-1" x-show="currentUser">Không thể thay đổi email sau khi cấp.</p>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Vai trò hệ thống (Role)</label>
                            <select name="role" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold focus:border-green-500 bg-white">
                                @foreach (var role in allRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </div>

                        <div x-show="!currentUser">
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Mật khẩu tạm thời</label>
                            <input type="text" name="Password" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold bg-slate-50 text-slate-600" value="HuitMeal@2026" readonly />
                            <p class="text-[11px] text-slate-500 mt-1"><i class="fas fa-info-circle mr-1"></i>Mật khẩu mặc định.</p>
                        </div>
                    </div>

                    <div class="px-6 py-5 bg-slate-50 border-t border-slate-100 flex justify-end gap-3 rounded-b-[32px]">
                        <button type="button" @@click="closeModal()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-white border border-slate-200 transition-colors text-sm">Hủy</button>
                        <button type="submit" class="px-6 py-2.5 rounded-xl admin-gradient text-white font-bold hover:shadow-lg transition-all text-sm flex items-center gap-2">
                            <i class="fas fa-check"></i>
                            <span x-text="currentUser ? 'Cập nhật' : 'Tạo Tài khoản'"></span>
                        </button>
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('userManager', () => ({
                isModalOpen: false,
                currentUser: null,

                openModal(user = null) {
                    this.currentUser = user ? JSON.parse(JSON.stringify(user)) : null;
                    this.isModalOpen = true;
                    document.body.style.overflow = 'hidden';
                    this.$nextTick(() => {
                        const roleSelect = document.querySelector('#userForm select[name=role]');
                        if (roleSelect && this.currentUser?.role) roleSelect.value = this.currentUser.role;
                        const emailInput = document.querySelector('#userForm input[name=Email]');
                        const userHidden = document.querySelector('#userForm input[name=Username]');
                        if (!this.currentUser && emailInput && userHidden) {
                            userHidden.value = emailInput.value;
                            emailInput.addEventListener('input', () => { userHidden.value = emailInput.value; });
                        }
                    });
                },

                closeModal() {
                    this.isModalOpen = false;
                    document.body.style.overflow = '';
                },

                lockUser(id) {
                    if (confirm('Bạn có chắc chắn muốn khóa tài khoản này?')) {
                        document.getElementById('lockId').value = id;
                        document.getElementById('lockForm').submit();
                    }
                },

                unlockUser(id) {
                    if (confirm('Bạn có chắc chắn muốn mở khóa tài khoản này?')) {
                        document.getElementById('unlockId').value = id;
                        document.getElementById('unlockForm').submit();
                    }
                },

                resetPassword(id) {
                    const newPass = prompt('Nhập mật khẩu mới cho người dùng này:');
                    if (newPass) {
                        document.getElementById('resetId').value = id;
                        document.getElementById('resetNewPassword').value = newPass;
                        document.getElementById('resetPasswordForm').submit();
                    }
                }
            }));
        });
    </script>
}
