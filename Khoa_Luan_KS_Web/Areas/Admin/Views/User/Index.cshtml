@{
    ViewData["Title"] = "SSO Identity";
    Layout = "_LayoutAdmin";
}

<div class="space-y-8" x-data="userManager()">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý Định danh (Identity & SSO)</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Quản lý tài khoản người dùng, phân quyền truy cập (Role-based Access Control) toàn hệ thống.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <button class="px-5 py-2 bg-white border border-slate-200 text-slate-600 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Export CSV
            </button>
            <button @@click="openModal()" class="px-5 py-2 admin-gradient text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:shadow-green-600/50 transition-all text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
                Cấp tài khoản mới
            </button>
        </div>
    </div>

    <!-- Stats & Filters -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="md:col-span-3 flex flex-wrap gap-3">
            <div class="relative flex-1 min-w-[250px]">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" x-model="searchQuery" placeholder="Tìm kiếm Email, Tên, SĐT..." class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-3 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all shadow-sm" />
            </div>
            
            <select x-model="roleFilter" class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none focus:border-green-500 shadow-sm min-w-[150px]">
                <option value="all">Tất cả Roles</option>
                <option value="Admin">System Admin</option>
                <option value="Manager">Manager</option>
                <option value="Customer">Customer</option>
            </select>
        </div>
        
        <div class="bg-white rounded-xl border border-slate-200 p-3 shadow-sm flex items-center justify-between">
            <div class="text-sm font-bold text-slate-500 uppercase tracking-wider ml-2">Total Users</div>
            <div class="bg-green-50 text-green-700 px-3 py-1 rounded-lg font-black text-xl" x-text="users.length"></div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-widest text-slate-500 font-black">
                        <th class="p-5 pl-6">Người dùng (Identity)</th>
                        <th class="p-5">Vai trò (Role)</th>
                        <th class="p-5">Liên hệ</th>
                        <th class="p-5">Trạng thái</th>
                        <th class="p-5">Đăng nhập cuối</th>
                        <th class="p-5 pr-6 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    <template x-for="user in filteredUsers" :key="user.id">
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <td class="p-5 pl-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold shadow-sm" :class="getAvatarColor(user.role)" x-text="user.name.charAt(0)"></div>
                                    <div>
                                        <div class="font-black text-slate-800" x-text="user.name"></div>
                                        <div class="text-xs font-medium text-slate-500" x-text="user.email"></div>
                                    </div>
                                </div>
                            </td>
                            
                            <td class="p-5">
                                <span class="px-2.5 py-1 text-[10px] font-black uppercase tracking-widest rounded-lg border" :class="getRoleBadge(user.role)" x-text="user.role"></span>
                            </td>
                            
                            <td class="p-5">
                                <div class="font-medium text-slate-700" x-text="user.phone"></div>
                            </td>
                            
                            <td class="p-5">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full" :class="user.status === 'Active' ? 'bg-green-500' : 'bg-red-500'"></div>
                                    <span class="font-bold text-slate-700" x-text="user.status"></span>
                                </div>
                            </td>
                            
                            <td class="p-5 text-slate-500 font-medium text-xs" x-text="user.lastLogin"></td>
                            
                            <td class="p-5 pr-6 text-right">
                                <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-green-600 hover:border-green-300 hover:bg-green-50 flex items-center justify-center transition-all" title="Sửa thông tin" @@click="openModal(user)">
                                        <i class="fas fa-edit text-xs"></i>
                                    </button>
                                    <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-red-600 hover:border-red-300 hover:bg-red-50 flex items-center justify-center transition-all" title="Khóa tài khoản" x-show="user.role !== 'Admin'">
                                        <i class="fas fa-lock text-xs"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
        
        <!-- Empty State -->
        <div x-show="filteredUsers.length === 0" class="p-12 text-center">
            <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
                <i class="fas fa-search text-2xl"></i>
            </div>
            <h3 class="text-lg font-black text-slate-800">Không tìm thấy kết quả</h3>
            <p class="text-sm text-slate-500 mt-1">Không có tài khoản nào phù hợp với bộ lọc hiện tại.</p>
        </div>
    </div>

    <!-- MODAL: ADD/EDIT USER -->
    <div x-show="isModalOpen" style="display: none;" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="isModalOpen" 
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" 
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="closeModal()"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="isModalOpen" 
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-xl" @@click.stop>
                    
                    <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h3 class="text-xl font-black text-slate-800" x-text="currentUser ? 'Chỉnh sửa Tài khoản' : 'Cấp Tài khoản mới'"></h3>
                        <button @@click="closeModal()" class="text-slate-400 hover:text-slate-600 bg-slate-200/50 hover:bg-slate-200 p-1.5 rounded-full transition-colors">
                            <i class="fas fa-times w-4 text-center"></i>
                        </button>
                    </div>
                    
                    <div class="p-6 space-y-5">
                        <div class="grid grid-cols-2 gap-5">
                            <div class="col-span-2 sm:col-span-1">
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Họ và Tên</label>
                                <input type="text" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" placeholder="VD: Nguyễn Văn A" :value="currentUser ? currentUser.name : ''" />
                            </div>
                            <div class="col-span-2 sm:col-span-1">
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số điện thoại</label>
                                <input type="text" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" placeholder="VD: 0901234567" :value="currentUser ? currentUser.phone : ''" />
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Email đăng nhập (Identity)</label>
                            <input type="email" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 shadow-sm" placeholder="VD: admin@huitmeal.com" :value="currentUser ? currentUser.email : ''" :disabled="currentUser" />
                            <p class="text-[11px] text-slate-500 mt-1" x-show="currentUser">Không thể thay đổi email sau khi cấp.</p>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Vai trò hệ thống (Role)</label>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <label class="relative flex cursor-pointer rounded-xl border border-slate-200 bg-white p-3 shadow-sm hover:border-green-300 transition-colors">
                                    <input type="radio" name="role" value="Admin" class="peer sr-only" />
                                    <div class="flex w-full justify-between items-center peer-checked:text-green-600">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-shield-alt"></i>
                                            <span class="text-sm font-bold">System Admin</span>
                                        </div>
                                    </div>
                                    <div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-green-500 pointer-events-none"></div>
                                </label>
                                
                                <label class="relative flex cursor-pointer rounded-xl border border-slate-200 bg-white p-3 shadow-sm hover:border-blue-300 transition-colors">
                                    <input type="radio" name="role" value="Manager" class="peer sr-only" checked />
                                    <div class="flex w-full justify-between items-center peer-checked:text-blue-600">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-tasks"></i>
                                            <span class="text-sm font-bold">Manager</span>
                                        </div>
                                    </div>
                                    <div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-blue-500 pointer-events-none"></div>
                                </label>

                                <label class="relative flex cursor-pointer rounded-xl border border-slate-200 bg-white p-3 shadow-sm hover:border-orange-300 transition-colors">
                                    <input type="radio" name="role" value="Customer" class="peer sr-only" />
                                    <div class="flex w-full justify-between items-center peer-checked:text-orange-600">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-user"></i>
                                            <span class="text-sm font-bold">Customer</span>
                                        </div>
                                    </div>
                                    <div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-orange-500 pointer-events-none"></div>
                                </label>
                            </div>
                        </div>

                        <div x-show="!currentUser">
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Mật khẩu tạm thời</label>
                            <div class="relative">
                                <input type="text" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold bg-slate-50 text-slate-600" value="HuitMeal@2026" readonly />
                                <button class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded">Generate Random</button>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-1"><i class="fas fa-info-circle mr-1"></i>Người dùng sẽ được yêu cầu đổi mật khẩu ở lần đăng nhập đầu tiên.</p>
                        </div>
                    </div>
                    
                    <div class="px-6 py-5 bg-slate-50 border-t border-slate-100 flex justify-end gap-3 rounded-b-[32px]">
                        <button @@click="closeModal()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-white border border-slate-200 transition-colors text-sm">Hủy</button>
                        <button @@click="submitUser()" class="px-6 py-2.5 rounded-xl admin-gradient text-white font-bold hover:shadow-lg transition-all text-sm flex items-center gap-2">
                            <i class="fas fa-check"></i>
                            <span x-text="currentUser ? 'Cập nhật' : 'Tạo Tài khoản'"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('userManager', () => ({
                searchQuery: '',
                roleFilter: 'all',
                isModalOpen: false,
                currentUser: null,
                
                users: [
                    { id: 1, name: 'Trần Văn Quản Trị', email: 'admin@huitmeal.com', phone: '0901234567', role: 'Admin', status: 'Active', lastLogin: 'Vừa xong' },
                    { id: 2, name: 'Lê Thị Bếp Trưởng', email: 'manager.bep@huitmeal.com', phone: '0912345678', role: 'Manager', status: 'Active', lastLogin: '2 giờ trước' },
                    { id: 3, name: 'Nguyễn Kế Toán', email: 'finance@huitmeal.com', phone: '0987654321', role: 'Manager', status: 'Active', lastLogin: '1 ngày trước' },
                    { id: 4, name: 'Công ty Samsung (B2B)', email: 'contact@samsung.vn', phone: '0283123456', role: 'Customer', status: 'Active', lastLogin: '3 ngày trước' },
                    { id: 5, name: 'Tài xế Nguyễn Văn A', email: 'driver01@huitmeal.com', phone: '0933334444', role: 'Customer', status: 'Locked', lastLogin: '1 tháng trước' }
                ],
                
                get filteredUsers() {
                    return this.users.filter(user => {
                        const matchSearch = user.name.toLowerCase().includes(this.searchQuery.toLowerCase()) || 
                                            user.email.toLowerCase().includes(this.searchQuery.toLowerCase()) ||
                                            user.phone.includes(this.searchQuery);
                        const matchRole = this.roleFilter === 'all' || user.role === this.roleFilter;
                        return matchSearch && matchRole;
                    });
                },
                
                getAvatarColor(role) {
                    if (role === 'Admin') return 'bg-green-600';
                    if (role === 'Manager') return 'bg-blue-600';
                    return 'bg-orange-500';
                },
                
                getRoleBadge(role) {
                    if (role === 'Admin') return 'bg-green-50 text-green-700 border-green-200';
                    if (role === 'Manager') return 'bg-blue-50 text-blue-700 border-blue-200';
                    return 'bg-orange-50 text-orange-700 border-orange-200';
                },
                
                openModal(user = null) {
                    this.currentUser = user ? JSON.parse(JSON.stringify(user)) : null;
                    this.isModalOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                
                closeModal() {
                    this.isModalOpen = false;
                    document.body.style.overflow = '';
                },
                
                submitUser() {
                    alert('Đã lưu thông tin tài khoản thành công!');
                    this.closeModal();
                }
            }));
        });
    </script>
}
