@{
    ViewData["Title"] = "Tổng quan Kho";
    Layout = "_LayoutWarehouse";
}

<div class="px-1 space-y-6" x-data="{
    currentTime: '',
    currentDate: '',
    init() {
        const update = () => {
            const now = new Date();
            this.currentTime = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            this.currentDate = now.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        };
        update();
        setInterval(update, 1000);
    }
}">

    <!-- Header Banner -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:px-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-[10px] font-bold uppercase tracking-wide">
                    <i class="fas fa-warehouse text-[9px]"></i> Khu vực Kho
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight mb-1">Tổng quan Hoạt động Kho</h1>
            <p class="text-gray-500 font-medium text-sm flex items-center gap-2">
                <i class="far fa-calendar text-gray-400"></i>
                Hôm nay là <span x-text="currentDate" class="text-gray-700 ml-1"></span>
            </p>
        </div>
        <div class="flex gap-3 items-center flex-wrap">
            <div class="px-4 py-2 bg-amber-50 border border-amber-100 rounded-xl flex items-center gap-3">
                <i class="far fa-clock text-amber-600"></i>
                <div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mb-0.5">Giờ Hệ Thống</div>
                    <div class="font-mono text-base font-bold text-gray-800" x-text="currentTime">--:--:--</div>
                </div>
            </div>
            <a href="/WarehouseStaff/Requisition/Create"
               class="bg-amber-500 hover:bg-amber-600 text-white font-semibold px-5 py-3 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-plus"></i> Tạo Phiếu Mới
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

        <!-- Card 1: Tổng NVL -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col group hover:border-amber-200 transition">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Tổng Mặt Hàng NVL</div>
                <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm group-hover:bg-amber-100 transition">
                    <i class="fas fa-boxes"></i>
                </div>
            </div>
            <h3 class="text-3xl font-bold text-gray-900">128</h3>
            <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-gray-500">
                <i class="fas fa-arrow-up text-green-500"></i> 4 mặt hàng mới nhập tuần này
            </div>
        </div>

        <!-- Card 2: Phiếu chờ duyệt -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col group hover:border-blue-200 transition">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Phiếu Chờ Duyệt</div>
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm group-hover:bg-blue-100 transition">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
            <h3 class="text-3xl font-bold text-blue-600">5</h3>
            <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-blue-600">
                <i class="fas fa-hourglass-half"></i> Đang chờ Manager duyệt
            </div>
        </div>

        <!-- Card 3: Phiếu đã duyệt hôm nay -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col group hover:border-green-200 transition">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Đã Duyệt Hôm Nay</div>
                <div class="w-9 h-9 rounded-xl bg-green-50 text-green-600 flex items-center justify-center text-sm group-hover:bg-green-100 transition">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <h3 class="text-3xl font-bold text-gray-900">3</h3>
            <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-green-600">
                <i class="fas fa-check"></i> Sẵn sàng nhập kho thực tế
            </div>
        </div>

        <!-- Card 4: Cảnh báo sắp hết -->
        <div class="bg-white p-6 rounded-2xl border border-red-100 shadow-sm flex flex-col group hover:border-red-200 transition">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Cảnh Báo Tồn Kho</div>
                <div class="w-9 h-9 rounded-xl bg-red-50 text-red-600 flex items-center justify-center text-sm group-hover:bg-red-100 transition">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
            </div>
            <h3 class="text-3xl font-bold text-red-600">7</h3>
            <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-red-600">
                <i class="fas fa-bell"></i> Mặt hàng sắp hết / sắp hết hạn
            </div>
        </div>

    </div>

    <!-- Phần chi tiết 2 cột -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Cột trái: Bảng phiếu đề xuất gần nhất -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h3 class="font-bold text-gray-900 text-[15px]">Phiếu Đề Xuất Gần Nhất</h3>
                        <p class="text-xs text-gray-500 font-medium mt-0.5">Danh sách 10 phiếu mới nhất của bạn</p>
                    </div>
                    <a href="/WarehouseStaff/Requisition/History"
                       class="text-amber-600 hover:text-amber-700 text-xs font-bold flex items-center gap-1 transition">
                        Xem tất cả <i class="fas fa-arrow-right text-[10px]"></i>
                    </a>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-gray-50 text-gray-500 text-[11px] uppercase font-bold tracking-wider">
                            <tr>
                                <th class="px-5 py-3.5 border-b border-gray-100">Mã Phiếu</th>
                                <th class="px-5 py-3.5 border-b border-gray-100">Loại</th>
                                <th class="px-5 py-3.5 border-b border-gray-100">Ngày Tạo</th>
                                <th class="px-5 py-3.5 border-b border-gray-100">Trạng Thái</th>
                                <th class="px-5 py-3.5 border-b border-gray-100 text-center">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 text-gray-700">
                            <tr class="hover:bg-amber-50/30 transition">
                                <td class="px-5 py-3.5 font-mono font-semibold text-gray-800">#PX-2405-007</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 text-[11px] font-bold border border-blue-100">
                                        <i class="fas fa-arrow-down text-[9px]"></i> Nhập kho
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-500">07/05/2026</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-green-50 text-green-700 text-[11px] font-bold border border-green-100">
                                        <i class="fas fa-check text-[9px]"></i> Đã duyệt
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-center">
                                    <a href="/WarehouseStaff/Warehouse/Receive" class="text-amber-600 hover:text-amber-800 text-xs font-semibold transition">Nhập kho →</a>
                                </td>
                            </tr>
                            <tr class="hover:bg-amber-50/30 transition">
                                <td class="px-5 py-3.5 font-mono font-semibold text-gray-800">#PX-2405-006</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-orange-50 text-orange-700 text-[11px] font-bold border border-orange-100">
                                        <i class="fas fa-arrow-up text-[9px]"></i> Xuất kho
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-500">06/05/2026</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-yellow-50 text-yellow-700 text-[11px] font-bold border border-yellow-100">
                                        <i class="fas fa-hourglass-half text-[9px]"></i> Chờ duyệt
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-center">
                                    <span class="text-gray-400 text-xs font-medium">Đang chờ</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-amber-50/30 transition">
                                <td class="px-5 py-3.5 font-mono font-semibold text-gray-800">#PX-2405-005</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 text-[11px] font-bold border border-blue-100">
                                        <i class="fas fa-arrow-down text-[9px]"></i> Nhập kho
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-500">05/05/2026</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-red-50 text-red-600 text-[11px] font-bold border border-red-100">
                                        <i class="fas fa-times text-[9px]"></i> Từ chối
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-center">
                                    <a href="/WarehouseStaff/Requisition/History" class="text-gray-500 hover:text-gray-700 text-xs font-semibold transition">Xem lý do</a>
                                </td>
                            </tr>
                            <tr class="hover:bg-amber-50/30 transition">
                                <td class="px-5 py-3.5 font-mono font-semibold text-gray-800">#PX-2405-004</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 text-[11px] font-bold border border-blue-100">
                                        <i class="fas fa-arrow-down text-[9px]"></i> Nhập kho
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-500">04/05/2026</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-green-50 text-green-700 text-[11px] font-bold border border-green-100">
                                        <i class="fas fa-check text-[9px]"></i> Đã duyệt
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-center">
                                    <a href="/WarehouseStaff/Warehouse/Receive" class="text-amber-600 hover:text-amber-800 text-xs font-semibold transition">Nhập kho →</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="grid grid-cols-2 gap-4">
                <a href="/WarehouseStaff/Requisition/Create"
                   class="bg-white border border-gray-100 shadow-sm rounded-2xl p-5 flex items-center justify-between group hover:border-amber-300 hover:shadow-md transition">
                    <div>
                        <div class="text-[11px] font-semibold text-gray-400 mb-1">Nghiệp vụ Kho</div>
                        <h4 class="font-bold text-sm text-gray-900">Tạo Phiếu Đề Xuất</h4>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center group-hover:bg-amber-100 transition">
                        <i class="fas fa-file-circle-plus text-amber-500 text-lg"></i>
                    </div>
                </a>
                <a href="/WarehouseStaff/Warehouse/Stock"
                   class="bg-white border border-gray-100 shadow-sm rounded-2xl p-5 flex items-center justify-between group hover:border-amber-300 hover:shadow-md transition">
                    <div>
                        <div class="text-[11px] font-semibold text-gray-400 mb-1">Kiểm soát Kho</div>
                        <h4 class="font-bold text-sm text-gray-900">Xem Tồn Kho</h4>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center group-hover:bg-amber-100 transition">
                        <i class="fas fa-boxes text-amber-500 text-lg"></i>
                    </div>
                </a>
            </div>
        </div>

        <!-- Cột phải: Timeline hoạt động -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 h-full flex flex-col">
                <div class="px-6 py-4 border-b border-gray-100 shrink-0">
                    <h3 class="font-bold text-gray-900 text-[15px]">Nhật Ký Hoạt Động Hôm Nay</h3>
                    <p class="text-xs text-gray-500 mt-1 font-medium">Cập nhật theo thời gian thực</p>
                </div>

                <div class="p-6 flex-1 overflow-auto">
                    <div class="relative border-l-2 border-amber-100 ml-2 space-y-7">

                        <div class="relative pl-6">
                            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-amber-500 border-2 border-white shadow"></div>
                            <div class="text-[10px] font-bold text-amber-600 mb-1 uppercase tracking-wide">08:30 SA</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Nhập kho thịt heo tươi</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Nhận 150kg thịt heo từ NCC CP Vietnam. Kiểm tra nhiệt độ và chứng nhận VSATTP đạt chuẩn.</p>
                        </div>

                        <div class="relative pl-6">
                            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-blue-400 border-2 border-white shadow"></div>
                            <div class="text-[10px] font-bold text-blue-600 mb-1 uppercase tracking-wide">07:15 SA</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Tạo phiếu đề xuất #PX-2405-007</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Gửi phiếu đề xuất nhập 200kg gạo tẻ và 50kg đường tinh luyện cho Manager duyệt.</p>
                        </div>

                        <div class="relative pl-6">
                            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-green-500 border-2 border-white shadow"></div>
                            <div class="text-[10px] font-bold text-green-600 mb-1 uppercase tracking-wide">06:00 SA</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Kiểm kê tồn kho đầu ngày</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Hoàn tất kiểm kê 128 mặt hàng. Phát hiện 7 mặt hàng sắp hết ngưỡng tối thiểu.</p>
                        </div>

                        <div class="relative pl-6">
                            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-gray-300 border-2 border-white shadow"></div>
                            <div class="text-[10px] font-bold text-gray-400 mb-1 uppercase tracking-wide">05:30 SA</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Bắt đầu ca làm việc</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Điểm danh và nhận bàn giao ca từ ca đêm. Bắt đầu sắp xếp khu vực nhận hàng.</p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
