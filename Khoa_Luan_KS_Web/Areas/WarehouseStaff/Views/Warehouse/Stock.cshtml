@{
    ViewData["Title"] = "Tồn Kho Hiện Tại";
    Layout = "_LayoutWarehouse";
}

<div class="px-1 space-y-6"
     x-data="{
        search: '',
        filterCategory: 'all',
        filterStatus: 'all',
        stocks: [
            { id: 1, name: 'Gạo tẻ thường', category: 'Lương thực', unit: 'kg', qty: 850, minQty: 200, expiry: '2026-11-07', lot: 'LOT-CP-001', location: 'A1-01', status: 'normal' },
            { id: 2, name: 'Thịt heo ba chỉ', category: 'Thịt tươi', unit: 'kg', qty: 45, minQty: 50, expiry: '2026-05-12', lot: 'LOT-TH-002', location: 'B2-03', status: 'low' },
            { id: 3, name: 'Rau muống', category: 'Rau củ', unit: 'kg', qty: 20, minQty: 30, expiry: '2026-05-09', lot: 'LOT-RM-001', location: 'C1-05', status: 'critical' },
            { id: 4, name: 'Dầu ăn Neptune', category: 'Gia vị & Dầu', unit: 'thùng', qty: 12, minQty: 5, expiry: '2027-01-07', lot: 'LOT-DA-003', location: 'A2-02', status: 'normal' },
            { id: 5, name: 'Đường tinh luyện', category: 'Lương thực', unit: 'kg', qty: 180, minQty: 100, expiry: '2027-05-07', lot: 'LOT-DT-002', location: 'A1-02', status: 'normal' },
            { id: 6, name: 'Hạt nêm Maggi', category: 'Gia vị & Dầu', unit: 'thùng', qty: 3, minQty: 5, expiry: '2027-03-03', lot: 'LOT-HN-001', location: 'A3-01', status: 'low' },
            { id: 7, name: 'Cà rốt tươi', category: 'Rau củ', unit: 'kg', qty: 0, minQty: 20, expiry: '2026-05-08', lot: 'LOT-CR-001', location: 'C1-06', status: 'out' },
            { id: 8, name: 'Trứng gà công nghiệp', category: 'Thực phẩm khác', unit: 'cái', qty: 300, minQty: 100, expiry: '2026-05-20', lot: 'LOT-TG-001', location: 'D1-01', status: 'normal' },
            { id: 9, name: 'Nước mắm Phú Quốc', category: 'Gia vị & Dầu', unit: 'chai', qty: 24, minQty: 10, expiry: '2027-08-01', lot: 'LOT-NM-001', location: 'A3-02', status: 'normal' },
            { id: 10, name: 'Thịt gà ta', category: 'Thịt tươi', unit: 'kg', qty: 8, minQty: 30, expiry: '2026-05-10', lot: 'LOT-TG-002', location: 'B2-04', status: 'critical' },
            { id: 11, name: 'Khoai tây', category: 'Rau củ', unit: 'kg', qty: 60, minQty: 40, expiry: '2026-06-01', lot: 'LOT-KT-001', location: 'C2-01', status: 'normal' },
            { id: 12, name: 'Sốt cà chua', category: 'Gia vị & Dầu', unit: 'hộp', qty: 5, minQty: 10, expiry: '2026-12-01', lot: 'LOT-SC-001', location: 'A3-03', status: 'low' }
        ],
        categories: ['all', 'Lương thực', 'Thịt tươi', 'Rau củ', 'Gia vị & Dầu', 'Thực phẩm khác'],
        get filtered() {
            return this.stocks.filter(s => {
                const matchCat = this.filterCategory === 'all' || s.category === this.filterCategory;
                const matchStatus = this.filterStatus === 'all' || s.status === this.filterStatus;
                const matchSearch = !this.search || s.name.toLowerCase().includes(this.search.toLowerCase()) || s.lot.toLowerCase().includes(this.search.toLowerCase());
                return matchCat && matchStatus && matchSearch;
            });
        },
        get counts() {
            return {
                normal: this.stocks.filter(s => s.status === 'normal').length,
                low: this.stocks.filter(s => s.status === 'low').length,
                critical: this.stocks.filter(s => s.status === 'critical').length,
                out: this.stocks.filter(s => s.status === 'out').length,
            };
        },
        statusConfig(status) {
            const map = {
                normal: { cls: 'bg-green-50 text-green-700 border-green-100', label: 'Bình thường', icon: 'fa-check' },
                low: { cls: 'bg-yellow-50 text-yellow-700 border-yellow-100', label: 'Sắp hết', icon: 'fa-exclamation' },
                critical: { cls: 'bg-red-50 text-red-600 border-red-100', label: 'Nguy hiểm', icon: 'fa-times' },
                out: { cls: 'bg-gray-100 text-gray-500 border-gray-200', label: 'Hết hàng', icon: 'fa-ban' },
            };
            return map[status] || map.normal;
        },
        qtyColor(s) {
            if (s.status === 'out') return 'text-gray-400';
            if (s.status === 'critical') return 'text-red-600 font-bold';
            if (s.status === 'low') return 'text-yellow-600 font-bold';
            return 'text-gray-800 font-semibold';
        },
        progressPct(s) {
            if (s.minQty === 0) return 100;
            return Math.min(100, Math.round((s.qty / (s.minQty * 3)) * 100));
        },
        progressColor(s) {
            if (s.status === 'out') return 'bg-gray-300';
            if (s.status === 'critical') return 'bg-red-500';
            if (s.status === 'low') return 'bg-yellow-500';
            return 'bg-green-500';
        }
     }">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/WarehouseStaff/Home/Index" class="text-gray-400 hover:text-gray-600 text-sm transition">
                    <i class="fas fa-home"></i>
                </a>
                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                <span class="text-sm font-medium text-gray-500">Tồn Kho Hiện Tại</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Tồn Kho Hiện Tại</h1>
            <p class="text-sm text-gray-500 mt-1">Tổng quan tồn kho theo thời gian thực</p>
        </div>
        <div class="flex gap-2">
            <a href="/WarehouseStaff/Requisition/Create"
               class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold transition shadow-sm">
                <i class="fas fa-plus"></i> Tạo Phiếu Đề Xuất
            </a>
        </div>
    </div>

    <!-- KPI Strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div x-on:click="filterStatus = 'all'" :class="filterStatus === 'all' ? 'border-amber-400 ring-2 ring-amber-100' : 'border-gray-100'"
             class="bg-white rounded-2xl border shadow-sm px-5 py-4 cursor-pointer hover:border-amber-300 transition">
            <div class="text-2xl font-bold text-gray-900" x-text="stocks.length"></div>
            <div class="text-xs text-gray-500 font-medium mt-0.5">Tổng mặt hàng</div>
        </div>
        <div x-on:click="filterStatus = 'low'" :class="filterStatus === 'low' ? 'border-yellow-400 ring-2 ring-yellow-100' : 'border-yellow-100'"
             class="bg-white rounded-2xl border shadow-sm px-5 py-4 cursor-pointer hover:border-yellow-300 transition">
            <div class="text-2xl font-bold text-yellow-600" x-text="counts.low"></div>
            <div class="text-xs text-gray-500 font-medium mt-0.5">Sắp hết</div>
        </div>
        <div x-on:click="filterStatus = 'critical'" :class="filterStatus === 'critical' ? 'border-red-400 ring-2 ring-red-100' : 'border-red-100'"
             class="bg-white rounded-2xl border shadow-sm px-5 py-4 cursor-pointer hover:border-red-300 transition">
            <div class="text-2xl font-bold text-red-600" x-text="counts.critical"></div>
            <div class="text-xs text-gray-500 font-medium mt-0.5">Nguy hiểm</div>
        </div>
        <div x-on:click="filterStatus = 'out'" :class="filterStatus === 'out' ? 'border-gray-400 ring-2 ring-gray-100' : 'border-gray-100'"
             class="bg-white rounded-2xl border shadow-sm px-5 py-4 cursor-pointer hover:border-gray-300 transition">
            <div class="text-2xl font-bold text-gray-500" x-text="counts.out"></div>
            <div class="text-xs text-gray-500 font-medium mt-0.5">Hết hàng</div>
        </div>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

        <!-- Toolbar -->
        <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
            <!-- Category filter -->
            <div class="flex gap-1.5 flex-wrap">
                <template x-for="cat in categories" :key="cat">
                    <button type="button"
                            x-on:click="filterCategory = cat"
                            :class="filterCategory === cat ? 'bg-amber-500 text-white shadow-sm' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition"
                            x-text="cat === 'all' ? 'Tất cả' : cat">
                    </button>
                </template>
            </div>
            <!-- Search -->
            <div class="relative w-full sm:w-60 shrink-0">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                <input type="text" x-model="search" placeholder="Tìm tên hoặc số LOT..."
                       class="w-full pl-8 pr-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition bg-gray-50" />
            </div>
        </div>

        <!-- Table content -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-gray-50 text-gray-500 text-[11px] uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-5 py-3.5 border-b border-gray-100">Tên NVL</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Danh mục</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Vị trí Kho</th>
                        <th class="px-5 py-3.5 border-b border-gray-100 text-right">Tồn Kho</th>
                        <th class="px-5 py-3.5 border-b border-gray-100 w-32">Mức Tồn</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Hạn Sử Dụng</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Trạng Thái</th>
                        <th class="px-5 py-3.5 border-b border-gray-100 text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-gray-700">
                    <template x-for="item in filtered" :key="item.id">
                        <tr class="hover:bg-amber-50/20 transition group">
                            <td class="px-5 py-3.5">
                                <div class="font-semibold text-gray-900" x-text="item.name"></div>
                                <div class="text-[11px] text-gray-400 font-mono" x-text="item.lot"></div>
                            </td>
                            <td class="px-5 py-3.5 text-gray-500" x-text="item.category"></td>
                            <td class="px-5 py-3.5">
                                <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-600 text-xs font-mono font-bold" x-text="item.location"></span>
                            </td>
                            <td class="px-5 py-3.5 text-right">
                                <span :class="qtyColor(item)" x-text="item.qty === 0 ? '—' : item.qty + ' ' + item.unit"></span>
                                <div class="text-[10px] text-gray-400 text-right" x-text="'Tối thiểu: ' + item.minQty + ' ' + item.unit"></div>
                            </td>
                            <td class="px-5 py-3.5 w-32">
                                <div class="w-full bg-gray-100 rounded-full h-1.5">
                                    <div :class="progressColor(item)"
                                         class="h-1.5 rounded-full transition-all"
                                         :style="'width: ' + progressPct(item) + '%'">
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-3.5">
                                <span class="text-gray-600" x-text="item.expiry"></span>
                            </td>
                            <td class="px-5 py-3.5">
                                <span :class="statusConfig(item.status).cls"
                                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold border">
                                    <i :class="'fas ' + statusConfig(item.status).icon + ' text-[9px]'"></i>
                                    <span x-text="statusConfig(item.status).label"></span>
                                </span>
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                <a href="/WarehouseStaff/Requisition/Create"
                                   class="text-amber-600 hover:text-amber-800 text-xs font-semibold transition opacity-0 group-hover:opacity-100">
                                    Tạo phiếu
                                </a>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="filtered.length === 0">
                        <td colspan="8" class="text-center py-16 text-gray-400">
                            <i class="fas fa-search text-3xl mb-3 block text-gray-200"></i>
                            <p class="text-sm font-medium">Không tìm thấy mặt hàng phù hợp</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="px-6 py-3.5 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
            <p class="text-xs text-gray-500 font-medium">
                Hiển thị <span class="font-bold text-amber-700" x-text="filtered.length"></span>
                / <span x-text="stocks.length"></span> mặt hàng
            </p>
            <p class="text-[10px] text-gray-400">Cập nhật lần cuối: @DateTime.Now.ToString("HH:mm - dd/MM/yyyy")</p>
        </div>
    </div>
</div>
