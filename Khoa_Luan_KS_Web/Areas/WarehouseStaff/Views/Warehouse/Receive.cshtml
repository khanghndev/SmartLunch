@{
    ViewData["Title"] = "Nhập Kho Thực Tế";
    Layout = "_LayoutWarehouse";
}

<div class="px-1 space-y-6"
     x-data="{
        showReceiveModal: false,
        selectedReq: null,
        confirming: false,
        pendingReceipts: [
            { id: 'PX-2405-007', supplier: 'CP Vietnam Food', date: '07/05/2026', approvedAt: '07/05/2026 09:00', items: [
                { name: 'Gạo tẻ thường', unit: 'kg', qty: 200, qtyActual: 200, expiry: '2026-11-07', lot: 'LOT-CP-001' },
                { name: 'Đường tinh luyện', unit: 'kg', qty: 50, qtyActual: 50, expiry: '2027-05-07', lot: 'LOT-DT-002' },
                { name: 'Dầu ăn Neptune', unit: 'thùng', qty: 10, qtyActual: 10, expiry: '2027-01-07', lot: 'LOT-DA-003' }
            ]},
            { id: 'PX-2405-004', supplier: 'Vissan', date: '04/05/2026', approvedAt: '04/05/2026 08:45', items: [
                { name: 'Xúc xích tiệt trùng', unit: 'thùng', qty: 5, qtyActual: 5, expiry: '2026-08-04', lot: 'LOT-XS-001' },
                { name: 'Thịt heo xay sẵn', unit: 'kg', qty: 30, qtyActual: 30, expiry: '2026-05-10', lot: 'LOT-TH-002' },
                { name: 'Chả giò chiên', unit: 'túi', qty: 20, qtyActual: 20, expiry: '2026-07-04', lot: 'LOT-CG-003' },
                { name: 'Nem chua rán', unit: 'túi', qty: 15, qtyActual: 15, expiry: '2026-06-15', lot: 'LOT-NC-004' }
            ]},
            { id: 'PX-2405-003', supplier: 'Masan Consumer', date: '03/05/2026', approvedAt: '03/05/2026 11:00', items: [
                { name: 'Hạt nêm Maggi', unit: 'thùng', qty: 8, qtyActual: 8, expiry: '2027-03-03', lot: 'LOT-HN-001' }
            ]}
        ],
        openReceive(req) {
            this.selectedReq = JSON.parse(JSON.stringify(req));
            this.showReceiveModal = true;
        },
        submitReceive() {
            this.confirming = true;
            setTimeout(() => {
                this.showReceiveModal = false;
                this.confirming = false;
                this.pendingReceipts = this.pendingReceipts.filter(r => r.id !== this.selectedReq.id);
                alert('Đã xác nhận nhập kho phiếu #' + this.selectedReq.id + ' thành công! Tồn kho đã được cập nhật.');
            }, 1200);
        }
     }">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/WarehouseStaff/Home/Index" class="text-gray-400 hover:text-gray-600 text-sm transition">
                    <i class="fas fa-home"></i>
                </a>
                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                <span class="text-sm font-medium text-gray-500">Nhập Kho Thực Tế</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Nhập Kho Thực Tế</h1>
            <p class="text-sm text-gray-500 mt-1">Xác nhận nhập kho cho các phiếu đã được Manager phê duyệt</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 text-sm font-bold">
                <i class="fas fa-clock text-amber-500"></i>
                <span x-text="pendingReceipts.length + ' phiếu chờ nhập'"></span>
            </span>
        </div>
    </div>

    <!-- Info banner -->
    <div class="flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-2xl">
        <i class="fas fa-info-circle text-amber-600 mt-0.5 shrink-0 text-lg"></i>
        <div class="text-sm text-amber-800 font-medium leading-relaxed">
            Chỉ hiển thị các phiếu đã được <strong>Manager phê duyệt</strong> và chưa nhập kho.
            Sau khi xác nhận, tồn kho sẽ được cập nhật tự động.
        </div>
    </div>

    <!-- Danh sách phiếu chờ nhập -->
    <div class="space-y-5">
        <template x-for="req in pendingReceipts" :key="req.id">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:border-amber-200 transition group">

                <!-- Card Header -->
                <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gradient-to-r from-amber-50/60 to-white">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center shrink-0">
                            <i class="fas fa-file-invoice text-amber-600"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-bold text-gray-900 text-sm" x-text="'#' + req.id"></span>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-[10px] font-bold border border-green-100">
                                    <i class="fas fa-check text-[8px]"></i> Đã duyệt
                                </span>
                            </div>
                            <p class="text-xs text-gray-500 mt-0.5">
                                <span x-text="'NCC: ' + req.supplier"></span>
                                &nbsp;·&nbsp;
                                <span x-text="'Duyệt lúc: ' + req.approvedAt"></span>
                            </p>
                        </div>
                    </div>
                    <button type="button" x-on:click="openReceive(req)"
                            class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold transition shadow-sm shrink-0">
                        <i class="fas fa-truck-loading"></i> Xác Nhận Nhập Kho
                    </button>
                </div>

                <!-- Items preview -->
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left whitespace-nowrap">
                        <thead class="bg-gray-50 text-[11px] text-gray-500 uppercase font-bold tracking-wider">
                            <tr>
                                <th class="px-5 py-3 border-b border-gray-100">Tên Nguyên Vật Liệu</th>
                                <th class="px-5 py-3 border-b border-gray-100">Đơn vị</th>
                                <th class="px-5 py-3 border-b border-gray-100 text-right">SL Đề Xuất</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 text-gray-700">
                            <template x-for="(item, idx) in req.items.slice(0, 3)" :key="idx">
                                <tr class="hover:bg-gray-50/50 transition">
                                    <td class="px-5 py-3 font-medium text-gray-800" x-text="item.name"></td>
                                    <td class="px-5 py-3 text-gray-500" x-text="item.unit"></td>
                                    <td class="px-5 py-3 text-right font-semibold text-gray-700" x-text="item.qty"></td>
                                </tr>
                            </template>
                            <template x-if="req.items.length > 3">
                                <tr>
                                    <td colspan="3" class="px-5 py-2.5 text-xs text-amber-600 font-semibold text-center bg-amber-50/30">
                                        + <span x-text="req.items.length - 3"></span> mặt hàng khác — Nhấn "Xác nhận" để xem đầy đủ
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </template>

        <!-- Empty state -->
        <div x-show="pendingReceipts.length === 0" class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-green-50 flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-check-double text-green-500 text-2xl"></i>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Tất cả đã nhập kho!</h3>
            <p class="text-sm text-gray-500">Không còn phiếu nào chờ nhập kho.</p>
            <a href="/WarehouseStaff/Warehouse/Stock"
               class="mt-4 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 text-white font-semibold text-sm hover:bg-amber-600 transition">
                <i class="fas fa-boxes"></i> Xem tồn kho
            </a>
        </div>
    </div>

    <!-- Modal xác nhận nhập kho -->
    <div x-show="showReceiveModal" x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center p-4"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" x-on:click="!confirming && (showReceiveModal = false)"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl z-10 max-h-[90vh] flex flex-col"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100 shrink-0">
                <div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-0.5">Xác nhận nhập kho</p>
                    <h3 class="font-bold text-gray-900 text-lg" x-text="selectedReq ? '#' + selectedReq.id : ''"></h3>
                </div>
                <button x-on:click="showReceiveModal = false" :disabled="confirming"
                        class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 transition disabled:opacity-40">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="overflow-y-auto flex-1 p-6">
                <p class="text-sm text-gray-600 mb-4">
                    Nhập <strong>số lượng thực tế</strong>, <strong>số lô (LOT)</strong> và <strong>hạn sử dụng</strong> cho từng mặt hàng:
                </p>

                <div class="space-y-3" x-show="selectedReq">
                    <template x-for="(item, idx) in (selectedReq ? selectedReq.items : [])" :key="idx">
                        <div class="border border-gray-100 rounded-xl p-4 bg-gray-50/50">
                            <div class="flex items-center justify-between mb-3">
                                <h4 class="font-semibold text-gray-900 text-sm" x-text="item.name"></h4>
                                <span class="text-xs text-gray-500 font-medium">
                                    Đề xuất: <span class="font-bold text-amber-700" x-text="item.qty + ' ' + item.unit"></span>
                                </span>
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <div>
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">SL Thực Nhận *</label>
                                    <div class="flex items-center gap-1">
                                        <input type="number" x-model="item.qtyActual" :placeholder="item.qty"
                                               class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition" />
                                        <span class="text-xs text-gray-400 whitespace-nowrap" x-text="item.unit"></span>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Số Lô (LOT)</label>
                                    <input type="text" x-model="item.lot" placeholder="VD: LOT-001"
                                           class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Hạn Sử Dụng</label>
                                    <input type="date" x-model="item.expiry"
                                           class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition" />
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-gray-100 shrink-0 flex gap-3">
                <button type="button" x-on:click="showReceiveModal = false" :disabled="confirming"
                        class="flex-1 py-3 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 font-semibold text-sm transition disabled:opacity-40">
                    Hủy
                </button>
                <button type="button" x-on:click="submitReceive()" :disabled="confirming"
                        class="flex-1 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 disabled:opacity-70 text-white font-bold text-sm transition shadow-sm flex items-center justify-center gap-2">
                    <template x-if="confirming">
                        <i class="fas fa-spinner fa-spin"></i>
                    </template>
                    <template x-if="!confirming">
                        <i class="fas fa-check-double"></i>
                    </template>
                    <span x-text="confirming ? 'Đang cập nhật...' : 'Xác Nhận Nhập Kho'"></span>
                </button>
            </div>
        </div>
    </div>

</div>
