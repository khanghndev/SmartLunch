@model List<Khoa_Luan_KS_Web.Services.IntakeProposalDetailClientDto>
@{
    ViewData["Title"] = "Nhập Kho Thực Tế";
    Layout = "_LayoutWarehouse";
}

<div class="px-1 space-y-6" x-data="{ confirmingId: null }">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/WarehouseStaff/Home/Index" class="text-gray-400 hover:text-gray-600 text-sm transition"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                <span class="text-sm font-medium text-gray-500">Nhập Kho Thực Tế</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Nhập Kho Thực Tế</h1>
            <p class="text-sm text-gray-500 mt-1">Xác nhận nhập kho cho các phiếu đã được Manager phê duyệt</p>
        </div>
        <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 text-sm font-bold">
            <i class="fas fa-clock text-amber-500"></i> @Model.Count phiếu chờ nhập
        </span>
    </div>

    <!-- Info banner -->
    <div class="flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-2xl">
        <i class="fas fa-info-circle text-amber-600 mt-0.5 shrink-0 text-lg"></i>
        <div class="text-sm text-amber-800 font-medium leading-relaxed">
            Chỉ hiển thị các phiếu đã được <strong>Manager phê duyệt</strong> và chưa nhập kho.
            Sau khi xác nhận, tồn kho sẽ được cập nhật tự động.
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-green-50 flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-check-double text-green-500 text-2xl"></i>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Tất cả đã nhập kho!</h3>
            <p class="text-sm text-gray-500">Không còn phiếu nào chờ nhập kho.</p>
            <a href="/WarehouseStaff/Inventory/Index" class="mt-4 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 text-white font-semibold text-sm hover:bg-amber-600 transition">
                <i class="fas fa-boxes"></i> Xem tồn kho
            </a>
        </div>
    }

    <div class="space-y-5">
        @foreach (var p in Model)
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:border-amber-200 transition">
                <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gradient-to-r from-amber-50/60 to-white">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center shrink-0">
                            <i class="fas fa-file-invoice text-amber-600"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-bold text-gray-900 text-sm">#@p.ProposalCode</span>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-[10px] font-bold border border-green-100">
                                    <i class="fas fa-check text-[8px]"></i> Đã duyệt
                                </span>
                            </div>
                            <p class="text-xs text-gray-500 mt-0.5">
                                Người tạo: @(p.CreatedByDisplayName ?? $"User#{p.CreatedByUserId}")
                                @if (p.ReviewedAt.HasValue) { <text>&nbsp;·&nbsp;Duyệt: @p.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm")</text> }
                            </p>
                        </div>
                    </div>
                    <div class="flex gap-2 items-center">
                        <a href="/WarehouseStaff/Requisition/Detail/@p.Id" class="px-3 py-2 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 text-xs font-semibold transition">
                            <i class="fas fa-eye mr-1"></i> Chi tiết
                        </a>
                        <button type="button" x-on:click="confirmingId = @p.Id"
                                class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold transition shadow-sm shrink-0">
                            <i class="fas fa-truck-loading"></i> Xác Nhận Nhập Kho
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left whitespace-nowrap">
                        <thead class="bg-gray-50 text-[11px] text-gray-500 uppercase font-bold tracking-wider">
                            <tr>
                                <th class="px-5 py-3 border-b border-gray-100">Tên Nguyên Liệu</th>
                                <th class="px-5 py-3 border-b border-gray-100">Đơn vị</th>
                                <th class="px-5 py-3 border-b border-gray-100 text-right">Số Lượng Đề Xuất</th>
                                <th class="px-5 py-3 border-b border-gray-100">Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 text-gray-700">
                            @foreach (var line in p.Lines)
                            {
                                <tr class="hover:bg-gray-50/50 transition">
                                    <td class="px-5 py-3 font-medium text-gray-800">@line.IngredientName</td>
                                    <td class="px-5 py-3 text-gray-500">@line.Unit</td>
                                    <td class="px-5 py-3 text-right font-semibold text-amber-700">@line.Quantity @line.Unit</td>
                                    <td class="px-5 py-3 text-gray-500">@(line.LineNote ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(p.HeaderNote))
                {
                    <div class="px-6 py-3 border-t border-amber-100 bg-amber-50/40 text-xs text-amber-800">
                        <i class="fas fa-sticky-note mr-1"></i> <strong>Ghi chú:</strong> @p.HeaderNote
                    </div>
                }

                <!-- Inline confirm panel -->
                <div x-show="confirmingId === @p.Id" x-cloak x-transition class="border-t border-amber-200 bg-amber-50/50 px-6 py-5">
                    <form method="post" action="/WarehouseStaff/Warehouse/ConfirmReceive">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="proposalId" value="@p.Id" />

                        <h4 class="font-bold text-amber-900 text-sm mb-3 flex items-center gap-2">
                            <i class="fas fa-clipboard-check"></i> Xác nhận nhập kho phiếu #@p.ProposalCode
                        </h4>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
                            <div class="md:col-span-2">
                                <label class="block text-[10px] font-bold text-amber-700 uppercase tracking-wide mb-1">Ghi chú nhập kho (tùy chọn)</label>
                                <input type="text" name="note" placeholder="VD: Hàng đạt chuẩn, đã kiểm tra VSATTP..."
                                       class="w-full px-3 py-2 border border-amber-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition bg-white" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-amber-700 uppercase tracking-wide mb-1">Thời điểm nhận</label>
                                <input type="text" readonly value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")" class="w-full px-3 py-2 border border-amber-200 rounded-lg text-sm bg-white text-gray-600" />
                            </div>
                        </div>

                        <label class="flex items-start gap-2 mb-4 cursor-pointer">
                            <input type="checkbox" name="confirmStandard" value="true" required class="mt-0.5 w-4 h-4 rounded border-gray-300 text-amber-500 focus:ring-amber-500" />
                            <span class="text-sm text-gray-700 font-medium">
                                Tôi xác nhận đã kiểm tra và <strong>nguyên liệu nhập đạt chuẩn</strong> theo phiếu đã duyệt (số lượng, chất lượng, VSATTP).
                            </span>
                        </label>

                        <div class="flex gap-2">
                            <button type="button" x-on:click="confirmingId = null"
                                    class="px-4 py-2 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 font-semibold text-sm transition">
                                Hủy
                            </button>
                            <button type="submit"
                                    class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm transition shadow-sm flex items-center gap-2">
                                <i class="fas fa-check-double"></i> Hoàn tất Nhập Kho
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
