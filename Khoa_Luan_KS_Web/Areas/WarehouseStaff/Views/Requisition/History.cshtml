@{
    ViewData["Title"] = "Lịch Sử Phiếu Duyệt";
    Layout = "_LayoutWarehouse";
}

<div class="px-1 space-y-6" x-data="{ activeTab: 'all', search: '', showDetail: false, selectedReq: null,
    requisitions: [
        { id: 'PX-2405-007', type: 'import', typeLabel: 'Nhập kho', date: '07/05/2026', status: 'approved', statusLabel: 'Đã duyệt', items: 3, note: 'Nhập gạo và đường', approver: 'Nguyễn Văn Quản Lý', approvedAt: '07/05/2026 09:00', reason: '' },
        { id: 'PX-2405-006', type: 'export', typeLabel: 'Xuất kho', date: '06/05/2026', status: 'pending', statusLabel: 'Chờ duyệt', items: 2, note: 'Xuất cho bộ phận bếp', approver: '', approvedAt: '', reason: '' },
        { id: 'PX-2405-005', type: 'import', typeLabel: 'Nhập kho', date: '05/05/2026', status: 'rejected', statusLabel: 'Từ chối', items: 5, note: 'Nhập thịt cá tươi', approver: 'Nguyễn Văn Quản Lý', approvedAt: '05/05/2026 14:30', reason: 'Số lượng vượt định mức tháng. Cần xem lại và điều chỉnh.' },
        { id: 'PX-2405-004', type: 'import', typeLabel: 'Nhập kho', date: '04/05/2026', status: 'approved', statusLabel: 'Đã duyệt', items: 4, note: 'Nhập gia vị và dầu ăn', approver: 'Nguyễn Văn Quản Lý', approvedAt: '04/05/2026 08:45', reason: '' },
        { id: 'PX-2405-003', type: 'export', typeLabel: 'Xuất kho', date: '03/05/2026', status: 'approved', statusLabel: 'Đã duyệt', items: 1, note: 'Xuất cho phòng bếp A', approver: 'Nguyễn Văn Quản Lý', approvedAt: '03/05/2026 11:00', reason: '' },
        { id: 'PX-2405-002', type: 'import', typeLabel: 'Nhập kho', date: '02/05/2026', status: 'pending', statusLabel: 'Chờ duyệt', items: 6, note: 'Nhập lô rau củ', approver: '', approvedAt: '', reason: '' },
        { id: 'PX-2405-001', type: 'import', typeLabel: 'Nhập kho', date: '01/05/2026', status: 'rejected', statusLabel: 'Từ chối', items: 2, note: 'Nhập gà tươi từ CP', approver: 'Trần Thị Quản Lý', approvedAt: '01/05/2026 10:00', reason: 'NCC chưa có giấy kiểm định VSATTP cho lô hàng này.' }
    ],
    get filtered() {
        return this.requisitions.filter(r => {
            const matchTab = this.activeTab === 'all' || r.status === this.activeTab;
            const matchSearch = !this.search || r.id.toLowerCase().includes(this.search.toLowerCase()) || r.note.toLowerCase().includes(this.search.toLowerCase());
            return matchTab && matchSearch;
        });
    },
    get countByStatus() {
        return {
            all: this.requisitions.length,
            pending: this.requisitions.filter(r => r.status === 'pending').length,
            approved: this.requisitions.filter(r => r.status === 'approved').length,
            rejected: this.requisitions.filter(r => r.status === 'rejected').length,
        };
    },
    openDetail(req) { this.selectedReq = req; this.showDetail = true; },
    statusBadge(status) {
        if (status === 'approved') return 'bg-green-50 text-green-700 border-green-100';
        if (status === 'pending') return 'bg-yellow-50 text-yellow-700 border-yellow-100';
        return 'bg-red-50 text-red-600 border-red-100';
    },
    statusIcon(status) {
        if (status === 'approved') return 'fa-check';
        if (status === 'pending') return 'fa-hourglass-half';
        return 'fa-times';
    }
}">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/WarehouseStaff/Home/Index" class="text-gray-400 hover:text-gray-600 text-sm transition">
                    <i class="fas fa-home"></i>
                </a>
                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                <span class="text-sm font-medium text-gray-500">Lịch sử Phiếu Duyệt</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Lịch Sử Phiếu Duyệt</h1>
            <p class="text-sm text-gray-500 mt-1">Xem trạng thái và kết quả duyệt của tất cả phiếu đề xuất</p>
        </div>
        <a href="/WarehouseStaff/Requisition/Create"
           class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold transition shadow-sm">
            <i class="fas fa-plus"></i> Tạo Phiếu Mới
        </a>
    </div>

    <!-- Stats strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm px-5 py-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-gray-100 flex items-center justify-center shrink-0">
                <i class="fas fa-file-alt text-gray-500 text-sm"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-gray-900" x-text="countByStatus.all"></div>
                <div class="text-xs text-gray-500 font-medium">Tổng phiếu</div>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-yellow-100 shadow-sm px-5 py-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-yellow-50 flex items-center justify-center shrink-0">
                <i class="fas fa-hourglass-half text-yellow-600 text-sm"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-yellow-600" x-text="countByStatus.pending"></div>
                <div class="text-xs text-gray-500 font-medium">Chờ duyệt</div>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-green-100 shadow-sm px-5 py-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-green-50 flex items-center justify-center shrink-0">
                <i class="fas fa-check-circle text-green-600 text-sm"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-green-600" x-text="countByStatus.approved"></div>
                <div class="text-xs text-gray-500 font-medium">Đã duyệt</div>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-red-100 shadow-sm px-5 py-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-red-50 flex items-center justify-center shrink-0">
                <i class="fas fa-times-circle text-red-500 text-sm"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-red-500" x-text="countByStatus.rejected"></div>
                <div class="text-xs text-gray-500 font-medium">Từ chối</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

        <!-- Toolbar -->
        <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
            <!-- Tabs -->
            <div class="flex gap-1 bg-gray-100 rounded-xl p-1 w-fit">
                <template x-for="tab in [{key:'all',label:'Tất cả'},{key:'pending',label:'Chờ duyệt'},{key:'approved',label:'Đã duyệt'},{key:'rejected',label:'Từ chối'}]" :key="tab.key">
                    <button type="button"
                            x-on:click="activeTab = tab.key"
                            :class="activeTab === tab.key ? 'bg-white shadow text-amber-700 font-bold' : 'text-gray-500 hover:text-gray-700'"
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition"
                            x-text="tab.label">
                    </button>
                </template>
            </div>
            <!-- Search -->
            <div class="relative w-full sm:w-56">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                <input type="text" x-model="search" placeholder="Tìm mã hoặc ghi chú..."
                       class="w-full pl-8 pr-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition bg-gray-50" />
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-gray-50 text-gray-500 text-[11px] uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-5 py-3.5 border-b border-gray-100">Mã Phiếu</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Loại</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Ngày Tạo</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Số NVL</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Ghi Chú</th>
                        <th class="px-5 py-3.5 border-b border-gray-100">Trạng Thái</th>
                        <th class="px-5 py-3.5 border-b border-gray-100 text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-gray-700">
                    <template x-for="req in filtered" :key="req.id">
                        <tr class="hover:bg-amber-50/20 transition">
                            <td class="px-5 py-3.5">
                                <span class="font-mono font-semibold text-gray-800" x-text="'#' + req.id"></span>
                            </td>
                            <td class="px-5 py-3.5">
                                <span :class="req.type === 'import' ? 'bg-blue-50 text-blue-700 border-blue-100' : 'bg-orange-50 text-orange-700 border-orange-100'"
                                      class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold border">
                                    <i :class="req.type === 'import' ? 'fa-arrow-down' : 'fa-arrow-up'" class="fas text-[9px]"></i>
                                    <span x-text="req.typeLabel"></span>
                                </span>
                            </td>
                            <td class="px-5 py-3.5 text-gray-500 text-sm" x-text="req.date"></td>
                            <td class="px-5 py-3.5">
                                <span class="font-semibold text-gray-700" x-text="req.items + ' mặt hàng'"></span>
                            </td>
                            <td class="px-5 py-3.5 text-gray-500 max-w-[180px]">
                                <span class="truncate block" x-text="req.note"></span>
                            </td>
                            <td class="px-5 py-3.5">
                                <span :class="statusBadge(req.status)"
                                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold border">
                                    <i :class="'fas ' + statusIcon(req.status) + ' text-[9px]'"></i>
                                    <span x-text="req.statusLabel"></span>
                                </span>
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" x-on:click="openDetail(req)"
                                            class="text-amber-600 hover:text-amber-800 text-xs font-semibold transition hover:underline">
                                        Chi tiết
                                    </button>
                                    <template x-if="req.status === 'approved'">
                                        <a href="/WarehouseStaff/Warehouse/Receive"
                                           class="text-white bg-amber-500 hover:bg-amber-600 text-[11px] font-bold px-2.5 py-1 rounded-lg transition">
                                            Nhập kho
                                        </a>
                                    </template>
                                </div>
                            </td>
                        </tr>
                    </template>
                    <!-- Empty state -->
                    <tr x-show="filtered.length === 0">
                        <td colspan="7" class="text-center py-16 text-gray-400">
                            <i class="fas fa-inbox text-4xl mb-3 block text-gray-200"></i>
                            <p class="text-sm font-medium">Không có phiếu nào phù hợp</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Chi tiết -->
    <div x-show="showDetail" x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center p-4"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" x-on:click="showDetail = false"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg z-10" x-show="selectedReq"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100">
            <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
                <div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-0.5">Chi tiết phiếu</p>
                    <h3 class="font-bold text-gray-900 text-lg" x-text="selectedReq ? '#' + selectedReq.id : ''"></h3>
                </div>
                <button x-on:click="showDetail = false" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 transition">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
            <div class="p-6 space-y-4" x-show="selectedReq">
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-gray-50 rounded-xl p-3">
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Loại phiếu</p>
                        <p class="text-sm font-semibold text-gray-800" x-text="selectedReq?.typeLabel"></p>
                    </div>
                    <div class="bg-gray-50 rounded-xl p-3">
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Ngày tạo</p>
                        <p class="text-sm font-semibold text-gray-800" x-text="selectedReq?.date"></p>
                    </div>
                    <div class="bg-gray-50 rounded-xl p-3">
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Số mặt hàng</p>
                        <p class="text-sm font-semibold text-gray-800" x-text="selectedReq?.items + ' mặt hàng'"></p>
                    </div>
                    <div class="bg-gray-50 rounded-xl p-3">
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Trạng thái</p>
                        <span :class="selectedReq ? statusBadge(selectedReq.status) : ''"
                              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold border">
                            <i :class="selectedReq ? 'fas ' + statusIcon(selectedReq.status) + ' text-[9px]' : ''"></i>
                            <span x-text="selectedReq?.statusLabel"></span>
                        </span>
                    </div>
                </div>
                <div class="bg-gray-50 rounded-xl p-3">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Ghi chú</p>
                    <p class="text-sm text-gray-700" x-text="selectedReq?.note || '(Không có ghi chú)'"></p>
                </div>
                <template x-if="selectedReq && selectedReq.status !== 'pending'">
                    <div class="bg-gray-50 rounded-xl p-3">
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Người duyệt</p>
                        <p class="text-sm font-semibold text-gray-800" x-text="selectedReq?.approver"></p>
                        <p class="text-xs text-gray-500 mt-0.5" x-text="selectedReq?.approvedAt"></p>
                    </div>
                </template>
                <template x-if="selectedReq && selectedReq.status === 'rejected' && selectedReq.reason">
                    <div class="bg-red-50 border border-red-100 rounded-xl p-3">
                        <p class="text-[10px] font-bold text-red-500 uppercase tracking-wide mb-1 flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i> Lý do từ chối
                        </p>
                        <p class="text-sm text-red-700 font-medium" x-text="selectedReq?.reason"></p>
                    </div>
                </template>
            </div>
            <div class="px-6 pb-5 flex gap-2">
                <button x-on:click="showDetail = false"
                        class="flex-1 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 font-semibold text-sm transition">
                    Đóng
                </button>
                <template x-if="selectedReq && selectedReq.status === 'approved'">
                    <a href="/WarehouseStaff/Warehouse/Receive"
                       class="flex-1 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm text-center transition shadow-sm">
                        <i class="fas fa-truck-loading mr-1"></i> Nhập kho ngay
                    </a>
                </template>
            </div>
        </div>
    </div>

</div>
