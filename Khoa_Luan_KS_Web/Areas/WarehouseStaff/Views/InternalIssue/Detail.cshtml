@model Khoa_Luan_KS_Web.Services.InternalIssueDetailClientDto
@{
    ViewData["Title"] = $"Phiếu Xuất #{Model.IssueCode}";
    Layout = "_LayoutWarehouse";
}

<div class="px-1 space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/WarehouseStaff/Home/Index" class="text-gray-400 hover:text-gray-600 text-sm transition"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                <a href="/WarehouseStaff/InternalIssue/Index" class="text-gray-500 hover:text-gray-700 text-sm">Xuất nội bộ</a>
                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                <span class="text-sm font-medium text-gray-500">#@Model.IssueCode</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Phiếu Xuất Kho #@Model.IssueCode</h1>
            <p class="text-sm text-gray-500 mt-1">Chi tiết phiếu xuất kho nội bộ</p>
        </div>
        <a href="/WarehouseStaff/InternalIssue/Index" class="px-4 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 text-sm font-semibold transition">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại
        </a>
    </div>

    <!-- Header info -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <div class="flex items-center gap-3 mb-5">
            <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center">
                <i class="fas fa-dolly text-amber-600 text-lg"></i>
            </div>
            <div>
                <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Mã phiếu</div>
                <div class="font-mono font-bold text-lg text-gray-900">#@Model.IssueCode</div>
            </div>
            <span class="ml-auto inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-bold border border-blue-100">
                <i class="fas fa-check-circle"></i> Đã hoàn tất
            </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
            <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Ngày xuất</p>
                <p class="font-semibold text-gray-800">@Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Người tạo</p>
                <p class="font-semibold text-gray-800">@(Model.CreatedByDisplayName ?? (Model.CreatedByUserId.HasValue ? $"User#{Model.CreatedByUserId}" : "—"))</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Số dòng</p>
                <p class="font-semibold text-gray-800">@Model.Lines.Count NVL</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wide mb-1">Ngày ghi nhận</p>
                <p class="font-semibold text-gray-800">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Reason))
        {
            <div class="mt-4 bg-amber-50 rounded-xl p-3 border border-amber-100">
                <p class="text-[10px] font-bold text-amber-600 uppercase tracking-wide mb-1">Lý do xuất</p>
                <p class="text-sm text-amber-900">@Model.Reason</p>
            </div>
        }
    </div>

    <!-- Lines -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="font-bold text-gray-900 text-sm">Chi Tiết Nguyên Liệu Đã Xuất</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="bg-gray-50 text-[11px] text-gray-500 uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-5 py-3 border-b border-gray-100 w-12">#</th>
                        <th class="px-5 py-3 border-b border-gray-100">Tên Nguyên Liệu</th>
                        <th class="px-5 py-3 border-b border-gray-100">Đơn vị</th>
                        <th class="px-5 py-3 border-b border-gray-100 text-right">Số Lượng Xuất</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-gray-700">
                    @{ var idx = 0; }
                    @foreach (var line in Model.Lines)
                    {
                        idx++;
                        <tr class="hover:bg-gray-50/50 transition">
                            <td class="px-5 py-3 text-gray-400 font-mono">@idx</td>
                            <td class="px-5 py-3 font-medium text-gray-800">
                                <a href="/WarehouseStaff/Inventory/Detail/@line.IngredientId" class="hover:text-amber-600 transition">@line.IngredientName</a>
                            </td>
                            <td class="px-5 py-3 text-gray-500">@line.Unit</td>
                            <td class="px-5 py-3 text-right font-semibold text-amber-700">@line.Quantity @line.Unit</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
