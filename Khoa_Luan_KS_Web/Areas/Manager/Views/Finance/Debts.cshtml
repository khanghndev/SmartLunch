@model Khoa_Luan_KS_Web.Areas.Manager.Controllers.DebtsPageViewModel
@using Khoa_Luan_KS_Web.Areas.Manager.Controllers
@{
    ViewData["Title"] = "Quản lý Công Nợ";
    Layout = "_LayoutManager";

    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int pageSize = (int)(ViewData["PageSize"] ?? 20);
    string? searchTerm = ViewData["SearchTerm"] as string;
    string statusFilter = ViewData["StatusFilter"] as string ?? "all";
    decimal grandTotal = ViewData["GrandTotalOutstanding"] is decimal d ? d : 0m;
    int totalCount = Model?.TotalCount ?? 0;
    int totalPages = pageSize > 0 ? Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize)) : 1;
    var rows = Model?.Rows ?? new List<DebtRowViewModel>();

    string FormatMoney(decimal v) => v.ToString("N0") + " đ";

    string BuildUrl(int page, string? filter = null)
    {
        var f = filter ?? statusFilter;
        var q = $"?page={page}&pageSize={pageSize}&statusFilter={Uri.EscapeDataString(f)}";
        if (!string.IsNullOrEmpty(searchTerm)) q += $"&searchTerm={Uri.EscapeDataString(searchTerm)}";
        return q;
    }

    string StatusBadge(string ui) => ui switch {
        "Còn nợ" => "bg-yellow-50 text-yellow-700 border-yellow-200",
        "Đã thanh toán" => "bg-green-50 text-green-700 border-green-200",
        _ => "bg-slate-50 text-slate-600 border-slate-200"
    };

    string ContactText(DebtRowViewModel r)
    {
        if (!string.IsNullOrWhiteSpace(r.ContactPerson) && !string.IsNullOrWhiteSpace(r.Phone))
            return $"{r.ContactPerson} · {r.Phone}";
        return r.ContactPerson ?? r.Phone ?? "—";
    }
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="debtsPage()">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Theo dõi Công Nợ</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Công nợ phải thu từ khách hàng doanh nghiệp (tổng đơn − đã thu qua Payment).</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="text-sm text-red-700 bg-red-50 border border-red-100 rounded-xl px-4 py-3">@TempData["Error"]</div>
    }

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-2xl shadow-sm p-6 text-white sm:col-span-1">
            <p class="text-xs font-bold uppercase tracking-wider opacity-80">Tổng nợ chưa thu</p>
            <h3 class="text-3xl font-black mt-2">@FormatMoney(grandTotal)</h3>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Số đơn vị có công nợ</p>
            <h3 class="text-2xl font-black text-slate-800 mt-2">@rows.Count(r => r.Outstanding > 0.01m)</h3>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Tổng đã thu (trang hiện tại)</p>
            <h3 class="text-2xl font-black text-green-700 mt-2">@FormatMoney(rows.Sum(r => r.TotalPaid))</h3>
        </div>
    </div>

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <div class="p-4 border-b border-slate-100 flex flex-col lg:flex-row gap-4 justify-between items-start lg:items-center bg-slate-50/50">
            <form method="get" asp-area="Manager" asp-controller="Finance" asp-action="Debts" class="flex flex-wrap items-center gap-3 flex-1">
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@pageSize" />
                <input type="hidden" name="statusFilter" value="@statusFilter" />
                <div class="relative w-full sm:w-72">
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" name="searchTerm" value="@searchTerm" placeholder="Tìm tên khách hàng doanh nghiệp..."
                           class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500" />
                </div>
                <button type="submit" class="px-4 py-2 bg-slate-800 text-white text-sm font-bold rounded-xl hover:bg-slate-900">Tìm</button>
            </form>
            <div class="flex flex-wrap gap-2">
                @{
                    var tabs = new[] {
                        new { Key = "all", Label = "Tất cả" },
                        new { Key = "outstanding", Label = "Còn nợ" },
                        new { Key = "paid", Label = "Đã thanh toán" },
                    };
                }
                @foreach (var t in tabs)
                {
                    <a href="@BuildUrl(1, t.Key)"
                       class="px-3 py-1.5 text-xs font-bold rounded-full border transition-all @(statusFilter == t.Key ? "bg-slate-800 text-white border-slate-800" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                        @t.Label
                    </a>
                }
            </div>
        </div>

        @if (!rows.Any())
        {
            <div class="py-16 text-center text-slate-500">
                <p class="font-bold text-slate-700">Không có bản ghi công nợ</p>
                <p class="text-sm mt-1">Thử đổi bộ lọc hoặc tạo đơn hàng B2B để phát sinh công nợ.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-wider text-slate-400 font-black">
                            <th class="p-4 pl-6">Khách hàng / Doanh nghiệp</th>
                            <th class="p-4 text-right">Tổng đơn</th>
                            <th class="p-4 text-right">Đã thu</th>
                            <th class="p-4 text-right">Còn nợ</th>
                            <th class="p-4 text-center">Số đơn</th>
                            <th class="p-4 text-center">Trạng thái</th>
                            <th class="p-4 pr-6 text-right">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 text-sm">
                        @foreach (var debt in rows)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="p-4 pl-6">
                                    <div class="font-bold text-slate-800 text-base">@debt.OrganizationName</div>
                                    <div class="text-xs text-slate-500 font-medium mt-1">Liên hệ: @ContactText(debt)</div>
                                </td>
                                <td class="p-4 text-right font-medium text-slate-600">@FormatMoney(debt.TotalBilled)</td>
                                <td class="p-4 text-right font-bold text-green-700">@FormatMoney(debt.TotalPaid)</td>
                                <td class="p-4 text-right">
                                    <span class="font-black text-lg @(debt.Outstanding > 0.01m ? "text-red-600" : "text-slate-500")">@FormatMoney(debt.Outstanding)</span>
                                </td>
                                <td class="p-4 text-center font-bold text-slate-700">@debt.OrderCount</td>
                                <td class="p-4 text-center">
                                    <span class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-lg border @StatusBadge(debt.UiStatus)">@debt.UiStatus</span>
                                </td>
                                <td class="p-4 pr-6 text-right whitespace-nowrap space-x-2">
                                    <button type="button"
                                            @@click="openHistory(@debt.OrganizationId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(debt.OrganizationName)))"
                                            class="px-3 py-1.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg text-xs font-bold border border-blue-200">
                                        Lịch sử thu
                                    </button>
                                    <a href="/Manager/Catalog/CustomerDetail/@debt.OrganizationId"
                                       class="inline-block px-3 py-1.5 bg-slate-50 text-slate-700 hover:bg-slate-100 rounded-lg text-xs font-bold border border-slate-200">
                                        Chi tiết KH
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-5 py-3 border-t border-slate-100">
                    <p class="text-sm text-slate-500 font-medium">
                        Trang <span class="font-bold text-slate-700">@currentPage</span> / @totalPages
                        · Tổng <span class="font-bold">@totalCount</span> đơn vị
                    </p>
                    <div class="flex items-center gap-1.5 flex-wrap justify-center">
                        @if (currentPage > 1)
                        {
                            <a href="@BuildUrl(currentPage - 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">← Trước</a>
                        }
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            if (p == currentPage)
                            {
                                <span class="px-3 py-1.5 text-sm font-black text-white bg-green-600 rounded-lg">@p</span>
                            }
                            else
                            {
                                <a href="@BuildUrl(p)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">@p</a>
                            }
                        }
                        @if (currentPage < totalPages)
                        {
                            <a href="@BuildUrl(currentPage + 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">Sau →</a>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Modal lịch sử thanh toán -->
    <div x-show="historyModal.open" style="display:none;" class="relative z-50">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="closeHistory()"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-4">
            <div class="relative bg-white rounded-[28px] shadow-2xl w-full max-w-lg max-h-[80vh] flex flex-col" @@click.stop>
                <div class="px-6 py-5 border-b flex justify-between items-center shrink-0">
                    <div>
                        <h3 class="text-lg font-black text-slate-800">Lịch sử thanh toán</h3>
                        <p class="text-sm text-slate-500" x-text="historyModal.orgName"></p>
                    </div>
                    <button type="button" @@click="closeHistory()" class="text-slate-400 hover:text-slate-600">✕</button>
                </div>
                <div class="p-6 overflow-y-auto flex-1">
                    <div x-show="historyModal.loading" class="text-center text-slate-400 py-8">Đang tải...</div>
                    <div x-show="historyModal.error" class="text-sm text-red-600" x-text="historyModal.error"></div>
                    <template x-if="!historyModal.loading && historyModal.entries.length === 0 && !historyModal.error">
                        <p class="text-sm text-slate-500 text-center py-6">Chưa có khoản thu nào trong 6 tháng gần đây.</p>
                    </template>
                    <ul class="space-y-3">
                        <template x-for="e in historyModal.entries" :key="e.entryId">
                            <li class="flex justify-between items-center bg-slate-50 rounded-xl px-4 py-3 border border-slate-100">
                                <div>
                                    <p class="text-sm font-bold text-slate-800" x-text="formatMoney(e.amount)"></p>
                                    <p class="text-xs text-slate-500" x-text="formatDate(e.paymentDate) + ' · ' + (e.method || '')"></p>
                                    <p class="text-xs text-slate-400" x-show="e.orderId" x-text="'Đơn #' + e.orderId"></p>
                                </div>
                                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-green-50 text-green-700" x-text="e.status"></span>
                            </li>
                        </template>
                    </ul>
                </div>
                <div class="px-6 py-4 bg-slate-50 border-t rounded-b-[28px] shrink-0">
                    <p class="text-xs text-slate-500 mb-3">Thanh toán mới được ghi nhận khi khách thanh toán đơn (PayOS / webhook). Hệ thống chưa hỗ trợ ghi nhận thủ công qua API.</p>
                    <button type="button" @@click="closeHistory()" class="w-full py-2.5 rounded-xl bg-slate-800 text-white font-bold text-sm">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function debtsPage() {
    return {
        historyModal: { open: false, orgId: 0, orgName: '', loading: false, error: '', entries: [] },
        formatMoney(n) {
            const v = Number(n) || 0;
            return v.toLocaleString('vi-VN') + ' đ';
        },
        formatDate(iso) {
            const d = new Date(iso);
            return isNaN(d) ? '' : d.toLocaleString('vi-VN');
        },
        async openHistory(orgId, orgName) {
            this.historyModal = { open: true, orgId, orgName, loading: true, error: '', entries: [] };
            document.body.style.overflow = 'hidden';
            try {
                const res = await fetch('@Url.Action("PaymentHistory", "Finance", new { area = "Manager" })?organizationId=' + orgId);
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || 'Không tải được lịch sử');
                this.historyModal.entries = data.entries || [];
            } catch (e) {
                this.historyModal.error = e.message;
            } finally {
                this.historyModal.loading = false;
            }
        },
        closeHistory() {
            this.historyModal.open = false;
            document.body.style.overflow = '';
        }
    };
}
</script>
}
