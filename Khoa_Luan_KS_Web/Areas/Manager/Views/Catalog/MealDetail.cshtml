@model Khoa_Luan_KS_Web.Services.DishDetailResponse
@{
    ViewData["Title"] = Model.Dish.Name + " - Chi tiết Thực đơn";
    Layout = "_LayoutManager";
    var d = Model.Dish;

    string CategoryLabel(string? cat) => cat?.ToLower() switch {
        "man"         => "Món chính",
        "xao"         => "Xào / Chiên",
        "canh"        => "Canh / Súp",
        "trang_mieng" => "Tráng miệng",
        _             => cat ?? "Khác"
    };

    string CategoryBadge(string? cat) => cat?.ToLower() switch {
        "man"         => "bg-orange-100 text-orange-700 border-orange-200",
        "xao"         => "bg-yellow-100 text-yellow-700 border-yellow-200",
        "canh"        => "bg-blue-100 text-blue-700 border-blue-200",
        "trang_mieng" => "bg-pink-100 text-pink-700 border-pink-200",
        _             => "bg-slate-100 text-slate-600 border-slate-200"
    };

    // Compute a simple "nutrition score" 0–100
    decimal score = 0;
    int factors = 0;
    if (d.Calories.HasValue)  { score += Math.Min(d.Calories.Value / 10, 100); factors++; }
    if (d.Protein.HasValue)   { score += Math.Min(d.Protein.Value * 2, 100);   factors++; }
    if (d.Carbs.HasValue)     { score += Math.Min(d.Carbs.Value, 100);          factors++; }
    if (factors > 0) score = score / factors;
    var nutritionScore = (int)Math.Min(score, 100);
}

<div class="space-y-6 animate-in fade-in duration-500">

    <!-- ── Breadcrumb ── -->
    <nav class="flex items-center gap-2 text-xs font-bold text-slate-400">
        <a href="/Manager/Catalog/Meals" class="hover:text-green-600 transition-colors flex items-center gap-1">
            <i class="fas fa-utensils"></i> Thực đơn
        </a>
        <i class="fas fa-chevron-right text-[9px]"></i>
        <span class="text-slate-700">@d.Name</span>
    </nav>

    <!-- ── Top Section: Hero + Quick Info ── -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

        <!-- Image Card -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden h-full">
                @if (!string.IsNullOrEmpty(d.ImageUrl))
                {
                    <div class="relative h-64 lg:h-80 bg-slate-50">
                        <img id="main-dish-image" src="@d.ImageUrl" alt="@d.Name" class="w-full h-full object-cover transition-all duration-300" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                        <!-- Status pill -->
                        <div class="absolute top-4 right-4">
                            @if (d.IsActive)
                            {
                                <span class="flex items-center gap-1.5 px-3 py-1 bg-emerald-500 text-white text-[10px] font-black rounded-full uppercase tracking-widest">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Đang phục vụ
                                </span>
                            }
                            else
                            {
                                <span class="flex items-center gap-1.5 px-3 py-1 bg-red-500/90 text-white text-[10px] font-black rounded-full">
                                    <i class="fas fa-eye-slash text-[9px]"></i> Đã ẩn
                                </span>
                            }
                        </div>
                        <!-- Category bottom-left -->
                        <div class="absolute bottom-4 left-4">
                            <span class="text-[10px] font-black px-3 py-1 rounded-full border @CategoryBadge(d.Category) backdrop-blur-sm">
                                @CategoryLabel(d.Category)
                            </span>
                        </div>
                    </div>

                    @if (d.Images != null && d.Images.Count > 1)
                    {
                        <div class="p-3 border-t border-slate-50 flex items-center gap-2 overflow-x-auto">
                            @foreach (var img in d.Images.OrderByDescending(x => x.Role == "cover").ThenBy(x => x.SortOrder))
                            {
                                <button onclick="document.getElementById('main-dish-image').src = '@img.Url'"
                                        class="w-12 h-12 rounded-lg border border-slate-200 overflow-hidden shrink-0 hover:ring-2 hover:ring-green-500 transition-all focus:ring-2 focus:ring-green-500 outline-none">
                                    <img src="@img.Url" class="w-full h-full object-cover" />
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="h-64 lg:h-80 bg-slate-50 flex flex-col items-center justify-center text-slate-300 gap-3">
                        <i class="fas fa-image text-6xl"></i>
                        <p class="text-xs font-bold text-slate-400">Chưa có hình ảnh</p>
                    </div>
                }

                <!-- Price + Actions bar -->
                <div class="p-5 border-t border-slate-50 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-0.5">Đơn giá / suất</p>
                        <p class="text-2xl font-black text-green-600">@d.Price.ToString("N0") <span class="text-sm">₫</span></p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/Manager/Catalog/MealEdit/@d.Id"
                           class="flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-xs font-bold rounded-xl hover:bg-blue-700 transition-all shadow-md shadow-blue-100">
                            <i class="fas fa-pen"></i> Chỉnh sửa
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Info + Nutrition -->
        <div class="lg:col-span-3 flex flex-col gap-5">

            <!-- Title Card -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
                <div class="flex items-start justify-between gap-4 mb-3">
                    <div>
                        @if (!string.IsNullOrEmpty(d.Code))
                        {
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">@d.Code</p>
                        }
                        <h1 class="text-2xl font-black text-slate-900 leading-snug">@d.Name</h1>
                    </div>
                    @if (!string.IsNullOrEmpty(d.DietaryLabel))
                    {
                        <span class="shrink-0 px-3 py-1 bg-green-100 text-green-700 border border-green-200 text-[10px] font-black rounded-full uppercase tracking-widest">
                            @d.DietaryLabel
                        </span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(d.Description))
                {
                    <p class="text-sm text-slate-500 font-medium leading-relaxed">@d.Description</p>
                }
                <div class="mt-4 pt-4 border-t border-slate-50 flex items-center gap-4 text-xs text-slate-400 font-medium">
                    <span><i class="fas fa-calendar-alt mr-1"></i>Tạo: @d.CreatedAt.ToString("dd/MM/yyyy")</span>
                    @if (d.UpdatedAt.HasValue)
                    {
                        <span><i class="fas fa-pen mr-1"></i>Cập nhật: @d.UpdatedAt.Value.ToString("dd/MM/yyyy")</span>
                    }
                </div>
            </div>

            <!-- Nutrition Dashboard -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
                <div class="flex items-center justify-between mb-5">
                    <h2 class="text-sm font-black text-slate-900 flex items-center gap-2">
                        <i class="fas fa-chart-pie text-green-500"></i> Thành phần Dinh dưỡng / suất ăn
                    </h2>
                    <!-- Nutrition score ring -->
                    <div class="flex items-center gap-2">
                        <div class="relative w-12 h-12">
                            <svg viewBox="0 0 36 36" class="w-12 h-12 -rotate-90">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#f1f5f9" stroke-width="3" />
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#16a34a" stroke-width="3"
                                        stroke-dasharray="@nutritionScore, 100"
                                        stroke-linecap="round" />
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-[10px] font-black text-green-700">@nutritionScore</span>
                        </div>
                        <div>
                            <p class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Nutrition</p>
                            <p class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Score</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <!-- Calories -->
                    <div class="bg-gradient-to-br from-orange-50 to-orange-100/50 rounded-xl p-4 border border-orange-100">
                        <div class="flex items-center justify-between mb-2">
                            <i class="fas fa-fire-flame-curved text-orange-500 text-sm"></i>
                            <span class="text-[9px] font-black text-orange-400 uppercase tracking-widest">Năng lượng</span>
                        </div>
                        <p class="text-2xl font-black text-orange-700">@(d.Calories?.ToString("N0") ?? "—")</p>
                        <p class="text-[10px] font-bold text-orange-500 mt-0.5">kcal</p>
                        @if (d.Calories.HasValue)
                        {
                            <div class="mt-2 h-1 bg-orange-200 rounded-full overflow-hidden">
                                <div class="h-full bg-orange-500 rounded-full" style="width: @Math.Min((double)d.Calories.Value / 800 * 100, 100)%"></div>
                            </div>
                        }
                    </div>

                    <!-- Protein -->
                    <div class="bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-xl p-4 border border-blue-100">
                        <div class="flex items-center justify-between mb-2">
                            <i class="fas fa-dumbbell text-blue-500 text-sm"></i>
                            <span class="text-[9px] font-black text-blue-400 uppercase tracking-widest">Protein</span>
                        </div>
                        <p class="text-2xl font-black text-blue-700">@(d.Protein?.ToString("N1") ?? "—")</p>
                        <p class="text-[10px] font-bold text-blue-500 mt-0.5">gram</p>
                        @if (d.Protein.HasValue)
                        {
                            <div class="mt-2 h-1 bg-blue-200 rounded-full overflow-hidden">
                                <div class="h-full bg-blue-500 rounded-full" style="width: @Math.Min((double)d.Protein.Value / 60 * 100, 100)%"></div>
                            </div>
                        }
                    </div>

                    <!-- Carbs -->
                    <div class="bg-gradient-to-br from-amber-50 to-amber-100/50 rounded-xl p-4 border border-amber-100">
                        <div class="flex items-center justify-between mb-2">
                            <i class="fas fa-wheat-awn text-amber-500 text-sm"></i>
                            <span class="text-[9px] font-black text-amber-400 uppercase tracking-widest">Carbs</span>
                        </div>
                        <p class="text-2xl font-black text-amber-700">@(d.Carbs?.ToString("N1") ?? "—")</p>
                        <p class="text-[10px] font-bold text-amber-500 mt-0.5">gram</p>
                        @if (d.Carbs.HasValue)
                        {
                            <div class="mt-2 h-1 bg-amber-200 rounded-full overflow-hidden">
                                <div class="h-full bg-amber-500 rounded-full" style="width: @Math.Min((double)d.Carbs.Value / 100 * 100, 100)%"></div>
                            </div>
                        }
                    </div>

                    <!-- Fat -->
                    <div class="bg-gradient-to-br from-purple-50 to-purple-100/50 rounded-xl p-4 border border-purple-100">
                        <div class="flex items-center justify-between mb-2">
                            <i class="fas fa-droplet text-purple-500 text-sm"></i>
                            <span class="text-[9px] font-black text-purple-400 uppercase tracking-widest">Chất béo</span>
                        </div>
                        <p class="text-2xl font-black text-purple-700">@(d.Fat?.ToString("N1") ?? "—")</p>
                        <p class="text-[10px] font-bold text-purple-500 mt-0.5">gram</p>
                        @if (d.Fat.HasValue)
                        {
                            <div class="mt-2 h-1 bg-purple-200 rounded-full overflow-hidden">
                                <div class="h-full bg-purple-500 rounded-full" style="width: @Math.Min((double)d.Fat.Value / 50 * 100, 100)%"></div>
                            </div>
                        }
                    </div>
                </div>

                @if (!d.Calories.HasValue && !d.Protein.HasValue && !d.Carbs.HasValue && !d.Fat.HasValue)
                {
                    <div class="mt-4 flex items-center gap-3 p-3 bg-yellow-50 border border-yellow-100 rounded-xl text-xs text-yellow-700 font-bold">
                        <i class="fas fa-triangle-exclamation"></i>
                        Chưa cập nhật thông tin dinh dưỡng. <a href="/Manager/Catalog/MealEdit/@d.Id" class="underline hover:text-yellow-900">Cập nhật ngay</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ── Ingredient Quotas Table ── -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-50">
            <h2 class="text-sm font-black text-slate-900 flex items-center gap-2">
                <i class="fas fa-list-check text-green-500"></i>
                Định mức Nguyên liệu
                <span class="ml-1 bg-slate-100 text-slate-600 text-[10px] font-black px-2 py-0.5 rounded-full">
                    @Model.IngredientQuotas.Count nguyên liệu
                </span>
            </h2>
            <a href="#" class="flex items-center gap-1.5 text-xs font-bold text-green-600 hover:text-green-700 transition-colors">
                <i class="fas fa-plus text-[10px]"></i> Thêm nguyên liệu
            </a>
        </div>

        @if (!Model.IngredientQuotas.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-center gap-3">
                <div class="w-14 h-14 rounded-xl bg-slate-50 flex items-center justify-center text-slate-300">
                    <i class="fas fa-seedling text-2xl"></i>
                </div>
                <p class="text-sm font-bold text-slate-700">Chưa có định mức nguyên liệu</p>
                <p class="text-xs text-slate-400">Thêm nguyên liệu để tính toán chi phí và kiểm soát kho.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-slate-50/50">
                            <th class="px-6 py-3 text-[10px] font-black text-slate-400 uppercase tracking-widest">#</th>
                            <th class="px-6 py-3 text-[10px] font-black text-slate-400 uppercase tracking-widest">Nguyên liệu</th>
                            <th class="px-6 py-3 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Định lượng</th>
                            <th class="px-6 py-3 text-[10px] font-black text-slate-400 uppercase tracking-widest">Đơn vị</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @{int idx = 1;}
                        @foreach (var q in Model.IngredientQuotas)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors group">
                                <td class="px-6 py-3.5">
                                    <span class="w-6 h-6 rounded-lg bg-slate-100 text-slate-500 text-[10px] font-black flex items-center justify-center">@idx</span>
                                </td>
                                <td class="px-6 py-3.5">
                                    <p class="text-sm font-bold text-slate-800">@q.IngredientName</p>
                                    <p class="text-[10px] text-slate-400 font-medium">ID: @q.IngredientId</p>
                                </td>
                                <td class="px-6 py-3.5 text-right">
                                    <span class="text-base font-black text-slate-900">@q.Quantity.ToString("G29")</span>
                                </td>
                                <td class="px-6 py-3.5">
                                    <span class="inline-flex items-center px-2.5 py-0.5 bg-slate-100 text-slate-600 text-xs font-bold rounded-lg">
                                        @(q.Unit ?? "—")
                                    </span>
                                </td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- Total estimated cost row -->
            <div class="px-6 py-3 bg-slate-50/80 border-t border-slate-100 flex items-center justify-between">
                <p class="text-xs font-bold text-slate-500">
                    Tổng cộng: <span class="text-slate-900">@Model.IngredientQuotas.Count nguyên liệu</span>
                </p>
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Chi phí nguyên liệu sẽ được cập nhật theo bảng giá nhập</span>
            </div>
        }
    </div>

    <!-- ── Bottom Actions ── -->
    <div class="flex items-center justify-between pt-2">
        <a href="/Manager/Catalog/Meals"
           class="flex items-center gap-2 px-5 py-2.5 bg-slate-50 text-slate-600 hover:bg-slate-100 rounded-xl font-bold text-sm transition-all">
            <i class="fas fa-arrow-left text-xs"></i> Quay lại danh sách
        </a>
        <div class="flex gap-3">
            <form method="post" action="/Manager/Catalog/ToggleMealStatus"
                  onsubmit="return confirm('Xác nhận thay đổi trạng thái món ăn?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@d.Id" />
                <button type="submit"
                        class="flex items-center gap-2 px-5 py-2.5 @(d.IsActive ? "bg-red-50 text-red-600 hover:bg-red-100" : "bg-emerald-50 text-emerald-600 hover:bg-emerald-100") rounded-xl font-bold text-sm transition-all">
                    <i class="fas @(d.IsActive ? "fa-eye-slash" : "fa-eye") text-xs"></i>
                    @(d.IsActive ? "Ẩn khỏi Thực đơn" : "Hiện lại")
                </button>
            </form>
            <a href="/Manager/Catalog/MealEdit/@d.Id"
               class="flex items-center gap-2 px-6 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-xl font-bold text-sm transition-all shadow-lg shadow-green-100 active:scale-95">
                <i class="fas fa-pen text-xs"></i> Chỉnh sửa Thực đơn
            </a>
        </div>
    </div>
</div>
