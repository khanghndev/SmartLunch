@model Khoa_Luan_KS_Web.Services.PartnerDto
@{
    ViewData["Title"] = "Chi Tiết Đối Tác Cung Ứng";
    Layout = "_LayoutManager";
}

<div class="space-y-6 animate-in fade-in duration-700">
    <!-- Breadcrumb & Status Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <nav class="flex text-xs font-bold uppercase tracking-widest text-slate-400" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-2">
                <li>
                    <a href="/Manager/Catalog/Suppliers" class="hover:text-emerald-600 transition-colors flex items-center gap-2">
                        <i class="fas fa-truck-loading"></i> Nhà cung cấp
                    </a>
                </li>
                <li><i class="fas fa-chevron-right text-[8px] opacity-50"></i></li>
                <li class="text-slate-900">Chi tiết đối tác</li>
            </ol>
        </nav>
        <div class="flex items-center gap-2">
            @if (Model.IsActive)
            {
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[10px] font-black uppercase tracking-tighter text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">Đang hoạt động</span>
            }
            else
            {
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                <span class="text-[10px] font-black uppercase tracking-tighter text-red-600 bg-red-50 px-2 py-0.5 rounded border border-red-100">Ngừng cung cấp</span>
            }
        </div>
    </div>

    <!-- Hero Profile Header -->
    <div class="relative overflow-hidden bg-white rounded-3xl border border-slate-200 shadow-sm">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-emerald-50/50 to-transparent pointer-events-none"></div>
        <div class="p-6 md:p-8 relative z-10">
            <div class="flex flex-col lg:flex-row lg:items-center gap-8">
                <!-- Logo Container -->
                <div class="shrink-0">
                    <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl bg-white border border-slate-100 shadow-sm p-4 flex items-center justify-center group hover:border-emerald-200 transition-all">
                        <div class="w-full h-full rounded-xl bg-emerald-50 flex items-center justify-center text-4xl font-black text-emerald-600 group-hover:scale-110 transition-transform duration-500">
                            @(!string.IsNullOrEmpty(Model.LegalName) ? Model.LegalName[0] : 'P')
                        </div>
                    </div>
                </div>

                <!-- Basic Info -->
                <div class="flex-1 space-y-4">
                    <div>
                        <div class="flex flex-wrap items-center gap-3 mb-2">
                            <h1 class="text-3xl font-black text-slate-900 tracking-tight">@Model.LegalName</h1>
                            <span class="bg-slate-900 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm uppercase tracking-widest">ID: #@Model.Id</span>
                        </div>
                        <p class="text-slate-500 font-medium flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-emerald-500"></i>
                            @(Model.Address ?? "Chưa cập nhật địa chỉ trụ sở")
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-4 pt-2">
                        <div class="flex items-center gap-3 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100 hover:bg-white transition-colors">
                            <i class="fas fa-fingerprint text-slate-400"></i>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Mã số thuế</p>
                                <p class="text-sm font-bold text-slate-700">@(Model.TaxId ?? "N/A")</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100 hover:bg-white transition-colors">
                            <i class="fas fa-id-card text-slate-400"></i>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Số ĐKKD</p>
                                <p class="text-sm font-bold text-slate-700">@(Model.BusinessRegistrationNumber ?? "Chưa cập nhật")</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100 hover:bg-white transition-colors">
                            <i class="fas fa-user-shield text-slate-400"></i>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Đại diện pháp luật</p>
                                <p class="text-sm font-bold text-slate-700">@(Model.LegalRepresentative ?? "N/A")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex flex-col gap-3 lg:w-48">
                    <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-emerald-200 transition-all active:scale-95 flex items-center justify-center gap-2">
                        <i class="fas fa-edit"></i> Chỉnh sửa hồ sơ
                    </button>
                    <div class="grid grid-cols-1 gap-2">
                        <button class="bg-white border border-slate-200 text-slate-700 font-bold py-2.5 rounded-xl hover:bg-slate-50 transition-all flex items-center justify-center gap-2 text-xs">
                            <i class="fas fa-file-pdf text-red-500"></i> Xuất hồ sơ PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dashboard Content Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        
        <!-- COLUMN LEFT: Metrics & Contact -->
        <div class="space-y-6">
            
            <!-- Strategic Value Card -->
            <div class="bg-slate-900 rounded-3xl p-6 text-white relative overflow-hidden shadow-xl">
                <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl"></div>
                <div class="relative z-10">
                    <h3 class="text-xs font-black uppercase tracking-widest text-emerald-400 mb-4">Giá trị chiến lược (YTD)</h3>
                    <div class="space-y-6">
                        <div>
                            <p class="text-3xl font-black tracking-tight">0 VNĐ</p>
                            <p class="text-[10px] text-slate-400 font-medium uppercase tracking-widest mt-1">Tổng giá trị giao dịch năm 2026</p>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="p-3 bg-white/5 rounded-2xl border border-white/10">
                                <p class="text-xl font-bold">0</p>
                                <p class="text-[9px] text-slate-500 uppercase font-black">Tổng PO</p>
                            </div>
                            <div class="p-3 bg-white/5 rounded-2xl border border-white/10">
                                <p class="text-xl font-bold text-emerald-400">@((Model.PerformanceRating ?? 0) >= 4 ? "A" : "B")</p>
                                <p class="text-[9px] text-slate-500 uppercase font-black">Xếp hạng</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Performance Analytics -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-50">
                    <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest">Chỉ số Hiệu suất (KPI)</h3>
                    <i class="fas fa-chart-line text-emerald-500"></i>
                </div>
                <div class="space-y-6">
                    <div>
                        <div class="flex justify-between text-xs font-black text-slate-700 uppercase mb-2">
                            <span>Điểm đánh giá hệ thống</span>
                            <span class="text-emerald-600">@((Model.PerformanceRating ?? 0).ToString("F1")) / 5.0</span>
                        </div>
                        <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-emerald-500 rounded-full" style="width: @((Model.PerformanceRating ?? 0) * 20)%"></div>
                        </div>
                    </div>
                    <div class="pt-4 p-4 bg-emerald-50 rounded-2xl border border-emerald-100 text-[11px] text-emerald-700 font-medium leading-relaxed">
                        <i class="fas fa-info-circle mr-1"></i> Các chỉ số về giao hàng và chất lượng sẽ được tự động tính toán dựa trên dữ liệu nhập kho thực tế.
                    </div>
                </div>
            </div>

            <!-- Primary Contact Person -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-6 flex items-center gap-2">
                    <i class="fas fa-id-badge text-slate-400"></i> Đại diện đầu mối
                </h3>
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center text-emerald-600 font-black text-xl">
                        @(!string.IsNullOrEmpty(Model.ContactPerson) ? Model.ContactPerson[0] : 'C')
                    </div>
                    <div>
                        <h4 class="font-black text-slate-900 text-base">@(Model.ContactPerson ?? "Chưa có thông tin")</h4>
                        <p class="text-xs font-bold text-slate-500 uppercase">Đại diện Kinh doanh</p>
                    </div>
                </div>
                <div class="space-y-3">
                    <a href="tel:@Model.Phone" class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all group @(string.IsNullOrEmpty(Model.Phone) ? "pointer-events-none opacity-50" : "")">
                        <span class="text-xs font-bold text-slate-600 group-hover:text-emerald-700">@(Model.Phone ?? "Chưa cập nhật SĐT")</span>
                        <i class="fas fa-phone-alt text-slate-300 group-hover:text-emerald-400"></i>
                    </a>
                    <a href="mailto:@Model.Email" class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all group @(string.IsNullOrEmpty(Model.Email) ? "pointer-events-none opacity-50" : "")">
                        <span class="text-xs font-bold text-slate-600 group-hover:text-emerald-700">@(Model.Email ?? "Chưa cập nhật Email")</span>
                        <i class="fas fa-envelope text-slate-300 group-hover:text-emerald-400"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- COLUMN RIGHT: Compliance & Orders -->
        <div class="xl:col-span-2 space-y-6">
            
            <!-- Compliance Matrix -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm overflow-hidden relative">
                <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-50/30 rounded-full blur-3xl"></div>
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-6 flex items-center gap-2 relative z-10">
                    <i class="fas fa-shield-check text-emerald-500"></i> Hồ sơ Pháp lý & Tuân thủ
                </h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 relative z-10">
                    <div class="p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:shadow-md transition-all group cursor-default">
                        <div class="flex items-center justify-between mb-3">
                            <i class="fas fa-file-contract text-2xl text-slate-200 group-hover:text-emerald-500 transition-colors"></i>
                            <span class="text-[10px] font-black text-emerald-600 uppercase">Hệ thống</span>
                        </div>
                        <h5 class="text-xs font-black text-slate-800 uppercase tracking-tight">Hợp đồng Gốc</h5>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">Đang chờ ký kết...</p>
                    </div>
                    <div class="p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:shadow-md transition-all group cursor-default">
                        <div class="flex items-center justify-between mb-3">
                            <i class="fas fa-apple-alt text-2xl text-slate-200 group-hover:text-emerald-500 transition-colors"></i>
                            <span class="text-[10px] font-black text-emerald-600 uppercase">ATVSTP</span>
                        </div>
                        <h5 class="text-xs font-black text-slate-800 uppercase tracking-tight">Giấy ATTP</h5>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">Chưa upload tài liệu</p>
                    </div>
                    <div class="p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:shadow-md transition-all group cursor-default">
                        <div class="flex items-center justify-between mb-3">
                            <i class="fas fa-microscope text-2xl text-slate-200 group-hover:text-emerald-500 transition-colors"></i>
                            <span class="text-[10px] font-black text-slate-400 uppercase">N/A</span>
                        </div>
                        <h5 class="text-xs font-black text-slate-800 uppercase tracking-tight">Kiểm định Mẫu</h5>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">Không có dữ liệu</p>
                    </div>
                </div>
            </div>

            <!-- Transaction History Placeholder -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden min-h-[300px] flex flex-col items-center justify-center p-12 text-center">
                <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 text-2xl mb-4">
                    <i class="fas fa-history"></i>
                </div>
                <h4 class="text-base font-black text-slate-900 uppercase tracking-tight mb-2">Chưa có lịch sử giao dịch</h4>
                <p class="text-xs text-slate-500 max-w-xs font-medium">Hệ thống sẽ tự động ghi lại các phiếu nhập hàng (PO) và phiếu thanh toán khi đối tác này bắt đầu cung cấp nguyên liệu.</p>
                <button class="mt-6 px-6 py-2 bg-slate-900 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-slate-800 transition-all">Tạo đơn hàng đầu tiên</button>
            </div>

        </div>
    </div>
</div>

<style>
    @@keyframes fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-in {
        animation: fade-in 0.6s ease-out forwards;
    }
</style>
