@{
    ViewData["Title"] = "Chi Tiết Đối Tác Cung Ứng";
    Layout = "_LayoutManager";
}

<div class="space-y-6 animate-in fade-in duration-700">
    <!-- Breadcrumb & Status Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <nav class="flex text-xs font-bold uppercase tracking-widest text-slate-400" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-2">
                <li>
                    <a href="/Manager/Catalog/Suppliers" class="hover:text-emerald-600 transition-colors flex items-center gap-2">
                        <i class="fas fa-truck-loading"></i> Nhà cung cấp
                    </a>
                </li>
                <li><i class="fas fa-chevron-right text-[8px] opacity-50"></i></li>
                <li class="text-slate-900">Chi tiết đối tác</li>
            </ol>
        </nav>
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[10px] font-black uppercase tracking-tighter text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">Đang hoạt động</span>
        </div>
    </div>

    <!-- Hero Profile Header -->
    <div class="relative overflow-hidden bg-white rounded-3xl border border-slate-200 shadow-sm">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-emerald-50/50 to-transparent pointer-events-none"></div>
        <div class="p-6 md:p-8 relative z-10">
            <div class="flex flex-col lg:flex-row lg:items-center gap-8">
                <!-- Logo Container -->
                <div class="shrink-0">
                    <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl bg-white border border-slate-100 shadow-sm p-4 flex items-center justify-center group hover:border-emerald-200 transition-all">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Logo-cp-1-.png/800px-Logo-cp-1-.png" 
                             alt="CP Logo" 
                             class="w-full h-full object-contain mix-blend-multiply group-hover:scale-110 transition-transform duration-500" />
                    </div>
                </div>

                <!-- Basic Info -->
                <div class="flex-1 space-y-4">
                    <div>
                        <div class="flex flex-wrap items-center gap-3 mb-2">
                            <h1 class="text-3xl font-black text-slate-900 tracking-tight">C.Ty Cổ Phần Chăn Nuôi C.P. Việt Nam</h1>
                            <span class="bg-slate-900 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm uppercase tracking-widest">Mã: CP001</span>
                        </div>
                        <p class="text-slate-500 font-medium flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-emerald-500"></i>
                            Khu Công nghiệp Biên Hòa 2, TP. Biên Hòa, Tỉnh Đồng Nai, Việt Nam
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-4 pt-2">
                        <div class="flex items-center gap-3 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100 hover:bg-white transition-colors">
                            <i class="fas fa-fingerprint text-slate-400"></i>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Mã số thuế</p>
                                <p class="text-sm font-bold text-slate-700">0101928371</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100 hover:bg-white transition-colors">
                            <i class="fas fa-tag text-slate-400"></i>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Phân loại</p>
                                <p class="text-sm font-bold text-slate-700">Thực phẩm tươi sống</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100 hover:bg-white transition-colors">
                            <i class="fas fa-calendar-alt text-slate-400"></i>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Đối tác từ</p>
                                <p class="text-sm font-bold text-slate-700">12/2021</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex flex-col gap-3 lg:w-48">
                    <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-emerald-200 transition-all active:scale-95 flex items-center justify-center gap-2">
                        <i class="fas fa-edit"></i> Chỉnh sửa hồ sơ
                    </button>
                    <div class="grid grid-cols-2 gap-2">
                        <button class="bg-white border border-slate-200 text-slate-700 font-bold py-2.5 rounded-xl hover:bg-slate-50 transition-all flex items-center justify-center gap-2 text-xs">
                            <i class="fas fa-file-pdf text-red-500"></i> PDF
                        </button>
                        <button class="bg-white border border-slate-200 text-slate-700 font-bold py-2.5 rounded-xl hover:bg-slate-50 transition-all flex items-center justify-center gap-2 text-xs">
                            <i class="fas fa-share-alt text-blue-500"></i> Share
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dashboard Content Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        
        <!-- COLUMN LEFT: Metrics & Contact -->
        <div class="space-y-6">
            
            <!-- Strategic Value Card -->
            <div class="bg-slate-900 rounded-3xl p-6 text-white relative overflow-hidden shadow-xl">
                <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl"></div>
                <div class="relative z-10">
                    <h3 class="text-xs font-black uppercase tracking-widest text-emerald-400 mb-4">Giá trị chiến lược (YTD)</h3>
                    <div class="space-y-6">
                        <div>
                            <p class="text-3xl font-black tracking-tight">1.84 tỷ VNĐ</p>
                            <p class="text-[10px] text-slate-400 font-medium uppercase tracking-widest mt-1">Tổng giá trị giao dịch năm 2026</p>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="p-3 bg-white/5 rounded-2xl border border-white/10">
                                <p class="text-xl font-bold">142</p>
                                <p class="text-[9px] text-slate-500 uppercase font-black">Tổng PO</p>
                            </div>
                            <div class="p-3 bg-white/5 rounded-2xl border border-white/10">
                                <p class="text-xl font-bold text-emerald-400">A+</p>
                                <p class="text-[9px] text-slate-500 uppercase font-black">Xếp hạng</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Performance Analytics -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-50">
                    <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest">Chỉ số Hiệu suất (KPI)</h3>
                    <i class="fas fa-chart-line text-emerald-500"></i>
                </div>
                <div class="space-y-6">
                    <div>
                        <div class="flex justify-between text-xs font-black text-slate-700 uppercase mb-2">
                            <span>Giao hàng đúng hẹn</span>
                            <span class="text-emerald-600">98%</span>
                        </div>
                        <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-emerald-500 rounded-full" style="width: 98%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-xs font-black text-slate-700 uppercase mb-2">
                            <span>Chất lượng sản phẩm</span>
                            <span class="text-blue-600">95%</span>
                        </div>
                        <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-blue-500 rounded-full" style="width: 95%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-xs font-black text-slate-700 uppercase mb-2">
                            <span>Phản hồi khiếu nại</span>
                            <span class="text-orange-500">85%</span>
                        </div>
                        <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-orange-400 rounded-full" style="width: 85%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Primary Contact Person -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-6 flex items-center gap-2">
                    <i class="fas fa-id-badge text-slate-400"></i> Đại diện đầu mối
                </h3>
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center text-emerald-600 font-black text-xl">TD</div>
                    <div>
                        <h4 class="font-black text-slate-900 text-base">Anh Trí Dũng</h4>
                        <p class="text-xs font-bold text-slate-500 uppercase">Giám đốc Kinh doanh</p>
                    </div>
                </div>
                <div class="space-y-3">
                    <a href="tel:0908887766" class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all group">
                        <span class="text-xs font-bold text-slate-600 group-hover:text-emerald-700">090.888.7766</span>
                        <i class="fas fa-phone-alt text-slate-300 group-hover:text-emerald-400"></i>
                    </a>
                    <a href="mailto:dung.tri@cp.com.vn" class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all group">
                        <span class="text-xs font-bold text-slate-600 group-hover:text-emerald-700">dung.tri@cp.com.vn</span>
                        <i class="fas fa-envelope text-slate-300 group-hover:text-emerald-400"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- COLUMN RIGHT: Compliance & Orders -->
        <div class="xl:col-span-2 space-y-6">
            
            <!-- Compliance Matrix -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm overflow-hidden relative">
                <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-50/30 rounded-full blur-3xl"></div>
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-6 flex items-center gap-2 relative z-10">
                    <i class="fas fa-shield-check text-emerald-500"></i> Hồ sơ Pháp lý & Tuân thủ
                </h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 relative z-10">
                    <div class="p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:shadow-md transition-all group cursor-default">
                        <div class="flex items-center justify-between mb-3">
                            <i class="fas fa-file-contract text-2xl text-slate-200 group-hover:text-emerald-500 transition-colors"></i>
                            <span class="text-[10px] font-black text-emerald-600 uppercase">Hợp lệ</span>
                        </div>
                        <h5 class="text-xs font-black text-slate-800 uppercase tracking-tight">Hợp đồng Gốc</h5>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">Hết hạn: 12/2026</p>
                    </div>
                    <div class="p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:shadow-md transition-all group cursor-default">
                        <div class="flex items-center justify-between mb-3">
                            <i class="fas fa-apple-alt text-2xl text-slate-200 group-hover:text-emerald-500 transition-colors"></i>
                            <span class="text-[10px] font-black text-emerald-600 uppercase">Hợp lệ</span>
                        </div>
                        <h5 class="text-xs font-black text-slate-800 uppercase tracking-tight">Giấy ATTP</h5>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">Đã kiểm tra định kỳ</p>
                    </div>
                    <div class="p-4 rounded-2xl border-2 border-red-100 bg-red-50/30 hover:bg-white hover:shadow-md transition-all group cursor-default">
                        <div class="flex items-center justify-between mb-3">
                            <i class="fas fa-microscope text-2xl text-red-200 group-hover:text-red-500 transition-colors"></i>
                            <span class="text-[10px] font-black text-red-600 uppercase">Sắp hết hạn</span>
                        </div>
                        <h5 class="text-xs font-black text-slate-800 uppercase tracking-tight">Kiểm định Mẫu</h5>
                        <p class="text-[10px] text-red-500 font-bold mt-1">Còn 45 ngày</p>
                    </div>
                </div>
            </div>

            <!-- Products List -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest flex items-center gap-2">
                        <i class="fas fa-boxes text-slate-400"></i> Danh mục Hàng hóa chủ yếu
                    </h3>
                    <button class="text-[10px] font-black text-emerald-600 uppercase hover:underline">Xem tất cả</button>
                </div>
                <div class="p-2">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <div class="flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-50 transition-colors">
                            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400 text-xl"><i class="fas fa-drumstick-bite"></i></div>
                            <div class="flex-1">
                                <h5 class="text-sm font-bold text-slate-900">Thịt Heo CP (Nạc vai)</h5>
                                <p class="text-[10px] font-medium text-slate-500 italic">Sản lượng: ~ 850kg / tháng</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs font-black text-slate-900">82,000 đ</p>
                                <p class="text-[8px] font-bold text-slate-400 uppercase">/ kg</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-50 transition-colors">
                            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400 text-xl"><i class="fas fa-egg"></i></div>
                            <div class="flex-1">
                                <h5 class="text-sm font-bold text-slate-900">Trứng gà tươi loại 1</h5>
                                <p class="text-[10px] font-medium text-slate-500 italic">Sản lượng: ~ 12,000 quả / tháng</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs font-black text-slate-900">2,450 đ</p>
                                <p class="text-[8px] font-bold text-slate-400 uppercase">/ quả</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transaction History -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-50">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest flex items-center gap-2">
                        <i class="fas fa-history text-slate-400"></i> Lịch sử Giao dịch gần đây
                    </h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-slate-50/50 text-[10px] font-black uppercase tracking-widest text-slate-400">
                                <th class="px-6 py-4">Mã Phiếu</th>
                                <th class="px-6 py-4">Ngày Nhập</th>
                                <th class="px-6 py-4">Giá trị PO</th>
                                <th class="px-6 py-4">Trạng thái</th>
                                <th class="px-6 py-4 text-center">Tác vụ</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            <tr class="hover:bg-slate-50/30 transition-colors">
                                <td class="px-6 py-4 font-black text-slate-900 text-sm">PO-240401-CP</td>
                                <td class="px-6 py-4 text-slate-500 text-xs font-bold">01/04/2026</td>
                                <td class="px-6 py-4 font-black text-slate-900 text-sm">42,500,000 đ</td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 rounded-md bg-emerald-50 text-emerald-600 text-[10px] font-black uppercase tracking-tighter border border-emerald-100">Đã nhận hàng</span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <button class="w-8 h-8 rounded-lg bg-slate-100 text-slate-400 hover:bg-emerald-500 hover:text-white transition-all"><i class="fas fa-eye text-xs"></i></button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-50/30 transition-colors">
                                <td class="px-6 py-4 font-black text-slate-900 text-sm">PO-240408-CP</td>
                                <td class="px-6 py-4 text-slate-500 text-xs font-bold">08/04/2026</td>
                                <td class="px-6 py-4 font-black text-slate-900 text-sm">28,150,000 đ</td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 rounded-md bg-blue-50 text-blue-600 text-[10px] font-black uppercase tracking-tighter border border-blue-100">Đang vận chuyển</span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <button class="w-8 h-8 rounded-lg bg-slate-100 text-slate-400 hover:bg-emerald-500 hover:text-white transition-all"><i class="fas fa-eye text-xs"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="p-4 bg-slate-50/50 text-center">
                    <button class="text-[11px] font-black text-slate-500 uppercase tracking-widest hover:text-emerald-600 transition-colors">Xem toàn bộ lịch sử <i class="fas fa-arrow-right ml-1"></i></button>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    @@keyframes fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-in {
        animation: fade-in 0.6s ease-out forwards;
    }
</style>
