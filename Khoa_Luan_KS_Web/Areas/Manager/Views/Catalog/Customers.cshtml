@model Khoa_Luan_KS_Web.Services.GetUnitsResponse
@{
    ViewData["Title"] = "Đối Tác Khách Hàng B2B";
    Layout = "_LayoutManager";
}

<div x-data="customerManager()" class="space-y-6 animate-in fade-in duration-500">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Đối Tác Khách Hàng B2B</h1>
            <p class="text-sm text-slate-500 font-medium">Quản lý tập khách hàng Doanh nghiệp, Trường học, Bệnh viện</p>
        </div>
        <button x-on:click="isModalOpen = true" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-xl font-bold shadow-lg shadow-green-100 transition-all active:scale-95 flex items-center gap-2">
            <i class="fas fa-plus-circle"></i> Khởi tạo Khách hàng
        </button>
    </div>

    <!-- Filters & Search -->
    <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row gap-4">
        <div class="relative flex-1">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
            <input type="text" x-model="searchTerm" placeholder="Tìm tên đối tác, đại diện liên hệ..." class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border-none rounded-xl focus:ring-2 focus:ring-green-500 transition-all text-sm font-medium" />
        </div>
        <div class="flex gap-2">
            <select x-model="filterType" class="bg-slate-50 border-none rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 focus:ring-2 focus:ring-green-500 cursor-pointer">
                <option value="">Tất cả Phân Khúc</option>
                <option value="School">Trường học</option>
                <option value="Office">Văn phòng</option>
                <option value="Factory">Nhà máy / Xí nghiệp</option>
            </select>
            <button class="bg-slate-50 hover:bg-slate-100 text-slate-600 px-4 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2">
                <i class="fas fa-filter"></i> Lọc trạng thái
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Tổng khách hàng</p>
            <p class="text-2xl font-black text-slate-900">@Model.TotalCount</p>
        </div>
        <div class="bg-emerald-50 p-4 rounded-2xl border border-emerald-100 shadow-sm">
            <p class="text-[10px] font-black text-emerald-600 uppercase tracking-widest mb-1">Đang phục vụ</p>
            <p class="text-2xl font-black text-emerald-700">@Model.Items.Count(x => x.IsActive)</p>
        </div>
        <div class="bg-blue-50 p-4 rounded-2xl border border-blue-100 shadow-sm">
            <p class="text-[10px] font-black text-blue-600 uppercase tracking-widest mb-1">Hợp đồng mới</p>
            <p class="text-2xl font-black text-blue-700">2</p>
        </div>
        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm">
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Dự kiến suất ăn</p>
            <p class="text-2xl font-black text-white">@(Model.Items.Sum(x => x.DefaultDailyMeals).ToString("N0"))</p>
        </div>
    </div>

    <!-- Table Section -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-100">
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Tên tổ chức / Khách hàng</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Phân khúc & Khu vực</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Quy mô suất ăn (Ước tính)</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Hợp đồng</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">Tác vụ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <template x-for="item in filteredCustomers" :key="item.id">
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400 group-hover:bg-green-100 group-hover:text-green-600 transition-all">
                                        <i class="fas fa-building" x-show="item.unitType !== 'School'"></i>
                                        <i class="fas fa-graduation-cap" x-show="item.unitType === 'School'"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-black text-slate-900" x-text="item.name"></p>
                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter" x-text="'ĐD: ' + (item.contactPerson || 'Chưa cập nhật')"></p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="space-y-1">
                                    <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-600 text-[10px] font-black uppercase tracking-tighter" x-text="item.unitType"></span>
                                    <p class="text-[11px] text-slate-500 font-medium line-clamp-1" x-text="item.address"></p>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden max-w-[80px]">
                                        <div class="h-full bg-indigo-500 rounded-full" :style="'width: ' + (Math.min(item.defaultDailyMeals / 500, 1) * 100) + '%'"></div>
                                    </div>
                                    <p class="text-xs font-black text-slate-700">
                                        <span x-text="item.defaultDailyMeals.toLocaleString()"></span> 
                                        <span class="text-[9px] text-slate-400 uppercase ml-0.5">suất/ngày</span>
                                    </p>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <template x-if="item.isActive">
                                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                        <span class="text-[10px] font-black uppercase tracking-tighter">Đang phục vụ</span>
                                    </div>
                                </template>
                                <template x-if="!item.isActive">
                                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg bg-red-50 text-red-600 border border-red-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                        <span class="text-[10px] font-black uppercase tracking-tighter">Kết thúc HĐ</span>
                                    </div>
                                </template>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <a :href="'/Manager/Catalog/CustomerDetail/' + item.id" class="w-8 h-8 rounded-lg bg-slate-100 text-slate-400 hover:bg-green-500 hover:text-white flex items-center justify-center transition-all">
                                        <i class="fas fa-eye text-xs"></i>
                                    </a>
                                    <button class="w-8 h-8 rounded-lg bg-slate-100 text-slate-400 hover:bg-blue-500 hover:text-white flex items-center justify-center transition-all">
                                        <i class="fas fa-edit text-xs"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between">
            <p class="text-xs font-medium text-slate-500">
                Hiển thị <span class="font-bold text-slate-900">1-@Model.Items.Count</span> trên <span class="font-bold text-slate-900">@Model.TotalCount</span> khách hàng B2B
            </p>
            <div class="flex gap-2">
                <button class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-400 cursor-not-allowed">Trước</button>
                <button class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-white hover:shadow-sm transition-all">Sau</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function customerManager() {
            return {
                searchTerm: '',
                filterType: '',
                isModalOpen: false,
                customers: @Html.Raw(Json.Serialize(Model.Items)),
                
                get filteredCustomers() {
                    return this.customers.filter(c => {
                        const matchesSearch = !this.searchTerm || 
                            c.name.toLowerCase().includes(this.searchTerm.toLowerCase()) ||
                            (c.contactPerson && c.contactPerson.toLowerCase().includes(this.searchTerm.toLowerCase()));
                        
                        const matchesType = !this.filterType || c.unitType === this.filterType;
                        
                        return matchesSearch && matchesType;
                    });
                }
            }
        }
    </script>
}
