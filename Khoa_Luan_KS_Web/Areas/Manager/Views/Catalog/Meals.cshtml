@using Khoa_Luan_KS_Web.Models
@using Khoa_Luan_KS_Web.Areas.Manager.Models
@model Khoa_Luan_KS_Web.Services.GetDishesResponse
@{
    ViewData["Title"] = "Quản lý Món ăn";
    Layout = "_LayoutManager";

    var pagination = ViewBag.Pagination as ManagerPaginationVm ?? new ManagerPaginationVm
    {
        Controller = "Catalog",
        Action = "Meals",
        Page = 1,
        PageSize = 20,
        TotalCount = Model.TotalCount,
        ItemCount = Model.Items.Count,
        SearchTerm = Context.Request.Query["searchTerm"].ToString(),
        Category = Context.Request.Query["category"].ToString()
    };

    string CatLabel(string? cat) => MealFormOptions.SlotLabel(cat);
    string CatDot(string? cat) => (cat ?? "").ToLowerInvariant() switch {
        "main" or "man" => "bg-orange-400",
        "side" or "xao" => "bg-yellow-400",
        "soup" or "canh" or "noodle_soup" => "bg-blue-400",
        "dessert" or "trang_mieng" => "bg-pink-400",
        "vegetable" => "bg-emerald-400",
        _ => "bg-slate-300"
    };
    string CatPill(string? cat) => MenuDishDisplayHelper.CategoryBadgeClass(cat) + " text-[10px] font-black px-2.5 py-1 rounded-full border";

    var curCat   = Context.Request.Query["category"].ToString();
    var curSearch = Context.Request.Query["searchTerm"].ToString();
}

<div class="space-y-5">

    <!-- ═══ HEADER ═══ -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-black text-slate-900">Quản lý Món ăn</h1>
            <p class="text-sm text-slate-500 mt-0.5">Quản lý danh mục, dinh dưỡng và định mức nguyên liệu</p>
        </div>
        <a href="/Manager/Catalog/MealCreate"
           class="flex items-center gap-2 bg-green-600 hover:bg-green-700 active:scale-95 text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow-lg shadow-green-200 transition-all">
            <i class="fas fa-plus"></i> Thêm món ăn
        </a>
    </div>

    <!-- ═══ STATS ═══ -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
        @{
            var stats = new[] {
                new { Label = "Tổng món", Value = Model.TotalCount.ToString(), Color = "text-slate-900", Bg = "bg-white" },
                new { Label = "Đang bán",   Value = Model.Items.Count(x => x.IsActive).ToString(),          Color = "text-emerald-700", Bg = "bg-emerald-50" },
                new { Label = "Món chính",  Value = Model.Items.Count(x => x.Category is "main" or "man").ToString(),  Color = "text-orange-700",  Bg = "bg-orange-50" },
                new { Label = "Canh / Súp", Value = Model.Items.Count(x => x.Category is "soup" or "canh" or "noodle_soup").ToString(), Color = "text-blue-700",    Bg = "bg-blue-50" },
                new { Label = "Tráng miệng",Value = Model.Items.Count(x => x.Category is "dessert" or "trang_mieng").ToString(), Color = "text-pink-700", Bg = "bg-pink-50" },
            };
        }
        @foreach (var s in stats)
        {
            <div class="@s.Bg border border-slate-100 rounded-xl px-4 py-3">
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">@s.Label</p>
                <p class="text-2xl font-black @s.Color">@s.Value</p>
            </div>
        }
    </div>

    <!-- ═══ FILTERS ═══ -->
    <div class="flex flex-wrap items-center gap-2">
        @{
            var filterTabs = new[] {
                new { Key = "", Label = "Tất cả" },
                new { Key = "main", Label = "Món chính" },
                new { Key = "soup", Label = "Canh / súp" },
                new { Key = "side", Label = "Món phụ" },
                new { Key = "dessert", Label = "Tráng miệng" },
            };
        }
        @foreach (var t in filterTabs)
        {
            var active = curCat == t.Key;
            <a href="/Manager/Catalog/Meals?page=1&amp;category=@t.Key@(!string.IsNullOrEmpty(curSearch) ? "&amp;searchTerm=" + Uri.EscapeDataString(curSearch) : "")"
               class="flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold transition-all @(active ? "bg-green-600 text-white shadow-md" : "bg-white text-slate-600 border border-slate-200 hover:border-green-300 hover:text-green-600")">
                @t.Label
            </a>
        }

        <!-- Search -->
        <form method="get" action="/Manager/Catalog/Meals" class="ml-auto">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="category" value="@curCat" />
            <div class="relative">
                <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                <input type="text" name="searchTerm" value="@curSearch"
                       placeholder="Tìm tên món ăn..."
                       class="pl-9 pr-10 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-green-500 w-52" />
                @if (!string.IsNullOrEmpty(curSearch))
                {
                    <a href="/Manager/Catalog/Meals?category=@curCat" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                        <i class="fas fa-times text-xs"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- ═══ TABLE / LIST ═══ -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="py-20 flex flex-col items-center text-center gap-4 text-slate-400">
                <i class="fas fa-bowl-food text-5xl"></i>
                <div>
                    <p class="font-black text-slate-700 text-base">Không tìm thấy món ăn nào</p>
                    <p class="text-sm mt-1">Hãy thêm món ăn mới hoặc điều chỉnh bộ lọc.</p>
                </div>
                <a href="/Manager/Catalog/MealCreate" class="inline-flex items-center gap-2 bg-green-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-green-700 transition">
                    <i class="fas fa-plus"></i> Thêm món ăn
                </a>
            </div>
        }
        else
        {
            <!-- Table header -->
            <div class="grid grid-cols-12 px-6 py-3 bg-slate-50 border-b border-slate-100 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                <div class="col-span-5">Tên món ăn</div>
                <div class="col-span-2 text-center">Phân loại</div>
                <div class="col-span-3 text-center">Dinh dưỡng</div>
                <div class="col-span-1 text-center">Trạng thái</div>
                <div class="col-span-1 text-center">Thao tác</div>
            </div>

            @foreach (var dish in Model.Items)
            {
                <div class="grid grid-cols-12 items-center px-6 py-4 border-b border-slate-50 last:border-0 hover:bg-slate-50/60 transition-colors">

                    <!-- Tên + ảnh thumbnail -->
                    <div class="col-span-5 flex items-center gap-4">
                        <div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-slate-100 border border-slate-200">
                            @if (!string.IsNullOrEmpty(dish.ImageUrl))
                            {
                                <img src="@MenuDishDisplayHelper.ImageSrc(dish.ImageUrl, dish.UpdatedAt, dish.CreatedAt)" alt="@dish.Name" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-slate-300">
                                    <i class="fas fa-image text-xl"></i>
                                </div>
                            }
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 mb-0.5">
                                <span class="w-2 h-2 rounded-full shrink-0 @CatDot(dish.Category)"></span>
                                <a href="/Manager/Catalog/MealDetail/@dish.Id"
                                   class="font-bold text-slate-900 hover:text-green-600 transition-colors truncate">@dish.Name</a>
                            </div>
                            @if (!string.IsNullOrEmpty(dish.Code))
                            {
                                <p class="text-[10px] text-slate-400 font-bold uppercase">@dish.Code</p>
                            }
                            @if (!string.IsNullOrEmpty(dish.Description))
                            {
                                <p class="text-xs text-slate-400 truncate max-w-xs mt-0.5">@dish.Description</p>
                            }
                        </div>
                    </div>

                    <!-- Phân loại -->
                    <div class="col-span-2 flex justify-center">
                        <span class="text-[10px] font-black px-2.5 py-1 rounded-full @CatPill(dish.Category)">
                            @CatLabel(dish.Category)
                        </span>
                    </div>

                    <!-- Dinh dưỡng pills -->
                    <div class="col-span-3 flex flex-col items-center gap-1">
                        @if (dish.Calories.HasValue)
                        {
                            <span class="text-[10px] font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded-full w-full text-center">🔥 @dish.Calories kcal</span>
                        }
                        @if (dish.Protein.HasValue)
                        {
                            <span class="text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full w-full text-center">💪 @dish.Protein g P</span>
                        }
                        @if (!dish.Calories.HasValue && !dish.Protein.HasValue)
                        {
                            <span class="text-[10px] text-slate-300 font-bold">— chưa có —</span>
                        }
                    </div>

                    <!-- Trạng thái -->
                    <div class="col-span-1 flex justify-center">
                        @if (dish.IsActive)
                        {
                            <span class="flex items-center gap-1 text-[10px] font-black text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-1 rounded-full">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Bán
                            </span>
                        }
                        else
                        {
                            <span class="flex items-center gap-1 text-[10px] font-black text-slate-400 bg-slate-50 border border-slate-200 px-2 py-1 rounded-full">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> Ẩn
                            </span>
                        }
                    </div>

                    <!-- Thao tác -->
                    <div class="col-span-1 flex justify-center gap-1.5">
                        <a href="/Manager/Catalog/MealDetail/@dish.Id"
                           title="Xem chi tiết"
                           class="w-8 h-8 rounded-lg bg-slate-50 text-slate-500 hover:bg-green-50 hover:text-green-600 border border-slate-200 flex items-center justify-center transition-all">
                            <i class="fas fa-eye text-xs"></i>
                        </a>
                        <a href="/Manager/Catalog/MealEdit/@dish.Id"
                           title="Chỉnh sửa"
                           class="w-8 h-8 rounded-lg bg-slate-50 text-slate-500 hover:bg-blue-50 hover:text-blue-600 border border-slate-200 flex items-center justify-center transition-all">
                            <i class="fas fa-pen text-xs"></i>
                        </a>
                    </div>
                </div>
            }

            <div class="relative">
                @if (!string.IsNullOrEmpty(curCat) || !string.IsNullOrEmpty(curSearch))
                {
                    <div class="absolute right-4 top-3 z-10">
                        <a href="/Manager/Catalog/Meals" class="text-xs text-green-600 font-bold hover:underline bg-white/90 px-2 py-1 rounded-lg border border-green-100">Xóa bộ lọc</a>
                    </div>
                }
                <partial name="_PaginationBar" model="pagination" />
            </div>
        }
    </div>
</div>
