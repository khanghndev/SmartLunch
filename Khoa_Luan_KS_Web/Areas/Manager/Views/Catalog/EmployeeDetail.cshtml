@model Khoa_Luan_KS_Web.Services.AdminUserDto
@{
    ViewData["Title"] = "Chi tiết Nhân Viên";
    Layout = "_LayoutManager";
    var returnListUrl = ViewBag.ReturnListUrl as string ?? Url.Action("Employees", "Catalog", new { area = "Manager" })!;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    static string StaffRole(IReadOnlyList<string> roles)
    {
        var staff = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "Admin", "Manager", "WarehouseStaff", "ChefStaff", "SalesStaff", "Shipper"
        };
        return roles.FirstOrDefault(r => staff.Contains(r)) ?? "Nhân viên";
    }

    static string RoleBadgeClass(string role) => role switch
    {
        "ChefStaff" => "bg-orange-50 text-orange-700 border-orange-100",
        "WarehouseStaff" => "bg-purple-50 text-purple-700 border-purple-100",
        "SalesStaff" => "bg-blue-50 text-blue-700 border-blue-100",
        "Manager" => "bg-green-50 text-green-700 border-green-100",
        "Admin" or "Super Admin" => "bg-slate-100 text-slate-700 border-slate-200",
        "Shipper" => "bg-amber-50 text-amber-700 border-amber-100",
        _ => "bg-gray-50 text-gray-700 border-gray-100"
    };

    var role = StaffRole(Model.RoleNames);
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? Model.Email : Model.FullName;
    var initials = !string.IsNullOrWhiteSpace(Model.FirstName) && Model.FirstName.Length > 0
        ? Model.FirstName[0].ToString()
        : (!string.IsNullOrWhiteSpace(Model.Email) ? Model.Email[0].ToString().ToUpperInvariant() : "N");
    if (!string.IsNullOrWhiteSpace(Model.LastName) && Model.LastName.Length > 0)
        initials += Model.LastName[0];
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-3.5 text-sm font-semibold text-emerald-800 shadow-sm">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600"><i class="fas fa-check"></i></span>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-3.5 text-sm font-semibold text-red-800 shadow-sm">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600"><i class="fas fa-circle-exclamation"></i></span>
        @TempData["Error"]
    </div>
}

<div class="px-4 py-6 md:p-8 space-y-6" x-data="employeeDetail(@Model.Id)">
    <nav class="flex text-sm text-gray-500 font-medium" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="@returnListUrl" class="hover:text-green-600 transition flex items-center gap-2">
                    <i class="fas fa-users"></i> Quản lý Nhân sự
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-400 text-xs mx-1"></i>
                    <span class="ml-1 md:ml-2 text-gray-900 font-bold">Hồ sơ #@Model.Id.ToString("D3")</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">@displayName</h1>
            <p class="text-sm text-gray-500 mt-1">@Model.Email</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a href="@returnListUrl" class="bg-white border border-gray-300 text-gray-700 font-bold px-4 py-2 rounded-xl shadow-sm hover:bg-gray-50 transition flex items-center gap-2 text-sm">
                <i class="fas fa-arrow-left"></i> Danh sách
            </a>
            @if (Model.IsActive)
            {
                <button type="button" @@click="lockEmployee()" class="bg-white border border-red-200 text-red-600 font-bold px-4 py-2 rounded-xl shadow-sm hover:bg-red-50 transition flex items-center gap-2 text-sm">
                    <i class="fas fa-lock"></i> Khóa tài khoản
                </button>
            }
            else
            {
                <button type="button" @@click="unlockEmployee()" class="bg-white border border-green-200 text-green-700 font-bold px-4 py-2 rounded-xl shadow-sm hover:bg-green-50 transition flex items-center gap-2 text-sm">
                    <i class="fas fa-unlock"></i> Khôi phục
                </button>
            }
            <button type="button" @@click="resetPassword()" class="bg-gray-100 hover:bg-gray-200 border-gray-200 border text-gray-700 font-bold px-4 py-2 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-key"></i> Đặt lại MK
            </button>
            <button type="submit" form="employeeUpdateForm" class="bg-green-600 hover:bg-green-700 text-white font-bold px-5 py-2 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-save"></i> Lưu thông tin
            </button>
        </div>
    </div>

    <form id="lockForm" method="post" asp-area="Manager" asp-controller="Catalog" asp-action="LockEmployee" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </form>
    <form id="unlockForm" method="post" asp-area="Manager" asp-controller="Catalog" asp-action="UnlockEmployee" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </form>
    <form id="resetPasswordForm" method="post" asp-area="Manager" asp-controller="Catalog" asp-action="ResetEmployeePassword" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="newPassword" id="resetNewPassword" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </form>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="h-24 bg-gradient-to-r from-green-500 to-emerald-600 relative">
                    <div class="absolute right-3 top-3 bg-white/20 backdrop-blur-md text-white text-xs px-2 py-1 rounded font-bold border border-white/30">#@Model.Id.ToString("D3")</div>
                </div>
                <div class="px-6 pb-6 pt-0 text-center relative">
                    <div class="w-24 h-24 rounded-full border-4 border-white shadow-md mx-auto -mt-12 bg-blue-100 text-blue-600 flex items-center justify-center text-2xl font-extrabold relative z-10">@initials</div>
                    <h2 class="mt-4 text-xl font-extrabold text-gray-900">@displayName</h2>
                    <p class="text-sm font-medium text-gray-500">@Model.Username</p>
                    <div class="mt-4 flex flex-wrap justify-center gap-2">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border @RoleBadgeClass(role)">@role</span>
                        @if (Model.IsActive)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-50 text-green-700 border border-green-100">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span> Đang làm việc
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-100">Đã nghỉ việc</span>
                        }
                    </div>
                </div>
                <div class="grid grid-cols-2 border-t border-gray-100 bg-gray-50/50">
                    <div class="p-4 text-center border-r border-gray-100">
                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Ngày vào làm</div>
                        <div class="font-bold text-gray-900">@(Model.CreatedAt != default ? Model.CreatedAt.ToString("dd/MM/yyyy") : "—")</div>
                    </div>
                    <div class="p-4 text-center">
                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Đăng nhập cuối</div>
                        <div class="font-bold text-gray-900 text-sm">@(Model.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-[13px] font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-gray-100 pb-3">
                    <i class="fas fa-shield-alt text-gray-400"></i> Trạng thái tài khoản
                </h3>
                <dl class="space-y-3 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-gray-500 font-medium">Email xác thực</dt>
                        <dd class="font-bold @(Model.IsEmailVerified ? "text-green-600" : "text-amber-600")">@(Model.IsEmailVerified ? "Đã xác thực" : "Chưa xác thực")</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-gray-500 font-medium">Trạng thái</dt>
                        <dd class="font-bold @(Model.IsActive ? "text-green-600" : "text-red-600")">@(Model.IsActive ? "Hoạt động" : "Đã khóa")</dd>
                    </div>
                    @if (Model.RoleNames.Count > 1)
                    {
                        <div>
                            <dt class="text-gray-500 font-medium mb-1">Vai trò khác</dt>
                            <dd class="flex flex-wrap gap-1">
                                @foreach (var r in Model.RoleNames.Where(r => !string.Equals(r, role, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded border @RoleBadgeClass(r)">@r</span>
                                }
                            </dd>
                        </div>
                    }
                </dl>
            </div>
        </div>

        <div class="lg:col-span-2">
            <form id="employeeUpdateForm" method="post" asp-area="Manager" asp-controller="Catalog" asp-action="UpdateEmployee" asp-route-id="@Model.Id" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <h3 class="text-[15px] font-bold text-gray-900 flex items-center gap-2 border-b border-gray-100 pb-3">
                    <i class="fas fa-id-card text-gray-400"></i> Thông tin cán bộ
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1.5">Họ</label>
                        <input type="text" name="LastName" value="@Model.LastName" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1.5">Tên</label>
                        <input type="text" name="FirstName" value="@Model.FirstName" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1.5">Email</label>
                        <input type="email" name="Email" value="@Model.Email" class="w-full bg-white border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1.5">Số điện thoại</label>
                        <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" />
                    </div>
                </div>

                <div class="rounded-xl border border-amber-100 bg-amber-50 p-4 text-sm text-amber-800">
                    <p class="font-bold mb-1"><i class="fas fa-info-circle mr-1"></i> Lưu ý</p>
                    <p>Thay đổi bộ phận/vai trò và mật khẩu mới thực hiện qua nút <strong>Đặt lại MK</strong> hoặc quản trị hệ thống (Admin). Trang này cập nhật thông tin liên hệ và email.</p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('employeeDetail', (id) => ({
                lockEmployee() {
                    if (confirm('Bạn có chắc chắn muốn khóa hồ sơ nhân viên này?')) {
                        document.getElementById('lockForm').submit();
                    }
                },
                unlockEmployee() {
                    if (confirm('Bạn có chắc chắn muốn khôi phục hồ sơ nhân viên này?')) {
                        document.getElementById('unlockForm').submit();
                    }
                },
                resetPassword() {
                    const newPass = prompt('Nhập mật khẩu mới cho nhân viên này (tối thiểu 6 ký tự):');
                    if (newPass && newPass.length >= 6) {
                        document.getElementById('resetNewPassword').value = newPass;
                        document.getElementById('resetPasswordForm').submit();
                    } else if (newPass) {
                        alert('Mật khẩu phải có ít nhất 6 ký tự.');
                    }
                }
            }));
        });
    </script>
}
