@{
    ViewData["Title"] = "Chi tiết Nhân Viên";
    Layout = "_LayoutManager";
}

<div class="px-4 py-6 md:p-8 space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-gray-500 font-medium" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/Manager/CatalogEmployees" class="hover:text-green-600 transition flex items-center gap-2">
                    <i class="fas fa-users"></i> Quản lý Nhân sự
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-400 text-xs mx-1"></i>
                    <span class="ml-1 md:ml-2 text-gray-900 font-bold">Hồ sơ #NV001</span>
                </div>
            </li>
        </ol>
    </nav>

    <!-- Header Action -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Chi tiết Cán bộ</h1>
        <div class="flex items-center gap-3">
            <button class="bg-white border border-gray-300 text-gray-700 font-bold px-4 py-2 rounded-xl shadow-sm hover:bg-gray-50 transition flex items-center gap-2 text-sm">
                <i class="fas fa-print"></i> In Hồ Sơ
            </button>
            <button class="bg-gray-100 hover:bg-gray-200 border-gray-200 border text-gray-700 font-bold px-4 py-2 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-ban text-red-500"></i> Đình chỉ công tác
            </button>
            <button class="bg-green-600 hover:bg-green-700 text-white font-bold px-5 py-2 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-save"></i> Lưu thông tin
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        
        <!-- Cột Trái (Left Card) -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Profile Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden relative">
                <!-- Cover -->
                <div class="h-24 bg-gradient-to-r from-green-500 to-emerald-600 relative">
                    <div class="absolute right-3 top-3 bg-white/20 backdrop-blur-md text-white text-xs px-2 py-1 object-cover rounded font-bold border border-white/30">ID: NV001</div>
                </div>
                <!-- Avatar & Info -->
                <div class="px-6 pb-6 pt-0 text-center relative">
                    <img src="https://i.pravatar.cc/150?u=a042581f4e29026024d" alt="Profile" class="w-24 h-24 rounded-full border-4 border-white shadow-md mx-auto -mt-12 bg-white object-cover object-center relative z-10" />
                    
                    <h2 class="mt-4 text-xl font-extrabold text-gray-900">Nguyễn Văn Khang</h2>
                    <p class="text-sm font-medium text-gray-500">khang.nguyen@huitmeal.com</p>
                    
                    <div class="mt-4 flex justify-center gap-2">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-100 shadow-sm">
                            <i class="fas fa-fire"></i> Bếp Trưởng
                        </span>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-50 text-green-700 border border-green-100 shadow-sm">
                            Đang rảnh (Off)
                        </span>
                    </div>
                </div>
                <!-- Mini Stats (For Kitchen Staff) -->
                <div class="grid grid-cols-2 border-t border-gray-100 bg-gray-50/50 hidden md:grid">
                    <div class="p-4 text-center border-r border-gray-100">
                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Thâm niên</div>
                        <div class="font-bold text-gray-900">3 năm</div>
                    </div>
                    <div class="p-4 text-center">
                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Hiệu suất tháng</div>
                        <div class="font-bold text-green-600">98%</div>
                    </div>
                </div>
            </div>

            <!-- Contact Information Form -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-[13px] font-bold text-gray-900 uppercase tracking-wider mb-5 flex items-center gap-2 border-b border-gray-100 pb-3">
                    <i class="fas fa-id-card text-gray-400"></i> Liên hệ cơ bản
                </h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1">Số điện thoại chính</label>
                        <input type="text" value="+84 909 123 456" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1">Căn Cước công dân (Đã X/T)</label>
                        <input type="text" value="079203012345" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1">Nguyên quán</label>
                        <input type="text" value="Xã Long Thượng, Cần Giuộc, Long An" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-1">Nơi ở hiện tại</label>
                        <textarea class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 font-medium" rows="2">140 Lê Trọng Tấn, Phường Tây Thạnh, Quận Tân Phú, TPHCM</textarea>
                    </div>
                </div>
            </div>
            
        </div>

        <!-- Cột Phải (Right Working Info) -->
        <div class="lg:col-span-2 space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Data Card: Lương -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 relative overflow-hidden">
                    <div class="absolute -right-6 -top-6 text-gray-50 opacity-50">
                        <i class="fas fa-money-check-alt text-8xl"></i>
                    </div>
                    <div class="relative z-10">
                        <div class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-1 border-l-2 border-green-500 pl-2">Lương Cơ Bản Cứng</div>
                        <h3 class="text-2xl font-extrabold text-gray-900 mt-2">15,000,000 <span class="text-sm text-gray-500 font-medium tracking-normal block mt-1">VNĐ / tháng</span></h3>
                    </div>
                </div>

                <!-- Data Card: Ngày Gắn Bó -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 relative overflow-hidden">
                    <div class="absolute -right-6 -top-6 text-gray-50 opacity-50">
                        <i class="fas fa-calendar-alt text-8xl"></i>
                    </div>
                    <div class="relative z-10">
                        <div class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-1 border-l-2 border-blue-500 pl-2">Bắt đầu trực tiếp từ</div>
                        <h3 class="text-2xl font-extrabold text-gray-900 mt-2">01/01/2026</h3>
                        <p class="text-sm font-bold text-blue-600 mt-1">Đã cộng tác: Mới đây</p>
                    </div>
                </div>
            </div>

            <!-- Công việc & Ca Làm -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                <h3 class="text-[15px] font-bold text-gray-900 mb-6 flex items-center justify-between border-b border-gray-100 pb-3">
                    <span class="flex items-center gap-2"><i class="fas fa-clipboard-list text-gray-400"></i> Thông số Pháp lý Nhân sự</span>
                    <i class="fas fa-edit text-gray-400 hover:text-green-600 cursor-pointer transition"></i>
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-2">Thông tin Ngân hàng chuyển khoản</label>
                        <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 flex items-center gap-4">
                            <div class="w-10 h-10 bg-white rounded shadow-sm flex items-center justify-center font-bold text-blue-800 border border-blue-100">MB</div>
                            <div>
                                <div class="font-bold text-sm text-gray-900">1999901019999</div>
                                <div class="text-xs text-gray-500 font-medium">NGUYEN VAN KHANG (MB BANK)</div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-2">Loại Hợp đồng Ký kết</label>
                        <select class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-3 font-medium shadow-sm">
                            <option>Hợp đồng Dịch vụ (Không BHXH)</option>
                            <option selected>Hợp đồng Xác định thời hạn (1 Năm)</option>
                            <option>Hợp đồng Vô thời hạn (Chính thức)</option>
                            <option>Thỏa thuận Thử việc 2 Tháng</option>
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wide mb-2">Lịch Đăng ký Ca làm cố định</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2">
                            <!-- Mon -->
                            <div class="border border-green-500 bg-green-50 rounded-lg p-2 text-center shadow-sm cursor-pointer hover:bg-green-100 transition">
                                <div class="text-[10px] font-bold text-green-700 uppercase mb-1">T2</div>
                                <div class="font-bold text-sm text-green-900">Ca Đêm</div>
                            </div>
                            <!-- Tue -->
                            <div class="border border-green-500 bg-green-50 rounded-lg p-2 text-center shadow-sm cursor-pointer hover:bg-green-100 transition">
                                <div class="text-[10px] font-bold text-green-700 uppercase mb-1">T3</div>
                                <div class="font-bold text-sm text-green-900">Ca Đêm</div>
                            </div>
                            <!-- Wed -->
                            <div class="border border-gray-200 bg-gray-50 rounded-lg p-2 text-center cursor-pointer hover:bg-gray-100 transition opacity-60">
                                <div class="text-[10px] font-bold text-gray-500 uppercase mb-1">T4</div>
                                <div class="font-bold text-sm text-gray-500">OFF</div>
                            </div>
                            <!-- Thu -->
                            <div class="border border-green-500 bg-green-50 rounded-lg p-2 text-center shadow-sm cursor-pointer hover:bg-green-100 transition">
                                <div class="text-[10px] font-bold text-green-700 uppercase mb-1">T5</div>
                                <div class="font-bold text-sm text-green-900">Ca Sáng</div>
                            </div>
                            <!-- Fri -->
                            <div class="border border-green-500 bg-green-50 rounded-lg p-2 text-center shadow-sm cursor-pointer hover:bg-green-100 transition">
                                <div class="text-[10px] font-bold text-green-700 uppercase mb-1">T6</div>
                                <div class="font-bold text-sm text-green-900">Ca Sáng</div>
                            </div>
                            <!-- Sat -->
                            <div class="border border-green-500 bg-green-50 rounded-lg p-2 text-center shadow-sm cursor-pointer hover:bg-green-100 transition">
                                <div class="text-[10px] font-bold text-green-700 uppercase mb-1">T7</div>
                                <div class="font-bold text-sm text-green-900">Ca Sáng</div>
                            </div>
                            <!-- Sun -->
                            <div class="border border-green-500 bg-green-50 rounded-lg p-2 text-center shadow-sm cursor-pointer hover:bg-green-100 transition">
                                <div class="text-[10px] font-bold text-green-700 uppercase mb-1">CN</div>
                                <div class="font-bold text-sm text-green-900">Ca Sáng</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Warning Zone -->
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
                <h4 class="font-bold text-red-800 text-sm mb-1 flex items-center gap-2">
                    <i class="fas fa-exclamation-triangle"></i> Cảnh báo hệ thống
                </h4>
                <p class="text-sm text-red-700">Dữ liệu Cán bộ khi xóa không thể phục hồi. Vui lòng sử dụng tính năng "Đình chỉ công tác" hiển thị cạnh trên cùng với lý do vi phạm nếu nhân viên này bị đuổi việc.</p>
            </div>

        </div>

    </div>
</div>
