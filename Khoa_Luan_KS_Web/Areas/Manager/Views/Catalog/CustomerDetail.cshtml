@model Khoa_Luan_KS_Web.Services.UnitDto
@{
    ViewData["Title"] = Model.Name;
    Layout = "_LayoutManager";
    string TypeVi() => Model.UnitType switch
    {
        "School" => "Trường học",
        "Factory" => "Nhà máy / Xí nghiệp",
        "Office" => "Văn phòng",
        _ => Model.UnitType ?? "—"
    };
    var returnListUrl = Url.Action("Customers", "Catalog", new { area = "Manager" }) ?? "/Manager/Catalog/Customers";
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800">@TempData["Error"]</div>
}

<div class="px-4 py-6 md:p-8 space-y-6 max-w-5xl mx-auto">
    <nav class="flex text-sm text-slate-500 font-medium" aria-label="Breadcrumb">
        <a href="@returnListUrl" class="hover:text-green-600 transition flex items-center gap-2">
            <i class="fas fa-building"></i> Khách hàng B2B
        </a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-900 font-bold line-clamp-1">@Model.Name</span>
    </nav>

    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-3">
                <span class="w-11 h-11 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-700">
                    @if (Model.UnitType == "School")
                    { <i class="fas fa-school text-xl"></i> }
                    else
                    { <i class="fas fa-building text-xl"></i> }
                </span>
                <span class="line-clamp-2">@Model.Name</span>
            </h1>
            <p class="text-sm text-slate-500 mt-2">
                Mã đơn vị: <span class="font-mono font-bold text-slate-700">@(string.IsNullOrEmpty(Model.Code) ? "—" : Model.Code)</span>
                · Phân khúc: <span class="font-bold text-slate-700">@TypeVi()</span>
            </p>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (Model.IsActive)
            {
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-100 text-xs font-black uppercase">Đang phục vụ</span>
            }
            else
            {
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-red-50 text-red-700 border border-red-100 text-xs font-black uppercase">Tạm ngưng</span>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl border border-slate-100 p-5 shadow-sm md:col-span-2 space-y-4">
            <h2 class="text-xs font-black text-slate-400 uppercase tracking-widest border-b border-slate-100 pb-2">Thông tin đơn vị <span class="text-slate-400 font-normal normal-case">(chỉ đọc)</span></h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Địa chỉ</dt>
                    <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</dd>
                </div>
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Điện thoại</dt>
                    <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd>
                </div>
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Người liên hệ</dt>
                    <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.ContactPerson) ? "—" : Model.ContactPerson)</dd>
                </div>
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Email liên hệ</dt>
                    <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.ContactEmail) ? "—" : Model.ContactEmail)</dd>
                </div>
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Mã số thuế</dt>
                    <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.TaxCode) ? "—" : Model.TaxCode)</dd>
                </div>
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Đại diện pháp luật</dt>
                    <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.LegalRepresentative) ? "—" : Model.LegalRepresentative)</dd>
                </div>
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Website</dt>
                    <dd class="font-medium text-slate-900">
                        @if (!string.IsNullOrWhiteSpace(Model.Website))
                        {
                            <a href="@Model.Website" class="text-green-600 hover:underline break-all" target="_blank" rel="noopener">@Model.Website</a>
                        }
                        else { <text>—</text> }
                    </dd>
                </div>
                <div>
                    <dt class="text-slate-400 text-xs font-bold uppercase">Bậc học</dt>
                    <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.EducationLevel) ? "—" : Model.EducationLevel)</dd>
                </div>
            </dl>
        </div>

        <div class="bg-white rounded-2xl border border-slate-100 p-5 shadow-sm space-y-4">
            <h2 class="text-xs font-black text-slate-400 uppercase tracking-widest border-b border-slate-100 pb-2">Vận hành</h2>
            <div>
                <p class="text-xs text-slate-500 mb-1">Suất ăn mặc định / ngày</p>
                <p class="text-2xl font-black text-slate-900">@Model.DefaultDailyMeals.ToString("N0")</p>
            </div>
            <div>
                <p class="text-xs text-slate-500 mb-1">Đăng ký định kỳ (subscription)</p>
                <p class="text-sm font-bold @(Model.IsSubscriptionActive ? "text-emerald-700" : "text-slate-500")">@(Model.IsSubscriptionActive ? "Bật" : "Tắt")</p>
            </div>
            <div class="border-t border-slate-100 pt-4">
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Trạng thái hoạt động</p>
                <p class="text-xs text-slate-500 mb-3">Chỉ thay đổi cờ hoạt động trên hệ thống. Không chỉnh sửa tài khoản người dùng hay thông tin liên hệ từ đây.</p>
                <form method="post" asp-area="Manager" asp-controller="Catalog" asp-action="UpdateCustomerStatus" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    @if (Model.IsActive)
                    {
                        <label class="flex items-center gap-2 cursor-pointer text-sm font-bold text-emerald-800">
                            <input type="radio" name="isActive" value="true" checked />
                            Đang phục vụ
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer text-sm font-bold text-red-800">
                            <input type="radio" name="isActive" value="false" />
                            Tạm ngưng
                        </label>
                    }
                    else
                    {
                        <label class="flex items-center gap-2 cursor-pointer text-sm font-bold text-emerald-800">
                            <input type="radio" name="isActive" value="true" />
                            Đang phục vụ
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer text-sm font-bold text-red-800">
                            <input type="radio" name="isActive" value="false" checked />
                            Tạm ngưng
                        </label>
                    }
                    <button type="submit" class="w-full mt-2 py-2.5 rounded-xl bg-slate-900 text-white text-sm font-bold hover:bg-slate-800 transition">
                        Cập nhật trạng thái
                    </button>
                </form>
            </div>
        </div>
    </div>

    <p class="text-xs text-slate-400">Cập nhật gần nhất: @(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</p>
</div>
