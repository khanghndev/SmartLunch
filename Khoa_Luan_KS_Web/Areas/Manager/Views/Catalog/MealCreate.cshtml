@using Khoa_Luan_KS_Web.Models
@{
    ViewData["Title"] = "Thêm món ăn";
    Layout = "_LayoutManager";
}

<div x-data="mealCreator()" class="w-full max-w-[1600px] space-y-6 px-2 py-6 sm:px-4 md:py-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 sticky top-0 bg-slate-50/90 backdrop-blur-md pt-2 pb-4 z-40 border-b border-slate-200/60 -mt-4 mb-4">
        <div class="flex items-center gap-3">
            <a href="/Manager/Catalog/Meals" class="w-10 h-10 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-900 transition shadow-sm">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Thêm món ăn mới</h1>
                <p class="text-[11px] text-slate-500 font-bold uppercase tracking-widest mt-0.5">Danh mục thực đơn · SmartLunch</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Manager/Catalog/Meals"
               class="bg-white border border-slate-200 hover:bg-slate-50 font-bold px-4 py-2.5 rounded-xl shadow-sm transition flex items-center gap-2 text-sm text-slate-700">
                Hủy
            </a>
            <button type="button" @@click="saveAll()" :disabled="isSaving"
                    class="bg-green-600 hover:bg-green-700 disabled:opacity-50 text-white font-bold px-6 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                <template x-if="!isSaving"><i class="fas fa-plus"></i></template>
                <template x-if="isSaving"><i class="fas fa-spinner fa-spin"></i></template>
                <span x-text="isSaving ? 'Đang lưu...' : 'Thêm vào danh mục'"></span>
            </button>
        </div>
    </div>

    <form id="meal-create-form" class="grid grid-cols-1 xl:grid-cols-12 gap-6 xl:gap-8" @@submit.prevent="saveAll()">
        @Html.AntiForgeryToken()

        <div class="xl:col-span-8 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
                <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest mb-6 flex items-center gap-2 border-b border-slate-100 pb-3">
                    1. Thông tin món ăn
                </h3>

                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Tên món ăn <span class="text-red-500">*</span></label>
                        <input type="text" required x-model="formData.name" placeholder="Ví dụ: Cơm gà nướng sả ớt"
                               class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-[15px] rounded-xl focus:ring-green-500 focus:border-green-500 font-bold block p-3.5 shadow-sm" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Tên tiếng Anh <span class="text-slate-400 font-normal">(tùy chọn)</span></label>
                        <input type="text" x-model="formData.nameEnglish" placeholder="Grilled lemongrass chicken rice"
                               class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-medium shadow-sm" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Nhóm món (slot) <span class="text-red-500">*</span></label>
                            <select required x-model="formData.primarySlot" class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-bold shadow-sm">
                                <option value="">-- Chọn nhóm --</option>
                                @foreach (var (value, label) in MealFormOptions.SlotCategories)
                                {
                                    <option value="@value">@label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Cách chế biến <span class="text-red-500">*</span></label>
                            <select required x-model="formData.cookingMethod" class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-bold shadow-sm">
                                <option value="">-- Chọn cách chế biến --</option>
                                @foreach (var (value, label) in MealFormOptions.CookingMethods)
                                {
                                    <option value="@value">@label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Nhãn dinh dưỡng</label>
                        <select x-model="formData.dietaryLabel" class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-bold shadow-sm">
                            <option value="">Không có</option>
                            <option value="Thuần chay">Thuần chay</option>
                            <option value="Ăn kiêng">Ăn kiêng</option>
                            <option value="High Energy">High Energy</option>
                            <option value="Best Seller">Best Seller</option>
                            <option value="Healthy">Healthy</option>
                            <option value="Vegan">Vegan</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Mô tả</label>
                        <textarea x-model="formData.description" rows="4" placeholder="Thành phần, cách dùng, ghi chú phục vụ..."
                                  class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 shadow-sm font-medium leading-relaxed"></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Giá bán (VNĐ)</label>
                            <div class="flex">
                                <input type="number" min="0" step="500" x-model.number="formData.price"
                                       class="w-full bg-white border border-slate-200 border-r-0 rounded-l-xl text-green-700 text-lg focus:ring-green-500 focus:border-green-500 font-black block p-3 shadow-sm" />
                                <span class="inline-flex items-center px-4 bg-slate-50 border border-slate-200 rounded-r-xl text-slate-600 text-sm font-bold">₫</span>
                            </div>
                        </div>
                        <div class="flex items-end">
                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" x-model="formData.isActive" class="w-4 h-4 rounded border-slate-300 text-green-600 focus:ring-green-500" />
                                <span class="text-sm font-bold text-slate-700">Đưa vào thực đơn ngay (đang bán)</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="xl:col-span-4 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Hình ảnh (<span x-text="images.length"></span>/5)</h3>
                    <label x-show="images.length < 5" class="text-[10px] font-bold text-blue-600 hover:underline cursor-pointer">
                        Tải ảnh
                        <input type="file" accept="image/*" multiple class="hidden" @@change="handleFileSelect" />
                    </label>
                </div>

                <div class="w-full relative rounded-xl border border-slate-200 overflow-hidden bg-slate-50 aspect-video mb-4">
                    <template x-if="mainImageUrl">
                        <img :src="mainImageUrl" class="w-full h-full object-cover" alt="Preview" />
                    </template>
                    <template x-if="!mainImageUrl">
                        <div class="w-full h-full flex items-center justify-center text-slate-300 flex-col gap-2">
                            <i class="fas fa-image text-3xl"></i>
                            <span class="text-xs font-bold uppercase tracking-widest">Chưa có hình ảnh</span>
                        </div>
                    </template>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <template x-for="(img, index) in images" :key="index">
                        <div class="relative group aspect-square rounded-xl overflow-hidden border border-slate-200"
                             :class="img.role === 'cover' ? 'ring-2 ring-green-500 ring-offset-2' : ''">
                            <img :src="img.previewUrl" class="w-full h-full object-cover" />
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-2">
                                <button type="button" @@click="setAsMain(index)"
                                        class="px-2 py-1 bg-white text-[10px] font-black rounded-lg hover:bg-green-500 hover:text-white"
                                        x-show="img.role !== 'cover'">Ảnh chính</button>
                                <button type="button" @@click="removeImage(index)"
                                        class="w-8 h-8 bg-red-500 text-white rounded-lg flex items-center justify-center">
                                    <i class="fas fa-trash-alt text-xs"></i>
                                </button>
                            </div>
                            <div class="absolute top-1.5 left-1.5" x-show="img.role === 'cover'">
                                <span class="bg-green-500 text-white text-[8px] font-black uppercase px-1.5 py-0.5 rounded">Ảnh chính</span>
                            </div>
                        </div>
                    </template>
                </div>

                <p x-show="statusMsg" :class="statusIsError ? 'text-red-500' : 'text-emerald-600'"
                   class="mt-3 text-[10px] font-bold uppercase tracking-wider text-center" x-text="statusMsg"></p>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 border-t-[6px] border-t-orange-400">
                <h3 class="text-[15px] font-black text-slate-900 tracking-wider mb-5">Dinh dưỡng (1 suất)</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Calories</label>
                        <input type="number" x-model.number="formData.calories" min="0" step="1"
                               class="w-full bg-orange-50 border border-orange-200 text-orange-800 text-sm rounded-lg font-black block p-2.5 text-center" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Protein (g)</label>
                            <input type="number" x-model.number="formData.protein" min="0" step="0.1"
                                   class="w-full bg-blue-50 border border-blue-200 text-blue-800 text-sm rounded-lg font-bold block p-2 text-center" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Carbs (g)</label>
                            <input type="number" x-model.number="formData.carbs" min="0" step="0.1"
                                   class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-sm rounded-lg font-bold block p-2 text-center" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Fat (g)</label>
                        <input type="number" x-model.number="formData.fat" min="0" step="0.1"
                               class="w-full bg-purple-50 border border-purple-200 text-purple-800 text-sm rounded-lg font-bold block p-2 text-center" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function mealCreator() {
        return {
            isSaving: false,
            statusMsg: '',
            statusIsError: false,
            images: [],
            formData: {
                name: '',
                nameEnglish: '',
                primarySlot: '',
                cookingMethod: '',
                description: '',
                dietaryLabel: '',
                price: 0,
                isActive: true,
                calories: null,
                protein: null,
                carbs: null,
                fat: null
            },

            get mainImageUrl() {
                const cover = this.images.find(i => i.role === 'cover') || this.images[0];
                return cover ? cover.previewUrl : null;
            },

            handleFileSelect(e) {
                const files = Array.from(e.target.files || []);
                if (!files.length) return;
                const remaining = 5 - this.images.length;
                if (remaining <= 0) {
                    this.setStatus('Tối đa 5 ảnh', true);
                    return;
                }
                files.slice(0, remaining).forEach(file => {
                    this.images.push({
                        file,
                        previewUrl: URL.createObjectURL(file),
                        role: this.images.length === 0 ? 'cover' : 'gallery'
                    });
                });
            },

            removeImage(index) {
                URL.revokeObjectURL(this.images[index].previewUrl);
                this.images.splice(index, 1);
                if (this.images.length > 0 && !this.images.some(i => i.role === 'cover'))
                    this.images[0].role = 'cover';
            },

            setAsMain(index) {
                this.images.forEach((img, i) => img.role = i === index ? 'cover' : 'gallery');
            },

            setStatus(msg, isErr) {
                this.statusMsg = msg;
                this.statusIsError = isErr;
            },

            numOrNull(v) {
                if (v === '' || v === null || v === undefined) return null;
                const n = Number(v);
                return Number.isFinite(n) ? n : null;
            },

            async saveAll() {
                if (!this.formData.name?.trim()) {
                    this.setStatus('Vui lòng nhập tên món ăn', true);
                    return;
                }
                if (!this.formData.primarySlot) {
                    this.setStatus('Vui lòng chọn nhóm món', true);
                    return;
                }
                if (!this.formData.cookingMethod) {
                    this.setStatus('Vui lòng chọn cách chế biến', true);
                    return;
                }

                this.isSaving = true;
                this.setStatus('Đang xử lý...', false);

                try {
                    const csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const imageRequests = [];

                    for (const img of this.images) {
                        const fd = new FormData();
                        fd.append('file', img.file);
                        fd.append('__RequestVerificationToken', csrf);
                        const res = await fetch('/Manager/Catalog/UploadDishImage', { method: 'POST', body: fd });
                        if (!res.ok) throw new Error('Lỗi tải ảnh: ' + img.file.name);
                        const data = await res.json();
                        imageRequests.push({
                            mediaFileId: data.mediaFileId,
                            role: img.role,
                            sortOrder: imageRequests.length
                        });
                    }

                    const payload = {
                        name: this.formData.name.trim(),
                        nameEnglish: this.formData.nameEnglish?.trim() || null,
                        description: this.formData.description?.trim() || null,
                        dishSlotCategoryCodes: [this.formData.primarySlot],
                        cookingMethod: this.formData.cookingMethod,
                        price: Number(this.formData.price) || 0,
                        dietaryLabel: this.formData.dietaryLabel || null,
                        calories: this.numOrNull(this.formData.calories),
                        protein: this.numOrNull(this.formData.protein),
                        carbs: this.numOrNull(this.formData.carbs),
                        fat: this.numOrNull(this.formData.fat),
                        isActive: !!this.formData.isActive,
                        images: imageRequests.length ? imageRequests : null
                    };

                    const createRes = await fetch('/Manager/Catalog/CreateMeal', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrf
                        },
                        body: JSON.stringify(payload)
                    });

                    if (createRes.ok) {
                        const data = await createRes.json();
                        window.location.href = data.redirectUrl;
                        return;
                    }

                    const err = await createRes.json().catch(() => ({}));
                    throw new Error(err.message || 'Không thể tạo món ăn');
                } catch (err) {
                    this.setStatus(err.message || 'Có lỗi xảy ra', true);
                    this.isSaving = false;
                }
            }
        };
    }
</script>
}
