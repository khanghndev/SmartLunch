@{
    ViewData["Title"] = "Chỉnh sửa Thực Đơn";
    Layout = "_LayoutManager";
}

<div class="px-4 py-6 md:p-8 space-y-6" x-data="{ 
    mealComponents: [
        { id: 1, name: 'Thịt Ba chỉ Rang Cháy Cạnh', desc: '150g • Nguồn: CP Foods', icon: '🍲' },
        { id: 2, name: 'Trứng Gà Ốp la Lòng Đào', desc: '1 Quả • Nguồn: Ba Huân', icon: '🍳' },
        { id: 3, name: 'Salad Xà lách Dầu Dấm', desc: '100g • Xà lách mớ', icon: '🥗' }
    ],
    addComponent() {
        this.mealComponents.push({ id: Date.now(), name: '', desc: '', icon: '🍽️' });
    },
    removeComponent(index) {
        this.mealComponents.splice(index, 1);
    }
}">

    <!-- Top Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 sticky top-0 bg-gray-50/90 backdrop-blur-md pt-2 pb-4 z-40 border-b border-gray-200/50 -mt-4 mb-4">
        <div class="flex items-center gap-3">
            <a href="/Manager/MealDetail/M001" class="w-10 h-10 bg-white border border-gray-300 rounded-xl flex items-center justify-center text-gray-500 hover:text-gray-900 transition shadow-sm">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Chỉnh sửa Menu #MNU-8821</h1>
                <p class="text-[11px] text-gray-500 font-bold uppercase tracking-widest mt-0.5">Hệ thống F&B Management</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button class="bg-white border text-red-600 border-red-200 hover:bg-red-50 font-bold px-4 py-2.5 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-trash-alt"></i> Hủy Nháp
            </button>
            <button class="bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                <i class="fas fa-save"></i> Cập nhật Hệ thống
            </button>
        </div>
    </div>

    <!-- Layout 2 Cột -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Cột Trái: Dữ liệu chính -->
        <div class="lg:col-span-2 space-y-8">
            
            <!-- Khối 1: Thông tin Chung -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                <h3 class="text-sm font-black text-gray-900 uppercase tracking-widest mb-6 flex items-center gap-2 border-b border-gray-100 pb-3">
                    1. Định danh Menu
                </h3>
                
                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Tên Combo / Set Menu <span class="text-red-500">*</span></label>
                        <input type="text" value="Menu Văn Phòng Chuẩn Kèm Trà Đá" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-[15px] rounded-xl focus:ring-green-500 focus:border-green-500 font-bold block p-3.5 shadow-sm" />
                    </div>
                    
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Mô tả Khẩu phần</label>
                        <textarea rows="4" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 shadow-sm font-medium leading-relaxed">Thực đơn thiết kế dành riêng cho nhóm nhân viên văn phòng có mức vận động nhẹ nhàng. Hàm lượng Canxi và Vitamin E được cân bằng để chống nhức mỏi. Phần chất tạo ngọt từ đường hóa học được cắt giảm hoàn toàn, thay thế bằng vị ngọt tự nhiên từ rau củ luộc chậm. Không kèm trà đá cho chi nhánh 2.</textarea>
                    </div>
                </div>
            </div>

            <!-- Khối 2: Cấu trúc Thành phần (Món ăn con) -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-6">
                    <h3 class="text-sm font-black text-gray-900 uppercase tracking-widest flex items-center gap-2">
                        2. Cấu trúc Món Ăn (Components)
                    </h3>
                    <div class="text-[10px] bg-blue-50 text-blue-600 border border-blue-100 font-bold px-2 py-1 rounded">Dữ liệu Bếp Trung Tâm</div>
                </div>
                
                <!-- Component Editor List -->
                <div class="space-y-4">
                    <template x-for="(comp, index) in mealComponents" :key="comp.id">
                        <div class="flex items-start gap-4 p-4 bg-gray-50 border border-gray-200 rounded-xl relative group transition hover:border-gray-300">
                            <!-- Icon Selector (Fake) -->
                            <div class="w-12 h-12 bg-white rounded-lg border border-gray-200 flex items-center justify-center text-2xl shadow-sm shrink-0 cursor-pointer hover:bg-green-50" x-text="comp.icon"></div>
                            
                            <!-- Input Fields -->
                            <div class="flex-1 space-y-3">
                                <div>
                                    <input type="text" x-model="comp.name" placeholder="Tên món (VD: Cơm trắng, Thịt kho...)" class="w-full bg-white border border-gray-300 text-gray-900 text-sm font-bold rounded-lg focus:ring-green-500 focus:border-green-500 block p-2 shadow-sm" />
                                </div>
                                <div class="flex gap-3">
                                    <input type="text" x-model="comp.desc" placeholder="Định lượng & Nguồn (VD: 150g / MeatDeli)" class="w-full bg-white border border-gray-300 text-gray-500 text-xs font-medium rounded-lg focus:ring-green-500 focus:border-green-500 block p-2 shadow-sm" />
                                </div>
                            </div>
                            
                            <!-- Delete Btn -->
                            <button x-on:click="removeComponent(index)" class="text-gray-300 hover:text-red-500 transition px-2">
                                <i class="fas fa-trash-alt text-lg"></i>
                            </button>
                        </div>
                    </template>
                </div>

                <!-- Add Button -->
                <button type="button" x-on:click="addComponent()" class="w-full mt-4 border-2 border-dashed border-gray-300 text-gray-500 hover:border-green-500 hover:text-green-600 hover:bg-green-50/50 bg-white font-bold text-sm py-4 rounded-xl transition flex justify-center items-center gap-2">
                    <i class="fas fa-plus"></i> Thêm Món Phụ / Canh / Tráng miệng
                </button>
            </div>

            <!-- Khối 3: Cấu Hình Giá Tiền -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                <h3 class="text-sm font-black text-gray-900 uppercase tracking-widest mb-6 flex items-center gap-2 border-b border-gray-100 pb-3">
                    3. Thiết lập Giá & Hợp đồng
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Giá Cost (Tạm tính) <i class="fas fa-info-circle text-gray-300"></i></label>
                        <div class="flex">
                            <input type="number" value="21500" class="w-full bg-gray-50 border border-gray-200 border-r-0 rounded-l-xl text-gray-500 text-sm font-bold block p-3.5 cursor-not-allowed" disabled />
                            <span class="inline-flex items-center px-4 bg-gray-100 border border-gray-200 rounded-r-xl text-gray-400 text-sm font-bold">
                                ₫
                            </span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Giá Niêm yết (Bán ra) <span class="text-red-500">*</span></label>
                        <div class="flex">
                            <input type="number" value="35000" class="w-full bg-white border border-gray-300 border-r-0 rounded-l-xl text-green-700 text-lg focus:ring-green-500 focus:border-green-500 font-black block p-3 shadow-sm" />
                            <span class="inline-flex items-center px-4 bg-gray-50 border border-gray-300 rounded-r-xl text-gray-600 text-sm font-bold">
                                ₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Cột Phải: Sidebar Trạng thái & Dinh dưỡng -->
        <div class="lg:col-span-1 space-y-8">
            
            <!-- Trạng thái Phát hành -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-4">Trạng thái Khả dụng</h3>
                <select class="w-full bg-green-50 border border-green-200 text-green-800 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-3 font-bold shadow-sm">
                    <option selected>🔴 Đang Phục vụ (Active)</option>
                    <option>🟠 Tạm ngưng (Hết nguyên liệu)</option>
                    <option>⚫ Draft (Bản nháp F&B)</option>
                </select>
            </div>

            <!-- Upload Ảnh bìa -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Hình ảnh Món ăn (Visual)</h3>
                    <span class="text-[10px] font-bold text-blue-500 hover:underline cursor-pointer">Re-upload</span>
                </div>
                <div class="w-full relative rounded-xl border border-gray-200 overflow-hidden group cursor-pointer">
                    <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=400&q=80" alt="Food" class="w-full h-48 object-cover group-hover:opacity-75 transition" />
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/30">
                        <i class="fas fa-camera text-3xl text-white"></i>
                    </div>
                </div>
            </div>

            <!-- Nutrition Editor -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 border-t-[6px] border-t-orange-400">
                <h3 class="text-[15px] font-black text-gray-900 tracking-wider mb-5">Hồ sơ Dinh dưỡng (Macros)</h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Tổng Calories</label>
                        <input type="number" value="650" class="w-full bg-orange-50 border border-orange-200 text-orange-800 text-sm rounded-lg focus:ring-orange-500 font-black block p-2.5 text-center" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Protein</label>
                            <input type="number" value="30" class="w-full bg-blue-50 border border-blue-200 text-blue-800 text-sm rounded-lg focus:ring-blue-500 font-bold block p-2 text-center" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Carbs (Tinh bột)</label>
                            <input type="number" value="80" class="w-full bg-gray-50 border border-gray-200 text-gray-800 text-sm rounded-lg focus:ring-gray-500 font-bold block p-2 text-center" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dị ứng & Tags -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-4">Cảnh báo Dị ứng (Allergens)</h3>
                
                <div class="space-y-2">
                    <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer transition">
                        <input type="checkbox" checked class="w-4 h-4 text-green-600 border-gray-300 rounded focus:ring-green-500">
                        <span class="text-sm font-medium text-gray-800">Trứng / Gia cầm</span>
                    </label>
                    <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer transition">
                        <input type="checkbox" checked class="w-4 h-4 text-green-600 border-gray-300 rounded focus:ring-green-500">
                        <span class="text-sm font-medium text-gray-800">Đậu nành / Tương</span>
                    </label>
                    <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer transition">
                        <input type="checkbox" class="w-4 h-4 text-green-600 border-gray-300 rounded focus:ring-green-500">
                        <span class="text-sm font-medium text-gray-800">Đậu phộng / Lạc</span>
                    </label>
                    <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer transition">
                        <input type="checkbox" class="w-4 h-4 text-green-600 border-gray-300 rounded focus:ring-green-500">
                        <span class="text-sm font-medium text-gray-800">Hải sản / Đồ biển</span>
                    </label>
                </div>
            </div>

        </div> <!-- End Cột Phải -->

    </div>
</div>
