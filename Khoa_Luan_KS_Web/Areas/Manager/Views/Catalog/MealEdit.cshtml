@using Khoa_Luan_KS_Web.Models
@model Khoa_Luan_KS_Web.Services.DishDto
@{
    ViewData["Title"] = "Chỉnh sửa Món ăn";
    Layout = "_LayoutManager";
    var primarySlot = Model.PrimarySlotKey
        ?? Model.DishSlotCategoryCodes.FirstOrDefault()
        ?? Model.Category
        ?? "";
}

<div x-data="dishEditor()" class="w-full max-w-[1600px] space-y-6 px-2 py-6 sm:px-4 md:py-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 sticky top-0 bg-slate-50/90 backdrop-blur-md pt-2 pb-4 z-40 border-b border-slate-200/60 -mt-4 mb-4">
        <div class="flex items-center gap-3">
            <a href="/Manager/Catalog/MealDetail/@Model.Id" class="w-10 h-10 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-900 transition shadow-sm">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Chỉnh sửa món ăn</h1>
                <p class="text-[11px] text-slate-500 font-bold uppercase tracking-widest mt-0.5">@(!string.IsNullOrEmpty(Model.Code) ? Model.Code : $"#{Model.Id}")</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Manager/Catalog/MealDetail/@Model.Id"
               class="bg-white border border-slate-200 hover:bg-slate-50 font-bold px-4 py-2.5 rounded-xl shadow-sm transition flex items-center gap-2 text-sm text-slate-700">
                <i class="fas fa-eye"></i> Xem chi tiết
            </a>
            <button type="button" @@click="saveAll()" :disabled="isSaving"
                    class="bg-green-600 hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-bold px-6 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                <template x-if="!isSaving">
                    <i class="fas fa-save"></i>
                </template>
                <template x-if="isSaving">
                    <i class="fas fa-spinner fa-spin"></i>
                </template>
                Lưu cập nhật
            </button>
        </div>
    </div>

    <form id="meal-edit-form" class="grid grid-cols-1 xl:grid-cols-12 gap-6 xl:gap-8">
        @Html.AntiForgeryToken()

        <div class="xl:col-span-8 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
                <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest mb-6 flex items-center gap-2 border-b border-slate-100 pb-3">
                    1. Thông tin món ăn
                </h3>

                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Tên món ăn <span class="text-red-500">*</span></label>
                        <input name="Name" required x-model="formData.name"
                               class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-[15px] rounded-xl focus:ring-green-500 focus:border-green-500 font-bold block p-3.5 shadow-sm" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Tên tiếng Anh</label>
                        <input type="text" x-model="formData.nameEnglish" placeholder="English name"
                               class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-medium shadow-sm" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Nhóm món (slot)</label>
                            <select x-model="formData.primarySlot" class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-bold shadow-sm">
                                <option value="">-- Chọn nhóm --</option>
                                @foreach (var (value, label) in MealFormOptions.SlotCategories)
                                {
                                    <option value="@value">@label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Cách chế biến</label>
                            <select x-model="formData.cookingMethod" class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-bold shadow-sm">
                                <option value="">-- Chọn --</option>
                                @foreach (var (value, label) in MealFormOptions.CookingMethods)
                                {
                                    <option value="@value">@label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Nhãn dinh dưỡng</label>
                        <input name="DietaryLabel" x-model="formData.dietaryLabel"
                               placeholder="VD: Healthy / Best Seller..."
                               class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-bold shadow-sm" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Mô tả</label>
                        <textarea name="Description" x-model="formData.description" rows="4"
                                  class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 shadow-sm font-medium leading-relaxed"></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Giá bán (VNĐ)</label>
                            <div class="flex">
                                <input type="number" name="Price" min="0" step="500" x-model="formData.price"
                                       class="w-full bg-white border border-slate-200 border-r-0 rounded-l-xl text-green-700 text-lg focus:ring-green-500 focus:border-green-500 font-black block p-3 shadow-sm" />
                                <span class="inline-flex items-center px-4 bg-slate-50 border border-slate-200 rounded-r-xl text-slate-600 text-sm font-bold">₫</span>
                            </div>
                        </div>
                        <div class="flex items-end gap-3">
                            <div class="flex-1">
                                <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-1.5">Trạng thái</label>
                                <select name="IsActive" x-model="formData.isActive" class="w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3.5 font-bold shadow-sm">
                                    <option :value="true">🔴 Đang phục vụ (Active)</option>
                                    <option :value="false">⚫ Đã ẩn (Inactive)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="xl:col-span-4 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Hình ảnh món ăn (<span x-text="images.length"></span>/5)</h3>
                    <label x-show="images.length < 5" class="text-[10px] font-bold text-blue-600 hover:underline cursor-pointer">
                        Tải ảnh mới
                        <input type="file" accept="image/*" multiple class="hidden" @@change="handleFileSelect" />
                    </label>
                </div>

                <!-- Main Preview -->
                <div class="w-full relative rounded-xl border border-slate-200 overflow-hidden bg-slate-50 aspect-video mb-4">
                    <template x-if="mainImageUrl">
                        <img :src="mainImageUrl" class="w-full h-full object-cover" alt="Main dish image" />
                    </template>
                    <template x-if="!mainImageUrl">
                        <div class="w-full h-full flex items-center justify-center text-slate-300 flex-col gap-2">
                            <i class="fas fa-image text-3xl"></i>
                            <span class="text-xs font-bold uppercase tracking-widest">Chưa có hình ảnh</span>
                        </div>
                    </template>
                </div>

                <!-- Gallery Grid -->
                <div class="grid grid-cols-2 gap-3" id="dish-gallery">
                    <template x-for="(img, index) in images" :key="index">
                        <div class="relative group aspect-square rounded-xl overflow-hidden border border-slate-200"
                             :class="img.role === 'cover' ? 'ring-2 ring-green-500 ring-offset-2' : ''">
                            <img :src="img.previewUrl || img.url" class="w-full h-full object-cover" />
                            
                            <!-- Overlay -->
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-2">
                                <button type="button" @@click="setAsMain(index)" 
                                        class="px-2 py-1 bg-white text-[10px] font-black rounded-lg hover:bg-green-500 hover:text-white transition-colors"
                                        x-show="img.role !== 'cover'">
                                    Đặt làm ảnh chính
                                </button>
                                <button type="button" @@click="removeImage(index)"
                                        class="w-8 h-8 bg-red-500 text-white rounded-lg flex items-center justify-center hover:bg-red-600 transition-colors">
                                    <i class="fas fa-trash-alt text-xs"></i>
                                </button>
                            </div>

                            <!-- Role Badge -->
                            <div class="absolute top-1.5 left-1.5" x-show="img.role === 'cover'">
                                <span class="bg-green-500 text-white text-[8px] font-black uppercase px-1.5 py-0.5 rounded shadow-sm">Ảnh chính</span>
                            </div>
                        </div>
                    </template>
                </div>

                <p x-show="statusMsg" :class="statusIsError ? 'text-red-500' : 'text-slate-500'" 
                   class="mt-3 text-[10px] font-bold uppercase tracking-wider text-center" x-text="statusMsg"></p>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 border-t-[6px] border-t-orange-400">
                <h3 class="text-[15px] font-black text-slate-900 tracking-wider mb-5">Hồ sơ dinh dưỡng (Macros)</h3>

                <div class="space-y-4">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Calories</label>
                        <input type="number" x-model="formData.calories" min="0" step="1"
                               class="w-full bg-orange-50 border border-orange-200 text-orange-800 text-sm rounded-lg focus:ring-orange-500 font-black block p-2.5 text-center" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Protein (g)</label>
                            <input type="number" x-model="formData.protein" min="0" step="0.1"
                                   class="w-full bg-blue-50 border border-blue-200 text-blue-800 text-sm rounded-lg focus:ring-blue-500 font-bold block p-2 text-center" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Carbs (g)</label>
                            <input type="number" x-model="formData.carbs" min="0" step="0.1"
                                   class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-sm rounded-lg focus:ring-slate-500 font-bold block p-2 text-center" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Fat (g)</label>
                        <input type="number" x-model="formData.fat" min="0" step="0.1"
                               class="w-full bg-purple-50 border border-purple-200 text-purple-800 text-sm rounded-lg focus:ring-purple-500 font-bold block p-2 text-center" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function dishEditor() {
        return {
            isSaving: false,
            statusMsg: '',
            statusIsError: false,
            images: @Html.Raw(Json.Serialize(Model.Images)), // Initial from server
            formData: {
                name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name)),
                nameEnglish: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NameEnglish ?? "")),
                primarySlot: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(primarySlot)),
                cookingMethod: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CookingMethod ?? "")),
                description: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Description ?? "")),
                dietaryLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DietaryLabel ?? "")),
                price: @Model.Price,
                isActive: @(Model.IsActive ? "true" : "false"),
                calories: @(Model.Calories ?? 0),
                protein: @(Model.Protein ?? 0),
                carbs: @(Model.Carbs ?? 0),
                fat: @(Model.Fat ?? 0)
            },
            
            get mainImageUrl() {
                const cover = this.images.find(i => i.role === 'cover') || this.images[0];
                return cover ? (cover.previewUrl || cover.url) : null;
            },

            handleFileSelect(e) {
                const files = Array.from(e.target.files);
                if (!files.length) return;

                const remaining = 5 - this.images.length;
                if (remaining <= 0) {
                    this.setStatus('Đã đạt giới hạn tối đa 5 ảnh', true);
                    return;
                }

                const toAdd = files.slice(0, remaining);
                toAdd.forEach(file => {
                    this.images.push({
                        file: file,
                        previewUrl: URL.createObjectURL(file),
                        role: this.images.length === 0 ? 'cover' : 'gallery',
                        mediaFileId: 0 // Indicates it needs upload
                    });
                });
                
                if (files.length > remaining) {
                    this.setStatus('Chỉ lấy được ' + remaining + ' ảnh đầu tiên do giới hạn 5 ảnh.', false);
                } else {
                    this.setStatus('', false);
                }
            },

            removeImage(index) {
                const img = this.images[index];
                if (img.previewUrl && img.file) {
                    URL.revokeObjectURL(img.previewUrl);
                }
                this.images.splice(index, 1);
                
                // Ensure there is always a cover if images exist
                if (this.images.length > 0 && !this.images.some(i => i.role === 'cover')) {
                    this.images[0].role = 'cover';
                }
            },

            setAsMain(index) {
                this.images.forEach((img, i) => {
                    img.role = (i === index) ? 'cover' : 'gallery';
                });
            },

            setStatus(msg, isError) {
                this.statusMsg = msg;
                this.statusIsError = isError;
                if (msg) setTimeout(() => { if(this.statusMsg === msg) this.statusMsg = ''; }, 3000);
            },

            async saveAll() {
                if (!this.formData.name) {
                    this.setStatus('Vui lòng nhập tên món ăn', true);
                    return;
                }

                this.isSaving = true;
                this.setStatus('Đang xử lý...', false);

                try {
                    const csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    // 1. Upload new files
                    for (let img of this.images) {
                        if (img.mediaFileId === 0 && img.file) {
                            const formData = new FormData();
                            formData.append('file', img.file);
                            formData.append('__RequestVerificationToken', csrf);

                            const res = await fetch('/Manager/Catalog/UploadDishImage', {
                                method: 'POST',
                                body: formData
                            });
                            
                            if (!res.ok) throw new Error('Lỗi upload ảnh: ' + img.file.name);
                            const data = await res.json();
                            img.mediaFileId = data.mediaFileId;
                            delete img.file; // Prevent re-upload
                        }
                    }

                    const payload = {
                        name: this.formData.name,
                        nameEnglish: this.formData.nameEnglish || null,
                        description: this.formData.description || null,
                        dishSlotCategoryCodes: this.formData.primarySlot ? [this.formData.primarySlot] : null,
                        cookingMethod: this.formData.cookingMethod || null,
                        price: Number(this.formData.price) || 0,
                        dietaryLabel: this.formData.dietaryLabel || null,
                        isActive: !!this.formData.isActive,
                        calories: this.formData.calories || null,
                        protein: this.formData.protein || null,
                        carbs: this.formData.carbs || null,
                        fat: this.formData.fat || null,
                        images: this.images.map((img, idx) => ({
                            mediaFileId: img.mediaFileId,
                            role: img.role,
                            sortOrder: idx
                        }))
                    };

                    // 3. Submit UpdateMeal
                    const updateRes = await fetch('/Manager/Catalog/UpdateMeal/@Model.Id', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrf
                        },
                        body: JSON.stringify(payload)
                    });

                    if (updateRes.ok) {
                        this.setStatus('Lưu thành công!', false);
                        setTimeout(() => window.location.href = '/Manager/Catalog/MealDetail/@Model.Id', 1000);
                    } else {
                        const errData = await updateRes.json().catch(() => ({}));
                        throw new Error(errData.message || 'Lỗi khi cập nhật thông tin món ăn');
                    }

                } catch (err) {
                    console.error(err);
                    this.setStatus(err.message || 'Có lỗi xảy ra', true);
                    this.isSaving = false;
                }
            }
        };
    }
</script>
}
