@model Khoa_Luan_KS_Web.Services.AdminGetUsersResponse
@using Khoa_Luan_KS_Web.Areas.Manager.Models
@{
    ViewData["Title"] = "Quản lý Nhân Viên";
    Layout = "_LayoutManager";
    var curPage = (int)(ViewBag.CurrentPage ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var serverSearch = ViewBag.SearchTerm as string ?? "";
    var roleFilter = ViewBag.RoleName as string ?? "";
    var pagination = ViewBag.Pagination as ManagerPaginationVm ?? new ManagerPaginationVm
    {
        Controller = "Catalog",
        Action = "Employees",
        Page = curPage,
        PageSize = pageSize,
        TotalCount = Model.TotalCount,
        ItemCount = Model.Items.Count,
        SearchTerm = serverSearch,
        RoleName = roleFilter
    };

    static string StaffRole(IReadOnlyList<string> roles)
    {
        var exclude = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "Customer", "Organization", "Company",
            "Khách hàng cá nhân", "Khách hàng doanh nghiệp"
        };
        return roles.FirstOrDefault(r => !exclude.Contains(r)) ?? "Nhân viên";
    }

    static string RoleBadgeClass(string role) => role switch
    {
        "ChefStaff" => "bg-orange-50 text-orange-700 border-orange-100",
        "WarehouseStaff" => "bg-purple-50 text-purple-700 border-purple-100",
        "SalesStaff" => "bg-blue-50 text-blue-700 border-blue-100",
        "Manager" => "bg-green-50 text-green-700 border-green-100",
        "Admin" or "Super Admin" => "bg-slate-100 text-slate-700 border-slate-200",
        "Shipper" => "bg-amber-50 text-amber-700 border-amber-100",
        _ => "bg-gray-50 text-gray-700 border-gray-100"
    };

    string Initials(Khoa_Luan_KS_Web.Services.AdminUserDto u)
    {
        var a = u.FirstName?.Length > 0 ? u.FirstName[0].ToString() : "";
        var b = u.LastName?.Length > 0 ? u.LastName[0].ToString() : "";
        return string.IsNullOrEmpty(a + b) ? "NV" : a + b;
    }
}

<div class="px-4 py-6 md:p-8 space-y-8" x-data="employeeManager()">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Hồ sơ Cán bộ Nhân viên</h1>
            <p class="text-sm text-gray-500 mt-1">Hệ thống quản lý định danh và hồ sơ vận hành bếp</p>
        </div>
        <button type="button" x-on:click="isModalOpen = true" class="bg-green-600 hover:bg-green-700 text-white font-bold px-5 py-2.5 rounded-xl shadow-sm hover:shadow-md transition-all flex items-center gap-2">
            <i class="fas fa-plus"></i> Thêm Nhân Viên
        </button>
    </div>

    <form id="lockForm" method="post" asp-area="Manager" asp-controller="Catalog" asp-action="LockEmployee" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="lockId" />
        <input type="hidden" name="page" value="@curPage" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="searchTerm" value="@serverSearch" />
        <input type="hidden" name="roleName" value="@roleFilter" />
    </form>
    <form id="unlockForm" method="post" asp-area="Manager" asp-controller="Catalog" asp-action="UnlockEmployee" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="unlockId" />
        <input type="hidden" name="page" value="@curPage" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="searchTerm" value="@serverSearch" />
        <input type="hidden" name="roleName" value="@roleFilter" />
    </form>
    <form id="resetPasswordForm" method="post" asp-area="Manager" asp-controller="Catalog" asp-action="ResetEmployeePassword" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="resetId" />
        <input type="hidden" name="newPassword" id="resetNewPassword" />
        <input type="hidden" name="page" value="@curPage" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="searchTerm" value="@serverSearch" />
        <input type="hidden" name="roleName" value="@roleFilter" />
    </form>

    <form method="get" asp-area="Manager" asp-controller="Catalog" asp-action="Employees"
          class="flex flex-col md:flex-row gap-4 justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <div class="relative w-full md:w-96 text-gray-400 focus-within:text-green-600">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2"></i>
            <input type="text" name="searchTerm" value="@serverSearch" placeholder="Tìm tên nhân viên, email, mã NV..."
                   class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block pl-10 p-2.5 transition-colors" />
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto">
            <select name="roleName" class="bg-white border border-gray-200 text-gray-700 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 flex-1 md:min-w-[180px] font-medium">
                <option value="" selected="@(string.IsNullOrEmpty(roleFilter))">Tất cả Bộ phận</option>
                @foreach (var role in new[] { "Admin", "Manager", "WarehouseStaff", "ChefStaff", "SalesStaff", "Shipper" })
                {
                    <option value="@role" selected="@(roleFilter == role)">@role</option>
                }
            </select>
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 rounded-lg text-sm font-bold transition shadow-sm">
                <i class="fas fa-filter mr-1"></i> Lọc
            </button>
            <a asp-area="Manager" asp-controller="Catalog" asp-action="Employees"
               class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 px-4 py-2.5 rounded-lg text-sm font-bold transition">Xóa lọc</a>
        </div>
    </form>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-gray-50 border-b border-gray-100 text-gray-500 text-[11px] uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Nhân viên</th>
                        <th class="px-6 py-4">Mã NV</th>
                        <th class="px-6 py-4">Khối / Bộ phận</th>
                        <th class="px-6 py-4">Ngày vào làm</th>
                        <th class="px-6 py-4">Trạng thái</th>
                        <th class="px-6 py-4 text-center">Tác vụ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-400">
                                <i class="fas fa-users text-3xl mb-2 opacity-40"></i>
                                <p class="font-medium">Không có nhân viên phù hợp bộ lọc.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var u in Model.Items)
                    {
                        var role = StaffRole(u.RoleNames);
                        var inactive = !u.IsActive;
                        <tr class="hover:bg-gray-50/80 transition-colors group @(inactive ? "opacity-60" : "")">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-4">
                                    @if (u.Id % 2 == 0)
                                    {
                                        <img src="https://i.pravatar.cc/150?u=@u.Id" alt="" class="w-10 h-10 rounded-full object-cover ring-2 ring-gray-100 shadow-sm @(inactive ? "grayscale" : "")" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold ring-2 ring-blue-50 shadow-sm">@Initials(u)</div>
                                    }
                                    <div>
                                        <div class="font-bold text-gray-900 text-sm @(inactive ? "line-through decoration-gray-400" : "")">@u.FullName</div>
                                        <div class="text-[12px] text-gray-500 mt-0.5">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-gray-600 font-medium tracking-wide">
                                <span class="bg-gray-100/80 text-gray-600 px-2.5 py-1 rounded-md text-xs font-bold border border-gray-200">#@u.Id.ToString("D3")</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold border @RoleBadgeClass(role)">@role</span>
                            </td>
                            <td class="px-6 py-4 text-gray-600 font-medium">@(u.LastLoginAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="px-6 py-4">
                                @if (u.IsActive)
                                {
                                    <div class="flex items-center gap-2 text-green-600 font-bold text-xs bg-green-50 px-2.5 py-1 w-fit rounded-lg border border-green-100">
                                        <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div> Đang làm việc
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-2 text-red-600 font-bold text-xs bg-red-50 px-2.5 py-1 w-fit rounded-lg border border-red-100">
                                        <div class="w-1.5 h-1.5 rounded-full bg-red-500"></div> Đã nghỉ việc
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4 text-center opacity-70 group-hover:opacity-100 transition-opacity">
                                <div class="flex items-center justify-center gap-2">
                                    <a href="/Manager/EmployeeDetail/@u.Id" class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center hover:bg-blue-600 hover:text-white transition shadow-sm" title="Xem chi tiết">
                                        <i class="fas fa-eye text-xs"></i>
                                    </a>
                                    <button type="button" @@click="resetPassword(@u.Id)" class="w-8 h-8 rounded-lg bg-gray-50 text-gray-600 flex items-center justify-center hover:bg-gray-200 hover:text-gray-900 transition border border-gray-200" title="Đặt lại mật khẩu">
                                        <i class="fas fa-key text-xs"></i>
                                    </button>
                                    @if (u.IsActive)
                                    {
                                        <button type="button" @@click="lockEmployee(@u.Id)" class="w-8 h-8 rounded-lg bg-red-50 text-red-600 flex items-center justify-center hover:bg-red-600 hover:text-white transition border border-red-200" title="Khóa hồ sơ">
                                            <i class="fas fa-lock text-xs"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @@click="unlockEmployee(@u.Id)" class="w-8 h-8 rounded-lg bg-green-50 text-green-600 flex items-center justify-center hover:bg-green-600 hover:text-white transition border border-green-200" title="Khôi phục hồ sơ">
                                            <i class="fas fa-unlock text-xs"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_PaginationBar" model="pagination" />
    </div>

    <!-- MODAL: Thêm Nhân Viên (giữ UI, chưa nối API) -->
    <div x-show="isModalOpen" style="display: none;" class="fixed inset-0 z-[100] flex items-center justify-center px-4" x-transition.opacity.duration.300ms>
        <div x-on:click="isModalOpen = false" class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity"></div>
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl z-10 overflow-hidden transform transition-all relative">
            <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center font-bold shadow-sm">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 tracking-tight">Tạo Hồ Sơ Nhân Viên Mới</h3>
                        <p class="text-xs font-medium text-gray-500 mt-0.5">Chức năng tạo mới sẽ được bổ sung qua API</p>
                    </div>
                </div>
                <button type="button" x-on:click="isModalOpen = false" class="text-gray-400 hover:text-gray-600 bg-white hover:bg-gray-100 w-8 h-8 rounded-lg flex items-center justify-center transition border border-gray-100 shadow-sm">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="px-6 py-8 text-center text-gray-500 text-sm">
                Vui lòng tạo nhân viên qua quản trị hệ thống hoặc API <code class="text-xs bg-gray-100 px-1 rounded">POST /api/v1/master-data/User</code>.
            </div>
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">
                <button type="button" x-on:click="isModalOpen = false" class="px-5 py-2.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-100">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('employeeManager', () => ({
                isModalOpen: false,

                lockEmployee(id) {
                    if (confirm('Bạn có chắc chắn muốn khóa hồ sơ nhân viên này?')) {
                        document.getElementById('lockId').value = id;
                        document.getElementById('lockForm').submit();
                    }
                },

                unlockEmployee(id) {
                    if (confirm('Bạn có chắc chắn muốn khôi phục hồ sơ nhân viên này?')) {
                        document.getElementById('unlockId').value = id;
                        document.getElementById('unlockForm').submit();
                    }
                },

                resetPassword(id) {
                    const newPass = prompt('Nhập mật khẩu mới cho nhân viên này:');
                    if (newPass) {
                        document.getElementById('resetId').value = id;
                        document.getElementById('resetNewPassword').value = newPass;
                        document.getElementById('resetPasswordForm').submit();
                    }
                }
            }));
        });
    </script>
}
