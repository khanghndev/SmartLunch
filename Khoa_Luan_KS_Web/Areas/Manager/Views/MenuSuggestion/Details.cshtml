@model Khoa_Luan_KS_Web.Services.MenuSuggestionDto

@{
    ViewData["Title"] = "Chi Tiết Gợi Ý Thực Đơn";
    Layout = "~/Areas/Manager/Views/Shared/_LayoutManager.cshtml";
    var plans = Model.Plans ?? new List<Khoa_Luan_KS_Web.Services.MenuSuggestionPlanDto>();
    var bestPlan = plans.OrderByDescending(p => p.PlanScore).FirstOrDefault();

    // Slot display helpers
    string SlotLabel(string slot) => slot switch {
        "main" => "Món chính", "soup" => "Canh/Súp", "vegetable" => "Rau xanh",
        "side" => "Món phụ", "dessert" => "Tráng miệng", "noodle_soup" => "Món nước",
        _ => slot
    };
    string SlotColor(string slot) => slot switch {
        "main" => "bg-red-50 text-red-700 border-red-100",
        "soup" => "bg-blue-50 text-blue-700 border-blue-100",
        "vegetable" => "bg-green-50 text-green-700 border-green-100",
        "side" => "bg-orange-50 text-orange-700 border-orange-100",
        "dessert" => "bg-purple-50 text-purple-700 border-purple-100",
        "noodle_soup" => "bg-amber-50 text-amber-700 border-amber-100",
        _ => "bg-slate-50 text-slate-600 border-slate-100"
    };
    string DayLabel(string name) {
        if (name is null) return "";
        var m = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
            ["Thu_2"]="Thứ 2",["Thu_3"]="Thứ 3",["Thu_4"]="Thứ 4",["Thu_5"]="Thứ 5",
            ["Thu_6"]="Thứ 6",["Thu_7"]="Thứ 7",["CN"]="Chủ nhật"
        };
        return m.TryGetValue(name, out var v) ? v : name;
    }
}

<style>
    .detail-stat-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px 20px;
    }
    .plan-tab {
        padding: 12px 20px;
        font-size: 13px;
        font-weight: 700;
        color: #64748b;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border-top: none;
        border-left: none;
        border-right: none;
    }
    .plan-tab:hover { color: #16a34a; background: #f0fdf4; }
    .plan-tab.active { color: #16a34a; border-bottom-color: #16a34a; background: #fff; }
    .day-column {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-width: 180px;
    }
    .day-header {
        background: linear-gradient(135deg, #1e293b, #334155);
        color: #fff;
        text-align: center;
        padding: 12px 8px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
    .dish-slot-item {
        padding: 10px 12px;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.15s;
    }
    .dish-slot-item:last-child { border-bottom: none; }
    .dish-slot-item:hover { background: #f8fafc; }
    .slot-badge {
        font-size: 9px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 5px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border: 1px solid;
    }
    .day-footer {
        margin-top: auto;
        padding: 10px 12px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .score-bar {
        height: 4px;
        background: #e2e8f0;
        border-radius: 2px;
        overflow: hidden;
    }
    .score-fill {
        height: 100%;
        background: linear-gradient(90deg, #16a34a, #22c55e);
        border-radius: 2px;
    }
</style>

<div class="px-4 md:px-6 py-6 mx-auto max-w-7xl" x-data="{ activeTab: @(bestPlan?.Id ?? (plans.FirstOrDefault()?.Id ?? 0)) }">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-7">
        <div class="flex items-center gap-3 flex-1">
            <a href="@Url.Action("Index")"
               class="w-10 h-10 flex items-center justify-center bg-white rounded-xl shadow-sm border border-slate-200 hover:bg-slate-50 transition-colors shrink-0">
                <i data-lucide="arrow-left" class="w-5 h-5 text-slate-600"></i>
            </a>
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight">
                        Thực đơn Tuần @Model.WeekStart.ToString("dd/MM/yyyy")
                    </h1>
                    <span class="px-2.5 py-1 bg-green-600 text-white text-[10px] font-black uppercase tracking-wider rounded-lg shadow-sm">
                        AI Generated
                    </span>
                </div>
                <p class="text-sm text-slate-400 font-medium mt-1 flex items-center gap-1.5">
                    <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                    Tạo lúc @Model.GeneratedAt.ToString("HH:mm - dd/MM/yyyy")
                    &nbsp;·&nbsp; v@(Model.Version)
                    &nbsp;·&nbsp; @plans.Count phương án
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <a href="@Url.Action("Index")"
               class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl font-bold hover:bg-slate-50 transition-all text-sm">
                <i data-lucide="list" class="w-4 h-4"></i> Danh sách
            </a>
            <a href="@Url.Action("Generate")"
               class="flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white rounded-xl font-bold hover:bg-green-700 transition-all shadow-sm shadow-green-600/20 text-sm">
                <i data-lucide="sparkles" class="w-4 h-4"></i> Tạo mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 rounded-2xl flex items-center gap-3 border border-emerald-200">
            <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0"></i>
            <span class="font-bold text-sm">@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 text-red-700 rounded-2xl flex items-center gap-3 border border-red-200">
            <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
            <span class="font-bold text-sm">@TempData["Error"]</span>
        </div>
    }

    <!-- Stats Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-7">
        <div class="detail-stat-card">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Ngân sách/Suất</p>
            <p class="text-xl font-black text-green-600">@(Model.BudgetPerServing?.ToString("N0") ?? "N/A") đ</p>
        </div>
        <div class="detail-stat-card">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Số phương án</p>
            <p class="text-xl font-black text-slate-900">@plans.Count Plans</p>
        </div>
        <div class="detail-stat-card">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Rule Base</p>
            <p class="text-xl font-black text-slate-900 capitalize">@(Model.RulesKey ?? "—")</p>
        </div>
        <div class="detail-stat-card">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Phiên bản</p>
            <p class="text-xl font-black text-slate-900">v@(Model.Version)</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuggestionText))
    {
        <div class="bg-green-50 p-5 rounded-2xl mb-7 border border-green-100 flex items-start gap-4">
            <div class="w-9 h-9 bg-green-600 text-white rounded-xl flex items-center justify-center shrink-0 shadow-sm">
                <i data-lucide="bot" class="w-5 h-5"></i>
            </div>
            <div>
                <p class="text-xs font-black text-green-700 uppercase tracking-widest mb-1">AI Nhận xét</p>
                <p class="text-sm text-green-800 font-medium leading-relaxed">@Model.SuggestionText</p>
            </div>
        </div>
    }

    @if (!plans.Any())
    {
        <div class="bg-white rounded-2xl p-12 text-center border border-slate-100 shadow-sm">
            <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="calendar-x" class="w-8 h-8 text-slate-300"></i>
            </div>
            <h3 class="text-lg font-black text-slate-700 mb-2">Chưa có phương án nào</h3>
            <p class="text-slate-400 text-sm">Gợi ý này chưa được AI xử lý hoặc không có kết quả phù hợp.</p>
        </div>
    }
    else
    {
        <!-- Plans Tabs Container -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <!-- Tab Header -->
            <div class="flex border-b border-slate-100 overflow-x-auto bg-slate-50/50">
                @foreach (var plan in plans.OrderBy(p => p.Rank))
                {
                    var isBest = plan.Id == bestPlan?.Id;
                    var scorePercent = (double)plan.PlanScore * 20; // scale to 100%
                    <button @@click="activeTab = @plan.Id"
                            class="plan-tab"
                            :class="activeTab === @plan.Id ? 'active' : ''">
                        <span class="w-7 h-7 rounded-lg flex items-center justify-center text-[11px] font-black shrink-0"
                              :class="activeTab === @plan.Id ? 'bg-green-600 text-white' : 'bg-slate-100 text-slate-500'">
                            @plan.Rank
                        </span>
                        <span>
                            Phương án @plan.Rank
                            @if (isBest)
                            {
                                <span class="ml-1 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded font-black uppercase">Best</span>
                            }
                        </span>
                        <span class="ml-auto text-[10px] font-black"
                              :class="activeTab === @plan.Id ? 'text-green-600' : 'text-slate-400'">
                            @plan.PlanScore.ToString("0.0")★
                        </span>
                    </button>
                }
            </div>

            <!-- Tab Content -->
            <div class="p-5 bg-slate-50/30">
                @foreach (var plan in plans.OrderBy(p => p.Rank))
                {
                    <div x-show="activeTab === @plan.Id"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         style="display:none;">

                        <!-- Plan Summary Bar -->
                        <div class="flex items-center gap-4 mb-5 p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Điểm tổng</p>
                                <p class="text-lg font-black text-green-600">@plan.PlanScore.ToString("0.00")</p>
                            </div>
                            <div class="flex-1">
                                <div class="score-bar">
                                    <div class="score-fill" style="width: @Math.Min((double)plan.PlanScore * 20, 100)%"></div>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Objective</p>
                                <p class="text-sm font-bold text-slate-600">@plan.ObjectiveValue.ToString("0.0")</p>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Ngày</p>
                                <p class="text-sm font-bold text-slate-800">@plan.Days.Count ngày</p>
                            </div>
                            <div class="border-l border-slate-100 pl-4">
                                <form asp-action="ApplyAsWeeklyMenu" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="suggestionId" value="@Model.Id" />
                                    <input type="hidden" name="planId" value="@plan.Id" />
                                    <button type="submit" class="flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-bold rounded-lg transition-colors shadow-sm">
                                        <i data-lucide="calendar-check" class="w-4 h-4"></i>
                                        Áp dụng thực đơn
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Weekly Calendar Grid -->
                        <div class="flex gap-3 overflow-x-auto pb-2">
                            @foreach (var day in plan.Days.OrderBy(d => d.DayIndex))
                            {
                                var dailyCost = day.Items.Sum(i => i.CostPerServing);
                                <div class="day-column" style="flex: 1; min-width: 160px;">
                                    <div class="day-header">@DayLabel(day.DayName)</div>
                                    <div class="flex-1">
                                        @if (!day.Items.Any())
                                        {
                                            <div class="flex flex-col items-center justify-center py-8 text-slate-300">
                                                <i data-lucide="coffee" class="w-7 h-7 mb-2 opacity-60"></i>
                                                <span class="text-[11px] font-bold uppercase tracking-wider">Không có món</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var item in day.Items.OrderBy(i => i.SlotCategory))
                                            {
                                                <div class="dish-slot-item">
                                                    <span class="slot-badge @SlotColor(item.SlotCategory)">
                                                        @SlotLabel(item.SlotCategory)
                                                    </span>
                                                    <h5 class="text-xs font-bold text-slate-900 mt-1.5 leading-tight">@item.DishName</h5>
                                                    <div class="flex items-center justify-between mt-1">
                                                        <span class="text-[10px] font-bold text-green-600">@item.CostPerServing.ToString("N0")đ</span>
                                                        <span class="text-[10px] font-bold text-slate-400">@item.Score.ToString("0.0")★</span>
                                                    </div>
                                                    @if (item.Reasons.Any())
                                                    {
                                                        <div class="mt-1.5 flex flex-wrap gap-1">
                                                            @foreach (var reason in item.Reasons.Take(2))
                                                            {
                                                                <span class="text-[9px] font-medium text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded truncate max-w-full">
                                                                    @reason
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="day-footer">
                                        <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">Chi phí/ngày</span>
                                        <span class="text-xs font-black text-slate-900">@dailyCost.ToString("N0")đ</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
