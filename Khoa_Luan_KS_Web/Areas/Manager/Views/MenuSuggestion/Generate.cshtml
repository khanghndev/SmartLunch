@model Khoa_Luan_KS_Web.Services.GenerateMenuSuggestionFromAiRequest
@using Khoa_Luan_KS_Web.Services

@{
    ViewData["Title"] = "Tạo Gợi Ý Thực Đơn";
    Layout = "~/Areas/Manager/Views/Shared/_LayoutManager.cshtml";
    var dishes = ViewBag.Dishes as List<DishDto> ?? new List<DishDto>();

    // Define structured days with English values for backend mapping
    var allDays = new[] {
        new { label = "Thứ 2", value = "Thứ 2" },
        new { label = "Thứ 3", value = "Thứ 3" },
        new { label = "Thứ 4", value = "Thứ 4" },
        new { label = "Thứ 5", value = "Thứ 5" },
        new { label = "Thứ 6", value = "Thứ 6" },
        new { label = "Thứ 7", value = "Thứ 7" },
        new { label = "Chủ nhật", value = "Chủ nhật" }
    };

    var allStructures = new[] {
        new { label = "Món chính", value = "Món chính", icon = "beef", color = "red" },
        new { label = "Món canh",  value = "Món canh",  icon = "soup", color = "blue" },
        new { label = "Món rau",   value = "Món rau",   icon = "leaf", color = "green" },
        new { label = "Món phụ",   value = "Món phụ",   icon = "utensils", color = "orange" },
        new { label = "Tráng miệng", value = "Tráng miệng", icon = "candy", color = "purple" }
    };
}

<style>
    .gen-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .panel-label {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #94a3b8;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .field-input {
        width: 100%;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }
    .field-input:focus {
        border-color: #16a34a;
        box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
    }
    .day-toggle input { display: none; }
    .day-toggle span {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 14px;
        font-size: 11px;
        font-weight: 800;
        background: #f1f5f9;
        color: #94a3b8;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        line-height: 1.2;
        flex-direction: column;
    }
    .day-toggle input:checked + span {
        background: #16a34a;
        color: #fff;
        border-color: #15803d;
        box-shadow: 0 4px 12px rgba(22,163,74,0.3);
    }
    .meal-toggle input { display: none; }
    .meal-toggle span {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        background: #f1f5f9;
        color: #64748b;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }
    .meal-toggle input:checked + span {
        background: #f0fdf4;
        color: #15803d;
        border-color: #86efac;
    }
    .dish-card {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }
    .dish-card:hover { border-color: #86efac; background: #f0fdf4; }
    .dish-card.selected { border-color: #16a34a; background: #f0fdf4; }
    .dish-card .check-mark {
        position: absolute;
        top: 8px; right: 8px;
        width: 20px; height: 20px;
        border-radius: 50%;
        background: #16a34a;
        display: flex; align-items: center; justify-content: center;
        opacity: 0; transform: scale(0.5);
        transition: all 0.2s;
    }
    .dish-card.selected .check-mark { opacity: 1; transform: scale(1); }
    .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 16px;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 8px 20px rgba(22,163,74,0.35);
        display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .submit-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(22,163,74,0.45); }
    .submit-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

    .slot-badge {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .slot-main { background: #fef2f2; color: #dc2626; }
    .slot-soup { background: #eff6ff; color: #2563eb; }
    .slot-vegetable { background: #f0fdf4; color: #16a34a; }
    .slot-side { background: #fff7ed; color: #ea580c; }
    .slot-dessert { background: #faf5ff; color: #9333ea; }
    .slot-noodle_soup { background: #fffbeb; color: #d97706; }
    .slot-other { background: #f1f5f9; color: #64748b; }
</style>

<div class="px-4 md:px-6 py-6 mx-auto max-w-7xl" x-data="menuGen()">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-7">
        <a href="@Url.Action("Index")"
           class="w-10 h-10 flex items-center justify-center bg-white rounded-xl shadow-sm border border-slate-200 hover:bg-slate-50 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-slate-600"></i>
        </a>
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Tạo Gợi Ý AI</h1>
            <p class="text-sm text-slate-500 font-medium mt-0.5">Thiết lập thông số để AI xây dựng thực đơn tuần tối ưu nhất.</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 text-red-700 rounded-2xl flex items-center gap-3 border border-red-200">
            <div class="w-8 h-8 bg-red-100 rounded-xl flex items-center justify-center shrink-0">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
            </div>
            <span class="font-bold text-sm">@TempData["Error"]</span>
        </div>
    }

    <form method="post" action="@Url.Action("Generate")" @@submit.prevent="submitForm" x-ref="form">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
            <!-- Left: Settings (2 cols) -->
            <div class="lg:col-span-2 space-y-5">

                <!-- Basic Settings -->
                <div class="gen-panel">
                    <h3 class="text-sm font-black text-slate-800 flex items-center gap-2 mb-5">
                        <i data-lucide="settings-2" class="w-4 h-4 text-green-600"></i>
                        Thông số cơ bản
                    </h3>

                    <div class="space-y-4">
                        <div>
                            <div class="panel-label"><i data-lucide="calendar" class="w-3.5 h-3.5"></i> Ngày bắt đầu tuần</div>
                            <input type="date" name="WeekStartUtc" value="@Model.WeekStartUtc.ToString("yyyy-MM-dd")"
                                   required class="field-input">
                        </div>

                        <div>
                            <div class="panel-label"><i data-lucide="wallet" class="w-3.5 h-3.5"></i> Ngân sách / Suất (VNĐ)</div>
                            <input type="number" name="BudgetPerServing" value="@Model.BudgetPerServing"
                                   min="10000" step="1000" required class="field-input">
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <div class="panel-label"><i data-lucide="layers" class="w-3.5 h-3.5"></i> Số phương án</div>
                                <input type="number" name="TopK" value="@Model.TopK"
                                       min="1" max="10" required class="field-input">
                            </div>
                            <div>
                                <div class="panel-label"><i data-lucide="zap" class="w-3.5 h-3.5"></i> Rule Base</div>
                                @{
                                    var rk = Model.RulesKey ?? "industrial";
                                    var ruleOpts = new (string Value, string Label)[]
                                    {
                                        ("industrial", "Công nghiệp (industrial)"),
                                        ("org_company", "Doanh nghiệp (org_company)"),
                                        ("org_elementary", "Mầm non / tiểu học (org_elementary)"),
                                        ("org_primary_school", "Tiểu học (org_primary_school)"),
                                        ("org_secondary_school", "THCS (org_secondary_school)"),
                                        ("org_high_school", "THPT (org_high_school)"),
                                        ("vegetarian", "Chay (vegetarian)"),
                                    };
                                }
                                <select name="RulesKey" class="field-input">
                                    @foreach (var ro in ruleOpts)
                                    {
                                        if (rk == ro.Value)
                                        {
                                            <option value="@ro.Value" selected>@ro.Label</option>
                                        }
                                        else
                                        {
                                            <option value="@ro.Value">@ro.Label</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Days -->
                <div class="gen-panel">
                    <h3 class="text-sm font-black text-slate-800 flex items-center gap-2 mb-5">
                        <i data-lucide="calendar-days" class="w-4 h-4 text-green-600"></i>
                        Ngày áp dụng
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        @{
                            var dayLabels = new[] { "T2", "T3", "T4", "T5", "T6", "T7", "CN" };
                        }
                        @for (int di = 0; di < allDays.Length; di++)
                        {
                            var d = allDays[di];
                            var isChecked = Model.Days.Contains(d.value);
                            <label class="day-toggle">
                                <input type="checkbox" name="Days" value="@d.value" @(isChecked ? "checked" : "")>
                                <span>@dayLabels[di]</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Meal Structure -->
                <div class="gen-panel">
                    <h3 class="text-sm font-black text-slate-800 flex items-center gap-2 mb-5">
                        <i data-lucide="layout-grid" class="w-4 h-4 text-green-600"></i>
                        Thành phần bữa ăn
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var s in allStructures)
                        {
                            var isChecked = Model.MealStructure.Contains(s.value);
                            <label class="meal-toggle">
                                <input type="checkbox" name="MealStructure" value="@s.value" @(isChecked ? "checked" : "")>
                                <span><i data-lucide="@s.icon" class="w-3.5 h-3.5"></i> @s.label</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" class="submit-btn" :disabled="isSubmitting || selectedCount === 0"
                        x-bind:class="selectedCount === 0 ? 'opacity-50 cursor-not-allowed' : ''">
                    <template x-if="!isSubmitting">
                        <span class="flex items-center gap-2">
                            <i data-lucide="cpu" class="w-5 h-5"></i>
                            <span x-show="selectedCount === 0">Vui lòng chọn ít nhất 1 món</span>
                            <span x-show="selectedCount > 0">Khởi chạy AI (<span x-text="selectedCount"></span> món)</span>
                        </span>
                    </template>
                    <template x-if="isSubmitting">
                        <span class="flex items-center gap-2">
                            <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            AI đang phân tích thực đơn...
                        </span>
                    </template>
                </button>

                @if (dishes.Count == 0)
                {
                    <div class="p-4 bg-amber-50 rounded-2xl border border-amber-200 flex items-start gap-3">
                        <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"></i>
                        <p class="text-sm text-amber-700 font-medium">
                            Không thể tải danh sách món ăn. Vui lòng kiểm tra kết nối Backend và đảm bảo database đã được khởi tạo đúng.
                        </p>
                    </div>
                }
            </div>

            <!-- Right: Dish Selection (3 cols) -->
            <div class="lg:col-span-3 gen-panel flex flex-col" style="min-height: 700px;">
                <!-- Panel Header -->
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-black text-slate-800 flex items-center gap-2">
                            <i data-lucide="utensils" class="w-4 h-4 text-green-600"></i>
                            Kho Món Ăn
                        </h3>
                        <p class="text-xs text-slate-400 font-medium mt-1">
                            Chọn món ăn AI được phép sử dụng
                            <span class="text-green-600 font-bold">(<span x-text="selectedCount">0</span> đã chọn)</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @@click="selectAll()"
                                class="px-3 py-1.5 bg-green-50 border border-green-200 rounded-lg text-xs font-bold text-green-700 hover:bg-green-100 transition-colors">
                            Tất cả
                        </button>
                        <button type="button" @@click="deselectAll()"
                                class="px-3 py-1.5 bg-red-50 border border-red-200 rounded-lg text-xs font-bold text-red-600 hover:bg-red-100 transition-colors">
                            Bỏ chọn
                        </button>
                    </div>
                </div>

                <!-- Search & Filter -->
                <div class="flex gap-2 mb-4">
                    <div class="relative flex-1">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                        <input type="text" x-model="searchQuery" placeholder="Tìm tên món..."
                               class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all">
                    </div>
                    <select x-model="selectedSlot" class="bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3 text-sm font-bold text-slate-600 focus:ring-2 focus:ring-green-500 cursor-pointer">
                        <option value="">Tất cả loại</option>
                        <option value="main">Món chính</option>
                        <option value="soup">Món canh</option>
                        <option value="vegetable">Món rau</option>
                        <option value="side">Món phụ</option>
                        <option value="dessert">Tráng miệng</option>
                        <option value="noodle_soup">Món nước</option>
                    </select>
                </div>

                <!-- Dish Grid -->
                <div class="flex-1 overflow-y-auto" style="max-height: 560px;">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pb-2">
                        <template x-for="dish in filteredDishes" :key="dish.id">
                            <div class="dish-card" :class="isSelected(dish.id) ? 'selected' : ''"
                                 @@click="toggleDish(dish.id)">
                                <div class="check-mark">
                                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>

                                <!-- hidden input -->
                                <template x-if="isSelected(dish.id)">
                                    <input type="checkbox" name="DishIds" :value="dish.id" checked class="hidden">
                                </template>

                                <div class="flex items-start gap-3 pr-6">
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5"
                                         :class="getSlotBg(dish.primarySlot)">
                                        <i :data-lucide="getSlotIcon(dish.primarySlot)" class="w-4 h-4"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4 class="text-sm font-bold text-slate-900 truncate" x-text="dish.name"></h4>
                                        <p class="text-[11px] text-slate-400 truncate mt-0.5" x-text="dish.description || ''"></p>
                                        <div class="flex items-center gap-2 mt-1.5">
                                            <span class="text-xs font-black text-green-600" x-text="formatMoney(dish.price) + 'đ'"></span>
                                            <span class="slot-badge" :class="'slot-' + (dish.primarySlot || 'other')" x-text="getSlotLabel(dish.primarySlot)"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </template>

                        <div x-show="filteredDishes.length === 0" class="col-span-full py-12 text-center" style="display:none">
                            <i data-lucide="search-x" class="w-10 h-10 text-slate-300 mx-auto mb-3"></i>
                            <p class="text-slate-400 font-medium text-sm">Không tìm thấy món ăn phù hợp</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('menuGen', () => ({
                isSubmitting: false,
                searchQuery: '',
                selectedSlot: '',
                allDishes: @Html.Raw(Json.Serialize(dishes.Select(d => new {
                    id = d.Id,
                    name = d.Name,
                    price = d.Price,
                    description = d.Description,
                    calories = d.Calories,
                    primarySlot = (d.PrimarySlotKey ?? d.Category ?? "").ToLowerInvariant(),
                    slotKeys = d.DishSlotCategoryCodes ?? new List<string>()
                }))),
                selectedIds: [],

                init() {
                    lucide.createIcons();
                    this.selectedIds = this.allDishes.map(d => d.id);
                    this.$nextTick(() => lucide.createIcons());
                },

                get filteredDishes() {
                    return this.allDishes.filter(d => {
                        const q = this.searchQuery.toLowerCase();
                        const matchSearch = !q || d.name.toLowerCase().includes(q);
                        if (!this.selectedSlot) return matchSearch;
                        const keys = d.slotKeys || [];
                        const matchSlot = d.primarySlot === this.selectedSlot ||
                            keys.some(k => (k || '').toLowerCase() === this.selectedSlot);
                        return matchSearch && matchSlot;
                    });
                },

                get selectedCount() { return this.selectedIds.length; },

                isSelected(id) { return this.selectedIds.includes(id); },

                toggleDish(id) {
                    const idx = this.selectedIds.indexOf(id);
                    if (idx > -1) this.selectedIds.splice(idx, 1);
                    else this.selectedIds.push(id);
                },

                selectAll() {
                    const ids = this.filteredDishes.map(d => d.id);
                    const s = new Set([...this.selectedIds, ...ids]);
                    this.selectedIds = Array.from(s);
                },

                deselectAll() {
                    const ids = new Set(this.filteredDishes.map(d => d.id));
                    this.selectedIds = this.selectedIds.filter(id => !ids.has(id));
                },

                submitForm() {
                    if (this.selectedIds.length === 0) return;
                    this.isSubmitting = true;

                    const form = this.$refs.form;
                    // Remove old hidden DishIds
                    form.querySelectorAll('input[name="DishIds"]').forEach(el => el.remove());
                    // Add fresh hidden inputs
                    this.selectedIds.forEach(id => {
                        const inp = document.createElement('input');
                        inp.type = 'hidden';
                        inp.name = 'DishIds';
                        inp.value = id;
                        form.appendChild(inp);
                    });
                    form.submit();
                },

                formatMoney(n) { return new Intl.NumberFormat('vi-VN').format(n); },

                getSlotLabel(slot) {
                    const m = { main: 'Chính', soup: 'Canh', vegetable: 'Rau', side: 'Phụ', dessert: 'Tráng miệng', noodle_soup: 'Nước' };
                    return m[slot] || 'Khác';
                },

                getSlotIcon(slot) {
                    const m = { main: 'beef', soup: 'soup', vegetable: 'leaf', side: 'utensils', dessert: 'candy', noodle_soup: 'bowl' };
                    return m[slot] || 'circle';
                },

                getSlotBg(slot) {
                    const m = { main: 'bg-red-50 text-red-600', soup: 'bg-blue-50 text-blue-600', vegetable: 'bg-green-50 text-green-600', side: 'bg-orange-50 text-orange-600', dessert: 'bg-purple-50 text-purple-600', noodle_soup: 'bg-amber-50 text-amber-600' };
                    return m[slot] || 'bg-slate-50 text-slate-500';
                }
            }));
        });
    </script>
}
