@model Khoa_Luan_KS_Web.Services.GetMenuSuggestionsResponse

@{
    ViewData["Title"] = "Gợi Ý Thực Đơn AI";
    Layout = "~/Areas/Manager/Views/Shared/_LayoutManager.cshtml";
    var items = Model.Items ?? new List<Khoa_Luan_KS_Web.Services.MenuSuggestionSummaryDto>();
    int pageSize = Model.PageSize > 0 ? Model.PageSize : 10;
    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / pageSize);
    int currentPage = Model.Page > 0 ? Model.Page : 1;
}

<style>
    .suggestion-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .suggestion-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -12px rgba(22, 163, 74, 0.2);
    }
    .shimmer {
        background: linear-gradient(90deg, #f0fdf4 25%, #dcfce7 50%, #f0fdf4 75%);
        background-size: 200% 100%;
        animation: shimmer 2s infinite;
    }
    @@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    .badge-version {
        background: linear-gradient(135deg, #166534, #15803d);
    }
    .hero-gradient {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 50%, #bbf7d0 100%);
    }
</style>

<div class="px-4 md:px-6 py-6 mx-auto max-w-7xl">
    <!-- Hero Header -->
    <div class="hero-gradient rounded-3xl p-6 md:p-8 mb-8 border border-green-100 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 opacity-10">
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                <path fill="#16a34a" d="M47.1,-57.1C59.5,-45.7,67.3,-28.9,69.2,-11.5C71.1,5.9,67.2,23.9,57.2,37.3C47.3,50.7,31.3,59.5,13.5,64.5C-4.3,69.5,-23.8,70.8,-38.9,63.1C-54,55.4,-64.7,38.7,-69,20.5C-73.3,2.3,-71.2,-17.4,-62,-31.9C-52.8,-46.4,-36.5,-55.7,-20.3,-62.9C-4.1,-70.1,11.9,-75.1,26.8,-72C41.7,-68.8,55.4,-57.5,47.1,-57.1Z" transform="translate(100 100)" />
            </svg>
        </div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-green-600 rounded-2xl flex items-center justify-center shadow-md">
                        <i data-lucide="brain-circuit" class="w-5 h-5 text-white"></i>
                    </div>
                    <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Gợi Ý Thực Đơn AI</h1>
                </div>
                <p class="text-slate-500 font-medium ml-[52px]">Phân tích và đề xuất thực đơn tối ưu từ Trí tuệ nhân tạo</p>
            </div>
            <a href="@Url.Action("Generate", "MenuSuggestion", new { area = "Manager" })"
               class="group flex items-center gap-3 bg-green-600 text-white px-6 py-3.5 rounded-2xl font-bold shadow-lg shadow-green-600/30 hover:bg-green-700 hover:shadow-green-600/40 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap self-start md:self-auto">
                <i data-lucide="sparkles" class="w-5 h-5 group-hover:animate-pulse"></i>
                Tạo Gợi Ý Mới
            </a>
        </div>
    </div>

    <!-- Stats Row + Search -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <!-- Stat -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden">
            <div class="absolute -top-4 -right-4 w-20 h-20 bg-green-500/8 rounded-full"></div>
            <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 bg-green-50 text-green-600 rounded-xl flex items-center justify-center">
                    <i data-lucide="history" class="w-4 h-4"></i>
                </div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Tổng đợt gợi ý</span>
            </div>
            <p class="text-3xl font-black text-slate-900">@Model.TotalCount</p>
        </div>

        <!-- Search -->
        <div class="md:col-span-3 bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex items-center">
            <form method="get" class="w-full flex gap-3">
                <div class="relative flex-1">
                    <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]"
                           placeholder="Tìm kiếm theo tuần, ngân sách..."
                           class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all font-medium text-slate-700 placeholder:text-slate-400 text-sm">
                </div>
                <button type="submit" class="px-6 py-3 bg-green-600 text-white rounded-xl font-bold hover:bg-green-700 transition-colors shadow-sm text-sm whitespace-nowrap">
                    Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty((string?)ViewData["SearchTerm"]))
                {
                    <a href="@Url.Action("Index")" class="px-5 py-3 bg-slate-100 text-slate-600 rounded-xl font-bold hover:bg-slate-200 transition-colors text-sm whitespace-nowrap">
                        Xóa
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 rounded-2xl flex items-center gap-3 border border-emerald-200">
            <div class="w-8 h-8 bg-emerald-100 rounded-xl flex items-center justify-center shrink-0">
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
            </div>
            <span class="font-bold text-sm">@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 text-red-700 rounded-2xl flex items-center gap-3 border border-red-200">
            <div class="w-8 h-8 bg-red-100 rounded-xl flex items-center justify-center shrink-0">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
            </div>
            <span class="font-bold text-sm">@TempData["Error"]</span>
        </div>
    }

    <!-- Grid List -->
    @if (!items.Any())
    {
        <div class="bg-white rounded-3xl p-16 text-center shadow-sm border border-slate-100 flex flex-col items-center justify-center">
            <div class="w-24 h-24 bg-green-50 rounded-full flex items-center justify-center mb-6">
                <i data-lucide="bot" class="w-10 h-10 text-green-400"></i>
            </div>
            <h3 class="text-xl font-black text-slate-900 mb-2">Chưa có gợi ý nào</h3>
            <p class="text-slate-500 mb-8 max-w-md text-sm leading-relaxed">Hãy sử dụng tính năng tạo gợi ý AI để hệ thống phân tích và đề xuất các mẫu thực đơn tối ưu nhất cho bạn.</p>
            <a href="@Url.Action("Generate")" class="inline-flex items-center gap-2 text-green-600 font-bold hover:text-green-700 bg-green-50 hover:bg-green-100 px-6 py-3 rounded-2xl transition-all">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                Tạo gợi ý ngay
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var item in items)
            {
                <a href="@Url.Action("Details", new { id = item.Id })"
                   class="suggestion-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden block group">
                    <!-- Card Top Color Bar -->
                    <div class="h-1.5 bg-gradient-to-r from-green-400 to-emerald-600"></div>

                    <div class="p-5">
                        <!-- Header -->
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-green-50 text-green-600 rounded-xl flex items-center justify-center shrink-0">
                                    <i data-lucide="calendar-days" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-black text-slate-900 group-hover:text-green-600 transition-colors">
                                        Tuần @item.WeekStart.ToString("dd/MM/yyyy")
                                    </h3>
                                    <p class="text-[11px] text-slate-400 font-medium flex items-center gap-1 mt-0.5">
                                        <i data-lucide="clock" class="w-3 h-3"></i>
                                        @item.GeneratedAt.ToString("HH:mm - dd/MM/yyyy")
                                    </p>
                                </div>
                            </div>
                            <span class="badge-version text-white text-[10px] font-black px-2.5 py-1 rounded-lg shadow-sm">
                                v@(item.Version)
                            </span>
                        </div>

                        <!-- Stats -->
                        <div class="grid grid-cols-3 gap-3 pt-4 border-t border-slate-50">
                            <div class="text-center">
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-1">Ngân sách</p>
                                <p class="text-sm font-black text-green-600">
                                    @(item.BudgetPerServing.HasValue ? item.BudgetPerServing.Value.ToString("N0") + "đ" : "N/A")
                                </p>
                            </div>
                            <div class="text-center border-x border-slate-50">
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-1">Phương án</p>
                                <p class="text-sm font-black text-slate-800">@(item.PlanCount ?? 0)</p>
                            </div>
                            <div class="text-center">
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-1">Rule</p>
                                <p class="text-sm font-black text-slate-800 capitalize">@(item.RulesKey ?? "—")</p>
                            </div>
                        </div>

                        <!-- View CTA -->
                        <div class="mt-4 pt-4 border-t border-slate-50 flex items-center justify-between">
                            <span class="text-xs text-slate-400 font-medium">AI Generated</span>
                            <span class="text-xs font-bold text-green-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                                Xem chi tiết <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="mt-8 flex justify-center">
                <nav class="flex items-center gap-1.5 bg-white px-3 py-2 rounded-2xl shadow-sm border border-slate-100">
                    @if (currentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = currentPage - 1, searchTerm = ViewData["SearchTerm"] })"
                           class="w-9 h-9 flex items-center justify-center text-slate-600 hover:bg-slate-50 rounded-xl transition-colors">
                            <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        </a>
                    }
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="w-9 h-9 flex items-center justify-center bg-green-600 text-white rounded-xl font-bold text-sm shadow-sm shadow-green-600/20">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", new { page = i, searchTerm = ViewData["SearchTerm"] })"
                               class="w-9 h-9 flex items-center justify-center text-slate-600 hover:bg-slate-50 rounded-xl font-semibold transition-colors text-sm">@i</a>
                        }
                    }
                    @if (currentPage < totalPages)
                    {
                        <a href="@Url.Action("Index", new { page = currentPage + 1, searchTerm = ViewData["SearchTerm"] })"
                           class="w-9 h-9 flex items-center justify-center text-slate-600 hover:bg-slate-50 rounded-xl transition-colors">
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </a>
                    }
                </nav>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
