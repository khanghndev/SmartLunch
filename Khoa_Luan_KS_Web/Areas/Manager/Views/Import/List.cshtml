@{
    ViewData["Title"] = "Danh sách Yêu Cầu Nhập Hàng";
    Layout = "_LayoutManager";
}

<div class="bg-white rounded-xl shadow overflow-hidden">
    <!-- Header -->
    <div class="px-4 md:px-6 pt-4 md:pt-6 pb-3 md:pb-4 flex items-center gap-3">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-green-100">
            <i class="fas fa-boxes text-green-600"></i>
        </div>
        <h1 class="text-xl md:text-2xl font-semibold text-green-600">Quản lý nhập nguyên liệu</h1>
    </div>

    <!-- Tabs -->
    <div class="border-t border-b bg-gray-50 px-3 md:px-6 py-2 overflow-x-auto">
         <div class="flex items-center gap-2 md:gap-3 min-w-max">
            <a href="/Manager/ImportCreate" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Tạo đề xuất</a>
            <a href="/Manager/ImportList" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap bg-green-100 text-green-700 shadow-sm">Danh sách</a>
            <a href="/Manager/ImportApprove" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Duyệt phiếu</a>
            <a href="/Manager/ImportReceipt" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Nhập kho</a>
            <a href="/Manager/ImportHistory" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Lịch sử</a>
        </div>
    </div>

    <!-- Content -->
    <div class="p-4 md:p-6 overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="p-4">Mã Phiếu</th>
                    <th class="p-4">Người đề xuất</th>
                    <th class="p-4">Mục đích</th>
                    <th class="p-4">Ngày tạo</th>
                    <th class="p-4">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b">
                     <td class="p-4 font-bold text-blue-600">IM-2604-01</td>
                     <td class="p-4">Staff01 - NV Bếp</td>
                     <td class="p-4">Gia vị bổ sung Kho 2</td>
                     <td class="p-4 text-gray-500">26/04 14:00</td>
                     <td class="p-4"><span class="px-2 py-1 bg-yellow-100 text-yellow-700 text-xs rounded font-bold">Chờ duyệt</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
