@{
    ViewData["Title"] = "Tạo Yêu Cầu Nhập Hàng";
    Layout = "_LayoutManager";
}

<div class="bg-white rounded-xl shadow overflow-hidden">
    <!-- Header -->
    <div class="px-4 md:px-6 pt-4 md:pt-6 pb-3 md:pb-4 flex items-center gap-3">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-green-100">
            <i class="fas fa-boxes text-green-600"></i>
        </div>
        <h1 class="text-xl md:text-2xl font-semibold text-green-600">Quản lý nhập nguyên liệu</h1>
    </div>

    <!-- Tabs -->
    <div class="border-t border-b bg-gray-50 px-3 md:px-6 py-2 overflow-x-auto">
        <div class="flex items-center gap-2 md:gap-3 min-w-max">
            <a href="/Manager/ImportCreate" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap bg-green-100 text-green-700 shadow-sm">Tạo đề xuất</a>
            <a href="/Manager/ImportList" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Danh sách</a>
            <a href="/Manager/ImportApprove" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Duyệt phiếu</a>
            <a href="/Manager/ImportReceipt" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Nhập kho</a>
            <a href="/Manager/ImportHistory" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Lịch sử</a>
        </div>
    </div>

    <!-- Content -->
    <div class="p-4 md:p-6 space-y-6 max-w-3xl">
        <div class="bg-gray-50 border rounded-xl p-6">
            <h2 class="font-bold text-lg text-gray-800 border-b pb-2 mb-4">Tạo phiếu đề xuất mua hàng / nhập hàng</h2>
            <form class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mục đích nhập hàng</label>
                    <input type="text" placeholder="Phục vụ thực đơn Tuần..." class="w-full border px-3 py-2 rounded focus:ring-green-500" />
                </div>
                <div>
                     <label class="block text-sm font-medium text-gray-700 mb-1">Danh sách nguyên liệu</label>
                     <textarea rows="4" placeholder="Nhập tên, số lượng, đơn vị tính..." class="w-full border px-3 py-2 rounded focus:ring-green-500"></textarea>
                </div>
                <div class="pt-4 text-right">
                    <button type="button" class="bg-green-600 text-white px-6 py-2 rounded font-bold shadow hover:bg-green-700">Tạo phiếu</button>
                </div>
            </form>
        </div>
    </div>
</div>
