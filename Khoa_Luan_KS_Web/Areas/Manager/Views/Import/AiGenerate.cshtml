@model Khoa_Luan_KS_Web.Services.GenerateIngredientPrepFromAiClientRequest
@using Khoa_Luan_KS_Web.Services

@{
    ViewData["Title"] = "Gợi ý nhập nguyên liệu (AI)";
    Layout = "~/Areas/Manager/Views/Shared/_LayoutManager.cshtml";
}

<style>
    .gen-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .panel-label {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #94a3b8;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .field-input {
        width: 100%;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }
    .field-input:focus {
        border-color: #16a34a;
        box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
    }
    .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 14px 16px;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 8px 20px rgba(22,163,74,0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .submit-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(22,163,74,0.45); }
    .submit-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }
</style>

<div class="px-4 md:px-6 py-6 mx-auto max-w-7xl" x-data="aiIngredientPrep()">
    <div class="flex items-center gap-4 mb-7">
        <a href="@Url.Action("Index","Import", new { area = "Manager" })"
           class="w-10 h-10 flex items-center justify-center bg-white rounded-xl shadow-sm border border-slate-200 hover:bg-slate-50 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-slate-600"></i>
        </a>
        <div class="flex-1">
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Gợi ý nhập nguyên liệu (AI)</h1>
            <p class="text-sm text-slate-500 font-medium mt-0.5">
                Thiết lập khoảng thời gian và điều kiện tồn kho để AI/OR-Tools đề xuất lượng cần mua. Có thể lưu thành phiếu đề xuất nhập.
            </p>
        </div>
        <a href="@Url.Action("Index","Import", new { area = "Manager" })"
           class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 font-bold text-sm hover:bg-slate-50">
            <i data-lucide="file-text" class="w-4 h-4"></i>
            Danh sách phiếu
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <div class="lg:col-span-2 space-y-5">
            <div class="gen-panel">
                <h3 class="text-sm font-black text-slate-800 flex items-center gap-2 mb-5">
                    <i data-lucide="settings-2" class="w-4 h-4 text-green-600"></i>
                    Thông số lập kế hoạch
                </h3>

                <div class="space-y-4">
                    <div>
                        <div class="panel-label"><i data-lucide="calendar" class="w-3.5 h-3.5"></i> Ngày bắt đầu</div>
                        <input type="date" class="field-input" x-model="form.startDate" required>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="panel-label"><i data-lucide="clock-3" class="w-3.5 h-3.5"></i> Số ngày</div>
                            <input type="number" class="field-input" min="1" max="31" step="1" x-model.number="form.days" required>
                        </div>
                        <div>
                            <div class="panel-label"><i data-lucide="timer" class="w-3.5 h-3.5"></i> Lead time (ngày)</div>
                            <input type="number" class="field-input" min="0" max="30" step="1" x-model.number="form.leadTimeDays">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="panel-label"><i data-lucide="shield" class="w-3.5 h-3.5"></i> Safety stock (kg)</div>
                            <input type="number" class="field-input" min="0" step="0.1" x-model.number="form.safetyStockKg">
                        </div>
                        <div>
                            <div class="panel-label"><i data-lucide="package" class="w-3.5 h-3.5"></i> Tồn tối đa (kg)</div>
                            <input type="number" class="field-input" min="0" step="0.1" x-model.number="form.maxInventoryKg">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="panel-label"><i data-lucide="file-signature" class="w-3.5 h-3.5"></i> ContractId (tuỳ chọn)</div>
                            <input type="number" class="field-input" min="1" step="1" x-model.number="form.contractId">
                        </div>
                        <div>
                            <div class="panel-label"><i data-lucide="layers" class="w-3.5 h-3.5"></i> DishValueId (override)</div>
                            <input type="number" class="field-input" min="1" step="1" x-model.number="form.dishValueIdOverride">
                        </div>
                    </div>

                    <div>
                        <div class="panel-label"><i data-lucide="sticky-note" class="w-3.5 h-3.5"></i> Ghi chú phiếu (nếu lưu)</div>
                        <input type="text" class="field-input" placeholder="VD: Kế hoạch nhập tuần này..." x-model="form.proposalHeaderNote">
                    </div>

                    <div class="flex items-center justify-between gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200">
                        <div>
                            <p class="text-sm font-black text-slate-800">Lưu thành phiếu đề xuất</p>
                            <p class="text-xs text-slate-500 font-medium mt-0.5">Bật để tự tạo phiếu đề xuất nhập sau khi sinh kế hoạch.</p>
                        </div>
                        <label class="inline-flex items-center cursor-pointer select-none">
                            <input type="checkbox" class="sr-only peer" x-model="form.persistAsProposal">
                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:bg-green-600 relative transition">
                                <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full transition-all peer-checked:translate-x-5"></div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <button type="button" class="submit-btn" @@click="run()" :disabled="loading">
                <template x-if="!loading">
                    <span class="flex items-center gap-2">
                        <i data-lucide="sparkles" class="w-5 h-5"></i>
                        Sinh kế hoạch từ AI
                    </span>
                </template>
                <template x-if="loading">
                    <span class="flex items-center gap-2">
                        <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Đang phân tích đơn hàng...
                    </span>
                </template>
            </button>

            <div x-show="error" class="p-4 bg-red-50 text-red-700 rounded-2xl flex items-start gap-3 border border-red-200" style="display:none">
                <div class="w-8 h-8 bg-red-100 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
                    <i data-lucide="alert-circle" class="w-4 h-4"></i>
                </div>
                <div>
                    <p class="font-black text-sm">Không thể sinh kế hoạch</p>
                    <p class="text-sm font-semibold mt-0.5" x-text="error"></p>
                </div>
            </div>

            @Html.AntiForgeryToken()
        </div>

        <div class="lg:col-span-3 gen-panel">
            <div class="flex items-start justify-between gap-3 mb-4">
                <div>
                    <h3 class="text-sm font-black text-slate-800 flex items-center gap-2">
                        <i data-lucide="list-checks" class="w-4 h-4 text-green-600"></i>
                        Kết quả đề xuất
                    </h3>
                    <p class="text-xs text-slate-400 font-medium mt-1">Danh sách nguyên liệu cần mua và tổng hợp theo ngày.</p>
                </div>

                <template x-if="result?.proposal?.proposalCode">
                    <a :href="'@Url.Action("Index","Import", new { area="Manager" })#' + result.proposal.proposalCode"
                       class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-green-50 border border-green-200 text-green-700 font-black text-xs hover:bg-green-100">
                        <i data-lucide="badge-check" class="w-4 h-4"></i>
                        Đã lưu: <span x-text="result.proposal.proposalCode"></span>
                    </a>
                </template>
            </div>

            <div x-show="!result && !loading" class="py-16 text-center" style="display:none">
                <i data-lucide="cpu" class="w-10 h-10 text-slate-300 mx-auto mb-3"></i>
                <p class="text-slate-400 font-medium text-sm">Chưa có dữ liệu. Hãy chạy AI để xem kết quả.</p>
            </div>

            <template x-if="result">
                <div class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
                            <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">Khoảng thời gian</p>
                            <p class="text-sm font-black text-slate-900 mt-1">
                                <span x-text="result.plan.startDate"></span> • <span x-text="result.plan.days"></span> ngày
                            </p>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
                            <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">Tổng cần mua</p>
                            <p class="text-sm font-black text-green-700 mt-1">
                                <span x-text="fmtKg(totalBuyKg())"></span>
                            </p>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
                            <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">Số nguyên liệu</p>
                            <p class="text-sm font-black text-slate-900 mt-1">
                                <span x-text="(result.plan.ingredients || []).length"></span> mục
                            </p>
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-2xl overflow-hidden">
                        <div class="px-4 py-3 bg-white border-b border-slate-200 flex items-center justify-between">
                            <p class="text-xs font-black text-slate-700 uppercase tracking-wider">Tổng hợp theo ngày</p>
                            <p class="text-xs text-slate-400 font-bold">kg</p>
                        </div>
                        <div class="overflow-x-auto bg-white">
                            <table class="min-w-full text-sm">
                                <thead class="bg-slate-50 text-slate-600 text-xs">
                                    <tr>
                                        <th class="text-left px-4 py-2.5 font-black">Ngày</th>
                                        <th class="text-right px-4 py-2.5 font-black">Nhu cầu</th>
                                        <th class="text-right px-4 py-2.5 font-black">Cần mua</th>
                                        <th class="text-right px-4 py-2.5 font-black">Tồn cuối</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template x-for="d in (result.plan.summaryByDay || [])" :key="d.date">
                                        <tr class="border-t">
                                            <td class="px-4 py-2.5 font-bold text-slate-700" x-text="d.date"></td>
                                            <td class="px-4 py-2.5 text-right font-bold text-slate-700" x-text="fmtKg(d.totalDemandKg)"></td>
                                            <td class="px-4 py-2.5 text-right font-black text-green-700" x-text="fmtKg(d.totalBuyKg)"></td>
                                            <td class="px-4 py-2.5 text-right font-bold text-slate-700" x-text="fmtKg(d.totalEndInventoryKg)"></td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-2xl overflow-hidden">
                        <div class="px-4 py-3 bg-white border-b border-slate-200 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <p class="text-xs font-black text-slate-700 uppercase tracking-wider">Danh sách nguyên liệu</p>
                                <span class="text-[11px] font-black text-slate-400" x-text="'(' + (result.plan.ingredients || []).length + ')'"></span>
                            </div>
                            <div class="relative">
                                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="text" x-model="q" placeholder="Tìm nguyên liệu..."
                                       class="pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all">
                            </div>
                        </div>
                        <div class="overflow-x-auto bg-white">
                            <table class="min-w-full text-sm">
                                <thead class="bg-slate-50 text-slate-600 text-xs">
                                    <tr>
                                        <th class="text-left px-4 py-2.5 font-black">Nguyên liệu</th>
                                        <th class="text-right px-4 py-2.5 font-black">Tồn đầu</th>
                                        <th class="text-right px-4 py-2.5 font-black">Nhu cầu</th>
                                        <th class="text-right px-4 py-2.5 font-black">Cần mua</th>
                                        <th class="text-right px-4 py-2.5 font-black">Tồn cuối</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template x-for="it in filteredIngredients()" :key="it.ingredientName">
                                        <tr class="border-t hover:bg-slate-50/60 transition-colors">
                                            <td class="px-4 py-2.5">
                                                <p class="font-black text-slate-900" x-text="it.ingredientName"></p>
                                                <p class="text-xs text-slate-400 font-bold mt-0.5" x-text="(it.unit || 'kg')"></p>
                                            </td>
                                            <td class="px-4 py-2.5 text-right font-bold text-slate-700" x-text="fmtKg(it.startInventoryKg)"></td>
                                            <td class="px-4 py-2.5 text-right font-bold text-slate-700" x-text="fmtKg(it.totalDemandKg)"></td>
                                            <td class="px-4 py-2.5 text-right font-black text-green-700" x-text="fmtKg(it.totalBuyKg)"></td>
                                            <td class="px-4 py-2.5 text-right font-bold text-slate-700" x-text="fmtKg(it.endInventoryKg)"></td>
                                        </tr>
                                    </template>
                                    <tr x-show="filteredIngredients().length === 0" style="display:none">
                                        <td colspan="5" class="px-4 py-8 text-center text-sm text-slate-400 font-bold">Không có kết quả phù hợp</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('aiIngredientPrep', () => ({
        loading: false,
        error: '',
        q: '',
        form: {
            startDate: '@Model.StartDate.ToString("yyyy-MM-dd")',
            days: @Model.Days,
            contractId: null,
            dishValueIdOverride: null,
            leadTimeDays: @Model.LeadTimeDays,
            safetyStockKg: @Model.SafetyStockKg,
            maxInventoryKg: null,
            persistAsProposal: @(Model.PersistAsProposal ? "true" : "false"),
            proposalHeaderNote: ''
        },
        result: null,

        init() {
            lucide.createIcons();
            this.$nextTick(() => lucide.createIcons());
        },

        csrf() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; },

        normalizeNumber(v) {
            if (v === '' || v === null || v === undefined) return null;
            const n = Number(v);
            return isNaN(n) ? null : n;
        },

        payload() {
            return {
                startDate: this.form.startDate,
                days: this.normalizeNumber(this.form.days) ?? 7,
                contractId: this.normalizeNumber(this.form.contractId),
                dishValueIdOverride: this.normalizeNumber(this.form.dishValueIdOverride),
                leadTimeDays: this.normalizeNumber(this.form.leadTimeDays) ?? 0,
                safetyStockKg: this.normalizeNumber(this.form.safetyStockKg) ?? 0,
                maxInventoryKg: this.normalizeNumber(this.form.maxInventoryKg),
                persistAsProposal: !!this.form.persistAsProposal,
                proposalHeaderNote: (this.form.proposalHeaderNote || '').trim() || null
            };
        },

        normalizeResult(raw) {
            if (!raw) return raw;
            const r = raw;
            const planRaw = r.plan || r.Plan || null;
            if (!planRaw) return r;

            const plan = {
                startDate: planRaw.startDate ?? planRaw.start_date ?? '',
                days: planRaw.days ?? 0,
                summaryByDay: (planRaw.summaryByDay ?? planRaw.summary_by_day ?? []).map(d => ({
                    date: d.date ?? '',
                    totalDemandKg: d.totalDemandKg ?? d.total_demand_kg ?? 0,
                    totalBuyKg: d.totalBuyKg ?? d.total_buy_kg ?? 0,
                    totalEndInventoryKg: d.totalEndInventoryKg ?? d.total_end_inventory_kg ?? 0
                })),
                ingredients: (planRaw.ingredients ?? []).map(it => ({
                    ingredientName: it.ingredientName ?? it.ingredient_name ?? '',
                    unit: it.unit ?? 'kg',
                    totalDemandKg: it.totalDemandKg ?? it.total_demand_kg ?? 0,
                    totalBuyKg: it.totalBuyKg ?? it.total_buy_kg ?? 0,
                    startInventoryKg: it.startInventoryKg ?? it.start_inventory_kg ?? 0,
                    endInventoryKg: it.endInventoryKg ?? it.end_inventory_kg ?? 0,
                    daily: (it.daily ?? []).map(x => ({
                        date: x.date ?? '',
                        demandKg: x.demandKg ?? x.demand_kg ?? 0,
                        buyKg: x.buyKg ?? x.buy_kg ?? 0,
                        endInventoryKg: x.endInventoryKg ?? x.end_inventory_kg ?? 0
                    }))
                }))
            };

            return { ...r, plan };
        },

        fmtKg(n) {
            const x = Number(n || 0);
            return new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 2 }).format(x);
        },

        totalBuyKg() {
            const rows = (this.result?.plan?.ingredients || []);
            return rows.reduce((s, r) => s + Number(r.totalBuyKg || 0), 0);
        },

        filteredIngredients() {
            const rows = (this.result?.plan?.ingredients || []);
            const q = (this.q || '').trim().toLowerCase();
            if (!q) return rows;
            return rows.filter(r => (r.ingredientName || '').toLowerCase().includes(q));
        },

        async run() {
            this.error = '';
            this.result = null;
            this.loading = true;
            try {
                const res = await fetch('@Url.Action("AiGenerateRun", "Import", new { area = "Manager" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': this.csrf()
                    },
                    body: JSON.stringify(this.payload())
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || 'Thất bại');

                // data is already unwrapped (BackendWarehouseClient returns Data only)
                this.result = this.normalizeResult(data);
                this.$nextTick(() => lucide.createIcons());
            } catch (e) {
                this.error = e.message;
            } finally {
                this.loading = false;
            }
        }
    }));
});
</script>
}

