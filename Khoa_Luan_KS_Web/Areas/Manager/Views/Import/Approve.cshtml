@{
    ViewData["Title"] = "Duyệt Phiếu Nhập Hàng";
    Layout = "_LayoutManager";
}

<div class="bg-white rounded-xl shadow overflow-hidden">
    <!-- Header -->
    <div class="px-4 md:px-6 pt-4 md:pt-6 pb-3 md:pb-4 flex items-center gap-3">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-green-100">
            <i class="fas fa-boxes text-green-600"></i>
        </div>
        <h1 class="text-xl md:text-2xl font-semibold text-green-600">Quản lý nhập nguyên liệu</h1>
    </div>

    <!-- Tabs -->
    <div class="border-t border-b bg-gray-50 px-3 md:px-6 py-2 overflow-x-auto">
         <div class="flex items-center gap-2 md:gap-3 min-w-max">
            <a href="/Manager/ImportCreate" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Tạo đề xuất</a>
            <a href="/Manager/ImportList" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Danh sách</a>
            <a href="/Manager/ImportApprove" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap bg-green-100 text-green-700 shadow-sm">Duyệt phiếu</a>
            <a href="/Manager/ImportReceipt" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Nhập kho</a>
            <a href="/Manager/ImportHistory" class="px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap text-gray-600 hover:bg-gray-100">Lịch sử</a>
        </div>
    </div>

    <!-- Content -->
    <div class="p-4 md:p-6 space-y-4">
        <div class="border border-yellow-300 bg-yellow-50 rounded-xl p-6 flex justify-between items-center transition">
            <div>
                <h3 class="font-bold text-lg text-yellow-800">Cần Duyệt: IM-2604-01</h3>
                <p class="text-sm text-gray-600 mt-1">Người tạo: Staff01 | Lý do: Gia vị bổ sung Kho 2</p>
                <div class="mt-2 text-xs bg-white p-2 border rounded inline-block">Nước mắm Nam Ngư (20 chai), Dầu ăn (5 can)</div>
            </div>
            <div class="flex gap-2">
                 <button class="bg-green-600 text-white px-4 py-2 rounded font-bold hover:bg-green-700"><i class="fas fa-check mr-2"></i>Duyệt</button>
                 <button class="bg-red-500 text-white px-4 py-2 rounded font-bold hover:bg-red-600"><i class="fas fa-times mr-2"></i>Từ chối</button>
            </div>
        </div>
    </div>
</div>
