@{
    ViewData["Title"] = "Quản lý Nhập hàng";
    Layout = "_LayoutManager";
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="importManager()">
    
    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Yêu cầu Nhập hàng</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Quản lý và duyệt các phiếu yêu cầu mua sắm nguyên vật liệu từ Bếp.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <button @@click="openCreateModal()" class="px-5 py-2 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-600/30 hover:bg-blue-700 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Tạo Yêu Cầu Nhập
            </button>
        </div>
    </div>

    <!-- TABS -->
    <div class="flex gap-4 border-b border-slate-200">
        <button class="px-4 py-3 font-bold text-sm transition-colors relative" 
                :class="activeTab === 'pending' ? 'text-blue-600' : 'text-slate-500 hover:text-slate-700'" 
                @@click="activeTab = 'pending'">
            Chờ duyệt
            <span x-show="pendingCount > 0" class="ml-1 bg-red-500 text-white text-[10px] px-1.5 py-0.5 rounded-full" x-text="pendingCount"></span>
            <div x-show="activeTab === 'pending'" class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-600"></div>
        </button>
        <button class="px-4 py-3 font-bold text-sm transition-colors relative" 
                :class="activeTab === 'approved' ? 'text-blue-600' : 'text-slate-500 hover:text-slate-700'" 
                @@click="activeTab = 'approved'">
            Đã duyệt (Chờ hàng về)
            <div x-show="activeTab === 'approved'" class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-600"></div>
        </button>
        <button class="px-4 py-3 font-bold text-sm transition-colors relative" 
                :class="activeTab === 'history' ? 'text-blue-600' : 'text-slate-500 hover:text-slate-700'" 
                @@click="activeTab = 'history'">
            Lịch sử nhập kho
            <div x-show="activeTab === 'history'" class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-600"></div>
        </button>
    </div>

    <!-- LIST OF REQUESTS -->
    <div class="space-y-4">
        <template x-for="req in filteredRequests" :key="req.id">
            <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 p-6 flex flex-col md:flex-row gap-6 relative overflow-hidden group hover:shadow-md transition-shadow">
                
                <div class="absolute left-0 top-0 bottom-0 w-1.5" :class="getStatusColor(req.status)"></div>

                <!-- Info -->
                <div class="md:w-2/3 border-b md:border-b-0 md:border-r border-slate-100 pb-4 md:pb-0 pr-6">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-lg border bg-slate-50 text-slate-600" x-text="req.code"></span>
                        <h3 class="text-lg font-black text-slate-800" x-text="req.title"></h3>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Người yêu cầu</p>
                            <p class="text-sm font-bold text-slate-700 flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                <span x-text="req.creator"></span>
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Ngày cần hàng</p>
                            <p class="text-sm font-bold text-slate-700 flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <span x-text="req.targetDate"></span>
                            </p>
                        </div>
                    </div>
                    
                    <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                        <p class="text-xs font-bold text-slate-500 mb-2">Chi tiết nguyên liệu yêu cầu:</p>
                        <p class="text-sm font-medium text-slate-700 leading-relaxed" x-text="req.items"></p>
                    </div>
                </div>
                
                <!-- Action / Status -->
                <div class="md:w-1/3 flex flex-col justify-center items-center md:items-end">
                    <template x-if="req.status === 'pending'">
                        <div class="w-full flex flex-col gap-2">
                            <button class="w-full py-2.5 bg-green-50 text-green-700 font-bold rounded-xl border border-green-200 hover:bg-green-100 transition-colors text-sm flex justify-center items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Duyệt phiếu nhập
                            </button>
                            <button class="w-full py-2.5 bg-white text-red-600 font-bold rounded-xl border border-red-200 hover:bg-red-50 transition-colors text-sm flex justify-center items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                Từ chối
                            </button>
                        </div>
                    </template>
                    <template x-if="req.status === 'approved'">
                        <div class="text-center md:text-right">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider rounded-lg border border-blue-200 mb-3">
                                <i class="fas fa-truck-loading"></i> Đang chờ NCC giao hàng
                            </span>
                            <button class="w-full py-2 bg-slate-800 text-white font-bold rounded-xl hover:bg-slate-900 transition-colors text-sm">Ghi nhận Hàng đã về kho</button>
                        </div>
                    </template>
                    <template x-if="req.status === 'completed'">
                        <div class="text-center md:text-right">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-50 text-green-700 text-xs font-bold uppercase tracking-wider rounded-lg border border-green-200">
                                <i class="fas fa-check-circle"></i> Đã nhập kho hoàn tất
                            </span>
                            <p class="text-xs text-slate-400 mt-2">Nhập lúc: 25/04 14:30</p>
                            <button class="mt-3 text-xs font-bold text-blue-600 hover:underline">Xem Biên bản nhập</button>
                        </div>
                    </template>
                </div>
            </div>
        </template>
        
        <div x-show="filteredRequests.length === 0" class="text-center py-12 bg-white rounded-[24px] border border-slate-100 border-dashed">
            <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <h3 class="mt-2 text-sm font-bold text-slate-800">Không có dữ liệu</h3>
            <p class="text-xs text-slate-500 mt-1">Không tìm thấy phiếu yêu cầu nào trong mục này.</p>
        </div>
    </div>

    <!-- MODAL: TẠO PHIẾU YÊU CẦU NHẬP (CRUD) -->
    <div x-show="isCreateModalOpen" style="display: none;" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="isCreateModalOpen" 
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" 
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="closeCreateModal()"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="isCreateModalOpen" 
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-xl" @@click.stop>
                    
                    <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h3 class="text-xl font-black text-slate-800">Tạo Phiếu Yêu cầu Nhập hàng</h3>
                        <button @@click="closeCreateModal()" class="text-slate-400 hover:text-slate-600 bg-slate-200/50 hover:bg-slate-200 p-1.5 rounded-full transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    
                    <div class="p-6 space-y-5">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Tiêu đề phiếu</label>
                            <input type="text" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-blue-500 focus:ring-1 focus:ring-blue-500 shadow-sm" placeholder="VD: Yêu cầu nhập thịt tươi phục vụ tuần 19" />
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-2">Người yêu cầu</label>
                                <input type="text" value="Nguyễn Bếp Trưởng" readonly class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold bg-slate-50 text-slate-600" />
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-2">Ngày cần hàng (Target Date)</label>
                                <input type="date" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-blue-500 bg-white shadow-sm" />
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Chi tiết danh sách hàng hóa</label>
                            <textarea rows="4" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-blue-500 shadow-sm" placeholder="- Thịt gà CN: 120kg&#10;- Rau muống: 50 bó..."></textarea>
                            <p class="text-xs text-slate-400 mt-2 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Hoặc đính kèm file Excel danh sách bên dưới
                            </p>
                        </div>
                        
                        <div class="border-2 border-dashed border-slate-300 rounded-xl p-4 text-center hover:border-blue-500 hover:bg-blue-50 transition-colors cursor-pointer">
                            <svg class="mx-auto h-8 w-8 text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                            <span class="text-sm font-bold text-slate-700">Kéo thả file Excel hoặc click để tải lên</span>
                        </div>
                    </div>
                    
                    <div class="px-6 py-5 bg-slate-50 border-t border-slate-100 flex justify-end gap-3 rounded-b-[32px]">
                        <button @@click="closeCreateModal()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-white border border-slate-200 transition-colors text-sm">Hủy</button>
                        <button @@click="submitRequest()" class="px-6 py-2.5 rounded-xl bg-blue-600 text-white font-bold hover:bg-blue-700 transition-colors text-sm shadow-lg shadow-blue-600/30 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                            Tạo và Gửi yêu cầu
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('importManager', () => ({
                activeTab: 'pending',
                isCreateModalOpen: false,
                
                requests: [
                    { id: 1, code: 'PO-2026-001', title: 'Yêu cầu Nhập thịt tươi Tuần 18', creator: 'Nguyễn Bếp Trưởng', targetDate: '27/04/2026', items: 'Gà CN (120kg), Heo (50kg), Bò (20kg)', status: 'pending' },
                    { id: 2, code: 'PO-2026-002', title: 'Nhập gia vị kho tổng', creator: 'Lê Văn Kho', targetDate: '28/04/2026', items: 'Nước mắm, Hạt nêm, Dầu ăn...', status: 'pending' },
                    { id: 3, code: 'PO-2026-003', title: 'Yêu cầu Nhập rau củ quả Đà Lạt', creator: 'Nguyễn Bếp Trưởng', targetDate: '26/04/2026', items: 'Cà chua (50kg), Cải thảo (30kg)', status: 'approved' },
                    { id: 4, code: 'PO-2026-004', title: 'Nhập gạo dự trữ tháng 5', creator: 'Lê Văn Kho', targetDate: '20/04/2026', items: 'Gạo ST25 (500kg)', status: 'completed' }
                ],
                
                get filteredRequests() {
                    return this.requests.filter(req => req.status === this.activeTab);
                },
                
                get pendingCount() {
                    return this.requests.filter(req => req.status === 'pending').length;
                },
                
                getStatusColor(status) {
                    if (status === 'pending') return 'bg-yellow-400';
                    if (status === 'approved') return 'bg-blue-500';
                    return 'bg-green-500';
                },
                
                openCreateModal() {
                    this.isCreateModalOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                
                closeCreateModal() {
                    this.isCreateModalOpen = false;
                    document.body.style.overflow = '';
                },
                
                submitRequest() {
                    alert('Đã gửi yêu cầu nhập hàng lên Bộ phận quản lý!');
                    this.closeCreateModal();
                }
            }));
        });
    </script>
}
