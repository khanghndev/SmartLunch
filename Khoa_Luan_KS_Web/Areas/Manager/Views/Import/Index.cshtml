@{
    ViewData["Title"] = "Quản lý Nhập hàng";
    Layout = "_LayoutManager";
    var ingredients = ViewBag.Ingredients as List<Khoa_Luan_KS_Web.Services.IngredientClientDto> ?? new();
}
@Html.AntiForgeryToken()

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="importManager()">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Yêu cầu Nhập hàng</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Duyệt phiếu đề xuất NVL từ kho/bếp, theo dõi hàng về và nhập kho thực tế.</p>
        </div>
        <button type="button" @@click="openCreateModal()" class="px-5 py-2 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-600/30 hover:bg-blue-700 transition-all flex items-center gap-2 text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Tạo đề xuất nhập
        </button>
    </div>

    <div x-show="loadError" class="text-sm text-red-700 bg-red-50 border border-red-100 rounded-xl px-4 py-3" x-text="loadError"></div>
    <div x-show="successMsg" class="text-sm text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-xl px-4 py-3" x-text="successMsg"></div>

    <div class="flex gap-4 border-b border-slate-200">
        <button type="button" class="px-4 py-3 font-bold text-sm transition-colors relative"
                :class="activeTab === 'pending' ? 'text-blue-600' : 'text-slate-500 hover:text-slate-700'"
                @@click="activeTab = 'pending'">
            Chờ duyệt
            <span x-show="pendingCount > 0" class="ml-1 bg-red-500 text-white text-[10px] px-1.5 py-0.5 rounded-full" x-text="pendingCount"></span>
            <div x-show="activeTab === 'pending'" class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-600"></div>
        </button>
        <button type="button" class="px-4 py-3 font-bold text-sm transition-colors relative"
                :class="activeTab === 'approved' ? 'text-blue-600' : 'text-slate-500 hover:text-slate-700'"
                @@click="activeTab = 'approved'">
            Đã duyệt (chờ hàng về)
            <div x-show="activeTab === 'approved'" class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-600"></div>
        </button>
        <button type="button" class="px-4 py-3 font-bold text-sm transition-colors relative"
                :class="activeTab === 'history' ? 'text-blue-600' : 'text-slate-500 hover:text-slate-700'"
                @@click="activeTab = 'history'">
            Lịch sử nhập kho
            <div x-show="activeTab === 'history'" class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-600"></div>
        </button>
    </div>

    <div x-show="loading" class="text-center py-16 text-slate-400 font-medium">Đang tải phiếu đề xuất...</div>

    <div class="space-y-4" x-show="!loading">
        <template x-for="req in filteredRequests" :key="req.id">
            <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 p-6 flex flex-col md:flex-row gap-6 relative overflow-hidden hover:shadow-md transition-shadow">
                <div class="absolute left-0 top-0 bottom-0 w-1.5" :class="tabColor(req)"></div>
                <div class="md:w-2/3 border-b md:border-b-0 md:border-r border-slate-100 pb-4 md:pb-0 pr-6">
                    <div class="flex items-center gap-2 mb-3 flex-wrap">
                        <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-lg border bg-slate-50 text-slate-600" x-text="req.proposalCode"></span>
                        <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded" :class="statusBadge(req)" x-text="statusLabel(req)"></span>
                    </div>
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <p class="text-xs text-slate-500 font-bold uppercase mb-1">Người yêu cầu</p>
                            <p class="text-sm font-bold text-slate-700" x-text="req.createdByDisplayName || ('User #' + req.createdByUserId)"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 font-bold uppercase mb-1">Ngày tạo</p>
                            <p class="text-sm font-bold text-slate-700" x-text="formatDate(req.createdAt)"></p>
                        </div>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                        <p class="text-xs font-bold text-slate-500 mb-2">Ghi chú / Chi tiết:</p>
                        <p class="text-sm font-medium text-slate-700 leading-relaxed" x-text="req.headerNote || '—'"></p>
                        <p class="text-xs text-blue-600 mt-2 cursor-pointer hover:underline" @@click="loadDetail(req.id)" x-text="req._linesPreview || 'Nhấn để xem danh sách nguyên liệu'"></p>
                    </div>
                </div>
                <div class="md:w-1/3 flex flex-col justify-center items-stretch md:items-end gap-2">
                    <template x-if="req.status === 'submitted'">
                        <div class="w-full flex flex-col gap-2">
                            <button type="button" @@click="openReview(req, true)" class="w-full py-2.5 bg-green-50 text-green-700 font-bold rounded-xl border border-green-200 hover:bg-green-100 text-sm">Duyệt phiếu</button>
                            <button type="button" @@click="openReview(req, false)" class="w-full py-2.5 bg-white text-red-600 font-bold rounded-xl border border-red-200 hover:bg-red-50 text-sm">Từ chối</button>
                        </div>
                    </template>
                    <template x-if="req.status === 'approved' && !req.hasActualReceipt">
                        <button type="button" @@click="confirmReceipt(req)" :disabled="acting" class="w-full py-2.5 bg-slate-800 text-white font-bold rounded-xl hover:bg-slate-900 text-sm disabled:opacity-50">Ghi nhận hàng đã về kho</button>
                    </template>
                    <template x-if="req.status === 'fulfilled' || req.hasActualReceipt">
                        <span class="inline-flex justify-center px-3 py-1.5 bg-green-50 text-green-700 text-xs font-bold uppercase rounded-lg border border-green-200">Đã nhập kho</span>
                    </template>
                    <template x-if="req.status === 'rejected'">
                        <span class="inline-flex justify-center px-3 py-1.5 bg-red-50 text-red-700 text-xs font-bold uppercase rounded-lg border border-red-200">Đã từ chối</span>
                    </template>
                </div>
            </div>
        </template>
        <div x-show="filteredRequests.length === 0" class="text-center py-12 bg-white rounded-[24px] border border-dashed border-slate-200">
            <h3 class="text-sm font-bold text-slate-800">Không có phiếu trong mục này</h3>
        </div>
    </div>

    <!-- Modal duyệt / từ chối -->
    <div x-show="reviewModal.open" style="display:none;" class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="reviewModal.open = false"></div>
        <div class="relative bg-white rounded-[28px] shadow-2xl w-full max-w-md p-6" @@click.stop>
            <h3 class="text-lg font-black text-slate-800 mb-2" x-text="reviewModal.approve ? 'Duyệt phiếu nhập' : 'Từ chối phiếu'"></h3>
            <p class="text-sm text-slate-500 mb-4" x-text="reviewModal.proposal?.proposalCode"></p>
            <textarea x-model="reviewModal.note" rows="3" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm mb-4" placeholder="Ghi chú duyệt (tùy chọn)"></textarea>
            <div class="flex justify-end gap-2">
                <button type="button" @@click="reviewModal.open = false" class="px-4 py-2 rounded-xl border font-bold text-sm">Hủy</button>
                <button type="button" @@click="submitReview()" :disabled="acting" class="px-5 py-2 rounded-xl text-white font-bold text-sm disabled:opacity-50" :class="reviewModal.approve ? 'bg-green-600' : 'bg-red-600'" x-text="acting ? 'Đang xử lý...' : 'Xác nhận'"></button>
            </div>
        </div>
    </div>

    <!-- Modal tạo phiếu -->
    <div x-show="isCreateModalOpen" style="display:none;" class="fixed inset-0 z-50 overflow-y-auto p-4">
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="closeCreateModal()"></div>
        <div class="relative max-w-2xl mx-auto bg-white rounded-[32px] shadow-2xl my-8" @@click.stop>
            <div class="px-6 py-5 border-b flex justify-between items-center">
                <h3 class="text-xl font-black text-slate-800">Tạo phiếu đề xuất nhập</h3>
                <button type="button" @@click="closeCreateModal()" class="text-slate-400 hover:text-slate-600">✕</button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">Ghi chú phiếu</label>
                    <textarea x-model="createForm.headerNote" rows="2" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" placeholder="Lý do / mô tả chung"></textarea>
                </div>
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <label class="text-sm font-bold text-slate-700">Danh sách nguyên liệu</label>
                        <button type="button" @@click="addLine()" class="text-xs font-bold text-blue-600">+ Thêm dòng</button>
                    </div>
                    <template x-for="(line, idx) in createForm.lines" :key="line._key">
                        <div class="grid grid-cols-12 gap-2 items-end bg-slate-50 p-3 rounded-xl border border-slate-100">
                            <div class="col-span-5">
                                <select x-model="line.ingredientId" @@change="onIngredientPick(line)" class="w-full rounded-lg border border-slate-200 text-sm px-2 py-2">
                                    <option value="0">-- Chọn NVL --</option>
                                    @foreach (var ing in ingredients)
                                    {
                                        <option value="@ing.Id">@ing.Name (@ing.Unit)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-span-3">
                                <input type="number" min="0.01" step="0.01" x-model="line.quantity" placeholder="SL" class="w-full rounded-lg border border-slate-200 text-sm px-2 py-2" />
                            </div>
                            <div class="col-span-3">
                                <input type="text" x-model="line.lineNote" placeholder="Ghi chú" class="w-full rounded-lg border border-slate-200 text-sm px-2 py-2" />
                            </div>
                            <div class="col-span-1">
                                <button type="button" @@click="removeLine(idx)" class="text-red-500 text-sm font-bold">×</button>
                            </div>
                        </div>
                    </template>
                </div>
                <p x-show="createError" class="text-sm text-red-600" x-text="createError"></p>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t flex justify-end gap-3 rounded-b-[32px]">
                <button type="button" @@click="closeCreateModal()" class="px-4 py-2 rounded-xl border font-bold text-sm">Hủy</button>
                <button type="button" @@click="submitCreate()" :disabled="acting" class="px-6 py-2 rounded-xl bg-blue-600 text-white font-bold text-sm disabled:opacity-50">Gửi duyệt</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('importManager', () => ({
        activeTab: 'pending',
        loading: true,
        acting: false,
        loadError: '',
        successMsg: '',
        proposals: [],
        isCreateModalOpen: false,
        createError: '',
        createForm: { headerNote: '', lines: [{ _key: 1, ingredientId: '0', quantity: '', lineNote: '' }] },
        lineKey: 2,
        reviewModal: { open: false, approve: true, proposal: null, note: '' },
        ingredients: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ingredients.Select(i => new { id = i.Id, name = i.Name, unit = i.Unit }))),

        init() { this.load(); },

        csrf() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; },

        async load() {
            this.loading = true;
            this.loadError = '';
            try {
                const res = await fetch('@Url.Action("Proposals", "Import", new { area = "Manager" })?pageSize=200');
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || 'Không tải được danh sách');
                this.proposals = (data.data || []).map(p => ({ ...p, _linesPreview: null }));
            } catch (e) {
                this.loadError = e.message;
            } finally {
                this.loading = false;
            }
        },

        get filteredRequests() {
            if (this.activeTab === 'pending') return this.proposals.filter(p => p.status === 'submitted');
            if (this.activeTab === 'approved') return this.proposals.filter(p => p.status === 'approved' && !p.hasActualReceipt);
            return this.proposals.filter(p => p.status === 'fulfilled' || p.hasActualReceipt || p.status === 'rejected');
        },

        get pendingCount() { return this.proposals.filter(p => p.status === 'submitted').length; },

        formatDate(iso) {
            const d = new Date(iso);
            return isNaN(d) ? '' : d.toLocaleString('vi-VN');
        },

        statusLabel(p) {
            if (p.status === 'submitted') return 'Chờ duyệt';
            if (p.status === 'approved') return 'Đã duyệt';
            if (p.status === 'rejected') return 'Từ chối';
            if (p.status === 'fulfilled') return 'Đã nhập kho';
            return p.status;
        },

        statusBadge(p) {
            if (p.status === 'submitted') return 'bg-amber-50 text-amber-700 border border-amber-200';
            if (p.status === 'approved') return 'bg-blue-50 text-blue-700 border border-blue-200';
            if (p.status === 'rejected') return 'bg-red-50 text-red-700 border border-red-200';
            return 'bg-green-50 text-green-700 border border-green-200';
        },

        tabColor(p) {
            if (p.status === 'submitted') return 'bg-yellow-400';
            if (p.status === 'approved' && !p.hasActualReceipt) return 'bg-blue-500';
            return 'bg-green-500';
        },

        async loadDetail(id) {
            try {
                const res = await fetch('@Url.Action("ProposalDetail", "Import", new { area = "Manager" })?id=' + id);
                const d = await res.json();
                if (!res.ok) throw new Error(d.message);
                const text = (d.lines || []).map(l => `${l.ingredientName}: ${l.quantity} ${l.unit}`).join(' · ');
                const p = this.proposals.find(x => x.id === id);
                if (p) p._linesPreview = text || 'Không có dòng';
            } catch (e) {
                alert(e.message);
            }
        },

        openReview(proposal, approve) {
            this.reviewModal = { open: true, approve, proposal, note: '' };
            document.body.style.overflow = 'hidden';
        },

        async submitReview() {
            if (!this.reviewModal.proposal) return;
            this.acting = true;
            try {
                const res = await fetch('@Url.Action("ReviewProposal", "Import", new { area = "Manager" })?id=' + this.reviewModal.proposal.id, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.csrf() },
                    body: JSON.stringify({ approve: this.reviewModal.approve, reviewNote: this.reviewModal.note })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || 'Thất bại');
                this.reviewModal.open = false;
                document.body.style.overflow = '';
                this.successMsg = this.reviewModal.approve ? 'Đã duyệt phiếu.' : 'Đã từ chối phiếu.';
                await this.load();
                setTimeout(() => this.successMsg = '', 4000);
            } catch (e) {
                alert(e.message);
            } finally {
                this.acting = false;
            }
        },

        async confirmReceipt(req) {
            if (!confirm('Xác nhận nguyên liệu đã về kho và cập nhật tồn?')) return;
            this.acting = true;
            try {
                const res = await fetch('@Url.Action("ConfirmReceipt", "Import", new { area = "Manager" })?id=' + req.id, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.csrf() },
                    body: JSON.stringify({ note: 'Nhập kho từ quản lý' })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || 'Thất bại');
                this.successMsg = 'Đã nhập kho. Mã phiếu: ' + (data.receipt?.receiptCode || '');
                await this.load();
                setTimeout(() => this.successMsg = '', 5000);
            } catch (e) {
                alert(e.message);
            } finally {
                this.acting = false;
            }
        },

        openCreateModal() {
            this.createForm = { headerNote: '', lines: [{ _key: 1, ingredientId: '0', quantity: '', lineNote: '' }] };
            this.lineKey = 2;
            this.createError = '';
            this.isCreateModalOpen = true;
            document.body.style.overflow = 'hidden';
        },

        closeCreateModal() {
            this.isCreateModalOpen = false;
            document.body.style.overflow = '';
        },

        addLine() {
            this.createForm.lines.push({ _key: this.lineKey++, ingredientId: '0', quantity: '', lineNote: '' });
        },

        removeLine(idx) {
            if (this.createForm.lines.length > 1) this.createForm.lines.splice(idx, 1);
        },

        onIngredientPick(line) { /* unit shown in option text */ },

        async submitCreate() {
            const lines = this.createForm.lines
                .filter(l => parseInt(l.ingredientId, 10) > 0 && parseFloat(l.quantity) > 0)
                .map(l => ({ ingredientId: parseInt(l.ingredientId, 10), quantity: parseFloat(l.quantity), lineNote: l.lineNote || null }));
            if (lines.length === 0) { this.createError = 'Thêm ít nhất một dòng nguyên liệu hợp lệ'; return; }
            this.acting = true;
            this.createError = '';
            try {
                const res = await fetch('@Url.Action("CreateProposal", "Import", new { area = "Manager" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.csrf() },
                    body: JSON.stringify({ headerNote: this.createForm.headerNote, lines })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || 'Tạo thất bại');
                this.closeCreateModal();
                this.successMsg = 'Đã tạo phiếu đề xuất.';
                await this.load();
            } catch (e) {
                this.createError = e.message;
            } finally {
                this.acting = false;
            }
        }
    }));
});
</script>
}
