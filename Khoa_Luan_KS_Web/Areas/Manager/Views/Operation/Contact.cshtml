@{
    ViewData["Title"] = "Liên hệ website";
    Layout = "_LayoutManager";
}

@Html.AntiForgeryToken()
<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="contactInquiryManager()">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Liên hệ từ Website</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Yêu cầu gửi từ trang Liên hệ — xem thông tin và ghi nhận phản hồi nội bộ (gọi/email khách ngoài hệ thống).</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 px-5 py-3 flex items-center gap-3">
                <span class="text-xs font-bold text-slate-400 uppercase">Chờ xử lý</span>
                <span class="text-2xl font-black text-orange-600" x-text="pendingCount">0</span>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-4 flex flex-col sm:flex-row gap-3">
        <input type="search" x-model="searchTerm" @@keydown.enter="load()"
               placeholder="Tìm tên, SĐT, email, mã CIQ..."
               class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-1 focus:ring-blue-500" />
        <div class="flex flex-wrap gap-2">
            <button type="button" class="px-4 py-2 rounded-xl text-sm font-bold border transition-colors"
                    :class="statusFilter === '' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-600 border-slate-200'"
                    @@click="statusFilter = ''; load()">Tất cả</button>
            <button type="button" class="px-4 py-2 rounded-xl text-sm font-bold border transition-colors"
                    :class="statusFilter === 'pending' ? 'bg-orange-500 text-white border-orange-500' : 'bg-white text-slate-600 border-slate-200'"
                    @@click="statusFilter = 'pending'; load()">Chờ xử lý</button>
            <button type="button" class="px-4 py-2 rounded-xl text-sm font-bold border transition-colors"
                    :class="statusFilter === 'replied' ? 'bg-green-600 text-white border-green-600' : 'bg-white text-slate-600 border-slate-200'"
                    @@click="statusFilter = 'replied'; load()">Đã trả lời</button>
            <button type="button" @@click="load()" class="px-4 py-2 bg-slate-800 text-white rounded-xl text-sm font-bold">Tìm</button>
        </div>
    </div>

    <div x-show="loadError" class="text-sm text-red-600 bg-red-50 border border-red-100 rounded-xl px-4 py-3" x-text="loadError"></div>
    <div x-show="loading" class="text-center py-12 text-slate-400 font-medium">Đang tải...</div>

    <template x-for="item in inquiries" :key="item.id">
        <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 p-6 flex flex-col lg:flex-row gap-6 relative overflow-hidden hover:shadow-md transition-shadow">
            <div x-show="!item.isReplied" class="absolute left-0 top-0 bottom-0 w-1.5 bg-orange-500"></div>

            <div class="lg:w-1/4 border-b lg:border-b-0 lg:border-r border-slate-100 pb-4 lg:pb-0 pr-0 lg:pr-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-orange-100 text-orange-600 font-black flex items-center justify-center text-lg uppercase"
                         x-text="(item.fullName||'?').charAt(0)"></div>
                    <div>
                        <h4 class="font-bold text-slate-800 text-sm" x-text="item.fullName"></h4>
                        <p class="text-[11px] font-bold text-slate-400" x-text="formatDate(item.createdAt)"></p>
                    </div>
                </div>
                <p class="text-xs font-mono font-bold text-slate-500 mb-2" x-text="item.code || ('#' + item.id)"></p>
                <div class="space-y-2 text-sm">
                    <a :href="'tel:' + item.phone" class="flex items-center gap-2 text-slate-700 font-bold hover:text-blue-600">
                        <i class="fas fa-phone text-orange-500 w-4"></i>
                        <span x-text="item.phone"></span>
                    </a>
                    <a :href="'mailto:' + item.email" class="flex items-center gap-2 text-slate-700 font-bold hover:text-blue-600 truncate">
                        <i class="fas fa-envelope text-blue-500 w-4"></i>
                        <span class="truncate" x-text="item.email"></span>
                    </a>
                </div>
                <span class="inline-block mt-3 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider"
                      :class="item.isReplied ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-orange-50 text-orange-700 border border-orange-200'"
                      x-text="item.isReplied ? 'Đã trả lời' : 'Chờ xử lý'"></span>
            </div>

            <div class="lg:w-2/4 flex flex-col justify-center">
                <p class="text-xs font-bold text-slate-400 uppercase mb-1">Dịch vụ quan tâm</p>
                <p class="text-base font-black text-slate-800 mb-3" x-text="item.interestedService"></p>
                <p class="text-sm font-medium text-slate-600 leading-relaxed whitespace-pre-wrap"
                   x-text="item.message || '(Không có nội dung chi tiết)'"></p>
                <div x-show="item.isReplied" class="mt-4 bg-blue-50 border border-blue-100 rounded-xl p-3">
                    <p class="text-xs font-bold text-blue-800 mb-1">Ghi chú phản hồi nội bộ</p>
                    <p class="text-sm font-medium text-blue-900/80 whitespace-pre-wrap" x-text="item.managerReply"></p>
                    <p class="text-[10px] text-blue-600/70 mt-1" x-show="item.repliedAt" x-text="'Lúc ' + formatDate(item.repliedAt)"></p>
                </div>
            </div>

            <div class="lg:w-1/4 flex flex-col justify-center items-stretch lg:items-end gap-2 border-t lg:border-t-0 border-slate-100 pt-4 lg:pt-0">
                <button @@click="openReplyModal(item)"
                        class="px-5 py-2.5 bg-blue-600 text-white font-bold rounded-xl shadow-md hover:bg-blue-700 transition-colors text-sm w-full">
                    <span x-text="item.isReplied ? 'Cập nhật ghi chú' : 'Ghi nhận đã liên hệ'"></span>
                </button>
            </div>
        </div>
    </template>

    <div x-show="!loading && inquiries.length === 0" class="text-center py-12 bg-white rounded-[24px] border border-dashed border-slate-200">
        <h3 class="text-sm font-bold text-slate-800">Chưa có yêu cầu liên hệ</h3>
        <p class="text-xs text-slate-500 mt-1">Khách gửi form tại trang Liên hệ sẽ hiển thị tại đây.</p>
    </div>

    <!-- Modal -->
    <div x-show="isReplyModalOpen" style="display: none;" class="relative z-50" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="closeModal()"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto flex min-h-full items-center justify-center p-4">
            <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-lg overflow-hidden" @@click.stop>
                <template x-if="currentItem">
                    <div>
                        <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                            <h3 class="text-xl font-black text-slate-800">Ghi nhận phản hồi</h3>
                            <button @@click="closeModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-full bg-slate-200/50">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                        <div class="p-6 space-y-4">
                            <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-sm">
                                <p class="font-bold text-slate-800" x-text="currentItem.fullName + ' · ' + currentItem.phone"></p>
                                <p class="text-slate-500 mt-1" x-text="currentItem.email"></p>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-2">Nội dung đã tư vấn / ghi chú nội bộ</label>
                                <textarea x-model="replyText" rows="5" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                                          placeholder="VD: Đã gọi lúc 14h, tư vấn gói suất ăn 500 suất/ngày, gửi báo giá qua email..."></textarea>
                                <p class="text-xs text-slate-400 mt-2">Lưu ý: Ghi chú chỉ lưu trong hệ thống; vui lòng gọi/email khách trực tiếp.</p>
                            </div>
                            <p x-show="replyError" class="text-sm text-red-600" x-text="replyError"></p>
                        </div>
                        <div class="px-6 py-5 bg-slate-50 border-t flex justify-end gap-3">
                            <button @@click="closeModal()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold border border-slate-200 text-sm">Hủy</button>
                            <button @@click="submitReply()" :disabled="replying" class="px-6 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-sm disabled:opacity-50">Lưu</button>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('contactInquiryManager', () => ({
                inquiries: [],
                pendingCount: 0,
                loading: true,
                loadError: '',
                searchTerm: '',
                statusFilter: '',
                isReplyModalOpen: false,
                currentItem: null,
                replyText: '',
                replyError: '',
                replying: false,
                init() { this.load(); },
                csrf() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; },
                async load() {
                    this.loading = true;
                    this.loadError = '';
                    try {
                        const params = new URLSearchParams();
                        if (this.searchTerm.trim()) params.set('searchTerm', this.searchTerm.trim());
                        if (this.statusFilter) params.set('status', this.statusFilter);
                        const q = params.toString() ? '?' + params.toString() : '';
                        const res = await fetch('@Url.Action("ContactList", "Operation", new { area = "Manager" })' + q);
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok) throw new Error(data.message || 'Không tải được');
                        this.inquiries = data.data || [];
                        this.pendingCount = data.pendingCount ?? 0;
                    } catch (e) {
                        this.loadError = e.message || 'Lỗi tải dữ liệu';
                    } finally {
                        this.loading = false;
                    }
                },
                formatDate(iso) {
                    if (!iso) return '';
                    const d = new Date(iso);
                    return isNaN(d) ? '' : d.toLocaleString('vi-VN');
                },
                openReplyModal(item) {
                    this.currentItem = item;
                    this.replyText = item.managerReply || '';
                    this.replyError = '';
                    this.isReplyModalOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                closeModal() {
                    this.isReplyModalOpen = false;
                    document.body.style.overflow = '';
                },
                async submitReply() {
                    if (!this.currentItem || !this.replyText.trim()) {
                        this.replyError = 'Vui lòng nhập nội dung';
                        return;
                    }
                    this.replying = true;
                    this.replyError = '';
                    try {
                        const res = await fetch('@Url.Action("ReplyContact", "Operation", new { area = "Manager" })?id=' + this.currentItem.id, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.csrf() },
                            body: JSON.stringify({ reply: this.replyText.trim() })
                        });
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok) throw new Error(data.message || 'Lưu thất bại');
                        this.closeModal();
                        await this.load();
                    } catch (e) {
                        this.replyError = e.message;
                    } finally {
                        this.replying = false;
                    }
                }
            }));
        });
    </script>
}
