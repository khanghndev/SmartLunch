@model Khoa_Luan_KS_Web.Services.GetManagerContractResponse
@using Khoa_Luan_KS_Web.Areas.Manager.Controllers
@{
    ViewData["Title"] = "Chi tiết Hợp đồng";
    Layout = "_LayoutManager";
    var c = Model.Contract;
    var uiStatus = ContractController.UiStatus(c);
    var party = !string.IsNullOrWhiteSpace(c.OrganizationName) ? c.OrganizationName : (c.PartnerLegalName ?? "—");
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans">
    <div class="flex items-center gap-4">
        <a asp-area="Manager" asp-controller="Contract" asp-action="Index"
           class="bg-white border border-slate-200 hover:bg-slate-50 px-4 py-2 rounded-xl text-slate-700 font-bold text-sm transition">
            ← Quay lại
        </a>
        <h1 class="text-2xl font-black text-slate-800">@(c.ContractNumber ?? ("Hợp đồng #" + c.Id))</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
                <div class="border-b border-slate-100 pb-4 mb-4">
                    <h2 class="text-xl font-bold text-slate-800">@(c.Description ?? "Hợp đồng cung cấp suất ăn")</h2>
                    <p class="text-slate-500 mt-1 text-sm">
                        Trạng thái: <span class="font-bold text-slate-800">@uiStatus</span>
                        @if (c.IsDigitallySigned)
                        {
                            <span class="ml-2 text-emerald-600 font-bold">· Đã ký số</span>
                        }
                    </p>
                </div>
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                    <div>
                        <dt class="text-slate-500 font-medium">Khách hàng / Đơn vị</dt>
                        <dd class="font-bold text-slate-800 mt-1">@party</dd>
                    </div>
                    <div>
                        <dt class="text-slate-500 font-medium">Đối tác cung cấp (NCC)</dt>
                        <dd class="font-bold text-slate-800 mt-1">@(c.PartnerLegalName ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-slate-500 font-medium">Loại hợp đồng</dt>
                        <dd class="font-bold text-slate-800 mt-1">@c.ContractType</dd>
                    </div>
                    <div>
                        <dt class="text-slate-500 font-medium">Lịch cung cấp</dt>
                        <dd class="font-bold text-slate-800 mt-1">@(c.SupplySchedule ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-slate-500 font-medium">Giá trị hợp đồng</dt>
                        <dd class="font-black text-slate-800 mt-1">@(c.TotalValue.HasValue ? c.TotalValue.Value.ToString("N0") + " đ" : "—")</dd>
                    </div>
                    <div>
                        <dt class="text-slate-500 font-medium">Đặt cọc</dt>
                        <dd class="font-bold text-slate-800 mt-1">@(c.DepositAmount.HasValue ? c.DepositAmount.Value.ToString("N0") + " đ" : "—")</dd>
                    </div>
                    @if (c.MealUnitPrice.HasValue)
                    {
                        <div>
                            <dt class="text-slate-500 font-medium">Đơn giá / suất</dt>
                            <dd class="font-bold text-slate-800 mt-1">@c.MealUnitPrice.Value.ToString("N0") đ</dd>
                        </div>
                    }
                    @if (c.SourceOrderId.HasValue)
                    {
                        <div>
                            <dt class="text-slate-500 font-medium">Đơn nguồn</dt>
                            <dd class="font-bold text-slate-800 mt-1">#@c.SourceOrderId</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
                <h3 class="font-bold text-slate-700 mb-4 border-b border-slate-100 pb-2">Thông tin thời hạn</h3>
                <ul class="space-y-3 text-sm">
                    <li>
                        <span class="text-slate-500 block">Bắt đầu</span>
                        <span class="font-bold text-slate-800">@c.StartDate.ToString("dd/MM/yyyy")</span>
                    </li>
                    <li>
                        <span class="text-slate-500 block">Kết thúc</span>
                        <span class="font-bold text-slate-800">@(c.EndDate?.ToString("dd/MM/yyyy") ?? "Không thời hạn")</span>
                    </li>
                    <li>
                        <span class="text-slate-500 block">Tạo lúc</span>
                        <span class="font-medium text-slate-700">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </li>
                </ul>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
                <h3 class="font-bold text-slate-700 mb-4 border-b border-slate-100 pb-2">Tài liệu</h3>
                @if (!string.IsNullOrWhiteSpace(c.ContractFileUrl))
                {
                    <a href="@c.ContractFileUrl" target="_blank" rel="noopener"
                       class="block w-full text-center bg-slate-800 text-white py-2.5 rounded-xl font-bold text-sm hover:bg-slate-900 transition">
                        Tải file hợp đồng (PDF)
                    </a>
                }
                else
                {
                    <p class="text-sm text-slate-500">Chưa có file đính kèm.</p>
                }
            </div>
        </div>
    </div>
</div>
