@model Khoa_Luan_KS_Web.Services.GetContractsClientResponse
@using Khoa_Luan_KS_Web.Areas.Manager.Controllers
@{
    ViewData["Title"] = "Quản lý Hợp Đồng";
    Layout = "_LayoutManager";

    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int pageSize = (int)(ViewData["PageSize"] ?? 12);
    string? searchTerm = ViewData["SearchTerm"] as string;
    string statusFilter = ViewData["StatusFilter"] as string ?? "all";
    int totalCount = Model?.TotalCount ?? 0;
    int totalPages = pageSize > 0 ? Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize)) : 1;
    var items = Model?.Items ?? new List<Khoa_Luan_KS_Web.Services.ContractListDto>();
    var partners = ViewBag.Partners as List<Khoa_Luan_KS_Web.Services.PartnerDto> ?? new();

    string PartyName(Khoa_Luan_KS_Web.Services.ContractListDto c) =>
        !string.IsNullOrWhiteSpace(c.OrganizationName) ? c.OrganizationName! : (c.PartnerLegalName ?? "—");

    string FormatMoney(decimal? v)
    {
        if (!v.HasValue || v.Value <= 0) return "—";
        return v.Value.ToString("N0") + " đ";
    }

    string BuildUrl(int page, string? filter = null)
    {
        var f = filter ?? statusFilter;
        var q = $"?page={page}&pageSize={pageSize}&statusFilter={Uri.EscapeDataString(f)}";
        if (!string.IsNullOrEmpty(searchTerm)) q += $"&searchTerm={Uri.EscapeDataString(searchTerm)}";
        return q;
    }

    string StatusColor(string ui) => ui switch {
        "Đang hiệu lực" => "bg-green-500",
        "Sắp hết hạn" => "bg-yellow-500",
        "Hết hạn" => "bg-orange-500",
        _ => "bg-slate-400"
    };

    string StatusBadge(string ui) => ui switch {
        "Đang hiệu lực" => "bg-green-50 text-green-700 border-green-200",
        "Sắp hết hạn" => "bg-yellow-50 text-yellow-700 border-yellow-200",
        "Hết hạn" => "bg-orange-50 text-orange-700 border-orange-200",
        _ => "bg-slate-50 text-slate-600 border-slate-200"
    };
}
@Html.AntiForgeryToken()

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="contractPage()">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Hợp Đồng Doanh Nghiệp (B2B)</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">
                Tổng <span class="font-bold text-slate-800">@totalCount</span> hợp đồng cung cấp suất ăn cho khách doanh nghiệp.
            </p>
        </div>
        <button type="button" @@click="isContractModalOpen = true; createError = ''; document.body.style.overflow = 'hidden'"
                class="px-5 py-2 bg-slate-800 text-white font-bold rounded-xl shadow-lg hover:bg-slate-900 transition-all flex items-center gap-2 text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Tạo hợp đồng mới
        </button>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="text-sm text-red-700 bg-red-50 border border-red-100 rounded-xl px-4 py-3">@TempData["Error"]</div>
    }

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex flex-col md:flex-row gap-4 justify-between">
        <form method="get" asp-area="Manager" asp-controller="Contract" asp-action="Index" class="flex flex-wrap items-center gap-3 flex-1">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <input type="hidden" name="statusFilter" value="@statusFilter" />
            <div class="relative flex-1 min-w-[200px] max-w-md">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" name="searchTerm" value="@searchTerm" placeholder="Mã HĐ, tên DN, mô tả..."
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-sm font-medium outline-none focus:border-slate-800 focus:ring-1 focus:ring-slate-800" />
            </div>
            <button type="submit" class="px-4 py-2.5 bg-slate-800 text-white text-sm font-bold rounded-xl hover:bg-slate-900">Tìm</button>
        </form>
        <div class="flex flex-wrap gap-2">
            @{
                var tabs = new[] {
                    new { Key = "all", Label = "Tất cả" },
                    new { Key = "active", Label = "Đang hiệu lực" },
                    new { Key = "expiring", Label = "Sắp hết hạn" },
                    new { Key = "expired", Label = "Hết hạn" },
                    new { Key = "cancelled", Label = "Đã thanh lý" },
                };
            }
            @foreach (var t in tabs)
            {
                <a href="@BuildUrl(1, t.Key)"
                   class="px-4 py-2 font-bold text-sm rounded-full transition-colors border @(statusFilter == t.Key ? "bg-slate-800 text-white border-slate-800" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                    @t.Label
                </a>
            }
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="text-center py-16 bg-white rounded-[24px] border border-dashed border-slate-200">
            <h3 class="text-sm font-bold text-slate-800">Không có hợp đồng B2B</h3>
            <p class="text-xs text-slate-500 mt-1">Thử đổi bộ lọc hoặc tạo hợp đồng mới.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var contract in items)
            {
                var uiStatus = ContractController.UiStatus(contract);
                var party = PartyName(contract);
                <div class="bg-white rounded-[24px] border border-slate-200 shadow-sm hover:shadow-lg hover:border-slate-300 transition-all group overflow-hidden flex flex-col">
                    <div class="h-2 w-full @StatusColor(uiStatus)"></div>
                    <div class="p-6 flex-1 flex flex-col">
                        <div class="flex items-start gap-3 mb-4">
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center font-black text-xl text-white @StatusColor(uiStatus)">
                                @(party.Length > 0 ? party[0] : '?')
                            </div>
                            <div class="min-w-0 flex-1">
                                <h3 class="font-black text-slate-800 leading-tight truncate">@(contract.ContractNumber ?? ("HĐ #" + contract.Id))</h3>
                                <p class="text-xs font-bold text-slate-500 mt-1 truncate">@(contract.Description ?? contract.ContractType)</p>
                            </div>
                        </div>
                        <p class="text-sm font-bold text-slate-700 mb-4 truncate" title="@party">@party</p>
                        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 mb-5 space-y-3 text-sm">
                            <div class="flex justify-between items-center">
                                <span class="text-slate-500 font-medium">Giá trị HĐ:</span>
                                <span class="font-black text-slate-800">@FormatMoney(contract.TotalValue)</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-slate-500 font-medium">Lịch cung cấp:</span>
                                <span class="font-bold text-slate-700 text-right max-w-[55%] truncate" title="@contract.SupplySchedule">@(contract.SupplySchedule ?? "—")</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-slate-500 font-medium">Hạn HĐ:</span>
                                <span class="font-bold @(uiStatus == "Sắp hết hạn" ? "text-yellow-600" : "text-slate-700")">
                                    @(contract.EndDate?.ToString("dd/MM/yyyy") ?? "Không thời hạn")
                                </span>
                            </div>
                        </div>
                        <div class="mt-auto flex items-center justify-between pt-4 border-t border-slate-100">
                            <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-lg border @StatusBadge(uiStatus)">@uiStatus</span>
                            <div class="flex gap-2">
                                @if (!string.IsNullOrWhiteSpace(contract.ContractFileUrl))
                                {
                                    <a href="@contract.ContractFileUrl" target="_blank" rel="noopener"
                                       class="w-8 h-8 rounded-full bg-slate-50 text-slate-400 hover:text-blue-600 hover:bg-blue-50 flex items-center justify-center transition-colors" title="Tải PDF">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                    </a>
                                }
                                <a href="/Manager/Contract/Detail/@contract.Id"
                                   class="w-8 h-8 rounded-full bg-slate-50 text-slate-400 hover:text-green-600 hover:bg-green-50 flex items-center justify-center transition-colors" title="Chi tiết">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-3">
                <p class="text-sm text-slate-500 font-medium">
                    Trang <span class="font-bold text-slate-700">@currentPage</span> / @totalPages
                </p>
                <div class="flex items-center gap-1.5 flex-wrap justify-center">
                    @if (currentPage > 1)
                    {
                        <a href="@BuildUrl(currentPage - 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">← Trước</a>
                    }
                    @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                    {
                        if (p == currentPage)
                        {
                            <span class="px-3 py-1.5 text-sm font-black text-white bg-slate-800 rounded-lg">@p</span>
                        }
                        else
                        {
                            <a href="@BuildUrl(p)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">@p</a>
                        }
                    }
                    @if (currentPage < totalPages)
                    {
                        <a href="@BuildUrl(currentPage + 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">Sau →</a>
                    }
                </div>
            </div>
        }
    }

    <!-- Modal tạo HĐ -->
    <div x-show="isContractModalOpen" style="display:none;" class="relative z-50">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="isContractModalOpen = false; document.body.style.overflow = ''"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-4">
            <div class="relative bg-white rounded-[32px] shadow-2xl w-full max-w-2xl" @@click.stop>
                <div class="px-6 py-5 border-b flex justify-between items-center">
                    <h3 class="text-xl font-black text-slate-800">Tạo hợp đồng dịch vụ</h3>
                    <button type="button" @@click="isContractModalOpen = false; document.body.style.overflow = ''" class="text-slate-400 hover:text-slate-600">✕</button>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Đối tác cung cấp (NCC) <span class="text-red-500">*</span></label>
                        <select x-model="createForm.partnerId" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium">
                            <option value="">-- Chọn NCC --</option>
                            @foreach (var p in partners)
                            {
                                <option value="@p.Id">@p.LegalName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Số hợp đồng</label>
                        <input type="text" x-model="createForm.contractNumber" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" placeholder="HD-B2B-..." />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Giá trị ước tính</label>
                        <input type="number" min="0" x-model="createForm.totalValue" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" placeholder="VNĐ" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Mô tả / phạm vi</label>
                        <textarea x-model="createForm.description" rows="2" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" placeholder="Cung cấp suất ăn văn phòng..."></textarea>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Lịch cung cấp</label>
                        <input type="text" x-model="createForm.supplySchedule" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" placeholder="Mỗi ngày lúc 11h..." />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Ngày bắt đầu</label>
                        <input type="date" x-model="createForm.startDate" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Ngày kết thúc</label>
                        <input type="date" x-model="createForm.endDate" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" />
                    </div>
                    <p x-show="createError" class="md:col-span-2 text-sm text-red-600" x-text="createError"></p>
                </div>
                <div class="px-6 py-5 bg-slate-50 border-t flex justify-end gap-3 rounded-b-[32px]">
                    <button type="button" @@click="isContractModalOpen = false; document.body.style.overflow = ''" class="px-5 py-2.5 rounded-xl border font-bold text-sm">Hủy</button>
                    <button type="button" @@click="submitCreate()" :disabled="acting" class="px-6 py-2.5 rounded-xl bg-slate-800 text-white font-bold text-sm disabled:opacity-50">Lưu hợp đồng</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function contractPage() {
    return {
        isContractModalOpen: false,
        acting: false,
        createError: '',
        createForm: { partnerId: '', contractNumber: '', description: '', supplySchedule: '', startDate: '', endDate: '', totalValue: '' },
        csrf() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; },
        async submitCreate() {
            const partnerId = parseInt(this.createForm.partnerId, 10);
            if (!partnerId) { this.createError = 'Chọn đối tác cung cấp'; return; }
            if (!this.createForm.startDate) { this.createError = 'Chọn ngày bắt đầu'; return; }
            this.acting = true;
            this.createError = '';
            try {
                const res = await fetch('@Url.Action("Create", "Contract", new { area = "Manager" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.csrf() },
                    body: JSON.stringify({
                        partnerId,
                        contractNumber: this.createForm.contractNumber || null,
                        description: this.createForm.description || null,
                        supplySchedule: this.createForm.supplySchedule || null,
                        startDate: this.createForm.startDate,
                        endDate: this.createForm.endDate || null,
                        totalValue: this.createForm.totalValue ? parseFloat(this.createForm.totalValue) : null,
                        status: 'active'
                    })
                });
                const json = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(json.message || 'Tạo thất bại');
                window.location.reload();
            } catch (e) {
                this.createError = e.message;
            } finally {
                this.acting = false;
            }
        }
    };
}
</script>
}
