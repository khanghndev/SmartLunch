@{
    ViewData["Title"] = "Trang cá nhân";
    Layout = "_LayoutManager";
}

<div class="p-2 sm:p-6 space-y-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-green-600">Trang cá nhân</h1>

    <div class="bg-white rounded-xl shadow p-6">
        <div class="flex items-center gap-6 border-b pb-6 mb-6">
            <div class="w-24 h-24 rounded-full bg-green-100 flex items-center justify-center text-green-600 text-3xl font-bold">
                M
            </div>
            <div>
                <h2 class="text-2xl font-bold">Quản Lý Nguyễn Văn A</h2>
                <p class="text-gray-500">manager@smartlunch.com</p>
                <div class="mt-2">
                    <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold">MANAGER</span>
                </div>
            </div>
        </div>

        <form class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên</label>
                    <input type="text" value="Nguyễn Văn A" class="w-full border px-3 py-2 rounded focus:ring-green-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
                    <input type="text" value="0987654321" class="w-full border px-3 py-2 rounded focus:ring-green-500" />
                </div>
            </div>
            <div>
                 <label class="block text-sm font-medium text-gray-700 mb-1">Bộ phận công tác</label>
                 <input type="text" value="Bếp trưởng Bếp 1 - KCN Amata" disabled class="w-full border px-3 py-2 rounded bg-gray-50 text-gray-500" />
            </div>
            <div class="pt-4 flex justify-end">
                <button type="button" class="bg-green-600 text-white px-6 py-2 rounded shadow hover:bg-green-700">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>
