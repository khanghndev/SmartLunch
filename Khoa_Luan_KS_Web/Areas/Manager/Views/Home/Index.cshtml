@{
    ViewData["Title"] = "Tổng quan Hoạt động";
    Layout = "_LayoutManager";
}

<!-- Alpine Data Component for Current Time & Date -->
<div class="px-4 space-y-6" x-data="{ 
    currentTime: '',
    currentDate: '',
    init() {
        const updateTime = () => {
            const now = new Date();
            this.currentTime = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            this.currentDate = now.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        };
        updateTime();
        setInterval(updateTime, 1000);
    }
}">

    <!-- Khối Header: Thông tin chung & Thời gian -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 md:px-8 py-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight mb-1">Tổng quan Hoạt động Doanh nghiệp</h1>
            <p class="text-gray-500 font-medium text-sm flex items-center gap-2">
                <i class="far fa-calendar text-gray-400"></i> Hôm nay là <span x-text="currentDate" class="text-gray-700"></span>
            </p>
        </div>
        
        <div class="flex gap-4 items-center">
            <div class="px-4 py-2 bg-gray-50 border border-gray-100 rounded-lg flex items-center gap-3">
                <i class="far fa-clock text-green-600"></i>
                <div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mb-0.5">Giờ Hệ Thống</div>
                    <div class="font-mono text-base font-bold text-gray-800" x-text="currentTime">--:--:--</div>
                </div>
            </div>
            <button class="bg-green-600 text-white hover:bg-green-700 font-semibold px-5 py-3 rounded-lg shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-file-export"></i> Báo cáo Vận hành
            </button>
        </div>
    </div>

    <!-- 4 WIDGETS: Bộ chỉ số KPI -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Khối 1 -->
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex flex-col">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Kế Hoạch Khẩu Phần</div>
                <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-sm"><i class="fas fa-utensils"></i></div>
            </div>
            <h3 class="text-3xl font-bold text-gray-900">2,450</h3>
            <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-gray-500">
                <i class="fas fa-arrow-up text-blue-600"></i> 12% so với định mức hôm qua
            </div>
        </div>

        <!-- Khối 2 -->
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex flex-col">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Tiến Độ Phục Vụ</div>
                <div class="w-8 h-8 rounded-full bg-orange-50 text-orange-600 flex items-center justify-center text-sm"><i class="fas fa-truck"></i></div>
            </div>
            <div class="flex items-end gap-1 mb-3">
                <h3 class="text-3xl font-bold text-gray-900">1,200</h3>
                <span class="text-gray-400 font-medium text-sm mb-1">/ 2,450</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-1.5 mb-1.5">
                <div class="bg-orange-500 h-1.5 rounded-full" style="width: 48%"></div>
            </div>
            <p class="text-[11px] text-gray-500 font-medium text-right">Đạt 48%</p>
        </div>

        <!-- Khối 3 -->
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex flex-col hover:border-red-200 transition">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Phản Hồi & Khuyến Nghị</div>
                <div class="w-8 h-8 rounded-full bg-red-50 text-red-600 flex items-center justify-center text-sm"><i class="fas fa-bell"></i></div>
            </div>
            <h3 class="text-3xl font-bold text-red-600">05</h3>
            <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-red-600">
                <i class="fas fa-info-circle"></i> Đang chờ xử lý trong ca
            </div>
        </div>

        <!-- Khối 4 -->
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex flex-col">
            <div class="flex items-center justify-between mb-3">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Hiện Diện Nhân Sự</div>
                <div class="w-8 h-8 rounded-full bg-green-50 text-green-600 flex items-center justify-center text-sm"><i class="fas fa-users"></i></div>
            </div>
            <div class="flex items-end gap-1">
                <h3 class="text-3xl font-bold text-gray-900">45</h3>
                <span class="text-gray-400 font-medium text-sm mb-1">/ 50</span>
            </div>
            <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-gray-500">
                <span class="w-2 h-2 rounded-full bg-yellow-400"></span> 5 ca nghỉ có phép
            </div>
        </div>

    </div>

    <!-- KHU VỰC DỮ LIỆU CHI TIẾT (2 CỘT) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Cột Trái: Bảng Theo dõi Công nợ (Span 2) -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                
                <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <h3 class="font-bold text-gray-900 text-[15px]">Bảng Kê Công Nợ Phải Thu</h3>
                    <div class="flex gap-2">
                        <span class="px-3 py-1 bg-gray-50 text-gray-600 text-xs font-medium rounded border border-gray-200">Kỳ Hiện Tại</span>
                        <span class="px-3 py-1 text-gray-500 hover:text-gray-700 text-xs font-medium rounded cursor-pointer transition">Xem Tất Cả</span>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-gray-50 text-gray-500 text-[11px] uppercase font-bold tracking-wider">
                            <tr>
                                <th class="px-6 py-4 border-b border-gray-100">Mã Chứng Từ</th>
                                <th class="px-6 py-4 border-b border-gray-100">Đơn Vị Khách Hàng</th>
                                <th class="px-6 py-4 border-b border-gray-100">Số Tiền (VND)</th>
                                <th class="px-6 py-4 border-b border-gray-100">Thời Hạn</th>
                                <th class="px-6 py-4 border-b border-gray-100 text-center">Tác Vụ</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 text-gray-700">
                            
                            <!-- Hợp đồng 1 -->
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 font-medium text-gray-900">#HD-2404-012</td>
                                <td class="px-6 py-4">Công ty TNHH May Mặc Hưng Phú</td>
                                <td class="px-6 py-4 font-semibold text-gray-900">45,000,000</td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-col gap-1">
                                        <span class="text-gray-900 font-medium">30/04/2026</span>
                                        <span class="text-[10px] text-red-600 font-medium bg-red-50 px-2 py-0.5 rounded w-fit border border-red-100">Sắp đến hạn</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <button class="text-blue-600 hover:text-blue-800 text-sm font-medium transition">Chi tiết</button>
                                </td>
                            </tr>

                            <!-- Hợp đồng 2 -->
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 font-medium text-gray-900">#HD-2405-013</td>
                                <td class="px-6 py-4">Trường Mầm Non Ánh Dương Quốc Tế</td>
                                <td class="px-6 py-4 font-semibold text-gray-900">20,500,000</td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-col gap-1">
                                        <span class="text-gray-900 font-medium">15/05/2026</span>
                                        <span class="text-[10px] text-gray-500 font-medium bg-gray-100 px-2 py-0.5 rounded w-fit border border-gray-200">Kỳ thanh toán tới</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <button class="text-blue-600 hover:text-blue-800 text-sm font-medium transition">Chi tiết</button>
                                </td>
                            </tr>
                            
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Truy cập nhanh (Quick Actions) -->
            <div class="grid grid-cols-2 gap-4">
                 <div class="bg-white border border-gray-100 shadow-sm rounded-xl p-5 flex items-center justify-between cursor-pointer hover:border-gray-300 transition">
                     <div>
                         <div class="text-[11px] font-medium text-gray-500 mb-1">Kiểm Soát Nguồn Gốc</div>
                         <h4 class="font-bold text-sm text-gray-900">Nhật Ký Nhập Kho</h4>
                     </div>
                     <i class="fas fa-box text-gray-300 text-xl"></i>
                 </div>
                 <a href="/Manager/CatalogMeals" class="bg-white border border-gray-100 shadow-sm rounded-xl p-5 flex items-center justify-between cursor-pointer hover:border-gray-300 transition block">
                     <div>
                         <div class="text-[11px] font-medium text-gray-500 mb-1">Quản Trị Hệ Thống</div>
                         <h4 class="font-bold text-sm text-gray-900">Bộ Thực Đơn Bếp</h4>
                     </div>
                     <i class="fas fa-utensils text-gray-300 text-xl"></i>
                 </a>
            </div>
        </div>

        <!-- Cột Phải: Lịch Trình Vận Hành (Timeline) (Span 1) -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 h-full flex flex-col">
                <div class="px-6 py-4 border-b border-gray-100 shrink-0">
                    <h3 class="font-bold text-gray-900 text-[15px]">Lịch Trình Hoạt Động Cơ Sở</h3>
                    <p class="text-xs text-gray-500 mt-1 font-medium">Bản tin cập nhật trong ca trực</p>
                </div>

                <div class="p-6 flex-1 overflow-auto">
                    <!-- Timeline Container -->
                    <div class="relative border-l border-gray-200 ml-2 space-y-8">
                        
                        <!-- Sự kiện 1 -->
                        <div class="relative pl-6">
                            <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-blue-500ring-4 ring-white"></div>
                            <div class="text-xs font-bold text-gray-600 mb-1">08:15 AM</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Xuất xe giao hàng tuyến Quận 1</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Bộ phận Logisitics hoàn tất bốc xếp 1,200 suất ăn cho khách hàng Trường Học. Đã ký biên bản bàn giao thân nhiệt lúc vận chuyển (4°C).</p>
                        </div>

                        <!-- Sự kiện 2 -->
                        <div class="relative pl-6">
                            <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-orange-500 ring-4 ring-white"></div>
                            <div class="text-xs font-bold text-gray-600 mb-1">07:30 AM</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Báo cáo điều chỉnh tiến độ Bếp Nhỏ</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Line nấu món "Thịt Kho" chậm tiến độ dự kiến 15 phút. Bếp trưởng đã can thiệp và phân bổ chảo nấu thay thế.</p>
                        </div>

                        <!-- Sự kiện 3 -->
                        <div class="relative pl-6">
                            <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-green-500 ring-4 ring-white"></div>
                            <div class="text-xs font-bold text-gray-600 mb-1">05:00 AM</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Hoàn tất kiểm tra và Nhập kho</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Nhận bàn giao 2 Tấn thực phẩm tươi sống từ nhà cung cấp CP. Chứng chỉ VSATTP và biên bản kiểm nghiệm chất lượng đạt tiêu chuẩn.</p>
                        </div>

                        <!-- Sự kiện 4 -->
                        <div class="relative pl-6">
                            <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-gray-400 ring-4 ring-white"></div>
                            <div class="text-xs font-bold text-gray-600 mb-1">04:30 AM</div>
                            <h4 class="text-sm font-semibold text-gray-900 mb-1">Điểm danh và Bắt đầu ca nấu sáng</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">Ghi nhận 45/50 nhân sự có mặt tại xưởng. Bắt đầu quy trình sơ chế bước 1.</p>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
