@model Khoa_Luan_KS_Web.Areas.Manager.Models.ManagerOrdersPageVm
@using System.Globalization
@using Khoa_Luan_KS_Web.Helpers
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    Layout = "_LayoutManager";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string FmtMoney(decimal v) => v.ToString("N0", vi) + " đ";
    int TotalQty(Khoa_Luan_KS_Web.Services.OrderDetailClientDto o) => o.Items.Sum(i => i.Quantity);
    string MealSummary(Khoa_Luan_KS_Web.Services.OrderDetailClientDto o) => o.Items.Count switch
    {
        0 => "—",
        1 => o.Items[0].DishName,
        _ => o.Items[0].DishName + $" +{o.Items.Count - 1} món"
    };
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="orderManager()">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý Đơn Hàng</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Tiếp nhận, xác nhận và theo dõi đơn đặt suất ăn B2B từ hệ thống.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, status = "pending" })"
           class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between hover:border-slate-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Chờ xác nhận</p>
                <p class="text-2xl font-black text-slate-800">@Model.CountPending</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-500 flex items-center justify-center">
                <i class="fas fa-clock text-lg"></i>
            </div>
        </a>
        <a href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, status = "confirmed" })"
           class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between hover:border-yellow-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Đã xác nhận / Chuẩn bị</p>
                <p class="text-2xl font-black text-slate-800">@Model.CountConfirmed</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-yellow-50 text-yellow-500 flex items-center justify-center">
                <i class="fas fa-utensils text-lg"></i>
            </div>
        </a>
        <a href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, status = "preparing" })"
           class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between hover:border-amber-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Đang chuẩn bị</p>
                <p class="text-2xl font-black text-slate-800">@Model.CountPreparing</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center">
                <i class="fas fa-fire text-lg"></i>
            </div>
        </a>
        <a href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, status = "delivered" })"
           class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between hover:border-green-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Đã giao (giao hôm nay)</p>
                <p class="text-2xl font-black text-green-600">@Model.CountDeliveredToday</p>
                <p class="text-[10px] text-slate-400 font-medium">Tổng đã giao: @Model.CountDelivered</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center">
                <i class="fas fa-check-circle text-lg"></i>
            </div>
        </a>
    </div>

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <form method="get" asp-area="Manager" asp-controller="Order" asp-action="Index"
              class="p-4 border-b border-slate-100 flex flex-col lg:flex-row gap-4 justify-between items-end bg-slate-50/50">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="flex flex-wrap items-end gap-3 w-full">
                <div class="relative flex-1 min-w-[200px] max-w-sm">
                    <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Tìm kiếm</label>
                    <input type="text" name="search" value="@Model.Search" placeholder="Mã HĐ, ID đơn, tên đơn vị..."
                           class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500" />
                    <i class="fas fa-search text-slate-400 absolute left-3 bottom-2.5 text-sm"></i>
                </div>
                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Trạng thái</label>
                    <select name="status" class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500 min-w-[160px]">
                        <option value="">Tất cả</option>
                        <option value="pending" selected="@(Model.FilterStatus == "pending")">Chờ xác nhận</option>
                        <option value="confirmed" selected="@(Model.FilterStatus == "confirmed")">Đã xác nhận</option>
                        <option value="preparing" selected="@(Model.FilterStatus == "preparing")">Đang chuẩn bị</option>
                        <option value="delivered" selected="@(Model.FilterStatus == "delivered")">Đã giao</option>
                        <option value="cancelled" selected="@(Model.FilterStatus == "cancelled")">Đã hủy</option>
                    </select>
                </div>
                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Ngày giao</label>
                    <input type="date" name="scheduledOn" value="@(Model.ScheduledOn?.ToString("yyyy-MM-dd"))"
                           class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500" />
                </div>
                <button type="submit" class="px-4 py-2 rounded-xl bg-slate-800 text-white text-sm font-bold hover:bg-slate-900">Lọc</button>
                <a asp-area="Manager" asp-controller="Order" asp-action="Index"
                   class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-white">Xóa lọc</a>
            </div>
        </form>

        <div class="overflow-x-auto">
            @if (!Model.Orders.Items.Any())
            {
                <div class="p-12 text-center text-slate-400">
                    <i class="fas fa-inbox text-4xl mb-3 opacity-40"></i>
                    <p class="font-medium">Không có đơn hàng phù hợp bộ lọc.</p>
                </div>
            }
            else
            {
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-wider text-slate-400 font-black">
                            <th class="p-4 pl-6">Mã đơn</th>
                            <th class="p-4">Khách hàng / Đơn vị</th>
                            <th class="p-4">Suất ăn</th>
                            <th class="p-4">Ngày giao</th>
                            <th class="p-4 text-right">Tổng tiền</th>
                            <th class="p-4 text-center">Trạng thái</th>
                            <th class="p-4 text-center">Thanh toán</th>
                            <th class="p-4 pr-6 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 text-sm">
                        @foreach (var o in Model.Orders.Items)
                        {
                            var code = string.IsNullOrWhiteSpace(o.InvoiceCode) ? $"ĐH-{o.Id}" : o.InvoiceCode;
                            <tr class="hover:bg-slate-50/50 transition-colors cursor-pointer" @@click="openDetail(@o.Id)">
                                <td class="p-4 pl-6 font-black text-slate-700">@code</td>
                                <td class="p-4">
                                    <div class="font-bold text-slate-800">@(o.OrganizationName ?? "—")</div>
                                    @if (o.AppliedPromotion != null)
                                    {
                                        <div class="text-[10px] text-green-700 font-medium mt-0.5">
                                            <i class="fas fa-tag"></i> @o.AppliedPromotion.PromotionName
                                        </div>
                                    }
                                </td>
                                <td class="p-4">
                                    <div class="font-medium text-slate-700 truncate max-w-[180px]">@MealSummary(o)</div>
                                    <span class="text-xs font-bold text-slate-500">@TotalQty(o) suất</span>
                                </td>
                                <td class="p-4 font-medium text-slate-700">@o.ScheduledDate.ToString("dd/MM/yyyy HH:mm", vi)</td>
                                <td class="p-4 text-right">
                                    <div class="font-black text-slate-800">@FmtMoney(o.TotalAmount)</div>
                                    @if (o.DiscountAmount > 0)
                                    {
                                        <div class="text-[10px] text-green-600 font-medium">−@FmtMoney(o.DiscountAmount)</div>
                                    }
                                </td>
                                <td class="p-4 text-center">
                                    <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-lg border @OrderStatusHelper.BadgeClass(o.Status)">
                                        @OrderStatusHelper.ToDisplay(o.Status)
                                    </span>
                                </td>
                                <td class="p-4 text-center">
                                    <span class="px-2 py-0.5 text-[10px] font-bold rounded @OrderStatusHelper.PaymentBadgeClass(o.PaymentStatus)">
                                        @OrderStatusHelper.PaymentDisplay(o.PaymentStatus)
                                    </span>
                                </td>
                                <td class="p-4 pr-6 text-right">
                                    <button type="button" @@click.stop="openDetail(@o.Id)"
                                            class="p-2 text-slate-400 hover:text-green-600 hover:bg-green-50 rounded-lg">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <partial name="_PaginationBar" model="Model.Pagination" />
    </div>

    <!-- Modal chi tiết -->
    <div x-show="isDetailOpen" style="display: none;" class="relative z-50" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="closeDetail()"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-4">
            <div class="relative w-full max-w-2xl rounded-[32px] bg-white shadow-2xl" @@click.stop>
                <template x-if="currentOrder">
                    <div>
                        <div class="px-8 py-6 border-b bg-slate-50/50 flex justify-between items-start">
                            <div>
                                <h2 class="text-xl font-black text-slate-800" x-text="'Đơn ' + currentOrder.code"></h2>
                                <p class="text-sm text-slate-500 mt-1" x-text="currentOrder.customer"></p>
                                <span class="inline-block mt-2 px-2.5 py-1 text-[10px] font-bold uppercase rounded-lg border"
                                      :class="currentOrder.statusClass" x-text="currentOrder.statusLabel"></span>
                            </div>
                            <button type="button" @@click="closeDetail()" class="p-2 text-slate-400 hover:bg-slate-200 rounded-full">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <div class="px-8 py-6 space-y-5 max-h-[60vh] overflow-y-auto">
                            <div class="grid grid-cols-2 gap-4 text-sm">
                                <div>
                                    <p class="text-slate-400 text-xs font-bold uppercase">Ngày đặt</p>
                                    <p class="font-bold text-slate-800" x-text="currentOrder.orderDate"></p>
                                </div>
                                <div>
                                    <p class="text-slate-400 text-xs font-bold uppercase">Ngày giao</p>
                                    <p class="font-bold text-slate-800" x-text="currentOrder.time"></p>
                                </div>
                                <div>
                                    <p class="text-slate-400 text-xs font-bold uppercase">Thanh toán</p>
                                    <p class="font-bold" :class="currentOrder.paymentClass" x-text="currentOrder.paymentLabel"></p>
                                </div>
                                <div>
                                    <p class="text-slate-400 text-xs font-bold uppercase">Phụ lục đã ký</p>
                                    <template x-if="currentOrder.annexPdfUrl">
                                        <a :href="currentOrder.annexPdfUrl" target="_blank" rel="noopener"
                                           class="font-bold text-green-600 hover:underline text-sm">Xem PDF phụ lục</a>
                                    </template>
                                    <p x-show="!currentOrder.annexPdfUrl" class="font-bold text-slate-500">Chưa ký</p>
                                </div>
                            </div>

                            <div class="border rounded-xl overflow-hidden">
                                <table class="w-full text-sm">
                                    <thead class="bg-slate-50 text-slate-500 text-xs">
                                        <tr>
                                            <th class="p-3 text-left">Món</th>
                                            <th class="p-3 text-center">SL</th>
                                            <th class="p-3 text-right">Đơn giá</th>
                                            <th class="p-3 pr-3 text-right">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <template x-for="line in currentOrder.items" :key="line.dishName + line.quantity">
                                            <tr class="border-t border-slate-50">
                                                <td class="p-3 font-medium" x-text="line.dishName"></td>
                                                <td class="p-3 text-center font-bold" x-text="line.quantity"></td>
                                                <td class="p-3 text-right text-slate-600" x-text="line.unitPrice"></td>
                                                <td class="p-3 pr-3 text-right font-bold" x-text="line.totalPrice"></td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>

                            <div class="bg-slate-50 rounded-xl p-4 space-y-1 text-sm">
                                <div class="flex justify-between">
                                    <span class="text-slate-500">Thành tiền</span>
                                    <span class="font-bold" x-text="currentOrder.subtotal"></span>
                                </div>
                                <template x-if="currentOrder.promotionName">
                                    <div class="flex justify-between text-green-700">
                                        <span>
                                            KM: <span class="font-bold" x-text="currentOrder.promotionName"></span>
                                            <span class="text-xs" x-text="currentOrder.promotionCode ? '(' + currentOrder.promotionCode + ')' : ''"></span>
                                        </span>
                                        <span class="font-bold" x-text="'−' + currentOrder.discount"></span>
                                    </div>
                                </template>
                                <div class="flex justify-between pt-2 border-t border-slate-200">
                                    <span class="font-black text-slate-800">Tổng phải trả</span>
                                    <span class="font-black text-green-600 text-lg" x-text="currentOrder.total"></span>
                                </div>
                            </div>

                            <template x-if="currentOrder.editableStatuses && currentOrder.editableStatuses.length > 0 && currentOrder.status !== 'delivered' && currentOrder.status !== 'cancelled'">
                                <form :action="'/Manager/Order/UpdateStatus'" method="post" class="space-y-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" :value="currentOrder.id" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <input type="hidden" name="filterStatus" value="@Model.FilterStatus" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="scheduledOn" value="@(Model.ScheduledOn?.ToString("yyyy-MM-dd"))" />
                                    <label class="block text-sm font-bold text-slate-700">Cập nhật trạng thái</label>
                                    <select name="status" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold" required>
                                        <template x-for="opt in currentOrder.editableStatuses" :key="opt.value">
                                            <option :value="opt.value" x-text="opt.label"></option>
                                        </template>
                                    </select>
                                    <button type="submit" class="w-full py-2.5 rounded-xl bg-green-600 text-white font-bold text-sm hover:bg-green-700">
                                        <i class="fas fa-check mr-1"></i> Lưu trạng thái
                                    </button>
                                </form>
                            </template>
                        </div>

                        <div class="px-8 py-4 border-t bg-slate-50 flex justify-end rounded-b-[32px]">
                            <button type="button" @@click="closeDetail()" class="px-5 py-2 rounded-xl border font-bold text-sm text-slate-600">Đóng</button>
                        </div>
                    </div>
                </template>
                <div x-show="loading" class="p-12 text-center text-slate-400">
                    <i class="fas fa-spinner fa-spin text-2xl"></i>
                    <p class="mt-2 text-sm">Đang tải chi tiết...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('orderManager', () => ({
                isDetailOpen: false,
                loading: false,
                currentOrder: null,

                async openDetail(id) {
                    this.isDetailOpen = true;
                    this.loading = true;
                    this.currentOrder = null;
                    document.body.style.overflow = 'hidden';
                    try {
                        const res = await fetch('/Manager/Order/Detail?id=' + id);
                        const data = await res.json();
                        if (!data.success) throw new Error(data.message || 'Lỗi tải đơn');
                        this.currentOrder = data.order;
                    } catch (e) {
                        alert(e.message || 'Không tải được chi tiết đơn');
                        this.closeDetail();
                    } finally {
                        this.loading = false;
                    }
                },

                closeDetail() {
                    this.isDetailOpen = false;
                    this.currentOrder = null;
                    document.body.style.overflow = '';
                }
            }));
        });
    </script>
}
