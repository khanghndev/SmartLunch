@model Khoa_Luan_KS_Web.Areas.Manager.Controllers.ManagerInventoryIndexViewModel
@using Khoa_Luan_KS_Web.Areas.Manager.Controllers
@{
    ViewData["Title"] = "Tồn Kho";
    Layout = "_LayoutManager";

    int totalPages = Model.PageSize > 0 ? Math.Max(1, (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)) : 1;
    var rows = Model.Rows;

    string FormatMoney(decimal v)
    {
        if (v >= 1_000_000_000) return (v / 1_000_000_000m).ToString("0.#") + " Tỷ";
        if (v >= 1_000_000) return (v / 1_000_000m).ToString("0.#") + " Tr";
        return v.ToString("N0") + " đ";
    }

    string BuildUrl(int page, string? filter = null)
    {
        var f = filter ?? Model.StatusFilter;
        var q = $"?page={page}&pageSize={Model.PageSize}&statusFilter={Uri.EscapeDataString(f)}";
        if (!string.IsNullOrEmpty(Model.SearchTerm)) q += $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}";
        return q;
    }

    string StatusBadgeClass(string ui) => ui switch
    {
        "HetHang" => "bg-slate-100 text-slate-600 border-slate-200",
        "SapHet" => "bg-yellow-50 text-yellow-700 border-yellow-200",
        "CanDate" => "bg-purple-50 text-purple-700 border-purple-200",
        _ => "bg-green-50 text-green-700 border-green-200"
    };
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý Tồn kho</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Theo dõi tồn thực tế, cảnh báo tồn thấp và hạn sử dụng lô hàng (API kho).</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-area="Manager" asp-controller="Import" asp-action="Index"
               class="px-5 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Đề xuất nhập kho
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="text-sm text-red-700 bg-red-50 border border-red-100 rounded-xl px-4 py-3">@TempData["Error"]</div>
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm group hover:border-green-300 transition-colors">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center group-hover:bg-green-50 group-hover:text-green-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Giá trị tồn (ước tính)</span>
            </div>
            <p class="text-2xl font-black text-slate-800" title="@Model.EstimatedStockValue.ToString("N0") đ">@FormatMoney(Model.EstimatedStockValue)</p>
            <p class="text-xs text-slate-500 mt-1">@Model.TotalSkuCount mặt hàng · tồn × giá NL</p>
        </div>

        <a href="@BuildUrl(1, "low")" class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:border-yellow-300 transition-colors block">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-yellow-50 text-yellow-500 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Sắp hết hàng</span>
            </div>
            <p class="text-2xl font-black text-slate-800">@Model.LowStockCount <span class="text-xs text-slate-500 font-bold">Mặt hàng</span></p>
        </a>

        <a href="@BuildUrl(1, "out")" class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:border-red-300 transition-colors block">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-red-50 text-red-500 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Hết hàng</span>
            </div>
            <p class="text-2xl font-black text-red-600">@Model.OutOfStockCount <span class="text-xs text-red-400 font-bold">Mặt hàng</span></p>
        </a>

        <a href="@BuildUrl(1, "near_expiry")" class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:border-purple-300 transition-colors block">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-purple-50 text-purple-500 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Cận HSD (30 ngày)</span>
            </div>
            <p class="text-2xl font-black text-slate-800">@Model.NearExpiryCount <span class="text-xs text-slate-500 font-bold">Mặt hàng</span></p>
        </a>
    </div>

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <div class="p-4 border-b border-slate-100 flex flex-col lg:flex-row gap-4 justify-between items-start lg:items-center bg-slate-50/50">
            <form method="get" asp-area="Manager" asp-controller="Inventory" asp-action="Index" class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                <div class="relative w-full sm:w-72">
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Tìm theo tên nguyên liệu..."
                           class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all" />
                </div>
                <select name="statusFilter" class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500">
                    @if (Model.StatusFilter == "all") { <option value="all" selected>Tất cả trạng thái</option> } else { <option value="all">Tất cả trạng thái</option> }
                    @if (Model.StatusFilter == "low") { <option value="low" selected>Sắp hết hàng</option> } else { <option value="low">Sắp hết hàng</option> }
                    @if (Model.StatusFilter == "out") { <option value="out" selected>Hết hàng</option> } else { <option value="out">Hết hàng</option> }
                    @if (Model.StatusFilter == "near_expiry") { <option value="near_expiry" selected>Cận HSD</option> } else { <option value="near_expiry">Cận HSD</option> }
                </select>
                <button type="submit" class="px-4 py-2 bg-green-600 text-white font-bold rounded-xl text-sm hover:bg-green-700 transition">Lọc</button>
            </form>
            <p class="text-xs font-bold text-slate-500">@Model.TotalCount kết quả</p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-wider text-slate-400 font-black">
                        <th class="p-4 pl-6">Mã / Nguyên liệu</th>
                        <th class="p-4 text-right">Tồn kho</th>
                        <th class="p-4 text-right">Ngưỡng tối thiểu</th>
                        <th class="p-4">Hạn sử dụng gần nhất</th>
                        <th class="p-4 text-center">Trạng thái</th>
                        <th class="p-4 pr-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 text-sm">
                    @if (!rows.Any())
                    {
                        <tr>
                            <td colspan="6" class="p-12 text-center text-slate-400">
                                <p class="font-bold">Không có dữ liệu tồn kho</p>
                                <p class="text-xs mt-1">Thử đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var row in rows)
                    {
                        decimal pct = row.ReorderLevel.HasValue && row.ReorderLevel.Value > 0
                            ? Math.Min(100, (row.QuantityAvailable / (row.ReorderLevel.Value * 3)) * 100)
                            : 100;
                        string qtyCls = row.UiStatus == "HetHang" ? "text-slate-400" : row.UiStatus == "SapHet" ? "text-red-600" : "text-slate-800";

                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="p-4 pl-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 border border-slate-200">
                                        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800">@row.Name</div>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <span class="text-xs font-bold text-slate-400 bg-white border border-slate-200 px-1.5 py-0.5 rounded uppercase tracking-wider">#@row.IngredientId</span>
                                            @if (!string.IsNullOrEmpty(row.Unit))
                                            {
                                                <span class="text-xs font-medium text-slate-500">@row.Unit</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4 text-right">
                                <span class="font-black text-lg @qtyCls">@row.QuantityAvailable</span>
                                <span class="text-xs text-slate-500 font-bold ml-1">@row.Unit</span>
                                <div class="w-24 ml-auto mt-1 bg-slate-100 rounded-full h-1">
                                    <div class="h-1 rounded-full @(row.UiStatus == "HetHang" ? "bg-slate-400" : row.UiStatus == "SapHet" ? "bg-red-500" : "bg-green-500")" style="width: @pct%"></div>
                                </div>
                            </td>
                            <td class="p-4 text-right text-slate-500 font-bold">
                                @(row.ReorderLevel.HasValue ? row.ReorderLevel.Value.ToString("N2") + " " + row.Unit : "—")
                            </td>
                            <td class="p-4">
                                @if (row.NearestExpiry.HasValue)
                                {
                                    <div class="font-bold text-slate-700">@row.NearestExpiry.Value.ToString("dd/MM/yyyy")</div>
                                    @if (row.UiStatus == "CanDate")
                                    {
                                        <div class="text-[10px] font-bold text-purple-600 bg-purple-50 inline-block px-1.5 py-0.5 rounded uppercase tracking-wider mt-1">Cận HSD</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="p-4 text-center">
                                <span class="px-2.5 py-1 text-[11px] font-bold rounded-lg border @StatusBadgeClass(row.UiStatus)">@row.UiStatusLabel</span>
                            </td>
                            <td class="p-4 pr-6 text-right">
                                <a asp-area="Manager" asp-controller="Inventory" asp-action="Detail" asp-route-id="@row.IngredientId"
                                   class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-bold text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="px-5 py-4 border-t border-slate-100 flex items-center justify-between text-sm bg-slate-50/30">
                <p class="text-slate-500 font-medium">Trang @Model.Page / @totalPages</p>
                <div class="flex gap-2">
                    @if (Model.Page > 1)
                    {
                        <a href="@BuildUrl(Model.Page - 1)" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-bold hover:bg-white transition">Trước</a>
                    }
                    @if (Model.Page < totalPages)
                    {
                        <a href="@BuildUrl(Model.Page + 1)" class="px-4 py-2 rounded-xl bg-green-600 text-white font-bold hover:bg-green-700 transition">Sau</a>
                    }
                </div>
            </div>
        }
    </div>

    <p class="text-xs text-slate-500 text-center max-w-2xl mx-auto">
        Tồn kho và HSD lấy từ hệ thống. Điều chỉnh/xuất kho nội bộ do nhân viên kho thực hiện; quản lý có thể tạo <a asp-area="Manager" asp-controller="Import" asp-action="Index" class="text-green-600 font-bold hover:underline">đề xuất nhập kho</a>.
    </p>
</div>
