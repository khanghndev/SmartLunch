@{
    ViewData["Title"] = "Tồn Kho";
    Layout = "_LayoutManager";
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="inventoryManager()">
    
    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý Tồn kho (Inventory)</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Theo dõi số lượng hàng hóa thực tế, cảnh báo hết hạn và sai lệch kho.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <button class="px-5 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Xuất file Excel
            </button>
            <button @@click="openAdjustModal()" class="px-5 py-2 bg-slate-800 text-white font-bold rounded-xl shadow-lg hover:bg-slate-900 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                Điều chỉnh kho / Kiểm kê
            </button>
        </div>
    </div>

    <!-- STATS WIDGETS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between group hover:border-green-300 transition-colors">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center group-hover:bg-green-50 group-hover:text-green-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Giá trị tồn</span>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">420.5M <span class="text-xs text-slate-500 font-bold">VNĐ</span></p>
            </div>
        </div>
        
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between group hover:border-yellow-300 transition-colors cursor-pointer" @@click="statusFilter = 'Sắp hết hàng'">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-yellow-50 text-yellow-500 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Sắp hết hàng</span>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">8 <span class="text-xs text-slate-500 font-bold">Mặt hàng</span></p>
            </div>
        </div>
        
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between group hover:border-red-300 transition-colors cursor-pointer" @@click="statusFilter = 'Sai lệch'">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-red-50 text-red-500 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Cảnh báo sai lệch</span>
            </div>
            <div>
                <p class="text-2xl font-black text-red-600">2 <span class="text-xs text-red-400 font-bold">Mặt hàng</span></p>
            </div>
        </div>
        
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between group hover:border-purple-300 transition-colors cursor-pointer" @@click="statusFilter = 'Cận Date'">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-full bg-purple-50 text-purple-500 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Cận Date (HSD)</span>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">5 <span class="text-xs text-slate-500 font-bold">Mặt hàng</span></p>
            </div>
        </div>
    </div>

    <!-- MAIN DATA GRID -->
    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <!-- Toolbar -->
        <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row gap-4 justify-between items-center bg-slate-50/50">
            <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                <div class="relative w-full sm:w-72">
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" x-model="searchQuery" placeholder="Tìm theo tên SP, SKU..." class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all" />
                </div>
                
                <select x-model="categoryFilter" class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500">
                    <option value="all">Tất cả danh mục</option>
                    <option value="Đồ khô">Đồ khô / Gia vị</option>
                    <option value="Thực phẩm tươi sống">Thực phẩm tươi sống</option>
                    <option value="Đông lạnh">Hàng đông lạnh</option>
                </select>
                
                <select x-model="statusFilter" class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="Bình thường">Bình thường</option>
                    <option value="Sắp hết hàng">Sắp hết hàng</option>
                    <option value="Sai lệch">Cảnh báo Sai lệch</option>
                    <option value="Cận Date">Cận Date</option>
                </select>
            </div>
        </div>
        
        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-wider text-slate-400 font-black">
                        <th class="p-4 pl-6">SKU / Sản phẩm</th>
                        <th class="p-4 text-right">Tồn hệ thống</th>
                        <th class="p-4 text-right">Tồn thực tế</th>
                        <th class="p-4 text-center">Chênh lệch</th>
                        <th class="p-4">Hạn sử dụng (Date)</th>
                        <th class="p-4 pr-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 text-sm">
                    <template x-for="item in filteredItems" :key="item.id">
                        <tr class="hover:bg-slate-50/50 transition-colors group" :class="item.systemQty !== item.actualQty ? 'bg-red-50/30' : ''">
                            <td class="p-4 pl-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 border border-slate-200">
                                        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800" x-text="item.name"></div>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <span class="text-xs font-bold text-slate-400 bg-white border border-slate-200 px-1.5 py-0.5 rounded uppercase tracking-wider" x-text="item.sku"></span>
                                            <span class="text-xs font-medium text-slate-500" x-text="item.category"></span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            
                            <td class="p-4 text-right">
                                <span class="font-black text-slate-500" x-text="item.systemQty + ' ' + item.unit"></span>
                            </td>
                            
                            <td class="p-4 text-right">
                                <span class="font-black text-lg" :class="item.actualQty < item.systemQty ? 'text-red-600' : 'text-slate-800'" x-text="item.actualQty + ' ' + item.unit"></span>
                            </td>
                            
                            <td class="p-4 text-center">
                                <template x-if="item.systemQty === item.actualQty">
                                    <span class="px-2 py-1 text-[11px] font-bold rounded-lg border bg-slate-50 text-slate-500 border-slate-200">Khớp</span>
                                </template>
                                <template x-if="item.systemQty > item.actualQty">
                                    <span class="px-2 py-1 text-[11px] font-bold rounded-lg border bg-red-50 text-red-600 border-red-200 inline-flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6"></path></svg>
                                        Thất thoát <span x-text="item.systemQty - item.actualQty"></span>
                                    </span>
                                </template>
                            </td>
                            
                            <td class="p-4">
                                <div class="font-bold text-slate-700" x-text="item.expiry"></div>
                                <div x-show="item.status === 'Cận Date'" class="text-[10px] font-bold text-purple-600 bg-purple-50 inline-block px-1.5 py-0.5 rounded uppercase tracking-wider mt-1">Cận HSD</div>
                            </td>
                            
                            <td class="p-4 pr-6 text-right">
                                <button @@click="openAdjustModal(item)" class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Điều chỉnh / Kiểm kê kho">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- MODAL: KIỂM KÊ / ĐIỀU CHỈNH KHO (CRUD) -->
    <div x-show="isAdjustModalOpen" style="display: none;" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="isAdjustModalOpen" 
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" 
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="closeModal()"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="isAdjustModalOpen" 
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md" @@click.stop>
                    
                    <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h3 class="text-xl font-black text-slate-800">Kiểm kê / Điều chỉnh Kho</h3>
                        <button @@click="closeModal()" class="text-slate-400 hover:text-slate-600 bg-slate-200/50 hover:bg-slate-200 p-1.5 rounded-full transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    
                    <div class="p-6 space-y-5" x-data="{ adjustType: 'loss' }">
                        <template x-if="currentItem">
                            <div class="bg-blue-50 border border-blue-100 rounded-[16px] p-4">
                                <p class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-1" x-text="'SKU: ' + currentItem.sku"></p>
                                <h4 class="text-lg font-black text-blue-900 mb-2" x-text="currentItem.name"></h4>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-blue-700">Tồn hệ thống:</span>
                                    <span class="font-black text-blue-900" x-text="currentItem.systemQty + ' ' + currentItem.unit"></span>
                                </div>
                            </div>
                        </template>
                        <template x-if="!currentItem">
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-2">Chọn sản phẩm (SKU)</label>
                                <select class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-blue-500 bg-white">
                                    <option>--- Tìm theo SKU ---</option>
                                    <option>Dầu ăn Neptune 5L (SKU: SP-001)</option>
                                    <option>Gạo ST25 (SKU: SP-002)</option>
                                </select>
                            </div>
                        </template>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Số lượng Tồn kho Thực tế sau kiểm đếm</label>
                            <div class="relative">
                                <input type="number" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-lg font-black focus:border-blue-500 focus:ring-1 focus:ring-blue-500 shadow-sm" value="0" />
                                <div class="absolute right-3 top-1/2 -translate-y-1/2 font-bold text-slate-400" x-text="currentItem ? currentItem.unit : ''"></div>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Lý do điều chỉnh sai lệch</label>
                            <select class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-blue-500 bg-white mb-3">
                                <option>Sản phẩm hư hỏng / Bể vỡ</option>
                                <option>Hết hạn sử dụng (Tiêu hủy)</option>
                                <option>Nhập liệu sai lệch trước đó</option>
                                <option>Hàng thất thoát không rõ nguyên nhân</option>
                            </select>
                            
                            <textarea rows="2" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-blue-500 shadow-sm" placeholder="Ghi chú thêm chi tiết (bắt buộc đối với thất thoát)..."></textarea>
                        </div>
                    </div>
                    
                    <div class="px-6 py-5 bg-slate-50 border-t border-slate-100 flex justify-end gap-3 rounded-b-[32px]">
                        <button @@click="closeModal()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-white border border-slate-200 transition-colors text-sm">Hủy</button>
                        <button @@click="submitAdjustment()" class="px-6 py-2.5 rounded-xl bg-blue-600 text-white font-bold hover:bg-blue-700 transition-colors text-sm shadow-lg shadow-blue-600/30 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                            Lưu biên bản kiểm kê
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('inventoryManager', () => ({
                searchQuery: '',
                categoryFilter: 'all',
                statusFilter: 'all',
                isAdjustModalOpen: false,
                currentItem: null,
                
                items: [
                    { id: 1, sku: 'SKU-001', name: 'Dầu ăn Neptune 5L', category: 'Đồ khô', systemQty: 45, actualQty: 45, unit: 'Can', expiry: '12/12/2026', status: 'Bình thường' },
                    { id: 2, sku: 'SKU-002', name: 'Thịt heo tươi (Ba rọi)', category: 'Thực phẩm tươi sống', systemQty: 20, actualQty: 15, unit: 'KG', expiry: '28/04/2026', status: 'Sai lệch' },
                    { id: 3, sku: 'SKU-003', name: 'Gạo tẻ ST25', category: 'Đồ khô', systemQty: 600, actualQty: 600, unit: 'KG', expiry: '15/08/2026', status: 'Bình thường' },
                    { id: 4, sku: 'SKU-004', name: 'Sữa tươi Vinamilk', category: 'Đồ khô', systemQty: 120, actualQty: 120, unit: 'Thùng', expiry: '30/04/2026', status: 'Cận Date' },
                    { id: 5, sku: 'SKU-005', name: 'Tôm sú đông lạnh', category: 'Đông lạnh', systemQty: 15, actualQty: 15, unit: 'KG', expiry: '10/05/2026', status: 'Sắp hết hàng' }
                ],
                
                get filteredItems() {
                    return this.items.filter(item => {
                        const matchSearch = item.name.toLowerCase().includes(this.searchQuery.toLowerCase()) || 
                                            item.sku.toLowerCase().includes(this.searchQuery.toLowerCase());
                        const matchCat = this.categoryFilter === 'all' || item.category === this.categoryFilter;
                        const matchStatus = this.statusFilter === 'all' || item.status === this.statusFilter;
                        return matchSearch && matchCat && matchStatus;
                    });
                },
                
                openAdjustModal(item = null) {
                    this.currentItem = item ? JSON.parse(JSON.stringify(item)) : null;
                    this.isAdjustModalOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                
                closeModal() {
                    this.isAdjustModalOpen = false;
                    document.body.style.overflow = '';
                },
                
                submitAdjustment() {
                    alert('Đã lưu biên bản kiểm kê và cập nhật tồn kho thực tế!');
                    this.closeModal();
                }
            }));
        });
    </script>
}
