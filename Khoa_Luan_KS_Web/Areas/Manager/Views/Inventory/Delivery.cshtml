@model Khoa_Luan_KS_Web.Areas.Manager.Controllers.ManagerDeliveryViewModel
@using Khoa_Luan_KS_Web.Services
@{
    ViewData["Title"] = "Điều phối giao hàng";
    Layout = "_LayoutManager";
    var deliveries = Model.Deliveries;
    var shippers = Model.Shippers;
    var stats = Model.Stats;

    string StatusBadge(string status) => (status ?? "").ToLowerInvariant() switch
    {
        "pending" => "bg-amber-50 text-amber-800 border-amber-200",
        "received" => "bg-blue-50 text-blue-800 border-blue-200",
        "in_transit" => "bg-indigo-50 text-indigo-800 border-indigo-200",
        "completed" => "bg-green-50 text-green-800 border-green-200",
        "failed" => "bg-red-50 text-red-800 border-red-200",
        "rejected" => "bg-slate-100 text-slate-600 border-slate-200",
        _ => "bg-slate-50 text-slate-600 border-slate-200",
    };

    string StatusBar(string status) => (status ?? "").ToLowerInvariant() switch
    {
        "pending" => "bg-amber-400",
        "received" => "bg-blue-500",
        "in_transit" => "bg-indigo-500",
        "completed" => "bg-green-500",
        "failed" => "bg-red-500",
        "rejected" => "bg-slate-400",
        _ => "bg-slate-300",
    };

    string BuildFilterUrl(string? statusOverride = null, bool? unassignedOverride = null)
    {
        var st = statusOverride ?? Model.StatusFilter;
        var ua = unassignedOverride ?? Model.UnassignedOnly;
        var q = $"/Manager/Inventory/Delivery?scheduledOn={Model.ScheduledOn:yyyy-MM-dd}";
        if (!string.IsNullOrWhiteSpace(st)) q += $"&status={Uri.EscapeDataString(st)}";
        if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) q += $"&search={Uri.EscapeDataString(Model.SearchTerm)}";
        if (ua) q += "&unassignedOnly=true";
        return q;
    }
}

<div class="p-4 md:p-6 lg:p-8 space-y-6 bg-slate-50 min-h-screen font-sans max-w-[1600px] mx-auto"
     x-data="deliveryBoard(@(deliveries.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(deliveries) : "[]"), @(shippers.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(shippers) : "[]"))">

    <!-- Header -->
    <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-black text-slate-800 tracking-tight">Điều phối giao hàng</h1>
            <p class="text-slate-500 mt-1 text-sm font-medium">Phân công shipper, theo dõi trạng thái chuyến giao theo ngày giao suất.</p>
        </div>
        <form method="get" class="flex flex-wrap items-end gap-2 bg-white border border-slate-200 rounded-2xl p-3 shadow-sm">
            <div>
                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Ngày giao</label>
                <input type="date" name="scheduledOn" value="@Model.ScheduledOn.ToString("yyyy-MM-dd")"
                       class="rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold" />
            </div>
            <div class="min-w-[140px]">
                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Trạng thái</label>
                <select name="status" class="rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold w-full">
                    <option value="">Tất cả</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending")">Chờ điều phối</option>
                    <option value="received" selected="@(Model.StatusFilter == "received")">Đã giao shipper</option>
                    <option value="in_transit" selected="@(Model.StatusFilter == "in_transit")">Đang giao</option>
                    <option value="completed" selected="@(Model.StatusFilter == "completed")">Đã giao</option>
                    <option value="failed" selected="@(Model.StatusFilter == "failed")">Thất bại</option>
                </select>
            </div>
            <div class="min-w-[180px] flex-1">
                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Tìm kiếm</label>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Đơn vị, địa chỉ, mã đơn..."
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" />
            </div>
            <label class="flex items-center gap-2 px-2 py-2 text-xs font-bold text-slate-600 cursor-pointer">
                <input type="checkbox" name="unassignedOnly" value="true" @(Model.UnassignedOnly ? "checked" : "")
                       class="rounded border-slate-300 text-green-600" />
                Chưa phân shipper
            </label>
            <button type="submit" class="px-4 py-2 rounded-xl bg-slate-900 text-white text-sm font-bold hover:bg-green-600 transition">
                Lọc
            </button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">@Model.ErrorMessage</div>
    }

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        <a href="@BuildFilterUrl("pending")" class="rounded-2xl border border-slate-200 bg-white p-4 hover:border-amber-300 transition shadow-sm">
            <p class="text-[10px] font-black uppercase text-amber-600">Chờ điều phối</p>
            <p class="text-2xl font-black text-slate-900 mt-1">@stats.Pending</p>
        </a>
        <a href="@BuildFilterUrl(null, true)" class="rounded-2xl border border-slate-200 bg-white p-4 hover:border-orange-300 transition shadow-sm">
            <p class="text-[10px] font-black uppercase text-orange-600">Chưa có shipper</p>
            <p class="text-2xl font-black text-slate-900 mt-1">@stats.Unassigned</p>
        </a>
        <a href="@BuildFilterUrl("in_transit")" class="rounded-2xl border border-slate-200 bg-white p-4 hover:border-indigo-300 transition shadow-sm">
            <p class="text-[10px] font-black uppercase text-indigo-600">Đang xử lý</p>
            <p class="text-2xl font-black text-slate-900 mt-1">@stats.InProgress</p>
        </a>
        <a href="@BuildFilterUrl("completed")" class="rounded-2xl border border-slate-200 bg-white p-4 hover:border-green-300 transition shadow-sm">
            <p class="text-[10px] font-black uppercase text-green-600">Đã giao xong</p>
            <p class="text-2xl font-black text-slate-900 mt-1">@stats.Completed</p>
        </a>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
        <!-- Danh sách chuyến -->
        <div class="xl:col-span-8 space-y-3">
            @if (!deliveries.Any())
            {
                <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-12 text-center">
                    <i class="fas fa-truck text-4xl text-slate-300 mb-3"></i>
                    <p class="font-bold text-slate-700">Không có chuyến giao trong ngày / bộ lọc này</p>
                    <p class="text-sm text-slate-500 mt-1">Thử đổi ngày giao hoặc xóa bộ lọc trạng thái.</p>
                </div>
            }
            else
            {
                @foreach (var d in deliveries)
                {
                    <article class="relative rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition group">
                        <div class="absolute left-0 top-0 bottom-0 w-1.5 @StatusBar(d.DeliveryStatus)"></div>
                        <div class="p-4 md:p-5 pl-5 flex flex-col lg:flex-row lg:items-start gap-4">
                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2 mb-2">
                                    <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded border @StatusBadge(d.DeliveryStatus)">
                                        @d.DeliveryStatusLabel
                                    </span>
                                    @if (!string.IsNullOrEmpty(d.InvoiceCode))
                                    {
                                        <span class="text-[10px] font-mono font-bold text-slate-500">@d.InvoiceCode</span>
                                    }
                                    <span class="text-[10px] font-bold text-slate-400">#@d.DeliveryId</span>
                                </div>
                                <h3 class="font-black text-slate-900 text-base">@d.OrganizationName</h3>
                                <p class="text-sm text-slate-600 mt-1 flex items-start gap-2">
                                    <i class="fas fa-map-marker-alt text-green-600 mt-0.5 shrink-0"></i>
                                    <span>@d.DeliveryAddress</span>
                                </p>
                                <div class="flex flex-wrap gap-3 mt-3 text-xs font-semibold text-slate-500">
                                    <span><i class="far fa-calendar mr-1"></i>@d.ScheduledDate.ToString("dd/MM/yyyy")</span>
                                    @if (!string.IsNullOrEmpty(d.PreferredDeliveryTime))
                                    {
                                        <span><i class="far fa-clock mr-1"></i>@d.PreferredDeliveryTime</span>
                                    }
                                    <span><i class="fas fa-utensils mr-1"></i>@d.MealCount suất</span>
                                </div>
                                @if (!string.IsNullOrEmpty(d.AssignedStaffName))
                                {
                                    <p class="mt-2 text-xs font-bold text-blue-700 bg-blue-50 inline-flex items-center gap-1.5 px-2 py-1 rounded-lg">
                                        <i class="fas fa-user"></i> @d.AssignedStaffName
                                        @if (!string.IsNullOrEmpty(d.AssignedStaffPhone))
                                        {
                                            <span class="font-normal text-blue-600">· @d.AssignedStaffPhone</span>
                                        }
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(d.Notes))
                                {
                                    <p class="mt-2 text-xs text-slate-500 italic border-l-2 border-slate-200 pl-2">@d.Notes</p>
                                }
                            </div>
                            <div class="flex flex-row lg:flex-col gap-2 shrink-0">
                                @if (d.DeliveryStatus is not "completed" and not "failed" and not "rejected")
                                {
                                    <button type="button"
                                            @@click="openAssign(@d.DeliveryId)"
                                            class="px-4 py-2 rounded-xl bg-green-600 text-white text-xs font-bold hover:bg-green-700 shadow-sm whitespace-nowrap">
                                        <i class="fas fa-user-plus mr-1"></i>
                                        @(d.AssignedStaffId.HasValue ? "Đổi shipper" : "Phân shipper")
                                    </button>
                                }
                                @if (!string.IsNullOrEmpty(d.ProofImageUrl))
                                {
                                    <a href="@d.ProofImageUrl" target="_blank" rel="noopener"
                                       class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-50 text-center">
                                        <i class="fas fa-image mr-1"></i> Ảnh giao
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        </div>

        <!-- Panel shipper -->
        <div class="xl:col-span-4 space-y-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sticky top-24">
                <h3 class="font-black text-slate-800 flex items-center gap-2 mb-4">
                    <i class="fas fa-motorcycle text-green-600"></i> Shipper khả dụng
                </h3>
                @if (!shippers.Any())
                {
                    <p class="text-sm text-slate-500">Chưa có tài khoản Shipper. Tạo user role Shipper trong quản trị người dùng.</p>
                }
                else
                {
                    <ul class="space-y-2 max-h-[320px] overflow-y-auto">
                        @foreach (var s in shippers)
                        {
                            <li class="flex items-center justify-between gap-2 rounded-xl border border-slate-100 bg-slate-50/80 px-3 py-2.5">
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-slate-800 truncate">@s.DisplayName</p>
                                    @if (!string.IsNullOrEmpty(s.PhoneNumber))
                                    {
                                        <p class="text-xs text-slate-500">@s.PhoneNumber</p>
                                    }
                                </div>
                                <span class="text-[10px] font-bold text-green-700 bg-green-50 px-2 py-0.5 rounded-full shrink-0">Sẵn sàng</span>
                            </li>
                        }
                    </ul>
                }
                <p class="text-[11px] text-slate-400 mt-4 leading-relaxed">
                    Sau khi phân shipper, trạng thái chuyển <strong>Đã giao shipper</strong>. Shipper cập nhật tiếp trên app vận chuyển.
                </p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-800 to-slate-900 p-5 text-white shadow-lg">
                <h4 class="font-bold text-sm mb-2"><i class="fas fa-route mr-2"></i>Quy trình</h4>
                <ol class="text-xs space-y-2 text-slate-300 list-decimal list-inside">
                    <li>Đơn checkout tạo chuyến giao (pending)</li>
                    <li>Manager phân shipper → received</li>
                    <li>Shipper bắt đầu giao → in_transit</li>
                    <li>Hoàn tất + ảnh chứng từ → completed</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- Modal phân shipper -->
    <div x-show="assignOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="assignOpen = false"></div>
        <div class="relative w-full max-w-md rounded-2xl bg-white shadow-2xl border border-slate-200 overflow-hidden" @@click.stop>
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 class="font-black text-lg text-slate-900">Phân shipper</h3>
                <button type="button" @@click="assignOpen = false" class="text-slate-400 hover:text-slate-600"><i class="fas fa-times"></i></button>
            </div>
            <form method="post" asp-action="AssignDelivery" class="p-6 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="deliveryId" :value="selectedDeliveryId" />
                <input type="hidden" name="scheduledOn" value="@Model.ScheduledOn.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="status" value="@Model.StatusFilter" />
                <input type="hidden" name="search" value="@Model.SearchTerm" />
                @if (Model.UnassignedOnly)
                {
                    <input type="hidden" name="unassignedOnly" value="true" />
                }
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1.5">Chọn shipper</label>
                    <select name="shipperUserId" required class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-semibold">
                        <option value="">-- Chọn shipper --</option>
                        @foreach (var s in shippers)
                        {
                            <option value="@s.UserId">@s.DisplayName @(!string.IsNullOrEmpty(s.PhoneNumber) ? $"({s.PhoneNumber})" : "")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1.5">Ghi chú (tuỳ chọn)</label>
                    <textarea name="notes" rows="2" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm resize-none" placeholder="VD: Giao trước 11h, gọi trước khi đến..."></textarea>
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="button" @@click="assignOpen = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 font-bold text-sm text-slate-600">Hủy</button>
                    <button type="submit" class="flex-1 py-2.5 rounded-xl bg-green-600 text-white font-bold text-sm hover:bg-green-700">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('deliveryBoard', (deliveries, shippers) => ({
            deliveries,
            shippers,
            assignOpen: false,
            selectedDeliveryId: null,
            openAssign(id) {
                this.selectedDeliveryId = id;
                this.assignOpen = true;
                document.body.style.overflow = 'hidden';
            },
        }));
    });
</script>
<style>[x-cloak]{display:none!important}</style>
}
