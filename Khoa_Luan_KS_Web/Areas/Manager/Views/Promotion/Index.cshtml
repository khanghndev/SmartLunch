@model Khoa_Luan_KS_Web.Services.GetPromotionsClientResponse
@using System.Text.Json
@{
    ViewData["Title"] = "Quản lý khuyến mãi";
    Layout = "_LayoutManager";
    var items = Model.Data ?? new();
    string search = ViewBag.SearchTerm ?? "";
    string scope = ViewBag.ScopeType ?? "";
    bool? isActiveFilter = ViewBag.IsActiveFilter as bool?;
    int currentPage = ViewBag.Page ?? Model.Page;
    if (currentPage < 1) currentPage = 1;
    int pageSize = ViewBag.PageSize ?? Model.PageSize;
    if (pageSize < 1) pageSize = 20;
    int totalPages = Model.PageSize > 0 ? Math.Max(1, (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)) : 1;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var soon = today.AddDays(7);

    int activeOnPage = items.Count(p => p.IsActive);
    int expiringOnPage = items.Count(p => p.IsActive && p.ValidTo >= today && p.ValidTo <= soon);
    int percentOnPage = items.Count(p => p.DiscountType == "percent");

    string ScopeLabel(string? s) => s switch
    {
        "dish" => "Theo món",
        "order_quantity" => "Theo SL đơn",
        "customer" => "Theo khách",
        _ => s ?? "—"
    };
    string ChannelLabel(string? c) => c switch
    {
        "b2c" => "B2C",
        "b2b_org" => "B2B",
        "all" => "Tất cả kênh",
        _ => c ?? "—"
    };
    string DiscountText(Khoa_Luan_KS_Web.Services.PromotionClientDto p) =>
        p.DiscountType == "percent" ? $"{p.DiscountValue:N0}%" : $"{p.DiscountValue:N0} đ";

    string FilterQuery(int page)
    {
        var q = $"?page={page}&pageSize={pageSize}&searchTerm={Uri.EscapeDataString(search)}";
        if (!string.IsNullOrEmpty(scope)) q += $"&scopeType={Uri.EscapeDataString(scope)}";
        if (isActiveFilter.HasValue) q += $"&isActive={isActiveFilter.Value.ToString().ToLowerInvariant()}";
        return q;
    }
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans -m-4 sm:-m-6" x-data="promotionList()">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Quản lý Khuyến Mãi</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Cấu hình mã giảm giá, ưu đãi theo món, đơn hàng và khách hàng B2B/B2C.</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Manager/Promotion/Create"
               class="px-5 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Thêm khuyến mãi
            </a>
            <a href="/Manager/Promotion/Create"
               class="px-5 py-2 bg-slate-800 text-white font-bold rounded-xl shadow-lg hover:bg-slate-900 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                Tạo chương trình mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="flex items-center gap-3 rounded-2xl border border-green-200 bg-green-50 px-5 py-3.5 text-sm font-medium text-green-800 shadow-sm">
            <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            @ok
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="flex items-center gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-3.5 text-sm font-medium text-red-800 shadow-sm">
            <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            @err
        </div>
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between group hover:border-green-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Tổng chương trình</p>
                <p class="text-2xl font-black text-slate-800">@Model.TotalCount</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center group-hover:bg-green-100 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between group hover:border-green-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Đang hoạt động</p>
                <p class="text-2xl font-black text-green-600">@activeOnPage</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center group-hover:bg-green-100 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between group hover:border-yellow-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Sắp hết hạn (7 ngày)</p>
                <p class="text-2xl font-black text-slate-800">@expiringOnPage</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-yellow-50 text-yellow-500 flex items-center justify-center group-hover:bg-yellow-100 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex items-center justify-between group hover:border-blue-300 transition-colors">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Giảm theo %</p>
                <p class="text-2xl font-black text-slate-800">@percentOnPage</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center group-hover:bg-blue-100 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <form method="get" class="p-4 border-b border-slate-100 flex flex-col sm:flex-row gap-4 justify-between items-center bg-slate-50/50">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="flex flex-wrap items-center gap-3 w-full">
                <div class="relative w-full sm:w-72">
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" name="searchTerm" value="@search" placeholder="Tìm tên hoặc mã khuyến mãi..."
                           class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all" />
                </div>

                <select name="scopeType" class="w-full sm:w-auto bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                    <option value="">Tất cả phạm vi</option>
                    <option value="dish" selected="@(scope == "dish")">Theo món</option>
                    <option value="order_quantity" selected="@(scope == "order_quantity")">Theo số lượng đơn</option>
                    <option value="customer" selected="@(scope == "customer")">Theo khách hàng</option>
                </select>

                <select name="isActive" class="w-full sm:w-auto bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(isActiveFilter == true)">Đang hoạt động</option>
                    <option value="false" selected="@(isActiveFilter == false)">Đã tắt</option>
                </select>

                <button type="submit" class="px-5 py-2 bg-green-600 text-white font-bold rounded-xl shadow-sm hover:bg-green-700 transition-all text-sm">
                    Lọc
                </button>
            </div>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-wider text-slate-400 font-black">
                        <th class="p-4 pl-6">Mã / Tên chương trình</th>
                        <th class="p-4">Phạm vi & Kênh</th>
                        <th class="p-4 text-center">Giảm giá</th>
                        <th class="p-4 text-center">Ưu tiên</th>
                        <th class="p-4">Hiệu lực</th>
                        <th class="p-4 text-center">Trạng thái</th>
                        <th class="p-4 pr-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 text-sm">
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="7" class="p-16 text-center">
                                <div class="flex flex-col items-center gap-3 text-slate-400">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center">
                                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                                    </div>
                                    <p class="font-bold text-slate-500">Chưa có chương trình khuyến mãi nào</p>
                                    <a href="/Manager/Promotion/Create" class="text-sm font-bold text-green-600 hover:text-green-700">+ Tạo khuyến mãi đầu tiên</a>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var p in items)
                    {
                        var isExpiring = p.IsActive && p.ValidTo >= today && p.ValidTo <= soon;
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <td class="p-4 pl-6">
                                @if (!string.IsNullOrEmpty(p.Code))
                                {
                                    <span class="inline-block font-black text-green-700 text-xs bg-green-50 border border-green-100 px-2 py-0.5 rounded-lg mb-1">@p.Code</span>
                                    <br />
                                }
                                <div class="font-bold text-slate-800">@p.Name</div>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="text-xs text-slate-500 font-medium mt-0.5 line-clamp-1 max-w-[240px]">@p.Description</div>
                                }
                            </td>
                            <td class="p-4">
                                <div class="font-bold text-slate-800">@ScopeLabel(p.ScopeType)</div>
                                <div class="text-xs text-slate-500 font-medium mt-0.5">@ChannelLabel(p.Channel)</div>
                            </td>
                            <td class="p-4 text-center">
                                <span class="font-black text-orange-600">@DiscountText(p)</span>
                            </td>
                            <td class="p-4 text-center">
                                <span class="text-xs font-black bg-slate-100 text-slate-600 px-2 py-1 rounded-lg">@p.Priority</span>
                            </td>
                            <td class="p-4">
                                <div class="font-bold text-slate-700">@p.ValidFrom.ToString("dd/MM/yyyy")</div>
                                <div class="text-xs font-medium @(isExpiring ? "text-yellow-600" : "text-slate-500")">
                                    → @p.ValidTo.ToString("dd/MM/yyyy")
                                    @if (isExpiring) { <span class="ml-1 font-bold">· Sắp hết</span> }
                                </div>
                            </td>
                            <td class="p-4 text-center">
                                @if (p.IsActive)
                                {
                                    <span class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-lg border bg-green-50 text-green-600 border-green-200">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-lg border bg-slate-100 text-slate-600 border-slate-200">Đã tắt</span>
                                }
                            </td>
                            <td class="p-4 pr-6">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="/Manager/Promotion/Detail/@p.Id" title="Chi tiết"
                                       class="p-2 text-slate-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                    </a>
                                    <a href="/Manager/Promotion/Edit/@p.Id" title="Sửa"
                                       class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </a>
                                    <button type="button" title="Vô hiệu hóa"
                                            @@click="openDelete(@p.Id, @Html.Raw(JsonSerializer.Serialize(p.Name)))"
                                            class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm">
            <span class="text-slate-500 font-medium">
                Hiển thị <span class="font-bold text-slate-700">@items.Count</span> / <span class="font-bold text-slate-700">@Model.TotalCount</span> chương trình
                @if (totalPages > 1)
                {
                    <span class="text-slate-400"> · Trang @currentPage/@totalPages</span>
                }
            </span>
            @if (totalPages > 1)
            {
                <div class="flex gap-1 flex-wrap justify-center">
                    @if (currentPage > 1)
                    {
                        <a href="@FilterQuery(currentPage - 1)" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium transition-colors">Trước</a>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-300 cursor-not-allowed font-medium">Trước</span>
                    }
                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);
                    }
                    @for (int pg = startPage; pg <= endPage; pg++)
                    {
                        if (pg == currentPage)
                        {
                            <span class="px-3 py-1.5 rounded-lg border border-green-500 bg-green-50 text-green-700 font-bold">@pg</span>
                        }
                        else
                        {
                            <a href="@FilterQuery(pg)" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium transition-colors">@pg</a>
                        }
                    }
                    @if (currentPage < totalPages)
                    {
                        <a href="@FilterQuery(currentPage + 1)" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium transition-colors">Tiếp</a>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-300 cursor-not-allowed font-medium">Tiếp</span>
                    }
                </div>
            }
        </div>
    </div>

    <div x-show="deleteOpen" style="display: none;" class="relative z-50" aria-modal="true" role="dialog">
        <div x-show="deleteOpen"
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="closeDelete()"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div x-show="deleteOpen"
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
                     class="relative w-full max-w-md transform overflow-hidden rounded-[32px] bg-white shadow-2xl" @@click.stop>
                    <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/50">
                        <h2 class="text-xl font-black text-slate-800">Vô hiệu hóa khuyến mãi?</h2>
                        <p class="text-sm text-slate-500 font-medium mt-2">Chương trình <span class="font-bold text-slate-700" x-text="deleteName"></span> sẽ không còn áp dụng cho đơn mới.</p>
                    </div>
                    <div class="px-8 py-5 flex justify-end gap-3">
                        <button type="button" @@click="closeDelete()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-white border border-slate-200 transition-colors text-sm shadow-sm">Hủy</button>
                        <form method="post" :action="'/Manager/Promotion/Delete/' + deleteId" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-6 py-2.5 rounded-xl bg-red-600 text-white font-bold hover:bg-red-700 transition-colors text-sm shadow-lg shadow-red-600/30">
                                Xác nhận vô hiệu hóa
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('promotionList', () => ({
                deleteOpen: false,
                deleteId: null,
                deleteName: '',

                openDelete(id, name) {
                    this.deleteId = id;
                    this.deleteName = name;
                    this.deleteOpen = true;
                    document.body.style.overflow = 'hidden';
                },

                closeDelete() {
                    this.deleteOpen = false;
                    document.body.style.overflow = '';
                }
            }));
        });
    </script>
}
