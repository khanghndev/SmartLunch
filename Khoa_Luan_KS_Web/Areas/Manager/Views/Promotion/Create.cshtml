@model Khoa_Luan_KS_Web.Areas.Manager.Controllers.PromotionFormVm
@{
    ViewData["Title"] = "Thêm khuyến mãi";
    Layout = "_LayoutManager";
}

<div x-data="{ scopeType: '@Model.ScopeType' }" class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans -m-4 sm:-m-6">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <nav class="mb-2 flex flex-wrap items-center gap-1.5 text-xs font-medium text-slate-400">
                <a href="/Manager/Home/Index" class="hover:text-green-600 transition-colors">Trang chủ</a>
                <span class="opacity-40">/</span>
                <a href="/Manager/Promotion/Index" class="hover:text-green-600 transition-colors">Khuyến mãi</a>
                <span class="opacity-40">/</span>
                <span class="text-slate-600">Thêm mới</span>
            </nav>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Thêm Khuyến Mãi</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Tạo chương trình giảm giá mới cho đơn hàng B2B/B2C.</p>
        </div>
        <a href="/Manager/Promotion/Index"
           class="px-5 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2 text-sm w-fit">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Quay lại danh sách
        </a>
    </div>

    <form method="post" class="grid gap-6 lg:grid-cols-[1fr_300px]">
        @Html.AntiForgeryToken()

        <div class="min-w-0 space-y-6">
            <partial name="_Form" model="Model" />

            <div class="flex flex-col-reverse items-stretch justify-end gap-3 rounded-[24px] border border-slate-100 bg-white px-6 py-5 shadow-sm sm:flex-row sm:items-center">
                <a href="/Manager/Promotion/Index"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-600 transition hover:bg-slate-50 shadow-sm">
                    Hủy
                </a>
                <button type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-green-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-green-600/30 transition hover:bg-green-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Lưu khuyến mãi
                </button>
            </div>
        </div>

        <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
            <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm p-6">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                    </div>
                    <h3 class="text-sm font-black text-slate-800">Gợi ý nhanh</h3>
                </div>
                <ul class="space-y-3 text-xs font-medium text-slate-600 leading-relaxed">
                    <li class="flex gap-2">
                        <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        <span><span class="font-bold text-slate-800">Ưu tiên cao</span> được xét trước khi nhiều KM cùng áp dụng.</span>
                    </li>
                    <li class="flex gap-2">
                        <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        <span>Chế độ <span class="font-bold text-slate-800">Tốt nhất</span> chọn mức giảm cao nhất cho khách.</span>
                    </li>
                    <li class="flex gap-2">
                        <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        <span>Mã KM để khách nhập khi thanh toán (không bắt buộc).</span>
                    </li>
                </ul>
            </div>

            <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm p-6">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-sm font-black text-slate-800">Phạm vi đã chọn</h3>
                </div>
                <div x-show="scopeType === 'dish'" x-cloak class="text-xs font-medium text-slate-600">
                    <p class="font-bold text-slate-800 mb-1">Theo món</p>
                    <p>Áp dụng khi đơn có món trong danh sách (<code class="rounded-lg bg-slate-100 px-1.5 py-0.5 font-mono text-slate-700">dish:id</code>).</p>
                </div>
                <div x-show="scopeType === 'order_quantity'" x-cloak class="text-xs font-medium text-slate-600">
                    <p class="font-bold text-slate-800 mb-1">Theo số lượng đơn</p>
                    <p>Kiểm tra SL đơn tối thiểu và giá trị đơn trước khi giảm.</p>
                </div>
                <div x-show="scopeType === 'customer'" x-cloak class="text-xs font-medium text-slate-600">
                    <p class="font-bold text-slate-800 mb-1">Theo khách / hợp đồng</p>
                    <p>Lọc theo <code class="rounded-lg bg-slate-100 px-1.5 py-0.5 font-mono text-slate-700">organization:id</code> hoặc <code class="rounded-lg bg-slate-100 px-1.5 py-0.5 font-mono text-slate-700">contract_type:...</code>.</p>
                </div>
            </div>

            <div class="bg-slate-800 rounded-[24px] p-6 text-white shadow-lg">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Lưu ý</p>
                <p class="text-sm font-medium text-slate-300">Bật <span class="text-white font-bold">Đang hoạt động</span> ở cuối form để KM có hiệu lực ngay sau khi lưu.</p>
            </div>
        </aside>
    </form>
</div>
