@model Khoa_Luan_KS_Web.Services.GetWeeklyMenuDetailClientResponse
@using System.Globalization
@{
    ViewData["Title"] = "Chi tiết thực đơn tuần";
    Layout = "_LayoutManager";

    var menu = Model?.WeeklyMenu;
    var schedules = Model?.Schedules ?? new List<Khoa_Luan_KS_Web.Services.WeeklyMenuScheduleDetailClientDto>();
    var returnUrl = Url.Action("Weekly", "Menu", new { area = "Manager" }) ?? "/Manager/Menu/Weekly";
    var vi = new CultureInfo("vi-VN");

    var byDate = schedules
        .GroupBy(s => s.Date.Date)
        .OrderBy(g => g.Key)
        .ToList();

    var allSlots = schedules
        .Select(s => s.MealSlot)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    var dayCount = menu != null ? (menu.EndDate.Date - menu.StartDate.Date).Days + 1 : 0;
    var uniqueDishes = schedules.Select(s => s.DishId).Distinct().Count();
    var avgPrice = schedules.Count > 0 ? schedules.Average(s => (double)s.Dish.Price) : 0;
    var isCurrent = menu != null && menu.StartDate.Date <= DateTime.Today && menu.EndDate.Date >= DateTime.Today;
    var isPast = menu != null && menu.EndDate.Date < DateTime.Today;
    var cover = menu?.Images?.FirstOrDefault(i => i.Role == "cover")?.Url
                  ?? menu?.Images?.FirstOrDefault()?.Url
                  ?? menu?.ImageUrl;
    var defaultDishImg = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&h=300&fit=crop";

    static string SlotColor(string slot) => slot?.ToLower() switch
    {
        "breakfast" => "bg-orange-100 text-orange-800 border-orange-200",
        "lunch" => "bg-green-100 text-green-800 border-green-200",
        "dinner" => "bg-indigo-100 text-indigo-800 border-indigo-200",
        "snack" => "bg-amber-100 text-amber-800 border-amber-200",
        _ => "bg-slate-100 text-slate-700 border-slate-200"
    };

    static string SlotDot(string slot) => slot?.ToLower() switch
    {
        "breakfast" => "bg-orange-500",
        "lunch" => "bg-green-500",
        "dinner" => "bg-indigo-500",
        "snack" => "bg-amber-400",
        _ => "bg-slate-400"
    };

    static string SlotLabel(string slot) => slot?.ToLower() switch
    {
        "breakfast" => "Sáng",
        "lunch" => "Trưa",
        "dinner" => "Chiều / Tối",
        "snack" => "Bữa phụ",
        _ => slot ?? "—"
    };

    static string DayShort(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday => "T2",
        DayOfWeek.Tuesday => "T3",
        DayOfWeek.Wednesday => "T4",
        DayOfWeek.Thursday => "T5",
        DayOfWeek.Friday => "T6",
        DayOfWeek.Saturday => "T7",
        DayOfWeek.Sunday => "CN",
        _ => "?"
    };
}

@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-3.5 text-sm font-semibold text-red-800 shadow-sm">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600"><i class="fas fa-circle-exclamation"></i></span>
        @TempData["Error"]
    </div>
}

<div class="space-y-6 animate-in fade-in duration-700" x-data="{ activeDay: 'all', activeSlot: 'all', view: 'cards' }">

    <!-- Breadcrumb -->
    <nav class="flex text-xs font-bold uppercase tracking-widest text-slate-400" aria-label="Breadcrumb">
        <ol class="inline-flex flex-wrap items-center gap-2">
            <li>
                <a href="@returnUrl" class="flex items-center gap-2 transition-colors hover:text-green-600">
                    <i class="fas fa-calendar-week"></i> Thực đơn tuần
                </a>
            </li>
            <li><i class="fas fa-chevron-right text-[8px] opacity-50"></i></li>
            <li class="text-slate-900">Chi tiết #@(menu?.Id ?? 0)</li>
        </ol>
    </nav>

    @if (menu == null)
    {
        <div class="rounded-3xl border border-slate-200 bg-white p-16 text-center shadow-sm">
            <i class="fas fa-calendar-xmark mb-4 text-5xl text-slate-200"></i>
            <p class="font-semibold text-slate-500">Không tìm thấy thực đơn.</p>
            <a href="@returnUrl" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-green-600 hover:text-green-700">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    }
    else
    {
        <!-- Hero -->
        <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
            @if (!string.IsNullOrEmpty(cover))
            {
                <div class="absolute inset-0">
                    <img src="@cover" alt="" class="h-full w-full object-cover opacity-20" />
                    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/95 to-white/80"></div>
                </div>
            }
            else
            {
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-green-50/90 via-white to-emerald-50/40"></div>
                <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-green-100/50 blur-3xl"></div>
            }

            <div class="relative z-10 p-6 md:p-8">
                <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                    <div class="min-w-0 flex-1">
                        <div class="mb-3 flex flex-wrap items-center gap-2">
                            @if (isCurrent)
                            {
                                <span class="inline-flex items-center gap-1.5 rounded-lg border border-green-200 bg-green-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-tighter text-green-700">
                                    <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"></span> Tuần hiện tại
                                </span>
                            }
                            else if (isPast)
                            {
                                <span class="rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-tighter text-slate-600">Đã qua</span>
                            }
                            else
                            {
                                <span class="rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-tighter text-sky-700">Sắp diễn ra</span>
                            }
                            <span class="rounded-lg bg-slate-900 px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-white">#@menu.Id</span>
                        </div>
                        <p class="text-[11px] font-black uppercase tracking-[0.2em] text-green-600">Thực đơn tuần</p>
                        <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl md:text-4xl">
                            @menu.StartDate.ToString("dd/MM/yyyy") – @menu.EndDate.ToString("dd/MM/yyyy")
                        </h1>
                        @if (!string.IsNullOrWhiteSpace(menu.Description))
                        {
                            <p class="mt-3 max-w-2xl text-sm font-medium leading-relaxed text-slate-600">@menu.Description</p>
                        }
                        @if (allSlots.Any())
                        {
                            <div class="mt-4 flex flex-wrap gap-2">
                                @foreach (var slot in allSlots)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold @SlotColor(slot)">
                                        <span class="h-2 w-2 rounded-full @SlotDot(slot)"></span>
                                        @SlotLabel(slot)
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="flex shrink-0 flex-col gap-2 sm:flex-row lg:flex-col">
                        <a href="@returnUrl"
                           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition-all hover:border-green-200 hover:bg-green-50 hover:text-green-800">
                            <i class="fas fa-arrow-left"></i> Danh sách
                        </a>
                    </div>
                </div>

                <!-- KPI strip -->
                <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    <div class="rounded-2xl border border-slate-100 bg-white/80 p-4 shadow-sm backdrop-blur-sm">
                        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Số ngày</p>
                        <p class="mt-1 text-2xl font-black text-slate-900">@dayCount</p>
                    </div>
                    <div class="rounded-2xl border border-slate-100 bg-white/80 p-4 shadow-sm backdrop-blur-sm">
                        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Tổng lịch món</p>
                        <p class="mt-1 text-2xl font-black text-green-600">@schedules.Count</p>
                    </div>
                    <div class="rounded-2xl border border-slate-100 bg-white/80 p-4 shadow-sm backdrop-blur-sm">
                        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Món khác nhau</p>
                        <p class="mt-1 text-2xl font-black text-slate-900">@uniqueDishes</p>
                    </div>
                    <div class="rounded-2xl border border-green-100 bg-green-50/80 p-4 shadow-sm">
                        <p class="text-[9px] font-black uppercase tracking-widest text-green-700/80">Giá TB / món</p>
                        <p class="mt-1 text-2xl font-black text-green-700">@avgPrice.ToString("N0")<span class="text-sm font-bold">đ</span></p>
                    </div>
                </div>
            </div>
        </div>

        @if (!schedules.Any())
        {
            <div class="rounded-3xl border border-dashed border-slate-200 bg-white p-16 text-center shadow-sm">
                <i class="fas fa-utensils mb-4 text-5xl text-slate-200"></i>
                <p class="font-semibold text-slate-600">Chưa có lịch món trong thực đơn này</p>
                <p class="mt-1 text-sm text-slate-400">Thêm món vào lịch từ module quản lý thực đơn.</p>
            </div>
        }
        else
        {
            <!-- Toolbar: filters + view toggle -->
            <div class="sticky top-0 z-20 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-sm backdrop-blur-md">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
                        <button type="button" @@click="activeDay = 'all'"
                                :class="activeDay === 'all' ? 'border-green-600 bg-green-600 text-white shadow-md shadow-green-500/25' : 'border-slate-200 bg-slate-50 text-slate-700 hover:border-green-300'"
                                class="shrink-0 rounded-full border px-4 py-2 text-xs font-bold transition">
                            Tất cả ngày
                        </button>
                        @foreach (var group in byDate)
                        {
                            var dayKey = group.Key.ToString("yyyy-MM-dd");
                            var isToday = group.Key == DateTime.Today;
                            <button type="button" @@click="activeDay = '@dayKey'"
                                    :class="activeDay === '@dayKey' ? 'border-green-600 bg-green-600 text-white shadow-md shadow-green-500/25' : 'border-slate-200 bg-slate-50 text-slate-700 hover:border-green-300'"
                                    class="shrink-0 rounded-full border px-4 py-2 text-xs font-bold transition">
                                @DayShort(group.Key) @group.Key.ToString("dd/MM")
                                @if (isToday) { <span class="ml-1 opacity-90">· Hôm nay</span> }
                            </button>
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        @if (allSlots.Count > 1)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                <button type="button" @@click="activeSlot = 'all'"
                                        :class="activeSlot === 'all' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'"
                                        class="rounded-lg px-3 py-1.5 text-[10px] font-black uppercase tracking-wide transition">
                                    Tất cả ca
                                </button>
                                @foreach (var slot in allSlots)
                                {
                                    <button type="button" @@click="activeSlot = '@slot'"
                                            :class="activeSlot === '@slot' ? 'bg-green-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-green-50'"
                                            class="rounded-lg px-3 py-1.5 text-[10px] font-black uppercase tracking-wide transition">
                                        @SlotLabel(slot)
                                    </button>
                                }
                            </div>
                        }
                        <div class="flex rounded-xl border border-slate-200 bg-slate-50 p-1">
                            <button type="button" @@click="view = 'cards'"
                                    :class="view === 'cards' ? 'bg-white text-green-700 shadow-sm' : 'text-slate-500'"
                                    class="rounded-lg px-3 py-1.5 text-xs font-bold transition" title="Dạng thẻ">
                                <i class="fas fa-grip"></i>
                            </button>
                            <button type="button" @@click="view = 'matrix'"
                                    :class="view === 'matrix' ? 'bg-white text-green-700 shadow-sm' : 'text-slate-500'"
                                    class="rounded-lg px-3 py-1.5 text-xs font-bold transition" title="Bảng tuần">
                                <i class="fas fa-table-cells"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card view by day -->
            <div x-show="view === 'cards'" class="space-y-6">
                @foreach (var group in byDate)
                {
                    var dayKey = group.Key.ToString("yyyy-MM-dd");
                    var isToday = group.Key == DateTime.Today;
                    var dayList = group.ToList();

                    <section x-show="activeDay === 'all' || activeDay === '@dayKey'" x-cloak
                             class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
                        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-green-50/30 px-5 py-4 sm:px-6">
                            <div class="flex items-center gap-4">
                                <div class="flex h-14 w-14 flex-col items-center justify-center rounded-2xl font-black @(isToday ? "bg-green-600 text-white shadow-lg shadow-green-500/30" : "bg-green-50 text-green-800 ring-1 ring-green-100")">
                                    <span class="text-lg leading-none">@DayShort(group.Key)</span>
                                    <span class="mt-0.5 text-[10px] font-bold opacity-90">@group.Key.ToString("dd/MM")</span>
                                </div>
                                <div>
                                    <h2 class="text-lg font-black capitalize text-slate-900 sm:text-xl">
                                        @group.Key.ToString("dddd", vi)
                                    </h2>
                                    <p class="text-xs font-medium text-slate-500">@dayList.Count món trong ngày</p>
                                </div>
                            </div>
                            @if (isToday)
                            {
                                <span class="rounded-full bg-orange-100 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-orange-700">Hôm nay</span>
                            }
                        </header>

                        <div class="p-5 sm:p-6">
                            @{
                                var slotGroups = dayList
                                    .GroupBy(s => s.MealSlot)
                                    .OrderBy(g => allSlots.IndexOf(g.Key))
                                    .ToList();
                            }
                            @foreach (var slotGroup in slotGroups)
                            {
                                <div x-show="activeSlot === 'all' || activeSlot === '@slotGroup.Key'" class="mb-8 last:mb-0">
                                    @if (allSlots.Count > 1)
                                    {
                                        <div class="mb-4 flex items-center gap-2">
                                            <span class="inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-[10px] font-black uppercase tracking-wider @SlotColor(slotGroup.Key)">
                                                <span class="h-2 w-2 rounded-full @SlotDot(slotGroup.Key)"></span>
                                                @SlotLabel(slotGroup.Key)
                                            </span>
                                            <span class="h-px flex-1 bg-slate-100"></span>
                                            <span class="text-[10px] font-bold text-slate-400">@slotGroup.Count() món</span>
                                        </div>
                                    }

                                    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
                                        @foreach (var s in slotGroup)
                                        {
                                            var img = !string.IsNullOrEmpty(s.Dish.ImageUrl) ? s.Dish.ImageUrl : defaultDishImg;
                                            <li class="group flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-all hover:border-green-200 hover:shadow-lg">
                                                <a href="/Manager/Catalog/MealDetail/@s.Dish.Id" class="relative block aspect-[4/3] overflow-hidden bg-slate-100">
                                                    <img src="@img" alt="@s.Dish.Name" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
                                                    <span class="absolute left-2 top-2 rounded-md bg-black/50 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white backdrop-blur-sm">
                                                        @SlotLabel(s.MealSlot)
                                                    </span>
                                                </a>
                                                <div class="flex flex-1 flex-col p-4">
                                                    <a href="/Manager/Catalog/MealDetail/@s.Dish.Id"
                                                       class="line-clamp-2 text-sm font-black leading-snug text-slate-900 transition hover:text-green-600">
                                                        @s.Dish.Name
                                                    </a>
                                                    @if (!string.IsNullOrEmpty(s.Dish.Category))
                                                    {
                                                        <p class="mt-1 line-clamp-1 text-[11px] font-semibold text-slate-500">@s.Dish.Category</p>
                                                    }
                                                    <div class="mt-auto flex items-center justify-between gap-2 pt-3">
                                                        <span class="text-base font-black text-green-600">@s.Dish.Price.ToString("N0")đ</span>
                                                        <a href="/Manager/Catalog/MealDetail/@s.Dish.Id"
                                                           class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-2.5 py-1.5 text-[10px] font-bold text-slate-600 transition hover:border-green-300 hover:bg-green-50 hover:text-green-700">
                                                            <i class="fas fa-eye"></i> Chi tiết
                                                        </a>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(s.Code))
                                                    {
                                                        <p class="mt-2 font-mono text-[10px] text-slate-400">@s.Code</p>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>

            <!-- Matrix view -->
            <div x-show="view === 'matrix'" x-cloak class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 bg-slate-50/80 px-5 py-4">
                    <h2 class="flex items-center gap-2 text-sm font-black uppercase tracking-widest text-slate-800">
                        <i class="fas fa-table-cells text-green-600"></i> Ma trận tuần
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[720px] border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 bg-slate-50/50">
                                <th class="w-28 p-4 text-left text-[10px] font-black uppercase tracking-widest text-slate-500">Ngày</th>
                                @foreach (var slot in allSlots)
                                {
                                    <th class="p-4 text-left" x-show="activeSlot === 'all' || activeSlot === '@slot'">
                                        <span class="inline-flex items-center gap-1.5 rounded-lg border px-2 py-1 text-[10px] font-black uppercase @SlotColor(slot)">
                                            <span class="h-1.5 w-1.5 rounded-full @SlotDot(slot)"></span>
                                            @SlotLabel(slot)
                                        </span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var group in byDate)
                            {
                                var dayKey = group.Key.ToString("yyyy-MM-dd");
                                var isToday = group.Key == DateTime.Today;
                                var daySchedules = group.ToList();

                                <tr x-show="activeDay === 'all' || activeDay === '@dayKey'" class="@(isToday ? "bg-green-50/40" : "hover:bg-slate-50/50")">
                                    <td class="border-r border-slate-100 p-4 align-top">
                                        <p class="text-sm font-black text-slate-900">@DayShort(group.Key)</p>
                                        <p class="text-xs text-slate-500">@group.Key.ToString("dd/MM/yyyy")</p>
                                        @if (isToday)
                                        {
                                            <span class="mt-1 inline-block rounded-full bg-green-600 px-2 py-0.5 text-[9px] font-black text-white">Hôm nay</span>
                                        }
                                    </td>
                                    @foreach (var slot in allSlots)
                                    {
                                        var slotDishes = daySchedules.Where(s => s.MealSlot == slot).ToList();
                                        <td class="p-3 align-top" x-show="activeSlot === 'all' || activeSlot === '@slot'">
                                            @if (!slotDishes.Any())
                                            {
                                                <span class="text-xs italic text-slate-300">—</span>
                                            }
                                            else
                                            {
                                                <div class="space-y-2">
                                                    @foreach (var schedule in slotDishes)
                                                    {
                                                        <a href="/Manager/Catalog/MealDetail/@schedule.Dish.Id"
                                                           class="flex items-center gap-2 rounded-xl border border-slate-100 bg-white p-2 shadow-sm transition hover:border-green-200 hover:shadow-md">
                                                            @{
                                                                var thumb = !string.IsNullOrEmpty(schedule.Dish.ImageUrl) ? schedule.Dish.ImageUrl : defaultDishImg;
                                                            }
                                                            <img src="@thumb" alt="" class="h-10 w-10 shrink-0 rounded-lg object-cover" />
                                                            <div class="min-w-0">
                                                                <p class="truncate text-xs font-bold text-slate-800">@schedule.Dish.Name</p>
                                                                <p class="text-[10px] font-black text-green-600">@schedule.Dish.Price.ToString("N0")đ</p>
                                                            </div>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <p class="text-center text-[11px] text-slate-400">
                <i class="far fa-clock mr-1"></i>
                Tạo lúc @menu.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </p>
        }
    }
</div>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    [x-cloak] { display: none !important; }
</style>
