@model Khoa_Luan_KS_Web.Services.GetWeeklyMenuDetailClientResponse
@{
    ViewData["Title"] = "Chi Tiết Thực Đơn Tuần";
    Layout = "_LayoutManager";

    var menu = Model?.WeeklyMenu;
    var schedules = Model?.Schedules ?? new List<Khoa_Luan_KS_Web.Services.WeeklyMenuScheduleDetailClientDto>();

    // Nhóm schedule theo ngày
    var byDate = schedules
        .GroupBy(s => s.Date.Date)
        .OrderBy(g => g.Key)
        .ToList();

    // Lấy tất cả các MealSlot có trong menu này (để render header cột)
    var allSlots = schedules
        .Select(s => s.MealSlot)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    // Mapping màu cho MealSlot
    static string SlotColor(string slot) => slot?.ToLower() switch
    {
        "breakfast" => "bg-orange-100 text-orange-700 border-orange-200",
        "lunch"     => "bg-green-100 text-green-700 border-green-200",
        "dinner"    => "bg-indigo-100 text-indigo-700 border-indigo-200",
        "snack"     => "bg-amber-100 text-amber-700 border-amber-200",
        _           => "bg-slate-100 text-slate-700 border-slate-200"
    };

    static string SlotDot(string slot) => slot?.ToLower() switch
    {
        "breakfast" => "bg-orange-400",
        "lunch"     => "bg-green-500",
        "dinner"    => "bg-indigo-500",
        "snack"     => "bg-amber-400",
        _           => "bg-slate-400"
    };

    static string SlotLabel(string slot) => slot?.ToLower() switch
    {
        "breakfast" => "Sáng",
        "lunch"     => "Trưa",
        "dinner"    => "Chiều / Tối",
        "snack"     => "Bữa phụ",
        _           => slot
    };

    static string DayLabel(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday    => "Thứ 2",
        DayOfWeek.Tuesday   => "Thứ 3",
        DayOfWeek.Wednesday => "Thứ 4",
        DayOfWeek.Thursday  => "Thứ 5",
        DayOfWeek.Friday    => "Thứ 6",
        DayOfWeek.Saturday  => "Thứ 7",
        DayOfWeek.Sunday    => "Chủ nhật",
        _                   => d.DayOfWeek.ToString()
    };
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans">

    <!-- BACK & HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <a href="/Manager/Menu/Weekly"
           class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 text-slate-600 text-sm font-bold rounded-xl hover:bg-slate-50 shadow-sm transition-all self-start">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Quay lại
        </a>
        <div class="flex-1">
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Thực đơn #@menu?.Id</p>
            <h1 class="text-2xl font-black text-slate-800 tracking-tight">
                @menu?.StartDate.ToString("dd/MM/yyyy") – @menu?.EndDate.ToString("dd/MM/yyyy")
            </h1>
        </div>
    </div>

    <!-- ERROR BANNER -->
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="text-sm font-medium">@TempData["Error"]</span>
        </div>
    }

    @if (menu == null)
    {
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-16 text-center">
            <p class="text-slate-400 font-semibold">Không tìm thấy thực đơn.</p>
        </div>
    }
    else
    {
        <!-- INFO CARDS -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Bắt đầu</p>
                <p class="font-black text-slate-800 text-base">@menu.StartDate.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Kết thúc</p>
                <p class="font-black text-slate-800 text-base">@menu.EndDate.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Số ngày</p>
                <p class="font-black text-slate-800 text-base">@((menu.EndDate.Date - menu.StartDate.Date).Days + 1) ngày</p>
            </div>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Tổng món</p>
                <p class="font-black text-slate-800 text-base">@schedules.Count món</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(menu.Description))
        {
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Mô tả</p>
                <p class="text-slate-700 text-sm font-medium">@menu.Description</p>
            </div>
        }

        <!-- SCHEDULE TABLE -->
        @if (!schedules.Any())
        {
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-16 text-center">
                <svg class="w-14 h-14 mx-auto text-slate-200 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <p class="text-slate-400 font-semibold">Chưa có lịch món nào trong thực đơn này.</p>
            </div>
        }
        else
        {
            <!-- LEGEND -->
            <div class="flex flex-wrap gap-3">
                @foreach (var slot in allSlots)
                {
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full border @SlotColor(slot)">
                        <span class="w-2 h-2 rounded-full @SlotDot(slot)"></span>
                        @SlotLabel(slot)
                    </span>
                }
            </div>

            <!-- CALENDAR GRID -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-slate-100 bg-slate-50/50">
                    <h2 class="font-black text-slate-800 text-base flex items-center gap-2">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        Lịch thực đơn theo ngày
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[700px] border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100">
                                <th class="p-3 text-left text-[11px] font-black text-slate-500 uppercase tracking-wider bg-slate-50 w-24">Ngày</th>
                                @foreach (var slot in allSlots)
                                {
                                    <th class="p-3 text-left text-[11px] font-black uppercase tracking-wider bg-slate-50">
                                        <span class="inline-flex items-center gap-1.5 @SlotColor(slot) px-2 py-1 rounded-lg border">
                                            <span class="w-2 h-2 rounded-full @SlotDot(slot)"></span>
                                            @SlotLabel(slot)
                                        </span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var group in byDate)
                            {
                                var isToday = group.Key == DateTime.Today;
                                var daySchedules = group.ToList();

                                <tr class="@(isToday ? "bg-green-50/50" : "hover:bg-slate-50/50") transition-colors">
                                    <!-- Ngày -->
                                    <td class="p-3 align-top border-r border-slate-100">
                                        <div class="flex flex-col items-start">
                                            @if (isToday)
                                            {
                                                <span class="text-[9px] font-black bg-green-500 text-white px-1.5 py-0.5 rounded-full uppercase mb-1">Hôm nay</span>
                                            }
                                            <p class="font-black text-slate-800 text-sm">@DayLabel(group.Key)</p>
                                            <p class="text-xs text-slate-400 font-medium">@group.Key.ToString("dd/MM")</p>
                                        </div>
                                    </td>

                                    <!-- Mỗi slot -->
                                    @foreach (var slot in allSlots)
                                    {
                                        var slotDishes = daySchedules.Where(s => s.MealSlot == slot).ToList();
                                        <td class="p-3 align-top">
                                            @if (!slotDishes.Any())
                                            {
                                                <p class="text-slate-300 text-xs italic">—</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-2">
                                                    @foreach (var schedule in slotDishes)
                                                    {
                                                        <div class="group/dish flex items-start gap-2 bg-white border border-slate-100 rounded-xl p-2.5 shadow-sm hover:shadow hover:border-green-200 transition-all">
                                                            @if (!string.IsNullOrEmpty(schedule.Dish.ImageUrl))
                                                            {
                                                                <div class="w-10 h-10 rounded-lg overflow-hidden shrink-0 bg-slate-100">
                                                                    <img src="@schedule.Dish.ImageUrl" alt="@schedule.Dish.Name"
                                                                         class="w-full h-full object-cover group-hover/dish:scale-105 transition-transform duration-200" />
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="w-10 h-10 rounded-lg shrink-0 bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center">
                                                                    <svg class="w-5 h-5 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                                                    </svg>
                                                                </div>
                                                            }
                                                            <div class="min-w-0 flex-1">
                                                                <p class="font-bold text-slate-800 text-xs leading-tight truncate">@schedule.Dish.Name</p>
                                                                @if (!string.IsNullOrEmpty(schedule.Dish.Category))
                                                                {
                                                                    <p class="text-[10px] text-slate-400 mt-0.5 truncate">@schedule.Dish.Category</p>
                                                                }
                                                                <p class="text-[10px] font-black text-green-600 mt-0.5">
                                                                    @schedule.Dish.Price.ToString("N0")đ
                                                                </p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- DISH LIST (cards dạng flat, dễ nhìn tổng thể) -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-slate-100 bg-slate-50/50">
                    <h2 class="font-black text-slate-800 text-base flex items-center gap-2">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                        </svg>
                        Tất cả món trong thực đơn
                        <span class="ml-auto text-xs font-bold text-slate-400">@schedules.Count mục</span>
                    </h2>
                </div>
                <div class="divide-y divide-slate-50">
                    @foreach (var schedule in schedules.OrderBy(s => s.Date).ThenBy(s => s.MealSlot))
                    {
                        var isToday = schedule.Date.Date == DateTime.Today;
                        <div class="flex items-center gap-4 px-4 py-3 hover:bg-slate-50/50 transition-colors">
                            <!-- Ảnh -->
                            @if (!string.IsNullOrEmpty(schedule.Dish.ImageUrl))
                            {
                                <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0 bg-slate-100">
                                    <img src="@schedule.Dish.ImageUrl" alt="@schedule.Dish.Name" class="w-full h-full object-cover" />
                                </div>
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-xl shrink-0 bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                    </svg>
                                </div>
                            }
                            <!-- Info -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <p class="font-bold text-slate-800 text-sm truncate">@schedule.Dish.Name</p>
                                    @if (!string.IsNullOrEmpty(schedule.Dish.Category))
                                    {
                                        <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded-md">@schedule.Dish.Category</span>
                                    }
                                </div>
                                <div class="flex items-center gap-3 mt-0.5">
                                    <span class="text-[11px] text-slate-400 font-medium">
                                        @DayLabel(schedule.Date.Date), @schedule.Date.ToString("dd/MM/yyyy")
                                    </span>
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full border @SlotColor(schedule.MealSlot)">
                                        <span class="w-1.5 h-1.5 rounded-full @SlotDot(schedule.MealSlot)"></span>
                                        @SlotLabel(schedule.MealSlot)
                                    </span>
                                    @if (isToday)
                                    {
                                        <span class="text-[10px] font-black text-green-600 bg-green-50 border border-green-200 px-2 py-0.5 rounded-full">Hôm nay</span>
                                    }
                                </div>
                            </div>
                            <!-- Giá -->
                            <div class="shrink-0 text-right">
                                <p class="font-black text-green-600 text-sm">@schedule.Dish.Price.ToString("N0")đ</p>
                                @if (!string.IsNullOrEmpty(schedule.Code))
                                {
                                    <p class="text-[10px] text-slate-400 font-medium">@schedule.Code</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
