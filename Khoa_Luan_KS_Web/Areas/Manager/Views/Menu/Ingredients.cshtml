@{
    ViewData["Title"] = "Dự tính Nguyên liệu";
    Layout = "_LayoutManager";
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="ingredientManager()">
    
    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Dự trù Nguyên liệu</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Bảng tính tự động lượng nguyên liệu cần thiết dựa trên Thực đơn tuần.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <button @@click="openPO()" class="px-5 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Tạo phiếu mua hàng
            </button>
            <button class="px-5 py-2 bg-green-600 text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:bg-green-700 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Xuất Excel
            </button>
        </div>
    </div>

    <!-- MAIN CARD -->
    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <!-- Toolbar -->
        <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row gap-4 justify-between items-center bg-slate-50/50">
            <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                <div class="relative w-full sm:w-64">
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" x-model="searchQuery" placeholder="Tìm tên nguyên liệu..." class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all" />
                </div>
                
                <select x-model="statusFilter" class="w-full sm:w-auto bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-2 outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="Cần nhập thêm">Cần nhập thêm</option>
                    <option value="Hết hàng">Hết hàng</option>
                    <option value="Đủ dùng">Đủ dùng</option>
                </select>
            </div>
            
            <div class="flex items-center gap-2 text-sm font-bold text-slate-700 bg-white px-4 py-2 rounded-xl border border-slate-200">
                Tuần áp dụng: <span class="text-green-600">Tuần 18 (26/04 - 02/05)</span>
            </div>
        </div>
        
        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-wider text-slate-400 font-black">
                        <th class="p-4 pl-6 w-16 text-center">STT</th>
                        <th class="p-4">Tên nguyên liệu</th>
                        <th class="p-4 w-24">ĐVT</th>
                        <th class="p-4 text-right">Lượng dự kiến</th>
                        <th class="p-4 text-right">Tồn kho</th>
                        <th class="p-4 text-center">Cần mua thêm</th>
                        <th class="p-4 w-48 text-center">Trạng thái</th>
                        <th class="p-4 pr-6">Nhà cung cấp đề xuất</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 text-sm">
                    <template x-for="(item, index) in filteredIngredients" :key="item.id">
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <td class="p-4 pl-6 text-center text-slate-400 font-bold" x-text="index + 1"></td>
                            <td class="p-4 font-bold text-slate-800" x-text="item.name"></td>
                            <td class="p-4 text-slate-500 font-medium" x-text="item.unit"></td>
                            
                            <td class="p-4 text-right">
                                <span class="font-black text-slate-700" x-text="formatNumber(item.required)"></span>
                            </td>
                            
                            <td class="p-4 text-right">
                                <span class="font-bold" :class="item.stock === 0 ? 'text-red-500' : 'text-slate-600'" x-text="formatNumber(item.stock)"></span>
                            </td>
                            
                            <td class="p-4 text-center">
                                <span x-show="item.required > item.stock" class="inline-block px-2.5 py-1 bg-red-50 text-red-600 font-black rounded-lg border border-red-100" x-text="'+' + formatNumber(item.required - item.stock)"></span>
                                <span x-show="item.required <= item.stock" class="text-slate-300 font-bold">-</span>
                            </td>
                            
                            <td class="p-4 text-center">
                                <span class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-lg border" :class="getStatus(item.required, item.stock).color" x-text="getStatus(item.required, item.stock).text"></span>
                            </td>
                            
                            <td class="p-4 pr-6">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded bg-slate-100 flex items-center justify-center text-slate-400">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                    </div>
                                    <span class="font-medium text-slate-600 truncate max-w-[150px]" x-text="item.vendor"></span>
                                </div>
                            </td>
                        </tr>
                    </template>
                    
                    <tr x-show="filteredIngredients.length === 0">
                        <td colspan="8" class="p-8 text-center text-slate-500">
                            Không tìm thấy dữ liệu nguyên liệu phù hợp.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Footer / Pagination -->
        <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex justify-between items-center text-sm">
            <span class="text-slate-500 font-medium">Hiển thị <span class="font-bold text-slate-700" x-text="filteredIngredients.length"></span> nguyên liệu</span>
            <div class="flex gap-1">
                <button class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-400 cursor-not-allowed">Trước</button>
                <button class="px-3 py-1.5 rounded-lg border border-green-500 bg-green-50 text-green-700 font-bold">1</button>
                <button class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50">2</button>
                <button class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50">Tiếp</button>
            </div>
        </div>
    </div>

    <!-- SLIDEOVER: TẠO PHIẾU MUA HÀNG -->
    <div x-show="isPOOpen" style="display: none;" class="relative z-50" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
        <!-- Background backdrop -->
        <div x-show="isPOOpen" 
             x-transition:enter="ease-in-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" 
             x-transition:leave="ease-in-out duration-300" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="closePO()"></div>

        <div class="fixed inset-0 overflow-hidden">
            <div class="absolute inset-0 overflow-hidden">
                <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10 sm:pl-16">
                    <!-- Slide-over panel -->
                    <div x-show="isPOOpen" 
                         x-transition:enter="transform transition ease-in-out duration-300 sm:duration-500" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" 
                         x-transition:leave="transform transition ease-in-out duration-300 sm:duration-500" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
                         class="pointer-events-auto w-screen max-w-xl" @@click.stop>
                        <div class="flex h-full flex-col overflow-y-scroll bg-white shadow-2xl rounded-l-[32px]">
                            <!-- Header -->
                            <div class="px-6 py-6 border-b border-slate-100 sticky top-0 bg-white/80 backdrop-blur-md z-10">
                                <div class="flex items-start justify-between">
                                    <h2 class="text-xl font-black text-slate-800">Tạo Phiếu Mua Hàng (PO)</h2>
                                    <div class="ml-3 flex h-7 items-center">
                                        <button type="button" @@click="closePO()" class="rounded-full bg-slate-100 p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-200 transition-colors">
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                        </button>
                                    </div>
                                </div>
                                <p class="text-sm text-slate-500 mt-2">Hệ thống sẽ tự động tổng hợp những nguyên liệu <span class="font-bold text-red-500">đang thiếu</span> để tạo phiếu nhập hàng.</p>
                            </div>
                            
                            <!-- Body Form -->
                            <div class="flex-1 px-6 py-6 space-y-6 bg-slate-50/50">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-slate-700 mb-2">Nhà cung cấp</label>
                                        <select class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 bg-white shadow-sm">
                                            <option>Tất cả nhà cung cấp (Tạo nhiều phiếu)</option>
                                            <option>Công ty Thực phẩm CP</option>
                                            <option>Vựa gạo Chợ Lớn</option>
                                            <option>Vissan</option>
                                            <option>Đà Lạt Hasfarm</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-slate-700 mb-2">Ngày cần giao hàng</label>
                                        <input type="date" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 bg-white shadow-sm" value="2026-04-26" />
                                    </div>
                                </div>

                                <div class="mt-6">
                                    <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
                                        <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                                        Chi tiết các nguyên liệu cần mua (Tự động)
                                    </h3>
                                    
                                    <div class="bg-white rounded-[20px] shadow-sm border border-slate-200 overflow-hidden">
                                        <ul class="divide-y divide-slate-100">
                                            <template x-for="item in missingIngredients" :key="item.id">
                                                <li class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors">
                                                    <div>
                                                        <div class="font-bold text-slate-800 text-sm" x-text="item.name"></div>
                                                        <div class="text-xs text-slate-500 mt-0.5" x-text="'NCC: ' + item.vendor"></div>
                                                    </div>
                                                    <div class="text-right">
                                                        <div class="font-black text-red-600" x-text="'+' + formatNumber(item.required - item.stock) + ' ' + item.unit"></div>
                                                    </div>
                                                </li>
                                            </template>
                                        </ul>
                                    </div>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-bold text-slate-700 mb-2">Ghi chú cho nhà cung cấp</label>
                                    <textarea rows="3" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 focus:ring-1 focus:ring-green-500 bg-white shadow-sm" placeholder="Ví dụ: Giao hàng qua cổng số 2..."></textarea>
                                </div>
                            </div>
                            
                            <!-- Footer -->
                            <div class="border-t border-slate-100 p-6 bg-white flex justify-end gap-3 sticky bottom-0 z-10 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] rounded-bl-[32px]">
                                <button @@click="closePO()" type="button" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-bold hover:bg-slate-50 transition-colors">Hủy bỏ</button>
                                <button @@click="submitPO()" type="button" class="px-6 py-2.5 rounded-xl bg-green-600 text-white font-bold hover:bg-green-700 shadow-lg shadow-green-600/30 transition-all flex items-center gap-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                                    <span>Tạo & Gửi Phiếu Mua</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('ingredientManager', () => ({
                searchQuery: '',
                statusFilter: 'all',
                isPOOpen: false,
                
                ingredients: [
                    { id: 1, name: 'Thịt Gà Công Nghiệp (Đùi)', unit: 'KG', required: 125, stock: 45, vendor: 'Công ty Thực phẩm CP' },
                    { id: 2, name: 'Gạo tẻ ST25', unit: 'KG', required: 500, stock: 650, vendor: 'Vựa gạo Chợ Lớn' },
                    { id: 3, name: 'Sườn non heo', unit: 'KG', required: 85, stock: 15, vendor: 'Vissan' },
                    { id: 4, name: 'Cà chua Đà Lạt', unit: 'KG', required: 45, stock: 0, vendor: 'Đà Lạt Hasfarm' },
                    { id: 5, name: 'Nước mắm Nam Ngư', unit: 'Lít', required: 20, stock: 25, vendor: 'Masan' },
                    { id: 6, name: 'Trứng gà (Size L)', unit: 'Quả', required: 1500, stock: 200, vendor: 'Ba Huân' },
                    { id: 7, name: 'Thịt Bò Thăn', unit: 'KG', required: 60, stock: 5, vendor: 'MeatDeli' },
                    { id: 8, name: 'Rau muống', unit: 'Bó', required: 120, stock: 0, vendor: 'Nông sản Hóc Môn' },
                    { id: 9, name: 'Cá diêu hồng', unit: 'KG', required: 95, stock: 95, vendor: 'Hải sản Biển Đông' },
                    { id: 10, name: 'Dầu ăn Tường An', unit: 'Lít', required: 80, stock: 120, vendor: 'Tường An' },
                ],
                
                get filteredIngredients() {
                    return this.ingredients.filter(item => {
                        const matchSearch = item.name.toLowerCase().includes(this.searchQuery.toLowerCase()) || 
                                            item.vendor.toLowerCase().includes(this.searchQuery.toLowerCase());
                        
                        let matchStatus = true;
                        if(this.statusFilter !== 'all') {
                            const statusText = this.getStatus(item.required, item.stock).text;
                            matchStatus = statusText === this.statusFilter;
                        }
                        
                        return matchSearch && matchStatus;
                    });
                },
                
                get missingIngredients() {
                    return this.ingredients.filter(item => item.required > item.stock);
                },
                
                getStatus(req, stock) {
                    if(stock >= req) return { text: 'Đủ dùng', color: 'text-green-700 bg-green-50 border-green-200' };
                    if(stock > 0 && stock < req) return { text: 'Cần nhập thêm', color: 'text-orange-700 bg-orange-50 border-orange-200' };
                    return { text: 'Hết hàng', color: 'text-red-700 bg-red-50 border-red-200' };
                },
                
                formatNumber(num) {
                    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                },
                
                openPO() {
                    this.isPOOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                
                closePO() {
                    this.isPOOpen = false;
                    document.body.style.overflow = '';
                },
                
                submitPO() {
                    alert('Đã tạo thành công các phiếu mua hàng và gửi cho NCC!');
                    this.closePO();
                }
            }));
        });
    </script>
}
