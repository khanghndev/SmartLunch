@model Khoa_Luan_KS_Web.Services.GetDishesResponse
@{
    ViewData["Title"] = "Quản lý Món Ăn";
    Layout = "_LayoutManager";

    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int pageSize = (int)(ViewData["PageSize"] ?? 12);
    string? searchTerm = ViewData["SearchTerm"] as string;
    string curCat = ViewData["Category"] as string ?? "";
    int totalCount = Model?.TotalCount ?? 0;
    int totalPages = pageSize > 0 ? Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize)) : 1;
    var items = Model?.Items ?? new List<Khoa_Luan_KS_Web.Services.DishDto>();

    string CatLabel(string? cat) => cat?.ToLower() switch {
        "man" => "Món chính",
        "xao" => "Món phụ",
        "canh" => "Canh",
        "trang_mieng" => "Tráng miệng",
        _ => "Khác"
    };

    string CatBadge(string? cat) => cat?.ToLower() switch {
        "man" => "text-green-700 bg-green-50",
        "xao" => "text-orange-700 bg-orange-50",
        "canh" => "text-blue-700 bg-blue-50",
        "trang_mieng" => "text-purple-700 bg-purple-50",
        _ => "text-slate-600 bg-slate-50"
    };

    bool IsVegetarian(Khoa_Luan_KS_Web.Services.DishDto d)
    {
        var label = (d.DietaryLabel ?? "").ToLowerInvariant();
        return label.Contains("chay") || label.Contains("vegetarian") || label.Contains("vegan");
    }

    string ImgUrl(Khoa_Luan_KS_Web.Services.DishDto d) =>
        !string.IsNullOrWhiteSpace(d.ImageUrl)
            ? d.ImageUrl!
            : "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&q=80";

    string KcalText(Khoa_Luan_KS_Web.Services.DishDto d) =>
        d.Calories.HasValue ? $"{d.Calories.Value:0} Kcal" : "—";

    string BuildUrl(int page, string? category = null)
    {
        var cat = category ?? curCat;
        var q = $"?page={page}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(cat)) q += $"&category={Uri.EscapeDataString(cat)}";
        if (!string.IsNullOrEmpty(searchTerm)) q += $"&searchTerm={Uri.EscapeDataString(searchTerm)}";
        return q;
    }
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="{ viewMode: 'grid' }">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Kho Món Ăn</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">
                Tổng <span class="font-bold text-green-600">@totalCount</span> món trong thư viện.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Manager/Catalog/Meals"
               class="px-6 py-2 bg-green-600 text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:bg-green-700 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Thêm món mới
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="text-sm text-red-700 bg-red-50 border border-red-100 rounded-xl px-4 py-3">@TempData["Error"]</div>
    }

    <div class="bg-white p-4 rounded-[20px] shadow-sm border border-slate-100 flex flex-col md:flex-row gap-4 items-center justify-between">
        <form method="get" asp-area="Manager" asp-controller="Menu" asp-action="Dish" class="flex flex-wrap items-center gap-4 w-full md:w-auto flex-1">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <input type="hidden" name="category" value="@curCat" />
            <div class="relative w-full md:w-72">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" name="searchTerm" value="@searchTerm" placeholder="Tìm kiếm món ăn..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all" />
            </div>
            <button type="submit" class="px-4 py-2.5 bg-slate-800 text-white text-sm font-bold rounded-xl hover:bg-slate-700 transition-all">Tìm</button>
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <a asp-area="Manager" asp-controller="Menu" asp-action="Dish" asp-route-page="1" asp-route-pageSize="@pageSize" asp-route-category="@curCat"
                   class="text-sm font-bold text-slate-500 hover:text-slate-700">Xóa tìm kiếm</a>
            }
        </form>

        <div class="flex flex-wrap items-center gap-2">
            @{
                var filterTabs = new[] {
                    new { Key = "", Label = "Tất cả" },
                    new { Key = "man", Label = "Món chính" },
                    new { Key = "xao", Label = "Món phụ" },
                    new { Key = "canh", Label = "Canh" },
                    new { Key = "trang_mieng", Label = "Tráng miệng" },
                };
            }
            @foreach (var t in filterTabs)
            {
                var active = curCat == t.Key;
                <a href="@BuildUrl(1, t.Key)"
                   class="px-3 py-1.5 text-xs font-bold rounded-lg transition-all @(active ? "bg-green-600 text-white shadow" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    @t.Label
                </a>
            }
        </div>

        <div class="flex items-center gap-2 bg-slate-100 p-1 rounded-lg shrink-0">
            <button type="button" @@click="viewMode = 'grid'" class="p-1.5 rounded-md transition-colors" :class="viewMode === 'grid' ? 'bg-white shadow-sm text-green-600' : 'text-slate-400 hover:text-slate-600'">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
            </button>
            <button type="button" @@click="viewMode = 'list'" class="p-1.5 rounded-md transition-colors" :class="viewMode === 'list' ? 'bg-white shadow-sm text-green-600' : 'text-slate-400 hover:text-slate-600'">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
            </button>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="text-center py-16 bg-white rounded-[24px] border border-dashed border-slate-200">
            <h3 class="text-sm font-bold text-slate-800">Không có món ăn nào</h3>
            <p class="text-xs text-slate-500 mt-1">Thử đổi bộ lọc hoặc thêm món mới.</p>
        </div>
    }
    else
    {
        <!-- GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" x-show="viewMode === 'grid'">
            @foreach (var dish in items)
            {
                <div class="bg-white rounded-[24px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden group flex flex-col">
                    <div class="h-48 bg-slate-100 relative overflow-hidden">
                        <img src="@ImgUrl(dish)" alt="@dish.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                        <div class="absolute top-3 left-3">
                            <span class="px-2.5 py-1 text-[10px] font-black uppercase tracking-wider rounded-lg border @CatBadge(dish.Category)">@CatLabel(dish.Category)</span>
                        </div>
                        @if (IsVegetarian(dish))
                        {
                            <div class="absolute top-3 right-3">
                                <span class="px-2 py-1 bg-green-500 text-white text-[10px] font-bold rounded-lg shadow-sm">Chay</span>
                            </div>
                        }
                        <div class="absolute bottom-3 inset-x-0 flex justify-center gap-2 translate-y-8 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
                            <a href="/Manager/Catalog/MealDetail/@dish.Id" class="w-8 h-8 bg-white text-slate-700 hover:text-green-600 rounded-full flex items-center justify-center shadow-md hover:scale-110 transition-transform" title="Xem chi tiết">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                            </a>
                            <a href="/Manager/Catalog/MealEdit/@dish.Id" class="w-8 h-8 bg-white text-slate-700 hover:text-blue-600 rounded-full flex items-center justify-center shadow-md hover:scale-110 transition-transform" title="Chỉnh sửa">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                            </a>
                        </div>
                    </div>
                    <div class="p-5 flex flex-col flex-1">
                        <h3 class="font-bold text-slate-800 text-base mb-1 group-hover:text-green-600 transition-colors line-clamp-2">@dish.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(dish.Description))
                        {
                            <p class="text-xs text-slate-500 line-clamp-2 mb-3">@dish.Description</p>
                        }
                        <div class="mt-auto pt-4 border-t border-slate-50 flex items-center justify-between gap-2">
                            <div class="flex items-center gap-1.5 text-xs text-slate-500 font-medium">
                                <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                <span>@KcalText(dish)</span>
                            </div>
                            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-lg @(dish.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">
                                @(dish.IsActive ? "Đang dùng" : "Tắt")
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- LIST -->
        <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden" x-show="viewMode === 'list'" style="display: none;">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-100 text-xs uppercase tracking-wider text-slate-500 font-bold">
                        <th class="p-4 pl-6">Món ăn</th>
                        <th class="p-4">Danh mục</th>
                        <th class="p-4">Dinh dưỡng</th>
                        <th class="p-4">Trạng thái</th>
                        <th class="p-4 pr-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var dish in items)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <td class="p-4 pl-6">
                                <div class="flex items-center gap-3">
                                    <img src="@ImgUrl(dish)" alt="@dish.Name" class="w-10 h-10 rounded-lg object-cover shadow-sm" />
                                    <div>
                                        <h4 class="font-bold text-slate-800 text-sm group-hover:text-green-600 transition-colors">@dish.Name</h4>
                                        @if (IsVegetarian(dish))
                                        {
                                            <span class="text-[10px] text-green-600 font-bold bg-green-50 px-1.5 py-0.5 rounded">Chay</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="p-4">
                                <span class="text-xs font-bold uppercase tracking-wider px-2 py-1 rounded-md @CatBadge(dish.Category)">@CatLabel(dish.Category)</span>
                            </td>
                            <td class="p-4 text-sm font-medium text-slate-600">@KcalText(dish)</td>
                            <td class="p-4">
                                <span class="text-xs font-bold px-2 py-1 rounded-lg @(dish.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">
                                    @(dish.IsActive ? "Đang dùng" : "Tắt")
                                </span>
                            </td>
                            <td class="p-4 pr-6">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/Manager/Catalog/MealDetail/@dish.Id" class="p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-800 rounded transition-colors" title="Chi tiết">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                    </a>
                                    <a href="/Manager/Catalog/MealEdit/@dish.Id" class="p-1.5 text-slate-400 hover:bg-blue-50 hover:text-blue-600 rounded transition-colors" title="Sửa">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-3">
                <p class="text-sm text-slate-500 font-medium">
                    Trang <span class="font-bold text-slate-700">@currentPage</span> / @totalPages
                    &nbsp;·&nbsp; Hiển thị @items.Count / @totalCount món
                </p>
                <div class="flex items-center gap-1.5 flex-wrap justify-center">
                    @if (currentPage > 1)
                    {
                        <a href="@BuildUrl(currentPage - 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">← Trước</a>
                    }
                    @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                    {
                        if (p == currentPage)
                        {
                            <span class="px-3 py-1.5 text-sm font-black text-white bg-green-600 rounded-lg shadow">@p</span>
                        }
                        else
                        {
                            <a href="@BuildUrl(p)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">@p</a>
                        }
                    }
                    @if (currentPage < totalPages)
                    {
                        <a href="@BuildUrl(currentPage + 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">Sau →</a>
                    }
                </div>
            </div>
        }
    }
</div>
