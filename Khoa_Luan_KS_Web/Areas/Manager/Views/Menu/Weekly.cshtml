@model Khoa_Luan_KS_Web.Services.WeeklyMenuListPageViewModel
@using Khoa_Luan_KS_Web.Services
@{
    ViewData["Title"] = "Thực Đơn Tuần";
    Layout = "_LayoutManager";

    var tab = Model.ActiveTab;
    var today = Model.Today;
    var items = Model.Items;
    var totalPages = Model.TotalPages;
    var searchTerm = Model.SearchTerm;

    string TabUrl(string t) => Url.Action("Weekly", "Menu", new
    {
        area = "Manager",
        tab = t,
        page = 1,
        pageSize = Model.PageSize,
        searchTerm
    }) ?? "#";

    string PageUrl(int p) => Url.Action("Weekly", "Menu", new
    {
        area = "Manager",
        tab,
        page = p,
        pageSize = Model.PageSize,
        searchTerm
    }) ?? "#";

    (string Label, string BadgeClass) LifecycleBadge(WeeklyMenuClientDto menu)
    {
        return WeeklyMenuManagerCatalog.GetLifecycle(menu, today) switch
        {
            WeeklyMenuManagerCatalog.MenuLifecycle.Current => ("Đang áp dụng", "bg-emerald-500 text-white"),
            WeeklyMenuManagerCatalog.MenuLifecycle.Upcoming => ("Sắp tới", "bg-sky-500 text-white"),
            _ => ("Đã hết hạn", "bg-slate-500 text-white")
        };
    }
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans">

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2">
            <i data-lucide="alert-triangle" class="w-5 h-5 shrink-0"></i>
            <span class="text-sm font-medium">@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-center gap-2">
            <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
            <span class="text-sm font-medium">@TempData["Success"]</span>
        </div>
    }

    <!-- Hero -->
    <div class="rounded-3xl border border-green-100 bg-gradient-to-br from-green-50 via-white to-emerald-50 p-6 md:p-8 shadow-sm">
        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
            <div class="space-y-2">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-green-600 flex items-center justify-center shadow-lg shadow-green-600/25">
                        <i data-lucide="calendar-range" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Thực Đơn Tuần</h1>
                        <p class="text-slate-500 text-sm font-medium mt-0.5">
                            Quản lý thực đơn cố định theo tuần · Hôm nay: <span class="font-bold text-slate-700">@today.ToString("dd/MM/yyyy")</span>
                        </p>
                    </div>
                </div>
            </div>
            <a href="@PageUrl(1)"
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl hover:bg-slate-50 transition-all self-start">
                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                Làm mới
            </a>
        </div>

        <!-- Stat cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-6">
            <div class="bg-white/80 backdrop-blur rounded-2xl border border-emerald-100 p-4">
                <p class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">Đang áp dụng</p>
                <p class="text-2xl font-black text-slate-800 mt-1">@Model.CountCurrent</p>
            </div>
            <div class="bg-white/80 backdrop-blur rounded-2xl border border-sky-100 p-4">
                <p class="text-[11px] font-bold text-sky-600 uppercase tracking-wider">Sắp tới</p>
                <p class="text-2xl font-black text-slate-800 mt-1">@Model.CountUpcoming</p>
            </div>
            <div class="bg-white/80 backdrop-blur rounded-2xl border border-green-100 p-4">
                <p class="text-[11px] font-bold text-green-600 uppercase tracking-wider">Còn hiệu lực</p>
                <p class="text-2xl font-black text-slate-800 mt-1">@Model.CountValid</p>
            </div>
            <div class="bg-white/80 backdrop-blur rounded-2xl border border-slate-200 p-4">
                <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Đã hết hạn</p>
                <p class="text-2xl font-black text-slate-800 mt-1">@Model.CountExpired</p>
            </div>
        </div>
    </div>

    <!-- Thêm menu cố định -->
    <div class="bg-white rounded-2xl border-2 border-dashed border-green-200 p-5 md:p-6 flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="flex gap-4">
            <div class="w-12 h-12 rounded-2xl bg-green-100 flex items-center justify-center shrink-0">
                <i data-lucide="plus-circle" class="w-6 h-6 text-green-700"></i>
            </div>
            <div>
                <h2 class="text-lg font-black text-slate-800">Thêm thực đơn cố định</h2>
                <p class="text-sm text-slate-500 mt-1 max-w-xl">
                    Tạo thực đơn tuần mới bằng AI (gợi ý món, ngân sách, quy tắc dinh dưỡng). Sau khi duyệt gợi ý, hệ thống sẽ áp dụng lên lịch phục vụ khách hàng.
                </p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
            <a href="@Url.Action("Create", "Menu", new { area = "Manager" })"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-800 text-white text-sm font-bold rounded-xl shadow-lg hover:bg-slate-900 transition-all">
                <i data-lucide="pen-line" class="w-4 h-4"></i>
                Tạo thủ công
            </a>
            <a href="@Url.Action("Generate", "MenuSuggestion", new { area = "Manager" })"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 text-white text-sm font-bold rounded-xl shadow-lg shadow-green-600/25 hover:bg-green-700 transition-all">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                Tạo bằng AI
            </a>
            <a href="@Url.Action("Index", "MenuSuggestion", new { area = "Manager" })"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl hover:bg-slate-50 transition-all">
                <i data-lucide="list" class="w-4 h-4"></i>
                Gợi ý đã tạo
            </a>
        </div>
    </div>

    <!-- Search -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
        <form method="get" asp-area="Manager" asp-controller="Menu" asp-action="Weekly" class="flex flex-col sm:flex-row gap-3">
            <input type="hidden" name="tab" value="@tab" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="relative flex-1">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                <input type="text" name="searchTerm" value="@searchTerm"
                       placeholder="Tìm theo mô tả hoặc mã #..."
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-sm font-medium outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 transition-all" />
            </div>
            <input type="hidden" name="page" value="1" />
            <button type="submit" class="px-5 py-2.5 bg-slate-800 text-white text-sm font-bold rounded-xl hover:bg-slate-700 transition-all">
                Tìm kiếm
            </button>
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <a asp-area="Manager" asp-controller="Menu" asp-action="Weekly"
                   asp-route-tab="@tab" asp-route-page="1" asp-route-pageSize="@Model.PageSize"
                   class="px-5 py-2.5 bg-white border border-slate-200 text-slate-600 text-sm font-bold rounded-xl hover:bg-slate-50 transition-all text-center">
                    Xóa bộ lọc
                </a>
            }
        </form>
    </div>

    <!-- Category tabs -->
    <div class="flex flex-wrap gap-2">
        @{
            var tabs = new (string Key, string Label, int Count)[]
            {
                (WeeklyMenuManagerCatalog.TabValid, "Còn hiệu lực", Model.CountValid),
                (WeeklyMenuManagerCatalog.TabCurrent, "Đang áp dụng", Model.CountCurrent),
                (WeeklyMenuManagerCatalog.TabUpcoming, "Sắp tới", Model.CountUpcoming),
                (WeeklyMenuManagerCatalog.TabExpired, "Đã hết hạn", Model.CountExpired),
                (WeeklyMenuManagerCatalog.TabAll, "Tất cả", Model.CountAll),
            };
        }
        @foreach (var t in tabs)
        {
            var active = string.Equals(tab, t.Key, StringComparison.OrdinalIgnoreCase);
            <a href="@TabUrl(t.Key)"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold transition-all border
                      @(active ? "bg-green-600 text-white border-green-600 shadow-md shadow-green-600/20" : "bg-white text-slate-600 border-slate-200 hover:border-green-300 hover:text-green-700")">
                @t.Label
                <span class="text-[11px] px-2 py-0.5 rounded-full font-black @(active ? "bg-white/20 text-white" : "bg-slate-100 text-slate-600")">
                    @t.Count
                </span>
            </a>
        }
    </div>

  @if (tab == WeeklyMenuManagerCatalog.TabValid && Model.CountCurrent > 0)
    {
        <p class="text-sm text-slate-500 font-medium -mt-2">
            <i data-lucide="info" class="w-4 h-4 inline align-text-bottom text-green-600"></i>
            Ưu tiên hiển thị tuần <strong class="text-slate-700">đang áp dụng</strong>, sau đó các tuần sắp tới gần nhất.
        </p>
    }

    <!-- Grid -->
    @if (!items.Any())
    {
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-16 text-center">
            <i data-lucide="calendar-x" class="w-16 h-16 mx-auto text-slate-200 mb-4"></i>
            @if (tab == WeeklyMenuManagerCatalog.TabValid || tab == WeeklyMenuManagerCatalog.TabCurrent || tab == WeeklyMenuManagerCatalog.TabUpcoming)
            {
                <p class="text-slate-600 font-bold text-base">Chưa có thực đơn trong nhóm này</p>
                <p class="text-slate-400 text-sm mt-2 max-w-md mx-auto">
                    Hãy tạo thực đơn cố định mới bằng AI để phục vụ khách hàng trong các tuần tới.
                </p>
                <div class="flex flex-wrap gap-2 justify-center mt-6">
                    <a href="@Url.Action("Create", "Menu", new { area = "Manager" })"
                       class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-800 text-white text-sm font-bold rounded-xl hover:bg-slate-900 transition-all">
                        <i data-lucide="pen-line" class="w-4 h-4"></i>
                        Tạo thủ công
                    </a>
                    <a href="@Url.Action("Generate", "MenuSuggestion", new { area = "Manager" })"
                       class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 text-white text-sm font-bold rounded-xl hover:bg-green-700 transition-all">
                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                        Tạo bằng AI
                    </a>
                </div>
            }
            else
            {
                <p class="text-slate-600 font-bold text-base">Không có thực đơn phù hợp</p>
                <p class="text-slate-400 text-sm mt-1">Thử đổi tab hoặc xóa từ khóa tìm kiếm.</p>
            }
        </div>
    }
    else
    {
        <p class="text-sm text-slate-500 font-medium">
            Hiển thị <span class="font-bold text-slate-700">@items.Count</span> / <span class="font-bold text-slate-700">@Model.TotalCount</span> thực đơn
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var menu in items)
            {
                var life = WeeklyMenuManagerCatalog.GetLifecycle(menu, today);
                var isCurrent = life == WeeklyMenuManagerCatalog.MenuLifecycle.Current;
                var (badgeLabel, badgeClass) = LifecycleBadge(menu);
                var startStr = menu.StartDate.ToString("dd/MM/yyyy");
                var endStr = menu.EndDate.ToString("dd/MM/yyyy");
                var days = (menu.EndDate.Date - menu.StartDate.Date).Days + 1;
                var cover = menu.Images.FirstOrDefault(i => i.Role == "cover")?.Url
                            ?? menu.Images.FirstOrDefault()?.Url
                            ?? menu.ImageUrl;

                <div class="group bg-white rounded-2xl border overflow-hidden flex flex-col transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5
                            @(isCurrent ? "border-emerald-300 ring-2 ring-emerald-500/20 shadow-md shadow-emerald-500/10" : "border-slate-100 shadow-sm")">
                    @if (!string.IsNullOrEmpty(cover))
                    {
                        <div class="h-40 overflow-hidden bg-slate-100 relative">
                            <img src="@cover" alt="Ảnh thực đơn" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                            <span class="absolute top-3 left-3 @badgeClass text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">@badgeLabel</span>
                            @if (isCurrent)
                            {
                                <span class="absolute top-3 right-3 bg-white/95 text-emerald-700 text-[10px] font-black px-2 py-1 rounded-full uppercase shadow flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Tuần này
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="h-36 bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center relative">
                            <i data-lucide="calendar" class="w-14 h-14 text-green-200"></i>
                            <span class="absolute top-3 left-3 @badgeClass text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">@badgeLabel</span>
                            @if (isCurrent)
                            {
                                <span class="absolute top-3 right-3 bg-white/95 text-emerald-700 text-[10px] font-black px-2 py-1 rounded-full uppercase shadow">Tuần này</span>
                            }
                        </div>
                    }

                    <div class="p-4 flex flex-col flex-1">
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">Thực đơn #@menu.Id</p>
                                <h2 class="font-black text-slate-800 text-base leading-tight">@startStr – @endStr</h2>
                            </div>
                            <span class="shrink-0 text-[11px] font-bold bg-slate-100 text-slate-600 px-2 py-1 rounded-lg">@days ngày</span>
                        </div>

                        @if (!string.IsNullOrEmpty(menu.Description))
                        {
                            <p class="text-slate-500 text-sm line-clamp-2 mb-3 flex-1">@menu.Description</p>
                        }
                        else
                        {
                            <p class="text-slate-300 text-sm italic mb-3 flex-1">Chưa có mô tả.</p>
                        }

                        <div class="border-t border-slate-50 pt-3 mt-auto flex items-center justify-between gap-2">
                            <p class="text-[11px] text-slate-400 font-medium">
                                Tạo: @menu.CreatedAt.ToString("dd/MM/yyyy")
                            </p>
                            <a href="/Manager/Menu/Detail/@menu.Id"
                               class="px-3 py-1.5 bg-green-600 text-white text-xs font-bold rounded-lg hover:bg-green-700 transition-all flex items-center gap-1.5 shadow shadow-green-600/20">
                                <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-3">
                <p class="text-sm text-slate-500 font-medium">
                    Trang <span class="font-bold text-slate-700">@Model.Page</span> / @totalPages
                </p>
                <div class="flex items-center gap-1.5 flex-wrap">
                    @if (Model.Page > 1)
                    {
                        <a href="@PageUrl(Model.Page - 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">← Trước</a>
                    }
                    @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(totalPages, Model.Page + 2); p++)
                    {
                        if (p == Model.Page)
                        {
                            <span class="px-3 py-1.5 text-sm font-black text-white bg-green-600 rounded-lg shadow">@p</span>
                        }
                        else
                        {
                            <a href="@PageUrl(p)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">@p</a>
                        }
                    }
                    @if (Model.Page < totalPages)
                    {
                        <a href="@PageUrl(Model.Page + 1)" class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">Sau →</a>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>
}
