@model Khoa_Luan_KS_Web.Services.GetWeeklyMenusClientResponse
@{
    ViewData["Title"] = "Danh Sách Thực Đơn Tuần";
    Layout = "_LayoutManager";

    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int pageSize = (int)(ViewData["PageSize"] ?? 10);
    string? searchTerm = ViewData["SearchTerm"] as string;
    int totalCount = Model?.TotalCount ?? 0;
    int totalPages = pageSize > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
    var items = Model?.Items ?? new List<Khoa_Luan_KS_Web.Services.WeeklyMenuClientDto>();
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Thực Đơn Tuần</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">
                Tổng cộng <span class="font-bold text-green-600">@totalCount</span> thực đơn đã được lên kế hoạch.
            </p>
        </div>
        <a href="/Manager/Menu/Weekly" class="px-5 py-2.5 bg-green-600 text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:bg-green-700 transition-all flex items-center gap-2 text-sm self-start">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            Làm mới
        </a>
    </div>

    <!-- ERROR BANNER -->
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="text-sm font-medium">@TempData["Error"]</span>
        </div>
    }

    <!-- SEARCH BAR -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
        <form method="get" asp-area="Manager" asp-controller="Menu" asp-action="Weekly" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input type="text" name="searchTerm" value="@searchTerm"
                       placeholder="Tìm kiếm thực đơn..."
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-sm font-medium outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 transition-all" />
            </div>
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <button type="submit"
                    class="px-5 py-2.5 bg-slate-800 text-white text-sm font-bold rounded-xl hover:bg-slate-700 transition-all">
                Tìm kiếm
            </button>
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <a asp-area="Manager" asp-controller="Menu" asp-action="Weekly" asp-route-page="1" asp-route-pageSize="@pageSize"
                   class="px-5 py-2.5 bg-white border border-slate-200 text-slate-600 text-sm font-bold rounded-xl hover:bg-slate-50 transition-all">
                    Xóa bộ lọc
                </a>
            }
        </form>
    </div>

    <!-- MENU CARDS GRID -->
    @if (!items.Any())
    {
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-16 text-center">
            <svg class="w-16 h-16 mx-auto text-slate-200 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            <p class="text-slate-500 font-semibold text-base">Chưa có thực đơn nào</p>
            <p class="text-slate-400 text-sm mt-1">Hãy thêm thực đơn tuần mới để bắt đầu.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var menu in items)
            {
                var startStr = menu.StartDate.ToString("dd/MM/yyyy");
                var endStr = menu.EndDate.ToString("dd/MM/yyyy");
                var days = (menu.EndDate.Date - menu.StartDate.Date).Days + 1;
                var isPast = menu.EndDate.Date < DateTime.Today;
                var isCurrent = menu.StartDate.Date <= DateTime.Today && menu.EndDate.Date >= DateTime.Today;
                var cover = menu.Images.FirstOrDefault(i => i.Role == "cover")?.Url
                            ?? menu.Images.FirstOrDefault()?.Url
                            ?? menu.ImageUrl;

                <div class="group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col">
                    <!-- Card Cover Image -->
                    @if (!string.IsNullOrEmpty(cover))
                    {
                        <div class="h-40 overflow-hidden bg-slate-100 relative">
                            <img src="@cover" alt="Ảnh thực đơn" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                            @if (isCurrent)
                            {
                                <span class="absolute top-3 left-3 bg-green-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">Đang áp dụng</span>
                            }
                            else if (isPast)
                            {
                                <span class="absolute top-3 left-3 bg-slate-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">Đã qua</span>
                            }
                            else
                            {
                                <span class="absolute top-3 left-3 bg-blue-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">Sắp tới</span>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Placeholder gradient khi không có ảnh -->
                        <div class="h-36 bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center relative">
                            <svg class="w-14 h-14 text-green-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            @if (isCurrent)
                            {
                                <span class="absolute top-3 left-3 bg-green-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">Đang áp dụng</span>
                            }
                            else if (isPast)
                            {
                                <span class="absolute top-3 left-3 bg-slate-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">Đã qua</span>
                            }
                            else
                            {
                                <span class="absolute top-3 left-3 bg-blue-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full uppercase shadow">Sắp tới</span>
                            }
                        </div>
                    }

                    <!-- Card Body -->
                    <div class="p-4 flex flex-col flex-1">
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">Thực đơn #@menu.Id</p>
                                <h2 class="font-black text-slate-800 text-base leading-tight">
                                    @startStr – @endStr
                                </h2>
                            </div>
                            <span class="shrink-0 text-[11px] font-bold bg-slate-100 text-slate-600 px-2 py-1 rounded-lg">@days ngày</span>
                        </div>

                        @if (!string.IsNullOrEmpty(menu.Description))
                        {
                            <p class="text-slate-500 text-sm line-clamp-2 mb-3 flex-1">@menu.Description</p>
                        }
                        else
                        {
                            <p class="text-slate-300 text-sm italic mb-3 flex-1">Chưa có mô tả.</p>
                        }

                        <div class="border-t border-slate-50 pt-3 mt-auto flex items-center justify-between">
                            <p class="text-[11px] text-slate-400 font-medium">
                                Tạo: @menu.CreatedAt.ToString("dd/MM/yyyy")
                            </p>
                            <a href="/Manager/Menu/Detail/@menu.Id"
                               class="px-3 py-1.5 bg-green-600 text-white text-xs font-bold rounded-lg hover:bg-green-700 transition-all flex items-center gap-1.5 shadow shadow-green-600/20">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (totalPages > 1)
        {
            <div class="flex items-center justify-between bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-3">
                <p class="text-sm text-slate-500 font-medium">
                    Trang <span class="font-bold text-slate-700">@currentPage</span> / @totalPages
                    &nbsp;·&nbsp; Tổng <span class="font-bold text-slate-700">@totalCount</span> thực đơn
                </p>
                <div class="flex items-center gap-1.5">
                    @if (currentPage > 1)
                    {
                        <a href="?page=@(currentPage - 1)&pageSize=@pageSize@(!string.IsNullOrEmpty(searchTerm) ? $"&searchTerm={Uri.EscapeDataString(searchTerm)}" : "")"
                           class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">
                            ← Trước
                        </a>
                    }

                    @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                    {
                        if (p == currentPage)
                        {
                            <span class="px-3 py-1.5 text-sm font-black text-white bg-green-600 rounded-lg shadow">@p</span>
                        }
                        else
                        {
                            <a href="?page=@p&pageSize=@pageSize@(!string.IsNullOrEmpty(searchTerm) ? $"&searchTerm={Uri.EscapeDataString(searchTerm)}" : "")"
                               class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">@p</a>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="?page=@(currentPage + 1)&pageSize=@pageSize@(!string.IsNullOrEmpty(searchTerm) ? $"&searchTerm={Uri.EscapeDataString(searchTerm)}" : "")"
                           class="px-3 py-1.5 text-sm font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">
                            Sau →
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
