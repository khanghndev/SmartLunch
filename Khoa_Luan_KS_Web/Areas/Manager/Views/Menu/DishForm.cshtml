@{
    ViewData["Title"] = "Thêm/Sửa Món Ăn";
    Layout = "_LayoutManager";
}

<div class="p-2 sm:p-6 space-y-6">
    <div class="flex items-center gap-4 mb-4">
        <a href="/Manager/MenuDish" class="bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded text-gray-700 font-medium">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h1 class="text-2xl font-bold text-green-600">Thêm Món Ăn Mới / Chỉnh sửa</h1>
    </div>

    <div class="bg-white rounded-xl shadow p-6 max-w-2xl border-t-4 border-blue-500">
        <form class="space-y-4">
            <div>
                 <label class="block text-sm font-medium text-gray-700 mb-1">Tên món ăn</label>
                 <input type="text" placeholder="Ví dụ: Thịt kho tàu" class="w-full border px-3 py-2 rounded focus:ring-green-500" />
            </div>
            <div>
                 <label class="block text-sm font-medium text-gray-700 mb-1">Danh mục / Nhóm món</label>
                 <select class="w-full border px-3 py-2 rounded focus:ring-green-500">
                     <option>Món chính</option>
                     <option>Món xào - Món phụ</option>
                     <option>Canh</option>
                     <option>Tráng miệng</option>
                 </select>
            </div>
            <div>
                 <label class="block text-sm font-medium text-gray-700 mb-1">Mô tả định lượng dinh dưỡng</label>
                 <textarea rows="3" placeholder="Kcal:..., Protein:..." class="w-full border px-3 py-2 rounded focus:ring-green-500"></textarea>
            </div>
            
            <div class="border-t pt-4">
                <button type="button" class="bg-green-600 text-white px-6 py-2 rounded shadow hover:bg-green-700">Lưu Món Ăn</button>
            </div>
        </form>
    </div>
</div>
