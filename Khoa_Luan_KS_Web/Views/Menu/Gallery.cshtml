@model Khoa_Luan_KS_Web.Models.DishGalleryViewModel
@using Khoa_Luan_KS_Web.Models
@using Khoa_Luan_KS_Web.Services
@{
    ViewData["Title"] = "Thư viện món ăn - HuitMeal";
    Layout = "_LayoutCustomer";

    var items = Model.Browse?.Items ?? new List<PublicDishBrowseItemClientDto>();
    var categories = Model.Categories?.Categories ?? new List<OrganizationDishCategoryClientDto>();
    var total = Model.Browse?.TotalCount ?? 0;
    var page = Model.Page;
    var pageSize = Model.Browse?.PageSize ?? 24;
    var totalPages = pageSize > 0 ? (int)Math.Ceiling(total / (double)pageSize) : 1;
    if (totalPages < 1) totalPages = 1;

    string BuildPageUrl(int p)
    {
        var qs = new List<string> { $"page={p}" };
        if (Model.SelectedCategoryId is > 0) qs.Add($"categoryId={Model.SelectedCategoryId}");
        if (!string.IsNullOrWhiteSpace(Model.Search)) qs.Add($"q={Uri.EscapeDataString(Model.Search)}");
        return Url.Action("Gallery", "Menu") + "?" + string.Join("&", qs) + "#gallery-grid";
    }

    string PlaceholderImg() =>
        "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80";
}

<style>
    .gallery-hero {
        background: radial-gradient(1100px 520px at 85% -5%, rgba(251, 146, 60, 0.24), transparent 58%),
                    radial-gradient(800px 420px at -5% 40%, rgba(148, 163, 184, 0.16), transparent 52%),
                    linear-gradient(180deg, #fffdfb 0%, #f8fafc 100%);
    }
    .dish-card {
        transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }
    .dish-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.15);
    }
    .category-pill { transition: all .2s ease; }
    .category-pill.active {
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 8px 20px -6px rgba(249, 115, 22, 0.55);
    }
</style>

<div class="w-full overflow-x-hidden font-sans text-slate-900"
     x-data="{ loaded: false, searchOpen: false }"
     x-init="setTimeout(() => loaded = true, 40)">

    <!-- Hero -->
    <section class="gallery-hero relative border-b border-orange-100/70">
        <div class="relative z-10 mx-auto max-w-7xl px-4 pb-12 pt-20 sm:px-6 lg:pt-24 lg:pb-16">
            <div class="max-w-3xl" :class="loaded ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4'" style="transition: all .7s ease;">
                <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-orange-200/80 bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.2em] text-orange-600 shadow-sm">
                    <span class="h-1.5 w-1.5 rounded-full bg-orange-500 animate-pulse"></span>
                    Thư viện ẩm thực HuitMeal
                </div>
                <h1 class="text-4xl font-black leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
                    Khám phá <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">toàn bộ</span> món ăn
                </h1>
                <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg max-w-2xl">
                    Hơn @total món trong hệ thống — từ món chính, canh, rau đến tráng miệng. Bấm vào từng món để xem mô tả, dinh dưỡng và nguyên liệu.
                </p>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a asp-controller="Menu" asp-action="Index" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm hover:border-orange-200 hover:text-orange-600 transition">
                        <i data-lucide="calendar-days" class="h-4 w-4"></i>
                        Thực đơn tuần
                    </a>
                    <a asp-controller="OrganizationMealOrder" asp-action="Index" class="inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg hover:bg-orange-600 transition">
                        <i data-lucide="chef-hat" class="h-4 w-4"></i>
                        Tự chọn thực đơn
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Filters -->
    <section class="sticky top-[72px] z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
            <form method="get" asp-action="Gallery" asp-controller="Menu" class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                <input type="hidden" name="page" value="1" />
                @if (Model.SelectedCategoryId is > 0)
                {
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                }
                <div class="relative flex-1 max-w-xl">
                    <i data-lucide="search" class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
                    <input type="search" name="q" value="@Model.Search" placeholder="Tìm tên món, mô tả, nhóm món..."
                           class="w-full rounded-2xl border border-slate-200 bg-slate-50/80 py-3 pl-11 pr-4 text-sm font-medium text-slate-800 outline-none transition focus:border-orange-300 focus:bg-white focus:ring-2 focus:ring-orange-100" />
                </div>
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-orange-500 px-6 py-3 text-sm font-bold text-white shadow-md shadow-orange-500/25 hover:bg-orange-600 transition shrink-0">
                    <i data-lucide="filter" class="h-4 w-4"></i>
                    Tìm kiếm
                </button>
            </form>

            <div class="mt-4 flex gap-2 overflow-x-auto pb-1 scrollbar-thin">
                <a href="@Url.Action("Gallery", "Menu", new { q = Model.Search })#gallery-grid"
                   class="category-pill shrink-0 rounded-full border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:border-orange-200 @(Model.SelectedCategoryId == null ? "active" : "")">
                    Tất cả
                </a>
                @foreach (var cat in categories.OrderBy(c => c.SortOrder))
                {
                    var active = Model.SelectedCategoryId == cat.Id;
                    <a href="@Url.Action("Gallery", "Menu", new { categoryId = cat.Id, q = Model.Search })#gallery-grid"
                       class="category-pill shrink-0 rounded-full border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:border-orange-200 @(active ? "active" : "")">
                        @cat.Name
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Grid -->
    <section id="gallery-grid" class="relative bg-gradient-to-b from-slate-50 to-white py-10 sm:py-14">
        <div class="pointer-events-none absolute left-1/2 top-0 h-48 w-[min(100%,40rem)] -translate-x-1/2 rounded-full bg-orange-100/50 blur-3xl"></div>
        <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6">

            @if (!string.IsNullOrEmpty(Model.LoadError))
            {
                <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">
                    <i class="fas fa-exclamation-circle mr-2"></i>Không tải được danh sách món: @Model.LoadError
                </div>
            }

            <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-orange-600">Kết quả</p>
                    <h2 class="text-xl font-black text-slate-900">@total món @(Model.SelectedCategoryId is > 0 ? "trong nhóm đã chọn" : "đang phục vụ")</h2>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a href="@Url.Action("Gallery", "Menu", new { categoryId = Model.SelectedCategoryId })"
                       class="text-xs font-bold text-slate-500 hover:text-orange-600">Xóa từ khóa «@Model.Search»</a>
                }
            </div>

            @if (!items.Any() && string.IsNullOrEmpty(Model.LoadError))
            {
                <div class="rounded-3xl border border-dashed border-slate-200 bg-white px-8 py-16 text-center">
                    <i data-lucide="utensils-crossed" class="mx-auto h-12 w-12 text-slate-300"></i>
                    <p class="mt-4 text-lg font-bold text-slate-700">Chưa có món phù hợp</p>
                    <p class="mt-1 text-sm text-slate-500">Thử đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    @foreach (var dish in items)
                    {
                        var catKey = dish.PrimarySlotKey ?? dish.CategoryLabel;
                        var badge = MenuDishDisplayHelper.CategoryBadgeClass(catKey);
                        var catLabel = !string.IsNullOrWhiteSpace(dish.CategoryLabel)
                            ? dish.CategoryLabel
                            : MenuDishDisplayHelper.CategoryLabel(catKey);
                        var img = !string.IsNullOrWhiteSpace(dish.ImageUrl) ? dish.ImageUrl : PlaceholderImg();
                        var desc = dish.Description;
                        if (!string.IsNullOrWhiteSpace(desc) && desc.Length > 100)
                            desc = desc[..100].TrimEnd() + "…";

                        <a asp-controller="Menu" asp-action="DishDetail" asp-route-id="@dish.Id"
                           class="dish-card group flex flex-col overflow-hidden rounded-[24px] border border-slate-100 bg-white">
                            <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
                                <img src="@img" alt="@dish.Name" loading="lazy"
                                     class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent opacity-80"></div>
                                <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
                                    <span class="text-[10px] font-black px-2.5 py-1 rounded-full border @badge bg-white/95 backdrop-blur-sm">@catLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(dish.DietaryLabel))
                                    {
                                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/90 text-white">@dish.DietaryLabel</span>
                                    }
                                </div>
                                <div class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full bg-orange-500 text-white shadow-lg opacity-0 transition group-hover:opacity-100 group-hover:translate-y-0 translate-y-1">
                                    <i data-lucide="arrow-up-right" class="h-4 w-4"></i>
                                </div>
                            </div>
                            <div class="flex flex-1 flex-col p-5">
                                <h3 class="text-base font-black text-slate-900 leading-snug line-clamp-2 group-hover:text-orange-600 transition-colors">@dish.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(desc))
                                {
                                    <p class="mt-2 text-xs leading-relaxed text-slate-500 line-clamp-2">@desc</p>
                                }
                                <div class="mt-auto pt-4 flex items-center justify-between border-t border-slate-50">
                                    @if (dish.Price > 0)
                                    {
                                        <span class="text-sm font-black text-orange-600">@dish.Price.ToString("N0")<span class="text-[10px] font-bold text-slate-400 ml-0.5">đ</span></span>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-bold text-slate-400">Giá theo hợp đồng</span>
                                    }
                                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 group-hover:text-orange-500">Chi tiết</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Phân trang">
                        @if (page > 1)
                        {
                            <a href="@BuildPageUrl(page - 1)" class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:border-orange-200 hover:text-orange-600">
                                <i data-lucide="chevron-left" class="h-4 w-4"></i>
                            </a>
                        }
                        @{
                            var start = Math.Max(1, page - 2);
                            var end = Math.Min(totalPages, page + 2);
                        }
                        @for (var p = start; p <= end; p++)
                        {
                            <a href="@BuildPageUrl(p)"
                               class="inline-flex h-10 min-w-[2.5rem] items-center justify-center rounded-xl px-3 text-sm font-bold @(p == page ? "bg-orange-500 text-white shadow-md shadow-orange-500/30" : "border border-slate-200 bg-white text-slate-600 hover:border-orange-200")">
                                @p
                            </a>
                        }
                        @if (page < totalPages)
                        {
                            <a href="@BuildPageUrl(page + 1)" class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:border-orange-200 hover:text-orange-600">
                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </a>
                        }
                    </nav>
                }
            }
        </div>
    </section>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', () => lucide.createIcons());</script>
}
