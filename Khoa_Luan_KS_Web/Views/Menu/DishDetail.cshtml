@using System.Text.Json
@model Khoa_Luan_KS_Web.Models.DishDetailPageViewModel
@using Khoa_Luan_KS_Web.Models
@using Khoa_Luan_KS_Web.Services
@{
    Layout = "_LayoutCustomer";
    var d = Model.Detail?.Dish;
    ViewData["Title"] = (d?.Name ?? "Chi tiết món") + " - HuitMeal";

    if (d == null && string.IsNullOrEmpty(Model.LoadError))
        ViewData["Title"] = "Không tìm thấy món - HuitMeal";

    var name = d?.Name ?? "Món ăn";
    var categoryRaw = d?.PrimarySlotKey ?? d?.Category;
    var categoryLabel = MenuDishDisplayHelper.CategoryLabel(categoryRaw);
    var categoryBadge = MenuDishDisplayHelper.CategoryBadgeClass(categoryRaw);
    var description = d?.Description?.Trim();
    var img = !string.IsNullOrWhiteSpace(d?.ImageUrl) ? d!.ImageUrl : null;
    var gallery = d?.Images?.Where(i => !string.IsNullOrWhiteSpace(i.Url)).OrderByDescending(i => i.Role == "cover").ThenBy(i => i.SortOrder).ToList()
        ?? new List<DishImageDto>();
    var priceTiers = (Model.Detail?.PriceTiers ?? new List<DishPriceTierClientDto>())
        .OrderBy(t => t.DishValue.SortOrder)
        .ThenBy(t => t.DishValue.Amount)
        .ToList();
    if (priceTiers.Count == 0 && (Model.Detail?.IngredientQuotas?.Count ?? 0) > 0)
    {
        var legacyQuotas = Model.Detail!.IngredientQuotas;
        var legacyGroups = legacyQuotas
            .GroupBy(q => q.DishValueId > 0 ? q.DishValueId : 0)
            .Select(g =>
            {
                var sample = g.First();
                var amount = sample.DishValueAmount > 0 ? sample.DishValueAmount : (d?.Price ?? 0);
                return new DishPriceTierClientDto
                {
                    DishValue = new DishValueClientDto
                    {
                        Id = sample.DishValueId > 0 ? sample.DishValueId : 1,
                        Amount = amount,
                        Label = !string.IsNullOrWhiteSpace(sample.DishValueLabel)
                            ? sample.DishValueLabel
                            : (amount > 0 ? $"{amount:N0}đ/suất" : "Mức chuẩn"),
                        SortOrder = 0
                    },
                    IngredientQuotas = g.ToList()
                };
            })
            .OrderBy(t => t.DishValue.Amount)
            .ToList();

        foreach (var tier in legacyGroups)
            tier.PortionWeightGrams = MenuDishDisplayHelper.ComputePortionWeightGrams(tier.IngredientQuotas);

        priceTiers = legacyGroups;
    }
    var defaultTier = MenuDishDisplayHelper.ResolveDefaultPriceTier(Model.Detail);
    var quotas = MenuDishDisplayHelper.ResolveIngredientQuotas(Model.Detail, defaultTier?.DishValue.Id);
    var (mainQuotas, spiceQuotas) = MenuDishDisplayHelper.SplitIngredientQuotas(quotas);
    var ingredientSummary = mainQuotas.Count > 0 && spiceQuotas.Count > 0
        ? $"{mainQuotas.Count} chính · {spiceQuotas.Count} gia vị"
        : $"{quotas.Count} loại";
    var priceTierJson = JsonSerializer.Serialize(priceTiers.Select(t => new
    {
        id = t.DishValue.Id,
        amount = t.DishValue.Amount,
        label = MenuDishDisplayHelper.FormatPriceTierLabel(t.DishValue),
        portionWeightGrams = t.PortionWeightGrams,
        portionLabel = MenuDishDisplayHelper.FormatPortionWeight(t.PortionWeightGrams),
        main = MenuDishDisplayHelper.SplitIngredientQuotas(t.IngredientQuotas).Main
            .Select(q => new { name = q.IngredientName, qty = MenuDishDisplayHelper.FormatQuotaQuantity(q.Quantity, q.Unit) }),
        spices = MenuDishDisplayHelper.SplitIngredientQuotas(t.IngredientQuotas).Spices
            .Select(q => new { name = q.IngredientName, qty = MenuDishDisplayHelper.FormatQuotaQuantity(q.Quantity, q.Unit) })
    }), new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var cookingLabel = MenuDishDisplayHelper.CookingMethodLabel(d?.CookingMethod);
    var hasNutrition = d?.Calories is > 0 || d?.Protein is > 0 || d?.Fat is > 0 || d?.Carbs is > 0;
    var placeholder = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=1200&q=80";
    var heroImg = img ?? placeholder;
    var ctx = Model.MenuContext;
    var relatedDishes = Model.RelatedDishes ?? new List<PublicDishBrowseItemClientDto>();
    var relatedCategoryId = Model.RelatedCategoryId;
    var cartSlotKey = MenuDishDisplayHelper.ResolveOrganizationSlotKey(categoryRaw) ?? categoryRaw?.Trim().ToLowerInvariant();
    var showDescription = !string.IsNullOrEmpty(description)
        && !string.Equals(description, name, StringComparison.OrdinalIgnoreCase)
        && description!.Length > name.Length + 8;
}

<style>
    .dish-detail-page {
        background:
            radial-gradient(900px 400px at 100% 0%, rgba(251, 146, 60, 0.1), transparent 55%),
            radial-gradient(700px 350px at 0% 30%, rgba(30, 58, 95, 0.05), transparent 50%),
            linear-gradient(180deg, #fafbfc 0%, #f1f5f9 100%);
    }
    .dish-main-panel {
        background: #fff;
        border: 1px solid rgba(226, 232, 240, 0.95);
        box-shadow: 0 8px 40px -12px rgba(15, 23, 42, 0.1);
    }
    .dish-media-col {
        background: linear-gradient(165deg, #f8fafc 0%, #f1f5f9 55%, #eef2f7 100%);
    }
    .dish-action-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px -6px rgba(15, 23, 42, 0.08);
    }
    .dish-hero-frame {
        box-shadow: 0 12px 32px -8px rgba(15, 23, 42, 0.18);
    }
    .dish-thumb.active {
        border-color: #f97316;
        box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.22);
    }
    .dish-stat-pill {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(226, 232, 240, 0.9);
        backdrop-filter: blur(6px);
    }
    .ingredient-chip {
        background: #fff;
        border: 1px solid #e2e8f0;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .ingredient-chip:hover {
        border-color: rgba(249, 115, 22, 0.35);
        box-shadow: 0 4px 12px -4px rgba(249, 115, 22, 0.2);
    }
    .ingredient-chip--spice {
        background: linear-gradient(135deg, #fffbeb 0%, #fff 100%);
        border-color: rgba(251, 191, 36, 0.35);
    }
    .price-tier-btn {
        border: 1px solid #e2e8f0;
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
    }
    .price-tier-btn:hover {
        border-color: rgba(249, 115, 22, 0.35);
    }
    .price-tier-btn.active {
        border-color: #f97316;
        background: linear-gradient(135deg, #fff7ed 0%, #fff 100%);
        box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
    }
    .related-card {
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .related-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -8px rgba(15, 23, 42, 0.12);
        border-color: rgba(249, 115, 22, 0.35);
    }
    .dish-detail-page ::-webkit-scrollbar { height: 6px; }
    .dish-detail-page ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    @@media (min-width: 1024px) {
        .dish-media-sticky { position: sticky; top: 5.5rem; }
    }
</style>

<div class="dish-detail-page min-h-screen"
     x-data='dishPriceQuotaPicker(@Html.Raw(priceTierJson))'
     x-init="setTimeout(() => loaded = true, 30)">

    @if (!string.IsNullOrEmpty(Model.LoadError) || d == null)
    {
        <div class="mx-auto max-w-lg px-4 pt-28 pb-20 text-center">
            <div class="rounded-2xl border border-amber-200 bg-white p-10 shadow-sm">
                <i data-lucide="alert-circle" class="mx-auto h-11 w-11 text-amber-500 mb-3"></i>
                <h1 class="text-lg font-bold text-slate-900">Không tải được món ăn</h1>
                <p class="mt-2 text-sm text-slate-600">@(Model.LoadError ?? "Món không tồn tại hoặc đã ngừng phục vụ.")</p>
                <a asp-controller="Menu" asp-action="Gallery"
                   class="mt-6 inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white hover:bg-orange-600 transition">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> Thư viện món
                </a>
            </div>
        </div>
    }
    else
    {
        <header class="border-b border-slate-200/80 bg-white/90 backdrop-blur-sm">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 py-3 pt-4 md:pt-5">
                <nav class="flex flex-wrap items-center gap-1.5 text-[11px] font-semibold text-slate-400 mb-2" aria-label="Breadcrumb">
                    <a href="/" class="hover:text-orange-600 transition">Trang chủ</a>
                    <i data-lucide="chevron-right" class="w-3 h-3"></i>
                    @if (ctx != null)
                    {
                        <a asp-controller="Menu" asp-action="Index" asp-route-menuId="@ctx.MenuId" class="hover:text-orange-600 transition">Thực đơn tuần</a>
                        <i data-lucide="chevron-right" class="w-3 h-3"></i>
                    }
                    else
                    {
                        <a asp-controller="Menu" asp-action="Gallery" class="hover:text-orange-600 transition">Thư viện món</a>
                        <i data-lucide="chevron-right" class="w-3 h-3"></i>
                    }
                    <span class="text-slate-700 truncate max-w-[200px] sm:max-w-md">@name</span>
                </nav>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="min-w-0 flex-1">
                        @if (!string.IsNullOrWhiteSpace(d!.NameEnglish))
                        {
                            <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 truncate">@d.NameEnglish</p>
                        }
                        <h1 class="text-xl sm:text-2xl lg:text-[1.65rem] font-black text-slate-900 tracking-tight">@name</h1>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                        <a asp-controller="Menu" asp-action="Gallery"
                           class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600 hover:border-orange-200 hover:text-orange-600 transition">
                            <i data-lucide="grid-3x3" class="w-3.5 h-3.5"></i> Thư viện
                        </a>
                        <a asp-controller="Menu" asp-action="Index"
                           class="inline-flex items-center gap-1.5 rounded-lg bg-orange-500 px-3 py-2 text-xs font-bold text-white hover:bg-orange-600 shadow-sm shadow-orange-500/30 transition">
                            <i data-lucide="calendar-days" class="w-3.5 h-3.5"></i> Thực đơn tuần
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <div class="mx-auto max-w-7xl px-4 sm:px-6 py-6 lg:py-8 space-y-8"
             :class="loaded ? 'opacity-100' : 'opacity-0'" style="transition: opacity .4s ease;">

            @if (TempData["CartSuccess"] is string cartOk && !string.IsNullOrEmpty(cartOk))
            {
                <div class="flex items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900">
                    <i data-lucide="check-circle" class="w-4 h-4 shrink-0"></i>
                    @cartOk
                    <a asp-controller="Cart" asp-action="Index" class="ml-auto text-xs font-bold text-emerald-700 hover:underline">Xem giỏ →</a>
                </div>
            }

            @if (ctx != null)
            {
                var slotVi = string.IsNullOrWhiteSpace(ctx.MealSlot) ? "" : MenuViewText.SlotLabel(ctx.MealSlot);
                <div class="flex flex-wrap items-center gap-3 rounded-xl border border-orange-200/80 bg-gradient-to-r from-orange-50 to-amber-50/50 px-4 py-3 text-sm">
                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-orange-500 text-white shrink-0">
                        <i data-lucide="calendar-check" class="w-4 h-4"></i>
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="text-[10px] font-black uppercase tracking-wider text-orange-600">Trong thực đơn tuần</p>
                        <p class="font-bold text-slate-800 text-sm">
                            @ctx.MenuStartDate.ToString("dd/MM") – @ctx.MenuEndDate.ToString("dd/MM/yyyy")
                            · @ctx.ScheduleDate.ToString("dddd dd/MM", new System.Globalization.CultureInfo("vi-VN"))
                            @if (!string.IsNullOrEmpty(slotVi)) { <span>· @slotVi</span> }
                        </p>
                    </div>
                    <a asp-controller="Menu" asp-action="Index" asp-route-menuId="@ctx.MenuId"
                       class="text-xs font-bold text-orange-700 hover:text-orange-800 whitespace-nowrap">← Quay lại tuần</a>
                </div>
            }

            <article class="dish-main-panel rounded-2xl lg:rounded-3xl overflow-hidden">
                <div class="grid lg:grid-cols-[minmax(0,380px)_1fr] lg:items-stretch">

                    <!-- Cột trái: ảnh + đặt món -->
                    <aside class="dish-media-col p-4 sm:p-5 lg:p-6 lg:border-r border-slate-200/80 flex flex-col">
                        <div class="dish-media-sticky flex flex-col gap-4">
                            <div class="relative dish-hero-frame rounded-2xl overflow-hidden bg-slate-200 aspect-[4/3] w-full shrink-0">
                                <img id="dish-hero-img" src="@heroImg" alt="@name"
                                     class="absolute inset-0 w-full h-full object-cover" />
                                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/50 to-transparent pointer-events-none"></div>
                                <div class="absolute bottom-3 left-3 right-3 flex flex-wrap gap-1.5">
                                    <span class="text-[10px] font-bold px-2.5 py-1 rounded-full border @categoryBadge bg-white/95 backdrop-blur-sm shadow-sm">@categoryLabel</span>
                                    @if (d.IsActive)
                                    {
                                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/95 text-white shadow-sm inline-flex items-center gap-1">
                                            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Đang phục vụ
                                        </span>
                                    }
                                </div>
                            </div>

                            @if (gallery.Count > 1)
                            {
                                <div class="flex gap-2 overflow-x-auto pb-0.5 shrink-0">
                                    @{ var thumbIdx = 0; }
                                    @foreach (var g in gallery)
                                    {
                                        var idx = thumbIdx++;
                                        <button type="button"
                                                @@click="activeThumb = @idx; document.getElementById('dish-hero-img').src = '@g.Url'"
                                                :class="activeThumb === @idx ? 'dish-thumb active' : 'dish-thumb'"
                                                class="w-14 h-14 rounded-lg border-2 border-slate-200/90 overflow-hidden shrink-0 transition-all hover:border-orange-300 bg-white">
                                            <img src="@g.Url" alt="" class="w-full h-full object-cover" />
                                        </button>
                                    }
                                </div>
                            }

                            <div class="dish-action-card rounded-2xl p-4 space-y-3">
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="dishId" value="@d!.Id" />
                                    <input type="hidden" name="name" value="@name" />
                                    <input type="hidden" name="price" value="@((d.Price).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                    <input type="hidden" name="imageUrl" value="@(img ?? "")" />
                                    <input type="hidden" name="slotKey" value="@cartSlotKey" />
                                    <input type="hidden" name="categoryLabel" value="@categoryLabel" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit"
                                            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-orange-500 px-4 py-3 text-sm font-bold text-white hover:bg-orange-600 transition shadow-md shadow-orange-500/20">
                                        <i data-lucide="plus" class="w-4 h-4"></i> Thêm vào giỏ hàng
                                    </button>
                                </form>
                                <div class="grid grid-cols-2 gap-2">
                                    <a asp-controller="Cart" asp-action="Index"
                                       class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs font-bold text-slate-700 hover:border-orange-200 hover:text-orange-600 transition">
                                        <i data-lucide="shopping-bag" class="w-4 h-4"></i> Giỏ
                                    </a>
                                    <a asp-controller="OrganizationMealOrder" asp-action="Index"
                                       class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-slate-900 px-3 py-2.5 text-xs font-bold text-white hover:bg-orange-600 transition">
                                        <i data-lucide="chef-hat" class="w-4 h-4"></i> Đặt suất
                                    </a>
                                </div>
                                <p class="text-[11px] leading-relaxed text-slate-500 text-center pt-1 border-t border-slate-100">
                                    Gom món theo nhóm trong giỏ, sau đó thiết lập đặt suất doanh nghiệp.
                                </p>
                            </div>

                            <p class="flex gap-2 text-[10px] leading-relaxed text-slate-400">
                                <i data-lucide="image" class="w-3 h-3 text-amber-600 shrink-0 mt-0.5"></i>
                                <span>@MenuDishDisplayHelper.ServingNotice.ImageCaption</span>
                            </p>
                        </div>
                    </aside>

                    <!-- Cột phải: thông tin + nguyên liệu -->
                    <div class="p-4 sm:p-5 lg:p-6 xl:p-7 flex flex-col gap-4 min-h-0">

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <div class="rounded-xl border border-slate-100 bg-slate-50/80 px-3 py-2.5">
                                <p class="text-[9px] font-black uppercase tracking-wider text-slate-400">Nhóm</p>
                                <p class="text-sm font-bold text-slate-800 mt-0.5 truncate">@categoryLabel</p>
                            </div>
                            <div class="rounded-xl border border-slate-100 bg-slate-50/80 px-3 py-2.5">
                                <p class="text-[9px] font-black uppercase tracking-wider text-slate-400">Chế biến</p>
                                <p class="text-sm font-bold text-slate-800 mt-0.5 truncate">@(string.IsNullOrEmpty(cookingLabel) ? "—" : cookingLabel)</p>
                            </div>
                            <div class="rounded-xl border border-slate-100 bg-slate-50/80 px-3 py-2.5">
                                <p class="text-[9px] font-black uppercase tracking-wider text-slate-400">Thành phần</p>
                                <p class="text-sm font-bold text-slate-800 mt-0.5">@ingredientSummary</p>
                            </div>
                            <div class="rounded-xl border border-slate-100 bg-slate-50/80 px-3 py-2.5">
                                <p class="text-[9px] font-black uppercase tracking-wider text-slate-400">Trạng thái</p>
                                <p class="text-sm font-bold mt-0.5 @(d.IsActive ? "text-emerald-600" : "text-slate-400")">@(d.IsActive ? "Phục vụ" : "Tạm ngưng")</p>
                            </div>
                        </div>

                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                            @if (!string.IsNullOrEmpty(d.Code))
                            {
                                <span class="text-[11px] font-mono text-slate-400">@d.Code</span>
                                <span class="text-slate-200 hidden sm:inline">·</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(d.DietaryLabel))
                            {
                                <span class="text-[11px] font-bold text-emerald-700">@d.DietaryLabel</span>
                            }
                        </div>

                        @if (showDescription)
                        {
                            <p class="text-sm text-slate-600 leading-relaxed border-l-[3px] border-orange-300 pl-3 py-0.5">@description</p>
                        }

                        @if (hasNutrition)
                        {
                            <div class="flex flex-wrap items-center gap-2 rounded-xl border border-slate-100 bg-white px-3 py-2.5">
                                <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 shrink-0">Dinh dưỡng/suất</span>
                                @if (d.Calories is > 0)
                                {
                                    <span class="text-xs font-bold text-slate-800 tabular-nums">@d.Calories.Value.ToString("N0") cal</span>
                                }
                                @if (d.Protein is > 0)
                                {
                                    <span class="text-xs font-bold text-slate-600 tabular-nums">P @d.Protein.Value.ToString("N0")g</span>
                                }
                                @if (d.Carbs is > 0)
                                {
                                    <span class="text-xs font-bold text-slate-600 tabular-nums">C @d.Carbs.Value.ToString("N0")g</span>
                                }
                                @if (d.Fat is > 0)
                                {
                                    <span class="text-xs font-bold text-slate-600 tabular-nums">F @d.Fat.Value.ToString("N0")g</span>
                                }
                            </div>
                        }

                        <div class="rounded-2xl border border-slate-200/90 bg-white overflow-hidden flex-1">
                            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-50/60 px-4 py-3 sm:px-5">
                                <div>
                                    <h2 class="text-sm font-black text-slate-900">Thành phần nguyên liệu</h2>
                                    <p class="text-[11px] text-slate-500 mt-0.5">
                                        Chọn mức giá suất để xem định lượng &amp; định mức nguyên liệu tương ứng
                                    </p>
                                </div>
                                <button type="button" @@click="showQuotaNote = !showQuotaNote"
                                        class="inline-flex items-center gap-1 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-800 hover:bg-amber-100 transition shrink-0">
                                    <i data-lucide="scale" class="w-3.5 h-3.5"></i>
                                    <span x-text="showQuotaNote ? 'Ẩn' : 'Định mức'"></span>
                                </button>
                            </div>

                            <div class="p-4 sm:p-5 space-y-4">
                                @if (priceTiers.Count > 0)
                                {
                                    <div class="rounded-xl border border-orange-100 bg-orange-50/40 p-3 sm:p-4 space-y-3">
                                        <div class="flex flex-wrap items-center justify-between gap-2">
                                            <p class="text-[10px] font-black uppercase tracking-wider text-orange-700">Mức giá suất ăn</p>
                                            <p x-show="selectedTier" class="text-[11px] font-bold text-slate-600">
                                                Định lượng: <span class="text-orange-700" x-text="selectedTier?.portionLabel || '—'"></span>
                                            </p>
                                        </div>
                                        <div class="flex flex-wrap gap-2">
                                            <template x-for="tier in tiers" :key="tier.id">
                                                <button type="button"
                                                        @@click="selectTier(tier.id)"
                                                        :class="selectedTierId === tier.id ? 'price-tier-btn active' : 'price-tier-btn'"
                                                        class="rounded-xl px-3 py-2 text-left min-w-[7.5rem]">
                                                    <span class="block text-sm font-black text-slate-900 tabular-nums" x-text="formatAmount(tier.amount)"></span>
                                                    <span class="block text-[10px] font-semibold text-slate-500 mt-0.5 line-clamp-1" x-text="tier.label"></span>
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                }

                                <div x-show="showQuotaNote" x-transition.opacity.duration.200ms
                                     class="rounded-xl border border-amber-200/80 bg-amber-50/80 px-3 py-2.5 text-[12px] leading-relaxed text-amber-950/85">
                                    <p class="font-bold text-amber-900 text-[11px] uppercase mb-0.5">@MenuDishDisplayHelper.ServingNotice.IngredientTitle</p>
                                    <p>@MenuDishDisplayHelper.ServingNotice.IngredientBody</p>
                                </div>

                                <template x-if="selectedTier && selectedTier.main.length > 0">
                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-400 mb-2">Nguyên liệu chính</p>
                                        <div class="grid sm:grid-cols-2 gap-2">
                                            <template x-for="(q, idx) in selectedTier.main" :key="'main-' + idx">
                                                <div class="ingredient-chip rounded-lg px-3 py-2 flex items-center justify-between gap-2">
                                                    <span class="text-sm font-semibold text-slate-800 truncate" x-text="q.name"></span>
                                                    <span class="text-[11px] font-bold text-orange-700 bg-orange-50 border border-orange-100 rounded-md px-2 py-0.5 tabular-nums shrink-0" x-text="q.qty"></span>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <template x-if="selectedTier && selectedTier.spices.length > 0">
                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-400 mb-2">Gia vị &amp; nước chấm</p>
                                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-1.5">
                                            <template x-for="(q, idx) in selectedTier.spices" :key="'spice-' + idx">
                                                <div class="ingredient-chip ingredient-chip--spice rounded-lg px-2.5 py-1.5 flex items-center justify-between gap-1.5 min-h-[2.25rem]">
                                                    <span class="text-[12px] font-medium text-slate-700 truncate leading-tight" x-text="q.name"></span>
                                                    <span class="text-[10px] font-bold text-amber-800 tabular-nums shrink-0" x-text="q.qty"></span>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <p x-show="!selectedTier || (selectedTier.main.length === 0 && selectedTier.spices.length === 0)"
                                   class="text-sm text-slate-400 text-center py-6">
                                    Chưa khai báo nguyên liệu cho mức giá này.
                                </p>
                            </div>

                            <div class="border-t border-slate-100 bg-gradient-to-r from-slate-50/90 to-amber-50/30 px-4 py-3.5 sm:px-5">
                                <p class="flex gap-2.5 text-[11px] leading-relaxed text-slate-500">
                                    <i data-lucide="info" class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"></i>
                                    <span>@MenuDishDisplayHelper.ServingNotice.DetailFooterNote</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <section class="pb-4 space-y-6">
                <div class="rounded-3xl border border-slate-200/90 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 sm:p-8 text-white shadow-xl">
                    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
                        <div class="max-w-2xl">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-300">Suất ăn trưa công nghiệp</p>
                            <h2 class="mt-2 text-xl font-black sm:text-2xl">Đưa món vào thực đơn doanh nghiệp</h2>
                            <p class="mt-2 text-sm leading-relaxed text-slate-300">
                                Món được phục vụ theo suất trong thực đơn tuần hoặc đơn đặt suất theo hợp đồng.
                                Chọn mức giá suất, số ngày phục vụ và địa điểm giao — phù hợp bữa trưa tập thể tại nhà máy, văn phòng.
                            </p>
                            @if (priceTiers.Count > 0)
                            {
                                <p class="mt-3 text-xs font-semibold text-orange-200">
                                    Mức giá suất: @string.Join(" · ", priceTiers.Select(t => MenuDishDisplayHelper.FormatPriceTierLabel(t.DishValue)))
                                </p>
                            }
                        </div>
                        <div class="flex flex-col gap-2 sm:flex-row lg:flex-col xl:flex-row shrink-0">
                            <a asp-controller="OrganizationMealOrder" asp-action="Index"
                               class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-500 px-5 py-3 text-sm font-black text-white hover:bg-orange-600 shadow-lg shadow-orange-500/30 transition">
                                <i data-lucide="chef-hat" class="w-4 h-4"></i> Thiết lập đặt suất
                            </a>
                            <a asp-controller="Menu" asp-action="Index"
                               class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-bold text-white hover:bg-white/15 transition">
                                <i data-lucide="calendar-days" class="w-4 h-4"></i> Thực đơn tuần
                            </a>
                        </div>
                    </div>
                </div>

                @if (relatedDishes.Count > 0)
                {
                    <div>
                        <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
                            <div>
                                <h2 class="text-lg font-black text-slate-900 tracking-tight">Món cùng nhóm · @categoryLabel</h2>
                                <p class="text-xs text-slate-500 mt-0.5">Tham khảo thêm món cùng loại trong danh mục phục vụ</p>
                            </div>
                            @if (relatedCategoryId is int catId)
                            {
                                <a asp-controller="Menu" asp-action="Gallery" asp-route-categoryId="@catId"
                                   class="text-xs font-bold text-orange-600 hover:text-orange-700 hover:underline">
                                    Xem tất cả @categoryLabel →
                                </a>
                            }
                        </div>

                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
                            @foreach (var item in relatedDishes)
                            {
                                var relatedImg = !string.IsNullOrWhiteSpace(item.ImageUrl) ? item.ImageUrl! : placeholder;
                                var detailUrl = Url.Action("DishDetail", "Menu", new { id = item.Id, menuId = ctx?.MenuId }) ?? $"/Menu/DishDetail/{item.Id}";

                                <article class="related-card group rounded-2xl border border-slate-200/90 bg-white overflow-hidden shadow-sm">
                                    <a href="@detailUrl" class="block relative aspect-[5/4] overflow-hidden bg-slate-100">
                                        <img src="@relatedImg" alt="@item.Name" loading="lazy"
                                             class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                                        <span class="absolute top-2 left-2 rounded-md bg-slate-900/75 backdrop-blur px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white line-clamp-1 max-w-[85%]">
                                            @categoryLabel
                                        </span>
                                    </a>
                                    <div class="p-3">
                                        <h3 class="text-sm font-bold text-slate-900 line-clamp-1 group-hover:text-orange-600 transition">
                                            <a href="@detailUrl" class="hover:text-orange-600">@item.Name</a>
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(item.DietaryLabel))
                                        {
                                            <p class="text-[10px] text-emerald-700 mt-1 font-semibold line-clamp-1">@item.DietaryLabel</p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="text-[10px] text-slate-500 mt-1 line-clamp-2">@item.Description</p>
                                        }
                                        <a href="@detailUrl"
                                           class="mt-2.5 w-full inline-flex items-center justify-center gap-1 rounded-lg bg-orange-50 text-orange-700 border border-orange-100 px-2 py-2 text-[11px] font-bold hover:bg-orange-100 transition">
                                            <i data-lucide="eye" class="w-3.5 h-3.5"></i> Xem chi tiết
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    }
</div>

@section Scripts {
    <script>
        function dishPriceQuotaPicker(tiers) {
            const list = Array.isArray(tiers) ? tiers : [];
            const firstId = list.length > 0 ? list[0].id : null;
            return {
                loaded: false,
                activeThumb: 0,
                showQuotaNote: false,
                tiers: list,
                selectedTierId: firstId,
                get selectedTier() {
                    return this.tiers.find(t => t.id === this.selectedTierId) || this.tiers[0] || null;
                },
                selectTier(id) {
                    this.selectedTierId = id;
                },
                formatAmount(amount) {
                    const n = Number(amount);
                    if (!Number.isFinite(n)) return '—';
                    return n.toLocaleString('vi-VN') + 'đ';
                }
            };
        }

        document.addEventListener('DOMContentLoaded', () => lucide.createIcons());
    </script>
}
