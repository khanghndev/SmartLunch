@using Khoa_Luan_KS_Web.Models
@using Khoa_Luan_KS_Web.Services
@{
    ViewData["Title"] = MenuViewText.PageTitle;
    Layout = "_LayoutCustomer";

    var menuList = ViewData["MenuList"] as GetWeeklyMenusClientResponse;
    var menuDetail = ViewData["MenuDetail"] as GetWeeklyMenuDetailClientResponse;
    var apiError = ViewData["ApiError"] as string;
    var customerProfileKey = ViewData["CustomerProfileKey"] as string;

    var schedules = menuDetail?.Schedules ?? new List<WeeklyMenuScheduleDetailClientDto>();
    var menu = menuDetail?.WeeklyMenu;
    var allSlots = schedules.Select(s => s.MealSlot).Distinct().OrderBy(s => s).ToList();
    var byDate = schedules.GroupBy(s => s.Date.Date).OrderBy(g => g.Key).ToList();

    string ProfileQuerySuffix() =>
        string.IsNullOrEmpty(customerProfileKey) ? "" : "&profile=" + Uri.EscapeDataString(customerProfileKey);

    string DayLabel(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday => "T2",
        DayOfWeek.Tuesday => "T3",
        DayOfWeek.Wednesday => "T4",
        DayOfWeek.Thursday => "T5",
        DayOfWeek.Friday => "T6",
        DayOfWeek.Saturday => "T7",
        DayOfWeek.Sunday => "CN",
        _ => d.DayOfWeek.ToString()
    };
}

<style>
    [x-cloak] { display: none !important; }
    .menu-hero-gradient {
        background: radial-gradient(1200px 600px at 80% -10%, rgba(251, 146, 60, 0.22), transparent 55%),
                    radial-gradient(900px 500px at -10% 30%, rgba(148, 163, 184, 0.18), transparent 50%),
                    linear-gradient(180deg, #fffdfb 0%, #f8fafc 100%);
    }
    .menu-table-wrap {
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.06), 0 24px 48px -12px rgba(15, 23, 42, 0.12);
    }
    .menu-slot-head {
        background: linear-gradient(135deg, #059669 0%, #047857 50%, #0f766e 100%);
    }
    @@media print {
        .no-print { display: none !important; }
        #menu-section { background: #fff !important; }
    }
</style>

<div class="w-full overflow-x-hidden font-sans text-slate-900" x-data="{ isLoaded: false }" x-init="setTimeout(() => isLoaded = true, 50)">

    <section class="menu-hero-gradient relative border-b border-orange-100/60">
        <div class="pointer-events-none absolute inset-0 opacity-[0.35]" style="background-image:url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23f97316\' fill-opacity=\'0.06\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
        <div class="relative z-10 mx-auto flex max-w-7xl flex-col gap-10 px-4 pb-16 pt-24 sm:px-6 lg:flex-row lg:items-center lg:gap-16 lg:pb-20 lg:pt-28">
            <div class="max-w-xl flex-1 space-y-6" :class="isLoaded ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4'" style="transition: opacity .7s ease, transform .7s ease;">
                <div class="inline-flex items-center gap-2 rounded-full border border-orange-200/80 bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.2em] text-orange-600 shadow-sm backdrop-blur-sm">
                    <span class="h-1.5 w-1.5 rounded-full bg-orange-500"></span>
                    @MenuViewText.HeroBadge
                </div>
                <h1 class="text-4xl font-black leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
                    @MenuViewText.HeroH1Line1<br />
                    <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">@MenuViewText.HeroH1Gradient</span>
                    <span class="text-slate-800">@MenuViewText.HeroH1Rest</span>
                </h1>
                <p class="text-base leading-relaxed text-slate-600 sm:text-lg">
                    @MenuViewText.HeroLead
                </p>
                <div class="no-print flex flex-wrap items-center gap-3">
                    <button type="button" @@click="document.getElementById('menu-section').scrollIntoView({ behavior: 'smooth' })"
                            class="inline-flex items-center gap-2 rounded-2xl bg-orange-500 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-orange-500/30 transition hover:bg-orange-600">
                        <i data-lucide="calendar-days" class="h-5 w-5"></i>
                        @MenuViewText.BtnViewWeek
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-orange-200 hover:text-orange-600">
                        <i data-lucide="shopping-cart" class="h-5 w-5"></i>
                        @MenuViewText.BtnCart
                    </a>
                </div>
            </div>
            <div class="relative mx-auto w-full max-w-md flex-1 lg:max-w-none" :class="isLoaded ? 'opacity-100' : 'opacity-0'" style="transition: opacity .9s ease .1s;">
                <div class="relative aspect-[4/3] overflow-hidden rounded-3xl border border-white/60 bg-white shadow-2xl shadow-slate-900/10 ring-1 ring-slate-900/5">
                    <img src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&amp;fit=crop&amp;w=1200&amp;q=80" alt="" class="h-full w-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-tr from-slate-900/50 via-transparent to-orange-500/20"></div>
                    <div class="absolute bottom-4 left-4 right-4 rounded-2xl border border-white/30 bg-white/90 p-4 shadow-lg backdrop-blur-md sm:bottom-6 sm:left-6 sm:right-6">
                        <p class="text-xs font-bold uppercase tracking-wider text-orange-600">@MenuViewText.HeroCardTitle</p>
                        <p class="text-sm font-semibold text-slate-800">@MenuViewText.HeroCardBody</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative z-10 border-b border-slate-800/10 bg-slate-900 py-10 text-white">
        <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 sm:grid-cols-4 sm:gap-8 sm:px-6">
            @foreach (var (n, l, i) in new[] { ("500+", MenuViewText.Stat1, "utensils-crossed"), ("30", MenuViewText.Stat2, "calendar-days"), ("100%", MenuViewText.Stat3, "shield-check"), ("3+", MenuViewText.Stat4, "map-pin") })
            {
                <div class="text-center">
                    <i data-lucide="@i" class="mx-auto mb-2 h-7 w-7 text-orange-400"></i>
                    <p class="text-2xl font-black sm:text-3xl">@n</p>
                    <p class="mt-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">@l</p>
                </div>
            }
        </div>
    </section>

    <section id="menu-section" class="relative bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
        <div class="pointer-events-none absolute left-1/2 top-0 h-64 w-[min(100%,48rem)] -translate-x-1/2 rounded-full bg-orange-100/40 blur-3xl"></div>

        <div class="relative z-10 mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-10">

            @if (TempData["CartSuccess"] is string cartOk && !string.IsNullOrEmpty(cartOk))
            {
                <div class="no-print mb-4 flex items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900">
                    <i data-lucide="check-circle" class="h-5 w-5 shrink-0"></i>
                    @cartOk
                </div>
            }
            @if (TempData["CartError"] is string cartBad && !string.IsNullOrEmpty(cartBad))
            {
                <div class="no-print mb-4 flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-900">
                    <i data-lucide="alert-circle" class="h-5 w-5 shrink-0"></i>
                    @cartBad
                </div>
            }

            <div class="mb-10 text-center">
                <p class="mb-2 text-[10px] font-black uppercase tracking-[0.35em] text-orange-500">@MenuViewText.SectionKicker</p>
                <h2 class="mx-auto mb-3 max-w-3xl text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                    @MenuViewText.SectionTitle
                </h2>
                <p class="mx-auto mb-8 max-w-2xl text-sm text-slate-600 sm:text-base">
                    @MenuViewText.SectionLead<strong class="text-orange-600">@MenuViewText.SectionLeadStrong</strong>@MenuViewText.SectionLeadEnd
                </p>
                <div class="no-print flex flex-wrap items-center justify-center gap-2 sm:gap-3">
                    <button type="button" onclick="window.print()"
                            class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm hover:border-orange-300 hover:text-orange-600 sm:text-sm">
                        <i data-lucide="printer" class="h-4 w-4"></i>
                        @MenuViewText.BtnPrint
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="inline-flex items-center gap-2 rounded-xl bg-orange-500 px-4 py-2.5 text-xs font-black text-white shadow-md hover:bg-orange-600 sm:text-sm">
                        <i data-lucide="shopping-cart" class="h-4 w-4"></i>
                        @MenuViewText.BtnCart
                    </a>
                    <a asp-controller="Cart" asp-action="Checkout" class="inline-flex items-center gap-2 rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-xs font-bold text-orange-800 hover:bg-orange-100 sm:text-sm">
                        @MenuViewText.BtnCheckout
                    </a>
                    <a asp-controller="Profile" asp-action="Orders" class="inline-flex items-center gap-1 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-600 hover:text-orange-600 sm:text-sm">
                        <i data-lucide="package" class="h-4 w-4"></i>
                        @MenuViewText.BtnMyOrders
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(apiError))
            {
                <div class="mb-6 flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                    <i data-lucide="alert-triangle" class="mt-0.5 h-5 w-5 shrink-0"></i>
                    <span>@MenuViewText.ApiErrorPrefix<strong>@apiError</strong></span>
                </div>
            }

            @if (menuList != null && menuList.Items.Any())
            {
                <div class="no-print mb-8 overflow-x-auto pb-1">
                    <div class="flex min-w-min flex-wrap items-center gap-2">
                        <span class="mr-1 flex shrink-0 items-center gap-1.5 text-sm font-bold text-slate-500">
                            <i data-lucide="calendar-range" class="h-4 w-4 text-orange-500"></i>
                            @MenuViewText.WeekPickerLabel
                        </span>
                        @foreach (var m in menuList.Items.OrderByDescending(x => x.StartDate).Take(12))
                        {
                            var isSel = menu?.Id == m.Id;
                            var isCur = m.StartDate.Date <= DateTime.Today && m.EndDate.Date >= DateTime.Today;
                            <a href="/Menu/Index?menuId=@m.Id@(ProfileQuerySuffix())#menu-section"
                               class="shrink-0 rounded-full border px-3 py-2 text-xs font-bold transition-all sm:px-4 sm:text-sm @(isSel ? "border-emerald-700 bg-emerald-600 text-white shadow-md shadow-emerald-600/25" : "border-slate-200 bg-white text-slate-700 hover:border-emerald-300 hover:text-emerald-700")">
                                @m.StartDate.ToString("dd/MM") &ndash; @m.EndDate.ToString("dd/MM")
                                @if (isCur)
                                {
                                    <span class="ml-1 opacity-90">@MenuViewText.WeekCurrent</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            }

            @if (menuDetail == null || !schedules.Any())
            {
                <div class="rounded-3xl border border-slate-100 bg-white/90 p-12 text-center shadow-sm backdrop-blur-sm">
                    <i data-lucide="utensils-crossed" class="mx-auto mb-4 h-12 w-12 text-slate-300"></i>
                    @if (menuList == null)
                    {
                        <p class="text-lg font-semibold text-slate-700">@MenuViewText.EmptyLoginTitle</p>
                        <p class="mt-2 text-sm text-slate-500">@MenuViewText.EmptyLoginSub</p>
                    }
                    else
                    {
                        <p class="text-lg font-semibold text-slate-700">@MenuViewText.EmptyNoDishesTitle</p>
                        <p class="mt-2 text-sm text-slate-500">@MenuViewText.EmptyNoDishesSub</p>
                    }
                </div>
            }
            else
            {
                <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between">
                    <div class="flex flex-wrap items-center gap-3">
                        <div class="inline-flex items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-2.5 text-sm shadow-sm">
                            <i data-lucide="calendar" class="h-4 w-4 text-emerald-600"></i>
                            <span class="font-bold text-slate-800">@menu!.StartDate.ToString("dd/MM/yyyy") &ndash; @menu.EndDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="inline-flex items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-2.5 text-sm shadow-sm">
                            <i data-lucide="chef-hat" class="h-4 w-4 text-orange-500"></i>
                            <span class="font-bold text-slate-800">@schedules.Count@MenuViewText.MetaDishCount</span>
                        </div>
                        @if (!string.IsNullOrEmpty(menu.Description))
                        {
                            <div class="max-w-full rounded-2xl border border-slate-100 bg-white px-4 py-2.5 text-sm text-slate-600 shadow-sm">
                                @menu.Description
                            </div>
                        }
                    </div>
                    <form asp-controller="Cart" asp-action="AddWeekMenu" method="post" class="no-print flex w-full flex-col gap-2 sm:max-w-md lg:w-auto lg:min-w-[280px] lg:max-w-none lg:items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="weeklyMenuId" value="@menu.Id" />
                        <input type="hidden" name="replaceExisting" value="true" />
                        <button type="submit"
                                class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 px-5 py-3.5 text-sm font-black text-white shadow-lg shadow-orange-500/30 transition hover:from-orange-600 hover:to-amber-600 sm:w-auto">
                            <i data-lucide="shopping-basket" class="h-5 w-5"></i>
                            @MenuViewText.BtnAddWholeWeek
                        </button>
                        <p class="text-center text-[11px] leading-snug text-slate-500 lg:text-right">
                            @MenuViewText.BtnAddWholeWeekHint
                        </p>
                    </form>
                </div>

                <div class="menu-table-wrap overflow-hidden rounded-3xl border border-slate-200/80 bg-white">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[920px] table-fixed border-collapse text-left">
                            <colgroup>
                                <col class="w-[92px]" />
                                @foreach (var __ in allSlots)
                                {
                                    <col />
                                }
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="menu-slot-head px-2 py-4 text-center text-[11px] font-black uppercase tracking-wider text-white sm:px-3 sm:text-xs">
                                        Ng&#224;y
                                    </th>
                                    @foreach (var slot in allSlots)
                                    {
                                        <th class="menu-slot-head border-l border-white/15 px-3 py-4 text-[11px] font-black uppercase tracking-wider text-white sm:px-4 sm:text-xs">
                                            @MenuViewText.SlotLabel(slot)
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-[13px]">
                                @foreach (var group in byDate)
                                {
                                    var isToday = group.Key == DateTime.Today;
                                    <tr class="@(isToday ? "bg-orange-50/90" : "bg-white hover:bg-slate-50/80")">
                                        <td class="border-r border-slate-100 p-3 text-center align-top sm:p-4">
                                            <div class="mx-auto flex w-[76px] flex-col items-center justify-center rounded-2xl border-2 py-2.5 font-black transition-colors @(isToday ? "border-orange-500 bg-orange-500 text-white shadow-md" : "border-slate-200 bg-slate-50 text-slate-800")">
                                                <span class="text-sm leading-none">@DayLabel(group.Key)</span>
                                                <span class="mt-1 text-[10px] font-bold opacity-85">@group.Key.ToString("dd/MM")</span>
                                            </div>
                                        </td>
                                        @foreach (var slot in allSlots)
                                        {
                                            var dishes = group.Where(s => s.MealSlot == slot).ToList();
                                            <td class="border-r border-slate-100 p-2 align-top last:border-r-0 sm:p-3">
                                                @if (!dishes.Any())
                                                {
                                                    <div class="flex min-h-[3rem] items-center justify-center rounded-xl border border-dashed border-slate-200 bg-slate-50/50">
                                                        <span class="text-xs text-slate-300">&mdash;</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <ul class="space-y-2">
                                                        @foreach (var s in dishes)
                                                        {
                                                            <li class="group rounded-2xl border border-slate-100 bg-gradient-to-b from-white to-slate-50/80 p-3 shadow-sm transition hover:border-orange-200 hover:shadow-md">
                                                                <a href="@Url.Action("MealDetail", "Menu", new { menuId = menu!.Id, scheduleId = s.Id })"
                                                                   class="line-clamp-2 font-bold leading-snug text-slate-900 group-hover:text-orange-600">
                                                                    @s.Dish.Name
                                                                </a>
                                                                @if (!string.IsNullOrEmpty(s.Dish.Category))
                                                                {
                                                                    <p class="mt-1 truncate text-[11px] font-medium text-slate-500">@s.Dish.Category</p>
                                                                }
                                                                <div class="mt-3 border-t border-slate-100/80 pt-2">
                                                                    <span class="text-sm font-black text-emerald-700">@s.Dish.Price.ToString("N0") @MenuViewText.CurrencyDong</span>
                                                                </div>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <p class="mt-6 flex items-center justify-center gap-2 text-center text-xs text-slate-500">
                    <i data-lucide="info" class="h-4 w-4 shrink-0 text-slate-400"></i>
                    @MenuViewText.TableFootnote
                </p>
            }
        </div>
    </section>

    <section class="border-t border-slate-100 bg-white py-14">
        <div class="mx-auto max-w-7xl px-4 text-center sm:px-6">
            <p class="mb-8 text-[10px] font-black uppercase tracking-[0.3em] text-slate-400">@MenuViewText.CertKicker</p>
            <div class="flex flex-wrap justify-center gap-3 md:gap-4">
                @foreach (var cert in new[] { "ISO 22000:2018", "HACCP", "VietGAP", MenuViewText.CertB1, MenuViewText.CertB2 })
                {
                    <div class="flex items-center gap-2 rounded-2xl border border-slate-100 bg-slate-50 px-4 py-2.5 transition hover:-translate-y-0.5 hover:border-emerald-200 hover:bg-white hover:shadow-md md:px-5 md:py-3">
                        <i data-lucide="badge-check" class="h-5 w-5 text-emerald-600"></i>
                        <span class="text-xs font-bold text-slate-800 md:text-sm">@cert</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="relative overflow-hidden py-16 sm:py-20">
        <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1555243896-c709bfa0b564?auto=format&amp;fit=crop&amp;w=1920&amp;q=80" alt="" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-br from-slate-950/95 via-slate-900/90 to-orange-950/80"></div>
        </div>
        <div class="relative z-10 mx-auto max-w-3xl px-4 text-center sm:px-6">
            <span class="mb-4 inline-flex rounded-full border border-orange-400/30 bg-orange-500/10 px-4 py-1.5 text-[10px] font-black uppercase tracking-[0.25em] text-orange-200">@MenuViewText.CtaKicker</span>
            <h2 class="mb-4 text-3xl font-black leading-tight text-white sm:text-4xl md:text-5xl">
                @MenuViewText.CtaTitle1<br />
                <span class="bg-gradient-to-r from-orange-300 to-amber-200 bg-clip-text text-transparent">@MenuViewText.CtaTitle2</span>
            </h2>
            <p class="mb-10 text-base text-slate-300">
                @MenuViewText.CtaLead
            </p>
            <div class="flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
                <a href="/Customer/Contact" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-orange-500 px-8 py-4 text-sm font-bold text-white shadow-xl shadow-orange-900/40 transition hover:bg-orange-400">
                    <i data-lucide="calendar-check" class="h-5 w-5"></i>
                    @MenuViewText.CtaBtn1
                </a>
                <a href="tel:0966741866" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/25 bg-white/10 px-8 py-4 text-sm font-bold text-white backdrop-blur-sm transition hover:bg-white/20">
                    <i data-lucide="phone" class="h-5 w-5"></i>
                    0966 741 866
                </a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) lucide.createIcons();
        });
    </script>
}
