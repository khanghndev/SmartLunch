@{
    ViewData["Title"] = "Thực đơn tiêu biểu - HuitMeal";
    Layout = "_LayoutCustomer";
}

<style>
    [x-cloak] { display: none !important; }
    .glass-panel {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }
    .text-gradient {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .card-hover-effect {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-hover-effect:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1);
    }
    .card-hover-effect img {
        transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-hover-effect:hover img {
        transform: scale(1.05);
    }
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
    .animate-float-delay {
        animation: float 6s ease-in-out infinite;
        animation-delay: 3s;
    }
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
        100% { transform: translateY(0px); }
    }
</style>

<div class="w-full bg-transparent overflow-hidden font-sans" x-data="{ activeTab: 'school', isLoaded: false }" x-init="setTimeout(() => isLoaded = true, 100)">

    <!-- HERO SECTION -->
    <section class="relative min-h-[90vh] flex items-center pt-24 pb-32 overflow-hidden bg-transparent">
        <!-- Background decorative elements -->
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-orange-50/80 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-slate-100 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4 pointer-events-none"></div>
        
        <div class="max-w-7xl mx-auto px-6 w-full relative z-10 grid lg:grid-cols-2 gap-16 items-center">
            
            <!-- Hero Text -->
            <div class="space-y-8" 
                 :class="isLoaded ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-12'" 
                 style="transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);">
                <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-orange-50 border border-orange-100 shadow-sm">
                    <span class="flex h-2 w-2 rounded-full bg-orange-500">
                        <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-orange-400 opacity-75"></span>
                    </span>
                    <span class="text-orange-600 text-[10px] font-black uppercase tracking-[0.2em]">Khám phá ẩm thực HuitMeal</span>
                </div>
                
                <h1 class="text-5xl md:text-7xl font-black text-slate-900 tracking-tight leading-[1.1]">
                    Thực Đơn <br />
                    <span class="text-gradient">Tinh Hoa</span> 
                    &amp; Dinh Dưỡng
                </h1>
                
                <p class="text-slate-600 text-lg max-w-lg font-medium leading-relaxed">
                    Hơn <span class="text-orange-500 font-bold">500+ món ăn</span> được thiết kế chuyên biệt bởi các chuyên gia dinh dưỡng hàng đầu, mang đến bữa ăn chuẩn vị, tốt cho sức khỏe.
                </p>
                
                <div class="flex flex-wrap items-center gap-6 pt-4">
                    <button @@click="document.getElementById('menu-section').scrollIntoView({behavior:'smooth'})" class="px-8 py-4 bg-orange-500 text-white rounded-2xl font-bold hover:bg-orange-600 transition-all shadow-xl shadow-orange-500/30 hover:shadow-orange-500/40 hover:-translate-y-1 flex items-center gap-2">
                        Xem thực đơn <i data-lucide="arrow-down" class="w-5 h-5"></i>
                    </button>
                    <div class="flex items-center hidden sm:flex">
                        <div class="flex -space-x-4">
                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80" class="w-12 h-12 rounded-full border-4 border-white object-cover" />
                            <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=100&q=80" class="w-12 h-12 rounded-full border-4 border-white object-cover" />
                            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80" class="w-12 h-12 rounded-full border-4 border-white object-cover" />
                            <div class="w-12 h-12 rounded-full border-4 border-white bg-slate-100 flex items-center justify-center z-10">
                                <span class="text-[10px] font-black text-slate-600">+10k</span>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-black text-slate-800 leading-tight">Khách hàng</p>
                            <p class="text-[11px] font-medium text-slate-500">mỗi ngày</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Images -->
            <div class="relative h-[600px] hidden lg:block"
                 :class="isLoaded ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-16'"
                 style="transition: all 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;">
                <!-- Main Image -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[480px] h-[480px] rounded-[40px] overflow-hidden shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-700">
                    <img src="https://images.unsplash.com/photo-1547592180-85f173990554?q=80&w=1000" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
                </div>
                <!-- Floating Card 1 -->
                <div class="absolute top-12 -left-8 glass-panel p-4 rounded-3xl shadow-xl animate-float flex items-center gap-4 z-20">
                    <div class="w-12 h-12 bg-green-50 rounded-2xl flex items-center justify-center text-green-500 border border-green-100">
                        <i data-lucide="leaf" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">Nguyên liệu</p>
                        <p class="text-sm font-black text-slate-900">100% Sạch & Tươi</p>
                    </div>
                </div>
                <!-- Floating Card 2 -->
                <div class="absolute bottom-20 -right-8 glass-panel p-6 rounded-3xl shadow-xl animate-float-delay flex flex-col gap-2 w-56 z-20">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-[10px] font-black text-orange-500 uppercase tracking-widest">Đánh giá</span>
                        <div class="flex text-amber-400 gap-0.5">
                            <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                            <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                            <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                            <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                            <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                        </div>
                    </div>
                    <p class="text-4xl font-black text-slate-900">4.9<span class="text-lg text-slate-400">/5</span></p>
                    <p class="text-[11px] font-medium text-slate-500 leading-tight">Được tin dùng bởi 500+ đối tác doanh nghiệp và trường học</p>
                </div>
            </div>
        </div>
    </section>

    <!-- STATS STRIP -->
    <section class="bg-slate-900 py-12 relative z-20">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-white/10">
            @foreach(var (n,l,i) in new[]{("500+","Món ăn đa dạng","utensils-crossed"),("30","Ngày không trùng","calendar-days"),("100%","An toàn thực phẩm","shield-check"),("3","Vùng miền đặc trưng","map")})
            {
                <div class="text-center px-4 group cursor-default">
                    <i data-lucide="@i" class="w-8 h-8 text-orange-400 mx-auto mb-4 opacity-80 group-hover:scale-110 group-hover:opacity-100 group-hover:text-orange-300 transition-all duration-300"></i>
                    <p class="text-3xl md:text-5xl font-black text-white mb-2">@n</p>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em]">@l</p>
                </div>
            }
        </div>
    </section>

    <!-- MENU SECTION -->
    <section id="menu-section" class="py-20 bg-slate-50/50">
        <div class="max-w-[1440px] mx-auto px-6 lg:px-8">
            
            <div class="text-center mb-16 relative z-10">
                <p class="text-orange-500 text-[10px] font-black uppercase tracking-[0.3em] mb-3">Thực đơn đa dạng</p>
                <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-6 tracking-tight">Thực Đơn <span class="text-orange-500 relative">Hàng Tuần
                    <svg class="absolute -bottom-2 left-0 w-full text-orange-200 h-3" viewBox="0 0 100 20" preserveAspectRatio="none"><path d="M0,10 Q50,20 100,10" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
                </span></h2>
                <p class="text-slate-500 max-w-2xl mx-auto font-medium text-sm md:text-base leading-relaxed">Hệ thống thực đơn được thiết kế khoa học, thay đổi mỗi tuần đảm bảo cung cấp đầy đủ dinh dưỡng và hương vị đa dạng cho mọi đối tượng khách hàng.</p>
            </div>

            <div class="flex flex-col lg:flex-row gap-8 items-start relative z-10"
                 x-data="{ 
                     activeCategory: 'cong-nghiep', 
                     activeSubMenu: 'mau-1',
                     menus: {
                         'cong-nghiep': { title: 'Suất ăn công nghiệp', icon: 'factory', sub: [{id: 'mau-1', name: 'Thực đơn mẫu 1'}, {id: 'mau-2', name: 'Thực đơn mẫu 2'}, {id: 'mau-3', name: 'Thực đơn mẫu 3'}] },
                         'hoc-sinh': { title: 'Suất ăn học sinh', icon: 'graduation-cap', sub: [{id: 'mau-1', name: 'Mầm non & Tiểu học'}, {id: 'mau-2', name: 'THCS & THPT'}] },
                         'van-phong': { title: 'Cơm hộp văn phòng', icon: 'briefcase', sub: [{id: 'mau-1', name: 'Set Tiêu chuẩn'}, {id: 'mau-2', name: 'Set Eat Clean'}] },
                         'theo-ban': { title: 'Thực đơn theo bàn', icon: 'users', sub: [{id: 'mau-1', name: 'Set Menu 1'}, {id: 'mau-2', name: 'Set Menu 2'}] },
                         'buffet': { title: 'Thực đơn buffet', icon: 'utensils-crossed', sub: [{id: 'mau-1', name: 'Buffet Cơ bản'}, {id: 'mau-2', name: 'Buffet Cao cấp'}] },
                         'tea-break': { title: 'Thực đơn Tea - Break', icon: 'coffee', sub: [{id: 'mau-1', name: 'Gói Tiêu chuẩn'}, {id: 'mau-2', name: 'Gói Đặc biệt'}] }
                     }
                 }">
                 
                 <!-- Sidebar -->
                 <div class="w-full lg:w-[320px] shrink-0 bg-white rounded-3xl p-5 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 lg:sticky lg:top-28">
                     <div class="flex items-center gap-3 mb-6 px-2">
                         <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center">
                             <i data-lucide="list-tree" class="w-5 h-5 text-orange-500"></i>
                         </div>
                         <h3 class="text-lg font-black text-slate-900">Danh mục thực đơn</h3>
                     </div>
                     <div class="space-y-3">
                         <template x-for="(catData, catKey) in menus" :key="catKey">
                             <div class="border border-slate-100 rounded-2xl overflow-hidden transition-all duration-300"
                                  :class="activeCategory === catKey ? 'ring-1 ring-green-500/20 shadow-md bg-white' : 'bg-slate-50 hover:bg-white hover:border-slate-200'">
                                 <button @@click="activeCategory = catKey; activeSubMenu = catData.sub[0].id" 
                                         class="w-full px-5 py-4 flex items-center justify-between group transition-colors"
                                         :class="activeCategory === catKey ? 'bg-green-600 text-white' : 'text-slate-700 hover:text-green-600'">
                                     <div class="flex items-center gap-3">
                                         <i :data-lucide="catData.icon" class="w-5 h-5" :class="activeCategory === catKey ? 'text-white' : 'text-green-600 opacity-70'"></i>
                                         <span class="font-bold text-[15px]" x-text="catData.title"></span>
                                     </div>
                                     <i data-lucide="chevron-down" class="w-4 h-4 transition-transform duration-300" :class="activeCategory === catKey ? 'rotate-180' : ''"></i>
                                 </button>
                                 
                                 <div x-show="activeCategory === catKey" 
                                      x-transition:enter="transition ease-out duration-200"
                                      x-transition:enter-start="opacity-0 -translate-y-2"
                                      x-transition:enter-end="opacity-100 translate-y-0"
                                      class="bg-white border-t border-slate-100">
                                     <div class="p-2.5 space-y-1">
                                         <template x-for="sub in catData.sub" :key="sub.id">
                                             <button @@click="activeSubMenu = sub.id" 
                                                     class="w-full text-left px-11 py-2.5 rounded-xl font-bold text-[13px] transition-all flex items-center gap-2"
                                                     :class="activeSubMenu === sub.id ? 'bg-orange-50 text-orange-600' : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'">
                                                 <span class="w-1.5 h-1.5 rounded-full transition-colors" :class="activeSubMenu === sub.id ? 'bg-orange-500' : 'bg-slate-300'"></span>
                                                 <span x-text="sub.name"></span>
                                             </button>
                                         </template>
                                     </div>
                                 </div>
                             </div>
                         </template>
                     </div>
                 </div>

                 <!-- Main Content -->
                 <div class="flex-1 w-full bg-white rounded-3xl p-6 lg:p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 overflow-hidden">
                     <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8 pb-6 border-b border-slate-100 gap-4">
                         <div>
                             <h3 class="text-2xl font-black text-slate-900 mb-2 uppercase tracking-tight" x-text="menus[activeCategory].title + ' - ' + menus[activeCategory].sub.find(s => s.id === activeSubMenu).name"></h3>
                             <p class="text-slate-500 text-[13px] font-medium flex items-center gap-1.5"><i data-lucide="info" class="w-4 h-4 text-orange-400"></i> Thực đơn chỉ mang tính chất tham khảo, có thể điều chỉnh theo yêu cầu.</p>
                         </div>
                         <div class="flex gap-2 shrink-0">
                             <button class="flex items-center gap-2 px-4 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-xl font-bold text-sm transition-colors border border-slate-200 shadow-sm">
                                 <i data-lucide="printer" class="w-4 h-4"></i> In
                             </button>
                             <button class="flex items-center gap-2 px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-xl font-bold text-sm transition-colors shadow-lg shadow-orange-500/20 border border-orange-600">
                                 <i data-lucide="download" class="w-4 h-4"></i> Tải PDF
                             </button>
                         </div>
                     </div>

                     <!-- Weekly Grid Data -->
                     <div class="overflow-x-auto w-full rounded-2xl border border-slate-200 shadow-sm custom-scrollbar">
                         <table class="w-full min-w-[950px] text-left border-collapse bg-white">
                             <thead>
                                 <tr>
                                     <th class="w-20 px-4 py-4 bg-green-600 text-white font-black text-[13px] uppercase tracking-wider border-b border-green-700 text-center">Ngày</th>
                                     <th class="px-5 py-4 bg-green-600 text-white font-black text-[13px] uppercase tracking-wider border-b border-green-700 border-l border-green-500/30">Ca 1 (Sáng)</th>
                                     <th class="px-5 py-4 bg-green-600 text-white font-black text-[13px] uppercase tracking-wider border-b border-green-700 border-l border-green-500/30">Ca 2 (Trưa)</th>
                                     <th class="px-5 py-4 bg-green-600 text-white font-black text-[13px] uppercase tracking-wider border-b border-green-700 border-l border-green-500/30">M. Xào</th>
                                     <th class="px-5 py-4 bg-green-600 text-white font-black text-[13px] uppercase tracking-wider border-b border-green-700 border-l border-green-500/30">M. Canh</th>
                                     <th class="px-5 py-4 bg-green-600 text-white font-black text-[13px] uppercase tracking-wider border-b border-green-700 border-l border-green-500/30 text-center">T. Miệng</th>
                                     <th class="px-5 py-4 bg-green-600 text-white font-black text-[13px] uppercase tracking-wider border-b border-green-700 border-l border-green-500/30">Ca 3 (Chiều)</th>
                                 </tr>
                             </thead>
                             <tbody class="text-[13px] font-medium text-slate-700 divide-y divide-slate-200">
                                 <!-- T2 -->
                                 <tr class="hover:bg-slate-50 transition-colors group">
                                     <td class="px-4 py-6 align-top border-r border-slate-100 text-center">
                                         <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-slate-100 text-slate-700 font-black text-lg border border-slate-200 group-hover:bg-orange-50 group-hover:text-orange-600 group-hover:border-orange-200 transition-colors">T2</div>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <ul class="space-y-2.5">
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Bánh canh cua</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Bánh bao</li>
                                         </ul>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <ul class="space-y-2.5">
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-orange-400 mt-1.5 shrink-0"></div>Sườn kho tiêu</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-orange-400 mt-1.5 shrink-0"></div>Trứng ốp la</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-orange-400 mt-1.5 shrink-0"></div>Cá thu nhật sốt cà</li>
                                         </ul>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <span class="inline-block px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-100 leading-tight">Giá - cải chua xào</span>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <span class="inline-block px-3 py-1.5 bg-sky-50 text-sky-700 rounded-lg text-xs font-bold border border-sky-100 leading-tight">Cải ngọt thịt bằm</span>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100 text-center">
                                         <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 rounded-full text-[11px] font-black border border-amber-200 uppercase">Nhãn</span>
                                     </td>
                                     <td class="px-5 py-6 align-top">
                                         <ul class="space-y-2.5">
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Cá bống kho tiêu</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Đậu hũ dồn thịt</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Bò xào đậu ve</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Hủ tiếu xào</li>
                                         </ul>
                                     </td>
                                 </tr>
                                 <!-- T3 -->
                                 <tr class="hover:bg-slate-50 transition-colors group">
                                     <td class="px-4 py-6 align-top border-r border-slate-100 text-center">
                                         <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-slate-100 text-slate-700 font-black text-lg border border-slate-200 group-hover:bg-orange-50 group-hover:text-orange-600 group-hover:border-orange-200 transition-colors">T3</div>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <ul class="space-y-2.5">
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Bún bò</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-slate-400 mt-1.5 shrink-0"></div>Mỳ xào giòn</li>
                                         </ul>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <ul class="space-y-2.5">
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-orange-400 mt-1.5 shrink-0"></div>Gà kho lá chanh</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-orange-400 mt-1.5 shrink-0"></div>Trứng chiên cuộn thịt</li>
                                             <li class="flex items-start gap-2"><div class="w-1 h-1 rounded-full bg-orange-400 mt-1.5 shrink-0"></div>Cá bạc má chiên</li>
                                         </ul>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <span class="inline-block px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-100 leading-tight">Bầu luộc</span>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100">
                                         <span class="inline-block px-3 py-1.5 bg-sky-50 text-sky-700 rounded-lg text-xs font-bold border border-sky-100 leading-tight">Mướp - rau ngót nấu tôm khô</span>
                                     </td>
                                     <td class="px-5 py-6 align-top border-r border-slate-100 text-center">
                                         <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 rounded-full text-[11px] font-black border border-amber-200 uppercase">Chuối</span>
                                     </td>
                                     <td class="px-5 py-6 align-top">
