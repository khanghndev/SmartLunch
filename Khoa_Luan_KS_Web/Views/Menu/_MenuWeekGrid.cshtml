@model MenuWeekGridViewModel
@using Khoa_Luan_KS_Web.Models

@{
    var byDate = Model.ByDate;
    var allSlots = Model.AllSlots;
    var menu = Model.Menu;
    var defaultDishImg = Model.DefaultDishImg;
}

<div class="no-print mb-6 space-y-3">
    <div class="menu-day-nav flex gap-2 overflow-x-auto pb-1">
        <button type="button" @@click="activeDay = 'all'"
                :class="activeDay === 'all' ? 'border-emerald-600 bg-emerald-600 text-white shadow-md' : 'border-slate-200 bg-white text-slate-700 hover:border-emerald-300'"
                class="shrink-0 rounded-full border px-4 py-2 text-xs font-bold transition sm:text-sm">
            @MenuViewText.FilterAllDays
        </button>
        @foreach (var groupNav in byDate)
        {
            var dayKeyNav = groupNav.Key.ToString("yyyy-MM-dd");
            var isTodayNav = groupNav.Key == DateTime.Today;
            <button type="button" @@click="activeDay = '@dayKeyNav'"
                    :class="activeDay === '@dayKeyNav' ? 'border-emerald-600 bg-emerald-600 text-white shadow-md' : 'border-slate-200 bg-white text-slate-700 hover:border-emerald-300'"
                    class="shrink-0 rounded-full border px-4 py-2 text-xs font-bold transition sm:text-sm">
                @MenuViewText.DayLabelShort(groupNav.Key) @groupNav.Key.ToString("dd/MM")
                @if (isTodayNav)
                {
                    <span class="ml-1 opacity-90">· @MenuViewText.TodayBadge</span>
                }
            </button>
        }
    </div>
    @if (allSlots.Count > 1)
    {
        <div class="flex flex-wrap gap-2">
            <button type="button" @@click="activeSlot = 'all'"
                    :class="activeSlot === 'all' ? 'bg-orange-500 text-white border-orange-500' : 'bg-white text-slate-600 border-slate-200'"
                    class="rounded-xl border px-3 py-1.5 text-xs font-bold transition">
                @MenuViewText.FilterAllSlots
            </button>
            @foreach (var slotFilter in allSlots)
            {
                <button type="button" @@click="activeSlot = '@slotFilter'"
                        :class="activeSlot === '@slotFilter' ? 'bg-orange-500 text-white border-orange-500' : 'bg-white text-slate-600 border-slate-200'"
                        class="rounded-xl border px-3 py-1.5 text-xs font-bold transition">
                    @MenuViewText.SlotLabel(slotFilter)
                </button>
            }
        </div>
    }
</div>

<div class="space-y-8">
    @foreach (var group in byDate)
    {
        var dayKey = group.Key.ToString("yyyy-MM-dd");
        var isToday = group.Key == DateTime.Today;
        var dayDishes = group.ToList();

        <section x-show="activeDay === 'all' || activeDay === '@dayKey'" x-cloak
                 class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-4 py-4 sm:px-6">
                <div class="flex items-center gap-3">
                    <div class="flex h-14 w-14 flex-col items-center justify-center rounded-2xl font-black @(isToday ? "bg-orange-500 text-white shadow-md shadow-orange-500/30" : "bg-emerald-50 text-emerald-800 ring-1 ring-emerald-100")">
                        <span class="text-base leading-none">@MenuViewText.DayLabelShort(group.Key)</span>
                        <span class="mt-0.5 text-[10px] font-bold opacity-90">@group.Key.ToString("dd/MM")</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-black text-slate-900 sm:text-xl">
                            @group.Key.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))
                        </h3>
                        <p class="text-xs font-medium text-slate-500">@dayDishes.Count món</p>
                    </div>
                </div>
                @if (isToday)
                {
                    <span class="rounded-full bg-orange-100 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-orange-700">
                        @MenuViewText.TodayBadge
                    </span>
                }
            </header>

            <div class="p-4 sm:p-6">
                @{
                    var slotGroups = dayDishes
                        .GroupBy(s => s.MealSlot)
                        .OrderBy(g => allSlots.IndexOf(g.Key))
                        .ToList();
                }
                @foreach (var slotGroup in slotGroups)
                {
                    <div x-show="activeSlot === 'all' || activeSlot === '@slotGroup.Key'" class="mb-6 last:mb-0">
                        @if (allSlots.Count > 1)
                        {
                            <div class="mb-3 flex items-center gap-2">
                                <span class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-white">
                                    <i data-lucide="clock" class="h-3.5 w-3.5"></i>
                                    @MenuViewText.SlotLabel(slotGroup.Key)
                                </span>
                                <span class="h-px flex-1 bg-slate-100"></span>
                            </div>
                        }

                        <ul class="menu-dish-grid grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                            @foreach (var s in slotGroup)
                            {
                                var img = !string.IsNullOrEmpty(s.Dish.ImageUrl) ? s.Dish.ImageUrl : defaultDishImg;
                                <li class="menu-dish-card group flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm hover:border-orange-200 hover:shadow-lg">
                                    <a href="@Url.Action("DishDetail", "Menu", new { id = s.DishId, menuId = menu.Id, scheduleId = s.Id })"
                                       class="relative block aspect-[4/3] overflow-hidden bg-slate-100">
                                        <img src="@img" alt="@s.Dish.Name" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
                                    </a>
                                    <div class="flex flex-1 flex-col p-3.5">
                                        <a href="@Url.Action("DishDetail", "Menu", new { id = s.DishId, menuId = menu.Id, scheduleId = s.Id })"
                                           class="line-clamp-2 text-sm font-bold leading-snug text-slate-900 hover:text-orange-600">
                                            @s.Dish.Name
                                        </a>
                                        @if (!string.IsNullOrEmpty(s.Dish.Category))
                                        {
                                            <p class="mt-1 line-clamp-1 text-[11px] font-medium text-slate-500">@s.Dish.Category</p>
                                        }
                                        <div class="mt-auto flex items-end justify-between gap-2 pt-3">
                                            <span class="text-base font-black text-emerald-700">@s.Dish.Price.ToString("N0") @MenuViewText.CurrencyDong</span>
                                            <div class="no-print flex shrink-0 gap-1.5">
                                                <a href="@Url.Action("DishDetail", "Menu", new { id = s.DishId, menuId = menu.Id, scheduleId = s.Id })"
                                                   class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-[10px] font-bold text-slate-600 hover:border-orange-200 hover:text-orange-600"
                                                   title="@MenuViewText.BtnViewDetail">
                                                    <i data-lucide="eye" class="h-3.5 w-3.5"></i>
                                                </a>
                                                <form asp-controller="Cart" asp-action="Add" method="post" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="dishId" value="@s.DishId" />
                                                    <input type="hidden" name="name" value="@s.Dish.Name" />
                                                    <input type="hidden" name="price" value="@s.Dish.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                    <input type="hidden" name="imageUrl" value="@(s.Dish.ImageUrl ?? "")" />
                                                    <input type="hidden" name="menuScheduleId" value="@s.Id" />
                                                    <input type="hidden" name="scheduleDateUtc" value="@s.Date.ToUniversalTime().ToString("o")" />
                                                    <input type="hidden" name="mealSlot" value="@s.MealSlot" />
                                                    <input type="hidden" name="quantity" value="1" />
                                                    <button type="submit"
                                                            class="inline-flex items-center gap-1 rounded-lg bg-orange-500 px-2.5 py-1.5 text-[10px] font-black text-white shadow-sm hover:bg-orange-600"
                                                            title="@MenuViewText.BtnAddToCart">
                                                        <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                                                        @MenuViewText.BtnAddToCart
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </section>
    }
</div>
