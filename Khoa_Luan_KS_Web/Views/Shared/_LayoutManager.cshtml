<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartLunch Manager</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome (matching React) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="flex flex-col min-h-screen bg-gray-50 text-gray-800" x-data="{ sidebarOpen: false }">
    
    <!-- HEADER -->
    <header class="bg-white shadow px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between z-20 relative">
        <div class="flex items-center gap-3">
            <button class="md:hidden p-2 text-green-600 rounded shadow bg-green-50" x-on:click="sidebarOpen = !sidebarOpen">
                <i class="fas fa-bars"></i>
            </button>
            <div class="w-10 h-10 bg-green-100 flex items-center justify-center rounded text-green-600 font-bold">SL</div>
            <h1 class="hidden sm:block text-lg sm:text-xl font-bold text-green-600">Ngọc Tâm i-food</h1>
        </div>
        
        <div class="flex items-center gap-2 sm:gap-4 relative" x-data="{ profileOpen: false }">
            <i class="fas fa-lock text-green-600 text-lg"></i>
            <button x-on:click="profileOpen = !profileOpen" class="flex items-center gap-2 px-3 py-1 rounded hover:bg-green-50 transition bg-white relative">
                <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-gray-600">M</div>
                <span class="font-medium text-gray-700">Manager User</span>
                <i class="fas fa-chevron-down text-gray-500 text-sm"></i>
            </button>
            <!-- Dropdown -->
            <div x-show="profileOpen" x-on:click.outside="profileOpen = false" x-cloak class="absolute right-0 top-full mt-2 w-48 bg-white shadow-lg rounded-md py-2 z-50">
                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-green-100 hover:text-green-700 flex items-center gap-2">
                    <i class="fas fa-user"></i> Cập nhật thông tin
                </a>
                <a href="/Auth/LogOut" class="block px-4 py-2 text-sm text-gray-700 hover:bg-green-100 hover:text-green-700 flex items-center gap-2">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </div>
        </div>
    </header>

    <div class="flex flex-1 flex-col md:flex-row overflow-hidden relative">
        <!-- OVERLAY MOBILE -->
        <div x-show="sidebarOpen" x-on:click="sidebarOpen = false" x-cloak class="fixed inset-0 bg-black/30 z-30 md:hidden"></div>

        <!-- SIDEBAR -->
        <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'" class="fixed inset-y-0 left-0 z-40 w-64 bg-white shadow-xl transform transition-transform duration-300 md:relative md:translate-x-0 overflow-y-auto" x-data="{ openMenu: null }">
            <nav class="flex flex-col gap-2 p-4 min-h-full">
                <!-- 1. Dashboard -->
                <a href="/Manager/Index" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-home w-5 text-center"></i> Dashboard
                </a>

                <!-- 2. Quản lý danh mục -->
                <div>
                    <button x-on:click="openMenu = openMenu === 'catalog' ? null : 'catalog'" class="w-full flex items-center justify-between p-2 rounded transition-colors hover:bg-green-100 hover:text-green-700">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-list-alt w-5 text-center"></i> <span>Quản lý danh mục</span>
                        </div>
                        <i :class="openMenu === 'catalog' ? 'fa-chevron-up' : 'fa-chevron-down'" class="fas text-xs"></i>
                    </button>
                    <div x-show="openMenu === 'catalog'" x-collapse class="pl-6 pt-1 flex flex-col gap-1">
                        <a href="/Manager/CatalogEmployees" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-user-friends w-4 text-center"></i> Nhân viên</a>
                        <a href="/Manager/CatalogSuppliers" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-truck w-4 text-center"></i> Nhà cung cấp</a>
                        <a href="/Manager/CatalogCustomers" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-user-tie w-4 text-center"></i> Khách hàng</a>
                        <a href="/Manager/CatalogMeals" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-pizza-slice w-4 text-center"></i> Suất ăn</a>
                    </div>
                </div>

                <!-- 3. Quản lý thực đơn -->
                <div>
                    <button x-on:click="openMenu = openMenu === 'menu' ? null : 'menu'" class="w-full flex items-center justify-between p-2 rounded transition-colors hover:bg-green-100 hover:text-green-700">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-utensils w-5 text-center"></i> <span>Quản lý thực đơn</span>
                        </div>
                        <i :class="openMenu === 'menu' ? 'fa-chevron-up' : 'fa-chevron-down'" class="fas text-xs"></i>
                    </button>
                    <div x-show="openMenu === 'menu'" x-collapse class="pl-6 pt-1 flex flex-col gap-1">
                        <a href="/Manager/MenuDashboard" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-chart-bar w-4 text-center"></i> Dashboard bếp</a>
                        <a href="/Manager/MenuWeekly" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-clipboard-list w-4 text-center"></i> Menu tuần</a>
                        <a href="/Manager/MenuDish" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-list-alt w-4 text-center"></i> Quản lý món</a>
                        <a href="/Manager/MenuHistory" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-history w-4 text-center"></i> Lịch sử menu</a>
                        <a href="/Manager/MenuIngredients" class="flex items-center gap-2 p-2 rounded hover:bg-green-100 hover:text-green-700 text-sm"><i class="fas fa-warehouse w-4 text-center"></i> Tính nguyên liệu</a>
                    </div>
                </div>

                <!-- 4. QL ATTP -->
                <a href="/Manager/FoodSafety" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "FoodSafety" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-shield-alt w-5 text-center"></i> Quản lý ATTP
                </a>

                <!-- 5. QL đơn hàng -->
                <a href="/Manager/Orders" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-file-invoice-dollar w-5 text-center"></i> Quản lý đơn hàng
                </a>

                <!-- 6. Báo cáo & TX -->
                <a href="/Manager/Finance" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Finance" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-chart-bar w-5 text-center"></i> Báo cáo & Thống kê
                </a>

                <!-- 7. Phản hồi -->
                <a href="/Manager/Feedback" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Feedback" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-comment-alt w-5 text-center"></i> Phản hồi & khiếu nại
                </a>

                <!-- 8. Công nợ -->
                <a href="/Manager/Debts" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Debts" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-money-bill-wave w-5 text-center"></i> Thanh toán & Công nợ
                </a>

                <!-- 9. Tồn kho -->
                <a href="/Manager/Inventory" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Inventory" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-warehouse w-5 text-center"></i> Quản lý tồn kho
                </a>

                <!-- 10. Nhập hàng -->
                <a href="/Manager/Import" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Import" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-file-import w-5 text-center"></i> Quản lý nhập hàng
                </a>

                <!-- 11. Giao hàng -->
                <a href="/Manager/Delivery" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Delivery" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-shipping-fast w-5 text-center"></i> Quản lý giao hàng
                </a>

                <!-- 12. Hợp đồng -->
                <a href="/Manager/Contracts" class="flex items-center gap-2 p-2 rounded transition-colors @(ViewContext.RouteData.Values["action"]?.ToString() == "Contracts" ? "bg-green-500 text-white" : "hover:bg-green-100 hover:text-green-700")">
                    <i class="fas fa-file-invoice-dollar w-5 text-center"></i> Quản lý hợp đồng
                </a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="flex-1 p-4 sm:p-6 overflow-y-auto bg-gray-50">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
