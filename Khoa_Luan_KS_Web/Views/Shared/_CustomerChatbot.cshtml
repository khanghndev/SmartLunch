<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('huitMealChatbot', (isOrgUser = false) => ({
        isOrgUser: !!isOrgUser,
        chatOpen: false,
        isTyping: false,
        input: '',
        unreadHint: true,
        messages: [],
        quickReplies: [],

        init() {
            this.quickReplies = this.isOrgUser
                ? ['Cần thanh toán bao nhiêu', 'Đơn hàng gần đây', 'Hợp đồng hiện tại', 'Thực đơn tuần này']
                : ['Thực đơn tuần', 'Đặt suất ăn DN', 'Giá & thanh toán', 'An toàn thực phẩm'];
        },

        toggleChatbot() {
            this.chatOpen = !this.chatOpen;
            if (this.chatOpen) {
                this.unreadHint = false;
                if (this.messages.length === 0) this.pushBot(this.welcomeText());
                this.$nextTick(() => {
                    this.scrollToBottom();
                    this.$refs.chatInput?.focus();
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                });
            }
        },

        welcomeText() {
            if (this.isOrgUser) {
                return 'Xin chào! Tôi tra cứu trực tiếp từ cơ sở dữ liệu HuitMeal.\n\nBạn có thể hỏi:\n• Tổng tiền đơn hàng\n• Đơn hàng gần đây\n• Hợp đồng & thực đơn tuần\n• Hạn chốt đơn, thanh toán, giao hàng';
            }
            return 'Xin chào! Tôi là trợ lý HuitMeal. Đăng nhập tài khoản doanh nghiệp để tra cứu đơn hàng thật từ hệ thống.';
        },

        nowLabel() {
            return new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        },

        toLines(text) {
            return (text || '').split('\n').map(l => l.trimEnd()).filter(l => l.length > 0);
        },

        escapeHtml(s) {
            return String(s ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        },

        /** Tránh Alpine x-html cắt nội dung tại dấu : trong giờ (VD: 17:00). */
        protectTimes(text) {
            const times = [];
            const safe = (text || '').replace(/\b(\d{1,2}:\d{2})\b/g, (_, t) => {
                times.push(t);
                return `__HM_TIME_${times.length - 1}__`;
            });
            return { safe, times };
        },

        restoreTimes(text, times) {
            let out = text || '';
            times.forEach((t, i) => {
                out = out.split(`__HM_TIME_${i}__`).join(t.replace(':', 'h'));
            });
            return out;
        },

        splitLabelValue(line) {
            const idx = line.indexOf(':');
            if (idx < 2 || idx > 40) return null;
            const key = line.slice(0, idx).trim();
            const val = line.slice(idx + 1).trim();
            if (!val || val.length < 2) return null;
            if (val.includes(';') || val.length > 72) return null;
            if (/^\d/.test(key)) return null;
            if (/^(Bước|Phục vụ)\s/i.test(key)) return null;
            return [key, val];
        },

        normalizeBotText(text) {
            let t = (text || '').trim();
            const i = t.toLowerCase().lastIndexOf('gợi ý:');
            if (i >= 0) t = t.slice(0, i).trim();
            return t
                .replace(/\*\*([^*]+)\*\*/g, '$1')
                .replace(/^\*\s+/gm, '• ')
                .replace(/\*\*/g, '')
                .replace(/\b(\d{1,2}):(\d{2})\b/g, '$1h$2')
                .replace(/\n{3,}/g, '\n\n');
        },

        formatBotHtml(text) {
            const { safe, times } = this.protectTimes(this.normalizeBotText(text));
            const lines = safe.split('\n').map(l => l.trim()).filter(Boolean);
            if (!lines.length) return '';

            let html = '';
            let inCard = false;

            const closeCard = () => {
                if (inCard) { html += '</div>'; inCard = false; }
            };

            for (const raw of lines) {
                const line = raw.replace(/^[•\-]\s*/, '').trim();
                const displayLine = this.restoreTimes(line, times);

                if (/^(Khiếu nại|Đơn|Hợp đồng|📦)\s/i.test(displayLine) && !displayLine.includes(':')) {
                    closeCard();
                    html += `<p class="hm-title">${this.escapeHtml(displayLine)}</p>`;
                    inCard = true;
                    html += '<div class="hm-card">';
                    continue;
                }

                if (/tổng tiền|tổng cộng|cần thanh toán|tổng giá trị/i.test(displayLine)) {
                    html += `<p class="hm-highlight">${this.escapeHtml(displayLine)}</p>`;
                    continue;
                }

                const kv = this.splitLabelValue(displayLine);
                if (kv) {
                    html += `<div class="hm-row"><span class="hm-row__k">${this.escapeHtml(kv[0])}</span><span class="hm-row__v">${this.escapeHtml(kv[1])}</span></div>`;
                    continue;
                }

                if (/^[•\-]/.test(raw) || /^Bước\s+\d/i.test(displayLine) || /^T[2-7]\s/i.test(displayLine)) {
                    html += `<div class="hm-bullet">${this.escapeHtml(displayLine)}</div>`;
                    continue;
                }

                closeCard();
                html += `<p class="hm-para">${this.escapeHtml(displayLine)}</p>`;
            }
            closeCard();
            return html;
        },

        pushUser(text) {
            this.messages.push({ role: 'user', text, html: '', time: this.nowLabel() });
        },
        pushBot(text) {
            const clean = this.normalizeBotText(text);
            this.messages.push({
                role: 'bot',
                text: clean,
                html: this.formatBotHtml(clean),
                time: this.nowLabel()
            });
        },

        scrollToBottom() {
            const el = this.$refs.chatScroll;
            if (el) requestAnimationFrame(() => { el.scrollTop = el.scrollHeight; });
        },

        sendQuick(text) { this.input = text; this.sendMessage(); },

        applySuggestions(list) {
            if (Array.isArray(list) && list.length > 0)
                this.quickReplies = list.slice(0, 4);
        },

        async sendMessage() {
            const text = this.input.trim();
            if (!text || this.isTyping) return;
            this.pushUser(text);
            this.input = '';
            this.isTyping = true;
            this.$nextTick(() => this.scrollToBottom());

            if (this.isOrgUser) {
                try {
                    const res = await fetch('/Chatbot/Send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'same-origin',
                        body: JSON.stringify({ message: text })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        this.pushBot(data.error || 'Không thể tra cứu. Vui lòng đăng nhập lại hoặc gọi hotline.');
                    } else {
                        this.pushBot(data.reply || 'Không có phản hồi.');
                        this.applySuggestions(data.suggestions);
                    }
                } catch {
                    this.pushBot('Mất kết nối máy chủ. Vui lòng thử lại hoặc liên hệ hotline 0334 297 551.');
                }
            } else {
                await new Promise(r => setTimeout(r, 450));
                this.pushBot(this.generateGuestReply(text));
            }

            this.isTyping = false;
            this.$nextTick(() => {
                this.scrollToBottom();
                if (typeof lucide !== 'undefined') lucide.createIcons();
            });
        },

        generateGuestReply(q) {
            const s = q.toLowerCase();
            if (/thực đơn|menu|món|tuần/.test(s))
                return 'Xem thực đơn tại Dịch vụ → Thực đơn cố định hoặc Thực đơn tự chọn (đơn vị).';
            if (/đặt|đơn|suất|doanh nghiệp|tổ chức/.test(s))
                return 'Khách DN đăng nhập để tra cứu đơn hàng thật từ hệ thống.';
            if (/giá|thanh toán|hóa đơn|tổng tiền/.test(s))
                return 'Đăng nhập tài khoản DN và hỏi \"Tổng tiền đơn hàng\" — hệ thống sẽ trả lời chính xác từ dữ liệu đơn của bạn.';
            if (/an toàn|vệ sinh|iso|haccp/.test(s))
                return 'HuitMeal tuân thủ HACCP, ISO 22000 và truy xuất nguồn nguyên liệu.';
            if (/liên hệ|zalo|gọi|hotline/.test(s))
                return 'Hotline 0334 297 551 · Zalo · contact@HuitMeal.com';
            if (/chào|hello|hi/.test(s)) return this.welcomeText();
            return 'Đăng nhập DN để tra cứu dữ liệu thật, hoặc bấm Zalo/Gọi bên dưới.';
        }
    }));
});
</script>
