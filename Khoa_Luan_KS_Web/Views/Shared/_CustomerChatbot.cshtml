@* Widget chatbot + FAB — HuitMeal *@
@{
    var chatUser = Context.User;
    var isOrgChatbotUser = chatUser?.Identity?.IsAuthenticated == true && (
        chatUser.IsInRole("Organization") ||
        chatUser.IsInRole("Company") ||
        chatUser.IsInRole("Khách hàng doanh nghiệp"));
}
<div x-data="huitMealChatbot(@(isOrgChatbotUser ? "true" : "false"))" x-cloak class="hm-chat-root">

    <!-- Chat panel -->
    <div x-show="chatOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-4 scale-[0.97]"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-end="opacity-0 translate-y-4 scale-[0.97]"
         class="hm-chat-panel"
         style="display: none;"
         @@keydown.escape.window="if (chatOpen) chatOpen = false">

        <div class="hm-chat-panel__bg"></div>
        <div class="hm-chat-panel__overlay"></div>

        <!-- Header -->
        <header class="hm-chat-header">
            <div class="hm-chat-header__avatar">
                <i data-lucide="bot" class="w-5 h-5 text-green-300"></i>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-white text-base font-bold leading-tight truncate">HuitMeal Assistant</p>
                <p class="text-xs text-green-300/90 font-medium flex items-center gap-2 mt-1">
                    <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse shrink-0"></span>
                    <span x-text="isOrgUser ? 'Tra cứu dữ liệu thật từ hệ thống' : 'Hỗ trợ tư vấn nhanh'"></span>
                </p>
            </div>
            <button type="button" @@click="chatOpen = false" class="hm-chat-close" aria-label="Đóng">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </header>

        <!-- Trust strip (guest only) -->
        <div x-show="!isOrgUser" class="hm-chat-trust">
            <span class="text-xl font-black text-white">100%</span>
            <div class="flex-1">
                <p class="text-[10px] font-bold text-white/60 uppercase tracking-wider">An toàn thực phẩm</p>
                <div class="h-1 w-full max-w-[140px] bg-white/10 rounded-full mt-1.5">
                    <div class="h-full w-[92%] bg-red-500 rounded-full"></div>
                </div>
            </div>
        </div>

        <!-- Messages -->
        <div x-ref="chatScroll" class="hm-chat-messages">
            <template x-for="(msg, idx) in messages" :key="'m-' + idx">
                <div class="flex gap-3" :class="msg.role === 'user' ? 'justify-end' : 'justify-start'">
                    <div x-show="msg.role === 'bot'" class="hm-chat-bot-avatar shrink-0">
                        <i data-lucide="sparkles" class="w-4 h-4 text-green-300"></i>
                    </div>
                    <div class="min-w-0"
                         :class="msg.role === 'user' ? 'max-w-[88%]' : 'max-w-[calc(100%-3rem)] flex-1'">
                        <!-- User bubble -->
                        <div x-show="msg.role === 'user'"
                             class="hm-chat-bubble hm-chat-bubble--user"
                             x-text="msg.text"></div>
                        <!-- Bot bubble — rich text -->
                        <div x-show="msg.role === 'bot'"
                             class="hm-chat-bubble hm-chat-bubble--bot"
                             x-html="msg.html"></div>
                        <p class="text-[11px] text-white/40 mt-1.5"
                           :class="msg.role === 'user' ? 'text-right' : 'text-left'"
                           x-text="msg.time"></p>
                    </div>
                </div>
            </template>

            <div x-show="isTyping" class="flex items-start gap-3" style="display: none;">
                <div class="hm-chat-bot-avatar shrink-0">
                    <i data-lucide="sparkles" class="w-4 h-4 text-green-300"></i>
                </div>
                <div class="hm-chat-typing">
                    <span class="hm-chat-dot"></span>
                    <span class="hm-chat-dot hm-chat-dot--2"></span>
                    <span class="hm-chat-dot hm-chat-dot--3"></span>
                </div>
            </div>
        </div>

        <!-- Quick replies -->
        <div class="hm-chat-chips" x-show="!isTyping && quickReplies.length">
            <template x-for="chip in quickReplies" :key="chip">
                <button type="button" @@click="sendQuick(chip)" class="hm-chat-chip">
                    <span x-text="chip"></span>
                </button>
            </template>
        </div>

        <!-- Input -->
        <footer class="hm-chat-footer">
            <div class="hm-chat-input-row">
                <input type="text"
                       x-model="input"
                       x-ref="chatInput"
                       autocomplete="off"
                       placeholder="Nhập câu hỏi của bạn..."
                       class="hm-chat-input"
                       @@keydown.enter.prevent="sendMessage()" />
                <button type="submit"
                        @@click.prevent="sendMessage()"
                        :disabled="!input.trim() || isTyping"
                        class="hm-chat-send"
                        aria-label="Gửi tin nhắn">
                    <i data-lucide="send" class="w-5 h-5 pointer-events-none"></i>
                </button>
            </div>
            <p class="text-[11px] text-white/35 text-center mt-2.5"
               x-text="isOrgUser ? '' : 'Đăng nhập DN để tra cứu đơn hàng thật · Hotline 0334 297 551'"></p>
        </footer>
    </div>

    <!-- FAB stack -->
    <div class="hm-fab-stack">
        <a href="https://zalo.me/0334297551" target="_blank" rel="noopener" class="hm-fab hm-fab--zalo">
            Zalo
        </a>
        <a href="tel:0334297551" class="hm-fab hm-fab--phone">
            <i data-lucide="phone" class="w-6 h-6"></i>
        </a>
        <button type="button" @@click="toggleChatbot()" class="hm-fab hm-fab--chat" :class="chatOpen && 'hm-fab--chat-open'">
            <i data-lucide="message-circle" class="w-6 h-6" x-show="!chatOpen"></i>
            <i data-lucide="chevron-down" class="w-5 h-5" x-show="chatOpen" style="display: none;"></i>
            <span x-show="unreadHint && !chatOpen" class="hm-fab-badge"></span>
        </button>
    </div>
</div>

<style>
