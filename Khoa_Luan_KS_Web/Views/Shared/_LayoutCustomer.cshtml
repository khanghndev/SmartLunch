                        <h4 class="text-white font-bold uppercase text-xs tracking-widest">Dịch vụ</h4>
                        <ul class="space-y-3 text-sm">
                            <li><a href="/Customer/Factory" class="hover:text-red-500">Nhà máy</a></li>
                            <li><a href="/Customer/Office" class="hover:text-red-500">Văn phòng</a></li>
                            <li><a href="/Customer/School" class="hover:text-red-500">Trường học</a></li>
