                            <a href="/Profile/Orders" class="flex items-center justify-center gap-2 py-2 bg-white rounded-lg text-[10px] font-bold border border-gray-100"><i data-lucide="package" class="w-3 h-3"></i> ĐƠN HÀNG</a>
                        </div>
                        <a href="/Auth/Logout" class="mt-2 flex items-center justify-center gap-2 py-2 text-red-500 text-[10px] font-bold"><i data-lucide="log-out" class="w-3 h-3"></i> ĐĂNG XUẤT</a>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="block w-full py-4 bg-gray-900 text-white text-center rounded-xl font-bold text-sm mb-6">ĐĂNG NHẬP</a>
                }

                <div x-data="{ open: false }" class="space-y-1">
                    <button @@click="open = !open" class="w-full flex items-center justify-between p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl transition-all">
                        GIỚI THIỆU <i data-lucide="chevron-down" class="w-4 h-4 transition-transform" :class="open ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="open" class="pl-4 space-y-1">
                        <a href="/Customer/About" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Về chúng tôi</a>
                        <a href="/Customer/Achievements" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Thành tựu</a>
                    </div>
                </div>

                <a href="/Customer/Reviews" class="block p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl">ĐÁNH GIÁ</a>
                <a href="/Customer/ChooseHuitMeal" class="block p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl">CHỌN HUITMEAL</a>

                <div x-data="{ open: false }" class="space-y-1">
                    <button @@click="open = !open" class="w-full flex items-center justify-between p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl transition-all">
                        DỊCH VỤ <i data-lucide="chevron-down" class="w-4 h-4 transition-transform" :class="open ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="open" class="pl-4 space-y-1">
                        <a href="/Service/Safety" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Suất ăn sạch</a>
                        <a href="/Service/Safety" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Vệ sinh công nghiệp</a>
                        <a href="/Menu/Index" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Thực đơn</a>
                        <a href="/Service/School" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Suất ăn trường học</a>
                        <a href="/Service/Office" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Suất ăn văn phòng</a>
                        <a href="/Service/Factory" class="block p-3 text-sm font-medium text-gray-600 hover:text-orange-500">Suất ăn nhà máy</a>
                    </div>
                </div>

                <a href="/Customer/Partners" class="block p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl">ĐỐI TÁC</a>
                <a href="/Customer/HuitMeal" class="block p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl">BẢN TIN</a>
                <a href="/Customer/Recruitment" class="block p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl">TUYỂN DỤNG</a>
                <a href="/Customer/Contact" class="block p-3 font-bold text-gray-800 hover:bg-gray-50 rounded-xl">LIÊN HỆ</a>
            </nav>

            <div class="p-6 border-t bg-gray-50 space-y-4">
                <div class="flex items-center gap-3 text-xs text-gray-500 font-medium">
                    <i data-lucide="phone" class="w-4 h-4 text-orange-500"></i> 0334 297 551
                </div>
                <div class="flex items-center gap-3 text-xs text-gray-500 font-medium">
                    <i data-lucide="mail" class="w-4 h-4 text-orange-500"></i> contact@HuitMeal.com
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- MAIN FOOTER -->
    <footer class="bg-[#0B1120] text-slate-400 pt-20 pb-10 px-6 relative overflow-hidden font-sans border-t-4 border-slate-800">
        <!-- Abstract Background Effects -->
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-500/5 rounded-full blur-[100px] pointer-events-none -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-orange-500/5 rounded-full blur-[100px] pointer-events-none translate-y-1/3 -translate-x-1/4"></div>

        <div class="max-w-7xl mx-auto relative z-10">
            <!-- Top Section -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-16">
                
                <!-- Brand Info (Col span 4) -->
                <div class="lg:col-span-4 space-y-6">
                    <img src="/assets/images/Logo.jpg" alt="HuitMeal Logo" class="h-14 bg-white px-3 py-2 rounded-xl shadow-lg border border-slate-700">
                    <p class="text-sm leading-relaxed pr-0 md:pr-8 text-slate-400 font-medium">
                        HuitMeal tự hào là đơn vị tiên phong cung cấp giải pháp suất ăn công nghiệp và học đường đạt chuẩn quốc tế. Chúng tôi cam kết mang đến những bữa ăn an toàn, giàu dinh dưỡng và trọn vẹn hương vị.
