                                      <i data-lucide="user" class="w-4 h-4 opacity-50"></i> Thông tin hồ sơ
                                  </a>
                                  <a href="/Customer/Orders" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-600 hover:bg-orange-50 hover:text-orange-600 rounded-xl transition-all">
