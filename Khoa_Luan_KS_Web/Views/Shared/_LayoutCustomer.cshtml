                <button @@click="mobileMenuOpen = false" class="w-10 h-10 flex items-center justify-center text-gray-400">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <nav class="flex-1 overflow-y-auto p-6 space-y-1">
                <!-- User Profile on Mobile Menu -->
                @if(isLoggedIn)
                {
                    <div class="mb-8 p-4 bg-gray-50 rounded-2xl">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-full bg-red-600 flex items-center justify-center text-white font-black">
