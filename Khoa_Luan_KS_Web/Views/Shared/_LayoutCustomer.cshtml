@{
    var user = Context.User;

    var userName =
        user?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
        ?? user?.FindFirst("unique_name")?.Value
        ?? user?.FindFirst("name")?.Value
        ?? "";

    var roles = user?.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList() ?? new List<string>();

    bool isCustomerRole = user != null && (user.IsInRole("Customer") || 
                         user.IsInRole("Organization") || 
                         user.IsInRole("Khách hàng doanh nghiệp") || 
                         user.IsInRole("Khách hàng cá nhân"));

    bool isOrgMealOrderUser = user != null && (
                         user.IsInRole("Organization") ||
                         user.IsInRole("Company") ||
                         user.IsInRole("Khách hàng doanh nghiệp"));

    bool isLoggedIn = user.Identity?.IsAuthenticated == true && isCustomerRole;
    
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    bool IsActive(string path) => currentPath.Equals(path.ToLower(), StringComparison.OrdinalIgnoreCase) || (path == "/Customer/Index" && (currentPath == "/customer" || currentPath == "/"));
    bool IsActivePrefix(string prefix) => currentPath.StartsWith(prefix.ToLower(), StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HuitMeal</title>
    <link rel="icon" type="image/png" href="/assets/images/Logo_tròn.png" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Montserrat', 'sans-serif'],
            }
          }
        }
      }
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Alpine JS for interactions -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        /* ===== BASE ===== */
        body { font-family: 'Montserrat', 'Segoe UI', system-ui, -apple-system, sans-serif; }

        /* ===== PAGE LOAD OVERLAY ===== */
        #page-loader {
            position: fixed; inset: 0; z-index: 9999;
            background: #fff;
            display: flex; align-items: center; justify-content: center;
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }
        #page-loader.hidden-loader { opacity: 0; visibility: hidden; }
        .loader-ring {
            width: 40px; height: 40px;
            border: 3px solid #fed7aa;
            border-top-color: #f97316;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* ===== SCROLL ANIMATION BASE ===== */
        [data-animate] {
            opacity: 0;
            transition-property: opacity, transform;
            transition-duration: 0.65s;
            transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }
        [data-animate].is-visible { opacity: 1; transform: none !important; }

        /* Variants */
        [data-animate="fade-up"]    { transform: translateY(36px); }
        [data-animate="fade-down"]  { transform: translateY(-36px); }
        [data-animate="fade-left"]  { transform: translateX(-40px); }
        [data-animate="fade-right"] { transform: translateX(40px); }
        [data-animate="zoom-in"]    { transform: scale(0.9); }
        [data-animate="fade"]       { transform: none; }

        /* Stagger delays (use data-delay="1".."5" on children) */
        [data-delay="1"] { transition-delay: 0.1s; }
        [data-delay="2"] { transition-delay: 0.2s; }
        [data-delay="3"] { transition-delay: 0.3s; }
        [data-delay="4"] { transition-delay: 0.4s; }
        [data-delay="5"] { transition-delay: 0.5s; }
        [data-delay="6"] { transition-delay: 0.6s; }

        /* ===== HOVER MICRO-INTERACTIONS ===== */
        .btn-primary {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(249,115,22,0.35);
        }
        .card-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        }

        /* ===== SKELETON SCREEN ===== */
        .skeleton {
            background: linear-gradient(90deg, #f3f4f6 25%, #e9eaec 50%, #f3f4f6 75%);
            background-size: 400% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 8px;
        }
        @@keyframes shimmer {
            0% { background-position: 100% 0; }
            100% { background-position: -100% 0; }
        }

        .bg-dots-pattern {
            background-color: #f8fafc; /* Tailwind slate-50 */
            background-image: radial-gradient(rgba(15, 23, 42, 0.06) 1.5px, transparent 1.5px);
            background-size: 32px 32px;
        }

        [x-cloak] { display: none !important; }

        /* Force light structural containers to be transparent to reveal global background */
        main.flex-1 > div.bg-white,
        main.flex-1 > div.bg-gray-50,
        main.flex-1 > div.bg-slate-50,
        main.flex-1 > section.bg-white,
        main.flex-1 > section.bg-gray-50,
        main.flex-1 > section.bg-slate-50,
        main.flex-1 > div > section.bg-white,
        main.flex-1 > div > section.bg-gray-50,
        main.flex-1 > div > section.bg-slate-50 {
            background-color: transparent !important;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen bg-dots-pattern relative" x-data="{ mobileMenuOpen: false, searchOpen: false }">

    <!-- ===== PAGE LOAD OVERLAY ===== -->
    <div id="page-loader" aria-hidden="true">
        <div class="loader-ring"></div>
    </div>
    
    <!-- ===== TOP BAR (Hidden on Mobile) ===== -->
    <div class="hidden md:flex w-full bg-[#0F172A] text-white/70 text-[10px] font-bold uppercase tracking-widest px-8 justify-between items-center relative z-[60] border-b border-white/5">
        <div class="flex gap-8">
          <a href="tel:0966741866" class="flex items-center gap-2 hover:text-red-500 transition-colors">
            <i data-lucide="phone" class="w-3.5 h-3.5 text-red-500"></i>
            0334 297 551
          </a>
          <a href="mailto:contact@HuitMeal.com" class="flex items-center gap-2 hover:text-red-500 transition-colors">
            <i data-lucide="mail" class="w-3.5 h-3.5 text-red-500"></i>
            contact@HuitMeal.com
          </a>
        </div>
        <div class="flex items-center gap-6">
            <!-- Language Switcher -->
            <div x-data="{ langOpen: false }" 
                 @@mouseenter="langOpen = true" 
                 @@mouseleave="langOpen = false" 
                 class="relative flex items-center cursor-pointer z-[100] py-2">
                <div class="flex items-center gap-1.5 hover:text-white transition-colors">
                    <img src="https://flagcdn.com/w40/vn.png" alt="VN" class="w-4 h-4 rounded-full object-cover border border-white/20 shadow-sm">
                    <span class="text-[9px] font-bold">VN</span>
                    <i data-lucide="chevron-down" class="w-3 h-3 opacity-70"></i>
                </div>
                <!-- Dropdown wrapper with top padding to bridge the gap -->
                <div x-show="langOpen" 
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 translate-y-2"
                     x-transition:enter-end="opacity-100 translate-y-0"
                     class="absolute right-0 top-full pt-1 w-36" style="display: none;">
                    <div class="bg-white rounded-xl shadow-xl py-2 border border-gray-100 text-slate-800">
                        <a href="?lang=vi" class="flex items-center gap-3 px-4 py-2 text-xs font-bold text-orange-600 bg-orange-50/50 hover:bg-orange-50 transition-colors">
                            <img src="https://flagcdn.com/w40/vn.png" alt="VN" class="w-4 h-4 rounded-full object-cover shadow-sm"> Tiếng Việt
                        </a>
                        <a href="?lang=en" class="flex items-center gap-3 px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 transition-colors">
                            <img src="https://flagcdn.com/w40/gb.png" alt="EN" class="w-4 h-4 rounded-full object-cover shadow-sm"> English
                        </a>
                    </div>
                </div>
            </div>

            <div class="flex gap-4 border-l border-white/10 pl-6">
                <a href="#" class="hover:text-white transition-colors"><i data-lucide="facebook" class="w-3.5 h-3.5"></i></a>
                <a href="#" class="hover:text-white transition-colors"><i data-lucide="youtube" class="w-3.5 h-3.5"></i></a>
            </div>
        </div>
    </div>

    <!-- HEADER / NAVBAR -->
    <header 
        x-data="{ isScrolled: false }" 
        x-on:scroll.window="isScrolled = (window.pageYOffset > 40)"
        class="w-full sticky top-0 z-50 transition-all duration-300 ease-in-out border-b border-gray-100"
        :class="isScrolled ? 'bg-white/95 backdrop-blur-md shadow-lg' : 'bg-white shadow-none'"
    >
        <div class="max-w-[1440px] mx-auto flex items-center justify-between px-8 h-[75px]">
          <!-- LOGO -->
          <a href="/Customer/Index" class="shrink-0 group">
            <img src="/assets/images/Logo.jpg" alt="HuitMeal Logo" class="h-12 w-auto object-contain transition-transform group-hover:scale-105">
          </a>

          <!-- DESKTOP MENU -->
          <nav class="hidden lg:flex flex-1 items-center justify-center gap-6 xl:gap-8 h-full">
            <div class="group relative flex items-center h-full cursor-pointer">
              <span class="text-[13px] font-semibold @(IsActivePrefix("/Customer/About") || IsActivePrefix("/Customer/Achievements") ? "text-orange-600" : "text-gray-800") group-hover:text-orange-600 transition-colors flex items-center gap-1 h-full">
                <span class="h-full flex items-center @(IsActivePrefix("/Customer/About") || IsActivePrefix("/Customer/Achievements") ? "border-b-2 border-orange-600" : "")">GIỚI THIỆU</span>
                <i data-lucide="chevron-down" class="w-4 h-4 transition-transform group-hover:-rotate-180"></i>
              </span>
              <div class="absolute top-[75px] left-0 w-60 bg-white shadow-xl rounded-xl py-3 border border-gray-100 opacity-0 invisible translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 z-50">
                <a href="/Customer/About" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Customer/About") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Về chúng tôi</a>
                <a href="/Customer/Achievements" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Customer/Achievements") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Thành tựu</a>
              </div>
            </div>

            <a href="/Customer/Reviews" class="text-[13px] font-semibold @(IsActive("/Customer/Reviews") ? "text-orange-600 border-b-2 border-orange-600" : "text-gray-800") hover:text-orange-600 transition-colors h-full flex items-center">ĐÁNH GIÁ</a>
            <a href="/Customer/ChooseHuitMeal" class="text-[13px] font-semibold @(IsActive("/Customer/ChooseHuitMeal") ? "text-orange-600 border-b-2 border-orange-600" : "text-gray-800") hover:text-orange-600 transition-colors h-full flex items-center">CHỌN HUITMEAL</a>

            <!-- DỊCH VỤ -->
            <div class="group relative flex items-center h-full cursor-pointer">
              <span class="text-[13px] font-semibold @(IsActivePrefix("/Service") || IsActivePrefix("/Menu") || IsActivePrefix("/OrganizationMealOrder") ? "text-orange-600" : "text-gray-800") group-hover:text-orange-600 transition-colors flex items-center gap-1 h-full">
                <span class="h-full flex items-center @(IsActivePrefix("/Service") || IsActivePrefix("/Menu") || IsActivePrefix("/OrganizationMealOrder") ? "border-b-2 border-orange-600" : "")">DỊCH VỤ</span>
                <i data-lucide="chevron-down" class="w-4 h-4 transition-transform group-hover:-rotate-180"></i>
              </span>
              <div class="absolute top-[75px] left-0 w-[280px] bg-white shadow-xl rounded-xl py-3 border border-gray-100 opacity-0 invisible translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 z-50">
                <a href="/Service/Safety" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Service/Safety") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Suất ăn sạch</a>
                <a href="/Service/MenuSuggestions" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Service/MenuSuggestions") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Gợi ý thực đơn</a>
                <a href="/Menu/Gallery" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Menu/Gallery") || IsActivePrefix("/Menu/DishDetail") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all border-t mt-1 pt-3">Thư viện món ăn</a>
                <a href="/Menu/Index" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Menu/Index") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Thực đơn cố định</a>
                <a href="/OrganizationMealOrder" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActivePrefix("/OrganizationMealOrder") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all font-bold">Thực đơn tự chọn</a>
                <a href="/Service/School" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Service/School") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Suất ăn trường học</a>
                <a href="/Service/Office" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Service/Office") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Suất ăn văn phòng</a>
                <a href="/Service/Factory" class="block px-5 py-2.5 text-[13px] font-semibold @(IsActive("/Service/Factory") ? "text-orange-600 bg-orange-50/50" : "text-gray-600") hover:text-orange-600 hover:bg-orange-50/50 transition-all">Suất ăn nhà máy</a>
              </div>
            </div>

            <a href="/Customer/Partners" class="text-[13px] font-semibold @(IsActive("/Customer/Partners") ? "text-orange-600 border-b-2 border-orange-600" : "text-gray-800") hover:text-orange-600 transition-colors h-full flex items-center">ĐỐI TÁC</a>
            <a href="/Customer/HuitMeal" class="text-[13px] font-semibold @(IsActive("/Customer/HuitMeal") ? "text-orange-600 border-b-2 border-orange-600" : "text-gray-800") hover:text-orange-600 transition-colors h-full flex items-center uppercase">BẢN TIN</a>
            @* <a href="/Customer/Recruitment" class="text-[13px] font-semibold @(IsActive("/Customer/Recruitment") ? "text-orange-600 border-b-2 border-orange-600" : "text-gray-800") hover:text-orange-600 transition-colors h-full flex items-center uppercase">TUYỂN DỤNG</a> *@
            <a href="/Customer/Contact" class="text-[13px] font-semibold @(IsActive("/Customer/Contact") ? "text-orange-600 border-b-2 border-orange-600" : "text-gray-800") hover:text-orange-600 transition-colors h-full flex items-center uppercase">LIÊN HỆ</a>
          </nav>

          <!-- PROFILE / ACTIONS -->
          <div class="flex items-center gap-3">
              <!-- Search Trigger -->
              <button @@click="searchOpen = true; $nextTick(() => $refs.searchInput.focus())" 
                      class="p-2.5 text-slate-400 hover:text-orange-600 hover:bg-orange-50 rounded-full transition-all duration-300 group">
                  <i data-lucide="search" class="w-5 h-5 transition-transform group-hover:scale-110"></i>
              </button>

              @if (!isLoggedIn)
              {
                  <a href="/Auth/Login"
                     class="flex items-center gap-2 px-6 py-2.5 bg-slate-900 text-white text-xs font-semibold uppercase tracking-widest rounded-full hover:bg-orange-600 transition-all shadow-sm active:scale-95">
                      <i data-lucide="user" class="w-4 h-4"></i>
                      Đăng nhập
                  </a>
              }
              @if (isLoggedIn)
              {
                  <a href="/Cart" class="hidden items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-sm transition hover:border-orange-200 hover:text-orange-600 sm:inline-flex" title="Giỏ hàng">
                      <i data-lucide="shopping-cart" class="h-4 w-4"></i>
                      <span>Giỏ</span>
                  </a>
                  <div x-data="{ profileOpen: false }" 
                       @@mouseenter="profileOpen = true" 
                       @@mouseleave="profileOpen = false" 
                       class="relative flex items-center py-4">
                      <button class="flex items-center gap-3 hover:text-orange-600 transition-all cursor-pointer group">
                          <div class="w-9 h-9 rounded-full bg-orange-600 flex items-center justify-center text-white font-black text-[11px] shadow-sm group-hover:scale-105 transition-transform uppercase">
                              @(string.IsNullOrEmpty(userName) ? "U" : userName.Substring(0, 1).ToUpper())
                          </div>
                          <div class="hidden xl:block text-left">
                              <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest leading-none mb-1">Xin chào,</p>
                              <p class="text-xs font-bold text-gray-800">@userName</p>
                          </div>
                          <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 transition-transform duration-300" :class="profileOpen ? 'rotate-180' : ''"></i>
                      </button>
                      
                      <div x-show="profileOpen" 
                           x-transition:enter="transition ease-out duration-200"
                           x-transition:enter-start="opacity-0 translate-y-2"
                           x-transition:enter-end="opacity-100 translate-y-0"
                           class="absolute right-0 top-full z-[100]" style="display: none;">
                          <div class="w-64 bg-white rounded-2xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.2)] py-2 border border-gray-100 mt-0 overflow-hidden">
                              <div class="px-6 py-4 bg-gray-50/50 border-b border-gray-100">
                                  <p class="text-[9px] text-gray-400 font-black uppercase tracking-widest mb-1">Quản lý tài khoản</p>
                                  <h4 class="font-bold text-gray-900 text-sm truncate">@userName</h4>
                              </div>
                              <div class="p-2 space-y-1">
                                  <a href="/Profile/Index" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-600 hover:bg-orange-50 hover:text-orange-600 rounded-xl transition-all">
                                      <i data-lucide="user" class="w-4 h-4 opacity-50"></i> Thông tin hồ sơ
                                  </a>
                                  <a href="/Cart" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-600 hover:bg-orange-50 hover:text-orange-600 rounded-xl transition-all">
                                      <i data-lucide="shopping-cart" class="w-4 h-4 opacity-50"></i> Giỏ hàng
                                  </a>
                                  <a href="/Profile/Orders" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-600 hover:bg-orange-50 hover:text-orange-600 rounded-xl transition-all">
                                      <i data-lucide="package" class="w-4 h-4 opacity-50"></i> Quản lý đơn hàng
                                  </a>
                                  @if (isOrgMealOrderUser)
                                  {
                                  <a href="/OrganizationMealOrder" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-600 hover:bg-orange-50 hover:text-orange-600 rounded-xl transition-all">
                                      <i data-lucide="building-2" class="w-4 h-4 opacity-50"></i> Đặt suất doanh nghiệp
                                  </a>
                                  }
                              </div>
                              <div class="p-2 border-t border-gray-50 mt-1">
                                  <a href="/Auth/Logout" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 rounded-xl transition-all font-bold">
                                      <i data-lucide="log-out" class="w-4 h-4"></i> Đăng xuất
                                  </a>
                              </div>
                          </div>
                      </div>
                  </div>
              }

              <!-- Mobile Toggle -->
              <button @@click="mobileMenuOpen = true" class="lg:hidden w-10 h-10 flex items-center justify-center text-slate-800 bg-slate-50 rounded-xl active:scale-90 transition-transform">
                <i data-lucide="menu" class="w-6 h-6"></i>
              </button>
          </div>
        </div>
    </header>


    <!-- MOBILE MENU DRAWER -->
    <div x-show="mobileMenuOpen" 
         class="fixed inset-0 z-[100] lg:hidden" style="display: none;"
         @@keydown.escape.window="mobileMenuOpen = false">
        <!-- Backdrop -->
        <div x-show="mobileMenuOpen" 
             x-transition:enter="transition-opacity ease-out duration-300" 
             x-transition:enter-start="opacity-0" 
             x-transition:enter-end="opacity-100" 
             x-transition:leave="transition-opacity ease-in duration-200" 
             x-transition:leave-start="opacity-100" 
             x-transition:leave-end="opacity-0" 
             @@click="mobileMenuOpen = false" 
             class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
        
        <!-- Drawer Panel -->
        <div x-show="mobileMenuOpen" 
             x-transition:enter="transition ease-out duration-300 transform" 
             x-transition:enter-start="translate-x-full" 
             x-transition:enter-end="translate-x-0" 
             x-transition:leave="transition ease-in duration-200 transform" 
             x-transition:leave-start="translate-x-0" 
             x-transition:leave-end="translate-x-full" 
             class="absolute right-0 top-0 h-full w-[300px] bg-white shadow-2xl flex flex-col">
            
            <div class="p-6 flex items-center justify-between border-b">
                <img src="/assets/images/Logo.jpg" class="h-8 w-auto">
                <button @@click="mobileMenuOpen = false" class="w-10 h-10 flex items-center justify-center text-gray-400">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <nav class="flex-1 overflow-y-auto p-6 space-y-1">
                <!-- User Profile on Mobile Menu -->
                @if(isLoggedIn)
                {
                    <div class="mb-8 p-4 bg-gray-50 rounded-2xl">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-full bg-red-600 flex items-center justify-center text-white font-black">
                                @(string.IsNullOrEmpty(userName) ? "U" : userName.Substring(0, 1).ToUpper())
                            </div>
