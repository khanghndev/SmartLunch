@{
    ViewData["Title"] = "Suất ăn văn phòng - HuitMeal";
    Layout = "_LayoutCustomer";
}

<div class="w-full bg-transparent overflow-hidden">
    <!-- ===== HERO SECTION ===== -->
    <section class="relative w-full h-[50vh] min-h-[400px] md:h-[70vh] flex items-center justify-center overflow-hidden">
        <!-- Background with Parallax-like feel -->
        <div class="absolute inset-0">
            <img src="/assets/images/banner-service.jpg" class="w-full h-full object-cover object-center scale-110" alt="Office Meals Banner" />
            <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/60 to-slate-900/80"></div>
        </div>

        <!-- Floating Decorative Elements -->
        <div class="absolute top-1/4 -left-20 w-64 h-64 bg-orange-500/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 -right-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>

        <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
            <div data-animate="fade-down">
                <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500/20 border border-orange-500/30 text-orange-400 text-xs md:text-sm font-bold uppercase tracking-[0.2em] mb-6 backdrop-blur-md">
                    Dịch vụ chuyên nghiệp
                </span>
            </div>
            <h1 data-animate="fade-up" data-delay="1" class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-[1.1] tracking-tight mb-6">
                Suất ăn văn phòng <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-emerald-400">Đẳng cấp & Tiện lợi</span>
            </h1>
            <p data-animate="fade-up" data-delay="2" class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-medium">
                Giải pháp dinh dưỡng khoa học, giúp duy trì năng lượng bền bỉ và nâng cao hiệu suất làm việc cho đội ngũ nhân sự của bạn.
            </p>
            <div data-animate="fade-up" data-delay="3" class="flex flex-wrap justify-center gap-4">
                <a href="/Menu/Index?profile=org_company#menu-section" class="px-8 py-4 bg-orange-500 hover:bg-orange-600 text-white rounded-full font-bold text-sm transition-all shadow-lg shadow-orange-500/25 hover:-translate-y-1 active:scale-95">
                    THỰC ĐƠN TUẦN (VĂN PHÒNG)
                </a>
                <a href="/Customer/Contact" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-md rounded-full font-bold text-sm transition-all hover:-translate-y-1 active:scale-95">
                    LIÊN HỆ TƯ VẤN
                </a>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-50">
            <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center p-1">
                <div class="w-1 h-2 bg-white rounded-full"></div>
            </div>
        </div>
    </section>

    <!-- ===== INTRO SECTION ===== -->
    <section class="relative py-24 bg-transparent overflow-hidden">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div class="relative" data-animate="fade-right">
                    <div class="absolute -top-10 -left-10 w-40 h-40 bg-orange-100 rounded-full -z-10 blur-2xl opacity-60"></div>
                    <div class="relative rounded-3xl overflow-hidden shadow-2xl group">
                        <img src="/assets/images/vanphong.jpg" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" alt="Office Lunch" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                        <div class="absolute bottom-8 left-8 p-6 bg-white/90 backdrop-blur-md rounded-2xl shadow-xl max-w-[280px]">
                            <div class="flex items-center gap-4 mb-2">
                                <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center">
                                    <i data-lucide="check-circle-2" class="text-emerald-600 w-6 h-6"></i>
                                </div>
                                <span class="font-bold text-slate-800">Chuẩn 5 Sao</span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">Quy trình chế biến khép kín, đảm bảo vệ sinh tuyệt đối.</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-8" data-animate="fade-left">
                    <div class="space-y-4">
                        <h4 class="text-orange-500 font-bold uppercase tracking-widest text-sm">Về HAPPYSPOON</h4>
                        <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 leading-tight">
                            Bữa trưa trọn vẹn <br/>
                            <span class="text-emerald-600">Khơi nguồn sáng tạo</span>
                        </h2>
                    </div>
                    <div class="space-y-6 text-slate-600 leading-relaxed text-lg">
                        <p>
                            HAPPYSPOON không chỉ mang đến bữa ăn, chúng tôi mang đến **giải pháp dinh dưỡng hiện đại** được thiết kế riêng cho môi trường công sở năng động.
                        </p>
                        <p>
                            Mỗi thực đơn được các chuyên gia dinh dưỡng tính toán kỹ lưỡng, đảm bảo sự cân bằng hoàn hảo giữa đạm, chất xơ và vitamin, giúp nhân viên duy trì năng lượng bền bỉ suốt 8 giờ làm việc mà không gây cảm giác mệt mỏi hay buồn ngủ sau khi ăn.
                        </p>
                    </div>
                    <div class="grid grid-cols-2 gap-6 pt-4">
                        <div class="p-4 bg-white rounded-2xl shadow-sm border border-slate-100">
                            <div class="text-3xl font-black text-orange-500 mb-1">800+</div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest">Suất ăn mỗi ngày</div>
                        </div>
                        <div class="p-4 bg-white rounded-2xl shadow-sm border border-slate-100">
                            <div class="text-3xl font-black text-emerald-500 mb-1">100%</div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest">Nguyên liệu sạch</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== BENEFITS SECTION ===== -->
    <section class="py-24 bg-transparent">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
                <h4 class="text-orange-500 font-bold uppercase tracking-widest text-sm mb-4">Lợi ích vượt trội</h4>
                <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-6">Tại sao nên chọn chúng tôi?</h2>
                <p class="text-slate-500 text-lg">HAPPYSPOON cam kết mang lại giá trị thiết thực nhất cho sức khỏe nhân viên và sự phát triển của doanh nghiệp.</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Benefit 1 -->
                <div class="group p-8 bg-white rounded-[32px] border border-slate-100 shadow-sm hover:shadow-2xl hover:border-orange-200 transition-all duration-500 hover:-translate-y-2" data-animate="zoom-in" data-delay="1">
                    <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-orange-500 group-hover:scale-110 transition-all duration-500 shadow-inner">
                        <i data-lucide="utensils-cross" class="w-8 h-8 text-orange-500 group-hover:text-white transition-colors"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-4">Đa dạng mỗi ngày</h3>
                    <p class="text-slate-500 leading-relaxed text-sm">Thực đơn xoay vòng hơn 200 món ăn, đảm bảo không trùng lặp, tạo cảm hứng mới mẻ mỗi bữa trưa.</p>
                </div>

                <!-- Benefit 2 -->
                <div class="group p-8 bg-white rounded-[32px] border border-slate-100 shadow-sm hover:shadow-2xl hover:border-emerald-200 transition-all duration-500 hover:-translate-y-2" data-animate="zoom-in" data-delay="2">
                    <div class="w-16 h-16 bg-emerald-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-emerald-500 group-hover:scale-110 transition-all duration-500 shadow-inner">
                        <i data-lucide="shield-check" class="w-8 h-8 text-emerald-500 group-hover:text-white transition-colors"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-4">Vệ sinh an toàn</h3>
                    <p class="text-slate-500 leading-relaxed text-sm">Đạt chứng nhận HACCP & ISO 22000. Nguyên liệu VietGAP có nguồn gốc xuất xứ rõ ràng.</p>
                </div>

                <!-- Benefit 3 -->
                <div class="group p-8 bg-white rounded-[32px] border border-slate-100 shadow-sm hover:shadow-2xl hover:border-blue-200 transition-all duration-500 hover:-translate-y-2" data-animate="zoom-in" data-delay="3">
                    <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-blue-500 group-hover:scale-110 transition-all duration-500 shadow-inner">
                        <i data-lucide="brain-circuit" class="w-8 h-8 text-blue-500 group-hover:text-white transition-colors"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-4">Tỉnh táo làm việc</h3>
                    <p class="text-slate-500 leading-relaxed text-sm">Công thức ít dầu mỡ, cân đối carb chuyển hóa chậm giúp nhân viên không bị buồn ngủ sau ăn.</p>
                </div>

                <!-- Benefit 4 -->
                <div class="group p-8 bg-white rounded-[32px] border border-slate-100 shadow-sm hover:shadow-2xl hover:border-rose-200 transition-all duration-500 hover:-translate-y-2" data-animate="zoom-in" data-delay="4">
                    <div class="w-16 h-16 bg-rose-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-rose-500 group-hover:scale-110 transition-all duration-500 shadow-inner">
                        <i data-lucide="truck" class="w-8 h-8 text-rose-500 group-hover:text-white transition-colors"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-4">Giao hàng đúng giờ</h3>
                    <p class="text-slate-500 leading-relaxed text-sm">Đội ngũ vận chuyển chuyên nghiệp, đảm bảo thức ăn luôn nóng hổi khi đến tay khách hàng.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FEATURED DISH SECTION ===== -->
    <section class="py-24 bg-slate-900 relative overflow-hidden">
        <!-- Decor -->
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-orange-500/10 rounded-full blur-[120px] -mr-64 -mt-64"></div>
        
        <div class="max-w-7xl mx-auto px-6 relative z-10">
            <div class="bg-slate-800/50 backdrop-blur-xl border border-white/10 rounded-[40px] p-8 md:p-16 flex flex-col lg:flex-row gap-12 items-center" data-animate="fade-up">
                <div class="w-full lg:w-1/2 aspect-square md:aspect-video lg:aspect-auto rounded-3xl overflow-hidden shadow-2xl">
                    <img src="https://cdn.tgdd.vn/2021/03/CookProduct/30-1200x676-3.jpg" class="w-full h-full object-cover" alt="Featured Dish" />
                </div>
                <div class="w-full lg:w-1/2 space-y-8">
                    <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-orange-500/20 text-orange-400 text-sm font-bold">
