@{
    ViewData["Title"] = "Dashboard Thực Đơn";
    Layout = "_LayoutManager";
}

<div class="p-2 sm:p-6 space-y-6">
    <h1 class="text-2xl font-bold text-green-600">Tổng quan Bếp / Thực đơn</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl shadow p-6 border-l-4 border-blue-500">
            <h3 class="text-gray-500 text-sm">Tổng món đang phục vụ</h3>
            <p class="text-3xl font-bold mt-2">120 <span class="text-sm font-normal text-gray-400">món</span></p>
        </div>
        <div class="bg-white rounded-xl shadow p-6 border-l-4 border-orange-500">
            <h3 class="text-gray-500 text-sm">Cảnh báo nguyên liệu</h3>
            <p class="text-3xl font-bold mt-2 text-orange-600">5 <span class="text-sm font-normal text-gray-400">loại sắp hết</span></p>
        </div>
        <div class="bg-white rounded-xl shadow p-6 border-l-4 border-green-500">
            <h3 class="text-gray-500 text-sm">Rating chất lượng (AI)</h3>
            <p class="text-3xl font-bold mt-2 text-green-600">4.8 <span class="text-sm font-normal text-gray-400">/ 5.0</span></p>
        </div>
    </div>
</div>
