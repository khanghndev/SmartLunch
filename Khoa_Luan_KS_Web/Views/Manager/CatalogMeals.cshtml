@{
    ViewData["Title"] = "Quản lý Menu Thực Đơn";
    Layout = "_LayoutManager";
}

<div class="px-4 py-6 md:p-8 space-y-8" x-data="{ isModalOpen: false, search: '' }">
    
    <!-- Tiêu đề & Công cụ -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2">
                <i class="fas fa-utensils text-green-600"></i> Quản lý Menu Thực đơn
            </h1>
            <p class="text-sm text-gray-500 mt-2">Xây dựng định lượng suất ăn và công bố tiêu chuẩn Dinh dưỡng</p>
        </div>
        <button x-on:click="isModalOpen = true" class="bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-3 rounded-xl shadow-sm hover:shadow-lg transition flex items-center gap-2 transform hover:-translate-y-0.5">
            <i class="fas fa-plus-circle text-lg"></i> Thiết kế Menu Mới
        </button>
    </div>

    <!-- Thanh Bộ lọc (Filter Bar) -->
    <div class="flex flex-col md:flex-row gap-4 justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <div class="relative w-full md:w-96 text-gray-400 focus-within:text-green-600">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2"></i>
            <input type="text" x-model="search" placeholder="Tìm tên món ăn, ví dụ 'Menu Chay'..." class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block pl-10 p-2.5 transition" />
        </div>
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <span class="text-xs font-bold text-gray-400 uppercase">Lọc theo:</span>
            <button class="bg-green-50 text-green-700 border border-green-100 px-4 py-2 rounded-full text-sm font-bold shadow-sm">Tất cả</button>
            <button class="bg-white text-gray-600 hover:bg-gray-50 border border-gray-200 px-4 py-2 rounded-full text-sm font-bold transition">Văn phòng</button>
            <button class="bg-white text-gray-600 hover:bg-gray-50 border border-gray-200 px-4 py-2 rounded-full text-sm font-bold transition">Công nhân (Nặng)</button>
            <button class="bg-white text-gray-600 hover:bg-gray-50 border border-gray-200 px-4 py-2 rounded-full text-sm font-bold transition">Ăn Kiêng / Chay</button>
        </div>
    </div>

    <!-- Lưới Hiển thị (Menu Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

        <!-- COMBO 1 -->
        <a href="/Manager/MealDetail/M001" class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all border border-gray-100 overflow-hidden group flex flex-col hover:-translate-y-1">
            <!-- Image Area -->
            <div class="relative h-48 overflow-hidden bg-gray-100">
                <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80" alt="Suất ăn" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>
                <!-- Tag -->
                <div class="absolute top-3 right-3 bg-red-500 text-white text-[10px] font-black tracking-wider uppercase px-2 py-1 rounded shadow-sm">
                    Best Seller
                </div>
                <div class="absolute bottom-3 left-4 text-white">
                    <h3 class="font-extrabold text-lg drop-shadow-md">Menu Văn Phòng Chuẩn</h3>
                    <p class="text-sm font-bold text-green-400 drop-shadow-md">35,000 đ</p>
                </div>
            </div>
            <!-- Info Area -->
            <div class="p-5 flex-1 flex flex-col">
                <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed mb-4">
                    Gồm Cơm niêu, Thịt ba chỉ rang cháy cạnh, Trứng ốp la, Canh chua thịt băm và Salad dầu dấm ăn kèm. Phù hợp nhân viên văn phòng.
                </p>
                <!-- Nutrition Pills -->
                <div class="mt-auto grid grid-cols-2 gap-3">
                    <div class="bg-orange-50 border border-orange-100 rounded-lg p-2 text-center">
                        <div class="text-[10px] font-bold text-orange-400 uppercase">Kcal / Năng lượng</div>
                        <div class="font-black text-orange-600 text-sm">650 <span class="text-[10px]">kcal</span></div>
                    </div>
                    <div class="bg-blue-50 border border-blue-100 rounded-lg p-2 text-center">
                        <div class="text-[10px] font-bold text-blue-400 uppercase">Cơ Bắp (Protein)</div>
                        <div class="font-black text-blue-600 text-sm">30 <span class="text-[10px]">gram</span></div>
                    </div>
                </div>
            </div>
        </a>

        <!-- COMBO 2 -->
        <a href="/Manager/MealDetail/M002" class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all border border-gray-100 overflow-hidden group flex flex-col hover:-translate-y-1">
            <div class="relative h-48 overflow-hidden bg-gray-100">
                <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=600&q=80" alt="Suất ăn" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>
                <div class="absolute top-3 right-3 bg-green-500 text-white text-[10px] font-black tracking-wider uppercase px-2 py-1 rounded shadow-sm">
                    Healthy (Thuần Chay)
                </div>
                <div class="absolute bottom-3 left-4 text-white">
                    <h3 class="font-extrabold text-lg drop-shadow-md">Menu Cơm Lức Dinh Dưỡng</h3>
                    <p class="text-sm font-bold text-green-400 drop-shadow-md">45,000 đ</p>
                </div>
            </div>
            <div class="p-5 flex-1 flex flex-col">
                <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed mb-4">
                    Gồm gạo lứt huyết rồng, Bơ sáp Đà lạt, Đậu hũ tươi Nhật Bản và các loại rau củ hữu cơ luộc. Dành cho người ăn kiêng / tiểu đường.
                </p>
                <div class="mt-auto grid grid-cols-2 gap-3">
                    <div class="bg-orange-50 border border-orange-100 rounded-lg p-2 text-center">
                        <div class="text-[10px] font-bold text-orange-400 uppercase">Kcal / Năng lượng</div>
                        <div class="font-black text-orange-600 text-sm">350 <span class="text-[10px]">kcal</span></div>
                    </div>
                    <div class="bg-blue-50 border border-blue-100 rounded-lg p-2 text-center">
                        <div class="text-[10px] font-bold text-blue-400 uppercase">Cơ Bắp (Protein)</div>
                        <div class="font-black text-blue-600 text-sm">15 <span class="text-[10px]">gram</span></div>
                    </div>
                </div>
            </div>
        </a>

        <!-- COMBO 3 -->
        <a href="/Manager/MealDetail/M003" class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all border border-gray-100 overflow-hidden group flex flex-col hover:-translate-y-1">
            <div class="relative h-48 overflow-hidden bg-gray-100">
                <img src="https://images.unsplash.com/photo-1544025162-836909b0e30f?auto=format&fit=crop&w=600&q=80" alt="Suất ăn" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 border-b" />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>
                <div class="absolute top-3 right-3 bg-amber-500 text-white text-[10px] font-black tracking-wider uppercase px-2 py-1 rounded shadow-sm">
                    High Energy (KCN)
                </div>
                <div class="absolute bottom-3 left-4 text-white">
                    <h3 class="font-extrabold text-lg drop-shadow-md">Menu Khu Công Nghiệp Nặng</h3>
                    <p class="text-sm font-bold text-green-400 drop-shadow-md">28,000 đ</p>
                </div>
            </div>
            <div class="p-5 flex-1 flex flex-col">
                <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed mb-4">
                    Suất ăn số lượng lớn với Cơm trắng thêm tự do. Thức ăn mặn 2 món (Gà ram sả ớt, Trứng cuộn thịt) nêm nếm đậm đà.
                </p>
                <div class="mt-auto grid grid-cols-2 gap-3">
                    <div class="bg-orange-50 border border-orange-100 rounded-lg p-2 text-center">
                        <div class="text-[10px] font-bold text-orange-400 uppercase">Kcal / Năng lượng</div>
                        <div class="font-black text-orange-600 text-sm">820 <span class="text-[10px]">kcal</span></div>
                    </div>
                    <div class="bg-blue-50 border border-blue-100 rounded-lg p-2 text-center">
                        <div class="text-[10px] font-bold text-blue-400 uppercase">Cơ Bắp (Protein)</div>
                        <div class="font-black text-blue-600 text-sm">45 <span class="text-[10px]">gram</span></div>
                    </div>
                </div>
            </div>
        </a>

    </div>


    <!-- MODAL: Thiết Kế Menu Mới -->
    <div x-show="isModalOpen" style="display: none;" class="fixed inset-0 z-[100] flex items-center justify-center px-4" x-transition.opacity.duration.300ms>
        
        <div x-on:click="isModalOpen = false" class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity"></div>
        
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-5xl z-10 overflow-hidden transform transition-all flex flex-col max-h-[90vh]" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
            
            <div class="px-8 py-5 border-b border-gray-100 flex items-center justify-between bg-white shrink-0 relative overflow-hidden">
                <div class="absolute right-0 top-0 w-32 h-32 bg-gradient-to-bl from-green-50 to-transparent z-0"></div>
                <div class="flex items-center gap-3 relative z-10">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-400 to-emerald-600 text-white flex items-center justify-center font-bold shadow-md text-xl">
                        <i class="fas fa-magic"></i>
                    </div>
                    <div>
                        <h3 class="text-2xl font-extrabold text-gray-900 tracking-tight">Cấu hình Menu Thực Đơn Mới</h3>
                        <p class="text-xs font-bold text-gray-500 mt-0.5 uppercase tracking-wider">Hệ thống Thiết kế Chuẩn Dinh Dưỡng</p>
                    </div>
                </div>
                <button x-on:click="isModalOpen = false" class="text-gray-400 hover:text-gray-600 bg-white hover:bg-gray-100 w-8 h-8 rounded-full flex items-center justify-center transition border border-gray-200 shadow-sm relative z-10">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="p-8 overflow-y-auto custom-scrollbar flex-1 bg-gray-50/50">
                <form class="space-y-8">
                    
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        
                        <!-- Cột Trái: Ảnh Đại diện -->
                        <div class="space-y-4">
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Hình ảnh trực quan (Thumbnail)</label>
                            <div class="w-full h-56 border-2 border-dashed border-gray-300 rounded-2xl bg-white flex flex-col items-center justify-center text-gray-500 hover:border-green-500 hover:bg-green-50/50 transition cursor-pointer relative group">
                                <i class="fas fa-camera text-4xl mb-3 text-gray-300 group-hover:text-green-500 transition-colors"></i>
                                <span class="text-sm font-bold text-gray-700">Tải ảnh chất lượng cao lên</span>
                                <span class="text-[11px] text-gray-400 mt-1">Định dạng JPG, PNG (16:9)</span>
                            </div>
                        </div>

                        <!-- Cột Phải: Dữ liệu Form -->
                        <div class="lg:col-span-2 space-y-6">
                            
                            <!-- Hàng 1: Tên & Phân loại -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Tiêu đề Món ăn / Set Menu <span class="text-red-500">*</span></label>
                                    <input type="text" placeholder="VD: Menu Cá kho tộ chuẩn vị..." class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3 shadow-sm font-medium" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Chỉ định Phân khúc <span class="text-red-500">*</span></label>
                                    <select class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3 shadow-sm font-medium">
                                        <option>Tiêu chuẩn Văn phòng (Đậm đà)</option>
                                        <option>Dinh dưỡng Chuyên biệt (Diet)</option>
                                        <option>Thực đơn KCN Cường độ cao</option>
                                        <option>Chế độ Nhà Trẻ / Mẫu giáo</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Hàng 2: Giá & Dinh dưỡng -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Giá trị gói (VNĐ)</label>
                                    <div class="flex">
                                        <input type="number" placeholder="25000" class="w-full bg-white border border-gray-300 border-r-0 rounded-l-xl text-gray-900 text-sm font-bold focus:ring-green-500 focus:border-green-500 block p-3 shadow-sm" />
                                        <span class="inline-flex items-center px-4 bg-gray-50 border border-gray-300 rounded-r-xl text-gray-500 text-sm font-bold">
                                            ₫
                                        </span>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Năng lượng (Kcal)</label>
                                    <input type="number" placeholder="Trị số Calorie" class="w-full bg-orange-50 border border-orange-200 text-orange-900 text-sm rounded-xl focus:ring-orange-500 focus:border-orange-500 block p-3 shadow-sm font-bold placeholder:font-normal placeholder:text-orange-300 text-center" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Protein (Chất đạm)</label>
                                    <input type="number" placeholder="Số gram (g)" class="w-full bg-blue-50 border border-blue-200 text-blue-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3 shadow-sm font-bold placeholder:font-normal placeholder:text-blue-300 text-center" />
                                </div>
                            </div>

                            <!-- Hàng 3: Mô tả (Full span) -->
                            <div class="md:col-span-3">
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Mô tả cấu thành (Các món, gia vị đặc trưng)</label>
                                <textarea rows="3" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-green-500 focus:border-green-500 block p-3 shadow-sm font-medium leading-relaxed" placeholder="Ghi chú các món chính, món phụ và định lượng gạo. Note các thành phần dễ dị ứng (trưng, đậu phộng)..."></textarea>
                            </div>

                        </div>
                    </div>

                </form>
            </div>
            
            <div class="px-8 py-5 bg-white border-t border-gray-100 flex items-center justify-end gap-4 shrink-0">
                <button type="button" x-on:click="isModalOpen = false" class="px-5 py-3 text-sm font-bold text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-100 transition shadow-sm">
                    Hủy thiết kế
                </button>
                <button type="button" class="px-8 py-3 text-sm font-bold text-white bg-green-600 rounded-xl hover:bg-green-700 transition shadow-md flex items-center gap-2">
                    <i class="fas fa-cloud-upload-alt"></i> Xuất bản Thực đơn
                </button>
            </div>
        </div>
    </div>

</div>
