@{
    ViewData["Title"] = "Báo cáo Tài chính";
    Layout = "_LayoutManager";
}

<div class="p-2 sm:p-6 space-y-6">
    <h1 class="text-2xl font-bold text-green-600">Báo cáo & Thống kê Tài chính</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded shadow p-6">
            <h3 class="text-gray-500 text-sm">Tổng Doanh Thu (Tháng 4)</h3>
            <p class="text-3xl font-bold mt-2 text-green-600">1,250,500,000 ₫</p>
        </div>
        <div class="bg-white rounded shadow p-6">
            <h3 class="text-gray-500 text-sm">Chi phí nhập hàng (Tháng 4)</h3>
            <p class="text-3xl font-bold mt-2 text-red-600">850,200,000 ₫</p>
        </div>
    </div>
    
    <div class="bg-white rounded shadow p-6 border text-center h-64 flex items-center justify-center text-gray-400">
        <p>Biểu đồ thống kê sẽ được render tại đây (Sử dụng Chart.js / ApexCharts)</p>
    </div>
</div>
