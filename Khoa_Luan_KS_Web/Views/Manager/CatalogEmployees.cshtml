@{
    ViewData["Title"] = "Quản lý Nhân Viên";
    Layout = "_LayoutManager";
}

<div class="px-4 py-6 md:p-8 space-y-8" x-data="{ isModalOpen: false, searchQuery: '' }">
    <!-- Header Page -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Hồ sơ Cán bộ Nhân viên</h1>
            <p class="text-sm text-gray-500 mt-1">Hệ thống quản lý định danh và hồ sơ vận hành bếp</p>
        </div>
        <button x-on:click="isModalOpen = true" class="bg-green-600 hover:bg-green-700 text-white font-bold px-5 py-2.5 rounded-xl shadow-sm hover:shadow-md transition-all flex items-center gap-2">
            <i class="fas fa-plus"></i> Thêm Nhân Viên
        </button>
    </div>

    <!-- Toolbar Filters -->
    <div class="flex flex-col md:flex-row gap-4 justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <div class="relative w-full md:w-96 text-gray-400 focus-within:text-green-600">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2"></i>
            <input type="text" x-model="searchQuery" placeholder="Tìm tên nhân viên, email, mã NV..." class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block pl-10 p-2.5 transition-colors" />
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto">
            <select class="bg-white border border-gray-200 text-gray-700 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 flex-1 md:w-auto font-medium">
                <option selected>Tất cả Bộ phận</option>
                <option value="kitchen">Bếp Chính</option>
                <option value="service">Phục vụ / Tạp vụ</option>
                <option value="warehouse">Kho & Hậu cần</option>
                <option value="management">Quản lý</option>
            </select>
            <button class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm transition">
                <i class="fas fa-filter text-gray-400"></i> <span class="hidden sm:inline font-medium text-sm">Lọc thêm</span>
            </button>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-gray-50 border-b border-gray-100 text-gray-500 text-[11px] uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Nhân viên</th>
                        <th class="px-6 py-4">Mã NV</th>
                        <th class="px-6 py-4">Khối / Bộ phận</th>
                        <th class="px-6 py-4">Ngày vào làm</th>
                        <th class="px-6 py-4">Trạng thái</th>
                        <th class="px-6 py-4 text-center">Tác vụ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <!-- Row 1 -->
                    <tr class="hover:bg-gray-50/80 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-4">
                                <img src="https://i.pravatar.cc/150?u=a042581f4e29026024d" alt="Avatar" class="w-10 h-10 rounded-full object-cover ring-2 ring-gray-100 shadow-sm" />
                                <div>
                                    <div class="font-bold text-gray-900 text-sm">Nguyễn Văn Khang</div>
                                    <div class="text-[12px] text-gray-500 mt-0.5">khang.nguyen@huitmeal.com</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-gray-600 font-medium tracking-wide">
                            <span class="bg-gray-100/80 text-gray-600 px-2.5 py-1 rounded-md text-xs font-bold border border-gray-200">#NV001</span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-100">
                                Bếp Trưởng
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-600 font-medium">01/01/2026</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2 text-green-600 font-bold text-xs bg-green-50 px-2.5 py-1 w-fit rounded-lg border border-green-100">
                                <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div> Đang làm việc
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center opacity-70 group-hover:opacity-100 transition-opacity">
                            <div class="flex items-center justify-center gap-2">
                                <a href="/Manager/EmployeeDetail/NV001" class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center hover:bg-blue-600 hover:text-white transition shadow-sm" title="Xem chi tiết">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                <button class="w-8 h-8 rounded-lg bg-gray-50 text-gray-600 flex items-center justify-center hover:bg-gray-200 hover:text-gray-900 transition border border-gray-200" title="Chỉnh sửa">
                                    <i class="fas fa-pen text-xs"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr class="hover:bg-gray-50/80 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold ring-2 ring-blue-50 shadow-sm">
                                    TB
                                </div>
                                <div>
                                    <div class="font-bold text-gray-900 text-sm">Trần Thị B</div>
                                    <div class="text-[12px] text-gray-500 mt-0.5">tran.thi.b@huitmeal.com</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-gray-600 font-medium tracking-wide">
                            <span class="bg-gray-100/80 text-gray-600 px-2.5 py-1 rounded-md text-xs font-bold border border-gray-200">#NV002</span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-100">
                                Phục vụ
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-600 font-medium">15/02/2026</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2 text-green-600 font-bold text-xs bg-green-50 px-2.5 py-1 w-fit rounded-lg border border-green-100">
                                <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div> Đang làm việc
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center opacity-70 group-hover:opacity-100 transition-opacity">
                            <div class="flex items-center justify-center gap-2">
                                <a href="/Manager/EmployeeDetail/NV002" class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center hover:bg-blue-600 hover:text-white transition shadow-sm" title="Xem chi tiết">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                                <button class="w-8 h-8 rounded-lg bg-gray-50 text-gray-600 flex items-center justify-center hover:bg-gray-200 hover:text-gray-900 transition border border-gray-200" title="Chỉnh sửa">
                                    <i class="fas fa-pen text-xs"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 3 -->
                    <tr class="hover:bg-gray-50/80 transition-colors group opacity-60">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-4">
                                <img src="https://i.pravatar.cc/150?u=a042581f4e29026704d" alt="Avatar" class="w-10 h-10 rounded-full object-cover ring-2 ring-gray-100 shadow-sm grayscale" />
                                <div>
                                    <div class="font-bold text-gray-700 text-sm line-through decoration-gray-400">Lê Hoàng C</div>
                                    <div class="text-[12px] text-gray-400 mt-0.5">hoang.le@huitmeal.com</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-gray-400 font-medium tracking-wide">
                            <span>#NV003</span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-500 border border-gray-200">
                                Kho Hậu Cần
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-400 font-medium">20/03/2026</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2 text-red-600 font-bold text-xs bg-red-50 px-2.5 py-1 w-fit rounded-lg border border-red-100">
                                <div class="w-1.5 h-1.5 rounded-full bg-red-500"></div> Đã nghỉ việc
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center opacity-70 group-hover:opacity-100 transition-opacity">
                            <div class="flex items-center justify-center gap-2">
                                <a href="/Manager/EmployeeDetail/NV003" class="w-8 h-8 rounded-lg bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-gray-300 transition shadow-sm" title="Khôi phục hồ sơ">
                                    <i class="fas fa-folder-open text-xs"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
            <span class="text-sm font-medium text-gray-500">Hiển thị <span class="text-gray-900 font-bold">1-3</span> trên <span class="text-gray-900 font-bold">45</span> nhân viên</span>
            <div class="flex gap-2">
                <button class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-500 bg-white font-medium hover:bg-gray-50 transition shadow-sm disabled:opacity-50" disabled>Trước</button>
                <div class="flex overflow-hidden border border-gray-300 rounded-lg shadow-sm">
                    <button class="px-3.5 py-1.5 bg-green-600 text-white text-sm font-bold">1</button>
                    <button class="px-3.5 py-1.5 bg-white text-gray-700 hover:bg-gray-50 text-sm font-medium border-l border-gray-300">2</button>
                    <button class="px-3.5 py-1.5 bg-white text-gray-700 hover:bg-gray-50 text-sm font-medium border-l border-gray-300">3</button>
                </div>
                <button class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-700 bg-white font-medium hover:bg-gray-50 transition shadow-sm">Sau</button>
            </div>
        </div>
    </div>

    <!-- MODAL: Thêm Nhân Viên -->
    <div x-show="isModalOpen" style="display: none;" class="fixed inset-0 z-[100] flex items-center justify-center px-4" x-transition.opacity.duration.300ms>
        
        <!-- Backdrop -->
        <div x-on:click="isModalOpen = false" class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity"></div>
        
        <!-- Modal Content -->
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl z-10 overflow-hidden transform transition-all" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
            
            <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center font-bold shadow-sm">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 tracking-tight">Tạo Hồ Sơ Nhân Viên Mới</h3>
                        <p class="text-xs font-medium text-gray-500 mt-0.5">Nhập đầy đủ thông tin pháp lý của Cán bộ nhân viên</p>
                    </div>
                </div>
                <button x-on:click="isModalOpen = false" class="text-gray-400 hover:text-gray-600 bg-white hover:bg-gray-100 w-8 h-8 rounded-lg flex items-center justify-center transition border border-gray-100 shadow-sm">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="px-6 py-6 pb-8 overflow-y-auto max-h-[70vh] custom-scrollbar">
                <form class="space-y-6">
                    
                    <!-- Basic Information -->
                    <div>
                        <h4 class="text-sm font-bold text-gray-900 border-b border-gray-100 pb-2 mb-4">1. Thông tin Định danh cơ bản</h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Họ và Tên <span class="text-red-500">*</span></label>
                                <input type="text" placeholder="Nguyễn Văn A" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 shadow-sm" />
                            </div>
                            
                            <!-- Image upload pretend -->
                            <div class="md:row-span-2 relative">
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Ảnh Thẻ Sinh Trắc Học</label>
                                <div class="w-full h-32 border-2 border-dashed border-gray-300 rounded-xl bg-gray-50 flex flex-col items-center justify-center text-gray-500 hover:border-green-500 hover:bg-green-50/50 transition cursor-pointer group">
                                    <i class="fas fa-image text-2xl mb-2 text-gray-400 group-hover:text-green-500 transition-colors"></i>
                                    <span class="text-xs font-medium content-center">Bấm để tải ảnh lên (Max: 5MB)</span>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Số CCCD / Hộ Chiếu <span class="text-red-500">*</span></label>
                                <input type="text" placeholder="001099002..." class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 shadow-sm" />
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Ngày sinh</label>
                                <input type="date" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 shadow-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Giới tính</label>
                                <select class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 shadow-sm">
                                    <option>Nam</option>
                                    <option>Nữ</option>
                                    <option>Khác</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Contact & Role -->
                    <div>
                        <h4 class="text-sm font-bold text-gray-900 border-b border-gray-100 pb-2 mb-4 mt-8">2. Thông tin Công tác & Liên hệ</h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Mã Chọn Khối Bộ Phận <span class="text-red-500">*</span></label>
                                <select class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 shadow-sm">
                                    <option>Bếp (Bếp Trưởng / Bếp Phụ)</option>
                                    <option>Sơ chế / Tạp vụ</option>
                                    <option>Giám sát An toàn Thực phẩm</option>
                                    <option>Vận chuyển / Logistic</option>
                                    <option>Nhân viên Quản trị</option>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Ngày bắt đầu làm việc</label>
                                <input type="date" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 shadow-sm" />
                            </div>

                            <div class="col-span-1 md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Số điện thoại liên lạc</label>
                                    <div class="flex shadow-sm rounded-lg overflow-hidden">
                                        <span class="inline-flex items-center px-3 bg-gray-50 border border-r-0 border-gray-300 text-gray-500 text-sm font-medium">
                                            +84
                                        </span>
                                        <input type="text" class="rounded-none rounded-r-lg bg-white border border-gray-300 text-gray-900 text-sm focus:ring-green-500 focus:border-green-500 block flex-1 min-w-0 w-full p-2.5" placeholder="909 123 456">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">Email làm việc nội bộ</label>
                                    <input type="email" placeholder="nv@huitmeal.com" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5 shadow-sm" />
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            
            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-3 rounded-b-2xl">
                <button type="button" x-on:click="isModalOpen = false" class="px-5 py-2.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 transition shadow-sm">
                    Hủy bỏ
                </button>
                <button type="button" class="px-6 py-2.5 text-sm font-bold text-white bg-green-600 rounded-xl hover:bg-green-700 focus:ring-4 focus:outline-none focus:ring-green-300 transition shadow-md flex items-center gap-2">
                    <i class="fas fa-save"></i> Hoàn tất thêm mới
                </button>
            </div>

        </div>
    </div>
</div>
