@{
    ViewData["Title"] = "Thực Đơn Tuần";
    Layout = "_LayoutManager";
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="menuPlanner()">
    
    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Kế hoạch Thực đơn</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Kéo thả món ăn từ kho vào các ngày trong tuần.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <button class="px-4 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2 hidden sm:flex text-sm">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                Áp dụng Template
            </button>
            <button class="px-6 py-2 bg-green-600 text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:bg-green-700 transition-all flex items-center gap-2 text-sm" @@click="saveData()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                Lưu thay đổi
            </button>
        </div>
    </div>

    <!-- MAIN WORKSPACE -->
    <div class="flex flex-col xl:flex-row gap-6 items-start">
        
        <!-- CALENDAR GRID -->
        <div class="flex-1 w-full bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col">
            <!-- Toolbar -->
            <div class="p-4 border-b border-slate-100 flex flex-wrap gap-4 items-center justify-between bg-slate-50/50">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="flex items-center bg-white border border-slate-200 rounded-lg p-1 shadow-sm">
                        <button class="p-1.5 hover:bg-slate-50 rounded text-slate-500 hover:text-slate-800 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        </button>
                        <div class="px-3 font-bold text-slate-700 text-sm flex items-center gap-2">
                            Tuần 18 (26/04 - 02/05)
                        </div>
                        <button class="p-1.5 hover:bg-slate-50 rounded text-slate-500 hover:text-slate-800 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                    
                    <select class="bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-lg px-3 py-2 outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                        <option>Ca Trưa - VP (45k)</option>
                        <option>Ca Trưa - NM (30k)</option>
                        <option>Ca Chiều</option>
                    </select>
                </div>
                <div class="flex flex-wrap items-center gap-3 text-[11px] font-bold text-slate-500 uppercase tracking-wider hidden md:flex">
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-green-500"></span> Chính</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span> Phụ</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Canh</span>
                </div>
            </div>

            <!-- Grid -->
            <div class="overflow-x-auto w-full">
                <div class="min-w-[900px] grid grid-cols-6 divide-x divide-slate-100">
                    <template x-for="(day, index) in days" :key="index">
                        <div class="flex flex-col bg-white">
                            <!-- Day Header -->
                            <div class="p-2 text-center border-b border-slate-100 flex flex-col items-center justify-center h-[80px]" :class="day.isToday ? 'bg-green-50 border-b-green-200' : ''">
                                <template x-if="day.isToday">
                                    <div class="bg-green-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase shadow-sm mb-1">Hôm nay</div>
                                </template>
                                <h3 class="font-bold text-slate-800 text-sm" x-text="day.name"></h3>
                                <p class="text-xs font-medium mt-0.5" :class="day.isToday ? 'text-green-600' : 'text-slate-400'" x-text="day.date"></p>
                            </div>
                            
                            <!-- Drop Zone -->
                            <div class="drop-zone flex-1 p-2 min-h-[450px] flex flex-col gap-2 transition-colors bg-slate-50/30" :class="day.isHoliday ? 'items-center justify-center bg-slate-50' : ''">
                                
                                <template x-if="day.isHoliday">
                                    <div class="text-center text-slate-400 opacity-50 select-none">
                                        <svg class="w-8 h-8 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                                        <span class="font-bold text-sm">Nghỉ lễ</span>
                                    </div>
                                </template>

                                <!-- Existing Meals in this day -->
                                <template x-for="meal in day.meals" :key="meal.id">
                                    <!-- Compact Text-Only Card for Calendar Grid -->
                                    <div class="meal-card group cursor-grab active:cursor-grabbing bg-white border rounded-lg p-2 shadow-sm hover:shadow relative"
                                         :class="getMealBorderColor(meal.type)">
                                        <!-- Remove Button -->
                                        <button @@click="removeMeal(index, meal.id)" class="absolute -top-2 -right-2 w-5 h-5 bg-red-100 text-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-sm z-10">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        </button>
                                        
                                        <div class="text-[9px] font-bold uppercase tracking-wider mb-1" :class="getMealTextColor(meal.type)" x-text="meal.type"></div>
                                        <div class="font-bold text-slate-800 text-xs leading-tight" x-text="meal.name"></div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <!-- SIDEBAR: MEAL LIBRARY -->
        <div class="w-full xl:w-72 shrink-0 bg-white rounded-[24px] shadow-sm border border-slate-100 flex flex-col h-[500px] xl:h-[calc(100vh-8rem)] xl:sticky xl:top-6">
            <div class="p-4 border-b border-slate-100 shrink-0 bg-slate-50/50 rounded-t-[24px]">
                <h3 class="font-black text-slate-800 text-base flex items-center gap-2 mb-3">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    Kho món ăn
                </h3>
                <div class="relative">
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" x-model="searchQuery" placeholder="Tìm kiếm món ăn..." class="w-full bg-white border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-sm font-medium outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all shadow-sm" />
                </div>
                
                <div class="flex gap-2 mt-3 overflow-x-auto no-scrollbar pb-1">
                    <button @@click="filterType = 'all'" class="px-2.5 py-1 text-[11px] font-bold rounded-md whitespace-nowrap transition-colors" :class="filterType === 'all' ? 'bg-slate-800 text-white shadow-sm' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'">Tất cả</button>
                    <button @@click="filterType = 'Món chính'" class="px-2.5 py-1 text-[11px] font-bold rounded-md whitespace-nowrap transition-colors" :class="filterType === 'Món chính' ? 'bg-green-100 text-green-800 shadow-sm' : 'bg-white text-slate-600 border border-slate-200 hover:bg-green-50'">Chính</button>
                    <button @@click="filterType = 'Canh'" class="px-2.5 py-1 text-[11px] font-bold rounded-md whitespace-nowrap transition-colors" :class="filterType === 'Canh' ? 'bg-blue-100 text-blue-800 shadow-sm' : 'bg-white text-slate-600 border border-slate-200 hover:bg-blue-50'">Canh</button>
                </div>
            </div>
            
            <div id="meal-library" class="flex-1 overflow-y-auto p-3 space-y-2 bg-slate-50/30">
                <template x-for="item in filteredLibrary" :key="item.id">
                    <!-- Library Item (Has Image) -->
                    <div class="meal-card group cursor-grab active:cursor-grabbing bg-white border border-slate-200 rounded-lg p-2 shadow-sm hover:shadow hover:border-green-300 transition-all flex items-center gap-3 select-none"
                         :data-id="item.id" :data-name="item.name" :data-type="item.type">
                        <div class="w-10 h-10 rounded bg-slate-100 overflow-hidden shrink-0">
                             <img :src="item.img" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" draggable="false" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-slate-800 text-xs truncate group-hover:text-green-600 transition-colors" x-text="item.name"></h4>
                            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded mt-1 inline-block uppercase tracking-wider" :class="getMealBadgeColor(item.type)" x-text="item.type"></span>
                        </div>
                        <svg class="w-4 h-4 text-slate-300 group-hover:text-slate-500 cursor-grab shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h8M8 15h8"></path></svg>
                    </div>
                </template>
                
                <div x-show="filteredLibrary.length === 0" class="text-center py-8 text-slate-400 text-sm font-medium" style="display: none;">
                    Không tìm thấy món ăn.
                </div>
            </div>
            
            <div class="p-3 border-t border-slate-100 bg-white rounded-b-[24px] shrink-0">
                <button class="w-full py-2 bg-slate-100 text-slate-700 font-bold rounded-lg hover:bg-slate-200 transition-colors flex items-center justify-center gap-2 text-sm shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Tạo món mới
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* SortableJS drag styles */
    .sortable-ghost { opacity: 0.4; background-color: #f8fafc; border: 2px dashed #cbd5e1; }
    .sortable-drag { cursor: grabbing !important; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); transform: rotate(2deg); opacity: 1 !important; z-index: 1000; }
</style>

@section Scripts {
    <!-- SortableJS library for Drag and Drop -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('menuPlanner', () => ({
                searchQuery: '',
                filterType: 'all',
                
                days: [
                    { name: 'Thứ 2', date: '26/04', isToday: true, isHoliday: false, meals: [
                        { id: 'm1', name: 'Gà kho gừng', type: 'Món chính' },
                        { id: 'm2', name: 'Trứng chiên thịt bằm', type: 'Món phụ' },
                        { id: 'm3', name: 'Canh rau ngót nấu mọc', type: 'Canh' }
                    ]},
                    { name: 'Thứ 3', date: '27/04', isToday: false, isHoliday: false, meals: [
                        { id: 'm4', name: 'Thịt kho tiêu', type: 'Món chính' }
                    ]},
                    { name: 'Thứ 4', date: '28/04', isToday: false, isHoliday: false, meals: []},
                    { name: 'Thứ 5', date: '29/04', isToday: false, isHoliday: false, meals: []},
                    { name: 'Thứ 6', date: '30/04', isToday: false, isHoliday: true, meals: []},
                    { name: 'Thứ 7', date: '01/05', isToday: false, isHoliday: true, meals: []}
                ],
                
                library: [
                    { id: 'l1', name: 'Sườn xào chua ngọt', type: 'Món chính', img: 'https://images.unsplash.com/photo-1544025162-811114215b24?w=100&q=80' },
                    { id: 'l2', name: 'Cá diêu hồng chiên xù', type: 'Món chính', img: 'https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?w=100&q=80' },
                    { id: 'l3', name: 'Thịt luộc cà pháo', type: 'Món phụ', img: 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=100&q=80' },
                    { id: 'l4', name: 'Canh chua cá lóc', type: 'Canh', img: 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100&q=80' },
                    { id: 'l5', name: 'Rau muống xào tỏi', type: 'Món phụ', img: 'https://images.unsplash.com/photo-1512058564366-18510be2db19?w=100&q=80' },
                    { id: 'l6', name: 'Đậu hũ dồn thịt', type: 'Món chính', img: 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=100&q=80' },
                    { id: 'l7', name: 'Chè trôi nước', type: 'Tráng miệng', img: 'https://images.unsplash.com/photo-1563805042-7684c8a9e9cb?w=100&q=80' }
                ],
                
                get filteredLibrary() {
                    return this.library.filter(item => {
                        const matchSearch = item.name.toLowerCase().includes(this.searchQuery.toLowerCase());
                        const matchType = this.filterType === 'all' || item.type === this.filterType;
                        return matchSearch && matchType;
                    });
                },
                
                getMealBorderColor(type) {
                    if(type === 'Món chính') return 'border-l-4 border-l-green-500';
                    if(type === 'Món phụ') return 'border-l-4 border-l-orange-500';
                    if(type === 'Canh') return 'border-l-4 border-l-blue-500';
                    return 'border-l-4 border-l-purple-500';
                },
                
                getMealTextColor(type) {
                    if(type === 'Món chính') return 'text-green-600';
                    if(type === 'Món phụ') return 'text-orange-600';
                    if(type === 'Canh') return 'text-blue-600';
                    return 'text-purple-600';
                },
                
                getMealBadgeColor(type) {
                    if(type === 'Món chính') return 'bg-green-100 text-green-700';
                    if(type === 'Món phụ') return 'bg-orange-100 text-orange-700';
                    if(type === 'Canh') return 'bg-blue-100 text-blue-700';
                    return 'bg-purple-100 text-purple-700';
                },
                
                removeMeal(dayIndex, mealId) {
                    this.days[dayIndex].meals = this.days[dayIndex].meals.filter(m => m.id !== mealId);
                },
                
                saveData() {
                    alert('Đã lưu thực đơn thành công!');
                },

                init() {
                    this.$nextTick(() => {
                        // Khởi tạo thư viện SortableJS cho Kho món ăn
                        new Sortable(document.getElementById('meal-library'), {
                            group: {
                                name: 'shared',
                                pull: 'clone', // Copy item khi kéo ra ngoài
                                put: false     // Không cho phép kéo ngược lại vào kho
                            },
                            animation: 150,
                            sort: false // Kho món ăn không cần sắp xếp lại thứ tự
                        });

                        // Khởi tạo SortableJS cho các ô ngày trong tuần (Drop Zones)
                        document.querySelectorAll('.drop-zone').forEach((zone, index) => {
                            // Chỉ áp dụng kéo thả cho những ngày không phải là ngày lễ
                            if (!this.days[index].isHoliday) {
                                new Sortable(zone, {
                                    group: 'shared',
                                    animation: 150,
                                    ghostClass: 'sortable-ghost',
                                    dragClass: 'sortable-drag',
                                    onAdd: (evt) => {
                                        // Lấy dữ liệu từ thẻ DOM vừa được thả vào
                                        const itemEl = evt.item;
                                        const id = itemEl.getAttribute('data-id') + '_' + Date.now();
                                        const name = itemEl.getAttribute('data-name');
                                        const type = itemEl.getAttribute('data-type');
                                        
                                        // Thêm dữ liệu vào mảng State của Alpine
                                        this.days[index].meals.push({ id, name, type });
                                        
                                        // Xóa thẻ DOM cũ đi vì Alpine sẽ tự động render lại UI theo State mới!
                                        itemEl.parentNode.removeChild(itemEl);
                                    }
                                });
                            }
                        });
                    });
                }
            }));
        });
    </script>
}
