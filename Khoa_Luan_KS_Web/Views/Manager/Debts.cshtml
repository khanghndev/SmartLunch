@{
    ViewData["Title"] = "Quản lý Công Nợ";
    Layout = "_LayoutManager";
}

<div class="p-2 sm:p-6 space-y-6">
    <h1 class="text-2xl font-bold text-green-600">Theo dõi Công Nợ & Thanh Toán</h1>

    <div class="bg-white rounded shadow overflow-x-auto border-t-4 border-red-500">
        <div class="px-6 py-4 border-b">
            <h3 class="font-bold">Danh sách đến hạn thanh toán</h3>
        </div>
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
                 <tr>
                    <th class="p-4">Khách hàng</th>
                    <th class="p-4">Số tiền nợ</th>
                    <th class="p-4">Hạn chót</th>
                    <th class="p-4">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-4 font-bold text-gray-700">KCN Quang Châu</td>
                    <td class="p-4 text-red-600 font-bold">120,500,000 ₫</td>
                    <td class="p-4 text-red-600 font-bold">Quá hạn 5 ngày</td>
                    <td class="p-4"><button class="bg-blue-100 text-blue-700 px-3 py-1 rounded text-xs font-bold hover:bg-blue-200">Gửi nhắc nợ</button></td>
                </tr>
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-4 font-bold text-gray-700">Trường Mầm Non ABC</td>
                    <td class="p-4 text-gray-700 font-bold">25,000,000 ₫</td>
                    <td class="p-4 text-gray-500">30/04/2026</td>
                    <td class="p-4"><span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded text-xs font-bold">Chờ thanh toán</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
