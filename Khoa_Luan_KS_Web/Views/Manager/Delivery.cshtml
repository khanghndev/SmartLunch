@{
    ViewData["Title"] = "Giao hàng & Vận chuyển";
    Layout = "_LayoutManager";
}

<div class="p-4 md:p-6 space-y-6 bg-slate-50 min-h-screen font-sans" x-data="deliveryManager()">
    
    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Điều phối Giao hàng (Logistics)</h1>
            <p class="text-slate-500 mt-1 font-medium text-sm">Quản lý đội xe, theo dõi lộ trình và ETA của các chuyến giao suất ăn.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <button class="px-5 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
                Liên hệ Tài xế
            </button>
            <button @@click="openDispatchModal()" class="px-5 py-2 bg-green-600 text-white font-bold rounded-xl shadow-lg shadow-green-600/30 hover:bg-green-700 transition-all flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Tạo chuyến giao hàng
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- MAP AREA -->
        <div class="lg:col-span-2 bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col h-[500px]">
            <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                    Bản đồ Giám sát Hành trình (GPS)
                </h3>
                <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                    Live Tracking
                </div>
            </div>
            
            <!-- Map Placeholder -->
            <div class="flex-1 bg-slate-100 relative overflow-hidden group">
                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cartographer.png')] opacity-10"></div>
                
                <!-- Fake routes -->
                <div class="absolute top-1/4 left-1/4 w-32 h-32 border-t-2 border-l-2 border-blue-500 border-dashed rounded-tl-full opacity-50"></div>
                <div class="absolute top-1/2 left-1/2 w-48 h-20 border-b-2 border-green-500 border-dashed opacity-50"></div>
                
                <!-- Fake Vehicles -->
                <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 bg-white rounded-full p-2 shadow-lg border-2 border-blue-500 hover:scale-110 transition-transform cursor-pointer group/pin">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                    <div class="absolute -top-10 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-[10px] font-bold py-1 px-2 rounded opacity-0 group-hover/pin:opacity-100 transition-opacity whitespace-nowrap">Xe 51D-123.45</div>
                </div>
                
                <div class="absolute top-[60%] left-[70%] -translate-x-1/2 -translate-y-1/2 bg-white rounded-full p-2 shadow-lg border-2 border-green-500 hover:scale-110 transition-transform cursor-pointer group/pin">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <div class="absolute -top-10 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-[10px] font-bold py-1 px-2 rounded opacity-0 group-hover/pin:opacity-100 transition-opacity whitespace-nowrap">KCN Tân Bình (Đã đến)</div>
                </div>

                <div class="absolute bottom-6 right-6 bg-white/90 backdrop-blur rounded-xl p-4 shadow-lg border border-slate-200">
                    <h4 class="font-bold text-slate-800 text-sm mb-2">Chú giải</h4>
                    <ul class="text-xs font-medium text-slate-600 space-y-1.5">
                        <li class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500"></span> Đang di chuyển</li>
                        <li class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-green-500"></span> Đã đến nơi</li>
                        <li class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-red-500"></span> Sự cố / Kẹt xe</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- FLEET / TRUCKS LIST -->
        <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden flex flex-col h-[500px]">
            <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <h3 class="font-black text-lg text-slate-800">Danh sách Chuyến xe</h3>
            </div>
            
            <div class="flex-1 overflow-y-auto p-4 space-y-3">
                <template x-for="trip in trips" :key="trip.id">
                    <div class="border border-slate-200 rounded-[16px] p-4 hover:border-blue-400 transition-colors cursor-pointer group relative overflow-hidden" @@click="viewTripDetail(trip)">
                        <div class="absolute left-0 top-0 bottom-0 w-1" :class="getStatusColor(trip.status)"></div>
                        
                        <div class="flex justify-between items-start mb-3 pl-2">
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm" x-text="trip.plate"></h4>
                                <p class="text-[11px] font-medium text-slate-500" x-text="'Tài xế: ' + trip.driver"></p>
                            </div>
                            <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded border" :class="getStatusBadge(trip.status)" x-text="trip.status"></span>
                        </div>
                        
                        <div class="pl-2 space-y-2">
                            <div class="flex items-start gap-2">
                                <div class="mt-0.5 text-slate-300">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                </div>
                                <p class="text-xs font-medium text-slate-700 leading-tight" x-text="'Đích: ' + trip.destination"></p>
                            </div>
                            <div class="flex items-center gap-2" x-show="trip.status === 'Đang đi'">
                                <div class="w-full bg-slate-100 rounded-full h-1.5">
                                    <div class="bg-blue-500 h-1.5 rounded-full" :style="'width: ' + trip.progress + '%'"></div>
                                </div>
                                <span class="text-[10px] font-bold text-blue-600 whitespace-nowrap" x-text="'ETA: ' + trip.eta"></span>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- MODAL: TẠO CHUYẾN XE (CRUD) -->
    <div x-show="isDispatchModalOpen" style="display: none;" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="isDispatchModalOpen" 
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" 
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="closeModal()"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="isDispatchModalOpen" 
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg" @@click.stop>
                    
                    <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h3 class="text-xl font-black text-slate-800">Tạo Chuyến Giao hàng</h3>
                        <button @@click="closeModal()" class="text-slate-400 hover:text-slate-600 bg-slate-200/50 hover:bg-slate-200 p-1.5 rounded-full transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    
                    <div class="p-6 space-y-5">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-2">Chọn Xe (Biển số)</label>
                                <select class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 bg-white">
                                    <option>51D-123.45 (Tải 1.5 tấn)</option>
                                    <option>51D-998.11 (Tải 2 tấn)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-2">Chọn Tài xế</label>
                                <select class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 bg-white">
                                    <option>Nguyễn Văn Tài</option>
                                    <option>Trần Lái Xe</option>
                                </select>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Lộ trình (Điểm đến)</label>
                            <input type="text" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 shadow-sm" placeholder="Nhập địa chỉ giao hàng..." />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Gắn kết Đơn hàng</label>
                            <select class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium focus:border-green-500 bg-slate-50 border-dashed">
                                <option>-- Chọn đơn hàng có sẵn --</option>
                                <option>ORD-1025 (KCN Tân Bình)</option>
                                <option>ORD-1026 (Quận 1)</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="px-6 py-5 bg-slate-50 border-t border-slate-100 flex justify-end gap-3 rounded-b-[32px]">
                        <button @@click="closeModal()" class="px-5 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-white border border-slate-200 transition-colors text-sm">Hủy</button>
                        <button @@click="submitDispatch()" class="px-6 py-2.5 rounded-xl bg-green-600 text-white font-bold hover:bg-green-700 transition-colors text-sm shadow-lg shadow-green-600/30 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            Bắt đầu chuyến đi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('deliveryManager', () => ({
                isDispatchModalOpen: false,
                
                trips: [
                    { id: 1, plate: 'Xe tải 51D-123.45', driver: 'Nguyễn Văn Tài', destination: 'KCN Tân Bình - Công ty TNHH B', status: 'Đang đi', progress: 65, eta: '15p' },
                    { id: 2, plate: 'Bán tải 51C-987.65', driver: 'Trần Bình', destination: 'Trường MN Họa Mi, Q.10', status: 'Đã giao', progress: 100, eta: '' },
                    { id: 3, plate: 'Xe tải 51D-456.78', driver: 'Lê Hoàng', destination: 'Khu CNC Quận 9', status: 'Chuẩn bị', progress: 0, eta: 'Đang xếp hàng' },
                    { id: 4, plate: 'Xe tải 51D-333.22', driver: 'Phạm Minh', destination: 'Quận 1 - Văn phòng Cty TMA', status: 'Đang đi', progress: 20, eta: '45p' }
                ],
                
                getStatusColor(status) {
                    if (status === 'Đang đi') return 'bg-blue-500';
                    if (status === 'Đã giao') return 'bg-green-500';
                    return 'bg-yellow-400';
                },
                
                getStatusBadge(status) {
                    if (status === 'Đang đi') return 'bg-blue-50 text-blue-700 border-blue-200';
                    if (status === 'Đã giao') return 'bg-green-50 text-green-700 border-green-200';
                    return 'bg-yellow-50 text-yellow-700 border-yellow-200';
                },
                
                openDispatchModal() {
                    this.isDispatchModalOpen = true;
                    document.body.style.overflow = 'hidden';
                },
                
                closeModal() {
                    this.isDispatchModalOpen = false;
                    document.body.style.overflow = '';
                },
                
                submitDispatch() {
                    alert('Đã điều phối xe thành công. Chuyến xe đang được theo dõi GPS!');
                    this.closeModal();
                },
                
                viewTripDetail(trip) {
                    // Logic to zoom map or show details
                    console.log('Viewing trip:', trip.plate);
                }
            }));
        });
    </script>
}
