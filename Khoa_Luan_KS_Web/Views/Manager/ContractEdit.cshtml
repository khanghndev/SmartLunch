@{
    ViewData["Title"] = "Chỉnh sửa Hợp đồng";
    Layout = "_LayoutManager";
}

<div class="p-2 sm:p-6 space-y-6">
    <div class="flex items-center gap-4 mb-4">
        <a href="/Manager/Contracts" class="bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded text-gray-700 font-medium">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h1 class="text-2xl font-bold text-green-600">Chỉnh sửa Hợp đồng HD-2026-SEV</h1>
    </div>

    <div class="bg-white rounded shadow p-6 max-w-3xl border-t-4 border-orange-500">
        <form class="space-y-4">
            <div>
                 <label class="block text-sm font-medium text-gray-700 mb-1">Tên hợp đồng</label>
                 <input type="text" value="Cung cấp cơm trưa Samsung Electronics VN" class="w-full border px-3 py-2 rounded focus:ring-green-500" />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                     <label class="block text-sm font-medium text-gray-700 mb-1">Ngày bắt đầu</label>
                     <input type="date" value="2026-01-01" class="w-full border px-3 py-2 rounded focus:ring-green-500" />
                </div>
                <div>
                     <label class="block text-sm font-medium text-gray-700 mb-1">Ngày kết thúc</label>
                     <input type="date" value="2026-12-31" class="w-full border px-3 py-2 rounded focus:ring-green-500" />
                </div>
            </div>
            
            <div class="border-t pt-4">
                <button type="button" class="bg-green-600 text-white px-6 py-2 rounded shadow hover:bg-green-700">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>
