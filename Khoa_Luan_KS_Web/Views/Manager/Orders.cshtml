@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    Layout = "_LayoutManager";
}

<div class="p-2 sm:p-6 space-y-6">
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-green-600">Quản lý Đơn hàng (Orders)</h1>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto border-t-4 border-green-600">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="p-4">Mã Đơn</th>
                    <th class="p-4">Khách hàng</th>
                    <th class="p-4">Suất ăn</th>
                    <th class="p-4">Thời gian giao</th>
                    <th class="p-4">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b">
                     <td class="p-4 font-bold text-gray-700">ORD-1001</td>
                     <td class="p-4">Nguyễn Văn A</td>
                     <td class="p-4">Văn Phòng Tiêu Chuẩn x 15</td>
                     <td class="p-4 text-gray-500">26/04 11:30</td>
                     <td class="p-4"><span class="px-2 py-1 bg-yellow-100 text-yellow-700 text-xs rounded font-bold">Chờ chuẩn bị</span></td>
                </tr>
                 <tr class="border-b">
                     <td class="p-4 font-bold text-gray-700">ORD-1002</td>
                     <td class="p-4">Công ty TNHH B</td>
                     <td class="p-4">Cơm trưa Nhà Máy x 150</td>
                     <td class="p-4 text-gray-500">26/04 11:00</td>
                     <td class="p-4"><span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs rounded font-bold">Đang giao</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
