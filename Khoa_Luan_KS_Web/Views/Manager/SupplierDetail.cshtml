@{
    ViewData["Title"] = "Chi Tiết Đối Tác ERP";
    Layout = "_LayoutManager";
}

<div class="px-4 py-6 md:p-8 space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-gray-500 font-medium" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/Manager/CatalogSuppliers" class="hover:text-green-600 transition flex items-center gap-2">
                    <i class="fas fa-truck"></i> Quản lý Đối Tác
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-400 text-xs mx-1"></i>
                    <span class="ml-1 md:ml-2 text-gray-900 font-bold">CP Foods VN (MST: 01019)</span>
                </div>
            </li>
        </ol>
    </nav>

    <!-- Header Action -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-orange-50 border border-orange-100 flex items-center justify-center p-1.5 shadow-sm">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Logo-cp-1-.png/800px-Logo-cp-1-.png" class="w-full h-full object-contain mix-blend-multiply" />
                </div>
                Chi Tiết C.Ty Cổ Phần Chăn Nuôi C.P. Việt Nam
            </h1>
        </div>
        <div class="flex items-center gap-3">
            <button class="bg-white border border-gray-300 text-gray-700 font-bold px-4 py-2 rounded-xl shadow-sm hover:bg-gray-50 transition flex items-center gap-2 text-sm">
                <i class="fas fa-file-pdf text-red-500"></i> Xuất Báo Cáo
            </button>
            <button class="bg-gray-100 hover:bg-gray-200 border border-gray-200 text-gray-700 font-bold px-4 py-2 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-pause-circle text-orange-500"></i> Tạm ngưng nhập
            </button>
            <button class="bg-green-600 hover:bg-green-700 text-white font-bold px-5 py-2 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fas fa-save"></i> Cập nhật File
            </button>
        </div>
    </div>

    <!-- Main Grid Dashboard -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        
        <!-- Cột Trái 1: Profile & Metrics -->
        <div class="xl:col-span-1 space-y-6">
            
            <!-- Company Mini Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 relative overflow-hidden">
                <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-green-50 to-transparent z-0"></div>
                <div class="relative z-10 space-y-4">
                    <div class="flex justify-between items-start">
                        <span class="px-2.5 py-1 bg-green-50 border border-green-100 text-green-700 rounded-lg text-[10px] font-bold tracking-wide uppercase">Tình trạng: Mở Ký Kết</span>
                    </div>
                    <div>
                        <div class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-1 mt-2">Mã số thuế & Định danh</div>
                        <h2 class="text-xl font-extrabold text-gray-900 tracking-wider">0 1 0 1 9 2 8 3 7 1</h2>
                        <p class="text-sm text-gray-500 font-medium mt-1">ĐKGD: Khu Công nghiệp Biên Hòa 2, Đồng Nai, Việt Nam</p>
                    </div>
                </div>
            </div>

            <!-- Trust Level Metrics -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-[13px] font-bold text-gray-900 uppercase tracking-wider mb-5 border-b border-gray-100 pb-3 flex items-center gap-2">
                    <i class="fas fa-chart-pie text-gray-400"></i> Radar Uy Tín (6 Tháng)
                </h3>
                
                <div class="space-y-5">
                    <div>
                        <div class="flex justify-between text-sm font-bold text-gray-800 mb-1">
                            <span>Độ chính xác (Giao hàng)</span>
                            <span class="text-green-600">98.5%</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-2">
                            <div class="bg-green-500 h-2 rounded-full" style="width: 98.5%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm font-bold text-gray-800 mb-1">
                            <span>Chất lượng đầu vào đạt chuẩn</span>
                            <span class="text-blue-600">95.0%</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-2">
                            <div class="bg-blue-500 h-2 rounded-full" style="width: 95%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm font-bold text-gray-800 mb-1">
                            <span>Giá cả Thị trường cạnh tranh</span>
                            <span class="text-orange-500">80.0%</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-2">
                            <div class="bg-orange-400 h-2 rounded-full" style="width: 80%"></div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-6 pt-5 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-500 uppercase">Hạng Đối Tác:</span>
                    <span class="bg-yellow-100 text-yellow-800 text-xs font-extrabold px-3 py-1 rounded-md border border-yellow-200">
                        DIAMOND (A+)
                    </span>
                </div>
            </div>

            <!-- Contact Point -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-[13px] font-bold text-gray-900 uppercase tracking-wider mb-5 border-b border-gray-100 pb-3 flex items-center gap-2">
                    <i class="fas fa-headset text-gray-400"></i> Liên lạc & Dispatch
                </h3>
                <div class="space-y-4">
                    <div class="flex items-start gap-4 p-3 bg-gray-50 rounded-xl border border-gray-200">
                        <div class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center font-bold text-blue-600">D</div>
                        <div>
                            <div class="font-bold text-gray-900 text-sm">Anh Trí Dũng (GĐ Sales)</div>
                            <div class="text-gray-500 text-xs font-medium">090.888.7766 • dung.tri@cp.com.vn</div>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 p-3 bg-gray-50 rounded-xl border border-gray-200">
                        <div class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center font-bold text-orange-600">QA</div>
                        <div>
                            <div class="font-bold text-gray-900 text-sm">CSKH Đầu Mối Kho</div>
                            <div class="text-gray-500 text-xs font-medium">1900 1200 • kho.dongnai@cp.com.vn</div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>

        <!-- Cột Phải: Logs, Documents & Orders -->
        <div class="xl:col-span-2 space-y-6">
            
            <!-- Document Compliance -->
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
                <h4 class="font-bold text-amber-800 text-sm mb-4 flex items-center gap-2">
                    <i class="fas fa-shield-virus"></i> Nền tảng Tuân thủ Pháp lý (Compliance)
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-white p-3 rounded-lg shadow-sm border border-amber-100 flex items-center justify-between">
                        <div>
                            <div class="text-[10px] font-bold text-gray-400 uppercase">Hợp Đồng Nguyên Tắc</div>
                            <div class="font-bold text-green-600 text-sm"><i class="fas fa-check-circle"></i> Có hiệu lực</div>
                        </div>
                        <i class="fas fa-file-contract text-2xl text-gray-200"></i>
                    </div>
                    <div class="bg-white p-3 rounded-lg shadow-sm border border-amber-100 flex items-center justify-between">
                        <div>
                            <div class="text-[10px] font-bold text-gray-400 uppercase">Giấy VSATTP Đầu Nguồn</div>
                            <div class="font-bold text-green-600 text-sm"><i class="fas fa-check-circle"></i> Đủ điều kiện</div>
                        </div>
                        <i class="fas fa-apple-alt text-2xl text-gray-200"></i>
                    </div>
                    <div class="bg-white p-3 rounded-lg shadow-sm border border-amber-100 flex items-center justify-between opacity-80">
                        <div>
                            <div class="text-[10px] font-bold text-red-400 uppercase">Kiểm Định Mẫu Thức Ăn</div>
                            <div class="font-bold text-red-600 text-sm">Sắp hết hạn (7/2026)</div>
                        </div>
                        <i class="fas fa-vial text-2xl text-red-100"></i>
                    </div>
                </div>
            </div>

            <!-- Pricing/Items Provided Grid -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                    <h3 class="font-bold text-gray-900 border-l-4 border-green-500 pl-3">Top Nhóm Hàng Nhập Thường Xuyên</h3>
                    <button class="text-sm font-bold text-green-600 hover:text-green-700">Xem bảng giá Đang chốt <i class="fas fa-arrow-right ml-1"></i></button>
                </div>
                <ul class="divide-y divide-gray-100">
                    <li class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-red-50 text-red-500 flex items-center justify-center"><i class="fas fa-drumstick-bite"></i></div>
                            <div>
                                <div class="font-bold text-gray-900 text-sm">Thịt Heo Nạc Vai / Ba Chỉ / Đùi</div>
                                <div class="text-xs text-gray-500 font-medium">Bảo quản lạnh 0-4 độ C</div>
                            </div>
                        </div>
                        <span class="bg-gray-100 text-gray-600 text-xs font-bold px-3 py-1 rounded border border-gray-200">~ 2 Tấn / Tuần</span>
                    </li>
                    <li class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center"><i class="fas fa-egg"></i></div>
                            <div>
                                <div class="font-bold text-gray-900 text-sm">Trứng Gà Tươi Vỉ Công nghiệp</div>
                                <div class="text-xs text-gray-500 font-medium">Cung cấp liên tục không trữ kho</div>
                            </div>
                        </div>
                        <span class="bg-gray-100 text-gray-600 text-xs font-bold px-3 py-1 rounded border border-gray-200">Trực tiếp hàng ngày</span>
                    </li>
                    <li class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center"><i class="fas fa-hotdog"></i></div>
                            <div>
                                <div class="font-bold text-gray-900 text-sm">Xúc Xích / Thịt Xông khói CP</div>
                                <div class="text-xs text-gray-500 font-medium">Date > 6 tháng</div>
                            </div>
                        </div>
                        <span class="bg-gray-100 text-gray-600 text-xs font-bold px-3 py-1 rounded border border-gray-200">Nhập mảng (Lô)</span>
                    </li>
                </ul>
            </div>

            <!-- Historical Orders (Simplified) -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/50">
                    <h3 class="font-bold text-gray-900 border-l-4 border-blue-500 pl-3">Lịch sử Phiếu Nhập Kho (PO) Gần Nhất</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-gray-50 border-b border-gray-100 text-gray-500 text-[10px] uppercase font-bold tracking-wider">
                            <tr>
                                <th class="px-6 py-3">Mã NhậpKho</th>
                                <th class="px-6 py-3">Ngày Ký Nhận</th>
                                <th class="px-6 py-3">Giá Trị PO</th>
                                <th class="px-6 py-3">Lệch / Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <tr>
                                <td class="px-6 py-3 font-bold text-blue-600">NK-240401-01</td>
                                <td class="px-6 py-3 text-gray-600 font-medium">01/04/2026 06:15 AM</td>
                                <td class="px-6 py-3 text-gray-900 font-bold">120,500,000 đ</td>
                                <td class="px-6 py-3 text-green-600 font-medium text-xs"><i class="fas fa-check"></i> Khớp số lượng</td>
                            </tr>
                            <tr>
                                <td class="px-6 py-3 font-bold text-blue-600">NK-240405-02</td>
                                <td class="px-6 py-3 text-gray-600 font-medium">05/04/2026 06:30 AM</td>
                                <td class="px-6 py-3 text-gray-900 font-bold">95,000,000 đ</td>
                                <td class="px-6 py-3 text-green-600 font-medium text-xs"><i class="fas fa-check"></i> Khớp số lượng</td>
                            </tr>
                            <tr>
                                <td class="px-6 py-3 font-bold text-blue-600">NK-240410-01</td>
                                <td class="px-6 py-3 text-gray-600 font-medium">10/04/2026 05:45 AM</td>
                                <td class="px-6 py-3 text-gray-900 font-bold">155,200,000 đ</td>
                                <td class="px-6 py-3 text-orange-500 font-medium text-xs"><i class="fas fa-exclamation-triangle"></i> Lệch 5kg Ức Gà (Lập BB)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="px-6 py-3 bg-gray-50 text-center text-sm font-medium text-blue-600 hover:text-blue-800 cursor-pointer transition">
                    Xem toàn bộ Báo cáo Nhập kho với Nhà cung cấp này
                </div>
            </div>

        </div>

    </div>
</div>
