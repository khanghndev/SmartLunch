@model Khoa_Luan_KS_Web.Models.OrganizationMealOrderPaymentResultVm
@{
    ViewData["Title"] = "Kết quả đặt hàng";
    Layout = "_LayoutCustomer";
}

<div class="mx-auto max-w-lg px-4 py-16 sm:px-6">
    <div class="rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-xl">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
            <i data-lucide="check-circle" class="h-9 w-9 text-emerald-600"></i>
        </div>
        <h1 class="text-2xl font-black text-slate-900">Đơn hàng đã được tạo</h1>
        @if (ViewBag.SuccessMessage is string ok)
        {
            <p class="mt-2 text-sm text-emerald-700">@ok</p>
        }
        @if (Model.OrderId > 0)
        {
            <p class="mt-4 text-sm text-slate-600">
                Mã đơn: <strong class="text-slate-900">#@Model.OrderId</strong>
            </p>
        }
        @if (Model.DepositPercent > 0)
        {
            <p class="mt-2 text-sm text-slate-600">
                Đặt cọc <strong>@Model.DepositPercent%</strong>:
                <strong class="text-orange-700">@Model.DepositAmountVnd.ToString("N0") đ</strong>
            </p>
        }
        @if (!string.IsNullOrEmpty(Model.PayOsMessage))
        {
            <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-900">@Model.PayOsMessage</p>
        }

        <div class="mt-8 flex flex-col gap-3">
            @if (!string.IsNullOrEmpty(Model.CheckoutUrl))
            {
                <a href="@Model.CheckoutUrl" target="_blank" rel="noopener"
                   class="inline-flex items-center justify-center gap-2 rounded-2xl bg-orange-500 px-6 py-3.5 text-sm font-black text-white shadow-lg hover:bg-orange-600">
                    <i data-lucide="credit-card" class="h-5 w-5"></i>
                    Tiếp tục thanh toán PayOS
                </a>
            }
            @if (Model.OrderId > 0)
            {
                <a asp-controller="Profile" asp-action="OrderDetail" asp-route-id="@Model.OrderId"
                   class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-bold text-slate-700 hover:border-orange-200 hover:text-orange-600">
                    <i data-lucide="file-text" class="h-5 w-5"></i>
                    Xem chi tiết đơn
                </a>
            }
            <a asp-controller="Profile" asp-action="Contracts"
               class="text-sm font-bold text-slate-500 hover:text-orange-600">Hợp đồng &amp; phụ lục</a>
            <a asp-action="Index" class="text-sm font-bold text-slate-400 hover:text-orange-500">Đặt suất mới</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', () => { if (window.lucide) lucide.createIcons(); });</script>
}
