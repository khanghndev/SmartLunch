                                <p class="text-sm font-medium">Đang tải mã khuyến mãi…</p>
                            </div>
                            <div x-show="!promoLoading && eligiblePromotions.length === 0" class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center">
