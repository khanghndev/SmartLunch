@model Khoa_Luan_KS_Web.Models.OrganizationMealOrderIndexVm
@using System.Text.Json
@using Khoa_Luan_KS_Web.Models
@using Khoa_Luan_KS_Web.Services
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Đặt suất theo đơn vị";
    Layout = "_LayoutCustomer";
    var categories = Model.Categories?.Categories ?? new List<Khoa_Luan_KS_Web.Services.OrganizationDishCategoryClientDto>();
    var categoriesJson = JsonSerializer.Serialize(categories, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var dateMin = Model.DateMin.ToString("yyyy-MM-dd");
    var dateMax = Model.DateMax.ToString("yyyy-MM-dd");
    var dateDefault = Model.DateDefault.ToString("yyyy-MM-dd");
    var dateRuleHint = Model.DateRuleHint;
    var antiToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? "";
    var antiTokenJson = JsonSerializer.Serialize(antiToken);
    var orgIdJson = Model.OrganizationId.ToString();
    var cartImportJson = JsonSerializer.Serialize(Model.CartImportLines ?? new List<CartImportLineDto>(), new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var deliveryDefaultsJson = JsonSerializer.Serialize(Model.DeliveryDefaults ?? new OrganizationMealDeliveryDefaultsVm(), new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var fromCart = Model.FromCart;
}

<style>
    [x-cloak] { display: none !important; }
    .org-meal-page {
        background-color: #f1f5f9;
        background-image: radial-gradient(circle at 1px 1px, rgba(148, 163, 184, 0.22) 1px, transparent 0);
        background-size: 24px 24px;
    }
    .org-step-line { flex: 1; height: 2px; min-width: 2rem; max-width: 5rem; border-radius: 999px; }
    .org-day-tab { scroll-snap-align: start; }
    .org-slot-card { transition: box-shadow 0.2s ease, transform 0.2s ease; }
    .org-slot-card:hover { box-shadow: 0 12px 40px -12px rgba(15, 23, 42, 0.12); }
    .org-picker-drawer-panel {
        box-shadow: -12px 0 48px -12px rgba(15, 23, 42, 0.25);
    }
    .org-picker-dish-row.is-selected {
        border-color: rgb(249 115 22);
        background: linear-gradient(135deg, #fff7ed 0%, #fff 100%);
        box-shadow: 0 0 0 2px rgba(249, 115, 22, 0.15);
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    /* Ẩn nút Zalo / Gọi / Chat khi mở drawer chọn món */
    body.hm-picker-open .hm-contact-fab-stack,
    body.hm-picker-open .hm-chat-panel {
        visibility: hidden !important;
        pointer-events: none !important;
        opacity: 0 !important;
    }
</style>

<div class="org-meal-page min-h-screen w-full font-sans text-slate-900" x-data="orgMealOrderApp" x-cloak>

    <!-- Hero -->
    <section class="relative h-[280px] overflow-hidden sm:h-[320px] lg:h-[360px]">
        <img src="https://images.unsplash.com/photo-1555244162-803834f70033?q=80&w=1920&auto=format&fit=crop"
             alt="" class="absolute inset-0 h-full w-full object-cover brightness-[0.45]" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/55 to-slate-900/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_80%_20%,rgba(249,115,22,0.25),transparent_55%)]"></div>
        <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col justify-end px-4 pb-10 pt-24 sm:px-6 lg:pb-14 lg:pt-28">
            <nav class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-white/70">
                <a href="/Customer/Index" class="transition hover:text-orange-300">Trang chủ</a>
                <span class="text-white/30">/</span>
                <span class="text-white/90">Đặt suất doanh nghiệp</span>
            </nav>
            <span class="mb-3 inline-flex w-fit items-center gap-2 rounded-full border border-orange-400/40 bg-orange-500/20 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-orange-200 backdrop-blur-sm">
                <i data-lucide="building-2" class="h-3 w-3"></i>
                Hợp đồng suất ăn theo đơn vị
            </span>
            <h1 class="max-w-3xl text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
                Thiết lập thực đơn <span class="text-orange-400">cho đơn vị của bạn</span>
            </h1>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">
                Thiết lập ngày phục vụ, giá thỏa thuận/suất và chọn món theo khung
                <strong class="text-white">Món chính · Món phụ · Canh</strong>.
                Tổng tiền = giá/suất × tổng suất món chính.
            </p>
            @if (Model.OrganizationId > 0)
            {
                <div class="mt-4 inline-flex w-fit items-center gap-2 rounded-2xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur-md">
                    <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/90 text-white shadow-lg">
                        <i data-lucide="school" class="h-4 w-4"></i>
                    </span>
                    @Model.OrganizationName
                </div>
            }
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:py-10">
        <div x-show="cartImportNotice" x-cloak
             class="mb-6 flex flex-col gap-3 rounded-2xl border border-orange-200 bg-orange-50 px-5 py-4 text-sm text-orange-950 shadow-sm sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-3">
                <i data-lucide="shopping-cart" class="mt-0.5 h-5 w-5 shrink-0 text-orange-600"></i>
                <span x-text="cartImportNotice"></span>
            </div>
            <button type="button" @@click="goStep2FromCart()"
                    class="shrink-0 rounded-xl bg-orange-600 px-4 py-2 text-xs font-bold text-white hover:bg-orange-700">
                Đi tới chọn món
            </button>
        </div>
        @if (TempData["OrgMealError"] is string err && !string.IsNullOrEmpty(err))
        {
            <div class="mb-6 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 shadow-sm">
                <i data-lucide="alert-circle" class="mt-0.5 h-5 w-5 shrink-0"></i>
                <span>@err</span>
            </div>
        }
        <div x-show="draftCacheNotice" x-cloak
             class="mb-6 flex flex-col gap-3 rounded-2xl border border-sky-200 bg-sky-50 px-5 py-4 text-sm text-sky-950 shadow-sm sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-3">
                <i data-lucide="history" class="mt-0.5 h-5 w-5 shrink-0 text-sky-600"></i>
                <span x-text="draftCacheNotice"></span>
            </div>
            <button type="button" @@click="clearDraftCache(true)"
                    class="shrink-0 rounded-xl border border-sky-300 bg-white px-4 py-2 text-xs font-bold text-sky-800 hover:bg-sky-100">
                Xóa bản nháp
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Model.ApiError))
        {
            <div class="rounded-3xl border border-amber-200 bg-white p-10 text-center shadow-xl ring-1 ring-slate-900/5">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-100">
                    <i data-lucide="alert-triangle" class="h-7 w-7 text-amber-600"></i>
                </div>
                <p class="text-lg font-black text-amber-900">@Model.ApiError</p>
                <a href="/Customer/Contact" class="mt-5 inline-flex items-center gap-2 rounded-full bg-orange-500 px-6 py-2.5 text-sm font-bold text-white shadow-lg hover:bg-orange-600">
                    Liên hệ hỗ trợ <i data-lucide="arrow-right" class="h-4 w-4"></i>
                </a>
            </div>
        }
        else if (Model.OrganizationId > 0)
        {
            <!-- Stepper -->
            <div class="mb-8 overflow-hidden rounded-3xl border border-slate-200/80 bg-white px-4 py-5 shadow-sm ring-1 ring-slate-900/5 sm:px-8">
                <div class="flex items-center justify-center gap-0 sm:gap-1">
                    <template x-for="(s, idx) in stepMeta" :key="s.key">
                        <div class="flex items-center gap-0 sm:gap-1">
                            <div class="flex flex-col items-center gap-2 px-2 sm:px-4">
                                <span class="relative flex h-10 w-10 items-center justify-center rounded-2xl text-sm font-black transition-all duration-300 sm:h-11 sm:w-11"
                                      :class="step === idx + 1
                                        ? 'bg-gradient-to-br from-orange-500 to-amber-500 text-white shadow-lg shadow-orange-500/35 scale-105'
                                        : (step > idx + 1
                                            ? 'bg-emerald-500 text-white shadow-md shadow-emerald-500/25'
                                            : 'border-2 border-slate-200 bg-slate-50 text-slate-400')">
                                    <template x-if="step > idx + 1">
                                        <i data-lucide="check" class="h-5 w-5"></i>
                                    </template>
                                    <template x-if="step <= idx + 1">
                                        <span x-text="idx + 1"></span>
                                    </template>
                                </span>
                                <div class="text-center">
                                    <p class="text-xs font-black sm:text-sm"
                                       :class="step === idx + 1 ? 'text-orange-600' : (step > idx + 1 ? 'text-emerald-700' : 'text-slate-400')"
                                       x-text="s.label"></p>
                                    <p class="hidden text-[10px] text-slate-400 sm:block" x-text="s.hint"></p>
                                </div>
                            </div>
                            <div x-show="idx < 2" class="org-step-line mb-6 hidden sm:block"
                                 :class="step > idx + 1 ? 'bg-emerald-400' : 'bg-slate-200'"></div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Step 1 -->
            <div x-show="step === 1" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
                <div class="grid gap-8 lg:grid-cols-[1fr_320px]">
                    <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-orange-50/30 px-6 py-5 sm:px-8">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-600">Bước 1</p>
                            <h2 class="mt-1 text-xl font-black text-slate-900 sm:text-2xl">Thiết lập đơn hàng</h2>
                            <p class="mt-1 text-sm text-slate-500">Chọn giá/suất và thêm các ngày phục vụ trước khi chọn món.</p>
                        </div>
                        <div class="space-y-8 p-6 sm:p-8">
                            <!-- Price -->
                            <div class="rounded-2xl border border-orange-100 bg-gradient-to-br from-orange-50/80 to-amber-50/40 p-5 sm:p-6">
                                <div class="flex items-start gap-4">
                                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-orange-500 text-white shadow-lg shadow-orange-500/30">
                                        <i data-lucide="badge-dollar-sign" class="h-6 w-6"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <label class="block text-[11px] font-black uppercase tracking-wider text-orange-800/80">Giá thỏa thuận / suất (VND)</label>
                                        <div class="relative mt-2">
                                            <select x-model.number="pricePerPortion"
                                                    class="w-full cursor-pointer appearance-none rounded-2xl border border-orange-200/80 bg-white py-3.5 pl-4 pr-14 text-2xl font-black text-slate-900 shadow-inner focus:border-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-200">
                                                <option value="25000">25.000 đ</option>
                                                <option value="30000">30.000 đ</option>
                                                <option value="45000">45.000 đ</option>
                                                <option value="60000">60.000 đ</option>
                                            </select>
                                            <i data-lucide="chevron-down" class="pointer-events-none absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dates -->
                            <div>
                                <div class="mb-3 flex items-center gap-2">
                                    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
                                        <i data-lucide="calendar-plus" class="h-4 w-4"></i>
                                    </div>
                                    <div>
                                        <label class="block text-[11px] font-black uppercase tracking-wider text-slate-500">Thêm ngày phục vụ</label>
                                        <p class="text-xs text-slate-400">Khoảng: @Model.DateMin.ToString("dd/MM/yyyy") – @Model.DateMax.ToString("dd/MM/yyyy")</p>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-3 sm:flex-row">
                                    <input type="date" x-model="newDate" :min="dateMin" :max="dateMax"
                                           class="h-12 flex-1 rounded-2xl border border-slate-200 bg-slate-50/50 px-4 text-sm font-semibold text-slate-900 focus:border-emerald-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                                    <button type="button" @@click="addDay()"
                                            class="inline-flex h-12 items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 px-6 text-sm font-black text-white shadow-lg shadow-emerald-600/25 transition hover:from-emerald-700 hover:to-teal-700">
                                        <i data-lucide="plus" class="h-4 w-4"></i> Thêm ngày
                                    </button>
                                </div>
                                <div class="mt-4 flex gap-3 rounded-2xl border border-blue-100 bg-blue-50/90 p-4">
                                    <i data-lucide="clock" class="mt-0.5 h-5 w-5 shrink-0 text-blue-600"></i>
                                    <p class="text-xs leading-relaxed text-blue-900">@dateRuleHint</p>
                                </div>
                                <div x-show="mealDays.length > 0" class="mt-5">
                                    <p class="mb-2 text-[10px] font-black uppercase tracking-wider text-slate-400">
                                        Đã chọn <span x-text="mealDays.length"></span> ngày
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        <template x-for="day in mealDays" :key="day.serviceDate">
                                            <span class="group inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white py-2 pl-3 pr-2 text-sm font-bold text-slate-800 shadow-sm transition hover:border-orange-200 hover:shadow-md">
                                                <i data-lucide="calendar-days" class="h-4 w-4 text-emerald-600"></i>
                                                <span x-text="formatDate(day.serviceDate)"></span>
                                                <button type="button" @@click="removeDay(day.serviceDate)"
                                                        class="flex h-7 w-7 items-center justify-center rounded-lg text-slate-400 transition hover:bg-red-50 hover:text-red-600"
                                                        title="Xóa ngày">&times;</button>
                                            </span>
                                        </template>
                                    </div>
                                </div>
                                <div x-show="mealDays.length === 0" class="mt-4 rounded-2xl border border-dashed border-slate-200 bg-slate-50/80 px-4 py-8 text-center">
                                    <i data-lucide="calendar-x" class="mx-auto mb-2 h-8 w-8 text-slate-300"></i>
                                    <p class="text-sm font-medium text-slate-500">Chưa có ngày phục vụ — hãy thêm ít nhất một ngày.</p>
                                </div>
                            </div>

                            <div x-show="formError" class="flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                                <i data-lucide="circle-alert" class="h-4 w-4 shrink-0"></i>
                                <span x-text="formError"></span>
                            </div>

                            <button type="button" @@click="goStep2()"
                                    class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 py-4 text-sm font-black text-white shadow-xl shadow-orange-500/30 transition hover:from-orange-600 hover:to-amber-600 hover:shadow-orange-500/40">
                                Tiếp tục — lập thực đơn
                                <i data-lucide="arrow-right" class="h-5 w-5 transition group-hover:translate-x-0.5"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Step 1 sidebar -->
                    <aside class="space-y-4 lg:sticky lg:top-28 lg:self-start">
                        <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-5 shadow-lg ring-1 ring-slate-900/5">
                            <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Quy trình</p>
                            <ul class="mt-4 space-y-3">
                                <li class="flex gap-3 text-sm">
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-orange-100 text-xs font-black text-orange-700">1</span>
                                    <span class="text-slate-600"><strong class="text-slate-800">Thiết lập</strong> — giá/suất và ngày giao</span>
                                </li>
                                <li class="flex gap-3 text-sm">
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-xs font-black text-slate-500">2</span>
                                    <span class="text-slate-600"><strong class="text-slate-800">Thực đơn</strong> — chọn món từng ngày</span>
                                </li>
                                <li class="flex gap-3 text-sm">
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-xs font-black text-slate-500">3</span>
                                    <span class="text-slate-600"><strong class="text-slate-800">Khuyến mãi</strong> — chọn mã, rồi xem nháp HĐ</span>
                                </li>
                            </ul>
                        </div>
                        <div class="rounded-3xl border border-emerald-100 bg-gradient-to-br from-emerald-50 to-teal-50/50 p-5">
                            <div class="flex items-center gap-2 text-emerald-800">
                                <i data-lucide="shield-check" class="h-5 w-5"></i>
                                <p class="text-sm font-black">Cam kết HuitMeal</p>
                            </div>
                            <p class="mt-2 text-xs leading-relaxed text-emerald-900/80">
                                Chuẩn ATTP, nguồn nguyên liệu kiểm soát, giao đúng khối lượng suất theo hợp đồng đơn vị.
                            </p>
                        </div>
                    </aside>
                </div>
            </div>

            <!-- Step 2 -->
            <div x-show="step === 2" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
                <div x-show="cartImportLines.length > 0" x-cloak
                     class="mb-5 flex flex-col gap-3 rounded-2xl border border-orange-200/90 bg-gradient-to-r from-orange-50 to-amber-50/60 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-start gap-3 text-sm text-orange-950">
                        <i data-lucide="shopping-bag" class="mt-0.5 h-5 w-5 shrink-0 text-orange-600"></i>
                        <div>
                            <p class="font-bold">Có <span x-text="cartImportLines.length"></span> món trong giỏ hàng</p>
                            <p class="mt-0.5 text-xs text-orange-900/80">Chọn tab <strong>「Từ giỏ hàng」</strong> khi thêm món, hoặc áp dụng nhanh cho ngày đang chọn.</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 shrink-0">
                        <button type="button" @@click="applyCartToDay(activeDay, false)"
                                class="rounded-xl border border-orange-300 bg-white px-3 py-2 text-xs font-bold text-orange-800 hover:bg-orange-100">
                            Áp dụng cho ngày này
                        </button>
                        <button type="button" @@click="applyCartToAllDays()"
                                class="rounded-xl bg-orange-600 px-3 py-2 text-xs font-bold text-white hover:bg-orange-700">
                            Áp dụng mọi ngày
                        </button>
                    </div>
                </div>
                <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-600">Bước 2</p>
                        <h2 class="text-xl font-black text-slate-900 sm:text-2xl">Thực đơn theo ngày</h2>
                        <p class="mt-1 max-w-xl text-sm text-slate-500">
                            <strong class="text-orange-600">SL</strong> = số suất. Tổng món phụ và canh mỗi ngày
                            <strong class="text-violet-700">không vượt</strong> tổng suất món chính.
                        </p>
                    </div>
                    <button type="button" @@click="step = 1"
                            class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm hover:border-orange-200 hover:text-orange-600">
                        <i data-lucide="pencil" class="h-4 w-4"></i> Sửa thiết lập
                    </button>
                </div>

                <div class="grid gap-8 lg:grid-cols-[1fr_340px]">
                    <div class="space-y-5">
                        <!-- Day tabs -->
                        <div class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-2 shadow-sm">
                            <div class="flex gap-2 overflow-x-auto pb-1 no-scrollbar scroll-smooth" style="scroll-snap-type: x mandatory;">
                                <template x-for="day in mealDays" :key="day.serviceDate">
                                    <button type="button" @@click="activeDay = day.serviceDate"
                                            class="org-day-tab shrink-0 rounded-xl px-4 py-2.5 text-xs font-black transition-all"
                                            :class="activeDay === day.serviceDate
                                                ? 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white shadow-md shadow-emerald-600/25'
                                                : 'bg-slate-50 text-slate-600 hover:bg-slate-100'">
                                        <span x-text="formatDate(day.serviceDate)"></span>
                                        <span class="mt-0.5 block text-[10px] font-semibold opacity-80"
                                              x-text="daySlotTotal(day, 'main') + ' suất chính'"></span>
                                    </button>
                                </template>
                            </div>
                        </div>

                        <template x-for="day in mealDays" :key="'panel-' + day.serviceDate">
                            <div x-show="activeDay === day.serviceDate" class="space-y-4">
                                <!-- Day stats bar -->
                                <div class="grid gap-3 sm:grid-cols-3">
                                    <div class="flex items-center gap-3 rounded-2xl border border-emerald-100 bg-emerald-50/80 px-4 py-3">
                                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 text-white">
                                            <i data-lucide="utensils" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-bold uppercase text-emerald-700/80">Món chính</p>
                                            <p class="text-lg font-black text-emerald-900"><span x-text="daySlotTotal(day, 'main')"></span> suất</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 rounded-2xl border px-4 py-3"
                                         :class="daySlotBalanceUiClass(day, 'side')">
                                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-600 text-white">
                                            <i data-lucide="salad" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-bold uppercase text-violet-700/80">Món phụ</p>
                                            <p class="text-lg font-black" x-text="daySlotTotal(day, 'side') + ' / ' + daySlotTotal(day, 'main') + ' suất'"></p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 rounded-2xl border px-4 py-3"
                                         :class="daySlotBalanceUiClass(day, 'soup')">
                                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-700 text-white">
                                            <i data-lucide="soup" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-bold uppercase text-slate-500">Canh</p>
                                            <p class="text-lg font-black" x-text="daySlotTotal(day, 'soup') + ' / ' + daySlotTotal(day, 'main') + ' suất'"></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-amber-100 bg-amber-50/80 px-4 py-3 text-xs text-amber-950">
                                    <span>Mỗi suất ăn = món chính + món phụ + canh <strong>cùng số lượng</strong> trong ngày.</span>
                                    <button type="button" @@click="balanceSideSoupToMain(day)"
                                            class="rounded-lg bg-amber-600 px-3 py-1.5 font-bold text-white hover:bg-amber-700">
                                        Cân bằng món phụ &amp; canh
                                    </button>
                                </div>

                                <template x-for="slot in slots" :key="slot.key">
                                    <article class="org-slot-card overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm ring-1 ring-slate-900/5">
                                        <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-6"
                                             :class="slot.key === 'main'
                                                ? 'bg-gradient-to-r from-emerald-700 via-emerald-600 to-teal-600'
                                                : (slot.key === 'side' ? 'bg-gradient-to-r from-violet-800 to-violet-600' : 'bg-gradient-to-r from-slate-800 to-slate-700')">
                                            <div class="flex items-center gap-3 text-white">
                                                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/15 backdrop-blur">
                                                    <i :data-lucide="slot.icon" class="h-5 w-5"></i>
                                                </span>
                                                <div>
                                                    <p class="text-sm font-black uppercase tracking-wide" x-text="slot.label"></p>
                                                    <p class="text-[10px] font-semibold text-white/70" x-text="slot.desc"></p>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span x-show="slot.key === 'main'" class="rounded-full bg-amber-400/90 px-2.5 py-0.5 text-[10px] font-black text-amber-950">Tính tiền</span>
                                                <button type="button" @@click="openPicker(day.serviceDate, slot.key)"
                                                        :disabled="slot.key !== 'main' && daySlotTotal(day, 'main') > 0 && daySlotTotal(day, slot.key) >= daySlotTotal(day, 'main')"
                                                        :class="slot.key !== 'main' && daySlotTotal(day, 'main') > 0 && daySlotTotal(day, slot.key) >= daySlotTotal(day, 'main') ? 'cursor-not-allowed opacity-50' : 'hover:bg-white/25'"
                                                        :title="slot.key !== 'main' ? 'Tổng suất phải bằng món chính' : ''"
                                                        class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-xs font-black text-white backdrop-blur transition">
                                                    <i data-lucide="plus-circle" class="h-4 w-4"></i> Thêm món
                                                </button>
                                            </div>
                                        </div>
                                        <div class="p-5 sm:p-6">
                                            <template x-if="getLines(day, slot.key).length === 0">
                                                <button type="button" @@click="openPicker(day.serviceDate, slot.key)"
                                                        class="flex w-full flex-col items-center gap-2 rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/50 py-10 text-slate-400 transition hover:border-orange-200 hover:bg-orange-50/30 hover:text-orange-600">
                                                    <i data-lucide="plus" class="h-8 w-8"></i>
                                                    <span class="text-sm font-bold">Chưa có món — nhấn để thêm</span>
                                                </button>
                                            </template>
                                            <ul class="space-y-2">
                                                <template x-for="(line, li) in getLines(day, slot.key)" :key="line.dishId">
                                                    <li class="flex flex-wrap items-center gap-3 rounded-2xl border border-slate-100 bg-gradient-to-r from-white to-slate-50/80 p-4 transition hover:border-orange-100 hover:shadow-sm">
                                                        <div class="relative h-12 w-12 shrink-0 overflow-hidden rounded-xl bg-gradient-to-br from-orange-50 to-amber-50 ring-1 ring-slate-100/90">
                                                            <img x-show="lineThumbSrc(line) && !dishThumbFailed(line)"
                                                                 :src="lineThumbSrc(line)"
                                                                 :alt="line.dishName"
                                                                 loading="lazy"
                                                                 decoding="async"
                                                                 @@error="onDishThumbError(line)"
                                                                 class="absolute inset-0 h-full w-full object-cover" />
                                                            <div x-show="!lineThumbSrc(line) || dishThumbFailed(line)"
                                                                 class="absolute inset-0 flex items-center justify-center text-orange-500">
                                                                <i data-lucide="utensils" class="h-5 w-5"></i>
                                                            </div>
                                                        </div>
                                                        <div class="min-w-0 flex-1">
                                                            <p class="font-bold text-slate-900" x-text="line.dishName"></p>
                                                            <p class="text-[11px] text-slate-400" x-show="slot.key === 'main'">Tính vào tổng suất</p>
                                                        </div>
                                                        <div class="flex items-center gap-1 rounded-xl border border-slate-200 bg-white p-1 shadow-sm">
                                                            <button type="button" @@click="changeQty(day.serviceDate, slot.key, line.dishId, -1)"
                                                                    class="flex h-9 w-9 items-center justify-center rounded-lg font-bold text-slate-600 hover:bg-orange-50 hover:text-orange-600">−</button>
                                                            <input type="number" min="1" x-model.number="line.quantity"
                                                                   @@blur="normalizeQty(line, day.serviceDate, slot.key)"
                                                                   class="w-14 border-0 bg-transparent py-1 text-center text-sm font-black text-slate-900 focus:ring-0" />
                                                            <button type="button" @@click="changeQty(day.serviceDate, slot.key, line.dishId, 1)"
                                                                    class="flex h-9 w-9 items-center justify-center rounded-lg font-bold text-slate-600 hover:bg-orange-50 hover:text-orange-600">+</button>
                                                        </div>
                                                        <button type="button" @@click="removeLine(day.serviceDate, slot.key, line.dishId)"
                                                                class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 transition hover:bg-red-50 hover:text-red-600"
                                                                title="Xóa món">
                                                            <i data-lucide="trash-2" class="h-4 w-4"></i>
                                                        </button>
                                                    </li>
                                                </template>
                                            </ul>
                                        </div>
                                    </article>
                                </template>
                            </div>
                        </template>

                        <div x-show="formError" class="flex items-center justify-center gap-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                            <i data-lucide="circle-alert" class="h-4 w-4"></i>
                            <span x-text="formError"></span>
                        </div>
                    </div>

                    <!-- Step 2 sidebar -->
                    <aside class="lg:sticky lg:top-28 lg:self-start">
                        <div class="overflow-hidden rounded-3xl border border-orange-200/80 bg-white shadow-xl ring-1 ring-orange-500/10">
                            <div class="bg-gradient-to-br from-orange-500 to-amber-500 px-6 py-5 text-white">
                                <p class="text-[10px] font-black uppercase tracking-wider text-orange-100">Tạm tính đơn</p>
                                <p class="mt-1 text-3xl font-black">
                                    <span x-text="formatMoney(estimatedTotal())"></span>
                                    <span class="text-lg font-bold opacity-80">đ</span>
                                </p>
                            </div>
                            <div class="space-y-4 p-6">
                                <div class="flex justify-between text-sm">
                                    <span class="text-slate-500">Giá / suất</span>
                                    <span class="font-black text-slate-900"><span x-text="formatMoney(pricePerPortion)"></span> đ</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-slate-500">Tổng suất món chính</span>
                                    <span class="font-black text-emerald-700" x-text="totalMainQty()"></span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-slate-500">Số ngày phục vụ</span>
                                    <span class="font-black text-slate-900" x-text="mealDays.length"></span>
                                </div>
                                <div class="border-t border-slate-100 pt-4">
                                    <p class="mb-2 text-[10px] font-black uppercase tracking-wider text-slate-400">Công thức</p>
                                    <p class="text-xs leading-relaxed text-slate-500">
                                        Tổng = giá/suất × tổng SL món chính (tất cả ngày). Món phụ &amp; canh: 0đ.
                                    </p>
                                </div>
                                <div class="flex flex-col gap-2 pt-2">
                                    <button type="button" @@click="step = 1"
                                            class="rounded-xl border border-slate-200 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-50">
                                        Quay lại thiết lập
                                    </button>
                                    <button type="button" @@click="goStep3()"
                                            class="flex items-center justify-center gap-2 rounded-2xl bg-slate-900 py-3.5 text-sm font-black text-white shadow-lg transition hover:bg-orange-600">
                                        <i data-lucide="arrow-right" class="h-4 w-4"></i>
                                        Tiếp tục — chọn khuyến mãi
                                    </button>
                                </div>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>

            <!-- Step 3: Promotion -->
            <div x-show="step === 3" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
                <div class="grid gap-8 lg:grid-cols-[1fr_340px]">
                    <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-violet-50 via-white to-orange-50/40 px-6 py-5 sm:px-8">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-violet-600">Bước 3</p>
                            <h2 class="mt-1 text-xl font-black text-slate-900 sm:text-2xl">Chọn mã khuyến mãi</h2>
                            <p class="mt-1 text-sm text-slate-500">Chọn từ danh sách mã phù hợp hoặc nhập mã thủ công. Có thể bỏ qua nếu không dùng KM.</p>
                        </div>
                        <div class="space-y-6 p-6 sm:p-8">
                            <div x-show="promoLoading" class="flex flex-col items-center py-12 text-slate-500">
                                <div class="mb-3 h-10 w-10 animate-spin rounded-full border-2 border-violet-200 border-t-violet-600"></div>
                                <p class="text-sm font-medium">Đang tải mã khuyến mãi…</p>
                            </div>
                            <div x-show="!promoLoading && eligiblePromotions.length === 0" class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center">
                                <i data-lucide="ticket" class="mx-auto mb-2 h-8 w-8 text-slate-300"></i>
                                <p class="text-sm font-semibold text-slate-600">Không có mã khuyến mãi phù hợp</p>
                                <p class="mt-1 text-xs text-slate-500" x-text="promoListMessage || 'Bạn vẫn có thể tiếp tục đặt hàng mà không áp dụng KM.'"></p>
                            </div>
                            <div x-show="!promoLoading && eligiblePromotions.length > 0" class="space-y-3">
                                <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Mã khuyến mãi khả dụng</p>
                                <div class="grid gap-3 sm:grid-cols-2">
                                    <template x-for="p in eligiblePromotions" :key="p.promotionId">
                                        <button type="button" @@click="selectPromotion(p)"
                                                class="relative rounded-2xl border p-4 text-left transition hover:shadow-md"
                                                :class="selectedPromotionId === p.promotionId ? 'border-violet-500 bg-violet-50/80 ring-2 ring-violet-200' : 'border-slate-200 bg-white hover:border-violet-200'">
                                            <span x-show="p.isRecommended" class="absolute -top-2 right-3 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 px-2.5 py-0.5 text-[9px] font-black uppercase tracking-wide text-white shadow">Đề xuất</span>
                                            <p class="pr-16 text-sm font-black text-slate-900" x-text="p.promotionName"></p>
                                            <p class="mt-0.5 font-mono text-xs font-bold uppercase text-violet-700" x-text="p.promotionCode || '—'"></p>
                                            <p class="mt-2 line-clamp-2 text-xs text-slate-500" x-show="p.description" x-text="p.description"></p>
                                            <p class="mt-3 text-base font-black text-emerald-700">−<span x-text="formatMoney(p.discountAmount)"></span> đ</p>
                                            <p class="text-[11px] text-slate-500">Còn <span x-text="formatMoney(p.totalAfter)"></span> đ</p>
                                        </button>
                                    </template>
                                </div>
                            </div>
                            <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5">
                                <p class="mb-3 text-[10px] font-black uppercase tracking-wider text-slate-500">Hoặc nhập mã khuyến mãi</p>
                                <div class="flex flex-col gap-2 sm:flex-row">
                                    <input type="text" x-model.trim="manualPromoCode" placeholder="VD: DONVI10" @@keydown.enter.prevent="applyManualCode()"
                                           class="h-11 flex-1 rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold uppercase focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-200" />
                                    <button type="button" @@click="applyManualCode()" :disabled="promoApplying"
                                            class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 text-sm font-black text-white hover:bg-violet-700 disabled:opacity-50">Áp dụng mã</button>
                                </div>
                                <p x-show="promoPreviewMessage" class="mt-2 text-xs font-medium" :class="promoPreviewApplied ? 'text-emerald-700' : 'text-red-600'" x-text="promoPreviewMessage"></p>
                            </div>
                            <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-slate-300">
                                <input type="radio" name="promoChoice" :checked="!promotionCode" @@change="clearPromotion()" class="h-4 w-4 border-slate-300 text-slate-600 focus:ring-slate-400" />
                                <span class="text-sm font-bold text-slate-700">Không sử dụng khuyến mãi</span>
                            </label>
                            <div x-show="formError" class="flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                                <i data-lucide="circle-alert" class="h-4 w-4 shrink-0"></i><span x-text="formError"></span>
                            </div>
                        </div>
                    </div>
                    <aside class="lg:sticky lg:top-28 lg:self-start">
                        <div class="overflow-hidden rounded-3xl border border-violet-200/80 bg-white shadow-xl ring-1 ring-violet-500/10">
                            <div class="bg-gradient-to-br from-violet-600 to-purple-700 px-6 py-5 text-white">
                                <p class="text-[10px] font-black uppercase tracking-wider text-violet-200">Tổng thanh toán</p>
                                <p class="mt-1 text-3xl font-black"><span x-text="formatMoney(promoTotalAfter())"></span><span class="text-lg font-bold opacity-80"> đ</span></p>
                            </div>
                            <div class="space-y-3 p-6 text-sm">
                                <div class="flex justify-between"><span class="text-slate-500">Tạm tính</span><span class="font-black text-slate-900"><span x-text="formatMoney(promoSubtotal())"></span> đ</span></div>
                                <div x-show="promoDiscount() > 0" class="flex justify-between"><span class="text-slate-500">Giảm giá</span><span class="font-black text-emerald-700">−<span x-text="formatMoney(promoDiscount())"></span> đ</span></div>
                                <div class="flex justify-between border-t border-slate-100 pt-3" x-show="selectedPromotionName"><span class="text-slate-500">Mã áp dụng</span><span class="max-w-[160px] truncate text-right font-bold text-violet-700" x-text="selectedPromotionName"></span></div>
                                <div class="flex flex-col gap-2 pt-3">
                                    <button type="button" @@click="step = 2" class="rounded-xl border border-slate-200 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-50">Quay lại thực đơn</button>
                                    <button type="button" @@click="goStep4()" class="flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-violet-600 to-purple-600 py-3.5 text-sm font-black text-white shadow-lg transition hover:from-violet-700 hover:to-purple-700">
                                        <i data-lucide="arrow-right" class="h-4 w-4"></i>
                                        Tiếp tục — giao hàng
                                    </button>
                                </div>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>

            <!-- Step 4: Delivery -->
            <div x-show="step === 4" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
                <div class="grid gap-8 lg:grid-cols-[1fr_340px]">
                    <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-emerald-50 via-white to-orange-50/40 px-6 py-5 sm:px-8">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-600">Bước 4</p>
                            <h2 class="mt-1 text-xl font-black text-slate-900 sm:text-2xl">Địa điểm giao &amp; người nhận</h2>
                            <p class="mt-1 text-sm text-slate-500">Email xác nhận đơn và PDF hợp đồng sẽ được gửi tới địa chỉ email bạn nhập bên dưới.</p>
                        </div>
                        <div class="grid gap-5 p-6 sm:grid-cols-2 sm:p-8">
                            <div x-show="deliveryPrefilled" class="sm:col-span-2 flex flex-col gap-3 rounded-2xl border border-emerald-200/80 bg-emerald-50/70 px-4 py-3.5 sm:flex-row sm:items-center sm:justify-between">
                                <div class="flex items-start gap-3 min-w-0">
                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
                                        <i data-lucide="user-check" class="h-4 w-4"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-bold text-emerald-900">Thông tin đã điền sẵn</p>
                                        <p class="mt-0.5 text-xs leading-relaxed text-emerald-800/90" x-text="deliveryDefaultsHint"></p>
                                    </div>
                                </div>
                                <button type="button" @@click="applyDeliveryDefaults(deliveryDefaults, true)"
                                        class="shrink-0 rounded-xl border border-emerald-300 bg-white px-3.5 py-2 text-xs font-bold text-emerald-800 transition hover:bg-emerald-50">
                                    Khôi phục mặc định
                                </button>
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Họ tên người nhận *</label>
                                <input type="text" x-model.trim="delivery.recipientName" autocomplete="name" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" placeholder="Nguyễn Văn A" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Số điện thoại *</label>
                                <input type="tel" x-model.trim="delivery.recipientPhone" autocomplete="tel" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" placeholder="0901234567" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Email nhận thông báo *</label>
                                <input type="email" x-model.trim="delivery.recipientEmail" autocomplete="email" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" placeholder="email@donvi.edu.vn" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Địa chỉ giao hàng *</label>
                                <input type="text" x-model.trim="delivery.deliveryAddress" autocomplete="street-address" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" placeholder="Số nhà, đường, tòa nhà..." />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Phường / quận / thành phố</label>
                                <input type="text" x-model.trim="delivery.deliveryWardDistrict"
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" placeholder="Phường ..., Quận ..., TP.HCM" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Giờ giao mong muốn</label>
                                <input type="time" x-model="delivery.preferredDeliveryTime"
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-bold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Ghi chú giao hàng</label>
                                <input type="text" x-model.trim="delivery.deliveryNotes"
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" placeholder="Cổng sau, liên hệ bảo vệ..." />
                            </div>
                            <div x-show="formError" class="sm:col-span-2 flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                                <i data-lucide="circle-alert" class="h-4 w-4 shrink-0"></i><span x-text="formError"></span>
                            </div>
                        </div>
                    </div>
                    <aside class="lg:sticky lg:top-28 lg:self-start">
                        <div class="overflow-hidden rounded-3xl border border-emerald-200/80 bg-white shadow-xl ring-1 ring-emerald-500/10">
                            <div class="bg-gradient-to-br from-emerald-600 to-teal-600 px-6 py-5 text-white">
                                <p class="text-[10px] font-black uppercase tracking-wider text-emerald-100">Sẵn sàng xác nhận</p>
                                <p class="mt-1 text-2xl font-black"><span x-text="formatMoney(promoTotalAfter())"></span><span class="text-base font-bold opacity-80"> đ</span></p>
                            </div>
                            <div class="space-y-3 p-6 text-sm">
                                <p class="text-xs text-slate-500">Sau khi gửi, hệ thống tạo nháp hợp đồng và gửi email kèm PDF tới <strong class="text-slate-800" x-text="delivery.recipientEmail || '—'"></strong>.</p>
                                <div class="flex flex-col gap-2 pt-2">
                                    <button type="button" @@click="step = 3" class="rounded-xl border border-slate-200 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-50">Quay lại khuyến mãi</button>
                                    <button type="button" @@click="submitDraft()" :disabled="submitting" class="flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 py-3.5 text-sm font-black text-white shadow-lg transition hover:from-orange-600 hover:to-amber-600 disabled:opacity-50">
                                        <i data-lucide="file-check" class="h-4 w-4" x-show="!submitting"></i>
                                        <span x-show="!submitting">Xem nháp hợp đồng</span><span x-show="submitting">Đang xử lý…</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        }
    </section>

    <!-- Dish picker drawer -->
    <div x-show="pickerOpen" x-cloak class="fixed inset-0 z-[100]"
         @@keydown.escape.window="closePicker()">
        <div class="absolute inset-0 bg-slate-900/55 backdrop-blur-[2px] transition-opacity"
             @@click="closePicker()" x-show="pickerOpen" x-transition.opacity></div>
        <aside class="org-picker-drawer-panel absolute right-0 top-0 flex h-full w-full max-w-full flex-col bg-slate-50 sm:max-w-xl lg:max-w-3xl xl:max-w-4xl"
               x-show="pickerOpen"
               @@click.stop
               x-transition:enter="transform transition ease-out duration-300"
               x-transition:enter-start="translate-x-full"
               x-transition:enter-end="translate-x-0"
               x-transition:leave="transform transition ease-in duration-200"
               x-transition:leave-start="translate-x-0"
               x-transition:leave-end="translate-x-full">
            <header class="shrink-0 border-b border-slate-200/80 bg-white px-4 py-4 sm:px-6">
                <div class="flex items-start gap-3">
                    <div class="min-w-0 flex-1">
                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-orange-600">Thư viện món</p>
                        <h3 class="mt-0.5 text-lg font-black leading-tight text-slate-900 sm:text-xl" x-text="pickerSlotLabel()"></h3>
                        <p class="mt-1 text-xs text-slate-500">Chọn món trong danh sách, xem chi tiết bên dưới rồi xác nhận thêm vào ngày.</p>
                    </div>
                    <button type="button" @@click="closePicker()"
                            class="shrink-0 rounded-xl border border-slate-200 bg-white p-2.5 text-slate-500 shadow-sm transition hover:border-slate-300 hover:text-slate-800">
                        <i data-lucide="x" class="h-5 w-5"></i>
                    </button>
                </div>
                <div class="mt-4 flex flex-wrap items-center gap-2">
                    <button type="button"
                            @@click="pickerSource = 'catalog'; pickerSelectedId = null; pickerPreview = null; pickerDetail = null; const cats = categoriesForPicker(); if (cats.length) loadDishes(cats[0].id);"
                            class="rounded-full px-4 py-2 text-xs font-bold transition"
                            :class="pickerSource === 'catalog' ? 'bg-slate-900 text-white shadow-md' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50'">
                        Danh mục
                    </button>
                    <button type="button"
                            @@click="pickerSource = 'cart'; pickerSelectedId = null; pickerPreview = null; pickerDetail = null;"
                            class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-xs font-bold transition"
                            :class="pickerSource === 'cart' ? 'bg-orange-500 text-white shadow-md shadow-orange-500/30' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50'">
                        <i data-lucide="shopping-cart" class="h-3.5 w-3.5"></i>
                        Từ giỏ hàng
                        <span x-show="cartLinesForPicker().length > 0"
                              class="rounded-full bg-white/25 px-1.5 py-0.5 text-[10px]" x-text="cartLinesForPicker().length"></span>
                    </button>
                    <div class="relative ml-auto min-w-[10rem] flex-1 sm:max-w-xs">
                        <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
                        <input type="search" x-model="pickerSearch" placeholder="Tìm tên món…"
                               class="w-full rounded-full border-0 bg-white py-2 pl-9 pr-3 text-sm shadow-sm ring-1 ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-orange-400" />
                    </div>
                </div>
                <div x-show="pickerSource === 'catalog'" class="mt-3 flex gap-2 overflow-x-auto pb-0.5 no-scrollbar">
                    <template x-for="cat in categoriesForPicker()" :key="cat.id">
                        <button type="button" @@click="loadDishes(cat.id); pickerSelectedId = null; pickerPreview = null; pickerDetail = null;"
                                class="shrink-0 rounded-full border px-3.5 py-1.5 text-xs font-bold transition"
                                :class="pickerCategoryId === cat.id
                                    ? 'border-orange-500 bg-orange-500 text-white shadow-sm'
                                    : 'border-slate-200 bg-white text-slate-600 hover:border-orange-300'">
                            <span x-text="cat.name"></span>
                        </button>
                    </template>
                </div>
            </header>

            <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
                <section class="flex min-h-0 flex-1 flex-col border-slate-200/80 lg:border-r lg:max-w-md xl:max-w-lg">
                    <div class="shrink-0 border-b border-slate-200/60 bg-white/80 px-4 py-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500 sm:px-5">
                        <span x-show="pickerSource === 'catalog'">Danh sách món</span>
                        <span x-show="pickerSource === 'cart'">Món trong giỏ (cùng nhóm)</span>
                    </div>
                    <div class="min-h-0 flex-1 overflow-y-auto px-3 py-3 sm:px-4">
                        <template x-if="pickerSource === 'catalog'">
                            <div>
                                <div x-show="dishesLoading" class="flex flex-col items-center py-20 text-slate-500">
                                    <div class="mb-3 h-9 w-9 animate-spin rounded-full border-2 border-orange-200 border-t-orange-500"></div>
                                    <p class="text-sm font-medium">Đang tải món…</p>
                                </div>
                                <div x-show="!dishesLoading && filteredPickerDishes().length === 0" class="py-16 text-center">
                                    <i data-lucide="utensils-crossed" class="mx-auto mb-2 h-9 w-9 text-slate-300"></i>
                                    <p class="text-sm text-slate-500">Không có món phù hợp.</p>
                                </div>
                                <ul class="space-y-2" x-show="!dishesLoading">
                                    <template x-for="d in filteredPickerDishes()" :key="d.id">
                                        <li>
                                            <button type="button" @@click="selectPickerDish(d)"
                                                    class="org-picker-dish-row flex w-full items-center gap-3 rounded-2xl border border-slate-200/90 bg-white p-2.5 text-left shadow-sm transition hover:border-orange-200"
                                                    :class="pickerSelectedId === d.id ? 'is-selected' : ''">
                                                <div class="relative h-[4.25rem] w-[4.25rem] shrink-0 overflow-hidden rounded-xl bg-gradient-to-br from-orange-50 to-amber-50 ring-1 ring-slate-100/90">
                                                    <img x-show="dishThumbSrc(d) && !dishThumbFailed(d)"
                                                         :src="dishThumbSrc(d)"
                                                         :alt="d.name"
                                                         loading="lazy"
                                                         decoding="async"
                                                         @@error="onDishThumbError(d)"
                                                         class="absolute inset-0 h-full w-full object-cover" />
                                                    <div x-show="!dishThumbSrc(d) || dishThumbFailed(d)"
                                                         class="absolute inset-0 flex items-center justify-center text-orange-500">
                                                        <i data-lucide="utensils" class="h-5 w-5"></i>
                                                    </div>
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <p class="line-clamp-2 text-sm font-bold text-slate-900" x-text="d.name"></p>
                                                    <p class="mt-0.5 text-[11px] text-slate-500">Xem chi tiết &amp; chọn</p>
                                                </div>
                                                <i data-lucide="chevron-right" class="h-4 w-4 shrink-0 text-slate-300"
                                                   :class="pickerSelectedId === d.id ? 'text-orange-500' : ''"></i>
                                            </button>
                                        </li>
                                    </template>
                                </ul>
                            </div>
                        </template>
                        <template x-if="pickerSource === 'cart'">
                            <div>
                                <div x-show="filteredCartLines().length === 0" class="py-16 text-center">
                                    <i data-lucide="shopping-cart" class="mx-auto mb-2 h-9 w-9 text-slate-300"></i>
                                    <p class="text-sm font-semibold text-slate-600">Giỏ hàng chưa có món phù hợp nhóm này</p>
                                    <a href="/Menu/Gallery" class="mt-2 inline-flex text-xs font-bold text-orange-600 hover:underline">Thêm món từ thư viện</a>
                                </div>
                                <ul class="space-y-2">
                                    <template x-for="line in filteredCartLines()" :key="'cart-' + line.dishId">
                                        <li>
                                            <button type="button" @@click="selectPickerCart(line)"
                                                    class="org-picker-dish-row flex w-full items-center gap-3 rounded-2xl border border-orange-100 bg-white p-2.5 text-left shadow-sm transition hover:border-orange-300"
                                                    :class="pickerSelectedId === line.dishId ? 'is-selected' : ''">
                                                <div class="relative h-[4.25rem] w-[4.25rem] shrink-0 overflow-hidden rounded-xl bg-gradient-to-br from-orange-100 to-amber-50 ring-1 ring-orange-100">
                                                    <img x-show="dishThumbSrc(line) && !dishThumbFailed(line)"
                                                         :src="dishThumbSrc(line)"
                                                         :alt="line.name"
                                                         loading="lazy"
                                                         decoding="async"
                                                         @@error="onDishThumbError(line)"
                                                         class="absolute inset-0 h-full w-full object-cover" />
                                                    <div x-show="!dishThumbSrc(line) || dishThumbFailed(line)"
                                                         class="absolute inset-0 flex items-center justify-center bg-orange-500 text-white">
                                                        <i data-lucide="utensils" class="h-5 w-5"></i>
                                                    </div>
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <p class="line-clamp-2 text-sm font-bold text-slate-900" x-text="line.name"></p>
                                                    <p class="mt-0.5 text-[10px] font-bold uppercase text-orange-700" x-text="line.categoryLabel"></p>
                                                    <p class="text-[11px] text-slate-500">Giỏ: <span x-text="line.quantity"></span> suất</p>
                                                </div>
                                                <i data-lucide="chevron-right" class="h-4 w-4 shrink-0"
                                                   :class="pickerSelectedId === line.dishId ? 'text-orange-500' : 'text-slate-300'"></i>
                                            </button>
                                        </li>
                                    </template>
                                </ul>
                            </div>
                        </template>
                    </div>
                </section>

                <section class="flex min-h-0 flex-1 flex-col bg-white">
                    <div class="shrink-0 border-b border-slate-100 px-4 py-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500 sm:px-6">
                        Chi tiết món
                    </div>
                    <div class="min-h-0 flex-1 overflow-y-auto">
                        <div x-show="!pickerPreview" class="flex h-full min-h-[12rem] flex-col items-center justify-center px-6 py-16 text-center lg:min-h-0">
                            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-orange-50 text-orange-500">
                                <i data-lucide="mouse-pointer-click" class="h-8 w-8"></i>
                            </div>
                            <p class="text-sm font-bold text-slate-700">Chọn một món ở danh sách bên trái</p>
                            <p class="mt-1 max-w-xs text-xs text-slate-500">Mô tả, dinh dưỡng và định mức nguyên liệu sẽ hiển thị tại đây trước khi bạn thêm vào thực đơn.</p>
                        </div>

                        <div x-show="pickerPreview" class="p-4 sm:p-6">
                            <div x-show="pickerDetailLoading" class="flex flex-col items-center py-16">
                                <div class="mb-3 h-9 w-9 animate-spin rounded-full border-2 border-orange-200 border-t-orange-500"></div>
                                <p class="text-sm text-slate-500">Đang tải chi tiết…</p>
                            </div>

                            <div x-show="pickerPreview && !pickerDetailLoading && !pickerDetail" class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-6 text-center">
                                <p class="text-sm font-semibold text-slate-600" x-text="pickerPreview.name"></p>
                                <p class="mt-2 text-xs text-slate-500">Không tải được mô tả chi tiết. Bạn vẫn có thể thêm món vào thực đơn.</p>
                            </div>

                            <template x-if="pickerPreview && !pickerDetailLoading && pickerDetail">
                                <div class="space-y-5">
                                    <div class="flex flex-col gap-4 sm:flex-row">
                                        <div class="shrink-0 sm:w-44 lg:w-52">
                                            <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-slate-100 ring-1 ring-slate-200/80">
                                                <template x-if="pickerDetailImage()">
                                                    <img :src="pickerDetailImage()" :alt="pickerPreview.name"
                                                         class="h-full w-full object-cover" />
                                                </template>
                                                <template x-if="!pickerDetailImage()">
                                                    <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-orange-100 to-amber-50 text-orange-500">
                                                        <i data-lucide="utensils" class="h-12 w-12"></i>
                                                    </div>
                                                </template>
                                            </div>
                                            <p class="mt-2 text-[10px] leading-snug text-amber-800/90">
                                                @MenuDishDisplayHelper.ServingNotice.ImageCaption
                                            </p>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <h4 class="text-xl font-black leading-snug text-slate-900" x-text="pickerPreview.name"></h4>
                                            <p x-show="pickerDetail.dish?.cookingMethod"
                                               class="mt-1 inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-bold text-slate-600"
                                               x-text="pickerDetail.dish.cookingMethod"></p>
                                            <p x-show="pickerDetail.dish?.dietaryLabel"
                                               class="mt-1 ml-1 inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700"
                                               x-text="pickerDetail.dish.dietaryLabel"></p>
                                            <p x-show="pickerDetail.dish?.description && pickerDetail.dish.description !== pickerPreview.name"
                                               class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-4"
                                               x-text="pickerDetail.dish.description"></p>
                                            <div x-show="pickerHasNutrition()" class="mt-4 grid grid-cols-4 gap-2">
                                                <div class="rounded-xl bg-slate-50 px-2 py-2 text-center ring-1 ring-slate-100">
                                                    <p class="text-[10px] font-bold uppercase text-slate-400">Calo</p>
                                                    <p class="text-sm font-black text-slate-800" x-text="pickerNutrition('calories')"></p>
                                                </div>
                                                <div class="rounded-xl bg-slate-50 px-2 py-2 text-center ring-1 ring-slate-100">
                                                    <p class="text-[10px] font-bold uppercase text-slate-400">Đạm</p>
                                                    <p class="text-sm font-black text-slate-800" x-text="pickerNutrition('protein')"></p>
                                                </div>
                                                <div class="rounded-xl bg-slate-50 px-2 py-2 text-center ring-1 ring-slate-100">
                                                    <p class="text-[10px] font-bold uppercase text-slate-400">Béo</p>
                                                    <p class="text-sm font-black text-slate-800" x-text="pickerNutrition('fat')"></p>
                                                </div>
                                                <div class="rounded-xl bg-slate-50 px-2 py-2 text-center ring-1 ring-slate-100">
                                                    <p class="text-[10px] font-bold uppercase text-slate-400">Đường</p>
                                                    <p class="text-sm font-black text-slate-800" x-text="pickerNutrition('carbs')"></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div x-show="pickerDetail.ingredientQuotas && pickerDetail.ingredientQuotas.length > 0"
                                         class="rounded-2xl border border-slate-100 bg-slate-50/80 p-4">
                                        <p class="text-xs font-black uppercase tracking-wide text-slate-500">Định mức tham chiếu (01 suất)</p>
                                        <ul class="mt-2 max-h-36 space-y-1 overflow-y-auto text-sm text-slate-700">
                                            <template x-for="(q, idx) in pickerDetail.ingredientQuotas.slice(0, 12)" :key="idx">
                                                <li class="flex justify-between gap-2 border-b border-slate-100/80 py-1 last:border-0">
                                                    <span class="truncate font-medium" x-text="q.ingredientName"></span>
                                                    <span class="shrink-0 text-slate-500" x-text="formatPickerQuota(q)"></span>
                                                </li>
                                            </template>
                                        </ul>
                                        <p x-show="pickerDetail.ingredientQuotas.length > 12" class="mt-1 text-[11px] text-slate-400">
                                            + <span x-text="pickerDetail.ingredientQuotas.length - 12"></span> nguyên liệu khác
                                        </p>
                                        <p class="mt-3 text-[11px] leading-relaxed text-amber-900/85 border-t border-amber-100/80 pt-3">
                                            @MenuDishDisplayHelper.ServingNotice.DetailFooterNote
                                        </p>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>

                    <footer x-show="pickerPreview"
                            class="shrink-0 border-t border-slate-200 bg-gradient-to-r from-white to-orange-50/30 px-4 py-4 sm:px-6">
                        <div class="flex flex-wrap items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-bold uppercase tracking-wide text-slate-500">Số suất thêm</span>
                                <div class="inline-flex items-center rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
                                    <button type="button" @@click="pickerPickQty = Math.max(1, pickerPickQty - 1)"
                                            class="rounded-l-xl px-3 py-2 text-slate-600 hover:bg-slate-50">
                                        <i data-lucide="minus" class="h-4 w-4"></i>
                                    </button>
                                    <span class="min-w-[2.5rem] text-center text-sm font-black text-slate-900" x-text="pickerPickQty"></span>
                                    <button type="button" @@click="pickerPickQty++"
                                            class="rounded-r-xl px-3 py-2 text-slate-600 hover:bg-slate-50">
                                        <i data-lucide="plus" class="h-4 w-4"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="button" @@click="confirmPickDish()"
                                    :disabled="pickerDetailLoading"
                                    class="inline-flex flex-1 items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 px-6 py-3.5 text-sm font-black text-white shadow-lg transition hover:from-orange-600 hover:to-amber-600 disabled:opacity-50 sm:flex-none sm:min-w-[12rem]">
                                <i data-lucide="check-circle-2" class="h-4 w-4"></i>
                                Chọn món này
                            </button>
                        </div>
                    </footer>
                </section>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('alpine:init', () => {
        const categories = @Html.Raw(categoriesJson);
        const orgId = @orgIdJson;
        const dateMin = @Json.Serialize(dateMin);
        const dateMax = @Json.Serialize(dateMax);
        const dateDefault = @Json.Serialize(dateDefault);
        const antiToken = @Html.Raw(antiTokenJson);
        const deliveryDefaults = @Html.Raw(deliveryDefaultsJson);
        const DRAFT_CACHE_TTL_MS = 5 * 60 * 1000;
        const draftCacheKey = 'hm_org_meal_draft_v1_' + orgId;

        Alpine.data('orgMealOrderApp', () => ({
            step: 1,
            pricePerPortion: 25000,
            pricePerPortionOptions: [25000, 30000, 45000, 60000],
            promotionCode: '',
            newDate: dateDefault,
            dateMin, dateMax,
            mealDays: [],
            activeDay: null,
            formError: '',
            submitting: false,
            pickerOpen: false,
            pickerDay: null,
            pickerSlot: 'main',
            pickerCategoryId: null,
            pickerDishes: [],
            dishesLoading: false,
            pickerSelectedId: null,
            pickerPreview: null,
            pickerDetail: null,
            pickerDetailLoading: false,
            pickerPickQty: 1,
            pickerSearch: '',
            dishImageCache: {},
            stepMeta: [
                { key: 'setup', label: 'Thiết lập', hint: 'Giá & ngày giao' },
                { key: 'menu', label: 'Thực đơn', hint: 'Chọn món từng ngày' },
                { key: 'promo', label: 'Khuyến mãi', hint: 'Chọn mã giảm giá' },
                { key: 'delivery', label: 'Giao hàng', hint: 'Người nhận & địa chỉ' },
            ],
            delivery: {
                recipientName: '',
                recipientPhone: '',
                recipientEmail: '',
                deliveryAddress: '',
                deliveryWardDistrict: '',
                deliveryNotes: '',
                preferredDeliveryTime: '11:30',
            },
            deliveryPrefilled: false,
            deliveryDefaultsHint: '',
            eligiblePromotions: [],
            selectedPromotionId: null,
            selectedPromotionName: '',
            promoDiscountAmount: 0,
            promoSubtotalAmount: 0,
            promoListMessage: '',
            promoLoading: false,
            promoApplying: false,
            manualPromoCode: '',
            promoPreviewMessage: '',
            promoPreviewApplied: false,
            draftCacheNotice: '',
            cartImportLines: @Html.Raw(cartImportJson),
            fromCart: @(fromCart ? "true" : "false"),
            cartImportNotice: '',
            pickerSource: 'catalog',
            _cacheSaveTimer: null,
            slots: [
                { key: 'main', label: 'Món chính', icon: 'beef', desc: 'Tính suất & thành tiền' },
                { key: 'side', label: 'Món phụ', icon: 'salad', desc: 'Tổng suất phải bằng món chính (1 suất ăn)' },
                { key: 'soup', label: 'Canh', icon: 'soup', desc: 'Tổng suất phải bằng món chính (1 suất ăn)' },
            ],

            formatDate(iso) {
                if (!iso) return '';
                const p = iso.split('-');
                return p[2] + '/' + p[1] + '/' + p[0];
            },
            formatMoney(n) {
                return new Intl.NumberFormat('vi-VN').format(Math.round(n || 0));
            },
            normalizePricePerPortion(value) {
                const n = parseInt(value, 10);
                return this.pricePerPortionOptions.includes(n) ? n : this.pricePerPortionOptions[0];
            },
            cacheStorageKey() {
                return draftCacheKey;
            },
            hasMeaningfulDraft() {
                return this.mealDays.length > 0 || this.step > 1
                    || (this.pricePerPortion && this.pricePerPortion !== this.pricePerPortionOptions[0]);
            },
            scheduleDraftCacheSave() {
                if (!this.hasMeaningfulDraft()) return;
                clearTimeout(this._cacheSaveTimer);
                this._cacheSaveTimer = setTimeout(() => this.saveDraftCache(), 350);
            },
            saveDraftCache() {
                if (!this.hasMeaningfulDraft()) return;
                try {
                    const payload = {
                        savedAt: Date.now(),
                        organizationId: orgId,
                        step: this.step,
                        pricePerPortion: this.pricePerPortion,
                        newDate: this.newDate,
                        mealDays: this.mealDays,
                        activeDay: this.activeDay,
                        promotionCode: this.promotionCode,
                        selectedPromotionId: this.selectedPromotionId,
                        selectedPromotionName: this.selectedPromotionName,
                        promoDiscountAmount: this.promoDiscountAmount,
                        promoSubtotalAmount: this.promoSubtotalAmount,
                        manualPromoCode: this.manualPromoCode,
                        delivery: this.delivery,
                    };
                    localStorage.setItem(this.cacheStorageKey(), JSON.stringify(payload));
                } catch (e) {
                    /* localStorage đầy hoặc private mode */
                }
            },
            restoreDraftCache() {
                try {
                    const raw = localStorage.getItem(this.cacheStorageKey());
                    if (!raw) return false;
                    const data = JSON.parse(raw);
                    if (!data || String(data.organizationId) !== String(orgId)) return false;
                    const age = Date.now() - (data.savedAt || 0);
                    if (age > DRAFT_CACHE_TTL_MS) {
                        localStorage.removeItem(this.cacheStorageKey());
                        return false;
                    }
                    if (!data.mealDays?.length && (data.step || 1) === 1) return false;

                    this.step = Math.min(4, Math.max(1, parseInt(data.step, 10) || 1));
                    this.pricePerPortion = this.normalizePricePerPortion(data.pricePerPortion);
                    this.newDate = data.newDate || this.newDate;
                    this.mealDays = Array.isArray(data.mealDays) ? data.mealDays : [];
                    this.activeDay = data.activeDay || this.mealDays[0]?.serviceDate || null;
                    this.promotionCode = data.promotionCode || '';
                    this.selectedPromotionId = data.selectedPromotionId ?? null;
                    this.selectedPromotionName = data.selectedPromotionName || '';
                    this.promoDiscountAmount = data.promoDiscountAmount || 0;
                    this.promoSubtotalAmount = data.promoSubtotalAmount || 0;
                    this.manualPromoCode = data.manualPromoCode || '';
                    if (data.delivery) {
                        this.mergeDeliveryFromCache(data.delivery);
                    }

                    const saved = new Date(data.savedAt);
                    const mins = Math.max(1, Math.round((DRAFT_CACHE_TTL_MS - age) / 60000));
                    this.draftCacheNotice =
                        'Đã khôi phục bản nháp đặt suất (lưu lúc '
                        + saved.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                        + '). Bản nháp còn hiệu lực khoảng ' + mins + ' phút.';
                    return true;
                } catch {
                    return false;
                }
            },
            mergeDeliveryFromCache(cached) {
                if (!cached) return;
                const d = this.delivery;
                const keys = ['recipientName', 'recipientPhone', 'recipientEmail', 'deliveryAddress', 'deliveryWardDistrict', 'deliveryNotes'];
                for (const key of keys) {
                    const v = cached[key];
                    if (v != null && String(v).trim()) d[key] = String(v).trim();
                }
                if (cached.preferredDeliveryTime && String(cached.preferredDeliveryTime).trim())
                    d.preferredDeliveryTime = String(cached.preferredDeliveryTime).trim();
            },
            applyDeliveryDefaults(defaults, force = false) {
                if (!defaults) return;
                const d = this.delivery;
                const fill = (key, val) => {
                    if (val == null || !String(val).trim()) return;
                    if (force || !d[key] || !String(d[key]).trim())
                        d[key] = String(val).trim();
                };
                fill('recipientName', defaults.recipientName);
                fill('recipientPhone', defaults.recipientPhone);
                fill('recipientEmail', defaults.recipientEmail);
                fill('deliveryAddress', defaults.deliveryAddress);
                fill('deliveryWardDistrict', defaults.deliveryWardDistrict);
                fill('deliveryNotes', defaults.deliveryNotes);
                if (defaults.preferredDeliveryTime && (force || !d.preferredDeliveryTime))
                    d.preferredDeliveryTime = defaults.preferredDeliveryTime;
                this.deliveryDefaultsHint = defaults.sourceHint || '';
                this.deliveryPrefilled = !!(
                    d.recipientName && d.recipientPhone && d.recipientEmail && d.deliveryAddress
                );
            },
            clearDraftCache(showNotice) {
                try { localStorage.removeItem(this.cacheStorageKey()); } catch { /* ignore */ }
                if (showNotice) {
                    this.draftCacheNotice = '';
                    this.step = 1;
                    this.mealDays = [];
                    this.activeDay = null;
                    this.formError = '';
                    this.clearPromotion(false);
                }
            },
            addDay() {
                this.formError = '';
                const d = this.newDate;
                if (!d) { this.formError = 'Chọn ngày phục vụ.'; return; }
                const dateErr = this.validateServiceDate(d);
                if (dateErr) { this.formError = dateErr; return; }
                if (this.mealDays.some(x => x.serviceDate === d)) {
                    this.formError = 'Ngày đã có trong danh sách.';
                    return;
                }
                this.mealDays.push({
                    serviceDate: d,
                    mealPlan: { main: [], side: [], soup: [] }
                });
                this.mealDays.sort((a, b) => a.serviceDate.localeCompare(b.serviceDate));
                this.activeDay = d;
                this.scheduleDraftCacheSave();
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            removeDay(iso) {
                this.mealDays = this.mealDays.filter(x => x.serviceDate !== iso);
                this.activeDay = this.mealDays[0]?.serviceDate || null;
                this.scheduleDraftCacheSave();
            },
            goStep2() {
                this.formError = '';
                if (!this.pricePerPortion || this.pricePerPortion <= 0) {
                    this.formError = 'Chọn giá thỏa thuận / suất hợp lệ.';
                    return;
                }
                if (this.mealDays.length === 0) {
                    this.formError = 'Thêm ít nhất một ngày phục vụ.';
                    return;
                }
                for (const day of this.mealDays) {
                    const dateErr = this.validateServiceDate(day.serviceDate);
                    if (dateErr) { this.formError = dateErr; return; }
                }
                this.activeDay = this.mealDays[0].serviceDate;
                this.step = 2;
                this.scheduleDraftCacheSave();
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            validateServiceDate(iso) {
                if (iso < this.dateMin || iso > this.dateMax) {
                    return 'Ngày nằm ngoài khoảng cho phép (' + this.formatDate(this.dateMin) + ' – ' + this.formatDate(this.dateMax) + ').';
                }
                return '';
            },
            daySlotTotal(dayOrIso, slot) {
                const d = this.resolveDay(dayOrIso);
                if (!d) return 0;
                return (d.mealPlan[slot] || []).reduce((s, l) => s + Math.max(1, parseInt(l.quantity, 10) || 1), 0);
            },
            daySlotBalanceUiClass(dayOrIso, slot) {
                const main = this.daySlotTotal(dayOrIso, 'main');
                if (main <= 0) return slot === 'side' ? 'border-violet-100 bg-violet-50/80' : 'border-slate-200 bg-slate-50';
                const t = this.daySlotTotal(dayOrIso, slot);
                if (t === main) return 'border-emerald-200 bg-emerald-50';
                if (t > main) return 'border-red-200 bg-red-50';
                return 'border-amber-200 bg-amber-50';
            },
            balanceSideSoupToMain(dayOrIso) {
                const day = this.resolveDay(dayOrIso);
                if (!day) return;
                const main = this.daySlotTotal(day, 'main');
                if (main <= 0) {
                    this.formError = 'Thêm món chính trước khi cân bằng món phụ/canh.';
                    return;
                }
                for (const slot of ['side', 'soup']) {
                    const lines = day.mealPlan[slot] || [];
                    if (lines.length === 0) continue;
                    const n = lines.length;
                    let remaining = main;
                    lines.forEach((line, idx) => {
                        const share = idx === n - 1
                            ? remaining
                            : Math.max(1, Math.floor(main / n));
                        line.quantity = share;
                        remaining -= share;
                    });
                    let total = this.daySlotTotal(day, slot);
                    while (total > main) {
                        const heavy = lines.reduce((a, b) => ((parseInt(a.quantity, 10) || 1) >= (parseInt(b.quantity, 10) || 1)) ? a : b);
                        if ((parseInt(heavy.quantity, 10) || 1) <= 1) break;
                        heavy.quantity = (parseInt(heavy.quantity, 10) || 1) - 1;
                        total = this.daySlotTotal(day, slot);
                    }
                    while (total < main) {
                        lines[0].quantity = (parseInt(lines[0].quantity, 10) || 1) + 1;
                        total++;
                    }
                }
                this.formError = '';
                this.scheduleDraftCacheSave();
            },
            validateDaySlotTotals(dayOrIso, requireMain) {
                const d = this.resolveDay(dayOrIso);
                if (!d) return '';
                const main = this.daySlotTotal(d, 'main');
                if (requireMain && main <= 0) {
                    return 'Ngày ' + this.formatDate(d.serviceDate) + ': cần ít nhất một món chính (suất > 0).';
                }
                if (main > 0) {
                    const side = this.daySlotTotal(d, 'side');
                    const soup = this.daySlotTotal(d, 'soup');
                    if (side !== main) {
                        return 'Ngày ' + this.formatDate(d.serviceDate) + ': tổng món phụ (' + side + ') phải bằng món chính (' + main + ' suất). Dùng nút "Cân bằng món phụ & canh".';
                    }
                    if (soup !== main) {
                        return 'Ngày ' + this.formatDate(d.serviceDate) + ': tổng canh (' + soup + ') phải bằng món chính (' + main + ' suất). Dùng nút "Cân bằng món phụ & canh".';
                    }
                }
                return '';
            },
            validateAllDaySlotTotals(requireMain) {
                for (const day of this.mealDays) {
                    const err = this.validateDaySlotTotals(day, requireMain);
                    if (err) return err;
                }
                return '';
            },
            canAddSideSoupQty(dayOrIso, slot, addQty) {
                if (slot === 'main') return true;
                const main = this.daySlotTotal(dayOrIso, 'main');
                if (main <= 0) return false;
                const current = this.daySlotTotal(dayOrIso, slot);
                return (current + addQty) < main;
            },
            getDay(iso) { return this.mealDays.find(x => x.serviceDate === iso); },
            resolveDay(dayOrIso) {
                if (dayOrIso && typeof dayOrIso === 'object') return dayOrIso;
                return this.getDay(dayOrIso);
            },
            getLines(day, slot) {
                const d = this.resolveDay(day);
                if (!d) return [];
                return d.mealPlan[slot] || [];
            },
            normalizeQty(line, dayOrIso, slot) {
                let q = parseInt(line.quantity, 10);
                if (isNaN(q) || q < 1) q = 1;
                if (slot !== 'main') {
                    const day = this.resolveDay(dayOrIso);
                    const main = this.daySlotTotal(day, 'main');
                    const others = this.daySlotTotal(day, slot) - Math.max(1, parseInt(line.quantity, 10) || 1);
                    const maxForLine = Math.max(0, main - others);
                    if (q > maxForLine) q = Math.max(1, maxForLine);
                    if (maxForLine < 1) q = 1;
                }
                line.quantity = q;
            },
            openPicker(serviceDate, slot) {
                this.pickerDay = serviceDate;
                this.pickerSlot = slot;
                this.pickerOpen = true;
                this.pickerSelectedId = null;
                this.pickerPreview = null;
                this.pickerDetail = null;
                this.pickerPickQty = 1;
                this.pickerSearch = '';
                const cartForSlot = this.cartLinesForPicker();
                this.pickerSource = cartForSlot.length > 0 ? 'cart' : 'catalog';
                const cats = this.categoriesForPicker();
                if (this.pickerSource === 'catalog' && cats.length) {
                    this.pickerCategoryId = cats[0].id;
                    this.loadDishes(cats[0].id);
                }
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            closePicker() {
                this.pickerOpen = false;
                this.pickerSelectedId = null;
                this.pickerPreview = null;
                this.pickerDetail = null;
                this.pickerDetailLoading = false;
                this.pickerSearch = '';
            },
            filteredPickerDishes() {
                const q = (this.pickerSearch || '').trim().toLowerCase();
                if (!q) return this.pickerDishes;
                return this.pickerDishes.filter(d => (d.name || '').toLowerCase().includes(q));
            },
            filteredCartLines() {
                const q = (this.pickerSearch || '').trim().toLowerCase();
                const lines = this.cartLinesForPicker();
                if (!q) return lines;
                return lines.filter(l =>
                    (l.name || '').toLowerCase().includes(q) ||
                    (l.categoryLabel || '').toLowerCase().includes(q));
            },
            dishThumbSrc(item) {
                const url = item?.imageUrl || (item?.dishId ? this.dishImageCache[item.dishId] : null);
                return url && String(url).trim() ? url : null;
            },
            lineThumbSrc(line) {
                return this.dishThumbSrc(line);
            },
            resolveDishImageUrl(d) {
                const url = d?.imageUrl || this.pickerPreview?.imageUrl || this.dishImageCache[d?.id];
                if (url && d?.id) this.dishImageCache[d.id] = url;
                return url || null;
            },
            applyImageToMealLines(dishId, imageUrl) {
                if (!imageUrl || !dishId) return;
                this.dishImageCache[dishId] = imageUrl;
                for (const day of this.mealDays) {
                    for (const slot of ['main', 'side', 'soup']) {
                        for (const line of day.mealPlan[slot] || []) {
                            if (line.dishId === dishId) {
                                line.imageUrl = imageUrl;
                                line._thumbFailed = false;
                            }
                        }
                    }
                }
            },
            async hydrateMealLineImages() {
                const missing = new Set();
                for (const day of this.mealDays) {
                    for (const slot of ['main', 'side', 'soup']) {
                        for (const line of day.mealPlan[slot] || []) {
                            if (line.dishId > 0 && !this.lineThumbSrc(line))
                                missing.add(line.dishId);
                        }
                    }
                }
                if (missing.size === 0) return;
                for (const id of missing) {
                    try {
                        const res = await fetch(`/OrganizationMealOrder/Dish/${id}`);
                        if (!res.ok) continue;
                        const data = await res.json();
                        const url = data.dish?.imageUrl || this.pickerDetailImageFromData(data);
                        if (url) this.applyImageToMealLines(id, url);
                    } catch { /* ignore */ }
                }
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            pickerDetailImageFromData(data) {
                const d = data?.dish;
                if (!d) return null;
                if (d.imageUrl) return d.imageUrl;
                const imgs = d.images;
                if (imgs && imgs.length > 0) {
                    const cover = imgs.find(i => (i.role || '').toLowerCase() === 'cover') || imgs[0];
                    return cover?.url || null;
                }
                return null;
            },
            dishThumbFailed(item) {
                return !!item?._thumbFailed;
            },
            onDishThumbError(item) {
                if (item) item._thumbFailed = true;
            },
            patchPickerDishImage(dishId, imageUrl) {
                if (!imageUrl) return;
                const row = this.pickerDishes.find(x => x.id === dishId);
                if (row) {
                    row.imageUrl = imageUrl;
                    row._thumbFailed = false;
                }
                const cartLine = (this.cartImportLines || []).find(x => x.dishId === dishId);
                if (cartLine) {
                    cartLine.imageUrl = imageUrl;
                    cartLine._thumbFailed = false;
                }
                this.applyImageToMealLines(dishId, imageUrl);
            },
            async selectPickerDish(d) {
                this.pickerSelectedId = d.id;
                this.pickerPreview = { id: d.id, name: d.name, imageUrl: d.imageUrl || null };
                this.pickerPickQty = 1;
                await this.loadPickerDetail(d.id);
            },
            async selectPickerCart(line) {
                const id = line.dishId;
                this.pickerSelectedId = id;
                this.pickerPreview = { id, name: line.name, imageUrl: line.imageUrl || null };
                this.pickerPickQty = Math.max(1, parseInt(line.quantity, 10) || 1);
                await this.loadPickerDetail(id);
            },
            async loadPickerDetail(id) {
                this.pickerDetailLoading = true;
                this.pickerDetail = null;
                try {
                    const res = await fetch(`/OrganizationMealOrder/Dish/${id}`);
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.message || 'Không tải được chi tiết món.');
                    this.pickerDetail = data;
                    if (data.dish?.name) this.pickerPreview.name = data.dish.name;
                    if (data.dish?.imageUrl) {
                        this.pickerPreview.imageUrl = data.dish.imageUrl;
                        this.patchPickerDishImage(id, data.dish.imageUrl);
                    }
                } catch (e) {
                    this.formError = e.message || 'Không tải được chi tiết món.';
                } finally {
                    this.pickerDetailLoading = false;
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                }
            },
            pickerDetailImage() {
                const d = this.pickerDetail?.dish;
                if (d?.imageUrl) return d.imageUrl;
                const imgs = d?.images;
                if (imgs && imgs.length > 0) {
                    const cover = imgs.find(i => (i.role || '').toLowerCase() === 'cover') || imgs[0];
                    return cover?.url || cover?.imageUrl || null;
                }
                return this.pickerPreview?.imageUrl || null;
            },
            pickerHasNutrition() {
                const d = this.pickerDetail?.dish;
                return d && (d.calories != null || d.protein != null || d.fat != null || d.carbs != null);
            },
            pickerNutrition(field) {
                const d = this.pickerDetail?.dish;
                if (!d) return '—';
                const v = d[field];
                if (v == null || v === '') return '—';
                const n = Number(v);
                return isNaN(n) ? String(v) : (Number.isInteger(n) ? n : n.toFixed(1));
            },
            formatPickerQuota(q) {
                const qty = Number(q.quantity);
                const unit = (q.unit || '').trim();
                if (isNaN(qty) || qty <= 0) return unit || '—';
                const text = qty >= 1 ? qty.toFixed(qty % 1 === 0 ? 0 : 2) : qty.toFixed(3);
                return unit ? text + ' ' + unit : text;
            },
            confirmPickDish() {
                if (!this.pickerPreview) return;
                this.pickDish(this.pickerPreview, this.pickerPickQty, true);
            },
            cartLinesForPicker() {
                const slot = (this.pickerSlot || '').toLowerCase();
                return (this.cartImportLines || []).filter(l =>
                    (l.slotKey || '').toLowerCase() === slot);
            },
            pickFromCart(line) {
                this.selectPickerCart(line);
            },
            mergeCartLineIntoDay(day, line) {
                const slot = (line.slotKey || '').toLowerCase();
                if (!['main', 'side', 'soup'].includes(slot)) return;
                const lines = day.mealPlan[slot];
                const addQty = Math.max(1, parseInt(line.quantity, 10) || 1);
                const existing = lines.find(x => x.dishId === line.dishId);
                if (existing) {
                    if (slot !== 'main' && !this.canAddSideSoupQty(day, slot, addQty)) return false;
                    existing.quantity += addQty;
                    if (!existing.imageUrl) {
                        const url = line.imageUrl || this.dishImageCache[line.dishId];
                        if (url) existing.imageUrl = url;
                    }
                } else {
                    if (slot !== 'main' && !this.canAddSideSoupQty(day, slot, addQty)) return false;
                    lines.push({
                        dishId: line.dishId,
                        dishName: line.name,
                        quantity: addQty,
                        imageUrl: line.imageUrl || this.dishImageCache[line.dishId] || null,
                        _thumbFailed: false,
                    });
                }
                return true;
            },
            applyCartToDay(iso, silent) {
                const day = this.getDay(iso);
                if (!day) {
                    if (!silent) this.formError = 'Chưa có ngày phục vụ. Thêm ngày ở bước 1.';
                    return;
                }
                const eligible = (this.cartImportLines || []).filter(l =>
                    ['main', 'side', 'soup'].includes((l.slotKey || '').toLowerCase()));
                if (eligible.length === 0) {
                    if (!silent) this.formError = 'Giỏ hàng không có món phù hợp (món chính / phụ / canh).';
                    return;
                }
                let merged = 0;
                for (const line of eligible) {
                    if (this.mergeCartLineIntoDay(day, line)) merged++;
                }
                this.balanceSideSoupToMain(day);
                if (!silent) {
                    this.formError = '';
                    this.cartImportNotice = 'Đã áp dụng ' + merged + ' món từ giỏ cho ngày ' + this.formatDate(day.serviceDate) + '.';
                }
                this.scheduleDraftCacheSave();
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            applyCartToAllDays() {
                if (this.mealDays.length === 0) {
                    this.formError = 'Thêm ít nhất một ngày phục vụ ở bước 1.';
                    return;
                }
                for (const day of this.mealDays) {
                    this.applyCartToDay(day.serviceDate, true);
                }
                this.formError = '';
                this.cartImportNotice = 'Đã áp dụng giỏ hàng cho ' + this.mealDays.length + ' ngày phục vụ.';
                this.scheduleDraftCacheSave();
            },
            goStep2FromCart() {
                if (this.mealDays.length === 0) {
                    this.formError = 'Thêm ít nhất một ngày phục vụ ở bước 1 trước.';
                    this.step = 1;
                    return;
                }
                this.activeDay = this.mealDays[0].serviceDate;
                this.step = 2;
                this.formError = '';
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            categoriesForPicker() {
                return categories.filter(c =>
                    (c.slotKey || '').toLowerCase() === this.pickerSlot.toLowerCase()
                ).sort((a, b) => a.sortOrder - b.sortOrder);
            },
            pickerSlotLabel() {
                const s = this.slots.find(x => x.key === this.pickerSlot);
                return (s?.label || this.pickerSlot) + ' · ' + this.formatDate(this.pickerDay);
            },
            async loadDishes(categoryId) {
                this.pickerCategoryId = categoryId;
                this.dishesLoading = true;
                this.pickerDishes = [];
                try {
                    const res = await fetch(`/OrganizationMealOrder/Dishes?categoryId=${categoryId}&pageSize=50`);
                    if (!res.ok) throw new Error((await res.json()).message || 'Lỗi tải món');
                    const data = await res.json();
                    this.pickerDishes = (data.dishes || []).map(d => ({ ...d, _thumbFailed: false }));
                } catch (e) {
                    this.formError = e.message || 'Không tải được danh sách món.';
                } finally {
                    this.dishesLoading = false;
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                }
            },
            pickDish(d, qty = 1, closeAfter = true) {
                const day = this.getDay(this.pickerDay);
                if (!day) return;
                const slot = this.pickerSlot;
                const addQty = Math.max(1, parseInt(qty, 10) || 1);
                if (slot !== 'main' && !this.canAddSideSoupQty(day, slot, addQty)) {
                    this.formError = 'Ngày ' + this.formatDate(day.serviceDate)
                        + ': tổng ' + (slot === 'side' ? 'món phụ' : 'canh')
                        + ' đã đạt ' + this.daySlotTotal(day, 'main') + ' suất. Chỉnh số lượng hoặc bỏ bớt món.';
                    return;
                }
                const lines = day.mealPlan[slot];
                const existing = lines.find(x => x.dishId === d.id);
                if (existing) {
                    if (slot !== 'main' && !this.canAddSideSoupQty(day, slot, addQty)) {
                        this.formError = 'Đã đạt giới hạn suất ' + (slot === 'side' ? 'món phụ' : 'canh') + ' cho ngày này.';
                        return;
                    }
                    existing.quantity += addQty;
                    if (!existing.imageUrl) {
                        const url = this.resolveDishImageUrl(d);
                        if (url) existing.imageUrl = url;
                    }
                } else {
                    const imageUrl = this.resolveDishImageUrl(d);
                    lines.push({
                        dishId: d.id,
                        dishName: d.name,
                        quantity: addQty,
                        imageUrl,
                        _thumbFailed: false,
                    });
                }
                if (closeAfter) this.closePicker();
                this.formError = '';
                this.scheduleDraftCacheSave();
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            changeQty(dayOrIso, slot, dishId, delta) {
                const day = this.resolveDay(dayOrIso);
                const line = day?.mealPlan[slot]?.find(x => x.dishId === dishId);
                if (!line) return;
                const next = Math.max(1, (parseInt(line.quantity, 10) || 1) + delta);
                if (slot !== 'main') {
                    const main = this.daySlotTotal(day, 'main');
                    const others = this.daySlotTotal(day, slot) - (parseInt(line.quantity, 10) || 1);
                    if (next + others > main) {
                        this.formError = 'Ngày ' + this.formatDate(day.serviceDate)
                            + ': tổng ' + (slot === 'side' ? 'món phụ' : 'canh')
                            + ' không được vượt ' + main + ' suất (phải bằng món chính).';
                        return;
                    }
                }
                line.quantity = next;
                if (slot === 'main') this.balanceSideSoupToMain(day);
                this.formError = '';
                this.scheduleDraftCacheSave();
            },
            removeLine(dayOrIso, slot, dishId) {
                const day = this.resolveDay(dayOrIso);
                if (!day) return;
                day.mealPlan[slot] = day.mealPlan[slot].filter(x => x.dishId !== dishId);
                this.scheduleDraftCacheSave();
            },
            totalMainQty() {
                let t = 0;
                for (const day of this.mealDays) {
                    for (const line of day.mealPlan.main || []) {
                        t += Math.max(1, parseInt(line.quantity, 10) || 1);
                    }
                }
                return t;
            },
            estimatedTotal() {
                return this.pricePerPortion * this.totalMainQty();
            },
            promoSubtotal() {
                return this.promoSubtotalAmount > 0 ? this.promoSubtotalAmount : this.estimatedTotal();
            },
            promoDiscount() {
                return (this.selectedPromotionId || this.promotionCode)
                    ? (this.promoDiscountAmount || 0) : 0;
            },
            promoTotalAfter() {
                const sub = this.promoSubtotal();
                const disc = this.promoDiscount();
                return Math.max(0, sub - disc);
            },
            async goStep3() {
                this.formError = this.validateMealPlan();
                if (this.formError) return;
                this.step = 3;
                this.formError = '';
                this.scheduleDraftCacheSave();
                await this.loadEligiblePromotions();
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            async loadEligiblePromotions() {
                this.promoLoading = true;
                this.eligiblePromotions = [];
                this.promoListMessage = '';
                try {
                    const payload = this.buildPayload();
                    delete payload.promotionCode;
                    delete payload.promotionId;
                    const res = await fetch('/OrganizationMealOrder/EligiblePromotions', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiToken
                        },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Không tải được mã khuyến mãi.');
                    this.promoSubtotalAmount = data.subtotal || this.estimatedTotal();
                    this.promoListMessage = data.message || '';
                    this.eligiblePromotions = (data.items || []).map(p => ({
                        promotionId: p.promotionId,
                        promotionCode: p.promotionCode,
                        promotionName: p.promotionName,
                        description: p.description,
                        discountAmount: p.discountAmount,
                        totalAfter: p.totalAfter,
                        isRecommended: p.isRecommended,
                    }));
                    const recommended = this.eligiblePromotions.find(p => p.isRecommended)
                        || this.eligiblePromotions[0];
                    if (recommended) {
                        this.selectPromotion(recommended, false);
                    } else {
                        this.clearPromotion(false);
                    }
                } catch (e) {
                    this.promoListMessage = e.message || '';
                    this.promoSubtotalAmount = this.estimatedTotal();
                    this.clearPromotion(false);
                } finally {
                    this.promoLoading = false;
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                }
            },
            selectPromotion(p, scrollMsg = true) {
                this.selectedPromotionId = p.promotionId;
                this.selectedPromotionName = p.promotionName;
                this.promotionCode = (p.promotionCode || '').trim();
                this.promoDiscountAmount = p.discountAmount || 0;
                this.promoSubtotalAmount = this.promoSubtotalAmount || this.estimatedTotal();
                this.manualPromoCode = this.promotionCode;
                if (scrollMsg) {
                    this.promoPreviewApplied = true;
                    this.promoPreviewMessage = 'Đã chọn: ' + p.promotionName;
                }
            },
            clearPromotion(clearMsg = true) {
                this.selectedPromotionId = null;
                this.selectedPromotionName = '';
                this.promotionCode = '';
                this.promoDiscountAmount = 0;
                this.manualPromoCode = '';
                if (clearMsg) {
                    this.promoPreviewApplied = false;
                    this.promoPreviewMessage = '';
                }
            },
            async applyManualCode() {
                const code = (this.manualPromoCode || '').trim();
                if (!code) {
                    this.promoPreviewApplied = false;
                    this.promoPreviewMessage = 'Nhập mã khuyến mãi.';
                    return;
                }
                this.promoApplying = true;
                this.promoPreviewMessage = '';
                try {
                    const orderPayload = this.buildPayload();
                    delete orderPayload.promotionCode;
                    delete orderPayload.promotionId;
                    const res = await fetch('/OrganizationMealOrder/PreviewPromotion', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiToken
                        },
                        body: JSON.stringify({ order: orderPayload, promotionCode: code })
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Mã không hợp lệ.');
                    if (!data.applied) {
                        this.promoPreviewApplied = false;
                        this.promoPreviewMessage = data.message || 'Mã không áp dụng được cho đơn này.';
                        return;
                    }
                    this.promotionCode = (data.promotionCode || code).trim();
                    this.selectedPromotionId = data.promotionId;
                    this.selectedPromotionName = data.promotionName || code;
                    this.promoDiscountAmount = data.discountAmount || 0;
                    this.promoSubtotalAmount = data.subtotal || this.estimatedTotal();
                    this.promoPreviewApplied = true;
                    this.promoPreviewMessage = 'Đã áp dụng: ' + (data.promotionName || code);
                } catch (e) {
                    this.promoPreviewApplied = false;
                    this.promoPreviewMessage = e.message || 'Mã không hợp lệ.';
                } finally {
                    this.promoApplying = false;
                }
            },
            goStep4() {
                this.formError = this.validateMealPlan();
                if (this.formError) return;
                this.applyDeliveryDefaults(deliveryDefaults);
                this.step = 4;
                this.scheduleDraftCacheSave();
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            validateDelivery() {
                const d = this.delivery;
                if (!d.recipientName || d.recipientName.length < 2)
                    return 'Nhập họ tên người nhận (ít nhất 2 ký tự).';
                const phone = (d.recipientPhone || '').replace(/\s|-/g, '');
                if (!/^(\+?84|0)[0-9]{8,10}$/.test(phone))
                    return 'Số điện thoại không hợp lệ.';
                const email = (d.recipientEmail || '').trim();
                if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email))
                    return 'Email không hợp lệ.';
                if (!d.deliveryAddress || d.deliveryAddress.length < 10)
                    return 'Địa chỉ giao hàng phải có ít nhất 10 ký tự.';
                if (d.preferredDeliveryTime && !/^([01]?\d|2[0-3]):[0-5]\d$/.test(d.preferredDeliveryTime))
                    return 'Giờ giao không hợp lệ.';
                return '';
            },
            buildPayload() {
                const qty = (l) => Math.max(1, parseInt(l.quantity, 10) || 1);
                return {
                    organizationId: orgId,
                    price: this.pricePerPortion,
                    promotionCode: this.promotionCode || null,
                    promotionId: this.selectedPromotionId || null,
                    delivery: {
                        recipientName: (this.delivery.recipientName || '').trim(),
                        recipientPhone: (this.delivery.recipientPhone || '').trim(),
                        recipientEmail: (this.delivery.recipientEmail || '').trim(),
                        deliveryAddress: (this.delivery.deliveryAddress || '').trim(),
                        deliveryWardDistrict: (this.delivery.deliveryWardDistrict || '').trim() || null,
                        deliveryNotes: (this.delivery.deliveryNotes || '').trim() || null,
                        preferredDeliveryTime: this.delivery.preferredDeliveryTime || null,
                    },
                    mealDays: this.mealDays.map(d => ({
                        serviceDate: d.serviceDate,
                        mealPlan: {
                            main: (d.mealPlan.main || []).map(l => ({ dishId: l.dishId, quantity: qty(l) })),
                            side: (d.mealPlan.side || []).map(l => ({ dishId: l.dishId, quantity: qty(l) })),
                            soup: (d.mealPlan.soup || []).map(l => ({ dishId: l.dishId, quantity: qty(l) })),
                        }
                    }))
                };
            },
            validateMealPlan() {
                for (const day of this.mealDays) {
                    const dateErr = this.validateServiceDate(day.serviceDate);
                    if (dateErr) return dateErr;
                }
                return this.validateAllDaySlotTotals(true);
            },
            async submitDraft() {
                this.formError = this.validateMealPlan() || this.validateDelivery();
                if (this.formError) return;
                this.submitting = true;
                try {
                    const res = await fetch('/OrganizationMealOrder/PrepareContract', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiToken
                        },
                        body: JSON.stringify(this.buildPayload())
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Không tạo được nháp hợp đồng.');
                    this.clearDraftCache(false);
                    window.location.href = data.redirectUrl;
                } catch (e) {
                    this.formError = e.message || 'Lỗi khi tạo nháp.';
                } finally {
                    this.submitting = false;
                }
            },
            init() {
                this.applyDeliveryDefaults(deliveryDefaults);
                const restored = this.restoreDraftCache();
                this.applyDeliveryDefaults(deliveryDefaults);
                if (this.fromCart && this.cartImportLines.length > 0 && !this.cartImportNotice) {
                    this.cartImportNotice =
                        'Đã chuyển từ giỏ hàng (' + this.cartImportLines.length + ' món). Hoàn tất bước 1, sau đó chọn món bằng tab 「Từ giỏ hàng」 hoặc nút áp dụng nhanh.';
                }
                if (this.fromCart && this.mealDays.length > 0 && !restored) {
                    this.step = 2;
                    this.activeDay = this.mealDays[0].serviceDate;
                }
                if (restored && this.step >= 3) {
                    this.$nextTick(() => this.loadEligiblePromotions());
                }
                this.$nextTick(() => this.hydrateMealLineImages());
                this.$watch('step', () => this.scheduleDraftCacheSave());
                this.$watch('pricePerPortion', () => this.scheduleDraftCacheSave());
                this.$watch('mealDays', () => this.scheduleDraftCacheSave(), { deep: true });
                this.$watch('activeDay', () => this.scheduleDraftCacheSave());
                this.$watch('newDate', () => this.scheduleDraftCacheSave());
                window.addEventListener('beforeunload', () => {
                    if (this.hasMeaningfulDraft()) this.saveDraftCache();
                });
                document.body.classList.remove('hm-picker-open');
                this.$watch('pickerOpen', (open) => {
                    document.body.classList.toggle('hm-picker-open', !!open);
                });
                if (window.lucide) lucide.createIcons();
                if (restored) {
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                }
            }
        }));
    });
    document.addEventListener('DOMContentLoaded', () => { if (window.lucide) lucide.createIcons(); });
</script>
}
