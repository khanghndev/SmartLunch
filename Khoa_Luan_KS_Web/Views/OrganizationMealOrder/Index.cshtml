                        </div>
                    </aside>
                </div>
            </div>

            <!-- Step 3: Promotion -->
            <div x-show="step === 3" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
                <div class="grid gap-8 lg:grid-cols-[1fr_340px]">
                    <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-violet-50 via-white to-orange-50/40 px-6 py-5 sm:px-8">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-violet-600">Bước 3</p>
                            <h2 class="mt-1 text-xl font-black text-slate-900 sm:text-2xl">Chọn mã khuyến mãi</h2>
                            <p class="mt-1 text-sm text-slate-500">Chọn từ danh sách mã phù hợp hoặc nhập mã thủ công. Có thể bỏ qua nếu không dùng KM.</p>
                        </div>
                        <div class="space-y-6 p-6 sm:p-8">
