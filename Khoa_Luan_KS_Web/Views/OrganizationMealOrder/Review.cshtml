@model Khoa_Luan_KS_Web.Models.OrganizationMealOrderReviewVm
@using System.Globalization
@{
    ViewData["Title"] = "Xác nhận nháp hợp đồng";
    Layout = "_LayoutCustomer";
    var draft = Model.Draft;
    var byDate = draft.Lines.GroupBy(l => l.ServiceDate).OrderBy(g => g.Key).ToList();
    string SlotLabel(string slot) => slot.ToLowerInvariant() switch
    {
        "main" => "Món chính",
        "side" => "Món phụ",
        "soup" => "Canh",
        _ => slot
    };
}

<div class="min-h-screen bg-slate-100/90" style="background-image: radial-gradient(circle at 1px 1px, rgba(148,163,184,0.2) 1px, transparent 0); background-size: 24px 24px;">
    <section class="relative h-[220px] overflow-hidden sm:h-[260px]">
        <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=1920&auto=format&fit=crop"
             alt="" class="absolute inset-0 h-full w-full object-cover brightness-[0.4]" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900/95 via-slate-900/70 to-slate-900/30"></div>
        <div class="relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-end px-4 pb-8 pt-24 sm:px-6">
            <nav class="mb-3 flex flex-wrap items-center gap-2 text-xs font-semibold text-white/70">
                <a href="/OrganizationMealOrder" class="hover:text-orange-300">Đặt suất</a>
                <span class="text-white/30">/</span>
                <span class="text-white/90">Xác nhận nháp</span>
            </nav>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-300">Bước 3 — Xác nhận</p>
            <h1 class="mt-1 text-2xl font-black text-white sm:text-3xl">Nháp hợp đồng đặt suất</h1>
            <p class="mt-2 text-sm text-slate-300">
                @Model.OrganizationName
                <span class="mx-2 text-white/30">·</span>
                Mã nháp <span class="font-mono text-orange-200">@draft.DraftId[..Math.Min(12, draft.DraftId.Length)]…</span>
            </p>
        </div>
    </section>

    <div class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 lg:py-10">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-slate-600">Kiểm tra thực đơn và chọn tỷ lệ đặt cọc trước khi thanh toán.</p>
            <a asp-action="Index"
               class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm hover:border-orange-200 hover:text-orange-600">
                <i data-lucide="pencil" class="h-4 w-4"></i> Sửa thực đơn
            </a>
        </div>

        @if (TempData["OrgMealError"] is string ce && !string.IsNullOrEmpty(ce))
        {
            <div class="mb-6 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 shadow-sm">
                <i data-lucide="alert-circle" class="mt-0.5 h-5 w-5 shrink-0"></i>
                <span>@ce</span>
            </div>
        }

        @if (draft.ContractId > 0)
        {
            <div class="mb-6 flex flex-col gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-900 shadow-sm sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-3">
                    <i data-lucide="file-check" class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600"></i>
                    <div>
                        <p class="font-bold">Hợp đồng đã lưu vào hệ thống</p>
                        <p class="mt-0.5 text-emerald-800">
                            Mã HĐ: <span class="font-mono font-bold">@(draft.ContractNumber ?? $"#{draft.ContractId}")</span>
                            @if (!string.IsNullOrEmpty(draft.PersistenceNotice))
                            {
                                <span class="block mt-1 text-xs">@draft.PersistenceNotice</span>
                            }
                        </p>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(draft.ContractFileUrl))
                {
                    <a href="@draft.ContractFileUrl" target="_blank" rel="noopener"
                       class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-white border border-emerald-200 px-4 py-2 text-xs font-bold text-emerald-700 hover:bg-emerald-100">
                        <i data-lucide="file-text" class="h-4 w-4"></i> Xem PDF hợp đồng (nháp)
                    </a>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(draft.PersistenceNotice))
        {
            <div class="mb-6 flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900 shadow-sm">
                <i data-lucide="info" class="mt-0.5 h-5 w-5 shrink-0 text-amber-600"></i>
                <span>@draft.PersistenceNotice</span>
            </div>
        }

        <div class="mb-8 grid gap-4 sm:grid-cols-3">
            <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-5 shadow-lg ring-1 ring-slate-900/5">
                <div class="flex items-center gap-3">
                    <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700">
                        <i data-lucide="badge-dollar-sign" class="h-5 w-5"></i>
                    </span>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Giá / suất</p>
                        <p class="text-2xl font-black text-emerald-700">@draft.PricePerPortion.ToString("N0") đ</p>
                    </div>
                </div>
            </div>
            <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-5 shadow-lg ring-1 ring-slate-900/5">
                <div class="flex items-center gap-3">
                    <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-slate-700">
                        <i data-lucide="users" class="h-5 w-5"></i>
                    </span>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Tổng suất món chính</p>
                        <p class="text-2xl font-black text-slate-900">@draft.TotalMainQuantity.ToString("N0")</p>
                    </div>
                </div>
            </div>
            <div class="overflow-hidden rounded-3xl border border-orange-200 bg-gradient-to-br from-orange-50 to-amber-50/80 p-5 shadow-lg ring-1 ring-orange-500/10">
                <div class="flex items-center gap-3">
                    <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-orange-500 text-white shadow-lg shadow-orange-500/30">
                        <i data-lucide="receipt" class="h-5 w-5"></i>
                    </span>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-wider text-orange-600">Tổng thanh toán</p>
                        <p class="text-2xl font-black text-orange-700">@draft.TotalAmount.ToString("N0") đ</p>
                        @if (draft.DiscountAmount > 0)
                        {
                            <p class="mt-1 text-xs text-violet-700">Giảm @draft.DiscountAmount.ToString("N0") đ · @draft.AppliedPromotionName</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-8 overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
            <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-orange-50/30 px-6 py-4">
                <h2 class="flex items-center gap-2 text-sm font-black uppercase tracking-wide text-slate-700">
                    <i data-lucide="clipboard-list" class="h-4 w-4 text-orange-600"></i>
                    Chi tiết thực đơn
                </h2>
            </div>
            <div class="divide-y divide-slate-100">
                @foreach (var group in byDate)
                {
                    var dayMainQty = group
                        .Where(l => string.Equals(l.Slot, "main", StringComparison.OrdinalIgnoreCase))
                        .Sum(l => l.Quantity);
                    var dayAmount = decimal.Round(draft.PricePerPortion * dayMainQty, 0, MidpointRounding.AwayFromZero);
                    var daySideQty = group
                        .Where(l => string.Equals(l.Slot, "side", StringComparison.OrdinalIgnoreCase))
                        .Sum(l => l.Quantity);
                    var daySoupQty = group
                        .Where(l => string.Equals(l.Slot, "soup", StringComparison.OrdinalIgnoreCase))
                        .Sum(l => l.Quantity);

                    <div class="p-6">
                        <div class="mb-4 flex flex-wrap items-center gap-2">
                            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
                                <i data-lucide="calendar" class="h-4 w-4"></i>
                            </span>
                            <p class="text-base font-black text-slate-900">
                                @group.Key.ToString("dddd, dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
                            </p>
                        </div>
                        <div class="overflow-x-auto rounded-2xl border border-slate-100">
                            <table class="w-full min-w-[360px] text-left text-sm">
                                <thead>
                                    <tr class="bg-slate-50/90 text-[11px] font-black uppercase tracking-wider text-slate-400">
                                        <th class="px-4 py-3">Khung</th>
                                        <th class="px-4 py-3">Món</th>
                                        <th class="px-4 py-3 text-center">Số lượng</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50">
                                    @foreach (var line in group.OrderBy(l => l.Slot).ThenBy(l => l.DishName))
                                    {
                                        <tr class="transition hover:bg-slate-50/60">
                                            <td class="px-4 py-3">
                                                <span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-bold @(line.Slot == "main" ? "bg-emerald-100 text-emerald-800" : line.Slot == "side" ? "bg-violet-100 text-violet-800" : "bg-slate-100 text-slate-600")">
                                                    @SlotLabel(line.Slot)
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 font-semibold text-slate-800">@line.DishName</td>
                                            <td class="px-4 py-3 text-center font-black text-slate-900">@line.Quantity.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-4 flex flex-col gap-3 rounded-2xl border border-orange-100 bg-gradient-to-r from-orange-50/90 to-amber-50/60 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                            <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-slate-600">
                                <span>
                                    <span class="font-bold text-slate-500">Suất món chính:</span>
                                    <strong class="ml-1 text-base text-emerald-800">@dayMainQty.ToString("N0")</strong>
                                </span>
                                @if (daySideQty > 0)
                                {
                                    <span><span class="font-bold text-slate-500">Món phụ:</span> @daySideQty.ToString("N0")</span>
                                }
                                @if (daySoupQty > 0)
                                {
                                    <span><span class="font-bold text-slate-500">Canh:</span> @daySoupQty.ToString("N0")</span>
                                }
                            </div>
                            <div class="text-left sm:text-right">
                                <p class="text-[10px] font-black uppercase tracking-wider text-orange-600">Thành tiền ngày</p>
                                <p class="text-2xl font-black text-orange-700">
                                    @dayAmount.ToString("N0") <span class="text-sm font-bold">đ</span>
                                </p>
                                <p class="text-[11px] text-slate-500">
                                    @dayMainQty.ToString("N0") suất × @draft.PricePerPortion.ToString("N0") đ/suất
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <form asp-action="Checkout" method="post" class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
            <div class="border-b border-slate-100 bg-gradient-to-r from-slate-900 to-slate-800 px-6 py-5 sm:px-8">
                <h2 class="flex items-center gap-2 text-lg font-black text-white">
                    <i data-lucide="file-signature" class="h-5 w-5 text-orange-400"></i>
                    Tỷ lệ đặt cọc (sau khi ký phụ lục)
                </h2>
                <p class="mt-1 text-sm text-slate-300">Chọn tỷ lệ 20–50%. Sau khi đặt hàng bạn sẽ ký phụ lục, rồi thanh toán cọc từ lịch sử đơn hàng.</p>
            </div>
            <div class="p-6 sm:p-8">
                @Html.AntiForgeryToken()
                <div class="mb-8 grid gap-3 sm:grid-cols-3 lg:grid-cols-5">
                    @foreach (var pct in Model.AllowedDepositPercents)
                    {
                        var deposit = (int)Math.Round(draft.TotalAmount * pct / 100m, 0, MidpointRounding.AwayFromZero);
                        <label class="cursor-pointer">
                            <input type="radio" name="depositPercent" value="@pct" class="peer sr-only" @(pct == 30 ? "checked" : null) required />
                            <span class="flex flex-col items-center rounded-2xl border-2 border-slate-200 bg-slate-50/50 px-4 py-4 text-center transition peer-checked:border-orange-500 peer-checked:bg-orange-50 peer-checked:shadow-lg peer-checked:shadow-orange-500/15 hover:border-orange-300">
                                <span class="text-2xl font-black text-slate-900">@pct%</span>
                                <span class="mt-1 text-xs font-bold text-orange-700">@deposit.ToString("N0") đ</span>
                            </span>
                        </label>
                    }
                </div>
                <button type="submit"
                        class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 py-4 text-sm font-black text-white shadow-xl shadow-orange-500/30 transition hover:from-orange-600 hover:to-amber-600">
                    <i data-lucide="shopping-cart" class="h-5 w-5"></i>
                    Đặt hàng — chuyển ký phụ lục
                    <i data-lucide="arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5"></i>
                </button>
                <p class="mt-4 text-center text-xs text-slate-500">
                    Bằng việc xác nhận, bạn đồng ý với điều khoản cung cấp suất ăn của HuitMeal.
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', () => { if (window.lucide) lucide.createIcons(); });</script>
}
