@model Khoa_Luan_KS_Web.Models.OrganizationMealOrderReviewVm
@using System.Globalization
@{
    ViewData["Title"] = "Xác nhận nháp hợp đồng";
    Layout = "_LayoutCustomer";
    var draft = Model.Draft;
    var byDate = draft.Lines.GroupBy(l => l.ServiceDate).OrderBy(g => g.Key).ToList();
    string SlotLabel(string slot) => slot.ToLowerInvariant() switch
    {
        "main" => "Món chính",
        "side" => "Món phụ",
        "soup" => "Canh",
        _ => slot
    };
}

<div class="flex min-h-[calc(100vh-8rem)] flex-col bg-slate-100/80">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 px-4 py-4 backdrop-blur sm:px-8">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-orange-600">Bước xác nhận</p>
                <h1 class="text-lg font-black text-slate-900 sm:text-xl">Nháp hợp đồng đặt suất</h1>
                <p class="mt-0.5 text-xs text-slate-500">@Model.OrganizationName · Mã nháp: <span class="font-mono">@draft.DraftId[..Math.Min(12, draft.DraftId.Length)]…</span></p>
            </div>
            <a asp-action="Index" class="text-sm font-bold text-slate-500 hover:text-orange-600">← Sửa thực đơn</a>
        </div>
    </header>

    <div class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
        @if (TempData["OrgMealError"] is string ce && !string.IsNullOrEmpty(ce))
        {
            <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@ce</div>
        }

        @if (!string.IsNullOrEmpty(draft.PersistenceNotice))
        {
            <div class="mb-6 flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                <i data-lucide="info" class="mt-0.5 h-5 w-5 shrink-0"></i>
                <span>@draft.PersistenceNotice</span>
            </div>
        }

        <div class="mb-6 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Giá / suất</p>
                <p class="mt-1 text-2xl font-black text-emerald-700">@draft.PricePerPortion.ToString("N0") đ</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Tổng suất món chính</p>
                <p class="mt-1 text-2xl font-black text-slate-900">@draft.TotalMainQuantity.ToString("N0")</p>
            </div>
            <div class="rounded-2xl border border-orange-200 bg-orange-50 p-4 shadow-sm">
                <p class="text-[10px] font-black uppercase tracking-wider text-orange-600">Tổng giá trị</p>
                <p class="mt-1 text-2xl font-black text-orange-700">@draft.TotalAmount.ToString("N0") đ</p>
            </div>
        </div>

        <div class="mb-8 overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-lg">
            <div class="border-b border-slate-100 bg-slate-50 px-5 py-3">
                <h2 class="text-sm font-black uppercase tracking-wide text-slate-700">Chi tiết thực đơn</h2>
            </div>
            <div class="divide-y divide-slate-100">
                @foreach (var group in byDate)
                {
                    var dayMainQty = group
                        .Where(l => string.Equals(l.Slot, "main", StringComparison.OrdinalIgnoreCase))
                        .Sum(l => l.Quantity);
                    var dayAmount = decimal.Round(draft.PricePerPortion * dayMainQty, 0, MidpointRounding.AwayFromZero);
                    var daySideQty = group
                        .Where(l => string.Equals(l.Slot, "side", StringComparison.OrdinalIgnoreCase))
                        .Sum(l => l.Quantity);
                    var daySoupQty = group
                        .Where(l => string.Equals(l.Slot, "soup", StringComparison.OrdinalIgnoreCase))
                        .Sum(l => l.Quantity);

                    <div class="p-5">
                        <p class="mb-3 text-sm font-black text-slate-900">
                            <i data-lucide="calendar" class="mr-1 inline h-4 w-4 text-emerald-600"></i>
                            @group.Key.ToString("dddd, dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
                        </p>
                        <div class="overflow-x-auto rounded-2xl border border-slate-100">
                            <table class="w-full min-w-[360px] text-left text-sm">
                                <thead>
                                    <tr class="bg-slate-50/80 text-[11px] font-black uppercase tracking-wider text-slate-400">
                                        <th class="px-3 py-2.5">Khung</th>
                                        <th class="px-3 py-2.5">Món</th>
                                        <th class="px-3 py-2.5 text-center">Số lượng</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50">
                                    @foreach (var line in group.OrderBy(l => l.Slot).ThenBy(l => l.DishName))
                                    {
                                        <tr class="hover:bg-slate-50/50">
                                            <td class="px-3 py-2.5">
                                                <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(line.Slot == "main" ? "bg-emerald-100 text-emerald-800" : line.Slot == "side" ? "bg-violet-100 text-violet-800" : "bg-slate-100 text-slate-600")">
                                                    @SlotLabel(line.Slot)
                                                </span>
                                            </td>
                                            <td class="px-3 py-2.5 font-medium text-slate-800">@line.DishName</td>
                                            <td class="px-3 py-2.5 text-center font-bold text-slate-900">@line.Quantity.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3 flex flex-col gap-2 rounded-2xl border border-orange-100 bg-gradient-to-r from-orange-50/80 to-amber-50/50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600">
                                <span>
                                    <span class="font-bold text-slate-500">Tổng suất món chính:</span>
                                    <strong class="ml-1 text-base text-emerald-800">@dayMainQty.ToString("N0")</strong>
                                </span>
                                @if (daySideQty > 0)
                                {
                                    <span><span class="font-bold text-slate-500">Món phụ:</span> @daySideQty.ToString("N0") suất</span>
                                }
                                @if (daySoupQty > 0)
                                {
                                    <span><span class="font-bold text-slate-500">Canh:</span> @daySoupQty.ToString("N0") suất</span>
                                }
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-black uppercase tracking-wider text-orange-600">Thành tiền ngày</p>
                                <p class="text-xl font-black text-orange-700">
                                    @dayAmount.ToString("N0") <span class="text-sm font-bold">đ</span>
                                </p>
                                <p class="text-[11px] text-slate-500">
                                    @dayMainQty.ToString("N0") suất × @draft.PricePerPortion.ToString("N0") đ/suất
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <form asp-action="Checkout" method="post" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl sm:p-8">
            @Html.AntiForgeryToken()
            <h2 class="mb-4 text-base font-black text-slate-900">Thanh toán đặt cọc</h2>
            <p class="mb-4 text-sm text-slate-600">Chọn tỷ lệ đặt cọc (20–50%). Sau khi xác nhận, hệ thống tạo đơn hàng và chuyển sang cổng PayOS.</p>
            <div class="mb-6 flex flex-wrap gap-2">
                @foreach (var pct in Model.AllowedDepositPercents)
                {
                    var deposit = (int)Math.Round(draft.TotalAmount * pct / 100m, 0, MidpointRounding.AwayFromZero);
                    <label class="cursor-pointer">
                        <input type="radio" name="depositPercent" value="@pct" class="peer sr-only" @(pct == 30 ? "checked" : null) required />
                        <span class="inline-flex flex-col items-center rounded-2xl border-2 border-slate-200 px-4 py-3 text-center transition peer-checked:border-orange-500 peer-checked:bg-orange-50 hover:border-orange-300">
                            <span class="text-lg font-black text-slate-900">@pct%</span>
                            <span class="text-[11px] font-bold text-orange-700">@deposit.ToString("N0") đ</span>
                        </span>
                    </label>
                }
            </div>
            <button type="submit"
                    class="w-full rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 py-4 text-sm font-black text-white shadow-lg shadow-orange-500/30 hover:from-orange-600 hover:to-amber-600">
                Xác nhận đơn &amp; thanh toán cọc
            </button>
            <p class="mt-3 text-center text-xs text-slate-500">
                Bằng việc xác nhận, bạn đồng ý với điều khoản cung cấp suất ăn của HuitMeal.
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', () => { if (window.lucide) lucide.createIcons(); });</script>
}
