@section Scripts {
    <script>
        // --- 1. ACCORDION (WHY SECTION) ---
        const whyData = [
            { 
                title: "Hơn 15 năm kinh nghiệm thực chiến", 
                content: "HuitMeal tự hào có bề dày kinh nghiệm phục vụ hàng ngàn đối tác, thấu hiểu sâu sắc nhu cầu dinh dưỡng của từng ngành nghề từ nhà máy đến văn phòng.",
                icon: "history"
            },
            { 
                title: "Tiêu chuẩn vệ sinh quốc tế", 
                content: "Hệ thống vận hành đạt chuẩn HACCP, ISO 22000 và FSSC 22000. Chúng tôi kiểm soát nguồn nguyên liệu đầu vào 100% VietGAP và Organic.",
                icon: "shield-check"
            },
            { 
                title: "Đội ngũ chuyên gia dinh dưỡng", 
                content: "Mỗi thực đơn được thiết kế bởi các chuyên gia dinh dưỡng hàng đầu, đảm bảo cân bằng dưỡng chất và đa dạng khẩu vị mỗi ngày.",
                icon: "users"
            }
        ];

        const container = document.getElementById('why-accordion');
        whyData.forEach((item, index) => {
            const html = `
                <div class="why-item rounded-3xl px-6 md:px-8 py-5 md:py-6 transition-all duration-300 border border-gray-100 hover:border-red-100 cursor-pointer bg-white group" onclick="toggleWhy(` + index + `)">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 bg-red-50 rounded-xl flex items-center justify-center text-red-600 group-hover:bg-red-600 group-hover:text-white transition-colors">
                                <i data-lucide="`+ item.icon +`" class="w-5 h-5"></i>
                            </div>
                            <span class="why-title text-base md:text-lg font-bold text-gray-800 transition-colors">` + item.title + `</span>
                        </div>
                        <div class="why-icon-box w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 group-hover:text-red-600 group-hover:border-red-600 transition-all">
                             <i data-lucide="plus" class="w-4 h-4 transition-transform duration-300 why-icon"></i>
                        </div>
                    </div>
                    <div class="why-content overflow-hidden transition-all duration-500 max-h-0 opacity-0">
                        <p class="text-gray-500 text-sm md:text-base leading-relaxed mt-5 pl-14">` + item.content + `</p>
                    </div>
                </div>
            `;
            container.innerHTML += html;
        });

        function toggleWhy(index) {
            const items = document.querySelectorAll('.why-item');
            items.forEach((el, i) => {
                const content = el.querySelector('.why-content');
                const icon = el.querySelector('.why-icon');
                const title = el.querySelector('.why-title');
                const iconBox = el.querySelector('.why-icon-box');
                if (i === index) {
                    const isOpen = !content.classList.contains('max-h-0');
                    if (isOpen) {
                        content.classList.add('max-h-0', 'opacity-0');
                        content.classList.remove('max-h-40', 'opacity-100');
                        icon.classList.remove('rotate-45');
                        title.classList.remove('text-red-600');
                        iconBox.classList.remove('bg-red-600', 'text-white', 'border-red-600');
                    } else {
                        content.classList.remove('max-h-0', 'opacity-0');
                        content.classList.add('max-h-40', 'opacity-100');
                        icon.classList.add('rotate-45');
                        title.classList.add('text-red-600');
                        iconBox.classList.add('bg-red-600', 'text-white', 'border-red-600');
                    }
                } else {
                    content.classList.add('max-h-0', 'opacity-0');
                    content.classList.remove('max-h-40', 'opacity-100');
                    icon.classList.remove('rotate-45');
                    title.classList.remove('text-red-600');
                    iconBox.classList.remove('bg-red-600', 'text-white', 'border-red-600');
                }
            });
        }

        // --- 2. COUNT UP ---
        const countObserver = new IntersectionObserver(entries => {
            if(entries[0].isIntersecting) {
                document.querySelectorAll('.counter').forEach(counter => {
                    const target = +counter.getAttribute('data-target');
                    let count = 0;
                    const duration = 2000;
                    const startTime = performance.now();
                    
                    const updateCount = (currentTime) => {
                        const elapsed = currentTime - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const easeOut = 1 - Math.pow(1 - progress, 3);
                        counter.innerText = Math.ceil(easeOut * target);
                        
                        if (progress < 1) {
                            requestAnimationFrame(updateCount);
                        } else {
                            counter.innerText = target;
                        }
                    };
                    requestAnimationFrame(updateCount);
                });
                countObserver.disconnect();
            }
        }, { threshold: 0.5 });
        countObserver.observe(document.getElementById('about-section'));
        
        // Refresh Lucide icons
        lucide.createIcons();
    </script>
}
