@{
    ViewData["Title"] = "Trang Chủ";
    Layout = "_LayoutCustomer";
}

<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .animate-fadeInUp {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .animate-float {
        animation: float 3s ease-in-out infinite;
    }

    .animation-delay-200 { animation-delay: 0.2s; }
    .animation-delay-400 { animation-delay: 0.4s; }
    .animation-delay-600 { animation-delay: 0.6s; }

    .glass-effect {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
</style>

<div class="w-full overflow-hidden bg-transparent">
    <!-- HERO SECTION -->
    <section class="relative min-h-[600px] lg:min-h-screen flex items-center pt-20 overflow-hidden">
        <div class="absolute inset-0">
            <img src="/assets/images/home_hero.png" alt="Home Hero" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
        </div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-3xl animate-fadeInUp">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-effect mb-8 text-white text-sm font-medium border border-white/10">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    Hệ thống suất ăn công nghiệp số 1 Việt Nam
                </div>
                <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight mb-8">
                    Tận Tâm Phục Vụ <br/>
                    <span class="text-red-500">Bữa Ăn Tử Tế</span>
                </h1>
                <p class="text-lg md:text-xl text-gray-300 mb-12 max-w-2xl font-light leading-relaxed">
                    HuitMeal mang đến giải pháp dinh dưỡng toàn diện với tiêu chuẩn vệ sinh quốc tế, 
                    đảm bảo sức khỏe và năng lượng cho hàng triệu người lao động mỗi ngày.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="/Customer/About" class="px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-lg shadow-red-600/30">
                        Khám phá ngay
                    </a>
                    <a href="/Customer/Contact" class="px-8 py-4 glass-effect text-white font-bold rounded-2xl transition-all duration-300 hover:bg-white/20 border border-white/20">
                        Liên hệ tư vấn
                    </a>
                </div>
            </div>
        </div>

        <!-- Floating decorative card -->
        <div class="hidden lg:block absolute right-32 top-1/2 -translate-y-1/2 animate-float">
            <div class="glass-effect p-8 rounded-[40px] w-80 text-white">
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-12 h-12 bg-green-500/20 rounded-2xl flex items-center justify-center">
                        <i data-lucide="shield-check" class="text-green-400 w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold">100%</div>
                        <div class="text-xs text-gray-400 uppercase tracking-widest">An toàn thực phẩm</div>
                    </div>
                </div>
                <div class="space-y-4">
                    <div class="h-1.5 w-full bg-white/10 rounded-full overflow-hidden">
                        <div class="h-full bg-red-500 w-[95%]"></div>
                    </div>
                    <p class="text-sm text-gray-400 leading-relaxed italic">
                        "Cam kết mang đến nguồn năng lượng sạch cho sự phát triển bền vững."
                    </p>
                </div>
            </div>
        </div>

        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0]">
            <svg class="relative block w-[calc(100%+1.3px)] h-[50px] md:h-[80px]" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C57.23,103.19,113.4,83.48,170.1,68.61,226.71,53.74,283.3,64,321.39,56.44Z" class="fill-white"></path>
            </svg>
        </div>
    </section>

    <!-- CORPORATE INTRODUCTION SECTION (Image-inspired style) -->
    <section id="about-section" class="py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-2 gap-16 items-start">
                
                <!-- Left: Professional Introduction Letter -->
                <div class="animate-fadeInUp">
                    <div class="mb-10">
                        <h3 class="text-emerald-700 font-serif italic text-3xl mb-4">Đôi nét về HuitMeal</h3>
                        <div class="w-24 h-1 bg-emerald-600 rounded-full mb-8"></div>
                        
                        <p class="text-slate-900 font-black text-xl mb-6">Kính thưa quý khách hàng!</p>
                        
                        <div class="space-y-4 text-slate-600 text-base leading-relaxed text-justify">
                            <p>
                                Cùng với quá trình công nghiệp hóa, hiện đại hóa trong sản xuất, việc tìm được <span class="text-emerald-700 font-bold">công ty suất ăn công nghiệp uy tín</span> là một trong những ưu tiên hàng đầu của các Doanh nghiệp, đặc biệt là người làm công tác quản lý và cũng là niềm mong mỏi của tất cả anh chị em công nhân. Để người lao động gắn bó lâu dài với công ty và đủ sức khỏe làm việc thì bữa ăn phải đầy đủ dưỡng chất, ngon miệng và bảo đảm an toàn vệ sinh thực phẩm.
                            </p>
                            <p>
                                <span class="text-emerald-700 font-bold">HuitMeal (Huit Catering Service)</span> với đội ngũ quản lý, đầu bếp, nhân viên nhiều năm kinh nghiệm hoạt động trong lĩnh vực cung cấp suất ăn công nghiệp sẽ là sự lựa chọn đúng đắn của Quý khách.
                            </p>
                        </div>
                    </div>

                    <!-- Commitments -->
                    <div class="bg-emerald-50/50 rounded-[32px] p-8 border border-emerald-100 mb-10">
                        <h4 class="text-slate-900 font-black text-lg mb-6 flex items-center gap-3">
                            <i class="fas fa-check-circle text-emerald-600"></i>
                            Chúng tôi luôn cam kết:
                        </h4>
                        <ul class="space-y-4 text-slate-700 font-medium">
                            <li class="flex items-start gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center mt-0.5">1</span>
                                <span>Đảm bảo định lượng như đã cam kết.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center mt-0.5">2</span>
                                <span>Sản xuất chế biến thực phẩm theo quy trình một chiều.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center mt-0.5">3</span>
                                <span>Hàng hóa bảo đảm chất lượng, có nguồn gốc rõ ràng.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center mt-0.5">4</span>
                                <span>Đội ngũ Quản lý, Đầu bếp, Nhân viên phục vụ chuyên nghiệp.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center mt-0.5">5</span>
                                <span>Đảm bảo an toàn vệ sinh thực phẩm theo tiêu chuẩn ISO 22000.</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Consultancy -->
                    <div class="mb-10">
                        <h4 class="text-slate-900 font-black text-lg mb-4 italic underline decoration-emerald-500 decoration-4 underline-offset-8">Tư vấn miễn phí:</h4>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 text-slate-600">
                            <li class="flex items-center gap-2"><i class="fas fa-arrow-right text-emerald-500 text-xs"></i> Khẩu phần ăn theo đặc thù ngành nghề.</li>
                            <li class="flex items-center gap-2"><i class="fas fa-arrow-right text-emerald-500 text-xs"></i> Thiết kế bếp ăn quy trình một chiều.</li>
                            <li class="flex items-center gap-2"><i class="fas fa-arrow-right text-emerald-500 text-xs"></i> Chế độ dinh dưỡng (Kcalo/phần ăn).</li>
                        </ul>
                    </div>

                    <!-- Contact highlight -->
                    <div class="flex flex-col md:flex-row items-center gap-6 p-6 bg-slate-900 rounded-2xl text-white">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-emerald-500 flex items-center justify-center animate-pulse">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div>
                                <p class="text-emerald-400 text-xs font-bold uppercase tracking-widest">Hotline tư vấn</p>
                                <p class="text-xl font-black">0334 297 551 (Mr. Khang)</p>
                            </div>
                        </div>
                        <div class="hidden md:block w-px h-10 bg-white/20"></div>
                        <p class="text-slate-400 text-xs italic">HuitMeal rất tự hào khi được hợp tác cùng Quý Công ty.</p>
                    </div>
                </div>

                <!-- Right: Visual Collage (Operations & Certificates) -->
                <div class="animate-fadeInUp animation-delay-400 space-y-8">
                    <!-- Main operational image -->
                    <div class="relative group">
                        <div class="absolute -inset-4 bg-emerald-600/10 rounded-[48px] blur-2xl group-hover:bg-emerald-600/20 transition-all duration-500"></div>
                        <div class="relative rounded-[40px] overflow-hidden shadow-2xl border-4 border-white">
                            <img src="https://images.unsplash.com/photo-1577106263724-2c8e03bfe9cf?auto=format&fit=crop&q=80&w=800" class="w-full h-[400px] object-cover" alt="Operation" />
                            <div class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-black/80 to-transparent">
                                <p class="text-white font-bold text-sm uppercase tracking-[0.2em]">Hệ thống vận hành hiện đại - An toàn - Chất lượng</p>
                            </div>
                        </div>
                    </div>

                    <!-- Grid of smaller items -->
                    <div class="grid grid-cols-2 gap-6">
                        <!-- Truck/Logistics -->
                        <div class="rounded-3xl overflow-hidden shadow-lg border-2 border-white">
                            <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&q=80" class="w-full h-40 object-cover" alt="Logistics" />
                        </div>
                        <div class="bg-slate-50 rounded-3xl p-4 flex flex-col items-center justify-center border-2 border-dashed border-slate-200 hover:border-emerald-500 transition-colors group text-emerald-600">
                            <i class="fas fa-certificate text-5xl mb-2 group-hover:scale-110 transition-transform"></i>
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">Chứng nhận ISO 22000</span>
                        </div>
                        <!-- Award/Shield -->
                        <div class="bg-amber-50 rounded-3xl p-4 flex flex-col items-center justify-center border-2 border-white shadow-md group">
                            <i class="fas fa-award text-5xl text-amber-500 mb-2 group-hover:rotate-12 transition-transform"></i>
                            <span class="text-[10px] font-black text-amber-700 uppercase tracking-widest text-center">Thương hiệu mạnh</span>
                        </div>
                        <!-- Kitchen -->
                        <div class="rounded-3xl overflow-hidden shadow-lg border-2 border-white">
                            <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&q=80" class="w-full h-40 object-cover" alt="Kitchen" />
                        </div>
                    </div>

                    <!-- Stats summary (floating style) -->
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-4">
                            <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center text-red-600 font-bold">15+</div>
                            <span class="text-xs font-bold text-slate-500 uppercase">Năm kinh nghiệm</span>
                        </div>
                        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-4">
                            <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600 font-bold">200+</div>
                            <span class="text-xs font-bold text-slate-500 uppercase">Đối tác FDI</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FEATURED MENU SECTION -->
    <section class="py-24 bg-gray-50" x-data="{ activeMenu: 'all' }">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Header -->
            <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-8 mb-14">
                <div>
                    <span class="text-orange-600 font-bold tracking-[0.25em] uppercase text-xs mb-3 block">Thực đơn tiêu biểu</span>
                    <h2 class="text-3xl md:text-5xl font-black text-gray-900 leading-tight tracking-tight">
                        Khám phá <span class="text-orange-600">Thực Đơn</span> <br class="hidden md:block"/> của HuitMeal
                    </h2>
                </div>
                <a href="/Menu" class="flex items-center gap-2 font-bold text-orange-600 hover:gap-4 transition-all group whitespace-nowrap">
                    Xem toàn bộ thực đơn
                    <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>

            <!-- Category Tabs -->
            <div class="flex flex-wrap gap-3 mb-12">
                @foreach (var (label, val) in new[] { ("Tất cả", "all"), ("Suất ăn nhà máy", "factory"), ("Suất ăn học đường", "school"), ("Suất ăn văn phòng", "office") })
                {
                    <button
                        @@click="activeMenu = '@val'"
                        :class="activeMenu === '@val' ? 'bg-orange-500 text-white shadow-md shadow-orange-200' : 'bg-white text-gray-600 border border-gray-200 hover:border-orange-300 hover:text-orange-600'"
                        class="px-6 py-3 rounded-full text-sm font-bold transition-all">
                        @label
                    </button>
                }
            </div>

            <!-- Menu Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

                <!-- Card: Cơm gà sốt cà -->
                <div x-show="activeMenu === 'all' || activeMenu === 'factory'"
                     x-transition:enter="transition duration-300 ease-out"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     class="group bg-white rounded-[24px] overflow-hidden border border-gray-100 hover:shadow-xl hover:border-orange-200 transition-all duration-400">
                    <div class="relative overflow-hidden h-52">
                        <img src="https://images.unsplash.com/photo-1512058564366-18510be2db19?w=400&q=80" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute top-3 left-3">
                            <span class="bg-orange-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">Nhà máy</span>
                        </div>
                        <div class="absolute top-3 right-3">
                            <span class="bg-white/90 backdrop-blur-sm text-gray-900 text-xs font-black px-3 py-1.5 rounded-full">35.000đ</span>
                        </div>
                    </div>
                    <div class="p-5">
                        <h4 class="font-bold text-gray-900 text-base mb-1.5">Cơm gà sốt cà chua</h4>
                        <p class="text-xs text-gray-500 mb-3 leading-relaxed">Gà ta hầm mềm, cà chua tươi, rau muống luộc, canh rau</p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="text-[10px] bg-green-50 text-green-700 border border-green-100 px-2 py-0.5 rounded-full font-semibold">ISO 22000</span>
                            <span class="text-[10px] bg-orange-50 text-orange-700 border border-orange-100 px-2 py-0.5 rounded-full font-semibold">Nóng hổi</span>
                        </div>
                    </div>
                </div>

                <!-- Card: Cơm sườn nướng -->
                <div x-show="activeMenu === 'all' || activeMenu === 'office'"
                     x-transition:enter="transition duration-300 ease-out"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     class="group bg-white rounded-[24px] overflow-hidden border border-gray-100 hover:shadow-xl hover:border-orange-200 transition-all duration-400">
                    <div class="relative overflow-hidden h-52">
                        <img src="https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?w=400&q=80" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute top-3 left-3">
                            <span class="bg-blue-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">Văn phòng</span>
                        </div>
                        <div class="absolute top-3 right-3">
                            <span class="bg-white/90 backdrop-blur-sm text-gray-900 text-xs font-black px-3 py-1.5 rounded-full">40.000đ</span>
                        </div>
                    </div>
                    <div class="p-5">
                        <h4 class="font-bold text-gray-900 text-base mb-1.5">Cơm sườn nướng mật ong</h4>
                        <p class="text-xs text-gray-500 mb-3 leading-relaxed">Sườn heo tươi ướp gia vị, cơm gạo ST25, dưa leo, canh chua</p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="text-[10px] bg-green-50 text-green-700 border border-green-100 px-2 py-0.5 rounded-full font-semibold">VietGAP</span>
                            <span class="text-[10px] bg-blue-50 text-blue-700 border border-blue-100 px-2 py-0.5 rounded-full font-semibold">Cân bằng</span>
                        </div>
                    </div>
                </div>

                <!-- Card: Phần ăn học đường -->
                <div x-show="activeMenu === 'all' || activeMenu === 'school'"
                     x-transition:enter="transition duration-300 ease-out"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     class="group bg-white rounded-[24px] overflow-hidden border border-gray-100 hover:shadow-xl hover:border-orange-200 transition-all duration-400">
                    <div class="relative overflow-hidden h-52">
                        <img src="https://images.unsplash.com/photo-1547592166-23ac45744acd?w=400&q=80" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute top-3 left-3">
                            <span class="bg-green-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">Học đường</span>
                        </div>
                        <div class="absolute top-3 right-3">
                            <span class="bg-white/90 backdrop-blur-sm text-gray-900 text-xs font-black px-3 py-1.5 rounded-full">28.000đ</span>
                        </div>
                    </div>
                    <div class="p-5">
                        <h4 class="font-bold text-gray-900 text-base mb-1.5">Suất ăn dinh dưỡng học sinh</h4>
                        <p class="text-xs text-gray-500 mb-3 leading-relaxed">Cơm trắng, cá hú kho, rau cải xào, canh bí đỏ hầm xương</p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="text-[10px] bg-purple-50 text-purple-700 border border-purple-100 px-2 py-0.5 rounded-full font-semibold">Dinh dưỡng</span>
                            <span class="text-[10px] bg-green-50 text-green-700 border border-green-100 px-2 py-0.5 rounded-full font-semibold">An toàn</span>
                        </div>
                    </div>
                </div>

                <!-- Card: Bữa chính công nhân -->
                <div x-show="activeMenu === 'all' || activeMenu === 'factory'"
                     x-transition:enter="transition duration-300 ease-out"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     class="group bg-white rounded-[24px] overflow-hidden border border-gray-100 hover:shadow-xl hover:border-orange-200 transition-all duration-400">
                    <div class="relative overflow-hidden h-52">
                        <img src="https://images.unsplash.com/photo-1569050467447-ce54b3bbc37d?w=400&q=80" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute top-3 left-3">
                            <span class="bg-orange-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">Nhà máy</span>
                        </div>
                        <div class="absolute top-3 right-3">
                            <span class="bg-white/90 backdrop-blur-sm text-gray-900 text-xs font-black px-3 py-1.5 rounded-full">32.000đ</span>
                        </div>
                    </div>
                    <div class="p-5">
                        <h4 class="font-bold text-gray-900 text-base mb-1.5">Bữa chính ca sản xuất</h4>
                        <p class="text-xs text-gray-500 mb-3 leading-relaxed">Cơm trắng, thịt heo kho trứng, đậu hũ chiên, canh rau muống</p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="text-[10px] bg-red-50 text-red-700 border border-red-100 px-2 py-0.5 rounded-full font-semibold">Năng lượng cao</span>
                            <span class="text-[10px] bg-orange-50 text-orange-700 border border-orange-100 px-2 py-0.5 rounded-full font-semibold">Nóng hổi</span>
                        </div>
                    </div>
                </div>

                <!-- Card: Combo văn phòng -->
                <div x-show="activeMenu === 'all' || activeMenu === 'office'"
                     x-transition:enter="transition duration-300 ease-out"
