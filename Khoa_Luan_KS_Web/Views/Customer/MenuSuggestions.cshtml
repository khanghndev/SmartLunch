                    <div class="relative h-[280px] overflow-hidden">
                        <img src="/assets/images/mamnon.jpg" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="School Meal 1" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <div class="absolute top-6 left-6">
                            <span class="px-4 py-1.5 bg-blue-500 text-white rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg">TRƯỜNG HỌC</span>
                        </div>
                    </div>
                    <div class="p-8 flex flex-col flex-grow">
                        <h3 class="text-2xl font-black text-slate-900 mb-4 group-hover:text-emerald-600 transition-colors">Suất Kids Development</h3>
                        <p class="text-slate-500 text-sm mb-6 leading-relaxed">Hương vị trẻ thơ, kích thích vị giác và bổ sung Canxi phát triển chiều cao.</p>
                        <div class="space-y-3 mb-8 flex-grow">
                            <div class="flex items-center gap-3 text-slate-700 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i> 
                                <span class="text-sm">Thịt viên sốt cà chua</span>
                            </div>
                            <div class="flex items-center gap-3 text-slate-700 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i> 
                                <span class="text-sm">Trứng hấp ngũ sắc, Tôm rim</span>
                            </div>
                            <div class="flex items-center gap-3 text-slate-700 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i> 
                                <span class="text-sm">Canh sườn khoai tây, Su su xào</span>
                            </div>
                        </div>
