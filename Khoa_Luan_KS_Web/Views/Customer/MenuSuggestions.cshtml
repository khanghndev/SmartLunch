                            <div>
                                <div class="text-xl font-black text-slate-900">450 Kcal</div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Phát triển chiều cao</div>
                            </div>
                            <a href="/Customer/MealDetail?level=mamnon&day=t2" class="px-6 py-3 bg-slate-900 text-white rounded-2xl font-bold text-xs group-hover:bg-emerald-500 transition-all shadow-lg hover:shadow-emerald-500/30">
                                XEM CHI TIẾT
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Factory 2 -->
                <div x-show="filter === 'all' || filter === 'factory'" x-transition:enter="transition ease-out duration-500" class="group bg-white rounded-[40px] overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col h-full hover:-translate-y-2" data-animate="fade-up">
                    <div class="relative h-[280px] overflow-hidden">
                        <img src="/assets/images/fact2.jpg" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="Factory Meal 2" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <div class="absolute top-6 left-6">
