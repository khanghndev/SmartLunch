@{
    ViewData["Title"] = "Gợi ý thực đơn - HuitMeal";
    Layout = "_LayoutCustomer";
}

<div class="w-full bg-white overflow-hidden">
    <!-- ===== HERO SECTION ===== -->
    <section class="relative w-full h-[50vh] min-h-[500px] md:h-[70vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0">
            <img src="/assets/images/menu_suggestions_hero.png" class="w-full h-full object-cover object-center scale-105" alt="Menu Suggestions Banner" />
            <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px]"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-slate-900/40 via-transparent to-white"></div>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
            <div data-animate="fade-down">
                <span class="inline-block px-4 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs md:text-sm font-bold uppercase tracking-[0.2em] mb-6 backdrop-blur-md">
                    Chuyên gia dinh dưỡng
                </span>
            </div>
            <h1 data-animate="fade-up" data-delay="1" class="text-4xl md:text-6xl lg:text-8xl font-black text-white leading-[1.1] mb-6 tracking-tight">
                Gợi ý <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Thực đơn chuẩn</span>
            </h1>
            <p data-animate="fade-up" data-delay="2" class="text-lg md:text-xl text-slate-200 max-w-3xl mx-auto mb-10 leading-relaxed font-medium">
                Khám phá các mẫu thực đơn được thiết kế khoa học, tối ưu dinh dưỡng cho từng môi trường làm việc và học tập.
            </p>
            <div data-animate="fade-up" data-delay="3" class="flex justify-center gap-4">
                <a href="#samples" class="px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-white rounded-full font-bold text-sm transition-all shadow-lg shadow-emerald-500/25 hover:-translate-y-1">
                    XEM CÁC MẪU THỰC ĐƠN
                </a>
            </div>
        </div>
    </section>

    <!-- ===== SAMPLE MENUS SECTION ===== -->
    <section id="samples" class="py-24 bg-white" x-data="{ filter: 'all' }">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
                <h4 class="text-emerald-600 font-bold uppercase tracking-widest text-sm mb-4">Mẫu thực đơn tiêu biểu</h4>
                <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-8 tracking-tight">Lựa chọn tối ưu cho bạn</h2>
                
                <!-- Filter Tabs -->
                <div class="inline-flex p-1.5 bg-slate-100 rounded-3xl w-fit">
                    <button @@click="filter = 'all'" :class="filter === 'all' ? 'bg-white text-emerald-600 shadow-sm' : 'text-slate-500 hover:text-slate-900'" class="px-8 py-3 rounded-2xl font-bold text-xs md:text-sm transition-all duration-300 uppercase">Tất cả</button>
                    <button @@click="filter = 'factory'" :class="filter === 'factory' ? 'bg-white text-emerald-600 shadow-sm' : 'text-slate-500 hover:text-slate-900'" class="px-8 py-3 rounded-2xl font-bold text-xs md:text-sm transition-all duration-300 uppercase">Nhà máy</button>
                    <button @@click="filter = 'office'" :class="filter === 'office' ? 'bg-white text-emerald-600 shadow-sm' : 'text-slate-500 hover:text-slate-900'" class="px-8 py-3 rounded-2xl font-bold text-xs md:text-sm transition-all duration-300 uppercase">Văn phòng</button>
                    <button @@click="filter = 'school'" :class="filter === 'school' ? 'bg-white text-emerald-600 shadow-sm' : 'text-slate-500 hover:text-slate-900'" class="px-8 py-3 rounded-2xl font-bold text-xs md:text-sm transition-all duration-300 uppercase">Trường học</button>
                </div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
                <!-- Card 1: Factory 1 -->
                <div x-show="filter === 'all' || filter === 'factory'" x-transition:enter="transition ease-out duration-500" class="group bg-white rounded-[40px] overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col h-full hover:-translate-y-2" data-animate="fade-up">
                    <div class="relative h-[280px] overflow-hidden">
                        <img src="/assets/images/fact1.jpg" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="Factory Meal 1" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <div class="absolute top-6 left-6">
                            <span class="px-4 py-1.5 bg-orange-500 text-white rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg">NHÀ MÁY</span>
                        </div>
                    </div>
                    <div class="p-8 flex flex-col flex-grow">
                        <h3 class="text-2xl font-black text-slate-900 mb-4 group-hover:text-emerald-600 transition-colors">Suất Năng Lượng Đột Phá</h3>
                        <p class="text-slate-500 text-sm mb-6 leading-relaxed">Được thiết kế cho công nhân lao động cường độ cao, giàu đạm và tinh bột phức hợp.</p>
                        <div class="space-y-3 mb-8 flex-grow">
                            <div class="flex items-center gap-3 text-slate-700 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i> 
                                <span class="text-sm">Bò kho bánh mì / Cơm trắng</span>
                            </div>
                            <div class="flex items-center gap-3 text-slate-700 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i> 
                                <span class="text-sm">Cá điêu hồng chiên xù</span>
                            </div>
                            <div class="flex items-center gap-3 text-slate-700 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i> 
                                <span class="text-sm">Cải thìa xào tỏi, Canh bí đỏ</span>
                            </div>
                        </div>
                        <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                            <div>
                                <div class="text-xl font-black text-slate-900">750 Kcal</div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Năng lượng cao</div>
                            </div>
                            <a href="/Customer/MealDetail?level=factory&day=t2" class="px-6 py-3 bg-slate-900 text-white rounded-2xl font-bold text-xs group-hover:bg-emerald-500 transition-all shadow-lg hover:shadow-emerald-500/30">
                                XEM CHI TIẾT
                            </a>
