                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Dinh dưỡng cân bằng</div>
                            </div>
                            <a href="/Customer/MealDetail?level=office&day=t3" class="px-6 py-3 bg-slate-900 text-white rounded-2xl font-bold text-xs group-hover:bg-emerald-500 transition-all shadow-lg hover:shadow-emerald-500/30">
                                XEM CHI TIẾT
                            </a>
