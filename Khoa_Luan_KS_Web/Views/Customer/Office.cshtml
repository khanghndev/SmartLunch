@{
    ViewData["Title"] = "Suất ăn văn phòng";
    Layout = "_LayoutCustomer";
}

<div class="w-full">
    <!-- ===== HERO ===== -->
    <section class="relative w-full h-[220px] sm:h-[280px] md:h-[360px] lg:h-[450px] xl:h-[520px] overflow-hidden">
        <img src="/assets/images/banner-service.jpg" class="absolute inset-0 w-full h-full object-cover object-center" />
        <div class="absolute inset-0 bg-black/60 md:bg-black/50"></div>
        <div class="relative z-10 h-full flex flex-col items-center justify-center text-white text-center px-4 sm:px-6">
            <h1 class="font-bold leading-tight text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl">Suất ăn văn phòng</h1>
            <p class="mt-2 sm:mt-3 text-xs sm:text-sm md:text-base lg:text-lg text-gray-200 max-w-[90%] sm:max-w-xl">
                Gọn nhẹ – Healthy – Đủ năng lượng làm việc
            </p>
        </div>
    </section>

    <!-- ===== INTRO ===== -->
    <section class="bg-white py-12 md:py-20">
        <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
            <div class="flex flex-col justify-center max-w-xl mx-auto md:mx-0 text-center md:text-left">
                <h2 class="font-bold mb-5 leading-snug text-lg sm:text-xl md:text-3xl lg:text-4xl whitespace-nowrap">
                    Suất ăn văn phòng tiện lợi & lành mạnh
                </h2>
                <p class="text-gray-600 leading-relaxed whitespace-pre-line text-sm md:text-base md:text-justify tracking-wide">
                    HAPPYSPOON cung cấp các suất ăn văn phòng được thiết kế khoa học, phù hợp với nhu cầu làm việc trong môi trường công sở. Mỗi bữa ăn đảm bảo cân đối dinh dưỡng giữa tinh bột, đạm, chất béo và rau xanh, giúp duy trì năng lượng ổn định mà không gây cảm giác nặng bụng sau khi ăn.

                    Thực đơn được thay đổi đa dạng mỗi ngày, mang đến nhiều lựa chọn phong phú, phù hợp khẩu vị của nhân viên văn phòng. Các món ăn được chế biến thanh đạm, ít dầu mỡ, giúp ăn ngon miệng nhưng vẫn tốt cho sức khỏe lâu dài.

                    Nguyên liệu được tuyển chọn kỹ lưỡng, đảm bảo nguồn gốc rõ ràng và vệ sinh an toàn thực phẩm. Quy trình chế biến khép kín, đóng gói tiện lợi, dễ dàng sử dụng ngay tại văn phòng hoặc mang đi.

                    Không chỉ là bữa ăn trưa, HAPPYSPOON còn mang đến giải pháp dinh dưỡng hiện đại, góp phần nâng cao hiệu suất làm việc, cải thiện sức khỏe và chất lượng cuộc sống cho nhân viên.
                </p>
            </div>
            <div class="w-full h-[250px] sm:h-[300px] md:h-[400px] md:translate-x-10 lg:translate-x-16">
                <img src="/assets/images/vanphong.jpg" class="w-full h-full object-cover rounded-2xl shadow-lg" />
            </div>
        </div>
    </section>

    <!-- ===== BENEFITS ===== -->
    <section class="bg-[#f3efe4] py-10 sm:py-12 md:py-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <h2 class="text-xl sm:text-2xl md:text-4xl font-bold text-center mb-8 sm:mb-10 md:mb-14 leading-snug">
                Lợi ích dành cho dân văn phòng
            </h2>
            <p class="text-center text-gray-500 max-w-xl mx-auto mb-8 sm:mb-10 text-xs sm:text-sm md:text-base">
                Giải pháp bữa trưa tiện lợi – lành mạnh – tối ưu cho môi trường công sở
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
                <!-- Benefit 1 -->
                <div class="bg-white p-4 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl shadow-sm sm:shadow-md text-center flex flex-col items-center justify-center min-h-[140px] sm:min-h-[160px] hover:shadow-xl hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 bg-orange-100 rounded-full flex items-center justify-center mb-3 sm:mb-4">
                        <i data-lucide="utensils" class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 text-orange-500"></i>
                    </div>
                    <p class="font-medium text-xs sm:text-sm md:text-base leading-snug">Thực đơn đa dạng, không ngán mỗi ngày</p>
                </div>
                <!-- Benefit 2 -->
                <div class="bg-white p-4 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl shadow-sm sm:shadow-md text-center flex flex-col items-center justify-center min-h-[140px] sm:min-h-[160px] hover:shadow-xl hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 bg-green-100 rounded-full flex items-center justify-center mb-3 sm:mb-4">
                        <i data-lucide="shield-check" class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 text-green-500"></i>
                    </div>
                    <p class="font-medium text-xs sm:text-sm md:text-base leading-snug">An toàn vệ sinh, an tâm mỗi bữa ăn</p>
                </div>
                <!-- Benefit 3 -->
                <div class="bg-white p-4 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl shadow-sm sm:shadow-md text-center flex flex-col items-center justify-center min-h-[140px] sm:min-h-[160px] hover:shadow-xl hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 bg-blue-100 rounded-full flex items-center justify-center mb-3 sm:mb-4">
                        <i data-lucide="scale" class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 text-blue-500"></i>
                    </div>
                    <p class="font-medium text-xs sm:text-sm md:text-base leading-snug">Dinh dưỡng cân bằng, không gây buồn ngủ</p>
                </div>
                <!-- Benefit 4 -->
                <div class="bg-white p-4 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl shadow-sm sm:shadow-md text-center flex flex-col items-center justify-center min-h-[140px] sm:min-h-[160px] hover:shadow-xl hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 bg-emerald-100 rounded-full flex items-center justify-center mb-3 sm:mb-4">
                        <i data-lucide="leaf" class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 text-emerald-500"></i>
                    </div>
                    <p class="font-medium text-xs sm:text-sm md:text-base leading-snug">Ít dầu mỡ, tốt cho sức khỏe lâu dài</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== MÓN NỔI BẬT ===== -->
    <section class="bg-green-50 py-10 sm:py-12 md:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <h2 class="flex items-center justify-center gap-2 text-lg sm:text-2xl md:text-3xl font-bold mb-6 sm:mb-8 md:mb-10 text-center">
                <i data-lucide="sparkles" class="text-yellow-500 w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6"></i>
                <span>Món đặc biệt hôm nay</span>
            </h2>
            <div class="bg-white rounded-xl sm:rounded-2xl shadow-md sm:shadow-lg overflow-hidden flex flex-col md:flex-row">
                <div class="w-full md:w-1/2 aspect-[4/3] sm:aspect-[16/10] md:aspect-auto">
                    <img src="https://cdn.tgdd.vn/2021/03/CookProduct/30-1200x676-3.jpg" class="w-full h-full object-cover object-center transition duration-500 ease-in-out hover:scale-105" loading="lazy" />
                </div>
                <div class="p-4 sm:p-5 md:p-6 flex flex-col justify-center text-center md:text-left">
                    <h3 class="text-base sm:text-lg md:text-xl lg:text-2xl font-bold mb-2 text-green-600 leading-snug">
                        Bò bít tết
                    </h3>
                    <p class="text-gray-600 text-xs sm:text-sm md:text-base mb-3 leading-relaxed max-w-xl mx-auto md:mx-0">
                        Cân bằng dinh dưỡng, phù hợp dân văn phòng
                    </p>
                    <span class="text-[11px] sm:text-xs md:text-sm text-gray-400">Thực đơn thay đổi mỗi ngày</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== MEALS ===== -->
    <section class="bg-white py-12" x-data="{ tab: 'man' }">
        <div class="max-w-7xl mx-auto px-6">
            <h2 class="text-2xl md:text-4xl font-bold text-center mb-8">Chọn suất ăn</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <!-- LEFT -->
                <div class="md:col-span-2">
                    <!-- TAB -->
                    <div class="flex justify-center gap-4 mb-8">
                        <button x-on:click="tab = 'man'" :class="tab === 'man' ? 'bg-orange-500 text-white' : 'bg-gray-200'" class="px-6 py-2 rounded-full transition">Món mặn</button>
                        <button x-on:click="tab = 'chay'" :class="tab === 'chay' ? 'bg-green-600 text-white' : 'bg-gray-200'" class="px-6 py-2 rounded-full transition">Món chay</button>
                    </div>

                    <!-- GRID MẶN -->
                    <div x-show="tab === 'man'" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        <!-- Meal 1 -->
                        <div class="bg-white border rounded-xl overflow-hidden hover:shadow-lg transition">
                            <div class="relative">
                                <img src="https://thucphambinhduong.vn/wp-content/uploads/2025/02/R-4-e1740057763357.jpg" class="w-full h-[180px] object-cover" />
                            </div>
                            <div class="p-4 flex flex-col gap-3 min-h-[180px]">
                                <div class="flex justify-between items-center">
                                    <h3 class="font-semibold text-sm">Suất vp tiêu chuẩn</h3>
                                    <span class="text-orange-500 font-bold whitespace-nowrap">45,000đ</span>
                                </div>
                                <ul class="text-xs text-gray-600 space-y-1">
                                    <li>• Tôm rim, sườn nướng</li>
                                    <li>• đậu cà rốt xào</li>
                                    <li>• Canh chua</li>
                                    <li>• Dưa hấu</li>
                                </ul>
                                <button class="mt-auto bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600">Đặt suất</button>
                            </div>
                        </div>

                        <!-- Meal 2 -->
                        <div class="bg-white border rounded-xl overflow-hidden hover:shadow-lg transition">
                            <div class="relative">
                                <img src="https://lh7-us.googleusercontent.com/pVvDxvnsr_cW4Ty9nsqsKY7851OwdDWwh5uKJnVTGGvtsXHccyDlPXdVYTNpe8MUboZ3PaTESrnPGYLWMIyME5lvbGmn3eTuy9XXx64hYte1lVXpuqMUAis5a7NrnJ227qb5eLTqr2rXH7TmvkYpjDo" class="w-full h-[180px] object-cover" />
                            </div>
                            <div class="p-4 flex flex-col gap-3 min-h-[180px]">
                                <div class="flex justify-between items-center">
                                    <h3 class="font-semibold text-sm">Suất eat-clean</h3>
                                    <span class="text-orange-500 font-bold whitespace-nowrap">50,000đ</span>
                                </div>
                                <ul class="text-xs text-gray-600 space-y-1">
                                    <li>• Thịt heo luộc</li>
                                    <li>• chả cá hấp</li>
                                    <li>• Bí đỏ, cà rốt</li>
                                </ul>
                                <button class="mt-auto bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600">Đặt suất</button>
                            </div>
                        </div>

                         <!-- Meal 3 -->
                        <div class="bg-white border rounded-xl overflow-hidden hover:shadow-lg transition">
                            <div class="relative">
                                <img src="https://suatancongnghiepphumy.com/public/userfiles/services/30k/suat-an-cong-nghiep-30k-16.jpg" class="w-full h-[180px] object-cover" />
                            </div>
                            <div class="p-4 flex flex-col gap-3 min-h-[180px]">
                                <div class="flex justify-between items-center">
                                    <h3 class="font-semibold text-sm">Suất nhanh gọn</h3>
                                    <span class="text-orange-500 font-bold whitespace-nowrap">40,000đ</span>
                                </div>
                                <ul class="text-xs text-gray-600 space-y-1">
                                    <li>• Gà chiên, Xíu mại</li>
                                    <li>• Cải thìa xào</li>
                                    <li>• Canh bí đao</li>
                                    <li>• Chuối</li>
                                </ul>
                                <button class="mt-auto bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600">Đặt suất</button>
                            </div>
                        </div>
                    </div>

                    <!-- GRID CHAY -->
                    <div x-show="tab === 'chay'" style="display: none;" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div class="bg-white border rounded-xl overflow-hidden hover:shadow-lg transition">
                            <div class="p-4 flex flex-col gap-3 min-h-[180px]">
                                <div class="flex justify-between items-center">
                                    <h3 class="font-semibold text-sm">Suất chay văn phòng</h3>
                                    <span class="text-orange-500 font-bold whitespace-nowrap">38,000đ</span>
                                </div>
                                <ul class="text-xs text-gray-600 space-y-1">
                                    <li>• Đậu hũ sốt nấm</li>
                                    <li>• Canh rong biển</li>
                                </ul>
                                <button class="mt-auto bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600">Đặt suất</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT BÊN CHỌN ĐƠN -->
                <div>
                     <div class="bg-white rounded-xl shadow-lg border p-6 sticky top-24">
                        <h3 class="font-bold text-xl mb-4 border-b pb-2">Đơn của bạn</h3>
                        <div class="text-gray-500 text-sm text-center py-4">Chưa có suất ăn nào được chọn</div>
                        <div class="border-t mt-4 pt-4 flex justify-between font-bold text-lg">
                            <span>Tổng tiền:</span>
                            <span class="text-orange-500">0đ</span>
                        </div>
                        <button class="w-full bg-orange-500 text-white py-3 rounded-xl mt-6 font-bold hover:bg-orange-600 hover:shadow-lg transition">THANH TOÁN</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="relative h-[320px] overflow-hidden">
        <img src="/assets/images/s4.jpg" class="absolute inset-0 w-full h-full object-cover object-center scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-transparent"></div>
        <div class="relative z-10 h-full flex flex-col justify-center px-10 md:px-20">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">Bạn cần tư vấn về suất ăn cho nhân viên văn phòng?</h2>
            <p class="text-gray-200 mb-6">HAPPYSPOON luôn sẵn sàng đồng hành.</p>
            <a href="/Customer/Contact" class="w-fit">
                <button class="bg-orange-500 hover:bg-orange-600 transition text-white px-6 py-3 rounded-full font-semibold">TƯ VẤN 1-1 MIỄN PHÍ</button>
            </a>
        </div>
    </section>
</div>
