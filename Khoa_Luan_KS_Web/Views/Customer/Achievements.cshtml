@{
    ViewData["Title"] = "Thành tựu nổi bật";
    Layout = "_LayoutCustomer";
}

<div class="w-full bg-gray-100 min-h-screen">
    <!-- ================= BREADCRUMB ================= -->
    <div class="max-w-7xl mx-auto px-6 py-6 flex items-center gap-2 text-sm text-gray-500">
        <a href="/Customer" class="hover:text-black">Trang chủ</a>
        <i data-lucide="chevron-right" style="width:16px;height:16px"></i>
        <span class="text-black font-medium">Thành tựu nổi bật</span>
    </div>

    <!-- ================= INTRO ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-10 sm:pb-14 md:pb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 items-stretch">
            <div class="overflow-hidden rounded-lg h-[220px] sm:h-[280px] md:h-auto">
                <img src="/assets/images/bannervechungtoi.jpg" class="w-full h-full object-cover" />
            </div>
            <div class="bg-[#2b2b2b] text-white p-5 sm:p-7 md:p-10 rounded-lg flex flex-col justify-center">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4 md:mb-6 leading-tight">
                    <span class="bg-yellow-400 text-black px-2 sm:px-3 py-1 mr-2 inline-block">Thành tựu</span>
                    Haseca
                </h2>
                <p class="text-yellow-400 italic mb-3 md:mb-4 text-sm sm:text-base">
                    “...mạng lưới đối tác rộng khắp, trải dài trên toàn lãnh thổ Việt Nam....”
                </p>
                <p class="text-gray-300 text-sm sm:text-base leading-relaxed md:text-justify">
                    Bằng sự tận tâm, thái độ chuyên nghiệp và dịch vụ chất lượng cao, HASECA đã chinh phục nhiều doanh nghiệp, tập đoàn lớn. Hành trình hơn 15 năm mang đến cho HASECA mạng lưới đối tác rộng khắp, trải dài trên toàn lãnh thổ Việt Nam.
                </p>
            </div>
        </div>
    </section>

    <!-- ================= TIMELINE TITLE ================= -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16">
        <h2 class="text-center text-2xl sm:text-3xl md:text-4xl font-bold mb-10">
            <span class="bg-yellow-400 text-black px-3 sm:px-4 py-1 mr-2 inline-block">Cột mốc</span> HASECA
        </h2>
    </div>

    <!-- ================= TIMELINE ================= -->
    <section class="w-full py-16 sm:py-20 relative overflow-hidden">
        <img src="/assets/images/thanhtuu.jpg" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/60"></div>
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6">
            <div class="hidden md:block absolute left-1/2 top-10 bottom-10 w-[2px] bg-white/30 -translate-x-1/2"></div>
            <div class="space-y-12 sm:space-y-16 md:space-y-24">
                
                <!-- 2009 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pr-10 md:text-right">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Khởi đầu</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <p>Công ty Cổ phần Dịch vụ Hà Thành ra đời vào ngày 12/12/2009 với 10 nhân sự và công suất 200 suất ăn/ngày.</p>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2009</div>
                </div>

                <!-- 2017 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pl-10 md:ml-auto md:text-left">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Chất lượng HASECA</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <ul class="list-disc pl-5 space-y-1">
                                    <li>Công ty đổi tên thành Công ty Dịch vụ Quốc tế Hà Thành (HASECA) vào tháng 6/2017 với đội ngũ 356 nhân sự, phục vụ 30 khách hàng và cung ứng 24.000 suất ăn/ngày.</li>
                                    <li>Đạt Chứng nhận Hệ thống quản lý an toàn thực phẩm quốc tế tiêu chuẩn ISO 22000:2005.</li>
                                    <li>Được Chi cục An toàn vệ sinh thực phẩm Hà Nội cấp Chứng nhận Cơ sở đủ điều kiện an toàn thực phẩm.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2017</div>
                </div>

                 <!-- 2018 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pr-10 md:text-right">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Khẳng định vị thế</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <p>HASECA là đối tác cung cấp suất ăn cho 2 tập đoàn lớn: Vinfast, Bridgestone Việt Nam.</p>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2018</div>
                </div>

                <!-- 2019 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pl-10 md:ml-auto md:text-left">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Tăng trưởng</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <ul class="list-disc pl-5 space-y-1">
                                    <li>Trở thành doanh nghiệp cung cấp suất ăn công nghiệp và cơm văn phòng hàng đầu miền Bắc.</li>
                                    <li>Cán mốc 500+ nhân viên, phục vụ 40.000+ suất ăn/ ngày cho 40+ khách hàng.</li>
                                    <li>Xây dựng quy trình làm việc chuyên nghiệp, minh bạch, mạng lưới đối tác rộng khắp.</li>
                                    <li>Vinh dự được Đài truyền hình Việt Nam lựa chọn là doanh nghiệp tiêu biểu về vệ sinh an toàn thực phẩm, và đưa tin trong chương trình “Doanh nghiệp với trách nhiệm xã hội”, phát sóng trên VTV1 lúc 14h30, ngày 27/4/2019.</li>
                                    <li>Hợp tác với Beet Innovators ứng dụng trí tuệ nhân tạo AI vào công tác quản lý.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2019</div>
                </div>

                 <!-- 2021 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pr-10 md:text-right">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Mở rộng</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                 <ul class="list-disc pl-5 space-y-1">
                                    <li>HASECA đã có mặt tại 37 tỉnh thành và có kế hoạch phủ hơn 40 tỉnh thành trong năm.</li>
                                    <li>Sở hữu hơn 1.500 nhân viên, phục vụ 130.000 suất ăn mỗi ngày cho hơn 80 khách hàng.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2021</div>
                </div>

                <!-- 2022 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pl-10 md:ml-auto md:text-left">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Khát vọng vươn xa</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <ul class="list-disc pl-5 space-y-1">
                                    <li>Xây dựng hệ thống thực đơn phong phú 40 ngày không trùng lặp. Mở 80 bếp ăn từ Bắc vào Nam.</li>
                                    <li>Phát triển quy mô nhân sự lên đến 1.600 nhân viên. Doanh thu tăng 80% so với năm 2021.</li>
                                    <li>Với hàng loạt các giải thưởng Quốc gia tầm cỡ:</li>
                                    <li>Doanh nghiệp có sản phẩm đạt thương hiệu quốc gia Việt Nam.</li>
                                    <li>Doanh nhân trẻ Thăng Long và doanh nhân trẻ thủ đô tiêu biểu năm 2022.</li>
                                    <li>Giải thưởng Sao đỏ - Doanh nhân trẻ Việt Nam tiêu biểu 2022.</li>
                                    <li>Doanh nhân, Doanh nghiệp có đóng góp có phong trào hội doanh nghiệp trẻ Hà Nội.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2022</div>
                </div>
                
                 <!-- 2023 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pr-10 md:text-right">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Vững tâm vượt sóng lớn</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <ul class="list-disc pl-5 space-y-1">
                                    <li>Phát triển quy mô nhân sự lên đến 2.300 nhân viên.</li>
                                    <li>Tổng số lượng suất ăn phục vụ lên đến 200.000 suất ăn/ngày.</li>
                                    <li>Khai trương văn phòng với diện tích 800 m2.</li>
                                    <li>Ứng dụng công nghệ 4.0 vào quản lý nhân sự chuyên biệt.</li>
                                    <li>Phát triển hệ thống phần mềm đào tạo online và offline.</li>
                                    <li>Ra mắt thành công APP IZII - ứng dụng đặt thực đơn.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2023</div>
                </div>

                <!-- 2024 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pl-10 md:ml-auto md:text-left">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Phát triển</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <ul class="list-disc pl-5 space-y-1">
                                    <li>Có măt trên 45 tỉnh thành.</li>
                                    <li>Tăng trưởng trên 40% so với năm 2023.</li>
                                    <li>Xây dựng và tái cơ cấu hoàn thiện bộ máy hoạt động năng động và chuyên môn hơn.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2024</div>
                </div>

                <!-- 2025 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pr-10 md:text-right">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Tăng trưởng mạnh</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <ul class="list-disc pl-5 space-y-1">
                                    <li>Tăng trưởng 50% so với năm 2024, với tổng 120 điểm bếp toàn quốc.</li>
                                    <li>Phát triển hơn 8 hệ thống trường học với 150.000 suất/ngày.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2025</div>
                </div>

                <!-- 2026 -->
                <div class="relative flex flex-col md:flex-row items-center">
                    <div class="w-full md:w-1/2 md:pl-10 md:ml-auto md:text-left">
                        <div class="bg-white/95 p-4 sm:p-6 rounded-xl shadow-xl text-left">
                            <h3 class="text-lg sm:text-xl font-bold mb-2">Mở rộng hệ sinh thái</h3>
                            <div class="text-gray-600 text-sm sm:text-base">
                                <ul class="list-disc pl-5 space-y-1">
                                    <li>Phát triển các thương hiệu trọng điểm gồm suất ăn trường học HappySpoon, thực phẩm sạch Phù Sa và canteen – quầy nước Hcafe, hoàn thiện chuỗi cung ứng khép kín.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-400 rounded-full"></div>
                    <div class="mt-2 md:mt-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:-top-6 text-yellow-400 font-bold text-sm sm:text-base">2026</div>
                </div>

            </div>
        </div>
    </section>

    <!-- ================= CERTIFICATES ================= -->
    <section class="py-20 bg-white" x-data="{ selectedImage: null }">
        <div class="max-w-7xl mx-auto px-6">
            <h2 class="text-center text-4xl font-bold mb-16">
                <span class="bg-yellow-400 px-4 py-1">Chứng chỉ, Chứng nhận</span> Haseca
            </h2>
            <div class="grid md:grid-cols-2 gap-16">
                 <!-- C1 -->
                <div class="flex items-center gap-6">
                    <img src="/assets/images/cn1.jpg" class="w-[80px] h-[110px] object-cover rounded shadow" />
                    <div>
                        <h3 class="font-semibold mb-2">Chứng nhận đăng kí doanh nghiệp công ty cổ phần</h3>
                        <button x-on:click="selectedImage = '/assets/images/cn1.jpg'" class="text-orange-500 hover:underline">Xem chứng nhận →</button>
                    </div>
                </div>
                 <!-- C2 -->
                <div class="flex items-center gap-6">
                    <img src="/assets/images/cn2.jpg" class="w-[80px] h-[110px] object-cover rounded shadow" />
                    <div>
                        <h3 class="font-semibold mb-2">Giấy chứng nhận bảo hiểm trách nhiệm sản phẩm</h3>
                        <button x-on:click="selectedImage = '/assets/images/cn2.jpg'" class="text-orange-500 hover:underline">Xem chứng nhận →</button>
                    </div>
                </div>
                 <!-- C3 -->
                <div class="flex items-center gap-6">
                    <img src="/assets/images/cn3.jpg" class="w-[80px] h-[110px] object-cover rounded shadow" />
                    <div>
                        <h3 class="font-semibold mb-2">Chứng nhận cơ sở đủ điều kiện an toàn thực phẩm</h3>
                        <button x-on:click="selectedImage = '/assets/images/cn3.jpg'" class="text-orange-500 hover:underline">Xem chứng nhận →</button>
                    </div>
                </div>
                 <!-- C4 -->
                <div class="flex items-center gap-6">
                    <img src="/assets/images/cn4.jpg" class="w-[80px] h-[110px] object-cover rounded shadow" />
                    <div>
                        <h3 class="font-semibold mb-2">Chứng nhận hệ thống quản lý an toàn thực phẩm</h3>
                        <button x-on:click="selectedImage = '/assets/images/cn4.jpg'" class="text-orange-500 hover:underline">Xem chứng nhận →</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- IMAGE MODAL -->
        <div x-show="selectedImage !== null" style="display: none;" class="fixed inset-0 z-[9999] bg-black/90 flex items-center justify-center p-4">
            <div class="absolute inset-0" x-on:click="selectedImage = null"></div>
            <img :src="selectedImage" class="relative z-10 w-auto h-auto max-w-[95vw] max-h-[95vh] object-contain rounded-lg shadow-2xl" />
            <button x-on:click="selectedImage = null" class="absolute top-5 right-5 text-white text-3xl font-bold z-20">✕</button>
        </div>
    </section>
</div>
