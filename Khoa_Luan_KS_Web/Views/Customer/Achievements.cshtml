@{
    ViewData["Title"] = "Thành tựu nổi bật - HuitMeal";
    Layout = "_LayoutCustomer";
}

<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeInUp {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .animation-delay-200 { animation-delay: 0.2s; }
    .animation-delay-400 { animation-delay: 0.4s; }

    .glass-title {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .timeline-line {
        background: linear-gradient(to bottom, transparent, #fbbf24, #ef4444, #fbbf24, transparent);
    }
</style>

<div class="w-full bg-white overflow-hidden">
    <!-- HERO SECTION -->
    <section class="relative h-[400px] md:h-[600px] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0">
            <img src="/assets/images/achievements_hero.png" alt="Achievements Hero" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/40 to-white"></div>
        </div>
        
        <div class="relative z-10 text-center px-4 animate-fadeInUp">
            <span class="inline-block px-4 py-1.5 mb-6 text-xs font-bold tracking-[0.2em] uppercase text-white glass-title rounded-full">Hành trình vươn xa</span>
            <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-4">
                Thành Tựu <span class="text-yellow-400">Nổi Bật</span>
            </h1>
            <p class="text-gray-200 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed">
                Hơn 15 năm kiến tạo giá trị và khẳng định vị thế dẫn đầu trong lĩnh vực 
                cung ứng suất ăn công nghiệp tại Việt Nam.
            </p>
        </div>
    </section>

    <!-- IMPACT STATS BAR -->
    <section class="max-w-7xl mx-auto px-4 -mt-16 relative z-20 mb-24">
        <div class="bg-white rounded-[40px] shadow-[0_20px_60px_rgba(0,0,0,0.1)] p-8 md:p-12 border border-gray-100">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 divide-x-0 lg:divide-x divide-gray-100">
                <div class="text-center px-4">
                    <div class="text-3xl md:text-5xl font-black text-red-600 mb-2">15+</div>
                    <div class="text-gray-400 text-xs md:text-sm font-bold uppercase tracking-widest">Năm Kinh Nghiệm</div>
                </div>
                <div class="text-center px-4">
                    <div class="text-3xl md:text-5xl font-black text-red-600 mb-2">200K+</div>
                    <div class="text-gray-400 text-xs md:text-sm font-bold uppercase tracking-widest">Suất Ăn/Ngày</div>
                </div>
                <div class="text-center px-4">
                    <div class="text-3xl md:text-5xl font-black text-red-600 mb-2">120+</div>
                    <div class="text-gray-400 text-xs md:text-sm font-bold uppercase tracking-widest">Điểm Bếp Toàn Quốc</div>
                </div>
                <div class="text-center px-4">
                    <div class="text-3xl md:text-5xl font-black text-red-600 mb-2">2300+</div>
                    <div class="text-gray-400 text-xs md:text-sm font-bold uppercase tracking-widest">Cán Bộ Nhân Viên</div>
                </div>
            </div>
        </div>
    </section>

    <!-- JOURNEY TIMELINE -->
    <section class="py-24 relative bg-gray-50/50">
        <div class="max-w-7xl mx-auto px-4 relative">
            <div class="text-center mb-24 animate-fadeInUp">
                <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight">Cột Mốc Phát Triển</h2>
                <div class="w-24 h-1.5 bg-yellow-400 mx-auto rounded-full"></div>
            </div>

            <!-- Timeline Main Line -->
            <div class="absolute left-1/2 top-48 bottom-24 w-1 timeline-line -translate-x-1/2 hidden lg:block"></div>

            <div class="space-y-24 md:space-y-32">
                <!-- 2009: Khởi đầu -->
                <div class="relative flex flex-col lg:flex-row items-center animate-fadeInUp">
                    <div class="lg:w-1/2 lg:pr-24 lg:text-right order-2 lg:order-1">
                        <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-500">
                            <h3 class="text-2xl font-bold text-gray-900 mb-4">Khởi đầu khát vọng</h3>
                            <p class="text-gray-500 leading-relaxed text-sm">
                                Công ty Cổ phần Dịch vụ Hà Thành ra đời với 10 nhân sự tâm huyết, phục vụ những suất ăn đầu tiên với công suất 200 suất/ngày.
                            </p>
                        </div>
                    </div>
                    <div class="w-16 h-16 bg-white border-4 border-yellow-400 rounded-full flex items-center justify-center z-10 mb-8 lg:mb-0 order-1 lg:order-2 shadow-lg">
                        <span class="text-xs font-black text-gray-900">2009</span>
                    </div>
                    <div class="lg:w-1/2 lg:pl-24 order-3">
                        <img src="/assets/images/bannervechungtoi.jpg" class="rounded-[40px] shadow-2xl h-48 w-full object-cover" />
                    </div>
                </div>

                <!-- 2017: Chất lượng -->
                <div class="relative flex flex-col lg:flex-row items-center animate-fadeInUp">
                    <div class="lg:w-1/2 lg:pr-24 order-3 lg:order-1">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="p-6 bg-red-600 rounded-[30px] text-white">
                                <div class="text-2xl font-black mb-1">356</div>
                                <div class="text-[10px] uppercase font-bold opacity-80">Nhân sự</div>
                            </div>
                            <div class="p-6 bg-gray-900 rounded-[30px] text-white">
                                <div class="text-2xl font-black mb-1">24K</div>
                                <div class="text-[10px] uppercase font-bold opacity-80">Suất ăn/ngày</div>
                            </div>
                        </div>
                    </div>
                    <div class="w-16 h-16 bg-white border-4 border-red-600 rounded-full flex items-center justify-center z-10 mb-8 lg:mb-0 order-1 lg:order-2 shadow-lg">
                        <span class="text-xs font-black text-gray-900">2017</span>
                    </div>
                    <div class="lg:w-1/2 lg:pl-24 order-2 lg:order-3">
                        <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-500">
                            <h3 class="text-2xl font-bold text-gray-900 mb-4">Dấu ấn HuitMeal</h3>
                            <p class="text-gray-500 leading-relaxed text-sm mb-4">
                                Đổi tên thương hiệu thành HUITMEAL, đạt chứng nhận ISO 22:2005 quốc tế, khẳng định tiêu chuẩn an toàn thực phẩm vượt trội.
                            </p>
                            <div class="flex gap-2">
                                <span class="px-3 py-1 bg-gray-50 text-[10px] font-bold text-gray-400 rounded-full border border-gray-100 uppercase">ISO 22000</span>
                                <span class="px-3 py-1 bg-gray-50 text-[10px] font-bold text-gray-400 rounded-full border border-gray-100 uppercase">FSSC 22000</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2019: Tăng trưởng -->
                <div class="relative flex flex-col lg:flex-row items-center animate-fadeInUp">
                    <div class="lg:w-1/2 lg:pr-24 lg:text-right order-2 lg:order-1">
                        <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-500">
                            <h3 class="text-2xl font-bold text-gray-900 mb-4">Bứt phá công nghệ</h3>
                            <p class="text-gray-500 leading-relaxed text-sm mb-6">
                                Tiên phong ứng dụng trí tuệ nhân tạo AI vào quản trị. Vinh dự được VTV1 vinh danh là doanh nghiệp tiêu biểu về trách nhiệm xã hội.
                            </p>
                            <div class="inline-flex items-center gap-3 px-4 py-2 bg-red-50 text-red-600 rounded-2xl text-xs font-bold">
                                <i data-lucide="play-circle" class="w-4 h-4"></i>
                                PHÁT SÓNG VTV1
                            </div>
                        </div>
                    </div>
                    <div class="w-16 h-16 bg-white border-4 border-yellow-400 rounded-full flex items-center justify-center z-10 mb-8 lg:mb-0 order-1 lg:order-2 shadow-lg">
                        <span class="text-xs font-black text-gray-900">2019</span>
                    </div>
                    <div class="lg:w-1/2 lg:pl-24 order-3">
                        <div class="relative rounded-[40px] overflow-hidden group shadow-2xl h-48">
                            <img src="/assets/images/thanhtuu.jpg" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <i data-lucide="maximize-2" class="text-white w-8 h-8"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2023-2026: Vươn tầm -->
                <div class="relative flex flex-col lg:flex-row items-center animate-fadeInUp">
                    <div class="lg:w-1/2 lg:pr-24 order-3 lg:order-1">
                        <div class="bg-gray-900 p-10 rounded-[40px] text-white">
                            <h4 class="text-xl font-bold mb-6 text-yellow-400">Tầm nhìn 2026</h4>
                            <ul class="space-y-4 text-xs text-gray-400">
                                <li class="flex gap-4"><i data-lucide="check-circle" class="w-4 h-4 text-yellow-400"></i> Phủ sóng 45+ tỉnh thành toàn quốc.</li>
                                <li class="flex gap-4"><i data-lucide="check-circle" class="w-4 h-4 text-yellow-400"></i> Ra mắt hệ sinh thái HappySpoon & HCafe.</li>
                                <li class="flex gap-4"><i data-lucide="check-circle" class="w-4 h-4 text-yellow-400"></i> Hoàn thiện chuỗi cung ứng khép kín.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="w-16 h-16 bg-white border-4 border-red-600 rounded-full flex items-center justify-center z-10 mb-8 lg:mb-0 order-1 lg:order-2 shadow-lg">
                        <span class="text-xs font-black text-gray-900">2026</span>
                    </div>
                    <div class="lg:w-1/2 lg:pl-24 order-2 lg:order-3">
                        <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-500">
                            <h3 class="text-2xl font-bold text-gray-900 mb-4">Kiến tạo hệ sinh thái</h3>
                            <p class="text-gray-500 leading-relaxed text-sm">
                                Cán mốc 200.000 suất ăn/ngày. Ra mắt ứng dụng IZII - tiên phong trong trải nghiệm đặt suất ăn số hóa tại Việt Nam.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CERTIFICATES GALLERY -->
    <section class="py-32 bg-white" x-data="{ selectedImage: null }">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-24">
                <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight">Chứng Chỉ & Pháp Lý</h2>
                <p class="text-gray-400 max-w-xl mx-auto">Cam kết tuân thủ nghiêm ngặt các tiêu chuẩn quốc tế cao nhất về an toàn thực phẩm.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- C1 -->
                <div class="group cursor-pointer animate-fadeInUp" x-on:click="selectedImage = '/assets/images/cn1.jpg'">
                    <div class="bg-gray-50 rounded-[32px] p-4 mb-6 group-hover:bg-red-50 transition-colors">
                        <div class="relative aspect-[3/4] rounded-2xl overflow-hidden shadow-lg">
                            <img src="/assets/images/cn1.jpg" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <i data-lucide="eye" class="text-white w-8 h-8"></i>
                            </div>
                        </div>
                    </div>
                    <h3 class="text-center font-bold text-gray-800 text-sm px-4 group-hover:text-red-600 transition-colors">Đăng ký doanh nghiệp</h3>
                </div>

                <!-- C2 -->
                <div class="group cursor-pointer animate-fadeInUp animation-delay-200" x-on:click="selectedImage = '/assets/images/cn2.jpg'">
                    <div class="bg-gray-50 rounded-[32px] p-4 mb-6 group-hover:bg-red-50 transition-colors">
                        <div class="relative aspect-[3/4] rounded-2xl overflow-hidden shadow-lg">
                            <img src="/assets/images/cn2.jpg" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <i data-lucide="eye" class="text-white w-8 h-8"></i>
                            </div>
                        </div>
                    </div>
                    <h3 class="text-center font-bold text-gray-800 text-sm px-4 group-hover:text-red-600 transition-colors">Bảo hiểm trách nhiệm</h3>
                </div>

                <!-- C3 -->
                <div class="group cursor-pointer animate-fadeInUp animation-delay-400" x-on:click="selectedImage = '/assets/images/cn3.jpg'">
                    <div class="bg-gray-50 rounded-[32px] p-4 mb-6 group-hover:bg-red-50 transition-colors">
                        <div class="relative aspect-[3/4] rounded-2xl overflow-hidden shadow-lg">
                            <img src="/assets/images/cn3.jpg" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <i data-lucide="eye" class="text-white w-8 h-8"></i>
                            </div>
                        </div>
                    </div>
                    <h3 class="text-center font-bold text-gray-800 text-sm px-4 group-hover:text-red-600 transition-colors">Vệ sinh ATTP</h3>
                </div>

                <!-- C4 -->
                <div class="group cursor-pointer animate-fadeInUp" x-on:click="selectedImage = '/assets/images/cn4.jpg'">
                    <div class="bg-gray-50 rounded-[32px] p-4 mb-6 group-hover:bg-red-50 transition-colors">
                        <div class="relative aspect-[3/4] rounded-2xl overflow-hidden shadow-lg">
                            <img src="/assets/images/cn4.jpg" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <i data-lucide="eye" class="text-white w-8 h-8"></i>
                            </div>
                        </div>
                    </div>
                    <h3 class="text-center font-bold text-gray-800 text-sm px-4 group-hover:text-red-600 transition-colors">Hệ thống ISO 22000</h3>
                </div>
            </div>
        </div>

        <!-- IMAGE MODAL (Alpine JS) -->
        <template x-teleport="body">
            <div x-show="selectedImage !== null" 
                 x-transition.opacity.duration.300ms
                 class="fixed inset-0 z-[9999] bg-black/95 flex items-center justify-center p-6 backdrop-blur-sm"
                 style="display: none;">
                <div class="absolute inset-0 cursor-zoom-out" x-on:click="selectedImage = null"></div>
                
                <div class="relative z-10 max-w-4xl w-full flex flex-col items-center">
                    <button x-on:click="selectedImage = null" class="absolute -top-12 right-0 text-white hover:text-red-500 transition-colors">
                        <i data-lucide="x" class="w-8 h-8"></i>
                    </button>
                    <img :src="selectedImage" 
                         x-transition.scale.duration.300ms
                         class="rounded-2xl shadow-2xl max-h-[85vh] w-auto object-contain border border-white/10" />
                </div>
            </div>
        </template>
    </section>

    <!-- CALL TO ACTION -->
    <section class="py-24 bg-red-600 relative overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <img src="/assets/images/achievements_hero.png" class="w-full h-full object-cover" />
        </div>
        <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-8">Đồng hành cùng đối tác chiến lược</h2>
            <p class="text-white/80 text-lg mb-12">HuitMeal sẵn sàng mang giải pháp suất ăn chuyên nghiệp đến doanh nghiệp của bạn.</p>
            <a href="/Customer/Contact" class="inline-block px-12 py-5 bg-white text-red-600 font-black rounded-2xl hover:shadow-2xl hover:-translate-y-1 transition-all uppercase tracking-widest">Liên hệ ngay</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
