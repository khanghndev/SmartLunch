@{
    ViewData["Title"] = "Chi tiết suất ăn";
    Layout = "_LayoutCustomer";
}

<div class="bg-gray-50 font-sans pb-20">
    <!-- Breadcrumb -->
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center gap-2 text-sm text-gray-500">
            <a href="/Customer" class="hover:text-orange-500 transition">Trang chủ</a>
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
            <a href="/Customer/Office" class="hover:text-orange-500 transition">Suất ăn công nghiệp</a>
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
            <span class="text-gray-900 font-medium">Bò lúc lắc hạt điều & Súp bí đỏ</span>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 mt-8">
        
        <!-- Top Section: Slideshow & Info -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 md:p-10 mb-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
            
            <!-- Left: Slideshow (Alpine.js) -->
            <div x-data="{ 
                activeSlide: 0, 
                slides: [
                    'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=800',
                    'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?q=80&w=800',
                    'https://images.unsplash.com/photo-1628840042765-356cda07504e?q=80&w=800',
                    'https://images.unsplash.com/photo-1543339308-43e59d6b73a6?q=80&w=800'
                ] 
            }" class="flex flex-col gap-4">
                
                <!-- Main Image -->
                <div class="w-full h-[300px] md:h-[450px] rounded-2xl overflow-hidden relative border border-gray-100 shadow-sm">
                    <img :src="slides[activeSlide]" class="w-full h-full object-cover transition-all duration-500" alt="Món ăn">
                    <div class="absolute top-4 left-4 bg-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-md uppercase tracking-wider">
                        ISO 22000:2018
                    </div>
                </div>

                <!-- Thumbnails -->
                <div class="grid grid-cols-4 gap-4">
                    <template x-for="(slide, index) in slides" :key="index">
                        <div x-on:click="activeSlide = index" 
                             :class="activeSlide === index ? 'ring-2 ring-orange-500 opacity-100' : 'opacity-60 hover:opacity-100'"
                             class="h-20 md:h-24 rounded-xl overflow-hidden cursor-pointer transition-all border border-gray-200">
                            <img :src="slide" class="w-full h-full object-cover">
                        </div>
                    </template>
                </div>
            </div>

            <!-- Right: Details -->
            <div class="flex flex-col">
                <div class="mb-6">
                     <div class="flex items-center gap-2 mb-3">
                        <span class="bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-md uppercase">Bán chạy nhất</span>
                        <span class="bg-blue-100 text-blue-600 text-xs font-bold px-2.5 py-1 rounded-md uppercase">Văn phòng</span>
                     </div>
                     <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight mb-2">Suất Tràn Năng Lượng: Bò lúc lắc hạt điều</h1>
                     <p class="text-2xl font-black text-orange-500">55,000 <span class="text-lg font-medium text-gray-500 line-through ml-2">65,000</span></p>
                </div>

                <p class="text-gray-600 text-base md:text-lg leading-relaxed mb-8">
                    Suất ăn được các chuyên gia dinh dưỡng HuitMeal thiết kế riêng cho người lao động trí óc cường độ cao. Đảm bảo nạp đủ năng lượng tức thì, bổ sung omega-3 từ hạt điều và vitamin từ bí đỏ giúp mắt và trí não hoạt động tối đa mà không gây cảm giác đầy bụng, buồn ngủ.
                </p>

                <!-- Nutrition Core -->
                <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-100">
                    <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i data-lucide="zap" class="w-5 h-5 text-yellow-500"></i> Hàm lượng dinh dưỡng ước tính
                    </h3>
                    <div class="grid grid-cols-4 gap-4 text-center">
                        <div>
                            <div class="text-2xl font-black text-gray-800">650</div>
                            <div class="text-xs text-gray-500 uppercase font-semibold">Kcal</div>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-green-600">38<span class="text-lg">g</span></div>
                            <div class="text-xs text-gray-500 uppercase font-semibold">Protein</div>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-orange-500">15<span class="text-lg">g</span></div>
                            <div class="text-xs text-gray-500 uppercase font-semibold">Lipid (Béo)</div>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-blue-500">75<span class="text-lg">g</span></div>
                            <div class="text-xs text-gray-500 uppercase font-semibold">Carbs</div>
                        </div>
                    </div>
                </div>

                <!-- Features -->
                <ul class="space-y-3 mb-10 text-gray-700 font-medium text-sm md:text-base">
                    <li class="flex items-center gap-3"><i data-lucide="check-circle-2" class="w-5 h-5 text-green-500"></i> Không sủ dụng chất tạo nạc, màu thực phẩm tổng hợp.</li>
                    <li class="flex items-center gap-3"><i data-lucide="check-circle-2" class="w-5 h-5 text-green-500"></i> Khay phân khẩu phần cách nhiệt an toàn sức khỏe.</li>
                    <li class="flex items-center gap-3"><i data-lucide="check-circle-2" class="w-5 h-5 text-green-500"></i> Trái cây tráng miệng gọt sẵn tiệt trùng.</li>
                </ul>

                <a href="/Customer/Contact" class="bg-orange-500 hover:bg-orange-600 text-white font-bold text-lg py-4 rounded-xl text-center shadow-[0_10px_20px_rgba(249,115,22,0.3)] hover:shadow-[0_10px_25px_rgba(249,115,22,0.5)] hover:-translate-y-1 transition-all">
                    LIÊN HỆ ĐẶT SUẤT CÔNG TY BẠN NGAY
                </a>
            </div>
        </div>

        <!-- Details Tabs -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Khoản Left: Info & Chef -->
            <div class="lg:col-span-2 space-y-8">
                
                <!-- Thành phần món ăn -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 border-b pb-4">Cấu trúc thực đơn trong mô hình này</h2>
                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0 border"><img src="https://images.unsplash.com/photo-1600891964092-4316c288032e?q=80&w=200" class="w-full h-full object-cover"></div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-lg">Món chính: Bò úc lúc lắc hạt điều</h4>
                                <p class="text-gray-600 text-sm mt-1">Sử dụng thăn bò nhập khẩu Úc, cắt hạt lựu lớn ướp dầu hào, xào lửa lớn với ớt chuông baby và hạt điều Bình Phước rang bơ.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0 border"><img src="https://images.unsplash.com/photo-1525351484163-f51652bb2731?q=80&w=200" class="w-full h-full object-cover"></div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-lg">Món nướng/chiên: Trứng ốp la viền giòn</h4>
                                <p class="text-gray-600 text-sm mt-1">Trứng gà ta loại 1, chiên trên chảo chống dính rắc thêm chút tiêu sọ đen.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0 border"><img src="https://images.unsplash.com/photo-1540420773420-3366772f4999?q=80&w=200" class="w-full h-full object-cover"></div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-lg">Món rau: Salad dầu giấm ngô ngọt</h4>
                                <p class="text-gray-600 text-sm mt-1">Xà lách thủy tinh, cà chua bi, dưa chuột baby mix ngô ngọt xốt dầu giấm hoa quả.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0 border"><img src="https://images.unsplash.com/photo-1547592166-23ac45744acd?q=80&w=200" class="w-full h-full object-cover"></div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-lg">Món canh: Súp bí đỏ cốt dừa</h4>
                                <p class="text-gray-600 text-sm mt-1">Bí đỏ nướng hầm nhừ xay nhuyễn cùng nước cốt dừa và kem tươi, vị ngọt tự nhiên không đường tinh luyện.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nguồn gốc nguyên liệu -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 border-b pb-4">Truy xuất nguồn gốc nguyên liệu</h2>
                    <p class="text-gray-600 mb-6">
                        Tại HuitMeal, sự cam kết vững vàng nhất là sự minh bạch về nguồn gốc. Mỗi khay ăn được dọn ra đều từ những nguyên liệu có đầy đủ giấy chứng nhận Vệ Sinh An Toàn Thực Phẩm do bộ Y Tế cấp:
                    </p>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <li class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex gap-3">
                            <i data-lucide="scan-barcode" class="w-6 h-6 text-gray-400"></i>
                            <div><strong class="block text-sm text-gray-900">Thịt Bò Úc</strong><span class="text-xs text-gray-500">Đối tác: MeatDeli VN</span></div>
                        </li>
                        <li class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex gap-3">
                            <i data-lucide="scan-barcode" class="w-6 h-6 text-gray-400"></i>
                            <div><strong class="block text-sm text-gray-900">Rau củ hữu cơ</strong><span class="text-xs text-gray-500">Nông trại: VietGAP Mộc Châu</span></div>
                        </li>
                        <li class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex gap-3">
                            <i data-lucide="scan-barcode" class="w-6 h-6 text-gray-400"></i>
                            <div><strong class="block text-sm text-gray-900">Gạo ST25</strong><span class="text-xs text-gray-500">Tổng kho Nông sản Vĩnh Long</span></div>
                        </li>
                        <li class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex gap-3">
                            <i data-lucide="scan-barcode" class="w-6 h-6 text-gray-400"></i>
                            <div><strong class="block text-sm text-gray-900">Dầu ăn & Gia vị</strong><span class="text-xs text-gray-500">Tường An, Ajinomoto VN</span></div>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Khoản Right: Chef & Trust -->
            <div class="space-y-8">
                <!-- Hồ sơ đầu bếp -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 text-center">
                    <h2 class="text-lg font-bold text-gray-900 mb-6 uppercase tracking-wider text-left">Đầu bếp chế biến</h2>
                    <div class="w-32 h-32 rounded-full overflow-hidden mx-auto mb-4 border-4 border-orange-100 shadow-inner">
                        <img src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?q=80&w=400" class="w-full h-full object-cover">
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-1">Chef. Trần Văn Thịnh</h3>
                    <p class="text-orange-500 font-medium text-sm mb-4">Bếp trưởng Điều hành khối Văn phòng</p>
                    <p class="text-gray-600 text-sm leading-relaxed mb-6 italic">
                        "Mỗi bữa ăn tại HuitMeal không chỉ là no bụng mà là sự phục hồi năng lượng tinh thần. Nhiệm vụ của tôi là đưa ẩm thực nhà hàng hạng sang đóng gói trong khay ăn công sở."
                    </p>
                    <div class="bg-orange-50 text-orange-800 text-xs text-left p-4 rounded-xl space-y-2">
                        <p><strong><i data-lucide="award" class="inline w-4 h-4 -mt-1 mr-1"></i>Kinh nghiệm:</strong> 15 năm (Từng là Bếp phó InterContinental)</p>
                        <p><strong><i data-lucide="check-square" class="inline w-4 h-4 -mt-1 mr-1"></i>Chứng chỉ:</strong> Chuyên gia dinh dưỡng 2022 (Viện DD Quốc Gia)</p>
                    </div>
                </div>

                <!-- Quy trình cam kết -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
                    <h2 class="text-lg font-bold text-gray-900 mb-6 uppercase tracking-wider">HuitMeal Cam kết 3 zero</h2>
                    <div class="space-y-4">
                        <div class="flex gap-4">
                            <div class="bg-red-100 text-red-500 w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">0</div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-sm">Thực phẩm Tồn dư hóa chất</h4>
                                <p class="text-gray-500 text-xs mt-1">Kiểm tra ngay tại khâu nhập liệu qua công nghệ test nhanh.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="bg-green-100 text-green-600 w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">0</div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-sm">Thực phẩm thừa từ ca trước</h4>
                                <p class="text-gray-500 text-xs mt-1">Mọi công đoạn nấu đều chuẩn giờ, tiêu hủy toàn bộ phần tồn dư ngay trong ngày.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="bg-blue-100 text-blue-600 w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">0</div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-sm">Sự cố an toàn thực phẩm</h4>
                                <p class="text-gray-500 text-xs mt-1">Lưu mẫu 24h và tuân thủ tuyệt đối quy định ATVSTP của bộ Y tế.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
