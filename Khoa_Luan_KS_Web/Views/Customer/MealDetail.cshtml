@{
    ViewData["Title"] = "Chi tiết thực đơn - HuitMeal";
    Layout = "_LayoutCustomer";
    string level = Context.Request.Query["level"].ToString();
    string day   = Context.Request.Query["day"].ToString();
    if (string.IsNullOrEmpty(level)) level = "mamnon";
    if (string.IsNullOrEmpty(day))   day   = "t2";

    var levelLabels = new Dictionary<string,string>{{"mamnon","Mầm Non"},{"tieuhoc","Tiểu Học"},{"thcs","THCS"},{"thpt","THPT"}};
    string levelLabel = levelLabels.GetValueOrDefault(level, "Học đường");

    // Full week meal data
    var meals = new Dictionary<string,(string Title,string Tag,string Kcal,string Img,string Desc,string[] Ingredients,string[] Steps,(string Label,int Pct)[] Nutrients)>{
        ["t2"]=(
            "Cơm thịt heo kho trứng cút","Bữa chính trưa","650 kcal",
            "https://images.unsplash.com/photo-1604908176997-125f25cc6f3d?w=900&q=80",
            "Món cơm truyền thống với thịt heo ba chỉ kho mềm ngọt cùng trứng cút đậm đà. Nước kho sánh, màu đẹp, thơm mùi nước dừa – món ăn quen thuộc được yêu thích nhất trong thực đơn học đường.",
            new[]{"Cơm gạo ST25 (180g)","Thịt heo ba chỉ tươi (100g)","Trứng cút luộc (4 quả)","Nước dừa tươi (100ml)","Tỏi, hành, nước mắm, đường","Rau muống xào tỏi (80g)","Canh bí đỏ hầm xương (200ml)","Dưa leo ngâm giấm (50g)"},
            new[]{"Thịt heo rửa sạch, cắt miếng vừa, ướp 15 phút","Phi thơm tỏi hành, cho thịt vào xào săn","Thêm nước dừa, kho liu riu 30 phút","Cho trứng cút vào, kho thêm 10 phút","Nêm nếm vừa miệng, tắt bếp"},
            new[]{("Tinh bột",62),("Protein",24),("Chất béo",14),("Chất xơ",8),("Vitamin C",45),("Canxi",35)}
        ),
        ["t3"]=(
            "Cơm gà nướng mật ong","Bữa chính trưa","680 kcal",
            "https://images.unsplash.com/photo-1512058564366-18510be2db19?w=900&q=80",
            "Đùi gà ta được ướp mật ong và gia vị đặc biệt, nướng vàng đều trong lò – giòn bên ngoài, mềm ngọt bên trong. Phục vụ kèm cơm trắng dẻo và canh rau thanh mát.",
            new[]{"Cơm trắng gạo Jasmine (180g)","Đùi gà ta (120g)","Mật ong nguyên chất (15ml)","Nước tương, tỏi, gừng","Rau cải xào tỏi (80g)","Canh cà chua trứng (200ml)","Dưa cải trắng muối (40g)"},
            new[]{"Gà ướp mật ong + nước tương 30 phút","Nướng lò 200°C trong 25 phút","Lật mặt, phết thêm mật ong, nướng 10 phút","Trình bày cùng cơm và rau"},
            new[]{("Tinh bột",55),("Protein",32),("Chất béo",13),("Chất xơ",10),("Vitamin A",60),("Kẽm",40)}
        ),
        ["t4"]=(
            "Cơm cá hú kho gừng","Bữa chính trưa","620 kcal",
            "https://images.unsplash.com/photo-1547592166-23ac45744acd?w=900&q=80",
            "Cá hú biển tươi kho gừng – món ăn giàu omega-3, đặc biệt tốt cho phát triển trí não học sinh. Nước kho cá vàng ươm, thấm đều, kết hợp hài hòa với vị cay nhẹ của gừng tươi.",
            new[]{"Cơm trắng (180g)","Cá hú tươi (130g)","Gừng tươi, sả (20g)","Nước mắm, tiêu, đường","Bắp cải xào (80g)","Canh rau dền (200ml)","Dưa hành muối (40g)"},
            new[]{"Cá rửa, khứa nhẹ, ướp gia vị 20 phút","Cho cá vào nồi, kho vừa lửa","Thêm gừng, sả vào, kho thêm 15 phút","Nêm nếm, đậy nắp giữ ấm"},
            new[]{("Tinh bột",58),("Protein",28),("Chất béo",14),("Omega-3",75),("Vitamin D",55),("Canxi",42)}
        ),
        ["t5"]=(
            "Mì Ý bò bằm sốt cà","Bữa chính trưa","700 kcal",
            "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=900&q=80",
            "Mì Ý nấu chín vừa, phủ sốt cà chua bò bằm đậm đà – món ăn phổ biến trong thực đơn quốc tế hóa của HuitMeal, giúp học sinh làm quen với ẩm thực đa dạng và bổ dưỡng.",
            new[]{"Mì Ý số 5 (150g)","Thịt bò bằm tươi (100g)","Cà chua bi (80g)","Hành tây, tỏi, cần tây","Dầu olive, muối, tiêu","Rau salad trộn (60g)","Bánh mì nướng bơ tỏi (1 lát)"},
            new[]{"Luộc mì al dente, vớt ra","Xào bò bằm với hành tỏi","Cho cà chua vào, nêm gia vị","Trộn mì với sốt, trình bày"},
            new[]{("Tinh bột",60),("Protein",26),("Chất béo",14),("Sắt",50),("Vitamin B12",65),("Lycopene",70)}
        ),
        ["t6"]=(
            "Cơm chiên dương châu tôm","Bữa chính trưa","730 kcal",
            "https://images.unsplash.com/photo-1569050467447-ce54b3bbc37d?w=900&q=80",
            "Cơm chiên dương châu truyền thống với tôm tươi, xúc xích, trứng và rau thập cẩm – màu sắc bắt mắt, thơm ngon, là món được học sinh yêu thích nhất trong thực đơn cuối tuần.",
            new[]{"Cơm nguội (200g)","Tôm tươi (60g)","Trứng gà (1 quả)","Xúc xích (40g)","Cà rốt, đậu Hà Lan (50g)","Hành lá, tỏi, dầu ăn","Nước tương Maggi, muối, tiêu"},
            new[]{"Xào tỏi với dầu ăn đến vàng thơm","Cho tôm, xúc xích vào xào sơ","Đẩy sang bên, đập trứng vào chiên","Cho cơm vào, đảo đều mạnh tay","Thêm rau, nêm gia vị, tắt bếp"},
            new[]{("Tinh bột",65),("Protein",20),("Chất béo",15),("Vitamin A",50),("Kẽm",35),("Selen",40)}
        ),
    };

    var current = meals.GetValueOrDefault(day, meals["t2"]);
    var days = new[]{("t2","Thứ Hai"),("t3","Thứ Ba"),("t4","Thứ Tư"),("t5","Thứ Năm"),("t6","Thứ Sáu")};
}

<div class="w-full bg-white overflow-hidden">

    <!-- HERO IMAGE -->
    <section class="relative h-[420px] md:h-[560px] overflow-hidden">
        <img src="@current.Img" class="absolute inset-0 w-full h-full object-cover brightness-75" />
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/30 to-transparent"></div>

        <!-- Back button -->
        <a href="/Customer/SchoolMenu?level=@level&day=@day"
           class="absolute top-6 left-6 z-20 flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 text-white px-4 py-2 rounded-full text-sm font-bold hover:bg-white/20 transition-all">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Quay lại thực đơn
        </a>

        <div class="absolute bottom-0 left-0 right-0 z-10 max-w-7xl mx-auto px-6 pb-10"
             x-data="{v:false}" x-init="setTimeout(()=>v=true,80)"
             x-show="v" x-transition:enter="transition duration-700" x-transition:enter-start="opacity-0 translate-y-6" x-transition:enter-end="opacity-100 translate-y-0">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                        <span class="bg-orange-500 text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-widest">@current.Tag</span>
                        <span class="bg-white/10 text-white text-[10px] font-bold px-3 py-1 rounded-full border border-white/20">
                            <i data-lucide="flame" class="w-3 h-3 inline text-orange-400 mr-1"></i>@current.Kcal
                        </span>
                        <span class="bg-white/10 text-white text-[10px] font-bold px-3 py-1 rounded-full border border-white/20">@levelLabel</span>
                    </div>
                    <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight leading-tight">@current.Title</h1>
                </div>
                <!-- Rating -->
                <div class="bg-white/10 backdrop-blur-lg border border-white/20 rounded-2xl px-6 py-4 text-center hidden md:block">
                    <div class="flex gap-0.5 justify-center mb-1">
                        @for(int i=0;i<5;i++){<i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>}
                    </div>
                    <p class="text-white font-black text-xl">4.9</p>
                    <p class="text-gray-300 text-[10px]">1.2k học sinh đánh giá</p>
                </div>
            </div>
        </div>
    </section>

    <!-- DAY SWITCHER -->
    <div class="bg-white border-b border-gray-100 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex items-center gap-2 overflow-x-auto py-3 no-scrollbar">
                @foreach (var (d,label) in days)
                {
                    <a href="/Customer/MealDetail?level=@level&day=@d"
                       class="flex-shrink-0 px-5 py-2 rounded-full text-sm font-bold transition-all @(d==day?"bg-orange-500 text-white shadow":"bg-gray-100 text-gray-600 hover:bg-gray-200")">
                        @label
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="max-w-7xl mx-auto px-6 py-16">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

            <!-- LEFT: Description + Ingredients + Steps -->
            <div class="lg:col-span-2 space-y-10">

                <!-- Description -->
                <div>
                    <p class="text-orange-600 text-xs font-bold uppercase tracking-[0.3em] mb-3">Giới thiệu món ăn</p>
                    <p class="text-gray-700 text-lg leading-relaxed font-medium">@current.Desc</p>
                </div>

                <!-- Ingredients -->
                <div>
                    <p class="text-orange-600 text-xs font-bold uppercase tracking-[0.3em] mb-4">Nguyên liệu</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @foreach (var ing in current.Ingredients)
                        {
                            <div class="flex items-center gap-3 bg-gray-50 border border-gray-100 rounded-xl px-4 py-3">
                                <div class="w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="utensils" class="w-3.5 h-3.5 text-orange-600"></i>
                                </div>
                                <span class="text-sm font-semibold text-gray-800">@ing</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Preparation Steps -->
                <div>
                    <p class="text-orange-600 text-xs font-bold uppercase tracking-[0.3em] mb-4">Quy trình chế biến</p>
                    <div class="space-y-4">
                        @for (int i = 0; i < current.Steps.Length; i++)
                        {
                            <div class="flex gap-4 items-start">
                                <div class="w-9 h-9 rounded-full bg-orange-500 text-white font-black text-sm flex items-center justify-center flex-shrink-0">@(i+1)</div>
                                <div class="flex-1 bg-gray-50 border border-gray-100 rounded-xl px-5 py-3.5">
                                    <p class="text-sm font-semibold text-gray-800 leading-relaxed">@current.Steps[i]</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Food Safety Certifications -->
                <div class="bg-green-50 border border-green-100 rounded-2xl p-6">
                    <p class="text-green-700 text-xs font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4"></i> Chứng nhận an toàn thực phẩm
                    </p>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        @foreach (var cert in new[]{"ISO 22000:2018","HACCP","VietGAP","Không chất bảo quản","Không phẩm màu","Kiểm định hàng ngày"})
                        {
                            <div class="flex items-center gap-2 text-xs font-semibold text-green-800">
                                <i data-lucide="check-circle" class="w-3.5 h-3.5 text-green-600 flex-shrink-0"></i> @cert
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT: Nutrition + Chef + Info -->
            <div class="space-y-6">

                <!-- Nutrition Chart -->
                <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
                    <p class="font-black text-gray-900 mb-1">Thành phần dinh dưỡng</p>
                    <p class="text-xs text-gray-400 mb-5">Tính trên 1 khẩu phần ăn (@current.Kcal)</p>
                    <div class="space-y-3.5">
                        @foreach (var (label, pct) in current.Nutrients)
                        {
                            <div>
                                <div class="flex justify-between text-xs font-semibold text-gray-700 mb-1.5">
                                    <span>@label</span>
                                    <span class="text-orange-600">@pct%</span>
                                </div>
                                <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-orange-400 to-orange-500 rounded-full transition-all duration-1000"
                                         style="width:@(pct)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                    <p class="text-[10px] text-gray-400 mt-4">* % Giá trị dinh dưỡng khuyến nghị hàng ngày theo Bộ Y tế VN</p>
                </div>

                <!-- Chef Profile -->
                <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
                    <p class="text-orange-600 text-xs font-bold uppercase tracking-widest mb-4">Bếp trưởng phụ trách</p>
                    <div class="flex items-center gap-4 mb-4">
                        <img src="https://ui-avatars.com/api/?name=Nguyen+Thanh+Hai&background=FED7AA&color=C2410C&bold=true&size=64"
                             class="w-14 h-14 rounded-full border-2 border-orange-100" />
                        <div>
                            <p class="font-black text-gray-900">Nguyễn Thanh Hải</p>
                            <p class="text-xs text-gray-500">Bếp trưởng HuitMeal · 12 năm kinh nghiệm</p>
                            <div class="flex gap-1 mt-1">
                                @for(int i=0;i<5;i++){<i data-lucide="star" class="w-3 h-3 fill-amber-400 text-amber-400"></i>}
                            </div>
                        </div>
                    </div>
                    <p class="text-xs text-gray-600 leading-relaxed italic">"Mỗi bữa ăn là một tình yêu tôi gửi trao cho thế hệ tương lai. Chúng tôi nấu với tâm huyết như nấu cho chính con em mình."</p>
                </div>

                <!-- Meal Meta Info -->
                <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
                    <p class="font-black text-gray-900 mb-4">Thông tin khẩu phần</p>
                    <div class="space-y-3">
                        @foreach (var (icon, label, val) in new[]{
                            ("clock","Thời gian chuẩn bị","45 phút"),
                            ("users","Phục vụ","1 học sinh"),
                            ("thermometer","Nhiệt độ phục vụ","≥ 65°C"),
                            ("package","Đóng gói","Hộp inox 1 chiều"),
                            ("truck","Giao hàng","Trước 11:00 sáng"),
                            ("calendar","Thực đơn xoay vòng","30 ngày"),
                        })
                        {
                            <div class="flex items-center gap-3 text-sm">
                                <div class="w-8 h-8 rounded-lg bg-orange-50 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="@icon" class="w-3.5 h-3.5 text-orange-600"></i>
                                </div>
                                <span class="text-gray-500 flex-1">@label</span>
                                <span class="font-bold text-gray-900">@val</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- CTA -->
                <a href="/Customer/Contact"
                   class="flex items-center justify-center gap-2 w-full py-4 bg-orange-500 text-white rounded-2xl font-bold text-sm hover:bg-orange-400 hover:-translate-y-0.5 transition-all shadow-lg shadow-orange-200">
                    <i data-lucide="phone" class="w-4 h-4"></i>
                    Đăng ký suất ăn cho trường
                </a>
            </div>
        </div>
    </div>

    <!-- WEEK OVERVIEW -->
    <section class="py-16 bg-gray-50 border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-6">
            <p class="text-orange-600 text-xs font-bold uppercase tracking-[0.3em] mb-3">Xem thêm</p>
            <h2 class="text-3xl font-black text-gray-900 mb-8 tracking-tight">Thực đơn cả tuần</h2>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                @foreach (var (d, label) in days)
                {
                    var m = meals[d];
                    <a href="/Customer/MealDetail?level=@level&day=@d"
                       class="group rounded-[20px] overflow-hidden border @(d==day?"border-orange-400 ring-2 ring-orange-200":"border-gray-100") bg-white hover:shadow-lg transition-all hover:-translate-y-1">
                        <div class="relative h-28 overflow-hidden">
                            <img src="@m.Img" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            @if(d==day){<div class="absolute inset-0 bg-orange-500/20"></div>
                            <div class="absolute top-2 right-2 w-5 h-5 rounded-full bg-orange-500 flex items-center justify-center"><i data-lucide="check" class="w-3 h-3 text-white"></i></div>}
                        </div>
                        <div class="p-3">
                            <p class="text-[10px] font-black text-orange-500 uppercase tracking-widest">@label</p>
                            <p class="text-xs font-bold text-gray-900 leading-tight truncate">@m.Title</p>
                            <p class="text-[10px] text-gray-400 mt-0.5">@m.Kcal</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar{display:none;}
    .no-scrollbar{-ms-overflow-style:none;scrollbar-width:none;}
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => { lucide.createIcons(); });
    </script>
}
