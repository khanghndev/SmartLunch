@model AboutPageViewModel
@{
    ViewData["Title"] = "Về chúng tôi - HuitMeal";
    Layout = "_LayoutCustomer";
    var certs = Model.Documents.Where(d => d.DocumentType is "food_safety" or "iso" or "business_license" or "inspection").ToList();
    var contracts = Model.Documents.Where(d => d.DocumentType == "contract").ToList();
    var others = Model.Documents.Where(d => d.DocumentType == "other").ToList();
    string FmtDate(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy") : "—";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    
    .milestone-year {
        font-family: 'Inter', sans-serif;
        font-weight: 900;
        line-height: 0.8;
    }

    .shadow-premium {
        box-shadow: 0 20px 80px -15px rgba(0,0,0,0.1);
    }
</style>

<div class="w-full bg-transparent overflow-hidden" x-data="{ openModal: false }">
    
    <!-- ===== CINEMATIC HERO ===== -->
    <section class="relative h-[550px] md:h-[700px] flex items-center">
        <img src="/assets/images/bannervechungtoi.jpg" class="absolute inset-0 w-full h-full object-cover brightness-[0.7] scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
            <div class="max-w-3xl" x-data="{ loaded: false }" x-init="setTimeout(() => loaded = true, 100)">
                <div x-show="loaded" x-transition:enter="transition ease-out duration-1000 transform" x-transition:enter-start="opacity-0 translate-x-[-50px]" x-transition:enter-end="opacity-100 translate-x-0">
                    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/20 backdrop-blur-md border border-orange-500/30 text-orange-400 text-[10px] font-bold uppercase tracking-[0.2em] mb-6">
                        <i data-lucide="award" class="w-3.5 h-3.5"></i>
                        Vị thế dẫn đầu ngành suất ăn
                    </span>
                    <h1 class="text-5xl md:text-8xl font-black text-white mb-8 tracking-tighter leading-[1.05]">
                        Tận Tâm Kiến Tạo <br /> 
                        <span class="text-orange-500">Giá Trị Thực</span>
                    </h1>
                    <p class="text-lg md:text-xl text-gray-300 font-medium leading-relaxed mb-10 opacity-80 border-l-4 border-orange-500 pl-6">
                        Hành trình 15 năm bền bỉ mang tinh hoa ẩm thực sạch đến hàng triệu người lao động và học sinh Việt Nam.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== THE JOURNEY (History) ===== -->
    <section class="py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div class="relative">
                    <div class="milestone-year text-[150px] md:text-[220px] text-gray-100 absolute -top-20 -left-10 z-0">2009</div>
                    <div class="relative z-10">
                        <h2 class="text-sm font-bold text-orange-600 uppercase tracking-widest mb-4">Hành trình phát triển</h2>
                        <h3 class="text-4xl md:text-5xl font-black text-gray-900 mb-8 tracking-tight">Hơn 15 năm <br /> Khẳng định thương hiệu</h3>
                        <div class="space-y-6 text-gray-600 leading-relaxed text-justify">
                            <p>Khởi đầu từ khát vọng mang lại bữa ăn sạch cho công nhân, HuitMeal đã không ngừng nỗ lực để trở thành đơn vị dẫn đầu trong lĩnh vực cung ứng suất ăn công nghiệp và suất ăn học đường.</p>
                            <p>Tự hào là đơn vị đạt tiêu chuẩn <span class="font-bold text-gray-900">ISO 22000:2005</span>, chúng tôi đã chuẩn hóa mô hình bếp ăn một chiều hiện đại nhất, kiểm soát chặt chẽ từng khâu từ trang trại đến bàn ăn.</p>
                            <div class="grid grid-cols-2 gap-8 pt-6">
                                <div>
                                    <p class="text-4xl font-black text-gray-900">15+</p>
                                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Năm kinh nghiệm</p>
                                </div>
                                <div>
                                    <p class="text-4xl font-black text-gray-900">10M+</p>
                                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Suất ăn mỗi năm</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="relative group">
                    <div class="absolute -inset-4 bg-orange-500/10 rounded-[40px] rotate-2 group-hover:rotate-0 transition-transform duration-500"></div>
                    <img src="/assets/images/vechungtoi2.jpg" class="relative z-10 rounded-[32px] shadow-2xl w-full h-[500px] object-cover" />
                </div>
            </div>
        </div>
    </section>

    <!-- ===== LEADERSHIP MESSAGE ===== -->
    <section class="py-24 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gray-900 -skew-x-12 translate-x-1/4"></div>
        <div class="max-w-7xl mx-auto px-6 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
                <div class="md:col-span-7 bg-white p-12 md:p-16 rounded-[48px] shadow-premium">
                    <div class="text-orange-500 mb-8">
                        <i data-lucide="quote" class="w-16 h-16 opacity-20"></i>
                    </div>
                    <h4 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8 italic leading-snug">
                        "Tại HuitMeal, chúng tôi không chỉ bán suất ăn, chúng tôi trao gửi sự an tâm và trách nhiệm trong từng hạt gạo, miếng thịt."
                    </h4>
                    <p class="text-gray-500 leading-relaxed mb-10 text-justify">
                        Bắt nguồn từ thực tế, chúng tôi hiểu rằng một bữa ăn ngon và sạch là nền tảng cho sức khỏe và năng suất lao động. HuitMeal cam kết đồng hành cùng doanh nghiệp để tạo nên một cộng đồng khỏe mạnh và hạnh phúc.
                    </p>
                    <div class="flex items-center gap-6">
                        <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 font-bold">CEO</div>
                        <div>
                            <p class="font-bold text-gray-900 text-lg">Tổng Giám Đốc</p>
                            <p class="text-sm text-gray-400 font-medium">HuitMeal Group</p>
                        </div>
                        <button @@click="openModal = true" class="ml-auto text-sm font-bold text-orange-600 hover:underline">Đọc toàn văn thư</button>
                    </div>
                </div>
                <div class="md:col-span-5 text-white">
                    <h3 class="text-4xl md:text-5xl font-black mb-8 tracking-tight">Thông điệp từ <br /> Ban lãnh đạo</h3>
                    <p class="text-gray-400 leading-relaxed mb-8">Hơn 500 nhân sự của HuitMeal luôn làm việc với tôn chỉ: "Tận tâm phục vụ - Bữa ăn tử tế".</p>
                    <div class="flex gap-4">
                        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center hover:bg-orange-500 transition-colors cursor-pointer">
                            <i data-lucide="linkedin" class="w-5 h-5"></i>
                        </div>
                        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center hover:bg-orange-500 transition-colors cursor-pointer">
                            <i data-lucide="mail" class="w-5 h-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== LEGAL & TRUST DOCUMENTS ===== -->
    @if (Model.Documents.Count > 0)
    {
        <section class="py-24 bg-white border-t border-gray-100" x-data="aboutDocuments()">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-14">
                    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold uppercase tracking-[0.2em] mb-4">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                        Minh bạch & Tuân thủ
                    </span>
                    <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-4">Hồ sơ pháp lý & Chứng từ</h2>
                    <p class="text-gray-500 max-w-2xl mx-auto leading-relaxed">HuitMeal công khai chứng nhận VSATTP, biên bản kiểm tra và các văn bản liên quan để quý khách hàng an tâm khi hợp tác.</p>
                </div>

                <div class="flex flex-wrap justify-center gap-2 mb-10">
                    <button type="button" @@click="tab='certs'" :class="tab==='certs' ? 'bg-gray-900 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="px-5 py-2.5 rounded-full text-sm font-bold transition-all">
                        Chứng nhận & Kiểm định (@certs.Count)
                    </button>
                    <button type="button" @@click="tab='contracts'" :class="tab==='contracts' ? 'bg-gray-900 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="px-5 py-2.5 rounded-full text-sm font-bold transition-all">
                        Hợp đồng & Khung thỏa thuận (@contracts.Count)
                    </button>
                    @if (others.Count > 0)
                    {
                        <button type="button" @@click="tab='other'" :class="tab==='other' ? 'bg-gray-900 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="px-5 py-2.5 rounded-full text-sm font-bold transition-all">
                            Chứng từ khác (@others.Count)
                        </button>
                    }
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" x-show="tab==='certs'" x-cloak>
                    @foreach (var doc in certs)
                    {
                        <article class="group relative bg-white rounded-[28px] border border-gray-100 shadow-premium hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                            <div class="h-2 @(doc.IsExpired ? "bg-red-400" : "bg-emerald-500")"></div>
                            <div class="p-7">
                                <div class="flex items-start justify-between gap-3 mb-4">
                                    <div class="w-12 h-12 rounded-2xl bg-red-50 flex items-center justify-center shrink-0">
                                        <i data-lucide="file-badge" class="w-6 h-6 text-red-500"></i>
                                    </div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full @(doc.IsExpired ? "bg-red-50 text-red-600" : "bg-emerald-50 text-emerald-700")">
                                        @(doc.IsExpired ? "Hết hạn" : "Hiệu lực")
                                    </span>
                                </div>
                                <p class="text-[10px] font-bold text-orange-600 uppercase tracking-wider mb-1">@doc.DocumentTypeLabel</p>
                                <h4 class="text-lg font-bold text-gray-900 mb-2 leading-snug">@doc.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(doc.Description))
                                {
                                    <p class="text-sm text-gray-500 mb-4 line-clamp-2">@doc.Description</p>
                                }
                                <dl class="text-xs text-gray-500 space-y-1 mb-6">
                                    <div class="flex justify-between"><dt>Cấp ngày</dt><dd class="font-semibold text-gray-700">@FmtDate(doc.IssuedDate)</dd></div>
                                    <div class="flex justify-between"><dt>Hết hạn</dt><dd class="font-semibold text-gray-700">@FmtDate(doc.ExpiryDate)</dd></div>
                                </dl>
                                <div class="flex gap-2">
                                    <a href="@doc.FileUrl" target="_blank" rel="noopener" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-gray-900 text-white text-sm font-bold hover:bg-orange-600 transition-colors">
                                        <i data-lucide="external-link" class="w-4 h-4"></i> Xem tài liệu
                                    </a>
                                    <button type="button" @@click="preview($el.dataset.url, $el.dataset.title)" data-url="@doc.FileUrl" data-title="@doc.Title" class="px-3 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:border-orange-300 hover:text-orange-600 transition-colors" title="Xem nhanh">
                                        <i data-lucide="maximize-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6" x-show="tab==='contracts'" x-cloak style="display:none;">
                    @foreach (var doc in contracts)
                    {
                        <article class="flex flex-col md:flex-row gap-6 p-8 rounded-[32px] bg-gradient-to-br from-slate-900 to-slate-800 text-white shadow-2xl">
                            <div class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center shrink-0">
                                <i data-lucide="file-signature" class="w-8 h-8 text-orange-400"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-[10px] font-bold text-orange-400 uppercase tracking-widest mb-2">@doc.DocumentTypeLabel</p>
                                <h4 class="text-xl font-bold mb-2">@doc.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(doc.Description))
                                {
                                    <p class="text-sm text-slate-300 mb-4">@doc.Description</p>
                                }
                                <p class="text-xs text-slate-400 mb-5">Cập nhật: @doc.CreatedAt.ToString("dd/MM/yyyy")</p>
                                <a href="@doc.FileUrl" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-400 text-white text-sm font-bold transition-colors">
                                    <i data-lucide="download" class="w-4 h-4"></i> Tải / Xem hợp đồng
                                </a>
                            </div>
                        </article>
                    }
                    @if (contracts.Count == 0)
                    {
                        <p class="col-span-2 text-center text-gray-400 py-12">Chưa có hợp đồng công khai.</p>
                    }
                </div>

                @if (others.Count > 0)
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" x-show="tab==='other'" x-cloak style="display:none;">
                        @foreach (var doc in others)
                        {
                            <article class="p-6 rounded-[24px] border border-gray-100 bg-gray-50 hover:bg-white hover:shadow-lg transition-all">
                                <h4 class="font-bold text-gray-900 mb-1">@doc.Title</h4>
                                <p class="text-xs text-gray-500 mb-4">@doc.DocumentTypeLabel</p>
                                <a href="@doc.FileUrl" target="_blank" class="text-sm font-bold text-orange-600 hover:underline">Xem tài liệu →</a>
                            </article>
                        }
                    </div>
                }
            </div>

            <div x-show="previewOpen" style="display:none;" class="fixed inset-0 z-[120] flex items-center justify-center p-4 md:p-8">
                <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @@click="closePreview()"></div>
                <div class="relative bg-white w-full max-w-5xl max-h-[90vh] rounded-[32px] shadow-2xl overflow-hidden flex flex-col" @@click.stop>
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                        <h3 class="font-bold text-gray-900 truncate pr-4" x-text="previewTitle"></h3>
                        <button type="button" @@click="closePreview()" class="p-2 rounded-full hover:bg-gray-100 text-gray-500"><i data-lucide="x" class="w-6 h-6"></i></button>
                    </div>
                    <iframe :src="previewUrl" class="flex-1 w-full min-h-[70vh] border-0 bg-gray-50" title="Xem tài liệu"></iframe>
                </div>
            </div>
        </section>
    }

    <!-- ===== VISION & MISSION GRID ===== -->
    <section class="py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-20">
                <h2 class="text-sm font-bold text-orange-600 uppercase tracking-widest mb-4 text-center">Tầm nhìn & Sứ mệnh</h2>
                <h3 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight text-center">Kim chỉ nam cho mọi hành động</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Vision -->
                <div class="group relative h-[500px] rounded-[40px] overflow-hidden shadow-xl">
                    <img src="/assets/images/about.jpg" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-700" />
                    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
                    <div class="absolute inset-0 p-10 flex flex-col justify-end">
                        <div class="w-12 h-12 rounded-xl bg-orange-500 flex items-center justify-center text-white mb-6">
                            <i data-lucide="eye" class="w-6 h-6"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-white mb-4">Tầm Nhìn</h4>
                        <p class="text-gray-300 text-sm leading-relaxed">Trở thành biểu tượng tin cậy hàng đầu trong ngành thực phẩm sạch và suất ăn công nghiệp tại Đông Nam Á.</p>
                    </div>
                </div>

                <!-- Mission 1 -->
                <div class="group relative h-[500px] rounded-[40px] overflow-hidden shadow-xl">
                    <img src="/assets/images/about1.jpg" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-700" />
                    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
                    <div class="absolute inset-0 p-10 flex flex-col justify-end">
                        <div class="w-12 h-12 rounded-xl bg-blue-500 flex items-center justify-center text-white mb-6">
                            <i data-lucide="users" class="w-6 h-6"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-white mb-4">Sứ Mệnh Khách Hàng</h4>
                        <p class="text-gray-300 text-sm leading-relaxed">Cung cấp giải pháp dinh dưỡng toàn diện, giúp doanh nghiệp tối ưu hóa nguồn nhân lực qua từng bữa ăn.</p>
                    </div>
                </div>

                <!-- Mission 2 -->
                <div class="group relative h-[500px] rounded-[40px] overflow-hidden shadow-xl">
                    <img src="/assets/images/about2.jpg" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-700" />
                    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
                    <div class="absolute inset-0 p-10 flex flex-col justify-end">
                        <div class="w-12 h-12 rounded-xl bg-green-500 flex items-center justify-center text-white mb-6">
                            <i data-lucide="heart" class="w-6 h-6"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-white mb-4">Trách Nhiệm Cộng Đồng</h4>
                        <p class="text-gray-300 text-sm leading-relaxed">Lan tỏa giá trị sống khỏe, bảo vệ môi trường và đóng góp tích cực cho sự phát triển bền vững của xã hội.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Full Text Modal -->
    <div x-show="openModal" style="display: none;" class="fixed inset-0 z-[100] flex items-center justify-center p-6">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @@click="openModal = false"></div>
        <div class="relative bg-white w-full max-w-3xl max-h-[80vh] overflow-y-auto rounded-[40px] shadow-2xl p-10 md:p-16 animate-fadeIn">
            <button @@click="openModal = false" class="absolute top-8 right-8 text-gray-400 hover:text-gray-900 transition-colors">
                <i data-lucide="x" class="w-8 h-8"></i>
            </button>
            <div class="text-orange-500 mb-8"><i data-lucide="quote" class="w-12 h-12"></i></div>
            <h3 class="text-3xl font-black text-gray-900 mb-8 tracking-tight">Thư ngỏ từ Ban Lãnh Đạo</h3>
            <div class="space-y-6 text-gray-600 leading-relaxed text-justify">
                <p class="font-bold text-gray-900">Kính thưa quý vị đối tác và khách hàng!</p>
                <p>Bắt nguồn từ thực tế: Các doanh nghiệp luôn mong muốn đẩy nhanh quá trình sản xuất nhưng đồng thời cũng cực kỳ quan tâm đến sức khỏe người lao động. Chúng tôi tin rằng các sản phẩm, dịch vụ HuitMeal cung cấp là lựa chọn đúng đắn nhất.</p>
                <p>Tại HuitMeal, chúng tôi xây dựng văn hóa "Coi thực phẩm là thuốc quý". Từng nguyên liệu được kiểm soát như trong phòng thí nghiệm để đảm bảo độ tươi ngon và sạch sẽ tuyệt đối.</p>
                <p>Chúng tôi rất mong muốn nhận được sự hợp tác, đồng hành của quý vị trên hành trình kiến tạo những bữa ăn tử tế cho người Việt.</p>
                <p class="pt-6 font-bold text-gray-900 italic">Trân trọng cảm ơn!</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('aboutDocuments', () => ({
                tab: '@(contracts.Count > 0 && certs.Count == 0 ? "contracts" : "certs")',
                previewOpen: false,
                previewUrl: '',
                previewTitle: '',
                preview(url, title) {
                    this.previewUrl = url;
                    this.previewTitle = title;
                    this.previewOpen = true;
                    document.body.style.overflow = 'hidden';
                    this.$nextTick(() => lucide.createIcons());
                },
                closePreview() {
                    this.previewOpen = false;
                    this.previewUrl = '';
                    document.body.style.overflow = '';
                }
            }));
        });
        document.addEventListener('DOMContentLoaded', () => lucide.createIcons());
    </script>
}

