@{
    ViewData["Title"] = "Liên hệ";
    Layout = "_LayoutCustomer";
}

<div class="w-full bg-white text-[#1f2a37]">
    <!-- ================= BANNER ================= -->
    <section class="relative w-full h-[400px] md:h-[500px] overflow-hidden">
        <img src="/assets/images/bannerlienhe.jpg" alt="Liên hệ" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="absolute inset-0 flex items-center px-6 md:px-20 lg:px-32 z-10">
            <div class="max-w-2xl text-white">
                <div class="bg-[#f39200] px-4 py-2 font-bold text-xl inline-block mb-4">LIÊN HỆ</div>
                <h1 class="text-3xl md:text-5xl font-extrabold mb-6 uppercase">Kết nối với HUITMEAL</h1>
                <p class="text-white/90 text-lg">Chúng tôi luôn sẵn sàng lắng nghe và giải đáp mọi thắc mắc.</p>
            </div>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-16">
        <!-- ===== 1. THÔNG TIN CÔNG TY ===== -->
        <div class="flex flex-col md:flex-row justify-between items-start mb-12 gap-8">
            <div>
                <h2 class="text-2xl md:text-3xl font-bold uppercase mb-4">
                    Công ty cổ phần dịch vụ <span class="relative inline-block">
                        Quốc tế Hà Thành
                        <span class="absolute bottom-1 left-0 w-full h-2 bg-[#ffc107] -z-10"></span>
                    </span>
                </h2>
                <div class="space-y-1 text-gray-700">
                    <p><span class="font-bold">Hotline 24/7:</span> 0966 741 866</p>
                    <p><span class="font-bold">Email:</span> contact@HuitMeal.com</p>
                </div>
            </div>
            <div class="text-gray-700">
                <p><span class="font-bold">Thời gian làm việc:</span> Thứ 2 – Thứ 6: 8h00 – 17h00</p>
                <p class="md:ml-[132px]">Thứ 7: 8h00 – 17h00</p>
            </div>
        </div>

        <!-- ===== 2. HỆ THỐNG CHI NHÁNH & MAP ===== -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
            <!-- Branch 1 -->
            <div class="relative group overflow-hidden rounded-lg shadow-md">
                <div class="h-72 w-full bg-gray-200">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3725.1957256191!2d105.7468305759684!3d20.98478958928374!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3134532be4070a7b%3A0x6335f6e80b8d3f1!2sThe%20Pride!5e0!3m2!1svi!2s!4v1710000000000!5m2!1svi!2s" class="w-full h-full transition duration-500 group-hover:scale-105"></iframe>
                </div>
                <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white px-4 py-3 backdrop-blur-sm text-xs">
                    <h4 class="text-[#ffc107] font-semibold mb-2 text-sm">CHI NHÁNH 1:</h4>
                    <div class="flex items-start gap-2 mb-1">
                        <i data-lucide="map-pin" class="mt-[2px] text-[#ffc107]" style="width:14px;height:14px"></i>
                        <p class="leading-snug line-clamp-2">Tầng 2, Toà CT4 tổ hợp TMDV The Pride, KĐT mới An Hưng, P. La Khê, Q. Hà Đông, Hà Nội</p>
                    </div>
                    <div class="flex items-center gap-2 text-[#ffc107] font-semibold">
                        <i data-lucide="phone" style="width:14px;height:14px"></i>
                        <span>024 9996 7799 - 0966 74 18 66</span>
                    </div>
                </div>
            </div>
             <!-- Branch 2 -->
             <div class="relative group overflow-hidden rounded-lg shadow-md">
                <div class="h-72 w-full bg-gray-200">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.5201202860473!2d106.704253175704!3d10.848039157868!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3175287968536f93%3A0x2863901b0665476a!2zS2h1IMSQw7QgVGjhu4sgVuG6oW4gUGjDumM!5e0!3m2!1svi!2s!4v1710000000000!5m2!1svi!2s" class="w-full h-full transition duration-500 group-hover:scale-105"></iframe>
                </div>
                <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white px-4 py-3 backdrop-blur-sm text-xs">
                    <h4 class="text-[#ffc107] font-semibold mb-2 text-sm">CHI NHÁNH 2:</h4>
                    <div class="flex items-start gap-2 mb-1">
                        <i data-lucide="map-pin" class="mt-[2px] text-[#ffc107]" style="width:14px;height:14px"></i>
                        <p class="leading-snug line-clamp-2">Số 24, đường 39, Khu đô thị Vạn Phúc, phường Hiệp Bình Phước, TP. Thủ Đức</p>
                    </div>
                    <div class="flex items-center gap-2 text-[#ffc107] font-semibold">
                         <i data-lucide="phone" style="width:14px;height:14px"></i>
                        <span>028 9996 7799 - 0923 787 787</span>
                    </div>
                </div>
            </div>
             <!-- Branch 3 -->
             <div class="relative group overflow-hidden rounded-lg shadow-md">
                <div class="h-72 w-full bg-gray-200">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3835.733333333333!2d108.3666666666666!3d15.88333333333333!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31420e6e6e6e6e6e%3A0x6e6e6e6e6e6e6e6e!2zQ-G6qW0gQW4sIEjhu5lpIEFuLCBRdeG6o25nIE5hbQ!5e0!3m2!1svi!2s!4v1710000000000!5m2!1svi!2s" class="w-full h-full transition duration-500 group-hover:scale-105"></iframe>
                </div>
                <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white px-4 py-3 backdrop-blur-sm text-xs">
                    <h4 class="text-[#ffc107] font-semibold mb-2 text-sm">CHI NHÁNH 3:</h4>
                    <div class="flex items-start gap-2 mb-1">
                        <i data-lucide="map-pin" class="mt-[2px] text-[#ffc107]" style="width:14px;height:14px"></i>
                        <p class="leading-snug line-clamp-2">Khu TĐC Làng Chài (phân khu 3), Cẩm An, Hội An, Quảng Nam</p>
                    </div>
                    <div class="flex items-center gap-2 text-[#ffc107] font-semibold">
                         <i data-lucide="phone" style="width:14px;height:14px"></i>
                        <span>Liên hệ Hotline để được hỗ trợ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== 3. SECTION FORM LIÊN HỆ ===== -->
        <div class="relative w-full rounded-3xl overflow-hidden bg-[#f9f9f9] min-h-[600px] flex items-center shadow-sm">
            <div class="absolute inset-0 z-0">
                <img src="/assets/images/guiyeucaulienhe.jpg" alt="Chefs" class="w-full h-full object-cover object-right" />
            </div>

            <div class="relative z-10 w-full md:w-1/2 px-8 py-12 md:pl-20 bg-white/10 md:bg-transparent backdrop-blur-sm md:backdrop-blur-none" x-data="{ expanded: false }">
                <div class="mb-8">
                    <h2 class="text-4xl font-extrabold text-black leading-tight">
                        <span class="relative inline-block">Liên hệ<span class="absolute bottom-2 left-0 w-full h-3 bg-[#ffc107] -z-10"></span></span><br /> với chúng tôi
                    </h2>
                </div>

                <form class="space-y-5 max-w-md">
                    <div class="flex flex-col">
                        <label class="text-sm font-bold text-black mb-1">Họ và tên <span class="text-red-500">*</span></label>
                        <input type="text" class="w-full bg-transparent border-b border-gray-400 focus:border-orange-500 outline-none py-2 transition-colors" />
                    </div>
                     <div class="flex flex-col">
                        <label class="text-sm font-bold text-black mb-1">Email <span class="text-red-500">*</span></label>
                        <input type="email" class="w-full bg-transparent border-b border-gray-400 focus:border-orange-500 outline-none py-2 transition-colors" />
                    </div>
                     <div class="flex flex-col">
                        <label class="text-sm font-bold text-black mb-1">Số điện thoại <span class="text-red-500">*</span></label>
                        <input type="tel" class="w-full bg-transparent border-b border-gray-400 focus:border-orange-500 outline-none py-2 transition-colors" />
                    </div>

                    <div class="pt-2">
                        <p class="text-sm font-bold text-black mb-3">Tôi quan tâm đến:</p>
                        <div class="grid grid-cols-1 gap-2">
                            <label class="flex items-center gap-3 cursor-pointer group"><input type="checkbox" class="w-4 h-4 accent-orange-500" /><span class="text-sm text-gray-700 group-hover:text-black">Suất ăn công nghiệp</span></label>
                            <label class="flex items-center gap-3 cursor-pointer group"><input type="checkbox" class="w-4 h-4 accent-orange-500" /><span class="text-sm text-gray-700 group-hover:text-black">Vệ sinh công nghiệp</span></label>
                            <label class="flex items-center gap-3 cursor-pointer group"><input type="checkbox" class="w-4 h-4 accent-orange-500" /><span class="text-sm text-gray-700 group-hover:text-black">Cung ứng thực phẩm sạch</span></label>
                            <label class="flex items-center gap-3 cursor-pointer group"><input type="checkbox" class="w-4 h-4 accent-orange-500" /><span class="text-sm text-gray-700 group-hover:text-black">Setup hệ thống bếp</span></label>
                        </div>
                    </div>

                    <div class="flex flex-col pt-2">
                        <label class="text-sm font-bold text-black mb-1">Nội dung tin nhắn</label>
                        <textarea rows="1" class="w-full bg-transparent border-b border-gray-400 focus:border-orange-500 outline-none py-2 resize-none"></textarea>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="bg-[#f39200] hover:bg-orange-600 text-white font-bold px-10 py-3 rounded-full shadow-lg transition-transform active:scale-95 uppercase text-sm">Gửi yêu cầu</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
