@{
    ViewData["Title"] = "Đánh giá";
    Layout = "_LayoutCustomer";
}

<div class="bg-gray-50 font-sans">
    
    <!-- Hero Section -->
    <div class="relative bg-[#1f2a37] text-white py-24 overflow-hidden">
        <div class="absolute inset-0 opacity-20">
            <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M0,0 L100,0 L100,100 L0,100 Z" fill="url(#grid-pattern)" />
            </svg>
            <defs>
                <pattern id="grid-pattern" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
                </pattern>
            </defs>
        </div>
        <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">
                Hơn <span class="text-orange-500">500+ Doanh nghiệp</span> đã tin chọn<br/>
                Hệ sinh thái suất ăn HuitMeal
            </h1>
            <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto">
                Bữa ăn chất lượng không chỉ nạp năng lượng mà còn là phúc lợi giữ chân nhân tài. Lắng nghe những chia sẻ chân thực nhất từ các đối tác.
            </p>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="max-w-7xl mx-auto px-6 -mt-10 relative z-20">
        <div class="bg-white rounded-2xl shadow-xl flex flex-wrap justify-between items-center p-8 border border-gray-100">
            <div class="w-full md:w-1/3 text-center mb-6 md:mb-0 border-r-0 md:border-r border-gray-200">
                <div class="text-4xl font-black text-green-600 mb-2">98%</div>
                <div class="text-gray-600 font-medium">Đối tác đánh giá Hài lòng</div>
            </div>
            <div class="w-full md:w-1/3 text-center mb-6 md:mb-0 border-r-0 md:border-r border-gray-200">
                <div class="text-4xl font-black text-orange-500 mb-2">5,000+</div>
                <div class="text-gray-600 font-medium">Bữa ăn được phục vụ mỗi ngày</div>
            </div>
            <div class="w-full md:w-1/3 text-center">
                <div class="text-4xl font-black text-blue-600 mb-2">0</div>
                <div class="text-gray-600 font-medium">Sự cố ngộ độc thực phẩm (10 năm)</div>
            </div>
        </div>
    </div>

    <!-- Testimonials Grid -->
    <div class="max-w-7xl mx-auto px-6 py-20">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Câu Chuyện Thành Công</h2>
            <div class="w-24 h-1 bg-orange-500 mx-auto rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            <!-- Card 1 -->
            <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-gray-100 hover:-translate-y-2 transition-all duration-300 relative group">
                <i data-lucide="quote" class="absolute top-6 right-6 w-10 h-10 text-orange-100 group-hover:text-orange-200 transition"></i>
                <div class="flex gap-1 mb-6">
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                </div>
                <p class="text-gray-700 leading-relaxed mb-8 relative z-10 italic">
                    "Suất ăn của HUITMEAL luôn đảm bảo độ tươi mới và nóng hổi. Đặc biệt, quy trình kiểm duyệt an toàn vệ sinh thực phẩm 100% đạt chuẩn ISO giúp chúng tôi hoàn toàn yên tâm khi giao phó 2.000 bữa ăn mỗi ca cho toàn thể cán bộ chuyên gia."
                </p>
                <div class="flex items-center gap-4 mt-auto">
                    <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&background=e0f2fe&color=0369a1&bold=true" alt="Avatar" class="w-12 h-12 rounded-full ring-2 ring-gray-100">
                    <div>
                        <h4 class="font-bold text-gray-900">Ông Nguyễn Văn An</h4>
                        <p class="text-sm text-gray-500">Giám đốc Hành chính NS - <span class="font-semibold">Công ty TNHH Samsung Vina</span></p>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-gray-100 hover:-translate-y-2 transition-all duration-300 relative group">
                <i data-lucide="quote" class="absolute top-6 right-6 w-10 h-10 text-orange-100 group-hover:text-orange-200 transition"></i>
                <div class="flex gap-1 mb-6">
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                </div>
                <p class="text-gray-700 leading-relaxed mb-8 relative z-10 italic">
                    "Thực đơn thay đổi đa dạng suốt cả tháng, các bạn nhân viên chia đồ ăn của HuitMeal cực kỳ chuyên nghiệp và niềm nở. Từ khi chuyển sang sử dụng dịch vụ của HuitMeal, tỷ lệ nhân viên từ chối ăn tại nhà máy giảm xuống còn 0%."
                </p>
                <div class="flex items-center gap-4 mt-auto">
                    <img src="https://ui-avatars.com/api/?name=Tran+Bich&background=fce7f3&color=be185d&bold=true" alt="Avatar" class="w-12 h-12 rounded-full ring-2 ring-gray-100">
                    <div>
                        <h4 class="font-bold text-gray-900">Bà Trần Thị Bích</h4>
                        <p class="text-sm text-gray-500">Trưởng phòng Nhân sự - <span class="font-semibold">Tập đoàn Canon</span></p>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-gray-100 hover:-translate-y-2 transition-all duration-300 relative group">
                <i data-lucide="quote" class="absolute top-6 right-6 w-10 h-10 text-orange-100 group-hover:text-orange-200 transition"></i>
                <div class="flex gap-1 mb-6">
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 text-yellow-400"></i> <!-- 4.5 sao demo -->
                </div>
                <p class="text-gray-700 leading-relaxed mb-8 relative z-10 italic">
                    "Chúng tôi đánh giá rất cao khả năng cung ứng lượng lớn thực phẩm một lúc của bếp ăn trung tâm HuitMeal mà vẫn đảm bảo tính đồng đều về cả định lượng và hương vị. Lắng nghe phản hồi nhanh chóng và sửa đổi ngay lập tức! Thật sự xuất sắc."
                </p>
                <div class="flex items-center gap-4 mt-auto">
                    <img src="https://ui-avatars.com/api/?name=Le+Hoang&background=dcfce7&color=15803d&bold=true" alt="Avatar" class="w-12 h-12 rounded-full ring-2 ring-gray-100">
                    <div>
                        <h4 class="font-bold text-gray-900">Ông Lê Hoàng</h4>
                        <p class="text-sm text-gray-500">Giám đốc Điều hành - <span class="font-semibold">Cty Thiết bị KCN Sóng Thần</span></p>
                    </div>
                </div>
            </div>
            
            <!-- Card 4 -->
            <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-gray-100 hover:-translate-y-2 transition-all duration-300 relative group">
                <i data-lucide="quote" class="absolute top-6 right-6 w-10 h-10 text-orange-100 group-hover:text-orange-200 transition"></i>
                <div class="flex gap-1 mb-6">
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                    <i data-lucide="star" class="w-5 h-5 fill-yellow-400 text-yellow-400"></i>
                </div>
                <p class="text-gray-700 leading-relaxed mb-8 relative z-10 italic">
                    "Học sinh cực kỳ thích các bữa trưa do HuitMeal chuẩn bị vì đồ ăn mang đậm tính truyền thống nhưng cũng có biến tấu hiện đại. Phụ huynh cũng khen ngợi hết lời vì mô hình kiểm tra thực phẩm khép kín bằng công nghệ quét mã QR."
                </p>
                <div class="flex items-center gap-4 mt-auto">
                    <img src="https://ui-avatars.com/api/?name=Phan+Lan&background=fef3c7&color=b45309&bold=true" alt="Avatar" class="w-12 h-12 rounded-full ring-2 ring-gray-100">
                    <div>
                        <h4 class="font-bold text-gray-900">Cô Phan Mai Lan</h4>
                        <p class="text-sm text-gray-500">Hiệu trưởng - <span class="font-semibold">Hệ thống Trường Liên Cấp Alpha</span></p>
                    </div>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-gray-100 hover:-translate-y-2 transition-all duration-300 relative group md:col-span-2 lg:col-span-2 flex flex-col justify-center">
                <h3 class="text-xl font-bold mb-4 text-gray-900">Cùng đồng hành với +50 Tập đoàn đa quốc gia</h3>
                <p class="text-gray-600 mb-6">Ngoài các đối tác kể trên, HuitMeal còn vinh dự là nhà cung ứng thực phẩm chiến lược lâu năm của hàng loạt khu chế xuất tập đoàn công nghệ lớn tại Bắc Ninh, Thái Nguyên, Bình Dương và TP. Hồ Chí Minh. Chất lượng - An Toàn - Trách nhiệm luôn là tôn chỉ của chúng tôi.</p>
                <div class="flex justify-start">
                    <a href="/Customer/Partners" class="inline-flex items-center gap-2 text-orange-500 font-bold hover:text-orange-600 transition group-hover:gap-3">
                        Xem tất cả hồ sơ Đối tác
                        <i data-lucide="arrow-right" class="w-5 h-5"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>

    <!-- Call to action block -->
    <div class="bg-orange-500 text-white py-16">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold mb-6">Nâng tầm phúc lợi công ty bạn ngay hôm nay!</h2>
            <p class="text-lg opacity-90 mb-8">
                Tặng miễn phí bản dùng thử thực đơn thiết kế cá nhân hoá dành riêng cho đặc thù lao động của doanh nghiệp bạn trong tuần đầu tiên.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/Customer/Contact" class="bg-white text-orange-600 font-bold px-8 py-3 rounded-lg shadow-lg hover:bg-gray-50 transition border-2 border-transparent">
                    Nhận Báo Giá Tư Vấn
                </a>
                <a href="#navbar" class="bg-orange-600 border border-orange-400 text-white font-bold px-8 py-3 rounded-lg hover:bg-orange-700 transition">
                    Đăng ký làm khách hàng
                </a>
            </div>
        </div>
    </div>

</div>
