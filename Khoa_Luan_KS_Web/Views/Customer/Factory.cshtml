@{
    ViewData["Title"] = "Suất ăn công nhân - HuitMeal";
    Layout = "_LayoutCustomer";
}

<div class="w-full bg-white overflow-hidden">
    <!-- ===== HERO SECTION ===== -->
    <section class="relative min-h-[65vh] lg:min-h-[85vh] flex items-center overflow-hidden">
        <div class="absolute inset-0 z-0">
            <img src="/assets/images/factory_hero_premium.png" 
                 class="w-full h-full object-cover object-center scale-105" 
                 alt="Factory Meal Hero" />
            <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/50 to-white/10 md:bg-gradient-to-r md:from-black/90 md:via-black/40 md:to-transparent"></div>
        </div>

        <div class="container mx-auto px-6 relative z-10 py-20">
            <div class="max-w-4xl" data-animate="fade-right">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-orange-500/20 backdrop-blur-md border border-orange-500/30 rounded-full text-orange-400 text-[10px] font-black uppercase tracking-widest mb-8">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
                    </span>
                    Giải pháp suất ăn công nghiệp hàng đầu
                </div>
                <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white leading-[1.1] mb-8 tracking-tighter">
                    Suất ăn công nhân <br />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-200">
                        Nhanh - No - Đủ Chất
                    </span>
                </h1>
                <p class="text-lg md:text-xl text-gray-300 max-w-2xl mb-12 leading-relaxed font-medium">
                    Đảm bảo năng lượng bền bỉ cho đội ngũ lao động của bạn với quy trình chế biến khép kín, 
                    thực đơn đa dạng và cam kết an toàn thực phẩm tuyệt đối theo tiêu chuẩn quốc tế.
                </p>
                <div class="flex flex-wrap gap-5">
                    <a href="/Customer/Contact" class="px-10 py-5 bg-orange-500 text-white rounded-2xl font-bold text-sm shadow-2xl shadow-orange-500/40 hover:bg-orange-600 hover:-translate-y-1 transition-all active:scale-95 uppercase tracking-wider">
                        Tư vấn ngay 1-1
                    </a>
                    <a href="#menu" class="px-10 py-5 bg-white/10 backdrop-blur-md text-white border border-white/20 rounded-2xl font-bold text-sm hover:bg-white/20 transition-all flex items-center gap-3 uppercase tracking-wider">
                        Khám phá thực đơn <i data-lucide="arrow-down-circle" class="w-5 h-5"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Scroll Hint -->
        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce hidden md:block">
            <div class="w-[2px] h-12 bg-gradient-to-b from-orange-500 to-transparent rounded-full"></div>
        </div>
    </section>

    <!-- ===== TRUST STATS ===== -->
    <section class="relative z-20 -mt-20 container mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <div class="bg-white p-8 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-gray-100 flex flex-col items-center text-center group hover:border-orange-200 transition-all hover:-translate-y-1">
                <div class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center text-orange-500 mb-4 group-hover:bg-orange-500 group-hover:text-white transition-colors">
                    <i data-lucide="award" class="w-6 h-6"></i>
                </div>
                <span class="text-4xl font-black text-gray-900 mb-1">15+</span>
                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Năm kinh nghiệm</span>
            </div>
            <div class="bg-white p-8 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-gray-100 flex flex-col items-center text-center group hover:border-orange-200 transition-all hover:-translate-y-1">
                <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-500 mb-4 group-hover:bg-blue-500 group-hover:text-white transition-colors">
                    <i data-lucide="users" class="w-6 h-6"></i>
                </div>
                <span class="text-4xl font-black text-gray-900 mb-1">10k+</span>
                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Suất ăn mỗi ngày</span>
            </div>
            <div class="bg-white p-8 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-gray-100 flex flex-col items-center text-center group hover:border-orange-200 transition-all hover:-translate-y-1">
                <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center text-green-500 mb-4 group-hover:bg-green-500 group-hover:text-white transition-colors">
                    <i data-lucide="building" class="w-6 h-6"></i>
                </div>
                <span class="text-4xl font-black text-gray-900 mb-1">100+</span>
                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Đối tác tin dùng</span>
            </div>
            <div class="bg-white p-8 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-gray-100 flex flex-col items-center text-center group hover:border-orange-200 transition-all hover:-translate-y-1">
                <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center text-amber-500 mb-4 group-hover:bg-amber-500 group-hover:text-white transition-colors">
                    <i data-lucide="shield-check" class="w-6 h-6"></i>
                </div>
                <span class="text-4xl font-black text-gray-900 mb-1">HACCP</span>
                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">An toàn chuẩn mực</span>
            </div>
        </div>
    </section>

    <!-- ===== INTRO SECTION ===== -->
    <section class="py-32 bg-white overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-20 items-center">
                <div class="relative" data-animate="fade-left">
                    <div class="absolute -top-10 -left-10 w-64 h-64 bg-orange-100/50 rounded-full blur-[80px] z-0"></div>
                    <div class="relative z-10 rounded-[40px] overflow-hidden shadow-[0_40px_100px_-20px_rgba(0,0,0,0.2)] group">
                        <img src="/assets/images/modern_cafeteria_premium.png" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="Modern Cafeteria" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-10">
                            <p class="text-white font-medium italic text-xl leading-relaxed max-w-md">
                                "Một bữa ăn đủ chất là nền tảng bền vững cho sức khỏe và năng suất lao động."
                            </p>
                            <div class="mt-4 flex items-center gap-3">
                                <div class="w-10 h-[2px] bg-orange-500"></div>
                                <span class="text-orange-500 font-bold uppercase tracking-widest text-[10px]">Tầm nhìn HuitMeal</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div data-animate="fade-right">
                    <h2 class="text-[11px] font-black text-orange-500 uppercase tracking-[0.3em] mb-6 flex items-center gap-3">
                        <span class="w-8 h-[1px] bg-orange-500"></span> Tại sao chọn chúng tôi?
                    </h2>
                    <h3 class="text-3xl md:text-5xl font-black text-gray-900 mb-8 leading-[1.2] tracking-tight">
                        Giải pháp suất ăn <br /> doanh nghiệp <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500">toàn diện nhất</span>
                    </h3>
                    <div class="space-y-8">
                        <p class="text-lg text-gray-600 leading-relaxed">
                            Tại <span class="font-bold text-gray-900 border-b-2 border-orange-500/20">HuitMeal</span>, chúng tôi thấu hiểu rằng mỗi suất ăn là một lời cam kết về sức khỏe của người lao động. Chúng tôi tối ưu hóa mọi quy trình để mang lại giá trị cao nhất.
                        </p>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="flex gap-4 group">
                                <div class="w-12 h-12 shrink-0 rounded-2xl bg-orange-50 flex items-center justify-center text-orange-500 group-hover:bg-orange-500 group-hover:text-white transition-all">
                                    <i data-lucide="flame" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 mb-1">Nấu mới tại chỗ</h4>
                                    <p class="text-sm text-gray-500">Chế biến nóng hổi, phục vụ trực tiếp tại bếp ăn nhà máy.</p>
                                </div>
                            </div>
                            <div class="flex gap-4 group">
                                <div class="w-12 h-12 shrink-0 rounded-2xl bg-green-50 flex items-center justify-center text-green-500 group-hover:bg-green-500 group-hover:text-white transition-all">
                                    <i data-lucide="leaf" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 mb-1">Nguyên liệu sạch</h4>
                                    <p class="text-sm text-gray-500">100% nguồn gốc rõ ràng, kiểm tra khắt khe mỗi ngày.</p>
                                </div>
                            </div>
                            <div class="flex gap-4 group">
                                <div class="w-12 h-12 shrink-0 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-500 group-hover:bg-blue-500 group-hover:text-white transition-all">
                                    <i data-lucide="calendar-days" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 mb-1">Thực đơn 30 ngày</h4>
                                    <p class="text-sm text-gray-500">Thay đổi liên tục, không lặp lại món trong tháng.</p>
                                </div>
                            </div>
                            <div class="flex gap-4 group">
                                <div class="w-12 h-12 shrink-0 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-500 group-hover:bg-amber-500 group-hover:text-white transition-all">
                                    <i data-lucide="zap" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 mb-1">Phục vụ siêu tốc</h4>
                                    <p class="text-sm text-gray-500">Đảm bảo hàng ngàn suất ăn đúng giờ theo ca kíp.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== BENEFITS CARDS ===== -->
    <section class="bg-gray-50 py-32">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
                <h2 class="text-[11px] font-black text-orange-500 uppercase tracking-[0.3em] mb-4">Lợi ích thực tế</h2>
                <h3 class="text-3xl md:text-5xl font-black text-gray-900 mb-6 tracking-tight">An tâm tuyệt đối cho công nhân</h3>
                <p class="text-gray-500 font-medium">Chúng tôi không chỉ bán suất ăn, chúng tôi xây dựng niềm tin thông qua chất lượng từng bữa cơm.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Benefit 1 -->
                <div class="bg-white p-10 rounded-[32px] shadow-sm border border-gray-100 hover:shadow-[0_30px_60px_rgba(0,0,0,0.08)] hover:-translate-y-2 transition-all duration-500 group" data-animate="fade-up" data-delay="1">
                    <div class="w-16 h-16 rounded-3xl bg-orange-50 flex items-center justify-center text-orange-500 mb-8 group-hover:bg-orange-500 group-hover:text-white transition-all">
                        <i data-lucide="utensils-cross" class="w-8 h-8"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-4 tracking-tight">Ăn ngon & No lâu</h4>
                    <p class="text-gray-500 text-sm leading-relaxed">Định lượng chuẩn, nhiều cơm và thức ăn để đảm bảo sức lao động cường độ cao.</p>
                </div>
                <!-- Benefit 2 -->
                <div class="bg-white p-10 rounded-[32px] shadow-sm border border-gray-100 hover:shadow-[0_30px_60px_rgba(0,0,0,0.08)] hover:-translate-y-2 transition-all duration-500 group" data-animate="fade-up" data-delay="2">
                    <div class="w-16 h-16 rounded-3xl bg-green-50 flex items-center justify-center text-green-500 mb-8 group-hover:bg-green-500 group-hover:text-white transition-all">
                        <i data-lucide="heart-pulse" class="w-8 h-8"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-4 tracking-tight">Sức khỏe bền bỉ</h4>
                    <p class="text-gray-500 text-sm leading-relaxed">Cân đối đạm, tinh bột và chất xơ từ rau xanh tươi sạch mỗi ngày.</p>
                </div>
                <!-- Benefit 3 -->
                <div class="bg-white p-10 rounded-[32px] shadow-sm border border-gray-100 hover:shadow-[0_30px_60px_rgba(0,0,0,0.08)] hover:-translate-y-2 transition-all duration-500 group" data-animate="fade-up" data-delay="3">
                    <div class="w-16 h-16 rounded-3xl bg-blue-50 flex items-center justify-center text-blue-500 mb-8 group-hover:bg-blue-500 group-hover:text-white transition-all">
                        <i data-lucide="smile" class="w-8 h-8"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-4 tracking-tight">Thoải mái tinh thần</h4>
                    <p class="text-gray-500 text-sm leading-relaxed">Không gian phục vụ chuyên nghiệp, sạch sẽ giúp giờ nghỉ trưa thư giãn hơn.</p>
                </div>
                <!-- Benefit 4 -->
                <div class="bg-white p-10 rounded-[32px] shadow-sm border border-gray-100 hover:shadow-[0_30px_60px_rgba(0,0,0,0.08)] hover:-translate-y-2 transition-all duration-500 group" data-animate="fade-up" data-delay="4">
                    <div class="w-16 h-16 rounded-3xl bg-amber-50 flex items-center justify-center text-amber-500 mb-8 group-hover:bg-amber-500 group-hover:text-white transition-all">
                        <i data-lucide="badge-check" class="w-8 h-8"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-4 tracking-tight">Bảo hiểm suất ăn</h4>
                    <p class="text-gray-500 text-sm leading-relaxed">Trách nhiệm pháp lý và bảo hiểm an toàn thực phẩm mức cao nhất cho khách hàng.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== TODAY'S SPECIAL ===== -->
    <section class="py-32 bg-white">
        <div class="container mx-auto px-6">
            <div class="bg-[#0F172A] rounded-[48px] overflow-hidden shadow-2xl relative">
                <div class="absolute top-0 right-0 p-12 opacity-10 pointer-events-none">
                    <i data-lucide="sparkles" class="w-64 h-64 text-white"></i>
                </div>
                
                <div class="grid lg:grid-cols-2 items-center">
                    <div class="p-12 md:p-20 relative z-10" data-animate="fade-right">
                        <div class="inline-flex items-center gap-2 px-3 py-1 bg-yellow-500/10 border border-yellow-500/20 rounded-full text-yellow-400 text-[10px] font-black uppercase tracking-[0.2em] mb-8">
                            Món ngon trong tuần
                        </div>
                        <h3 class="text-4xl md:text-6xl font-black text-white mb-6 leading-tight tracking-tight">
                            Bánh canh <br /> <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-400">cá lóc đồng</span>
                        </h3>
                        <p class="text-lg text-gray-400 mb-10 leading-relaxed font-medium">
                            Vị ngọt thanh từ xương cá, sợi bánh dai mềm đặc trưng cùng hương thơm ngào ngạt của rau răm, hành lá. 
                            Một bữa ăn bùng nổ hương vị truyền thống ngay tại bếp ăn nhà máy.
                        </p>
                        <div class="flex items-center gap-8 border-t border-white/5 pt-8">
                            <div>
                                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Năng lượng</p>
                                <p class="text-white font-bold">550 Kcal</p>
                            </div>
                            <div class="w-[1px] h-8 bg-white/5"></div>
                            <div>
                                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Tình trạng</p>
                                <p class="text-green-400 font-bold">Đang phục vụ</p>
                            </div>
                        </div>
                    </div>
                    <div class="relative h-full min-h-[400px] lg:min-h-[600px]" data-animate="fade-left">
                        <img src="/assets/images/special_dish_premium.png" class="absolute inset-0 w-full h-full object-cover object-center" alt="Banh Canh Ca Loc" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== MEALS SHOWCASE ===== -->
    <section id="menu" class="bg-gray-50 py-32" x-data="{ tab: 'man' }">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
                <h2 class="text-[11px] font-black text-orange-500 uppercase tracking-[0.3em] mb-4">Gợi ý hôm nay</h2>
                <h3 class="text-3xl md:text-5xl font-black text-gray-900 mb-8 tracking-tight">Thực đơn điển hình</h3>
                
                <!-- Advanced Tabs -->
                <div class="inline-flex bg-white p-2 rounded-2xl shadow-lg border border-gray-100">
                    <button x-on:click="tab = 'man'" 
                            :class="tab === 'man' ? 'bg-gray-900 text-white shadow-lg scale-105' : 'text-gray-500 hover:text-gray-900'"
                            class="px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest transition-all duration-300">
                        Món mặn
                    </button>
                    <button x-on:click="tab = 'chay'" 
                            :class="tab === 'chay' ? 'bg-green-600 text-white shadow-lg scale-105' : 'text-gray-500 hover:text-green-600'"
                            class="px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest transition-all duration-300">
                        Món chay
                    </button>
                </div>
            </div>

            <!-- MÓN MẶN GRID -->
            <div x-show="tab === 'man'" x-transition.opacity.duration.500ms class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Meal 1 -->
                <div class="bg-white rounded-[32px] overflow-hidden hover:shadow-[0_30px_70px_rgba(0,0,0,0.12)] hover:-translate-y-2 transition-all duration-500 flex flex-col h-full group border border-gray-100">
                    <div class="relative h-[240px] overflow-hidden">
                        <img src="https://suatancongnghiepthuyluan.com/wp-content/uploads/2022/12/8f83343e085dd003894c22-e1671504623220.jpg" 
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        <div class="absolute top-5 left-5 bg-white/90 backdrop-blur-md px-4 py-1.5 rounded-full text-[10px] font-black text-orange-600 shadow-sm">20,000 VND</div>
                    </div>
                    <div class="p-8 flex flex-col flex-grow">
                        <h4 class="text-xl font-black text-gray-900 mb-4 tracking-tight">Suất Tiết Kiệm</h4>
                        <div class="space-y-3 mb-8 flex-grow">
                            <div class="flex items-center gap-3 text-sm text-gray-500 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span> Tôm rim thịt cháy cạnh
                            </div>
                            <div class="flex items-center gap-3 text-sm text-gray-500 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span> Khoai tây xào lá hẹ
                            </div>
                            <div class="flex items-center gap-3 text-sm text-gray-500 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span> Canh bí đao nấu giò
                            </div>
                        </div>
                        <a href="/Customer/MealDetail" class="mt-auto block text-center w-full py-4 bg-gray-50 text-gray-900 font-black text-[10px] uppercase tracking-widest rounded-2xl hover:bg-orange-500 hover:text-white transition-all shadow-sm">
                            Xem chi tiết
                        </a>
                    </div>
                </div>

                <!-- Meal 2 -->
                <div class="bg-white rounded-[32px] overflow-hidden hover:shadow-[0_30px_70px_rgba(0,0,0,0.12)] hover:-translate-y-2 transition-all duration-500 flex flex-col h-full group border border-gray-100">
                    <div class="relative h-[240px] overflow-hidden">
                        <div class="absolute top-5 left-5 z-10 bg-red-500 text-white text-[9px] font-black px-4 py-1.5 rounded-full shadow-lg tracking-widest">PHỔ BIẾN NHẤT</div>
                        <img src="https://suatancongnghiepphumy.com/public/userfiles/services/25k/suat-an-cong-nghiep-25k-cong-nhan-vien-6.jpg" 
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        <div class="absolute bottom-5 right-5 bg-white/90 backdrop-blur-md px-4 py-1.5 rounded-full text-[10px] font-black text-orange-600 shadow-sm">25,000 VND</div>
                    </div>
                    <div class="p-8 flex flex-col flex-grow">
                        <h4 class="text-xl font-black text-gray-900 mb-4 tracking-tight">Suất Tiêu Chuẩn</h4>
                        <div class="space-y-3 mb-8 flex-grow">
                            <div class="flex items-center gap-3 text-sm text-gray-500 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Ba rọi khìa nước dừa
                            </div>
                            <div class="flex items-center gap-3 text-sm text-gray-500 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Rau muống tỏi giòn
                            </div>
                            <div class="flex items-center gap-3 text-sm text-gray-500 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Canh chua cá bông lau
                            </div>
                        </div>
