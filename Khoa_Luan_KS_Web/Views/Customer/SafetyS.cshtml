@{
    ViewData["Title"] = "Vệ sinh công nghiệp";
    Layout = "_LayoutCustomer";
}

<div class="w-full">
    <!-- ================= HERO ================= -->
    <section class="relative h-[500px]">
        <img src="/assets/images/banner-service.jpg" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center text-center">
            <h1 class="text-5xl font-bold text-white">
                <span class="bg-yellow-400 text-black px-3 py-1">Dịch vụ</span> HuitMeal
            </h1>
        </div>
    </section>

    <!-- ================= GIỚI THIỆU ================= -->
    <section class="px-20 py-16">
        <div class="grid grid-cols-2">
            <!-- LEFT -->
            <div class="grid grid-rows-2 h-[520px]">
                <div class="bg-[#f5f1e8] p-10 flex items-center">
                    <h2 class="text-4xl font-bold leading-tight">
                        Tiên phong trong <br />
                        <span class="bg-yellow-400 px-2">ngành vệ sinh công nghiệp</span>
                    </h2>
                </div>
                <img src="/assets/images/anh1.jpg" class="w-full h-full object-cover" />
            </div>
            <!-- RIGHT -->
            <div class="relative h-[520px]">
                <img src="/assets/images/anh2.jpg" class="w-full h-full object-cover" />
                <div class="absolute bottom-0 left-0 right-0 bg-black/40 text-white p-6">
                    <p class="leading-relaxed">
                        Với sứ mệnh cung cấp dịch vụ chất lượng – an toàn – chu đáo – tin cậy – tiết kiệm, HUITMEAL đang dần khẳng định vị thế của mình là doanh nghiệp đi đầu trong ngành vệ sinh công nghiệp tại Việt Nam.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION ĐEN ================= -->
    <section class="relative px-6 md:px-16 py-24 overflow-hidden bg-gradient-to-r from-[#2b2b2b] to-[#1f1f1f]">
        <div class="absolute inset-0 bg-black/20 z-0"></div>
        <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 items-center">
            <!-- LEFT -->
            <div class="max-w-xl text-white">
                <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
                    <span class="bg-yellow-400 text-black px-3 py-1 inline-block">Vệ sinh tổng thể</span>
                    <span class="text-gray-200">cho không gian hoàn hảo</span>
                </h2>
                <p class="text-gray-300 mb-8 leading-relaxed text-sm md:text-base max-w-md">
                    Tại những khu vực có diện tích lớn, không dễ dàng để có thể vệ sinh toàn diện một cách bài bản. Muốn không gian được vệ sinh sạch sẽ, ngoài nhân công còn cần sự giúp sức của máy móc, thiết bị phù hợp. Hiểu được vấn đề này, HUITMEAL đã phát triển dịch vụ vệ sinh công nghiệp trong chặng đường đa dạng hóa loại hình dịch vụ của mình, đảm bảo mục tiêu mang lại những sự tiện lợi tối đa cho doanh nghiệp.
                </p>
                <a href="/Customer/ChooseHuitMeal">
                    <button class="bg-orange-500 hover:bg-orange-600 transition px-6 py-3 rounded-full font-semibold">CHỌN HUITMEAL</button>
                </a>
            </div>
            <!-- RIGHT -->
            <div class="relative flex justify-end">
                <div class="absolute right-[-150px] bottom-[-180px] w-[800px] h-[500px] bg-yellow-400 rounded-[50%] z-0"></div>
                <img src="/assets/images/anh4.png" alt="cleaning machine" class="relative z-10 w-[700px] max-w-none translate-x-24 translate-y-20" />
            </div>
        </div>
    </section>

    <!-- ================= DỊCH VỤ ================= -->
    <section class="px-4 sm:px-6 md:px-10 lg:px-20 py-10 md:py-16">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6 md:mb-10 text-center">
            <span class="bg-yellow-400 px-2">Đa dạng</span> dịch vụ
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-0 rounded-xl md:rounded-2xl overflow-hidden">
            <!-- LEFT -->
            <div class="lg:col-span-2 flex flex-col">
                <div class="grid grid-cols-1 sm:grid-cols-2">
                    <div class="relative h-[200px] sm:h-[220px] md:h-[200px] overflow-hidden">
                        <img src="/assets/images/anh5.jpg" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-black/30"></div>
                        <p class="absolute bottom-2 left-2 text-white text-sm md:text-base font-semibold">Dịch vụ vệ sinh sau xây dựng</p>
                    </div>
                    <div class="relative h-[200px] sm:h-[220px] md:h-[200px] overflow-hidden">
                        <img src="/assets/images/anh6.jpg" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-black/30"></div>
                        <p class="absolute bottom-2 left-2 text-white text-sm md:text-base font-semibold">Dịch vụ giặt thảm, ghế sofa</p>
                    </div>
                </div>
                <!-- IMG 7 -->
                <div class="relative h-[250px] sm:h-[300px] md:h-[400px] lg:h-[500px] overflow-hidden">
                    <img src="/assets/images/anh7.jpg" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-black/30"></div>
                    <p class="absolute bottom-2 left-2 text-white text-sm md:text-base font-semibold">Xử lý phục hồi đánh bóng sàn đá Marble, granite</p>
                </div>
            </div>
            <!-- RIGHT -->
            <div class="flex flex-col">
                <!-- IMG 3 -->
                <div class="relative h-[220px] sm:h-[260px] md:h-[300px] lg:h-[440px] overflow-hidden">
                    <img src="/assets/images/anh3.jpg" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-black/30"></div>
                    <p class="absolute bottom-2 left-2 text-white text-sm md:text-base font-semibold">Dịch vụ tổng vệ sinh siêu thị, nhà xưởng</p>
                </div>
                <!-- IMG 8 + 9 -->
                <div class="grid grid-cols-2">
                    <div class="relative h-[140px] sm:h-[160px] md:h-[200px] lg:h-[260px] overflow-hidden">
                        <img src="/assets/images/anh8.jpg" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-black/30"></div>
                        <p class="absolute bottom-2 left-2 text-white text-xs sm:text-sm font-semibold">Vệ sinh theo giờ</p>
                    </div>
                    <div class="relative h-[140px] sm:h-[160px] md:h-[200px] lg:h-[260px] overflow-hidden">
                        <img src="/assets/images/anh9.jpg" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-black/30"></div>
                        <p class="absolute bottom-2 left-2 text-white text-xs sm:text-sm font-semibold">Đánh bóng sàn đá</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= ƯU ĐIỂM ================= -->
    <section class="bg-gray-100 px-10 md:px-20 py-16" x-data="{ active: null }">
        <h2 class="text-4xl font-bold mb-10 text-center">
            <span class="bg-yellow-400 px-2">Ưu điểm</span> HUITMEAL
        </h2>
        <div class="space-y-4 max-w-4xl mx-auto">
            <!-- Item 1 -->
            <div class="rounded overflow-hidden shadow">
                <div x-on:click="active = active === 0 ? null : 0" :class="active === 0 ? 'bg-yellow-400 text-black' : 'bg-[#e9e4d8]'" class="flex justify-between items-center px-6 py-5 cursor-pointer transition">
                    <span class="font-semibold text-lg">Tận tâm trong công việc</span>
                    <span class="text-2xl font-bold" x-text="active === 0 ? '−' : '+'"></span>
                </div>
                <div x-show="active === 0" style="display: none;" class="bg-white px-6 py-6 border border-yellow-400">
                    <p class="text-gray-700 leading-relaxed">Với tinh thần phục vụ khách hàng bằng sự trách nhiệm, chuyên nghiệp, mọi công đoạn vệ sinh đều được HUITMEAL chú trọng. Ngoài ra, HUITMEAL không ngừng nỗ lực đa dạng hóa dịch vụ để có thể đáp ứng đầy đủ những nhu cầu phát sinh và mang đến sự thuận tiện nhất cho khách hàng.</p>
                </div>
            </div>
             <!-- Item 2 -->
            <div class="rounded overflow-hidden shadow">
                <div x-on:click="active = active === 1 ? null : 1" :class="active === 1 ? 'bg-yellow-400 text-black' : 'bg-[#e9e4d8]'" class="flex justify-between items-center px-6 py-5 cursor-pointer transition">
                    <span class="font-semibold text-lg">Thiết bị hiện đại, hóa chất an toàn</span>
                    <span class="text-2xl font-bold" x-text="active === 1 ? '−' : '+'"></span>
                </div>
                <div x-show="active === 1" style="display: none;" class="bg-white px-6 py-6 border border-yellow-400">
                    <p class="text-gray-700 leading-relaxed">Vệ sinh công nghiệp tại các khu vực lớn cần có sự tham gia của nhiều máy móc, thiết bị chuyên dụng để đảm bảo cho việc vệ sinh sau khi hoàn thành đạt chất lượng tối ưu nhất. Đặc biệt, HUITMEAL luôn sử dụng những hóa chất thân thiện với môi trường, không gây ảnh hưởng đến sức khỏe con người.</p>
                </div>
            </div>
             <!-- Item 3 -->
            <div class="rounded overflow-hidden shadow">
                <div x-on:click="active = active === 2 ? null : 2" :class="active === 2 ? 'bg-yellow-400 text-black' : 'bg-[#e9e4d8]'" class="flex justify-between items-center px-6 py-5 cursor-pointer transition">
                    <span class="font-semibold text-lg">Đội ngũ chuyên nghiệp, thực hiện nhanh chóng</span>
                    <span class="text-2xl font-bold" x-text="active === 2 ? '−' : '+'"></span>
                </div>
                <div x-show="active === 2" style="display: none;" class="bg-white px-6 py-6 border border-yellow-400">
                    <p class="text-gray-700 leading-relaxed">Đội ngũ HUITMEAL được đào tạo bài bản về chuyên môn và vô cùng giàu kinh nghiệm. Nhờ đó, quy trình vệ sinh sẽ được tiến hành một cách bài bản, chuyên nghiệp. Cũng vì vậy, khách hàng không phải lo lắng về việc thời gian vệ sinh kéo dài, ảnh hưởng đến trải nghiệm người mua tại cửa hàng hoặc trì trệ kinh doanh.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= CTA ================= -->
    <section class="relative h-[320px] overflow-hidden">
        <img src="/assets/images/s4.jpg" class="absolute inset-0 w-full h-full object-cover object-center scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-transparent"></div>
        <div class="relative z-10 h-full flex flex-col justify-center px-10 md:px-20">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">Bạn vẫn băn khoăn về dịch vụ?</h2>
            <p class="text-gray-200 mb-6">HUITMEAL có thể giúp bạn.</p>
            <a href="/Customer/Contact" class="w-fit">
                <button class="bg-orange-500 hover:bg-orange-600 transition text-white px-6 py-3 rounded-full font-semibold">TƯ VẤN 1-1 MIỄN PHÍ</button>
            </a>
        </div>
    </section>
</div>
