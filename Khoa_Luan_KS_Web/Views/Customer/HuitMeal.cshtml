@{
    ViewData["Title"] = "Bản tin HuitMeal - Kết nối & Phát triển";
    Layout = "_LayoutCustomer";

    var posts = new[] {
        new { Id = 1, Title = "ĐẠI TIỆC ÂM NHẠC – HUITMEAL MUSIC FESTIVAL 2024", Date = "10/01/2024", Category = "Hoạt động nội bộ", Image = "/assets/images/t1.jpg", Excerpt = "Chương trình ca nhạc nội bộ hoành tráng để chúc mừng thành công của tập đoàn trong năm qua, quy tụ dàn nghệ sĩ hàng đầu...", ReadTime = "5 phút đọc" },
        new { Id = 2, Title = "LỄ KÝ KẾT HỢP TÁC CHIẾN LƯỢC TOÀN DIỆN", Date = "15/02/2024", Category = "Hợp tác phát triển", Image = "/assets/images/t2.jpg", Excerpt = "HuitMeal chính thức bắt tay cùng đối tác quốc tế để mở rộng thị trường và nâng tầm dịch vụ suất ăn công nghiệp lên chuẩn 5 sao...", ReadTime = "3 phút đọc" },
        new { Id = 3, Title = "BỮA ĂN YÊU THƯƠNG – HUITMEAL GẮN KẾT CỘNG ĐỒNG", Date = "05/03/2024", Category = "Tin tức 24h", Image = "/assets/images/t3.jpg", Excerpt = "Dự án từ thiện chia sẻ khó khăn cùng đồng bào vùng cao, mang đến hàng ngàn suất ăn nóng sốt và đầy đủ dinh dưỡng...", ReadTime = "4 phút đọc" },
        new { Id = 4, Title = "HỘI NGHỊ TỔNG KẾT KINH DOANH QUÝ I/2024", Date = "20/04/2024", Category = "Hoạt động nội bộ", Image = "/assets/images/t4.jpg", Excerpt = "Đánh giá hoạt động quý đầu năm, vinh danh những cá nhân xuất sắc và đề ra chiến lược bứt phá cho các quý tiếp theo...", ReadTime = "6 phút đọc" },
    };

    var featured = posts.First();
    var otherPosts = posts.Skip(1);
}

<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeInUp {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .glass-pill {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
</style>

<div class="w-full bg-white overflow-hidden">
    <!-- HERO SECTION -->
    <section class="relative h-[500px] md:h-[650px] flex items-center overflow-hidden">
        <div class="absolute inset-0">
            <img src="/assets/images/news_hero.png" alt="News Hero" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
        </div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 w-full animate-fadeInUp">
            <div class="max-w-2xl">
                <span class="inline-block px-4 py-1.5 mb-6 text-[10px] font-black tracking-[0.3em] uppercase text-white glass-pill rounded-full">News & Stories</span>
                <h1 class="text-4xl md:text-7xl font-black text-white leading-[1.1] mb-6">
                    Bản Tin <br />
                    <span class="text-red-500">HuitMeal</span>
                </h1>
                <p class="text-gray-300 text-lg md:text-xl font-light leading-relaxed mb-8 border-l-4 border-red-500 pl-6">
                    "Doanh nghiệp chỉ có thể phát triển nếu xã hội xung quanh phát triển".
                    Hành trình kiến tạo giá trị bền vững.
                </p>
            </div>
        </div>
    </section>

    <!-- CONTENT SECTION -->
    <section class="py-24 bg-gray-50/50">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <div class="flex flex-col lg:flex-row gap-16">
                
                <!-- MAIN COLUMN -->
                <div class="flex-1">
                    
                    <!-- FEATURED POST -->
                    <div class="mb-20 animate-fadeInUp">
                        <div class="group relative overflow-hidden rounded-[48px] bg-white shadow-2xl border border-gray-100 flex flex-col md:flex-row h-full md:h-[450px]">
                            <div class="md:w-1/2 overflow-hidden h-64 md:h-full">
                                <img src="@featured.Image" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            </div>
                            <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center">
                                <div class="flex items-center gap-3 mb-6">
                                    <span class="px-3 py-1 bg-red-600 text-white text-[10px] font-black uppercase tracking-widest rounded-lg">Nổi bật</span>
                                    <span class="text-xs text-gray-400 font-bold uppercase tracking-widest">@featured.Category</span>
                                </div>
                                <h2 class="text-2xl md:text-3xl font-black text-gray-900 mb-6 group-hover:text-red-600 transition-colors leading-tight">
                                    @featured.Title
                                </h2>
                                <p class="text-gray-500 text-sm md:text-base leading-relaxed mb-8 line-clamp-3 font-light">
                                    @featured.Excerpt
                                </p>
                                <div class="flex items-center justify-between mt-auto">
                                    <div class="flex items-center gap-3 text-[11px] text-gray-400 font-bold">
                                        <i data-lucide="calendar" class="w-4 h-4"></i> @featured.Date
                                    </div>
                                    <a href="/Customer/PostDetail/@featured.Id" class="flex items-center gap-2 text-xs font-black text-red-600 group">
                                        Đọc tiếp <i data-lucide="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-2"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NEWS GRID -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                        @foreach (var post in otherPosts)
                        {
                            <article class="group animate-fadeInUp">
                                <div class="bg-white rounded-[40px] overflow-hidden border border-gray-100 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 flex flex-col h-full">
                                    <div class="relative h-64 overflow-hidden">
                                        <img src="@post.Image" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                                        <div class="absolute top-6 left-6">
                                            <span class="px-4 py-2 bg-white/90 backdrop-blur-md rounded-2xl text-[10px] font-black uppercase tracking-widest text-gray-900 shadow-lg">@post.Category</span>
                                        </div>
                                    </div>
                                    <div class="p-8 flex flex-col flex-1">
                                        <div class="flex items-center gap-4 text-[10px] text-gray-400 font-black uppercase tracking-widest mb-4">
                                            <span>@post.Date</span>
                                            <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                                            <span>@post.ReadTime</span>
                                        </div>
                                        <h3 class="text-xl font-bold text-gray-900 mb-4 line-clamp-2 group-hover:text-red-600 transition-colors leading-tight">
                                            @post.Title
                                        </h3>
                                        <p class="text-gray-500 text-sm leading-relaxed line-clamp-3 mb-8 font-light">
                                            @post.Excerpt
                                        </p>
                                        <div class="mt-auto">
                                            <a href="/Customer/PostDetail/@post.Id" class="inline-flex items-center gap-2 text-xs font-black text-red-600 group/link">
                                                KHÁM PHÁ <i data-lucide="chevron-right" class="w-4 h-4 transition-transform group-hover/link:translate-x-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    <!-- PAGINATION -->
                    <div class="flex justify-center mt-20 gap-3 items-center">
                        <button class="w-12 h-12 flex items-center justify-center bg-white rounded-2xl border border-gray-100 shadow-sm hover:bg-red-600 hover:text-white transition-all">
                            <i data-lucide="chevron-left" class="w-5 h-5"></i>
                        </button>
                        <button class="w-12 h-12 rounded-2xl bg-red-600 text-white font-black shadow-lg shadow-red-600/30">1</button>
                        <button class="w-12 h-12 flex items-center justify-center bg-white rounded-2xl border border-gray-100 shadow-sm hover:bg-red-600 hover:text-white transition-all text-gray-400">2</button>
                        <button class="w-12 h-12 flex items-center justify-center bg-white rounded-2xl border border-gray-100 shadow-sm hover:bg-red-600 hover:text-white transition-all">
                            <i data-lucide="chevron-right" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>

                <!-- SIDEBAR -->
                <aside class="w-full lg:w-80 space-y-12">
                    
                    <!-- SEARCH -->
                    <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100">
                        <h3 class="text-lg font-black text-gray-900 mb-6 uppercase tracking-widest">Tìm kiếm</h3>
                        <div class="relative">
                            <input type="text" placeholder="Nhập từ khóa..." class="w-full px-6 py-4 bg-gray-50 rounded-2xl border-none focus:ring-2 focus:ring-red-600 text-sm font-medium" />
                            <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-600 transition-colors">
                                <i data-lucide="search" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>

                    <!-- CATEGORIES -->
                    <div class="bg-gray-900 p-10 rounded-[40px] text-white shadow-2xl relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-red-600/10 rounded-full -mr-16 -mt-16 blur-3xl"></div>
                        <h3 class="text-lg font-black mb-8 uppercase tracking-widest text-red-500">Danh mục</h3>
                        <ul class="space-y-4">
                            <li><a href="#" class="flex items-center justify-between group py-2">
                                <span class="text-sm font-bold text-gray-300 group-hover:text-white transition-colors">Tất cả</span>
                                <span class="text-[10px] bg-white/10 px-2 py-1 rounded-md">12</span>
                            </a></li>
                            <li class="border-t border-white/5 pt-4"><a href="#" class="flex items-center justify-between group py-2">
                                <span class="text-sm font-bold text-gray-300 group-hover:text-white transition-colors">Hoạt động nội bộ</span>
                                <span class="text-[10px] bg-white/10 px-2 py-1 rounded-md">05</span>
                            </a></li>
                            <li class="border-t border-white/5 pt-4"><a href="#" class="flex items-center justify-between group py-2">
                                <span class="text-sm font-bold text-gray-300 group-hover:text-white transition-colors">Hợp tác chiến lược</span>
                                <span class="text-[10px] bg-white/10 px-2 py-1 rounded-md">03</span>
                            </a></li>
                            <li class="border-t border-white/5 pt-4"><a href="#" class="flex items-center justify-between group py-2">
                                <span class="text-sm font-bold text-gray-300 group-hover:text-white transition-colors">Tin tức 24h</span>
                                <span class="text-[10px] bg-white/10 px-2 py-1 rounded-md">04</span>
                            </a></li>
                        </ul>
                    </div>

                    <!-- TRENDING -->
                    <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100">
                        <h3 class="text-lg font-black text-gray-900 mb-8 uppercase tracking-widest">Đang Hot</h3>
                        <div class="space-y-8">
                            @foreach (var post in posts.Take(3))
                            {
                                <a href="/Customer/PostDetail/@post.Id" class="flex gap-4 group">
                                    <div class="w-16 h-16 rounded-2xl overflow-hidden shrink-0">
                                        <img src="@post.Image" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                    </div>
                                    <div>
                                        <h4 class="text-xs font-bold text-gray-900 line-clamp-2 group-hover:text-red-600 transition-colors leading-tight">@post.Title</h4>
                                        <span class="text-[10px] text-gray-400 font-bold">@post.Date</span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- NEWSLETTER -->
                    <div class="bg-red-600 p-10 rounded-[40px] text-white shadow-2xl shadow-red-600/30">
                        <i data-lucide="mail-plus" class="w-10 h-10 mb-6 opacity-50"></i>
                        <h3 class="text-xl font-black mb-4 leading-tight">Đăng ký nhận tin mới nhất</h3>
                        <p class="text-red-100 text-xs leading-relaxed mb-8">Nhận những thông tin cập nhật sớm nhất từ HuitMeal qua Email của bạn.</p>
                        <div class="space-y-3">
                            <input type="email" placeholder="Email của bạn..." class="w-full px-6 py-4 bg-white/20 border-none rounded-2xl placeholder:text-red-200 text-xs font-bold focus:ring-2 focus:ring-white" />
                            <button class="w-full py-4 bg-white text-red-600 text-[10px] font-black uppercase tracking-widest rounded-2xl hover:bg-gray-100 transition-colors">Gửi ngay</button>
                        </div>
                    </div>

                </aside>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
