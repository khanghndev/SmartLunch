@{
    ViewData["Title"] = "Tuyển dụng";
    Layout = "_LayoutCustomer";
}

<div class="w-full bg-white text-[#1f2a37]">
    <!-- ================= 1. BANNER ================= -->
    <section class="relative w-full h-[400px] md:h-[600px] overflow-hidden">
        <img src="/assets/images/recruitment_banner.jpg" alt="Banner" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/30"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 md:px-6 z-10">
            <h1 class="text-2xl sm:text-3xl md:text-6xl font-black text-white mb-4 md:mb-6 leading-tight">
                <span class="bg-[#ffc107] text-black px-3 py-1 md:px-4 md:py-2 inline-block">Phát triển</span> cùng Haseca
            </h1>
            <p class="max-w-xl md:max-w-3xl text-white/90 text-sm sm:text-base md:text-lg leading-relaxed">
                Trong suốt hành trình tạo giá trị của mình, HASECA không ngừng tìm kiếm và đào tạo nhân tài với tâm niệm: con người là nhân tố trung tâm quyết định sự thành công, phồn thịnh và phát triển bền vững của doanh nghiệp.
            </p>
        </div>
    </section>

    <!-- ================= CARDS ================= -->
    <div class="relative z-20 px-4 mt-[-60px] md:mt-[-80px] mb-20">
        <div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 md:gap-6">
            <!-- Card 1 -->
            <div class="bg-white shadow-xl py-10 px-6 flex flex-col items-center text-center rounded-md hover:-translate-y-2 transition duration-300">
                <div class="w-16 h-16 flex items-center justify-center border-2 border-[#f39200] rounded-full mb-4">
                    <i data-lucide="users" class="text-[#f39200] w-7 h-7"></i>
                </div>
                <h3 class="font-bold text-lg uppercase">Môi trường</h3>
                <p class="text-gray-600 text-sm mt-1">chuyên nghiệp</p>
            </div>
            <!-- Card 2 -->
            <div class="bg-white shadow-xl py-10 px-6 flex flex-col items-center text-center rounded-md hover:-translate-y-2 transition duration-300">
                <div class="w-16 h-16 flex items-center justify-center border-2 border-[#f39200] rounded-full mb-4">
                    <i data-lucide="trending-up" class="text-[#f39200] w-7 h-7"></i>
                </div>
                <h3 class="font-bold text-lg uppercase">Cơ hội phát triển</h3>
                <p class="text-gray-600 text-sm mt-1">sự nghiệp bền vững</p>
            </div>
            <!-- Card 3 -->
            <div class="bg-white shadow-xl py-10 px-6 flex flex-col items-center text-center rounded-md hover:-translate-y-2 transition duration-300">
                <div class="w-16 h-16 flex items-center justify-center border-2 border-[#f39200] rounded-full mb-4">
                    <i data-lucide="lightbulb" class="text-[#f39200] w-7 h-7"></i>
                </div>
                <h3 class="font-bold text-lg uppercase">Đào tạo</h3>
                <p class="text-gray-600 text-sm mt-1">bài bản</p>
            </div>
        </div>
    </div>

    <!-- QUOTE -->
    <section class="max-w-7xl mx-auto py-20 md:py-28 px-4 md:px-6">
        <div class="relative bg-gradient-to-br from-[#1f1f1f] via-[#2b2b2b] to-[#111] rounded-3xl p-8 md:p-16 overflow-hidden">
            <div class="absolute -top-20 -left-20 w-72 h-72 bg-[#ffc107]/20 blur-3xl rounded-full"></div>
            <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-[#ffc107]/10 blur-3xl rounded-full"></div>
            <div class="relative max-w-3xl mx-auto text-center">
                <div class="text-[#ffc107] text-5xl mb-6 opacity-80">“</div>
                <p class="text-white/90 text-lg md:text-xl leading-relaxed font-light">
                    Con người chính là sức mạnh của Haseca. Đích đến của chúng tôi là sức khỏe, sự hài lòng và cảm giác ngon miệng của khách hàng.
                </p>
                <div class="mt-10 flex flex-col items-center">
                    <div class="w-14 h-14 rounded-full bg-[#ffc107] flex items-center justify-center text-black font-bold text-lg shadow-lg">CEO</div>
                    <h3 class="mt-4 text-[#ffc107] text-xl md:text-2xl font-semibold">Tổng Giám Đốc</h3>
                    <p class="text-gray-400 text-sm mt-1">Haseca Corporation</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FACTS -->
    <section class="max-w-7xl mx-auto py-16 md:py-24 px-4 md:px-6">
        <div class="text-center mb-12 md:mb-16">
            <h2 class="text-3xl sm:text-4xl md:text-6xl font-extrabold text-[#1f2937] leading-tight">
                <span class="relative inline-block mr-2 md:mr-3">Haseca's<span class="absolute left-0 bottom-1 md:bottom-2 w-full h-2 md:h-4 bg-[#ffc107] -z-10"></span></span> facts
            </h2>
            <div class="mt-6 md:mt-10">
                <button class="bg-[#f59e0b] hover:bg-orange-600 text-white px-6 md:px-10 py-3 md:py-4 rounded-full font-bold uppercase text-xs md:text-sm tracking-wide shadow-md transition">Vị trí tuyển dụng</button>
            </div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
            <div>
                <h3 class="text-2xl md:text-3xl font-bold mb-4 leading-tight">Tạo dựng cơ hội nghề nghiệp cho sinh viên</h3>
                <p class="text-gray-600 leading-relaxed text-sm md:text-base">Đầu năm 2019, HASECA đã ký kết, hợp tác với Trường cao đẳng Hùng Vương Hà Nội, nhận các bạn sinh viên về thực tập, học nghề và sẵn sàng bao tiêu đầu ra cho các sinh viên có nguyện vọng về công ty làm việc sau khi ra trường.</p>
                <p class="text-gray-600 leading-relaxed text-sm md:text-base mt-4">Các bếp ăn công nghiệp của Haseca hoạt động 24/24 giờ mang bữa ăn tới công nhân ở các nhà máy từ sáng cho tới đêm khuya, kể cả ngày lễ, tết. Với một khối lượng công việc lớn như vậy, nếu không có lửa nhiệt huyết và tình yêu với nghề thì không thể hoàn thành tốt được.</p>
                <p class="text-gray-600 leading-relaxed text-sm md:text-base mt-4">Căn phòng để tập trung nghiên cứu và phát triển công tác đào tạo là thứ được chúng tôi quan tâm đầu tư từ những bước đi đầu tiên. Việc đào tạo không chỉ quan tâm tới các kỹ năng cứng về chuyên môn nghiệp vụ mà còn trang bị thêm các kỹ năng mềm cho toàn bộ đội ngũ nhân viên.</p>
            </div>
            <div>
                <img src="/assets/images/fact1.jpg" alt="HASECA" class="w-full h-auto shadow-sm rounded-xl" />
            </div>
        </div>
    </section>

    <!-- 4 GIÁ TRỊ -->
    <section class="max-w-7xl mx-auto py-24 px-6 h-auto hidden md:block">
        <div class="text-center mb-20">
            <h2 class="text-5xl font-extrabold text-[#1f2937]">
                <span class="relative inline-block mr-2">4 giá trị<span class="absolute left-0 bottom-2 w-full h-3 bg-[#ffc107] -z-10"></span></span> làm nên Haseca
            </h2>
        </div>
        <div class="relative w-full py-20 flex items-center justify-center overflow-hidden">
            <div class="relative w-full max-w-[1200px] h-[700px] flex items-center justify-center">
                <!-- CIRCLES -->
                <div class="absolute rounded-full border border-[#f59e0b]/20" style="width: 750px; height: 750px;"></div>
                <div class="absolute rounded-full border border-[#f59e0b]/20" style="width: 600px; height: 600px;"></div>
                <div class="absolute rounded-full border border-[#f59e0b]/20" style="width: 450px; height: 450px;"></div>
                <div class="absolute rounded-full border border-[#f59e0b]/20" style="width: 300px; height: 300px;"></div>
                <!-- CENTER ICON -->
                <div class="absolute flex items-center justify-center w-28 h-28 md:w-32 md:h-32 rounded-full border border-[#f59e0b] bg-white z-10 shadow">
                    <i data-lucide="gem" class="text-[#f59e0b] w-10 h-10 md:w-12 md:h-12"></i>
                </div>
                <!-- LEFT TOP -->
                <div class="absolute left-0 top-[15%] flex items-center">
                    <div class="bg-[#f3f3f3] rounded-2xl px-6 md:px-8 py-5 md:py-6 w-[300px] md:w-[420px] shadow-lg">
                        <p class="text-gray-700 text-sm md:text-[15px] leading-relaxed">Công việc HASECA liên quan đến sức khỏe và hiệu quả làm việc của người lao động nên không thể làm qua loa mà thiếu chuyên môn.</p>
                    </div>
                    <div class="-ml-10 md:-ml-14 w-20 h-20 md:w-28 md:h-28 bg-[#ffc107] rounded-full flex items-center justify-center font-bold text-sm md:text-lg shadow-md">Kỹ năng</div>
                </div>
                <!-- RIGHT TOP -->
                <div class="absolute right-0 top-[15%] flex items-center">
                    <div class="mr-[-40px] md:mr-[-56px] w-20 h-20 md:w-28 md:h-28 bg-[#ffc107] rounded-full flex items-center justify-center font-bold text-sm md:text-lg shadow-md z-10">Sáng tạo</div>
                    <div class="bg-[#f3f3f3] rounded-2xl px-6 md:px-8 py-5 md:py-6 w-[300px] md:w-[420px] shadow-lg">
                        <p class="text-gray-700 text-sm md:text-[15px] leading-relaxed">Phương châm làm việc của HASECA là không ngừng học hỏi và cải tiến để mang đến hiệu quả công việc tốt hơn.</p>
                    </div>
                </div>
                <!-- LEFT BOTTOM -->
                <div class="absolute left-0 bottom-[15%] flex items-center">
                    <div class="bg-[#f3f3f3] rounded-2xl px-6 md:px-8 py-5 md:py-6 w-[300px] md:w-[420px] shadow-lg">
                        <p class="text-gray-700 text-sm md:text-[15px] leading-relaxed">Hành động xuất phát từ sự chân thành mới đủ bền vững và đủ để lan tỏa những giá trị tốt đẹp đến cho cộng đồng.</p>
                    </div>
                    <div class="-ml-10 md:-ml-14 w-20 h-20 md:w-28 md:h-28 bg-[#ffc107] rounded-full flex items-center justify-center font-bold text-sm md:text-lg shadow-md">Tâm - Đức</div>
                </div>
                <!-- RIGHT BOTTOM -->
                <div class="absolute right-0 bottom-[15%] flex items-center">
                    <div class="mr-[-40px] md:mr-[-56px] w-20 h-20 md:w-28 md:h-28 bg-[#ffc107] rounded-full flex items-center justify-center font-bold text-sm md:text-lg shadow-md z-10">Nhiệt huyết</div>
                    <div class="bg-[#f3f3f3] rounded-2xl px-6 md:px-8 py-5 md:py-6 w-[300px] md:w-[420px] shadow-lg">
                        <p class="text-gray-700 text-sm md:text-[15px] leading-relaxed">Tình yêu chính là thứ giúp HASECA có thể xử lý tốt khối lượng công việc lớn mà vẫn đảm bảo chất lượng cho khách hàng.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- VỊ TRÍ TUYỂN DỤNG -->
    <section class="w-full bg-gray-100 py-16 md:py-24 px-4 md:px-6">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl md:text-5xl font-extrabold text-center mb-10 md:mb-14">
                <span class="bg-[#ffc107] px-3 py-1 mr-2">Vị trí</span> tuyển dụng
            </h2>
            <!-- DESKTOP TABLE -->
            <div class="hidden md:block">
                <div class="bg-[#ffc107] text-black font-semibold uppercase text-sm">
                    <div class="grid grid-cols-5 gap-4 px-6 py-4">
                        <div class="flex items-center gap-1"><i data-lucide="hash" class="w-4 h-4"></i> SL</div>
                        <div>Công việc</div>
                        <div class="flex items-center gap-1"><i data-lucide="map-pin" class="w-4 h-4"></i> Nơi làm việc</div>
                        <div class="flex items-center gap-1"><i data-lucide="briefcase" class="w-4 h-4"></i> Vị trí</div>
                        <div class="flex items-center gap-1"><i data-lucide="clock" class="w-4 h-4"></i> Hạn nộp</div>
                    </div>
                </div>
                <div class="bg-white divide-y">
                    <div class="grid grid-cols-5 gap-4 px-6 py-4 items-center hover:bg-gray-50 transition">
                        <div class="flex items-center gap-1"><i data-lucide="hash" class="w-3 h-3 text-gray-500"></i>02</div>
                        <div class="font-medium">Nhân viên bếp</div>
                        <div class="flex items-center gap-1 text-gray-600"><i data-lucide="map-pin" class="w-3 h-3"></i>Hà Nội</div>
                        <div class="flex items-center gap-1 text-gray-600"><i data-lucide="briefcase" class="w-3 h-3"></i>Full-time</div>
                        <div class="flex items-center gap-1 text-red-500 font-medium"><i data-lucide="clock" class="w-3 h-3"></i>30/12/2025</div>
                    </div>
                    <div class="grid grid-cols-5 gap-4 px-6 py-4 items-center hover:bg-gray-50 transition">
                        <div class="flex items-center gap-1"><i data-lucide="hash" class="w-3 h-3 text-gray-500"></i>01</div>
                        <div class="font-medium">Kế toán nội bộ</div>
                        <div class="flex items-center gap-1 text-gray-600"><i data-lucide="map-pin" class="w-3 h-3"></i>TP.HCM</div>
                        <div class="flex items-center gap-1 text-gray-600"><i data-lucide="briefcase" class="w-3 h-3"></i>Full-time</div>
                        <div class="flex items-center gap-1 text-red-500 font-medium"><i data-lucide="clock" class="w-3 h-3"></i>15/01/2026</div>
                    </div>
                     <div class="grid grid-cols-5 gap-4 px-6 py-4 items-center hover:bg-gray-50 transition">
                        <div class="flex items-center gap-1"><i data-lucide="hash" class="w-3 h-3 text-gray-500"></i>03</div>
                        <div class="font-medium">Phục vụ</div>
                        <div class="flex items-center gap-1 text-gray-600"><i data-lucide="map-pin" class="w-3 h-3"></i>Bắc Ninh</div>
                        <div class="flex items-center gap-1 text-gray-600"><i data-lucide="briefcase" class="w-3 h-3"></i>Part-time</div>
                        <div class="flex items-center gap-1 text-red-500 font-medium"><i data-lucide="clock" class="w-3 h-3"></i>10/01/2026</div>
                    </div>
                </div>
            </div>
            
            <!-- MOBILE CARD -->
            <div class="md:hidden space-y-4">
                 <div class="bg-white rounded-xl shadow p-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-base">Nhân viên bếp</h3>
                        <div class="flex items-center gap-1 text-xs bg-[#ffc107] px-2 py-1 rounded"><i data-lucide="hash" class="w-3 h-3"></i>02</div>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i data-lucide="map-pin" class="w-4 h-4"></i>Hà Nội</div>
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i data-lucide="briefcase" class="w-4 h-4"></i>Full-time</div>
                    <div class="flex items-center gap-2 text-sm text-red-500 font-medium"><i data-lucide="clock" class="w-4 h-4"></i>30/12/2025</div>
                </div>
                <div class="bg-white rounded-xl shadow p-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-base">Kế toán nội bộ</h3>
                        <div class="flex items-center gap-1 text-xs bg-[#ffc107] px-2 py-1 rounded"><i data-lucide="hash" class="w-3 h-3"></i>01</div>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i data-lucide="map-pin" class="w-4 h-4"></i>TP.HCM</div>
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i data-lucide="briefcase" class="w-4 h-4"></i>Full-time</div>
                    <div class="flex items-center gap-2 text-sm text-red-500 font-medium"><i data-lucide="clock" class="w-4 h-4"></i>15/01/2026</div>
                </div>
                 <div class="bg-white rounded-xl shadow p-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-base">Phục vụ</h3>
                        <div class="flex items-center gap-1 text-xs bg-[#ffc107] px-2 py-1 rounded"><i data-lucide="hash" class="w-3 h-3"></i>03</div>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i data-lucide="map-pin" class="w-4 h-4"></i>Bắc Ninh</div>
                    <div class="flex items-center gap-2 text-sm text-gray-600"><i data-lucide="briefcase" class="w-4 h-4"></i>Part-time</div>
                    <div class="flex items-center gap-2 text-sm text-red-500 font-medium"><i data-lucide="clock" class="w-4 h-4"></i>10/01/2026</div>
                </div>
            </div>
        </div>
    </section>
</div>
