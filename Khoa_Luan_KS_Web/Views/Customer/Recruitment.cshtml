@{
    ViewData["Title"] = "Tuyển dụng - HuitMeal Careers";
    Layout = "_LayoutCustomer";

    var jobs = new[] {
        new { Id = 1, Title = "Trưởng Bếp Công Nghiệp", Location = "TP. Hồ Chí Minh", Type = "Full-time", Salary = "Thỏa thuận", Deadline = "30/06/2025", Category = "Chế biến", Icon = "chef-hat" },
        new { Id = 2, Title = "Chuyên Viên Kế Toán Nội Bộ", Location = "Bình Dương", Type = "Full-time", Salary = "12 – 15 Triệu", Deadline = "15/07/2025", Category = "Văn phòng", Icon = "calculator" },
        new { Id = 3, Title = "Nhân Viên Phục Vụ Suất Ăn", Location = "Đồng Nai", Type = "Part-time", Salary = "Theo giờ", Deadline = "10/06/2025", Category = "Vận hành", Icon = "utensils" },
        new { Id = 4, Title = "Chuyên Viên Nhân Sự Đào Tạo", Location = "TP. Hồ Chí Minh", Type = "Full-time", Salary = "15 – 20 Triệu", Deadline = "20/07/2025", Category = "Văn phòng", Icon = "users" },
    };
}

<style>
    .step-line-desktop::after {
        content: '';
        position: absolute;
        top: 28px;
        left: calc(50% + 28px);
        width: calc(100% - 56px);
        height: 1px;
        border-top: 2px dashed #fed7aa;
        z-index: 0;
    }
</style>

<div class="w-full overflow-hidden" x-data="{ activeCategory: 'Tất cả' }">

    <!-- ===== HERO ===== -->
    <section class="relative min-h-[700px] flex items-center overflow-hidden">
        <!-- Background -->
        <img src="/assets/images/recruitment_hero.png"
             class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-br from-gray-900/85 via-gray-900/60 to-orange-900/40"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 w-full"
             x-data="{ loaded: false }" x-init="setTimeout(() => loaded = true, 80)">
            <div class="max-w-3xl"
                 x-show="loaded"
                 x-transition:enter="transition duration-700 ease-out"
                 x-transition:enter-start="opacity-0 translate-y-8"
                 x-transition:enter-end="opacity-100 translate-y-0">

                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/20 border border-orange-400/30 text-orange-300 text-[10px] font-bold uppercase tracking-[0.25em] mb-6">
                    <i data-lucide="zap" class="w-3 h-3"></i>
                    Cơ hội nghề nghiệp tại HuitMeal
                </span>

                <h1 class="text-5xl md:text-7xl font-black text-white leading-[1.05] tracking-tight mb-6">
                    Phát triển <br />
                    <span class="text-orange-400">cùng chúng tôi</span>
                </h1>

                <p class="text-gray-300 text-lg leading-relaxed mb-10 max-w-xl font-medium">
                    HuitMeal tìm kiếm những cộng sự tận tâm, sẵn sàng kiến tạo bữa ăn tử tế cho hàng triệu người Việt.
                </p>

                <div class="flex flex-wrap gap-4">
                    <a href="#open-positions"
                       class="px-8 py-4 bg-orange-500 text-white rounded-full font-bold shadow-lg shadow-orange-500/30 hover:bg-orange-400 hover:-translate-y-0.5 transition-all flex items-center gap-2 text-sm">
                        Xem vị trí ứng tuyển
                        <i data-lucide="arrow-down" class="w-4 h-4"></i>
                    </a>
                    <a href="#why-huitmeal"
                       class="px-8 py-4 bg-white/10 text-white border border-white/20 rounded-full font-bold hover:bg-white/20 transition-all text-sm backdrop-blur-sm">
                        Văn hóa công ty
                    </a>
                </div>
            </div>

            <!-- Floating stat badge -->
            <div class="absolute bottom-10 right-8 hidden lg:flex items-center gap-5 bg-white/10 backdrop-blur-lg border border-white/10 rounded-2xl px-6 py-4">
                <div class="w-12 h-12 rounded-xl bg-orange-500/20 flex items-center justify-center">
                    <i data-lucide="users" class="w-6 h-6 text-orange-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-black text-white leading-none">500+</p>
                    <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-widest mt-0.5">Cộng sự tận tâm</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== WHY HUITMEAL ===== -->
    <section id="why-huitmeal" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <p class="text-orange-600 text-xs font-bold uppercase tracking-[0.3em] mb-3">Môi trường làm việc</p>
                <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight">Tại sao chọn <span class="text-orange-600">HuitMeal?</span></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="group p-10 rounded-[32px] bg-orange-50 border border-orange-100 hover:shadow-xl hover:border-orange-200 transition-all duration-500">
                    <div class="w-14 h-14 rounded-2xl bg-orange-500 flex items-center justify-center text-white mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="trending-up" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Lộ trình thăng tiến</h3>
                    <p class="text-gray-600 leading-relaxed text-sm">Ưu tiên phát triển nội bộ, trao cơ hội cho những cá nhân có năng lực và thái độ tích cực vươn lên vị trí lãnh đạo.</p>
                </div>
                <!-- Card 2 -->
                <div class="group p-10 rounded-[32px] bg-amber-50 border border-amber-100 hover:shadow-xl hover:border-amber-200 transition-all duration-500">
                    <div class="w-14 h-14 rounded-2xl bg-amber-500 flex items-center justify-center text-white mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="heart" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Chăm sóc toàn diện</h3>
                    <p class="text-gray-600 leading-relaxed text-sm">Bảo hiểm đầy đủ, thưởng hiệu quả, bữa ăn miễn phí và các gói chăm sóc sức khỏe định kỳ cho toàn bộ nhân viên.</p>
                </div>
                <!-- Card 3 -->
                <div class="group p-10 rounded-[32px] bg-rose-50 border border-rose-100 hover:shadow-xl hover:border-rose-200 transition-all duration-500">
                    <div class="w-14 h-14 rounded-2xl bg-rose-500 flex items-center justify-center text-white mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="sparkles" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Văn hóa đổi mới</h3>
                    <p class="text-gray-600 leading-relaxed text-sm">Môi trường năng động, nơi mỗi ý tưởng sáng tạo đều được lắng nghe, trân trọng và hiện thực hóa.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== RECRUITMENT JOURNEY ===== -->
    <section class="py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <p class="text-orange-600 text-xs font-bold uppercase tracking-[0.3em] mb-3">Quy trình tuyển dụng</p>
                <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight">Hành trình trở thành <span class="text-orange-600">HuitMealer</span></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
                @foreach (var (step, idx) in new[] {
                    new { Icon = "send", Label = "Ứng Tuyển", Desc = "Gửi CV qua website hoặc email chính thức." },
                    new { Icon = "message-square", Label = "Phỏng Vấn", Desc = "Gặp gỡ nhân sự và quản lý bộ phận trực tiếp." },
                    new { Icon = "check-circle", Label = "Đánh Giá", Desc = "Tham gia bài kiểm tra năng lực chuyên môn." },
                    new { Icon = "star", Label = "Onboarding", Desc = "Nhận thư mời và bắt đầu hành trình mới." }
                }.Select((s, i) => (s, i)))
                {
                    <div class="relative flex flex-col items-center text-center group">
                        <!-- Dashed connector (desktop) -->
                        @if (idx < 3)
                        {
                            <div class="step-line-desktop absolute top-0 left-0 w-full hidden md:block"></div>
                        }
                        <!-- Step circle -->
                        <div class="w-14 h-14 rounded-full border-2 border-orange-200 bg-white flex items-center justify-center text-orange-600 mb-6 relative z-10 group-hover:bg-orange-500 group-hover:text-white group-hover:border-orange-500 transition-all shadow-sm">
                            <i data-lucide="@step.Icon" class="w-6 h-6"></i>
                        </div>
                        <span class="text-[10px] font-black text-orange-500 uppercase tracking-widest mb-1">Bước @(idx + 1)</span>
                        <h4 class="text-lg font-bold text-gray-900 mb-2">@step.Label</h4>
                        <p class="text-sm text-gray-500 leading-relaxed font-medium max-w-[200px]">@step.Desc</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ===== OPEN POSITIONS ===== -->
    <section id="open-positions" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-16">
                <div>
                    <p class="text-orange-600 text-xs font-bold uppercase tracking-[0.3em] mb-3">Vị trí đang tuyển</p>
                    <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight">Cơ hội <span class="text-orange-600">dành cho bạn</span></h2>
                </div>
                <!-- Filters -->
                <div class="flex flex-wrap gap-2">
                    @foreach (var cat in new[] { "Tất cả", "Chế biến", "Văn phòng", "Vận hành" })
                    {
                        <button
                            @@click="activeCategory = '@cat'"
                            :class="activeCategory === '@cat' ? 'bg-orange-500 text-white shadow-md shadow-orange-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-5 py-2.5 rounded-full text-xs font-bold transition-all uppercase tracking-widest">
                            @cat
                        </button>
                    }
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                @foreach (var job in jobs)
                {
                    <div
                        x-show="activeCategory === 'Tất cả' || activeCategory === '@job.Category'"
                        x-transition:enter="transition ease-out duration-300"
                        x-transition:enter-start="opacity-0 scale-95"
                        x-transition:enter-end="opacity-100 scale-100"
                        class="group relative bg-white border border-gray-100 rounded-[28px] p-8 hover:border-orange-200 hover:shadow-xl transition-all duration-400">

                        <!-- Top row -->
                        <div class="flex items-start justify-between mb-6 gap-4">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-orange-50 flex items-center justify-center text-orange-600 flex-shrink-0">
                                    <i data-lucide="@job.Icon" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <span class="text-[10px] font-bold text-orange-500 uppercase tracking-widest">@job.Category</span>
                                    <h4 class="text-lg font-black text-gray-900 leading-tight">@job.Title</h4>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <p class="text-lg font-black text-gray-900">@job.Salary</p>
                                <p class="text-[10px] text-gray-400 font-semibold">mức lương</p>
                            </div>
                        </div>

                        <!-- Tags -->
                        <div class="flex flex-wrap gap-2 mb-6">
                            <span class="inline-flex items-center gap-1.5 bg-gray-50 border border-gray-100 text-gray-600 text-xs font-semibold px-3 py-1.5 rounded-full">
                                <i data-lucide="map-pin" class="w-3 h-3 text-gray-400"></i>
                                @job.Location
                            </span>
                            <span class="inline-flex items-center gap-1.5 bg-gray-50 border border-gray-100 text-gray-600 text-xs font-semibold px-3 py-1.5 rounded-full">
                                <i data-lucide="clock" class="w-3 h-3 text-gray-400"></i>
                                @job.Type
                            </span>
                        </div>

                        <!-- Footer -->
                        <div class="flex items-center justify-between pt-5 border-t border-gray-50">
                            <span class="text-xs text-gray-400">Hạn nộp: <span class="text-gray-600 font-semibold">@job.Deadline</span></span>
                            <button class="flex items-center gap-2 text-sm font-bold text-orange-600 hover:gap-3 transition-all group-hover:text-orange-500">
                                Ứng tuyển
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ===== FINAL CTA ===== -->
    <section class="py-24 bg-gray-900 relative overflow-hidden">
        <!-- Warm background glow -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-orange-500/10 blur-[120px] rounded-full pointer-events-none"></div>

        <div class="max-w-3xl mx-auto px-6 text-center relative z-10">
            <p class="text-orange-500 text-xs font-bold uppercase tracking-[0.3em] mb-4">Không tìm thấy vị trí phù hợp?</p>
            <h2 class="text-4xl md:text-6xl font-black text-white mb-6 tracking-tight leading-tight">
                Hãy gửi CV của bạn <br />
                <span class="text-orange-400">ngay hôm nay</span>
            </h2>
            <p class="text-gray-400 text-lg font-medium mb-12 leading-relaxed max-w-xl mx-auto">
                Gia nhập Talent Pool của HuitMeal — chúng tôi sẽ liên hệ ngay khi có vị trí phù hợp với bạn.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="mailto:tuyendung@huitmeal.com"
                   class="px-10 py-4 bg-orange-500 text-white rounded-full font-bold text-sm hover:bg-orange-400 hover:-translate-y-0.5 transition-all shadow-2xl shadow-orange-500/20">
                    Gửi CV trực tiếp
                </a>
                <a href="tel:0966741866"
                   class="px-10 py-4 bg-white/5 text-gray-300 border border-white/10 rounded-full font-bold text-sm hover:bg-white/10 transition-all flex items-center gap-2">
                    <i data-lucide="phone" class="w-4 h-4 text-orange-500"></i>
                    0966 741 866
                </a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
}
