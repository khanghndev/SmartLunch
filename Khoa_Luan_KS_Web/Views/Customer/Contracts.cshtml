@{
    ViewData["Title"] = "Quản lý Hợp đồng - HuitMeal";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<style>
    .sig-canvas {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #ffffff;
        cursor: crosshair;
    }
    
    .paper-sheet {
        background: white;
        box-shadow: 0 4px 25px rgba(0,0,0,0.06);
        border: 1px solid #f3f4f6;
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
        min-height: 1100px;
        padding: 60px md:padding-80px;
        font-family: 'Times New Roman', Times, serif;
    }

    .full-screen-sign {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #f8fafc;
        overflow-y: auto;
    }

    .stamp-ink {
        width: 100px;
        height: 100px;
        border: 3px solid #ef4444;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #ef4444;
        font-weight: 800;
        font-size: 9px;
        text-transform: uppercase;
        transform: rotate(-12deg);
        opacity: 0.7;
        border-style: double;
        padding: 4px;
    }

    .modern-toolbar {
        background: white;
        border-bottom: 1px solid #f1f5f9;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }
</style>

<div x-data="eSignFlow()" class="max-w-7xl mx-auto px-6 pt-10 pb-20">
    <!-- Breadcrumb (Synced) -->
    <nav class="flex text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/Customer" class="hover:text-orange-500 font-medium transition flex items-center gap-1">
                    <i data-lucide="home" class="w-4 h-4"></i> Trang chủ
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300"></i>
                    <span class="ml-1 md:ml-2 font-medium text-gray-700">Hợp đồng điện tử</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Hợp đồng & Văn bản</h1>
        <div x-show="!isSigned" class="flex items-center gap-2 bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
            <div class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-pulse"></div>
            <span class="text-[10px] font-bold text-blue-700 uppercase">01 Văn bản mới</span>
        </div>
    </div>

    <div class="flex flex-col md:flex-row gap-8 items-stretch">
        <!-- Sidebar Navigation -->
        <div class="w-full md:w-64 flex-shrink-0">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 h-full">
                <div class="flex items-center gap-3 mb-6 pb-6 border-b border-gray-100">
                    <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center text-orange-600 font-bold text-xl shadow-sm">
                        K
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900">TRƯỜNG THPT HOÀNG VĂN THỤ</h3>
                        <p class="text-xs text-gray-500">Khách hàng Doanh nghiệp</p>
                    </div>
                </div>

                <nav class="space-y-1 text-sm font-medium">
                    <a href="/Customer/Profile" class="flex items-center gap-3 px-3 py-2.5 text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-lg transition-colors">
                        <i data-lucide="user" class="w-4 h-4 text-gray-400"></i> Hồ sơ doanh nghiệp
                    </a>
                    <a href="/Customer/Orders" class="flex items-center gap-3 px-3 py-2.5 text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-lg transition-colors">
                        <i data-lucide="shopping-bag" class="w-4 h-4 text-gray-400"></i> Lịch sử đơn hàng
                    </a>
                    <a href="/Customer/Contracts" class="flex items-center gap-3 px-3 py-2.5 bg-orange-50 text-orange-700 rounded-lg transition-colors">
                        <i data-lucide="file-signature" class="w-4 h-4"></i> Hợp đồng điện tử
                    </a>
                </nav>
            </div>
        </div>


        <div class="flex-1">

            <div class="space-y-4">
                <!-- PENDING ITEM -->
                <div x-show="!isSigned" class="bg-white rounded-xl p-6 border border-gray-100 hover:border-orange-300 shadow-sm transition-all group">
                    <div class="flex flex-col md:flex-row md:items-center gap-6">
                        <div class="w-14 h-14 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center shrink-0 group-hover:bg-orange-600 group-hover:text-white transition-colors">
                            <i data-lucide="file-edit" class="w-7 h-7"></i>
                        </div>
                        <div class="flex-1">
                            <h3 class="font-bold text-gray-900 text-lg">Phụ lục Điều chỉnh Suất ăn Dự phòng T05/2026</h3>
                            <p class="text-[10px] text-gray-400 mt-1 uppercase tracking-wider font-bold">Mã văn bản: PL-2026-001</p>
                        </div>
                        <button @@click="startSigning()" class="px-8 py-3 bg-gray-900 text-white rounded-xl text-xs font-bold hover:bg-orange-600 transition-all shadow-sm">
                            Ký xác nhận ngay
                        </button>
                    </div>
                </div>

                <!-- SIGNED ITEM -->
                <template x-if="isSigned">
                    <div class="bg-white rounded-xl p-6 border border-green-100 shadow-sm animate-fadeIn">
                        <div class="flex flex-col md:flex-row md:items-center gap-6">
                            <div class="w-14 h-14 rounded-xl bg-green-50 text-green-600 flex items-center justify-center shrink-0">
                                <i data-lucide="check-circle" class="w-7 h-7"></i>
                            </div>
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900 text-lg">Phụ lục Điều chỉnh Suất ăn Dự phòng T05/2026</h3>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="text-[10px] text-green-600 font-bold uppercase">Đã ký điện tử</span>
                                    <span class="text-[10px] text-gray-300">|</span>
                                    <span class="text-[10px] text-gray-400 font-medium">Hoàn tất: 25/04/2026</span>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <button @@click="viewSignedDoc()" class="px-4 py-2 text-xs font-bold text-gray-400 hover:text-gray-900 transition">Xem lại</button>
                                <button class="px-4 py-2 bg-green-600 text-white text-xs font-bold rounded-lg hover:bg-green-700 transition">Tải bản PDF</button>
                            </div>
                        </div>
                    </div>
                </template>

                <!-- ARCHIVED -->
                <div class="bg-gray-50/50 rounded-xl p-6 border border-gray-100 flex items-center gap-6 opacity-50 grayscale">
                    <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center text-gray-300">
                        <i data-lucide="file-text" class="w-6 h-6"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-gray-700">Hợp đồng Nguyên tắc 2025</h4>
                        <p class="text-[10px] text-gray-400 font-medium mt-1">Lưu trữ từ: 01/01/2025</p>
                    </div>
                    <button class="px-4 py-2 text-xs font-bold text-gray-400 cursor-not-allowed">Đã khóa</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== FULL-SCREEN LIGHT SIGNING FLOW ===== -->
    <div x-show="signingMode" 
         class="full-screen-sign flex flex-col"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         style="display: none;">
        
        <!-- Modern Toolbar -->
        <header class="modern-toolbar px-8 py-5 flex items-center justify-between shrink-0 sticky top-0 z-50">
            <div class="flex items-center gap-5">
                <button @@click="exitSigning()" class="w-10 h-10 rounded-xl bg-gray-50 hover:bg-orange-50 flex items-center justify-center text-gray-400 hover:text-orange-600 transition-all">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                </button>
                <div>
                    <h2 class="text-[13px] font-bold text-gray-900 leading-tight">Cổng ký số HuitMeal</h2>
                    <p class="text-[10px] text-gray-400 font-medium" x-text="stepTitle()"></p>
                </div>
            </div>
            
            <!-- Compact Progress -->
            <div class="hidden md:flex items-center gap-6">
                <div class="flex items-center gap-2" :class="step >= 1 ? 'text-gray-900' : 'text-gray-300'">
                    <span class="w-6 h-6 rounded-lg border flex items-center justify-center text-[10px] font-bold" :class="step >= 1 ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-100'">1</span>
                    <span class="text-[10px] font-bold uppercase tracking-wider">Xem</span>
                </div>
                <div class="w-4 h-[1px] bg-gray-100"></div>
                <div class="flex items-center gap-2" :class="step >= 2 ? 'text-gray-900' : 'text-gray-300'">
                    <span class="w-6 h-6 rounded-lg border flex items-center justify-center text-[10px] font-bold" :class="step >= 2 ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-100'">2</span>
                    <span class="text-[10px] font-bold uppercase tracking-wider">Ký</span>
                </div>
                <div class="w-4 h-[1px] bg-gray-100"></div>
                <div class="flex items-center gap-2" :class="step >= 3 ? 'text-green-600' : 'text-gray-300'">
                    <span class="w-6 h-6 rounded-lg border flex items-center justify-center text-[10px] font-bold" :class="step >= 3 ? 'border-green-600 bg-green-600 text-white' : 'border-gray-100'">3</span>
                    <span class="text-[10px] font-bold uppercase tracking-wider">Xong</span>
                </div>
            </div>

            <button @@click="exitSigning()" class="text-xs font-bold text-gray-400 hover:text-red-600 transition">Thoát</button>
        </header>

        <!-- Document Body -->
        <div class="flex-1 p-6 md:p-10 flex flex-col items-center">
            
            <!-- DOCUMENT VIEW -->
            <div x-show="step === 1 || step === 3" class="animate-fadeIn">
                <div class="paper-sheet p-10 md:p-20 relative">
                    <div class="text-center mb-16">
                        <h2 class="text-lg font-bold uppercase underline">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</h2>
                        <p class="font-bold text-sm">Độc lập - Tự do - Hạnh phúc</p>
                    </div>

                    <div class="flex justify-between items-start mb-16">
                        <img src="/assets/images/Logo.jpg" class="h-8 opacity-50 grayscale" />
                        <div class="text-right text-[11px] text-gray-400 font-medium uppercase tracking-wider">
                            <p>Số: PL-2026-001/HUITMEAL</p>
                        </div>
                    </div>

                    <h1 class="text-center font-bold text-2xl mb-16 tracking-tight">PHỤ LỤC HỢP ĐỒNG DỊCH VỤ</h1>

                    <div class="space-y-8 text-sm leading-[1.8] text-gray-800 text-justify">
                        <p>Hôm nay, ngày 25/04/2026, chúng tôi cùng thống nhất các nội dung sau:</p>
                        <p><span class="font-bold">Bên A:</span> Công ty Cổ phần HuitMeal</p>
                        <p><span class="font-bold">Bên B:</span> Đơn vị TRƯỜNG THPT HOÀNG VĂN THỤ Enterprise</p>
                        <div class="space-y-4">
                            <p><span class="font-bold">Điều 1:</span> Tăng định mức suất ăn dự phòng từ 5% lên 15% tổng số lượng đặt hàng thực tế.</p>
                            <p><span class="font-bold">Điều 2:</span> Thời gian áp dụng kể từ kỳ cung ứng tháng 05/2026.</p>
                            <p><span class="font-bold">Điều 3:</span> Các điều khoản khác về chất lượng, đơn giá và thanh toán vẫn giữ nguyên theo Hợp đồng gốc đã ký kết.</p>
                        </div>
                        <p>Văn bản này được lập dưới dạng điện tử, có giá trị pháp lý tương đương văn bản giấy.</p>
                    </div>

                    <!-- Signatures -->
                    <div class="mt-40 grid grid-cols-2 text-sm">
                        <div class="flex flex-col items-center">
                            <p class="font-bold uppercase mb-16 text-xs text-gray-400">ĐẠI DIỆN HUITMEAL</p>
                            <div class="relative">
                                <div class="stamp-ink">
                                    <i data-lucide="check-square" class="w-6 h-6 mb-1"></i>
                                    <span>APPROVED</span>
                                    <span class="text-[7px]">BY HUITMEAL</span>
                                </div>
                            </div>
                            <p class="mt-8 text-[11px] text-gray-400 font-medium italic">Đã xác thực hệ thống</p>
                        </div>
                        <div class="flex flex-col items-center">
                            <p class="font-bold uppercase mb-16 text-xs text-gray-400">ĐẠI DIỆN KHÁCH HÀNG</p>
                            <div class="h-24 flex flex-col items-center justify-center">
                                <template x-if="step === 3 && signatureImage">
                                    <img :src="signatureImage" class="max-h-20 object-contain animate-fadeIn" />
                                </template>
                                <template x-if="step === 1">
                                    <div class="px-6 py-3 border-2 border-dashed border-gray-100 rounded-xl text-[10px] text-gray-300 font-bold uppercase tracking-widest">Chờ bạn ký</div>
                                </template>
                            </div>
                            <p class="mt-8 text-sm font-bold text-gray-900">TRƯỜNG THPT HOÀNG VĂN THỤ</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIGNATURE PAD -->
            <div x-show="step === 2" class="w-full max-w-xl animate-fadeIn h-full flex flex-col justify-center py-20">
                <div class="text-center mb-8">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Tạo chữ ký điện tử</h3>
                    <p class="text-gray-400 text-sm">Vui lòng ký tên của bạn vào khung trắng dưới đây</p>
                </div>
                <div class="bg-white p-10 rounded-2xl shadow-sm border border-gray-100">
                    <canvas id="signCanvas" width="500" height="280" class="sig-canvas w-full h-[280px]"></canvas>
                    <div class="flex justify-between items-center mt-8">
                        <button @@click="clearCanvas()" class="text-[10px] font-bold text-gray-400 hover:text-orange-600 flex items-center gap-2 transition-all uppercase">
                            <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Xóa & Làm lại
                        </button>
                        <span class="text-[9px] font-bold text-gray-300 uppercase tracking-widest">Mã hóa bảo mật 2-lớp</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Sticky Footer -->
        <footer class="bg-white border-t border-gray-100 px-8 py-5 flex justify-center shrink-0">
            <div class="w-full max-w-4xl flex gap-4">
                <template x-if="step === 1">
                    <button @@click="step = 2; $nextTick(() => initCanvas())" class="w-full py-4 bg-gray-900 text-white rounded-xl font-bold text-sm shadow-md hover:bg-orange-600 transition-all">TIẾP TỤC: KÝ TÊN</button>
                </template>
                <template x-if="step === 2">
                    <div class="flex w-full gap-4">
                        <button @@click="step = 1" class="flex-1 py-4 text-sm font-bold text-gray-400">QUAY LẠI</button>
                        <button @@click="confirmSignature()" class="flex-[2] py-4 bg-gray-900 text-white rounded-xl font-bold text-sm shadow-md hover:bg-orange-600 transition-all">XÁC NHẬN CHỮ KÝ</button>
                    </div>
                </template>
                <template x-if="step === 3">
                    <div class="flex w-full gap-4">
                        <button @@click="exitSigning()" class="flex-1 py-4 text-sm font-bold text-gray-400">HOÀN TẤT</button>
                        <button class="flex-[2] py-4 bg-green-600 text-white rounded-xl font-bold text-sm shadow-md hover:bg-green-700 transition-all">
                            <i data-lucide="download" class="w-4 h-4 inline mr-2"></i> TẢI BẢN PDF (SIGNED)
                        </button>
                    </div>
                </template>
            </div>
        </footer>
    </div>
</div>

@section Scripts {
    <script>
        function eSignFlow() {
            return {
                signingMode: false,
                step: 1,
                signatureImage: null,
                isSigned: false,
                canvas: null,
                ctx: null,
                isDrawing: false,

                startSigning() {
                    this.signingMode = true;
                    this.step = 1;
                    this.isSigned = false;
                    document.body.style.overflow = 'hidden';
                    this.$nextTick(() => lucide.createIcons());
                },

                exitSigning() {
                    this.signingMode = false;
                    document.body.style.overflow = 'auto';
                },

                stepTitle() {
                    if (this.step === 1) return 'Bước 1: Rà soát nội dung';
                    if (this.step === 2) return 'Bước 2: Vẽ chữ ký điện tử';
                    return 'Bước 3: Chứng thực thành công';
                },

                initCanvas() {
                    this.canvas = document.getElementById('signCanvas');
                    this.ctx = this.canvas.getContext('2d');
                    this.ctx.lineWidth = 2.5;
                    this.ctx.lineJoin = 'round';
                    this.ctx.lineCap = 'round';
                    this.ctx.strokeStyle = '#1e293b';

                    const start = (e) => {
                        this.isDrawing = true;
                        this.ctx.beginPath();
                        const rect = this.canvas.getBoundingClientRect();
                        const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
                        const y = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
                        this.ctx.moveTo(x, y);
                    };
                    const move = (e) => {
                        if (!this.isDrawing) return;
                        const rect = this.canvas.getBoundingClientRect();
                        const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
                        const y = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
                        this.ctx.lineTo(x, y);
                        this.ctx.stroke();
                    };
                    const stop = () => this.isDrawing = false;

                    this.canvas.addEventListener('mousedown', start);
                    this.canvas.addEventListener('mousemove', move);
                    this.canvas.addEventListener('mouseup', stop);
                    this.canvas.addEventListener('touchstart', (e) => { e.preventDefault(); start(e); });
                    this.canvas.addEventListener('touchmove', (e) => { e.preventDefault(); move(e); });
                    this.canvas.addEventListener('touchend', stop);
                    
                    lucide.createIcons();
                },

                clearCanvas() { this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height); },

                confirmSignature() {
                    this.signatureImage = this.canvas.toDataURL();
                    this.step = 3;
                    this.isSigned = true;
                    this.$nextTick(() => lucide.createIcons());
                },

                viewSignedDoc() {
                    this.signingMode = true;
                    this.step = 3;
                    document.body.style.overflow = 'hidden';
                    this.$nextTick(() => lucide.createIcons());
                }
            }
        }
        document.addEventListener("DOMContentLoaded", () => lucide.createIcons());
    </script>
}
