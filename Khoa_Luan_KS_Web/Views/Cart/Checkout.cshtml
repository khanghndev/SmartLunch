@using Khoa_Luan_KS_Web.Models
@model CartIndexViewModel
@{
    ViewData["Title"] = "Đặt hàng";
    Layout = "_LayoutCustomer";
    var flatLines = CartIndexViewModel.FlattenForOrder(Model.State);
    var defaultDate = DateTime.Today.AddDays(1).Date;
    var canSubmit = User.IsInRole("Customer") || User.IsInRole("Khách hàng cá nhân")
        || User.IsInRole("Organization") || User.IsInRole("Company") || User.IsInRole("Khách hàng doanh nghiệp");
    var skipCheckoutSignature = ViewBag.SkipCheckoutSignature as bool? == true;
}

<div class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
    <h1 class="mb-2 text-2xl font-black text-slate-900">Thanh toán &amp; đặt hàng</h1>
    @if (skipCheckoutSignature)
    {
        <p class="mb-6 text-sm text-slate-600">Chọn ngày giao suất rồi gửi đơn. Sau khi đặt hàng thành công, hệ thống sẽ mở <strong class="text-slate-800">cổng ký phụ lục đặt hàng</strong> (chữ ký điện tử + PDF lưu cloud) — không cần ký trên trang này.</p>
    }
    else
    {
        <p class="mb-6 text-sm text-slate-600">Chọn ngày giao suất, ký xác nhận (chữ ký điện tử trên trình duyệt) nếu muốn hiển thị trên hóa đơn, rồi gửi đơn. Sau đó mở chi tiết đơn để xuất hóa đơn in/PDF.</p>
    }

    @if (TempData["CheckoutError"] is string ce && !string.IsNullOrEmpty(ce))
    {
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@ce</div>
    }

    <div class="mb-6 rounded-xl border border-slate-100 bg-white p-4 text-sm shadow-sm">
        <p class="mb-2 font-bold text-slate-800">Tóm tắt (@flatLines.Count dòng gửi đơn)</p>
        <ul class="mb-3 max-h-48 space-y-2 overflow-y-auto text-xs text-slate-600">
            @foreach (var b in Model.State.MenuBundles)
            {
                var n = b.Slots.Count(s => s.Selected);
                if (n == 0) { continue; }
                <li class="flex justify-between gap-2 border-b border-slate-50 pb-2">
                    <span>Menu @b.Label × @b.BundleQuantity bộ (@n suất/bộ)</span>
                    <span class="shrink-0 font-bold text-slate-800">@((b.Slots.Where(s => s.Selected).Sum(s => s.Price) * b.BundleQuantity).ToString("N0")) đ</span>
                </li>
            }
            @foreach (var line in Model.State.LooseLines)
            {
                <li class="flex justify-between gap-2 border-b border-slate-50 pb-2">
                    <span>@line.Name × @line.Quantity</span>
                    <span class="shrink-0 font-bold text-slate-800">@((line.Price * line.Quantity).ToString("N0")) đ</span>
                </li>
            }
        </ul>
        <p class="text-lg font-black text-orange-600">@Model.TotalAmount.ToString("N0") đ</p>
    </div>

    <form asp-action="Checkout" method="post" class="space-y-6 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm" id="checkout-form">
        @Html.AntiForgeryToken()
        <div>
            <label class="mb-1 block text-sm font-bold text-slate-700">Ngày giao / ăn suất</label>
            <input type="datetime-local" name="scheduledDate" required
                   value="@defaultDate.ToString("yyyy-MM-ddTHH:mm")"
                   class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium" />
        </div>

        @if (!skipCheckoutSignature)
        {
            <div>
                <label class="mb-2 block text-sm font-bold text-slate-700">Chữ ký xác nhận (không bắt buộc)</label>
                <p class="mb-2 text-xs text-slate-500">Ký bằng chuột hoặc cảm ứng. Dùng cho xác nhận điện tử trên hóa đơn in (phiên bản demo nội bộ).</p>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-2">
                    <canvas id="sig-canvas" width="400" height="160" class="w-full max-w-full cursor-crosshair touch-none rounded-lg bg-white"></canvas>
                </div>
                <div class="mt-2 flex gap-2">
                    <button type="button" id="sig-clear" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-50">Xóa chữ ký</button>
                </div>
                <input type="hidden" name="signatureDataUrl" id="signatureDataUrl" value="" />
            </div>
        }

        @if (canSubmit)
        {
            <button type="submit" class="w-full rounded-xl bg-orange-500 py-3.5 text-sm font-black text-white shadow-lg shadow-orange-500/25 hover:bg-orange-600">
                Xác nhận đặt hàng
            </button>
        }
        else
        {
            <button type="button" disabled class="w-full cursor-not-allowed rounded-xl bg-slate-300 py-3.5 text-sm font-black text-slate-500">
                Tài khoản chưa được phép đặt suất trực tuyến
            </button>
        }
        <a asp-action="Index" class="block text-center text-sm font-bold text-slate-500 hover:text-orange-600">Quay lại giỏ</a>
    </form>
</div>

@section Scripts {
    @if (!skipCheckoutSignature)
    {
    <script>
        (function () {
            const canvas = document.getElementById('sig-canvas');
            const hidden = document.getElementById('signatureDataUrl');
            const form = document.getElementById('checkout-form');
            if (!canvas || !hidden || !form) return;
            const ctx = canvas.getContext('2d');
            let drawing = false, last = null;

            function pos(e) {
                const r = canvas.getBoundingClientRect();
                const t = e.touches ? e.touches[0] : e;
                return { x: (t.clientX - r.left) * (canvas.width / r.width), y: (t.clientY - r.top) * (canvas.height / r.height) };
            }
            function start(e) { drawing = true; last = pos(e); e.preventDefault(); }
            function end() { drawing = false; last = null; }
            function move(e) {
                if (!drawing || !last) return;
                const p = pos(e);
                ctx.strokeStyle = '#0f172a';
                ctx.lineWidth = 2;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(last.x, last.y);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();
                last = p;
                e.preventDefault();
            }
            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', move);
            canvas.addEventListener('mouseup', end);
            canvas.addEventListener('mouseleave', end);
            canvas.addEventListener('touchstart', start, { passive: false });
            canvas.addEventListener('touchmove', move, { passive: false });
            canvas.addEventListener('touchend', end);

            document.getElementById('sig-clear').addEventListener('click', function () {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                hidden.value = '';
            });

            form.addEventListener('submit', function () {
                try {
                    const blank = document.createElement('canvas');
                    blank.width = canvas.width; blank.height = canvas.height;
                    if (blank.toDataURL() !== canvas.toDataURL())
                        hidden.value = canvas.toDataURL('image/png');
                } catch (_) { }
            });
        })();
    </script>
    }
}
