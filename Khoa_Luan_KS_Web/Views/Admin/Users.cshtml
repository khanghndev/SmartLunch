@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "_LayoutAdmin";

    var users = new[] {
        new { Id = 1, Username = "admin01", Name = "Hệ thống Admin", Email = "admin@HuitMeal.com", Role = "ADMIN", Created = "15/01/2026", IsLocked = false },
        new { Id = 2, Username = "manager01", Name = "Trần Quản Lý", Email = "manager@HuitMeal.com", Role = "MANAGER", Created = "20/01/2026", IsLocked = false },
        new { Id = 3, Username = "staff01", Name = "Lê Nhân Viên", Email = "staff@HuitMeal.com", Role = "STAFF", Created = "25/01/2026", IsLocked = true },
    };
}

<div class="space-y-6 p-2 sm:p-6" x-data="{ showForm: false, searchText: '' }">
    <!-- Header + Search + Add -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 sm:gap-0">
        <h1 class="text-2xl font-bold text-green-600">Danh sách tài khoản người dùng</h1>

        <div class="flex gap-3 flex-wrap sm:flex-nowrap">
            <div class="relative flex-1 min-w-[200px]">
                <input x-model="searchText" type="text" placeholder="Tìm kiếm..." class="w-full pl-10 pr-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-green-500" />
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            </div>
            <button x-on:click="showForm = true" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md flex-shrink-0 transition">
                + Thêm mới
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl shadow overflow-x-auto">
        <!-- Table desktop -->
        <table class="w-full text-sm table-fixed hidden sm:table">
            <thead class="bg-green-600 text-white">
                <tr>
                    <th class="p-3 text-left w-12">ID</th>
                    <th class="p-3 w-40 text-left">Tên đăng nhập</th>
                    <th class="p-3 w-40 text-left">Họ và tên</th>
                    <th class="p-3 w-48 text-left">Email</th>
                    <th class="p-3 w-24 text-left">Vai trò</th>
                    <th class="p-3 w-32 text-center">Ngày tạo</th>
                    <th class="p-3 w-24 text-center">Trạng thái</th>
                    <th class="p-3 w-32 text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var u in users) {
                    <tr class="border-t hover:bg-green-50">
                        <td class="p-3">@u.Id</td>
                        <td class="p-3 font-medium truncate">@u.Username</td>
                        <td class="p-3 truncate">@u.Name</td>
                        <td class="p-3 truncate">@u.Email</td>
                        <td class="p-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-green-200 text-green-800">@u.Role</span>
                        </td>
                        <td class="p-3 text-center">@u.Created</td>
                        <td class="p-3 text-center">
                            @if(u.IsLocked) {
                                <span class="px-2 py-1 text-xs rounded-full bg-red-200 text-red-800">Đã khóa</span>
                            } else {
                                <span class="px-2 py-1 text-xs rounded-full bg-green-200 text-green-800">Hoạt động</span>
                            }
                        </td>
                        <td class="p-3 flex gap-3 justify-center">
                            <button class="text-blue-600 hover:text-blue-800"><i class="fas fa-pencil-alt"></i></button>
                            <button class="@(u.IsLocked ? "text-red-500" : "text-orange-500")"><i class="fas fa-lock"></i></button>
                            <button class="text-red-500 hover:text-red-700"><i class="fas fa-trash-alt"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Card mobile -->
        <div class="space-y-4 sm:hidden p-4 bg-gray-50">
            @foreach(var u in users) {
                <div class="bg-white border rounded-xl p-4 shadow flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="font-medium text-base">@u.Username</p>
                            <p class="text-gray-500 text-sm">@u.Name</p>
                            <p class="text-gray-500 text-sm truncate max-w-[200px]">@u.Email</p>
                        </div>
                        <div class="flex gap-3">
                            <button class="text-blue-600"><i class="fas fa-pencil-alt"></i></button>
                            <button class="text-orange-500"><i class="fas fa-lock"></i></button>
                            <button class="text-red-500"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                    <div class="flex justify-between items-center mt-2 text-sm">
                        <span class="px-2 py-1 rounded-full bg-green-200 text-green-800 text-xs">@u.Role</span>
                        @if(u.IsLocked) {
                             <span class="px-2 py-1 text-xs rounded-full bg-red-200 text-red-800">Đã khóa</span>
                        } else {
                             <span class="px-2 py-1 text-xs rounded-full bg-green-200 text-green-800">Hoạt động</span>
                        }
                    </div>
                    <div class="text-sm text-gray-500 mt-1">Ngày tạo: @u.Created</div>
                </div>
            }
        </div>
    </div>

    <!-- Modal Form Thêm Mới -->
    <div x-show="showForm" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md" x-on:click.outside="showForm = false">
            <div class="flex justify-between items-center border-b p-4">
                <h3 class="text-lg font-bold text-green-600">Thêm tài khoản</h3>
                <button x-on:click="showForm = false" class="text-gray-500 hover:text-black hover:bg-gray-100 rounded-full w-8 h-8 flex items-center justify-center"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tên đăng nhập</label>
                    <input type="text" class="w-full border px-3 py-2 rounded focus:ring-green-500 focus:border-green-500" />
                </div>
                 <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên</label>
                    <input type="text" class="w-full border px-3 py-2 rounded focus:ring-green-500 focus:border-green-500" />
                </div>
                 <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Quyền truy cập</label>
                    <select class="w-full border px-3 py-2 rounded focus:ring-green-500 focus:border-green-500">
                        <option>ADMIN</option>
                        <option>MANAGER</option>
                        <option>STAFF</option>
                    </select>
                </div>
            </div>
            <div class="border-t p-4 flex justify-end gap-3">
                <button x-on:click="showForm = false" class="px-4 py-2 border rounded hover:bg-gray-50">Hủy</button>
                <button x-on:click="showForm = false" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Lưu</button>
            </div>
        </div>
    </div>
</div>
