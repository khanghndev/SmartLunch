@{
    ViewData["Title"] = "Cấu hình AI";
    Layout = "_LayoutAdmin";
}

<div class="p-2 sm:p-6 space-y-6" x-data="{ sentimentEnabled: true, recommendEnabled: true }">
    <h1 class="text-2xl font-bold text-green-600 mb-4">Cấu hình AI hệ thống</h1>

    <!-- AI CARD 1: SENTIMENT -->
    <div class="bg-white rounded-xl shadow p-6 border border-gray-100">
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-4 pb-4 border-b">
            <div>
                <h2 class="text-lg font-bold text-gray-800">CẢM XÚC & ĐÁNH GIÁ (SENTIMENT)</h2>
                <p class="text-sm text-gray-500">Cấu hình hành vi AI phân tích cảm xúc từ phản hồi người dùng.</p>
            </div>
            
            <div class="flex items-center gap-4">
                <select class="border rounded px-3 py-1.5 text-sm outline-none focus:ring-green-500">
                    <option>GPT-4o (OpenAI)</option>
                    <option>Gemini 1.5 Pro</option>
                    <option>Claude 3.5 Sonnet</option>
                </select>
                <!-- Toggle -->
                <button x-on:click="sentimentEnabled = !sentimentEnabled" :class="sentimentEnabled ? 'bg-green-500' : 'bg-gray-300'" class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                    <span :class="sentimentEnabled ? 'translate-x-6' : 'translate-x-1'" class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                </button>
            </div>
        </div>

        <div x-show="sentimentEnabled" x-collapse>
            <div class="space-y-4">
                <div>
                    <div class="flex justify-between text-sm mb-1 text-gray-600">
                        <span>Độ nhạy cảm (Threshold)</span>
                        <span>0.7</span>
                    </div>
                    <input type="range" min="0" max="1" step="0.1" value="0.7" class="w-full accent-green-600" />
                </div>
                <div class="bg-gray-50 p-4 rounded mt-4">
                    <h3 class="text-sm font-semibold mb-2">Test AI Control Panel</h3>
                    <div class="flex gap-2">
                        <input type="text" placeholder="Nhập câu mẫu..." class="border px-3 py-2 text-sm w-full rounded" />
                        <button class="bg-gray-800 text-white px-4 text-sm rounded whitespace-nowrap hover:bg-gray-900 transition">Test</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- AI CARD 2: RECOMMENDATION -->
    <div class="bg-white rounded-xl shadow p-6 border border-gray-100">
         <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-4 pb-4 border-b">
            <div>
                <h2 class="text-lg font-bold text-gray-800">GỢI Ý THỰC ĐƠN (RECOMMENDATION)</h2>
                <p class="text-sm text-gray-500">Cấu hình hành vi AI tạo suất ăn thông minh dựa theo lịch sử.</p>
            </div>
            
            <div class="flex items-center gap-4">
                <select class="border rounded px-3 py-1.5 text-sm outline-none focus:ring-green-500">
                    <option>GPT-4o (OpenAI)</option>
                    <option selected>Gemini 1.5 Pro</option>
                    <option>Claude 3.5 Sonnet</option>
                </select>
                <!-- Toggle -->
                <button x-on:click="recommendEnabled = !recommendEnabled" :class="recommendEnabled ? 'bg-green-500' : 'bg-gray-300'" class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                    <span :class="recommendEnabled ? 'translate-x-6' : 'translate-x-1'" class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                </button>
            </div>
        </div>

        <div x-show="recommendEnabled" x-collapse>
            <div class="space-y-4">
                <div>
                     <div class="flex justify-between text-sm mb-1 text-gray-600">
                        <span>Độ sáng tạo (Temperature)</span>
                        <span>0.9</span>
                    </div>
                    <input type="range" min="0" max="1" step="0.1" value="0.9" class="w-full accent-green-600" />
                </div>
            </div>
        </div>
    </div>

    <button class="bg-green-600 hover:bg-green-700 transition text-white px-6 py-3 rounded-lg font-bold flex items-center gap-2">
        <i class="fas fa-save"></i> Lưu cấu hình toàn cầu
    </button>
</div>
