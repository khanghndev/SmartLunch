@{
    ViewData["Title"] = "Nhật ký hệ thống";
    Layout = "_LayoutAdmin";

    var logs = new[] {
        new { Id = 101, User = "admin01", Action = "CREATE", Target = "USER", Description = "Tạo mới tài khoản manager_hn", Time = "25/04/2026 14:30:10" },
        new { Id = 102, User = "manager01", Action = "UPDATE", Target = "MENU", Description = "Cập nhật thực đơn tuần 4", Time = "25/04/2026 13:15:00" },
        new { Id = 103, User = "system", Action = "CRON", Target = "BACKUP", Description = "Auto backup success", Time = "25/04/2026 00:00:00" },
    };
}

<div class="p-2 sm:p-6 space-y-6">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
        <h1 class="text-2xl font-bold text-green-600">Nhật ký hoạt động (Activity Logs)</h1>
        
        <div class="flex gap-2">
            <input type="text" placeholder="Tìm kiếm log..." class="border rounded-md px-4 py-2 w-full sm:w-64 focus:ring-green-500 focus:border-green-500" />
            <button class="bg-gray-100 text-gray-600 hover:bg-gray-200 px-4 py-2 rounded shadow-sm border transition"><i class="fas fa-sync-alt"></i></button>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow overflow-hidden">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-gray-50 border-b text-gray-600">
                <tr>
                    <th class="p-4">Thời gian</th>
                    <th class="p-4">Người dùng</th>
                    <th class="p-4">Hành động</th>
                    <th class="p-4">Đối tượng</th>
                    <th class="p-4 w-1/3">Mô tả chi tiết</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @foreach(var log in logs) {
                    <tr class="hover:bg-green-50 transition">
                        <td class="p-4 text-gray-500">@log.Time</td>
                        <td class="p-4 font-medium">@log.User</td>
                        <td class="p-4">
                            @if(log.Action == "CREATE") {
                                <span class="px-2 py-1 text-xs rounded bg-blue-100 text-blue-700 font-bold">@log.Action</span>
                            } else if (log.Action == "UPDATE") {
                                <span class="px-2 py-1 text-xs rounded bg-orange-100 text-orange-700 font-bold">@log.Action</span>
                            } else {
                                <span class="px-2 py-1 text-xs rounded bg-gray-200 text-gray-700 font-bold">@log.Action</span>
                            }
                        </td>
                        <td class="p-4">@log.Target</td>
                        <td class="p-4 text-gray-600 truncate max-w-xs" title="@log.Description">@log.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    <div class="flex justify-end items-center gap-2 mt-4">
        <button class="p-2 rounded bg-gray-100 text-gray-400 cursor-not-allowed">
            <i class="fas fa-chevron-left"></i>
        </button>
        <span class="px-2 text-sm text-gray-700">1 / 1</span>
        <button class="p-2 rounded bg-gray-100 text-gray-400 cursor-not-allowed">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>
