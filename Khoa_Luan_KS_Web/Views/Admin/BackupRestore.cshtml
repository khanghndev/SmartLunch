@{
    ViewData["Title"] = "Sao lưu & Phục hồi";
    Layout = "_LayoutAdmin";
}

<div class="p-2 sm:p-6 space-y-6">
    <h1 class="text-2xl font-bold text-green-600 mb-4">
        Sao lưu & Phục hồi Dữ liệu
    </h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- BACKUP FORM -->
        <div class="bg-white rounded-xl shadow p-6 border-t-4 border-green-500">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                    <i class="fas fa-download"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-gray-800">Tạo bản sao lưu mới</h2>
                    <p class="text-sm text-gray-500">Lưu trữ hệ thống an toàn</p>
                </div>
            </div>
            <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                Việc sao lưu sẽ lưu lại toàn bộ dữ liệu hiện tại bao gồm tài khoản, đơn hàng, cấu hình và lịch sử thao tác. Quá trình có thể mất vài phút.
            </p>
            <button class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-lg flex items-center justify-center gap-2 transition">
                <i class="fas fa-save"></i> Tiến hành Sao lưu
            </button>
            <div class="mt-4 text-xs text-gray-500 text-center">Bản sao lưu gần nhất: Hôm qua, 23:45</div>
        </div>

        <!-- RESTORE FORM -->
        <div class="bg-white rounded-xl shadow p-6 border-t-4 border-yellow-500">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600">
                    <i class="fas fa-upload"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-gray-800">Phục hồi dữ liệu</h2>
                    <p class="text-sm text-gray-500">Trở lại bản ghi trước đó</p>
                </div>
            </div>
            
            <p class="text-sm text-gray-600 mb-4 leading-relaxed">
                Tải lên file định dạng <strong>.bak</strong> hoặc <strong>.sql</strong> từ hệ thống lưu trữ của bạn. Cảnh báo: Việc phục hồi sẽ ghi đè dữ liệu hiện tại.
            </p>
            
            <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 flex flex-col items-center justify-center bg-gray-50 hover:bg-gray-100 transition cursor-pointer mb-4">
                <i class="fas fa-cloud-upload-alt text-3xl text-gray-400 mb-2"></i>
                <span class="text-sm text-gray-600 font-medium">Bấm để chọn file sao lưu</span>
            </div>

            <button class="w-full bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-3 rounded-lg flex items-center justify-center gap-2 transition">
                <i class="fas fa-sync"></i> Bắt đầu Phục hồi
            </button>
        </div>

    </div>
</div>
