@model Khoa_Luan_KS_Web.Models.OrganizationMealContractWeeklyTrackVm
@using Khoa_Luan_KS_Web.Helpers
@{
    ViewData["Title"] = "Theo dõi suất ăn tuần";
    Layout = "_LayoutCustomer";
    var w = Model.Week;
    var weekLabel = $"Tuần {w.WeekMonday:dd/MM} – {w.WeekEnd:dd/MM/yyyy}";
}

<div class="min-h-screen bg-slate-100/90" style="background-image: radial-gradient(circle at 1px 1px, rgba(148,163,184,0.2) 1px, transparent 0); background-size: 24px 24px;">
    <section class="relative h-[180px] overflow-hidden sm:h-[200px]">
        <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=1920&auto=format&fit=crop"
             alt="" class="absolute inset-0 h-full w-full object-cover brightness-[0.45]" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/65 to-slate-900/25"></div>
        <div class="relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-end px-4 pb-8 pt-20 sm:px-6">
            <nav class="mb-2 flex flex-wrap items-center gap-2 text-xs font-semibold text-white/70">
                <a asp-action="Detail" asp-route-id="@Model.ContractId" class="hover:text-orange-300">Chi tiết HĐ</a>
                <span class="text-white/30">/</span>
                <span class="text-white/90">Theo dõi tuần</span>
            </nav>
            <h1 class="text-xl font-black text-white sm:text-2xl">@ContractWeeklySelectionDisplay.TrackWeekButtonLabel</h1>
            <p class="mt-1 text-sm text-slate-300">@(Model.ContractNumber ?? $"HĐ #{Model.ContractId}") · @weekLabel</p>
        </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        @if (!string.IsNullOrEmpty(Model.ApiError))
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900">@Model.ApiError</div>
        }
        else
        {
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/80 px-5 py-4">
                <div>
                    <span class="rounded-full px-2.5 py-0.5 text-[10px] font-bold @ContractWeeklySelectionDisplay.StatusBadgeClass(w.Status)">
                        @ContractWeeklySelectionDisplay.StatusLabel(w.Status)
                    </span>
                    @if (w.SelectedAt.HasValue)
                    {
                        <p class="mt-1 text-xs text-emerald-800">Lưu lúc @w.SelectedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                    }
                </div>
                @if (w.FulfillmentOrderId is int orderId)
                {
                    <a asp-controller="Profile" asp-action="OrderDetail" asp-route-id="@orderId"
                       class="text-xs font-bold text-emerald-800 hover:underline">Mã đơn fulfillment #@orderId</a>
                }
            </div>

            <div class="space-y-4">
                @foreach (var day in w.Days)
                {
                    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <div class="border-b border-slate-100 bg-slate-50 px-5 py-3">
                            <p class="font-black text-slate-900">@day.ServiceDate.ToString("dddd, dd/MM/yyyy")</p>
                            <p class="text-xs text-slate-500">@(day.Main.Sum(l => l.Quantity))/@(day.RequiredMeals) suất</p>
                        </div>
                        <ul class="divide-y divide-slate-100 px-5 py-2">
                            @if (day.Main.Count == 0)
                            {
                                <li class="py-3 text-sm text-slate-500">Chưa có món.</li>
                            }
                            @foreach (var line in day.Main)
                            {
                                <li class="flex items-center justify-between py-3 text-sm">
                                    <span class="font-semibold text-slate-800">@line.DishName</span>
                                    <span class="rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-black text-orange-800">×@line.Quantity</span>
                                </li>
                            }
                        </ul>
                    </article>
                }
            </div>

            <div class="mt-8 flex flex-wrap gap-3">
                <a asp-action="Detail" asp-route-id="@Model.ContractId"
                   class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-orange-500 to-amber-500 px-5 py-2.5 text-sm font-black text-white shadow">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i> Quay lại chi tiết HĐ
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', () => { if (window.lucide) lucide.createIcons(); });</script>
}
