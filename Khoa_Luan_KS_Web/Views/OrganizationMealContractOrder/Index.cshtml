        }
    </section>
</div>

@section Scripts {
<script>
    document.addEventListener('alpine:init', () => {
        const orgId = @orgIdJson;
        const periodStartDefault = @Json.Serialize(periodStartDefault);
        const periodEndDefault = @Json.Serialize(periodEndDefault);
        const periodStartMin = @Json.Serialize(periodStartMin);
        const antiToken = @Html.Raw(antiTokenJson);
        const deliveryDefaults = @Html.Raw(deliveryDefaultsJson);

        Alpine.data('orgMealPeriodApp', () => ({
            step: 1,
            periodStart: periodStartDefault,
            periodEnd: periodEndDefault,
            periodStartMin,
            mealsPerDay: 50,
            mealUnitPrice: 45000,
            excludedDates: [],
            dailyMealOverrides: {},
            selectedDay: null,
            selectedDayMeals: null,
            holidayMap: {},
            calYear: 0,
            calMonth: 0,
            formError: '',
            submitting: false,
            delivery: {
                recipientName: '',
                recipientPhone: '',
                recipientEmail: '',
                deliveryAddress: '',
                deliveryWardDistrict: '',
                deliveryNotes: '',
                preferredDeliveryTime: '11:30',
            },
            deliveryPrefilled: false,
            deliveryDefaultsHint: '',
            stepMeta: [
                { key: 'period', label: 'Kỳ HĐ', hint: 'Ngày & đơn giá' },
                { key: 'delivery', label: 'Giao hàng', hint: 'Người nhận' },
                { key: 'promo', label: 'Khuyến mãi', hint: 'Mã giảm giá' },
                { key: 'summary', label: 'Xác nhận', hint: 'Tạo nháp' },
            ],
            promoLoading: false,
            promoApplying: false,
            eligiblePromotions: [],
            promoListMessage: '',
            promoSubtotalAmount: 0,
            promoDiscountAmount: 0,
            promotionCode: '',
            selectedPromotionId: null,
            selectedPromotionName: '',
            manualPromoCode: '',
            promoPreviewMessage: '',
            promoPreviewApplied: false,

            init() {
                const p = this.parseIso(this.periodStart);
                if (p) { this.calYear = p.y; this.calMonth = p.m; }
                this.applyDeliveryDefaults(deliveryDefaults);
                this.loadHolidays();
                this.$watch('periodStart', () => { this.pruneExcluded(); this.pruneOverrides(); this.loadHolidays(); });
                this.$watch('periodEnd', () => { this.pruneExcluded(); this.pruneOverrides(); this.loadHolidays(); });
                this.$watch('mealsPerDay', () => this.pruneOverrides());
                this.$watch('selectedDay', (iso) => {
                    if (!iso || this.isDayExcluded(iso)) {
                        this.selectedDayMeals = this.mealsPerDay;
                        return;
                    }
                    this.selectedDayMeals = this.getMealsForDate(iso);
                });
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },

            parseIso(iso) {
                if (!iso) return null;
                const p = iso.split('-').map(Number);
                if (p.length < 3) return null;
                return { y: p[0], m: p[1] - 1, d: p[2] };
            },
            toIso(y, m, d) {
                return y + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
            },
            dayNum(iso) {
                const p = this.parseIso(iso);
                return p ? p.d : 0;
            },
            formatDate(iso) {
                if (!iso) return '';
                const p = iso.split('-');
                return p[2] + '/' + p[1] + '/' + p[0];
            },
            formatMoney(n) {
                return new Intl.NumberFormat('vi-VN').format(Math.round(n || 0));
            },
            maxPeriodEnd() {
                const s = this.parseIso(this.periodStart);
                if (!s) return this.periodEnd;
                const end = new Date(s.y, s.m, s.d);
                end.setDate(end.getDate() + 61);
                return this.toIso(end.getFullYear(), end.getMonth(), end.getDate());
            },
            onPeriodStartChange() {
                const max = this.maxPeriodEnd();
                if (this.periodEnd > max) this.periodEnd = max;
                if (this.periodEnd < this.periodStart) this.periodEnd = this.periodStart;
                this.pruneExcluded();
                this.pruneOverrides();
            },
            pruneExcluded() {
                this.excludedDates = this.excludedDates.filter(d =>
                    d >= this.periodStart && d <= this.periodEnd);
                if (this.selectedDay && !this.isInRange(this.selectedDay))
                    this.selectedDay = null;
            },
            pruneOverrides() {
                const def = Math.max(1, parseInt(this.mealsPerDay, 10) || 1);
                const next = {};
                for (const [iso, count] of Object.entries(this.dailyMealOverrides)) {
                    if (!this.isInRange(iso)) continue;
                    if (this.excludedDates.includes(iso)) continue;
                    if (count !== def) next[iso] = count;
                }
                this.dailyMealOverrides = next;
            },
            async loadHolidays() {
                if (!this.periodStart || !this.periodEnd || this.periodEnd < this.periodStart) {
                    this.holidayMap = {};
                    return;
                }
                try {
                    const res = await fetch('/OrganizationMealContractOrder/Holidays?from=' +
                        encodeURIComponent(this.periodStart) + '&to=' + encodeURIComponent(this.periodEnd));
                    const data = await res.json();
                    this.holidayMap = data.map || {};
                } catch {
                    this.holidayMap = {};
                }
            },
            getMealsForDate(iso) {
                const def = Math.max(1, parseInt(this.mealsPerDay, 10) || 1);
                if (!iso || this.isDayExcluded(iso)) return 0;
                const custom = this.dailyMealOverrides[iso];
                return custom && custom > 0 ? custom : def;
            },
            isDayExcluded(iso) {
                return iso && this.excludedDates.includes(iso);
            },
            customMealDayCount() {
                return Object.keys(this.dailyMealOverrides).length;
            },
            totalMealsCount() {
                if (!this.periodStart || !this.periodEnd || this.periodEnd < this.periodStart) return 0;
                const start = this.parseIso(this.periodStart);
                const end = this.parseIso(this.periodEnd);
                if (!start || !end) return 0;
                let total = 0;
                for (let d = new Date(Date.UTC(start.y, start.m, start.d));
                     d <= new Date(Date.UTC(end.y, end.m, end.d));
                     d.setUTCDate(d.getUTCDate() + 1)) {
                    const iso = this.toIso(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
                    if (!this.isDayExcluded(iso))
                        total += this.getMealsForDate(iso);
                }
                return total;
            },
            selectedDayNote() {
                if (!this.selectedDay) return '';
                return this.holidayMap[this.selectedDay] || this.weekendNote(this.selectedDay) || '';
            },
            weekendNote(iso) {
                const p = this.parseIso(iso);
                if (!p) return '';
                const dow = new Date(p.y, p.m, p.d).getDay();
                if (dow === 6) return 'Thứ Bảy';
                if (dow === 0) return 'Chủ nhật';
                return '';
            },
            onCalendarDayClick(iso, ev) {
                if (!this.isInRange(iso)) return;
                if (ev.shiftKey) {
                    this.toggleExcluded(iso);
                    return;
                }
                this.selectedDay = iso;
                this.selectedDayMeals = this.getMealsForDate(iso);
            },
            applySelectedDayMeals() {
                if (!this.selectedDay || this.isDayExcluded(this.selectedDay)) return;
                const def = Math.max(1, parseInt(this.mealsPerDay, 10) || 1);
                const count = Math.max(1, parseInt(this.selectedDayMeals, 10) || def);
                if (count === def) {
                    delete this.dailyMealOverrides[this.selectedDay];
                } else {
                    this.dailyMealOverrides[this.selectedDay] = count;
                }
                this.dailyMealOverrides = { ...this.dailyMealOverrides };
            },
            clearSelectedDayMeals() {
                if (!this.selectedDay) return;
                delete this.dailyMealOverrides[this.selectedDay];
                this.dailyMealOverrides = { ...this.dailyMealOverrides };
                this.selectedDayMeals = Math.max(1, parseInt(this.mealsPerDay, 10) || 1);
            },
            isInRange(iso) {
                return iso && iso >= this.periodStart && iso <= this.periodEnd;
            },
            serviceDaysCount() {
                if (!this.periodStart || !this.periodEnd || this.periodEnd < this.periodStart) return 0;
                const start = this.parseIso(this.periodStart);
                const end = this.parseIso(this.periodEnd);
                if (!start || !end) return 0;
                const inclusive = Math.floor((Date.UTC(end.y, end.m, end.d) - Date.UTC(start.y, start.m, start.d)) / 86400000) + 1;
                const excl = this.excludedDates.filter(d => this.isInRange(d)).length;
                return Math.max(0, inclusive - excl);
            },
            estimatedTotal() {
                const totalMeals = this.totalMealsCount();
                const price = parseFloat(this.mealUnitPrice) || 0;
                if (totalMeals < 1 || price <= 0) return 0;
                return Math.round(totalMeals * price);
            },
            promoSubtotal() {
                return this.promoSubtotalAmount > 0 ? this.promoSubtotalAmount : this.estimatedTotal();
            },
            promoDiscount() {
                return (this.selectedPromotionId || this.promotionCode)
                    ? (this.promoDiscountAmount || 0) : 0;
            },
            promoTotalAfter() {
                const sub = this.promoSubtotal();
                const disc = this.promoDiscount();
                return Math.max(0, sub - disc);
            },
            calMonthLabel() {
                const names = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6','Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
                return (names[this.calMonth] || '') + ' ' + this.calYear;
            },
            prevCalMonth() {
                if (this.calMonth === 0) { this.calMonth = 11; this.calYear--; }
                else this.calMonth--;
            },
            nextCalMonth() {
                if (this.calMonth === 11) { this.calMonth = 0; this.calYear++; }
                else this.calMonth++;
            },
            calendarCells() {
                const first = new Date(this.calYear, this.calMonth, 1);
                const offset = (first.getDay() + 6) % 7;
                const daysInMonth = new Date(this.calYear, this.calMonth + 1, 0).getDate();
                const cells = [];
                for (let i = 0; i < offset; i++) cells.push({ date: null, inRange: false, excluded: false, dayNum: '' });
                for (let d = 1; d <= daysInMonth; d++) {
                    const iso = this.toIso(this.calYear, this.calMonth, d);
                    const p = this.parseIso(iso);
                    const dow = p ? new Date(p.y, p.m, p.d).getDay() : -1;
                    const isWeekend = dow === 0 || dow === 6;
                    const holiday = this.holidayMap[iso];
                    const note = holiday || (isWeekend ? (dow === 6 ? 'T7' : 'CN') : '');
                    const excluded = this.excludedDates.includes(iso);
                    const custom = this.dailyMealOverrides[iso];
                    const meals = excluded ? 0 : this.getMealsForDate(iso);
                    const def = Math.max(1, parseInt(this.mealsPerDay, 10) || 1);
                    cells.push({
                        date: iso,
                        inRange: this.isInRange(iso),
                        excluded,
                        dayNum: d,
                        note,
                        isHoliday: !!holiday,
                        isWeekend,
                        customMeals: !!custom,
                        mealsLabel: excluded ? 'Nghỉ' : (meals + ' suất'),
                    });
                }
                return cells;
            },
            toggleExcluded(iso) {
                if (!this.isInRange(iso)) return;
                const i = this.excludedDates.indexOf(iso);
                if (i >= 0) {
                    this.excludedDates.splice(i, 1);
                } else {
                    this.excludedDates.push(iso);
                    delete this.dailyMealOverrides[iso];
                }
                this.excludedDates.sort();
                if (this.selectedDay === iso)
                    this.selectedDayMeals = this.getMealsForDate(iso);
            },
            applyDeliveryDefaults(defaults, force = false) {
                if (!defaults) return;
                const d = this.delivery;
                const fill = (key, val) => {
                    if (val == null || !String(val).trim()) return;
                    if (force || !d[key] || !String(d[key]).trim()) d[key] = String(val).trim();
                };
                fill('recipientName', defaults.recipientName);
                fill('recipientPhone', defaults.recipientPhone);
                fill('recipientEmail', defaults.recipientEmail);
                fill('deliveryAddress', defaults.deliveryAddress);
                fill('deliveryWardDistrict', defaults.deliveryWardDistrict);
                fill('deliveryNotes', defaults.deliveryNotes);
                if (defaults.preferredDeliveryTime && (force || !d.preferredDeliveryTime))
                    d.preferredDeliveryTime = defaults.preferredDeliveryTime;
                this.deliveryDefaultsHint = defaults.sourceHint || '';
                this.deliveryPrefilled = !!(d.recipientName && d.recipientPhone && d.recipientEmail && d.deliveryAddress);
            },
            fullDeliveryAddress() {
                const w = (this.delivery.deliveryWardDistrict || '').trim();
                const a = (this.delivery.deliveryAddress || '').trim();
                return w ? a + ', ' + w : a;
            },
            validatePeriod() {
                if (!this.periodStart || !this.periodEnd) return 'Chọn ngày bắt đầu và kết thúc.';
                if (this.periodStart < this.periodStartMin) return 'Ngày bắt đầu phải từ tháng kế tiếp trở đi.';
                if (this.periodEnd < this.periodStart) return 'Ngày kết thúc phải sau ngày bắt đầu.';
                if (this.periodEnd > this.maxPeriodEnd()) return 'Thời hạn tối đa 62 ngày (khoảng 1 tháng).';
                if (!this.mealsPerDay || this.mealsPerDay < 1) return 'Nhập số suất/ngày hợp lệ.';
                if (!this.mealUnitPrice || this.mealUnitPrice <= 0) return 'Nhập đơn giá/suất hợp lệ.';
                if (this.serviceDaysCount() < 1) return 'Phải có ít nhất 1 ngày phục vụ sau khi loại trừ.';
                return '';
            },
            validateDelivery() {
                const d = this.delivery;
                if (!d.recipientName || d.recipientName.length < 2) return 'Nhập họ tên người nhận (ít nhất 2 ký tự).';
                const phone = (d.recipientPhone || '').replace(/\s|-/g, '');
                if (!/^(\+?84|0)[0-9]{8,10}$/.test(phone)) return 'Số điện thoại không hợp lệ.';
                const email = (d.recipientEmail || '').trim();
                if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) return 'Email không hợp lệ.';
                if (!d.deliveryAddress || d.deliveryAddress.length < 10) return 'Địa chỉ giao hàng phải có ít nhất 10 ký tự.';
                return '';
            },
            goStep2() {
                this.formError = this.validatePeriod();
                if (this.formError) return;
                this.applyDeliveryDefaults(deliveryDefaults);
                this.step = 2;
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            async goStep3() {
                this.formError = this.validatePeriod() || this.validateDelivery();
                if (this.formError) return;
                this.step = 3;
                this.formError = '';
                await this.loadEligiblePromotions();
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            goStep4() {
                this.formError = this.validatePeriod() || this.validateDelivery();
                if (this.formError) return;
                this.step = 4;
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },
            async loadEligiblePromotions() {
                this.promoLoading = true;
                this.eligiblePromotions = [];
                this.promoListMessage = '';
                try {
                    const payload = this.buildPayload();
                    delete payload.promotionCode;
                    delete payload.promotionId;
                    const res = await fetch('/OrganizationMealContractOrder/EligiblePromotions', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiToken,
                        },
                        body: JSON.stringify(payload),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Không tải được mã khuyến mãi.');
                    this.promoSubtotalAmount = data.subtotal || this.estimatedTotal();
                    this.promoListMessage = data.message || '';
                    this.eligiblePromotions = (data.items || []).map(p => ({
                        promotionId: p.promotionId,
                        promotionCode: p.promotionCode,
                        promotionName: p.promotionName,
                        description: p.description,
                        discountAmount: p.discountAmount,
                        totalAfter: p.totalAfter,
                        isRecommended: p.isRecommended,
                    }));
                    const recommended = this.eligiblePromotions.find(p => p.isRecommended)
                        || this.eligiblePromotions[0];
                    if (recommended) {
                        this.selectPromotion(recommended, false);
                    } else {
                        this.clearPromotion(false);
                    }
                } catch (e) {
                    this.promoListMessage = e.message || '';
                    this.promoSubtotalAmount = this.estimatedTotal();
                    this.clearPromotion(false);
                } finally {
                    this.promoLoading = false;
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                }
            },
            selectPromotion(p, scrollMsg = true) {
                this.selectedPromotionId = p.promotionId;
                this.selectedPromotionName = p.promotionName;
                this.promotionCode = (p.promotionCode || '').trim();
                this.promoDiscountAmount = p.discountAmount || 0;
                this.promoSubtotalAmount = this.promoSubtotalAmount || this.estimatedTotal();
                this.manualPromoCode = this.promotionCode;
                if (scrollMsg) {
                    this.promoPreviewApplied = true;
                    this.promoPreviewMessage = 'Đã chọn: ' + p.promotionName;
                }
            },
            clearPromotion(clearMsg = true) {
                this.selectedPromotionId = null;
                this.selectedPromotionName = '';
                this.promotionCode = '';
                this.promoDiscountAmount = 0;
                this.manualPromoCode = '';
                if (clearMsg) {
                    this.promoPreviewApplied = false;
                    this.promoPreviewMessage = '';
                }
            },
            async applyManualCode() {
                const code = (this.manualPromoCode || '').trim();
                if (!code) {
                    this.promoPreviewApplied = false;
                    this.promoPreviewMessage = 'Nhập mã khuyến mãi.';
                    return;
                }
                this.promoApplying = true;
                this.promoPreviewMessage = '';
                try {
                    const orderPayload = this.buildPayload();
                    delete orderPayload.promotionCode;
                    delete orderPayload.promotionId;
                    const res = await fetch('/OrganizationMealContractOrder/PreviewPromotion', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiToken,
                        },
                        body: JSON.stringify({ order: orderPayload, promotionCode: code }),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Mã không hợp lệ.');
                    if (!data.applied) {
                        this.promoPreviewApplied = false;
                        this.promoPreviewMessage = data.message || 'Mã không áp dụng được.';
                        return;
                    }
                    this.promotionCode = (data.promotionCode || code).trim();
                    this.selectedPromotionId = data.promotionId;
                    this.selectedPromotionName = data.promotionName || code;
                    this.promoDiscountAmount = data.discountAmount || 0;
                    this.promoSubtotalAmount = data.subtotal || this.estimatedTotal();
                    this.promoPreviewApplied = true;
                    this.promoPreviewMessage = 'Đã áp dụng: ' + (data.promotionName || code);
                } catch (e) {
                    this.promoPreviewApplied = false;
                    this.promoPreviewMessage = e.message || 'Mã không hợp lệ.';
                } finally {
                    this.promoApplying = false;
                }
            },
            buildPayload() {
                const def = Math.max(1, parseInt(this.mealsPerDay, 10) || 1);
                const dailyMealPortions = Object.entries(this.dailyMealOverrides)
                    .filter(([iso, count]) => this.isInRange(iso) && !this.excludedDates.includes(iso) && count !== def)
                    .map(([iso, count]) => ({ serviceDate: iso, mealCount: count }));
                const payload = {
                    organizationId: orgId,
                    startDate: this.periodStart,
                    endDate: this.periodEnd,
                    excludedDates: [...this.excludedDates],
                    mealsPerDay: def,
                    dailyMealPortions,
                    mealUnitPrice: parseFloat(this.mealUnitPrice) || 0,
                    delivery: {
                        recipientName: (this.delivery.recipientName || '').trim(),
                        recipientPhone: (this.delivery.recipientPhone || '').trim(),
                        recipientEmail: (this.delivery.recipientEmail || '').trim(),
                        deliveryAddress: (this.delivery.deliveryAddress || '').trim(),
                        deliveryWardDistrict: (this.delivery.deliveryWardDistrict || '').trim() || null,
                        deliveryNotes: (this.delivery.deliveryNotes || '').trim() || null,
                        preferredDeliveryTime: this.delivery.preferredDeliveryTime || null,
                    },
                };
                if (this.selectedPromotionId) {
                    payload.promotionId = this.selectedPromotionId;
                } else if (this.promotionCode) {
                    payload.promotionCode = this.promotionCode;
                }
                return payload;
            },
            async submitContract() {
                this.formError = this.validatePeriod() || this.validateDelivery();
                if (this.formError) return;
                this.submitting = true;
                try {
                    const res = await fetch('/OrganizationMealContractOrder/PrepareContract', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiToken,
                        },
                        body: JSON.stringify(this.buildPayload()),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Không tạo được nháp hợp đồng.');
                    window.location.href = data.redirectUrl;
                } catch (e) {
                    this.formError = e.message || 'Lỗi khi tạo nháp.';
                } finally {
                    this.submitting = false;
                }
            },
        }));
    });
</script>
}
