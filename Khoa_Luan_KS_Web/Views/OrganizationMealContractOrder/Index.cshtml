                                <button type="button" @@click="step = 3" class="rounded-xl border border-slate-200 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-50">Quay lại khuyến mãi</button>
                                <button type="button" @@click="submitContract()" :disabled="submitting"
                                        class="flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 py-3.5 text-sm font-black text-white shadow-lg hover:from-orange-600 hover:to-amber-600 disabled:opacity-50">
                                    <i data-lucide="file-check" class="h-4 w-4" x-show="!submitting"></i>
                                    <span x-text="submitting ? 'Đang xử lý…' : 'Tạo nháp hợp đồng'"></span>
                                </button>
