                    <aside class="lg:sticky lg:top-28 lg:self-start">
                        <div class="overflow-hidden rounded-3xl border border-orange-200 bg-white shadow-xl ring-1 ring-orange-500/10">
                            <div class="bg-gradient-to-br from-orange-500 to-amber-500 px-6 py-5 text-white">
                                <p class="text-[10px] font-black uppercase tracking-wider text-orange-100">Tổng hợp đồng</p>
                                <p class="mt-1 text-3xl font-black"><span x-text="formatMoney(promoTotalAfter())"></span> đ</p>
                                <p class="mt-1 text-xs text-orange-100/90" x-show="promoDiscount() > 0">
                                    Tạm tính <span x-text="formatMoney(promoSubtotal())"></span> đ · giảm <span x-text="formatMoney(promoDiscount())"></span> đ
                                </p>
