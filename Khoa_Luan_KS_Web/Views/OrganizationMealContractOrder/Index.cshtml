@model Khoa_Luan_KS_Web.Models.OrganizationMealContractOrderIndexVm
@using System.Text.Json
@using Khoa_Luan_KS_Web.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Đặt suất theo hợp đồng kỳ";
    Layout = "_LayoutCustomer";
    var periodStartDefault = Model.PeriodStartDefault.ToString("yyyy-MM-dd");
    var periodEndDefault = Model.PeriodEndDefault.ToString("yyyy-MM-dd");
    var periodStartMin = Model.PeriodStartMin.ToString("yyyy-MM-dd");
    var periodEndMax = Model.PeriodEndMax.ToString("yyyy-MM-dd");
    var dateRuleHint = Model.DateRuleHint;
    var antiToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? "";
    var antiTokenJson = JsonSerializer.Serialize(antiToken);
    var orgIdJson = Model.OrganizationId.ToString();
    var deliveryDefaultsJson = JsonSerializer.Serialize(Model.DeliveryDefaults ?? new OrganizationMealDeliveryDefaultsVm(), new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<style>
    [x-cloak] { display: none !important; }
    .org-period-page {
        background-color: #f1f5f9;
        background-image: radial-gradient(circle at 1px 1px, rgba(148, 163, 184, 0.22) 1px, transparent 0);
        background-size: 24px 24px;
    }
    .org-step-line { flex: 1; height: 2px; min-width: 2rem; max-width: 5rem; border-radius: 999px; }
    .cal-day-btn { min-height: 4.25rem; padding: 0.25rem 0.15rem; line-height: 1.1; }
    .cal-day-note { font-size: 0.55rem; font-weight: 600; line-height: 1.15; max-height: 2.3em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
</style>

<div class="org-period-page min-h-screen w-full font-sans text-slate-900" x-data="orgMealPeriodApp" x-cloak>

    <section class="relative h-[260px] overflow-hidden sm:h-[300px]">
        <img src="https://images.unsplash.com/photo-1555244162-803834f70033?q=80&w=1920&auto=format&fit=crop"
             alt="" class="absolute inset-0 h-full w-full object-cover brightness-[0.45]" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/55 to-slate-900/20"></div>
        <div class="relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-end px-4 pb-10 pt-24 sm:px-6">
            <nav class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-white/70">
                <a href="/Customer/Index" class="hover:text-orange-300">Trang chủ</a>
                <span class="text-white/30">/</span>
                <span class="text-white/90">Đặt suất theo hợp đồng</span>
            </nav>
            <span class="mb-3 inline-flex w-fit items-center gap-2 rounded-full border border-orange-400/40 bg-orange-500/20 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-orange-200">
                <i data-lucide="calendar-range" class="h-3 w-3"></i>
                Hợp đồng theo kỳ
            </span>
            <h1 class="max-w-3xl text-3xl font-black tracking-tight text-white sm:text-4xl">
                Đặt suất <span class="text-orange-400">theo tháng</span>
            </h1>
            <p class="mt-3 max-w-2xl text-sm text-slate-300 sm:text-base">
                Chọn kỳ hợp đồng, số suất/ngày và đơn giá. Món chính sẽ được chọn theo từng tuần sau khi ký HĐ.
            </p>
            @if (Model.OrganizationId > 0)
            {
                <div class="mt-4 inline-flex items-center gap-2 rounded-2xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur-md">
                    <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/90 text-white">
                        <i data-lucide="building-2" class="h-4 w-4"></i>
                    </span>
                    @Model.OrganizationName
                </div>
            }
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-10">
        @if (TempData["OrgPeriodError"] is string err && !string.IsNullOrEmpty(err))
        {
            <div class="mb-6 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 shadow-sm">
                <i data-lucide="alert-circle" class="mt-0.5 h-5 w-5 shrink-0"></i>
                <span>@err</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ApiError))
        {
            <div class="rounded-3xl border border-amber-200 bg-white p-10 text-center shadow-xl ring-1 ring-slate-900/5">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-100">
                    <i data-lucide="alert-triangle" class="h-7 w-7 text-amber-600"></i>
                </div>
                <p class="text-lg font-black text-amber-900">@Model.ApiError</p>
            </div>
        }
        else if (Model.OrganizationId > 0)
        {
            <div class="mb-8 overflow-hidden rounded-3xl border border-slate-200/80 bg-white px-4 py-5 shadow-sm ring-1 ring-slate-900/5 sm:px-8">
                <div class="flex items-center justify-center gap-0 sm:gap-1">
                    <template x-for="(s, idx) in stepMeta" :key="s.key">
                        <div class="flex items-center gap-0 sm:gap-1">
                            <div class="flex flex-col items-center gap-2 px-2 sm:px-4">
                                <span class="relative flex h-10 w-10 items-center justify-center rounded-2xl text-sm font-black transition-all duration-300 sm:h-11 sm:w-11"
                                      :class="step === idx + 1
                                        ? 'bg-gradient-to-br from-orange-500 to-amber-500 text-white shadow-lg shadow-orange-500/35 scale-105'
                                        : (step > idx + 1
                                            ? 'bg-emerald-500 text-white shadow-md shadow-emerald-500/25'
                                            : 'border-2 border-slate-200 bg-slate-50 text-slate-400')">
                                    <template x-if="step > idx + 1">
                                        <i data-lucide="check" class="h-5 w-5"></i>
                                    </template>
                                    <template x-if="step <= idx + 1">
                                        <span x-text="idx + 1"></span>
                                    </template>
                                </span>
                                <div class="text-center">
                                    <p class="text-xs font-black sm:text-sm"
                                       :class="step === idx + 1 ? 'text-orange-600' : (step > idx + 1 ? 'text-emerald-700' : 'text-slate-400')"
                                       x-text="s.label"></p>
                                    <p class="hidden text-[10px] text-slate-400 sm:block" x-text="s.hint"></p>
                                </div>
                            </div>
                            <div x-show="idx < 3" class="org-step-line mb-6 hidden sm:block"
                                 :class="step > idx + 1 ? 'bg-emerald-400' : 'bg-slate-200'"></div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Step 1: Period -->
            <div x-show="step === 1" x-transition>
                <div class="grid gap-8 lg:grid-cols-[1fr_320px]">
                    <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-orange-50/30 px-6 py-5 sm:px-8">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-600">Bước 1</p>
                            <h2 class="mt-1 text-xl font-black text-slate-900 sm:text-2xl">Kỳ hợp đồng &amp; đơn giá</h2>
                        </div>
                        <div class="space-y-8 p-6 sm:p-8">
                            <div class="grid gap-5 sm:grid-cols-2">
                                <div>
                                    <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Ngày bắt đầu *</label>
                                    <input type="date" x-model="periodStart" :min="periodStartMin" @@change="onPeriodStartChange()"
                                           class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                                </div>
                                <div>
                                    <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Ngày kết thúc *</label>
                                    <input type="date" x-model="periodEnd" :min="periodStart" :max="maxPeriodEnd()"
                                           class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                                </div>
                            </div>

                            <div class="grid gap-5 sm:grid-cols-2">
                                <div class="rounded-2xl border border-emerald-100 bg-emerald-50/50 p-5">
                                    <label class="block text-[11px] font-black uppercase tracking-wider text-emerald-800">Suất ăn / ngày *</label>
                                    <input type="number" x-model.number="mealsPerDay" min="1" step="1"
                                           class="mt-2 w-full rounded-xl border border-emerald-200 bg-white py-3 pl-4 text-2xl font-black text-slate-900 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                                </div>
                                <div class="rounded-2xl border border-orange-100 bg-orange-50/50 p-5">
                                    <label class="block text-[11px] font-black uppercase tracking-wider text-orange-800">Đơn giá / suất (VND) *</label>
                                    <input type="number" x-model.number="mealUnitPrice" min="1000" step="1000"
                                           class="mt-2 w-full rounded-xl border border-orange-200 bg-white py-3 pl-4 text-2xl font-black text-slate-900 focus:border-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-200" />
                                </div>
                            </div>

                            <div class="flex gap-3 rounded-2xl border border-blue-100 bg-blue-50/90 p-4">
                                <i data-lucide="info" class="mt-0.5 h-5 w-5 shrink-0 text-blue-600"></i>
                                <p class="text-xs leading-relaxed text-blue-900">@dateRuleHint</p>
                            </div>

                            <!-- Calendar -->
                            <div>
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-violet-100 text-violet-700">
                                            <i data-lucide="calendar-days" class="h-4 w-4"></i>
                                        </div>
                                        <div>
                                            <p class="text-[11px] font-black uppercase tracking-wider text-slate-500">Lịch kỳ hợp đồng</p>
                                            <p class="text-xs text-slate-400">Chọn ngày để đặt suất; Shift+click loại trừ ngày</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <button type="button" @@click="prevCalMonth()" class="rounded-lg border border-slate-200 p-2 hover:bg-slate-50">
                                            <i data-lucide="chevron-left" class="h-4 w-4"></i>
                                        </button>
                                        <span class="min-w-[8rem] text-center text-sm font-black text-slate-800" x-text="calMonthLabel()"></span>
                                        <button type="button" @@click="nextCalMonth()" class="rounded-lg border border-slate-200 p-2 hover:bg-slate-50">
                                            <i data-lucide="chevron-right" class="h-4 w-4"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4">
                                    <div class="mb-2 grid grid-cols-7 gap-1 text-center text-[10px] font-black uppercase text-slate-400">
                                        <span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span>
                                    </div>
                                    <div class="grid grid-cols-7 gap-1">
                                        <template x-for="(cell, i) in calendarCells()" :key="'c'+i">
                                            <button type="button"
                                                    @@click="cell.date && onCalendarDayClick(cell.date, $event)"
                                                    :disabled="!cell.inRange"
                                                    class="cal-day-btn flex flex-col items-center justify-start rounded-xl transition"
                                                    :class="!cell.date ? 'invisible' : (
                                                        !cell.inRange ? 'text-slate-300 cursor-default bg-transparent' :
                                                        (cell.excluded ? 'bg-red-100 text-red-900 ring-2 ring-red-300' :
                                                        (selectedDay === cell.date ? 'bg-orange-100 text-orange-900 ring-2 ring-orange-400' :
                                                        (cell.isWeekend ? 'bg-rose-50/80 text-slate-800 hover:bg-orange-50 hover:ring-2 hover:ring-orange-200' :
                                                        'bg-white text-slate-800 hover:bg-orange-50 hover:ring-2 hover:ring-orange-200'))))"
                                            >
                                                <span class="text-sm font-black" x-text="cell.dayNum || ''"></span>
                                                <span x-show="cell.inRange && cell.note" class="cal-day-note mt-0.5 w-full text-center"
                                                      :class="cell.isHoliday ? 'text-violet-700' : 'text-slate-400'"
                                                      x-text="cell.note"></span>
                                                <span x-show="cell.inRange && !cell.excluded" class="mt-0.5 text-[10px] font-bold"
                                                      :class="cell.customMeals ? 'text-emerald-700' : 'text-slate-400'"
                                                      x-text="cell.mealsLabel"></span>
                                            </button>
                                        </template>
                                    </div>
                                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                                        <p class="text-xs text-slate-600 sm:col-span-2">
                                            Đã loại trừ <strong x-text="excludedDates.length"></strong> ngày
                                            · <strong x-text="customMealDayCount()"></strong> ngày tùy chỉnh suất
                                            · Tổng <strong x-text="totalMealsCount()"></strong> suất
                                        </p>
                                        <div x-show="selectedDay" class="rounded-2xl border border-orange-200 bg-orange-50/60 p-4 sm:col-span-2">
                                            <div class="flex flex-wrap items-start justify-between gap-3">
                                                <div>
                                                    <p class="text-[10px] font-black uppercase tracking-wider text-orange-700">Ngày đang chọn</p>
                                                    <p class="mt-1 text-lg font-black text-slate-900" x-text="formatDate(selectedDay)"></p>
                                                    <p class="mt-1 text-xs font-semibold text-violet-800" x-show="selectedDayNote()" x-text="selectedDayNote()"></p>
                                                </div>
                                                <button type="button" @@click="selectedDay = null"
                                                        class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-xs font-bold text-slate-500 hover:bg-slate-50">Đóng</button>
                                            </div>
                                            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                                                <div>
                                                    <label class="mb-1 block text-[10px] font-black uppercase text-slate-500">Suất ăn ngày này</label>
                                                    <input type="number" min="1" step="1" x-model.number="selectedDayMeals"
                                                           :disabled="isDayExcluded(selectedDay)"
                                                           class="h-10 w-full rounded-xl border border-orange-200 bg-white px-3 text-lg font-black disabled:bg-slate-100" />
                                                    <p class="mt-1 text-[11px] text-slate-500">Để trống hoặc bấm «Mặc định» = <span x-text="mealsPerDay"></span> suất/ngày</p>
                                                </div>
                                                <div class="flex flex-col gap-2 sm:justify-end">
                                                    <button type="button" @@click="applySelectedDayMeals()"
                                                            :disabled="isDayExcluded(selectedDay)"
                                                            class="rounded-xl bg-emerald-600 py-2.5 text-sm font-black text-white hover:bg-emerald-700 disabled:opacity-50">
                                                        Lưu số suất
                                                    </button>
                                                    <button type="button" @@click="clearSelectedDayMeals()"
                                                            class="rounded-xl border border-slate-200 bg-white py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50">
                                                        Dùng mặc định (<span x-text="mealsPerDay"></span>)
                                                    </button>
                                                    <button type="button" @@click="toggleExcluded(selectedDay)"
                                                            class="rounded-xl border py-2.5 text-sm font-bold"
                                                            :class="isDayExcluded(selectedDay) ? 'border-emerald-300 bg-emerald-50 text-emerald-800' : 'border-red-200 bg-red-50 text-red-800'">
                                                        <span x-text="isDayExcluded(selectedDay) ? 'Bỏ loại trừ' : 'Loại trừ ngày này'"></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div x-show="!selectedDay" class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/80 p-4 text-xs text-slate-500 sm:col-span-2">
                                            Bấm một ngày trong kỳ để chỉnh số suất hoặc loại trừ. Ngày lễ / cuối tuần hiển thị gợi ý trên ô lịch.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div x-show="formError" class="flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                                <i data-lucide="circle-alert" class="h-4 w-4 shrink-0"></i><span x-text="formError"></span>
                            </div>
                            <button type="button" @@click="goStep2()"
                                    class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 py-4 text-sm font-black text-white shadow-xl shadow-orange-500/30 hover:from-orange-600 hover:to-amber-600">
                                Tiếp tục — giao hàng
                                <i data-lucide="arrow-right" class="h-5 w-5 transition group-hover:translate-x-0.5"></i>
                            </button>
                        </div>
                    </div>
                    <aside class="lg:sticky lg:top-28 lg:self-start">
                        <div class="overflow-hidden rounded-3xl border border-orange-200/80 bg-white shadow-xl ring-1 ring-orange-500/10">
                            <div class="bg-gradient-to-br from-orange-500 to-amber-500 px-6 py-5 text-white">
                                <p class="text-[10px] font-black uppercase tracking-wider text-orange-100">Tổng dự kiến</p>
                                <p class="mt-1 text-3xl font-black"><span x-text="formatMoney(estimatedTotal())"></span><span class="text-lg opacity-80"> đ</span></p>
                            </div>
                            <div class="space-y-3 p-6 text-sm">
                                <div class="flex justify-between"><span class="text-slate-500">Ngày phục vụ</span><span class="font-black" x-text="serviceDaysCount()"></span></div>
                                <div class="flex justify-between"><span class="text-slate-500">Tổng suất</span><span class="font-bold" x-text="totalMealsCount()"></span></div>
                                <div class="flex justify-between"><span class="text-slate-500">Đơn giá</span><span class="font-bold"><span x-text="formatMoney(mealUnitPrice)"></span> đ</span></div>
                                <p class="border-t border-slate-100 pt-3 text-xs text-slate-500">Tổng = tổng suất từng ngày phục vụ × đơn giá (mặc định <span x-text="mealsPerDay"></span> suất/ngày)</p>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>

            <!-- Step 2: Delivery -->
            <div x-show="step === 2" x-transition>
                <div class="grid gap-8 lg:grid-cols-[1fr_340px]">
                    <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl ring-1 ring-slate-900/5">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-emerald-50 via-white to-orange-50/40 px-6 py-5 sm:px-8">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-600">Bước 2</p>
                            <h2 class="mt-1 text-xl font-black text-slate-900 sm:text-2xl">Địa điểm giao &amp; người nhận</h2>
                            <p class="mt-1 text-sm text-slate-500">Email xác nhận và PDF hợp đồng sẽ gửi tới email bên dưới.</p>
                        </div>
                        <div class="grid gap-5 p-6 sm:grid-cols-2 sm:p-8">
                            <div x-show="deliveryPrefilled" class="sm:col-span-2 flex flex-col gap-3 rounded-2xl border border-emerald-200/80 bg-emerald-50/70 px-4 py-3.5 sm:flex-row sm:items-center sm:justify-between">
                                <div class="flex items-start gap-3 min-w-0">
                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
                                        <i data-lucide="user-check" class="h-4 w-4"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-bold text-emerald-900">Thông tin đã điền sẵn</p>
                                        <p class="mt-0.5 text-xs leading-relaxed text-emerald-800/90" x-text="deliveryDefaultsHint"></p>
                                    </div>
                                </div>
                                <button type="button" @@click="applyDeliveryDefaults(deliveryDefaults, true)"
                                        class="shrink-0 rounded-xl border border-emerald-300 bg-white px-3.5 py-2 text-xs font-bold text-emerald-800 hover:bg-emerald-50">
                                    Khôi phục mặc định
                                </button>
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Họ tên người nhận *</label>
                                <input type="text" x-model.trim="delivery.recipientName" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Số điện thoại *</label>
                                <input type="tel" x-model.trim="delivery.recipientPhone" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Email nhận thông báo *</label>
                                <input type="email" x-model.trim="delivery.recipientEmail" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Địa chỉ giao hàng *</label>
                                <input type="text" x-model.trim="delivery.deliveryAddress" required
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">Phường / quận / thành phố</label>
                                <input type="text" x-model.trim="delivery.deliveryWardDistrict"
                                       class="h-11 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
                            </div>
                            <div>
