@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HuitMeal</title>
    <link rel="icon" type="image/png" href="/assets/images/Logo_tròn.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .input-field {
            display: block; width: 100%; padding: 12px 12px 12px 42px;
            border: 1.5px solid #e5e7eb; border-radius: 12px;
            font-size: 14px; background: #fafafa;
            transition: all 0.2s ease; outline: none;
        }
        .input-field:focus { background: #fff; border-color: #f97316; box-shadow: 0 0 0 3px rgba(249,115,22,0.12); }
        .input-field::placeholder { color: #9ca3af; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 antialiased">

<div class="min-h-screen flex">

    <!-- ===== LEFT: Visual Panel ===== -->
    <div class="hidden lg:flex lg:w-[45%] relative overflow-hidden">
        <img src="https://images.unsplash.com/photo-1547592180-85f173990554?q=80&w=1920" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-br from-gray-900/90 via-gray-900/60 to-gray-900/30"></div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-between h-full p-14">
            <!-- Logo top -->
            <a href="/Customer" class="flex items-center gap-3">
                <img src="/assets/images/Logo.jpg" class="h-10 w-auto object-contain rounded-lg" />
                <span class="text-white font-black text-lg tracking-tight">HuitMeal</span>
            </a>

            <!-- Hero text -->
            <div class="max-w-md">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/20 border border-orange-400/30 text-orange-300 text-[10px] font-bold uppercase tracking-[0.25em] mb-6">
                    <i data-lucide="user-plus" class="w-3 h-3"></i>
                    Gia nhập cộng đồng
                </span>
                <h2 class="text-4xl font-black text-white leading-tight tracking-tight mb-4">
                    Bắt đầu hành trình <br/><span class="text-orange-400">ăn sạch & sống khỏe</span>
                </h2>
                <p class="text-gray-300 text-lg leading-relaxed font-medium">Đăng ký ngay để nhận ưu đãi cho đơn hàng đầu tiên và quản lý thực đơn cá nhân hóa.</p>
            </div>

            <!-- Features -->
            <div class="space-y-6">
                @foreach(var (icon, text) in new[]{("zap", "Đặt hàng siêu tốc trong 30s"), ("gift", "Tích điểm đổi quà hấp dẫn"), ("bell", "Thông báo thực đơn mới mỗi ngày")})
                {
                    <div class="flex items-center gap-4 text-white">
                        <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center">
                            <i data-lucide="@icon" class="w-5 h-5 text-orange-400"></i>
                        </div>
                        <span class="font-bold">@text</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ===== RIGHT: Form Panel ===== -->
    <div class="flex-1 flex items-center justify-center p-6 sm:p-10 bg-white lg:bg-gray-50">
        <div class="w-full max-w-[480px] py-10">

            <!-- Mobile logo -->
            <div class="lg:hidden flex items-center gap-3 mb-8">
                <img src="/assets/images/Logo.jpg" class="h-9 w-auto object-contain rounded-lg" />
                <span class="font-black text-lg text-gray-900 tracking-tight">HuitMeal</span>
            </div>

            <!-- Title -->
            <div class="mb-8">
                <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-2">Tạo tài khoản</h1>
                <p class="text-gray-500 text-sm font-medium leading-relaxed">Vui lòng điền các thông tin dưới đây để đăng ký thành viên HuitMeal.</p>
            </div>

            <!-- Form -->
            <form action="/Auth/Register" method="post" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                
                <!-- Full Name -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Họ và tên</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="user" class="w-4.5 h-4.5 text-gray-400"></i>
                        </div>
                        <input type="text" name="FullName" required class="input-field" placeholder="Nguyễn Văn A" />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="mail" class="w-4.5 h-4.5 text-gray-400"></i>
                        </div>
                        <input type="email" name="Email" required class="input-field" placeholder="example@gmail.com" />
                    </div>
                </div>

                <!-- Phone -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Số điện thoại</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="phone" class="w-4.5 h-4.5 text-gray-400"></i>
                        </div>
                        <input type="tel" name="Phone" required class="input-field" placeholder="09xx xxx xxx" />
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Mật khẩu</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="lock" class="w-4.5 h-4.5 text-gray-400"></i>
                        </div>
                        <input type="password" name="Password" required class="input-field" placeholder="••••••••" />
                    </div>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Xác nhận mật khẩu</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="shield-check" class="w-4.5 h-4.5 text-gray-400"></i>
                        </div>
                        <input type="password" name="ConfirmPassword" required class="input-field" placeholder="••••••••" />
                    </div>
                </div>

                <!-- Terms -->
                <div class="md:col-span-2 py-2">
                    <label class="flex items-start gap-3 cursor-pointer select-none">
                        <input type="checkbox" required class="w-4 h-4 mt-1 rounded border-gray-300 accent-orange-500">
                        <span class="text-sm font-medium text-gray-600 leading-snug">
                            Tôi đồng ý với các <a href="#" class="text-orange-600 font-bold hover:underline">Điều khoản dịch vụ</a> và <a href="#" class="text-orange-600 font-bold hover:underline">Chính sách bảo mật</a> của HuitMeal.
                        </span>
                    </label>
                </div>

                <!-- Submit -->
                <div class="md:col-span-2 pt-2">
                    <button type="submit"
                            class="w-full py-3.5 rounded-xl font-black text-white text-sm tracking-wide bg-orange-500 hover:bg-orange-400 shadow-lg shadow-orange-500/25 transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                        <i data-lucide="user-plus" class="w-4 h-4"></i>
                        ĐĂNG KÝ NGAY
                    </button>
                </div>
            </form>

            <!-- Footer links -->
            <div class="mt-8 pt-6 border-t border-gray-100 text-center">
                <p class="text-sm text-gray-600 font-medium">
                    Đã có tài khoản?
                    <a href="/Auth/Login" class="font-black text-orange-600 hover:text-orange-700 ml-1">Đăng nhập ngay</a>
                </p>
                <div class="mt-6">
                    <a href="/Customer" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 font-semibold transition-all hover:gap-3">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i> Quay lại trang chủ
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<script>lucide.createIcons();</script>
</body>
</html>
