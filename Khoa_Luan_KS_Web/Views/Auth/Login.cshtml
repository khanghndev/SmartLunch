@{
    ViewData["Title"] = "Đăng Nhập";
    Layout = null;

    var role = Context.Request.Query["role"].ToString().ToUpper();
    if (string.IsNullOrEmpty(role)) role = "CUSTOMER";
    var returnUrl = Context.Request.Query["returnUrl"].ToString();

    var roleLabels = new Dictionary<string, string> {
        {"CUSTOMER", "Khách hàng"}, {"ADMIN", "Quản trị viên"}, {"MANAGER", "Quản lý"}, {"WAREHOUSESTAFF", "Nhân viên Kho"}
    };

    // Per-role config as value tuples
    var configs = new Dictionary<string, (string Title, string Subtitle, string BgImage, string Hero, string HeroSub, string Ring, string Btn, string Accent)> {
        ["CUSTOMER"] = (
            "Đăng nhập Khách hàng",
            "Đặt suất ăn nhanh chóng và theo dõi đơn hàng dễ dàng.",
            "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?q=80&w=1920",
            "Trải nghiệm đặt suất ăn chuẩn doanh nghiệp",
            "Hàng trăm doanh nghiệp tin tưởng HuitMeal mỗi ngày.",
            "focus:ring-orange-400 focus:border-orange-400",
            "bg-orange-500 hover:bg-orange-400",
            "text-orange-600 hover:text-orange-700"),
        ["ADMIN"] = (
            "Đăng nhập Quản trị",
            "Kiểm soát hệ thống, phân quyền và vận hành dữ liệu.",
            "https://images.unsplash.com/photo-1587293852726-694b6302ca2f?q=80&w=1920",
            "Bảng điều khiển quản trị",
            "Quản lý toàn diện hệ thống HuitMeal.",
            "focus:ring-slate-500 focus:border-slate-500",
            "bg-slate-900 hover:bg-slate-800",
            "text-slate-700 hover:text-slate-900"),
        ["MANAGER"] = (
            "Đăng nhập Quản lý",
            "Điều phối vận hành, theo dõi KPI và báo cáo tổng hợp.",
            "https://images.unsplash.com/photo-1578474846511-04ba529f0b88?q=80&w=1920",
            "Trung tâm điều hành vận hành",
            "Theo dõi hiệu quả vận hành theo thời gian thực.",
            "focus:ring-indigo-500 focus:border-indigo-500",
            "bg-indigo-600 hover:bg-indigo-700",
            "text-indigo-700 hover:text-indigo-900"),
        ["WAREHOUSESTAFF"] = (
            "Đăng nhập Nhân viên Kho",
            "Quản lý tồn kho, tạo phiếu đề xuất và xác nhận nhập xuất nguyên vật liệu.",
            "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=1920",
            "Hệ thống Quản lý Kho Bãi",
            "Theo dõi và kiểm soát nguyên vật liệu theo thời gian thực.",
            "focus:ring-amber-500 focus:border-amber-500",
            "bg-amber-500 hover:bg-amber-600",
            "text-amber-600 hover:text-amber-700"),
    };

    if (!configs.ContainsKey(role)) role = "CUSTOMER";
    var cfg = configs[role];
    bool isCustomer = role == "CUSTOMER";
    bool isWarehouseStaff = role == "WAREHOUSESTAFF";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@cfg.Title - HuitMeal</title>
    <link rel="icon" type="image/png" href="/assets/images/Logo_tròn.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .input-field {
            display: block; width: 100%; padding: 12px 12px 12px 42px;
            border: 1.5px solid #e5e7eb; border-radius: 12px;
            font-size: 14px; background: #fafafa;
            transition: all 0.2s ease; outline: none;
        }
        .input-field:focus { background: #fff; border-color: #f97316; box-shadow: 0 0 0 3px rgba(249,115,22,0.12); }
        .input-field::placeholder { color: #9ca3af; }
        @if (!isCustomer) {
            @:.input-field:focus { border-color: #64748b; box-shadow: 0 0 0 3px rgba(100,116,139,0.12); }
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 antialiased">

<div class="min-h-screen flex">

    <!-- ===== LEFT: Visual Panel ===== -->
    <div class="hidden lg:flex lg:w-[55%] relative overflow-hidden">
        <img src="@cfg.BgImage" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-br from-gray-900/90 via-gray-900/60 to-gray-900/30"></div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-between h-full p-14">
            <!-- Logo top -->
            <a href="/Customer" class="flex items-center gap-3">
                <img src="/assets/images/Logo.jpg" class="h-10 w-auto object-contain rounded-lg" />
                <span class="text-white font-black text-lg tracking-tight">HuitMeal</span>
            </a>

            <!-- Hero text -->
            <div class="max-w-lg">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-white text-[10px] font-bold uppercase tracking-[0.25em] mb-6">
                    <i data-lucide="@(isCustomer ? "utensils" : "shield")" class="w-3 h-3"></i>
                    @roleLabels[role]
                </span>
                <h2 class="text-4xl md:text-5xl font-black text-white leading-tight tracking-tight mb-4">
                    @cfg.Hero
                </h2>
                <p class="text-gray-300 text-lg leading-relaxed font-medium">@cfg.HeroSub</p>
            </div>

            <!-- Trust indicators (Customer only) -->
            @if (isCustomer)
            {
                <div class="grid grid-cols-3 gap-4">
                    @foreach(var (n,l) in new[]{("500+","Doanh nghiệp"),("150k","Suất ăn/ngày"),("4.9★","Đánh giá")})
                    {
                        <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-4 text-center">
                            <p class="text-xl font-black text-orange-400">@n</p>
                            <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-widest">@l</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500 text-xs">© @DateTime.Now.Year HuitMeal. All rights reserved.</p>
            }
        </div>
    </div>

    <!-- ===== RIGHT: Form Panel ===== -->
    <div class="flex-1 flex items-center justify-center p-6 sm:p-10 bg-white lg:bg-gray-50">
        <div class="w-full max-w-[420px]">

            <!-- Mobile logo -->
            <div class="lg:hidden flex items-center gap-3 mb-8">
                <img src="/assets/images/Logo.jpg" class="h-9 w-auto object-contain rounded-lg" />
                <span class="font-black text-lg text-gray-900 tracking-tight">HuitMeal</span>
            </div>

            <!-- Title -->
            <div class="mb-8">
                <span class="text-[10px] font-black text-orange-500 uppercase tracking-[0.3em] mb-1 block">@roleLabels[role]</span>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-2">@cfg.Title</h1>
                <p class="text-gray-500 text-sm font-medium leading-relaxed">@cfg.Subtitle</p>
            </div>

            <!-- Error -->
            @if (TempData["Error"] != null)
            {
                <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm font-semibold">
                    <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
                    @TempData["Error"]
                </div>
            }
            
            <!-- Success -->
            @if (TempData["Success"] != null)
            {
                <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-6 text-sm font-semibold">
                    <i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0"></i>
                    @TempData["Success"]
                </div>
            }

            <!-- Form -->
            <form action="/Auth/Login" method="post" class="space-y-5">
                <input type="hidden" name="role" value="@role" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <!-- Email -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Email / Số điện thoại</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="mail" class="w-4.5 h-4.5 text-gray-400"></i>
                        </div>
                        <input type="text" name="email" required
                               value="@(role == "ADMIN" ? "admin@smartlunch.com" : (role == "MANAGER" ? "manager@smartlunch.com" : (role == "WAREHOUSESTAFF" ? "warehouse@smartlunch.com" : "contact@xyzschool.edu.vn")))"
                               class="input-field" placeholder="Nhập email hoặc số điện thoại..." />
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Mật khẩu</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="lock" class="w-4.5 h-4.5 text-gray-400"></i>
                        </div>
                        <input type="password" name="password" required
                               class="input-field pr-10" placeholder="Nhập mật khẩu..." />
                        <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 transition"
                                onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password'">
                            <i data-lucide="eye" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember + Forgot -->
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <input id="remember" type="checkbox" class="w-4 h-4 rounded border-gray-300 accent-orange-500">
                        <span class="text-sm font-medium text-gray-600">Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="#" class="text-sm font-bold @cfg.Accent">Quên mật khẩu?</a>
                </div>

                <!-- Submit -->
                <button type="submit"
                        class="w-full py-3.5 rounded-xl font-black text-white text-sm tracking-wide @cfg.Btn shadow-lg transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    ĐĂNG NHẬP
                </button>
            </form>

            <!-- Footer links -->
            <div class="mt-8 pt-6 border-t border-gray-100 space-y-4 text-center">
                @if (isCustomer)
                {
                    <p class="text-sm text-gray-600 font-medium">
                        Chưa có tài khoản?
                        <a href="/Auth/Register" class="font-black @cfg.Accent ml-1">Đăng ký ngay</a>
                    </p>
                }
                <a href="/Customer" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 font-semibold transition-all hover:gap-3">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> Quay lại trang chủ
                </a>
            </div>

        </div>
    </div>
</div>

<script>lucide.createIcons();</script>
</body>
</html>
