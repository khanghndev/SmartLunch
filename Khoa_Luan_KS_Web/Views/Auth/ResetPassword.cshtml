@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
    var token = ViewBag.Token as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - HuitMeal</title>
    <link rel="icon" type="image/png" href="/assets/images/Logo_tròn.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .input-field {
            display: block; width: 100%; padding: 12px 12px 12px 42px;
            border: 1.5px solid #e5e7eb; border-radius: 12px;
            font-size: 14px; background: #fafafa;
            transition: all 0.2s ease; outline: none;
        }
        .input-field:focus { background: #fff; border-color: #f97316; box-shadow: 0 0 0 3px rgba(249,115,22,0.12); }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 antialiased min-h-screen flex items-center justify-center p-6">

<div class="w-full max-w-[420px] bg-white rounded-2xl shadow-xl border border-gray-100 p-8 sm:p-10">
    <div class="flex items-center gap-3 mb-8">
        <img src="/assets/images/Logo.jpg" class="h-9 w-auto object-contain rounded-lg" alt="HuitMeal" />
        <span class="font-black text-lg text-gray-900 tracking-tight">HuitMeal</span>
    </div>

    <div class="mb-8">
        <span class="text-[10px] font-black text-orange-500 uppercase tracking-[0.3em] mb-1 block">Bảo mật</span>
        <h1 class="text-2xl font-black text-gray-900 tracking-tight mb-2">Đặt lại mật khẩu</h1>
        <p class="text-gray-500 text-sm font-medium leading-relaxed">
            Nhập mật khẩu mới (tối thiểu 8 ký tự).
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm font-semibold">
            <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
            @TempData["Error"]
        </div>
    }

    <form action="/Auth/ResetPassword" method="post" class="space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@token" />

        <div>
            <label class="block text-sm font-bold text-gray-700 mb-1.5">Mật khẩu mới</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="lock" class="w-4.5 h-4.5 text-gray-400"></i>
                </div>
                <input type="password" name="newPassword" required minlength="8" class="input-field" placeholder="Nhập mật khẩu mới..." />
            </div>
        </div>

        <div>
            <label class="block text-sm font-bold text-gray-700 mb-1.5">Xác nhận mật khẩu</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="lock-keyhole" class="w-4.5 h-4.5 text-gray-400"></i>
                </div>
                <input type="password" name="confirmPassword" required minlength="8" class="input-field" placeholder="Nhập lại mật khẩu..." />
            </div>
        </div>

        <button type="submit"
                class="w-full py-3.5 rounded-xl font-black text-white text-sm tracking-wide bg-orange-500 hover:bg-orange-400 shadow-lg transition-all active:scale-[0.98] flex items-center justify-center gap-2">
            <i data-lucide="check" class="w-4 h-4"></i>
            CẬP NHẬT MẬT KHẨU
        </button>
    </form>

    <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <a href="/Auth/Login?role=Customer" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 font-semibold transition-all hover:gap-3">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Quay lại đăng nhập
        </a>
    </div>
</div>

<script>lucide.createIcons();</script>
</body>
</html>
