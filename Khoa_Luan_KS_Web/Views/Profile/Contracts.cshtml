@using System.Globalization
@using System.Text.Json
@using System.Text.Encodings.Web
@model Khoa_Luan_KS_Web.Models.CustomerContractsPageVm
@{
    ViewData["Title"] = "Cổng ký số HuitMeal";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var contractsJson = JsonSerializer.Serialize(
        Model.Contracts,
        new JsonSerializerOptions(JsonSerializerDefaults.Web) { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    var orderAnnexRaw = string.IsNullOrEmpty(Model.PendingOrderAnnexJson) ? "null" : Model.PendingOrderAnnexJson;
}
<style>
    [x-cloak] { display: none !important; }
    .esign-paper { font-family: 'Times New Roman', Times, serif; }
    .esign-full { position: fixed; inset: 0; z-index: 60; background: #e2e8f0; overflow-y: auto; }
    .annex-pdf-frame {
        min-height: calc(100vh - 10.5rem);
        height: calc(100vh - 10.5rem);
        background: #525659;
    }
    .annex-pdf-frame iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        background: #fff;
    }
</style>

<script>window.__HM_CONTRACTS = @Html.Raw(contractsJson);</script>
<script>window.__HM_ORDER_ANNEX = @Html.Raw(orderAnnexRaw);</script>
<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6" x-data="esignPortal()" x-init="init()">
    <nav class="mb-6 flex text-sm text-slate-500">
        <a href="/Customer/Index" class="hover:text-orange-600">Trang chủ</a>
        <span class="mx-2">/</span>
        <span class="font-medium text-slate-800">Hợp đồng điện tử</span>
    </nav>

    <h1 class="mb-2 text-2xl font-black text-slate-900">Cổng ký số HuitMeal</h1>
    <p class="mb-6 text-sm text-slate-600">Rà soát phụ lục đặt hàng (menu, tổng tiền) và/hoặc hợp đồng khung. Ký mô phỏng trên canvas; hệ thống tạo PDF và lưu trên cloud giống quy trình thật.</p>

    @if (TempData["ContractSuccess"] is string ok && !string.IsNullOrEmpty(ok))
    {
        <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900">@ok</div>
    }
    @if (TempData["ContractError"] is string bad && !string.IsNullOrEmpty(bad))
    {
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@bad</div>
    }
    @if (!string.IsNullOrEmpty(Model.PostCheckoutBanner))
    {
        <div class="mb-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-950">
            <p class="font-medium">@Model.PostCheckoutBanner</p>
            <p class="mt-1 text-sky-900">Ký phụ lục bên dưới (hoặc cổng tự mở). Sau khi ký, trạng thái chuyển <strong>đang chờ thanh toán</strong> — thanh toán đặt cọc tại <a href="@Url.Action("Orders", "Profile")" class="font-semibold underline">lịch sử đơn hàng</a>.</p>
            @if (Model.PostCheckoutOrderId is int ocId)
            {
                <p class="mt-2"><a href="@Url.Action("OrderDetail", "Profile", new { id = ocId })" class="font-semibold text-orange-700 underline hover:text-orange-800">Xem chi tiết đơn vừa tạo</a></p>
            }
        </div>
    }

    <template x-if="orderAnnex && !annexOpen">
        <div class="mb-6 rounded-2xl border border-orange-200 bg-orange-50/80 p-5 shadow-sm">
            <p class="text-sm font-bold text-orange-950">Phụ lục đặt hàng đang chờ ký</p>
            <p class="mt-1 text-xs text-orange-900/90">Đơn <span class="font-mono" x-text="orderAnnex.invoiceCode || ('#' + orderAnnex.id)"></span> — tổng <span class="font-bold" x-text="money(orderAnnex.totalAmount)"></span></p>
            <button type="button" @@click="openAnnexFlow()" class="mt-3 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-black text-white hover:bg-orange-600">Mở cổng ký phụ lục</button>
        </div>
    </template>

    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-950">@Model.InfoMessage</div>
    }
    else if (!string.IsNullOrEmpty(Model.ApiError))
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900">Không tải được danh sách: <strong>@Model.ApiError</strong></div>
    }
    else if (Model.Contracts.Count == 0)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center text-slate-600 shadow-sm">
            Chưa có hợp đồng khung nào gắn đơn vị của bạn. Bạn vẫn có thể ký phụ lục theo từng đơn đặt hàng (nút phía trên). Liên hệ quản trị HuitMeal để được cấp hợp đồng khung nếu cần.
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var c in Model.Contracts)
            {
                <div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-wider text-orange-600">Hợp đồng #@c.Id</p>
                        <p class="text-lg font-black text-slate-900">@(c.ContractNumber ?? "Khung cung cấp suất")</p>
                        <p class="mt-1 text-xs text-slate-500">@c.OrganizationName · @c.StartDate.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))@(c.EndDate.HasValue ? " – " + c.EndDate.Value.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN")) : "")</p>
                        @if (c.TotalValue.HasValue)
                        {
                            <p class="mt-1 text-sm font-bold text-emerald-700">Giá trị tham chiếu: @c.TotalValue.Value.ToString("N0") đ</p>
                        }
                    </div>
                    <div class="flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(c.ContractFileUrl))
                        {
                            <a href="@c.ContractFileUrl" target="_blank" rel="noopener" class="rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50">Xem / tải PDF</a>
                        }
                        @if (!c.IsDigitallySigned)
                        {
                            <button type="button" @@click="openFlow(@c.Id)" class="rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-black text-white shadow hover:bg-orange-600">Ký xác nhận</button>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-xl bg-emerald-50 px-4 py-2.5 text-xs font-black text-emerald-800">Đã ký @(c.DigitallySignedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Full-screen: hợp đồng khung -->
    <div x-show="open" x-cloak class="esign-full flex flex-col" style="display:none;">
        <header class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white px-4 py-4 sm:px-8">
            <div class="flex items-center gap-3">
                <button type="button" @@click="closeFlow()" class="rounded-xl border border-slate-200 p-2 text-slate-500 hover:bg-orange-50 hover:text-orange-600">
                    <i data-lucide="arrow-left" class="h-5 w-5"></i>
                </button>
                <div>
                    <p class="text-sm font-black text-slate-900">Cổng ký số HuitMeal</p>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400" x-text="step === 1 ? 'Bước 1: Rà soát nội dung' : 'Bước 2: Ký tên'"></p>
                </div>
            </div>
            <div class="hidden items-center gap-2 sm:flex">
                <span class="rounded-lg px-2 py-1 text-[10px] font-black" :class="step >= 1 ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-400'">1 XEM</span>
                <span class="text-slate-300">—</span>
                <span class="rounded-lg px-2 py-1 text-[10px] font-black" :class="step >= 2 ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-400'">2 KÝ</span>
                <span class="text-slate-300">—</span>
                <span class="rounded-lg px-2 py-1 text-[10px] font-black text-slate-300">3 XONG</span>
            </div>
            <button type="button" @@click="closeFlow()" class="text-xs font-bold text-slate-500 hover:text-orange-600">Thoát</button>
        </header>

        <div class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
            <div x-show="step === 1" class="esign-paper rounded-sm border border-slate-200 bg-white p-8 shadow-lg sm:p-12">
                <h2 class="mb-6 text-center text-lg font-black uppercase tracking-wide text-slate-900">Phụ lục / Hợp đồng cung cấp suất ăn</h2>
                <div class="space-y-4 text-sm leading-relaxed text-slate-800">
                    <p><strong>Bên A (HuitMeal):</strong> <span x-text="active?.partnerLegalName || 'Công ty Cổ phần HuitMeal'"></span></p>
                    <p><strong>Bên B (Khách hàng):</strong> <span x-text="active?.organizationName || 'Đơn vị khách hàng'"></span></p>
                    <p class="border-t border-slate-200 pt-4"><strong>Điều 1.</strong> Nội dung cung cấp suất ăn theo lịch đã thống nhất; điều chỉnh bổ sung (nếu có) được phản ánh trong mô tả hợp đồng và hệ thống đặt hàng.</p>
                    <p><strong>Điều 2.</strong> Thời hiệu: từ <span x-text="fmt(active?.startDate)"></span> <template x-if="active?.endDate"><span>đến <span x-text="fmt(active.endDate)"></span></span></template>.</p>
                    <p><strong>Điều 3.</strong> Giá và thanh toán: theo khung giá trị <span x-text="money(active?.totalValue)"></span> (tham chiếu); chi tiết từng kỳ thanh toán tuân theo biên bản đối soát.</p>
                    <p class="text-xs italic text-slate-500">Văn bản điện tử có giá trị pháp lý tương đương bản giấy sau khi các bên ký số theo quy định nội bộ và pháp luật hiện hành.</p>
                </div>
                <div class="mt-10 grid gap-6 border-t border-slate-200 pt-8 sm:grid-cols-2">
                    <div class="text-center">
                        <p class="mb-3 text-xs font-black uppercase text-slate-600">Đại diện HuitMeal</p>
                        <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full border-4 border-red-500 text-[9px] font-black uppercase leading-tight text-red-600">Approved<br/>HuitMeal</div>
                        <p class="mt-2 text-[10px] text-slate-500">Đã xác thực hệ thống</p>
                    </div>
                    <div class="text-center">
                        <p class="mb-3 text-xs font-black uppercase text-slate-600">Đại diện khách hàng</p>
                        <div class="mx-auto flex h-28 max-w-xs items-center justify-center rounded-lg border-2 border-dashed border-slate-300 text-sm font-bold text-slate-400">CHỜ BẠN KÝ</div>
                    </div>
                </div>
            </div>

            <div x-show="step === 2" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
                <p class="mb-4 text-sm font-bold text-slate-800">Ký bằng chuột hoặc cảm ứng (PNG)</p>
                <canvas id="contract-sig-canvas" width="520" height="200" class="w-full max-w-full cursor-crosshair touch-none rounded-xl border border-slate-200 bg-slate-50"></canvas>
                <div class="mt-3 flex gap-2">
                    <button type="button" @@click="clearSig()" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50">Xóa chữ ký</button>
                </div>
                <form id="contract-sign-form" asp-action="SignContract" method="post" class="mt-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contractId" :value="activeId" />
                    <input type="hidden" name="digitalSignature" id="contract-digital-signature" value="" />
                    <button type="button" @@click="submitSig()" class="w-full rounded-xl bg-slate-900 py-4 text-sm font-black text-white shadow-lg hover:bg-orange-600">Gửi chữ ký &amp; hoàn tất</button>
                </form>
            </div>
        </div>

        <div class="sticky bottom-0 border-t border-slate-200 bg-white px-4 py-4 sm:px-8" x-show="step === 1">
            <button type="button" @@click="step = 2" class="mx-auto block w-full max-w-5xl rounded-xl bg-slate-900 py-4 text-sm font-black text-white shadow hover:bg-orange-600">Tiếp tục: ký tên</button>
        </div>
    </div>

    <!-- Full-screen: phụ lục đơn hàng (menu + tổng + ký) -->
    <div x-show="annexOpen" x-cloak class="esign-full flex flex-col" style="display:none;">
        <header class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white px-4 py-4 sm:px-8">
            <div class="flex items-center gap-3">
                <button type="button" @@click="closeAnnexFlow()" class="rounded-xl border border-slate-200 p-2 text-slate-500 hover:bg-orange-50 hover:text-orange-600">
                    <i data-lucide="arrow-left" class="h-5 w-5"></i>
                </button>
                <div>
                    <p class="text-sm font-black text-slate-900">Cổng ký số HuitMeal</p>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400" x-text="annexStep === 1 ? 'Bước 1: Rà soát nội dung' : 'Bước 2: Ký tên'"></p>
                </div>
            </div>
            <div class="hidden items-center gap-2 sm:flex">
                <span class="rounded-lg px-2 py-1 text-[10px] font-black" :class="annexStep >= 1 ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-400'">1 XEM</span>
                <span class="text-slate-300">—</span>
                <span class="rounded-lg px-2 py-1 text-[10px] font-black" :class="annexStep >= 2 ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-400'">2 KÝ</span>
                <span class="text-slate-300">—</span>
                <span class="rounded-lg px-2 py-1 text-[10px] font-black text-slate-300">3 XONG</span>
            </div>
            <button type="button" @@click="closeAnnexFlow()" class="text-xs font-bold text-slate-500 hover:text-orange-600">Thoát</button>
        </header>

        <div class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6" x-show="orderAnnex">
            <div x-show="annexStep === 1">
                <p class="mb-3 text-center text-[10px] font-semibold uppercase tracking-wider text-slate-500">Bản xem trước phụ lục (PDF) — đúng nội dung sẽ lưu sau khi ký</p>
                <div class="annex-pdf-frame relative mx-auto max-w-4xl overflow-hidden rounded-sm border border-slate-300 shadow-2xl">
                    <div x-show="annexPreviewLoading" class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-slate-200/95">
                        <div class="h-10 w-10 animate-spin rounded-full border-4 border-slate-300 border-t-slate-900"></div>
                        <p class="text-sm font-semibold text-slate-700">Đang tạo bản xem trước PDF…</p>
                    </div>
                    <iframe
                        x-show="annexPreviewSrc"
                        :src="annexPreviewSrc"
                        @@load="onAnnexPreviewLoad()"
                        title="Xem trước phụ lục đặt hàng"
                    ></iframe>
                </div>
            </div>
            <div x-show="annexStep === 2" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
                <p class="mb-4 text-sm font-bold text-slate-800">Ký bằng chuột hoặc cảm ứng (PNG) — xác nhận phụ lục đơn</p>
                <canvas id="order-annex-sig-canvas" width="520" height="200" class="w-full max-w-full cursor-crosshair touch-none rounded-xl border border-slate-200 bg-slate-50"></canvas>
                <div class="mt-3 flex gap-2">
                    <button type="button" @@click="clearAnnexSig()" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50">Xóa chữ ký</button>
                </div>
                <form id="order-annex-sign-form" asp-action="SignOrderAnnex" method="post" class="mt-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" :value="orderAnnex.id" />
                    <input type="hidden" name="digitalSignature" id="order-annex-digital-signature" value="" />
                    <button type="button" @@click="submitAnnexSig()" class="w-full rounded-xl bg-slate-900 py-4 text-sm font-black text-white shadow-lg hover:bg-orange-600">Hoàn tất ký — lưu PDF &amp; chuyển thanh toán</button>
                </form>
            </div>
        </div>

        <div class="sticky bottom-0 border-t border-slate-200 bg-white px-4 py-4 sm:px-8" x-show="annexStep === 1 && orderAnnex">
            <button type="button" @@click="annexStep = 2; $nextTick(() => bindAnnexCanvas())" class="mx-auto block w-full max-w-5xl rounded-xl bg-slate-900 py-4 text-sm font-black text-white shadow hover:bg-orange-600">Tiếp tục: ký tên</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function esignPortal() {
            return {
                contracts: [],
                orderAnnex: null,
                annexOpen: false,
                annexStep: 1,
                annexPreviewSrc: '',
                annexPreviewLoading: false,
                open: false,
                step: 1,
                activeId: null,
                get active() { return this.contracts.find(c => c.id === this.activeId); },
                init() {
                    this.contracts = window.__HM_CONTRACTS || [];
                    this.orderAnnex = window.__HM_ORDER_ANNEX || null;
                    this.annexOpen = !!(this.orderAnnex && this.orderAnnex.id);
                    this.annexStep = 1;
                    if (this.annexOpen) {
                        document.body.classList.add('overflow-hidden');
                        this.loadAnnexPreview();
                        this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                    }
                },
                loadAnnexPreview(force) {
                    if (!this.orderAnnex?.id) return;
                    if (this.orderAnnex.annexPdfUrl) {
                        this.annexPreviewLoading = true;
                        this.annexPreviewSrc = this.orderAnnex.annexPdfUrl;
                        return;
                    }
                    if (force) this.annexPreviewSrc = '';
                    this.annexPreviewLoading = true;
                    this.annexPreviewSrc = '/Profile/OrderAnnexPreview?orderId=' + encodeURIComponent(this.orderAnnex.id) + '&_=' + Date.now();
                },
                onAnnexPreviewLoad() {
                    this.annexPreviewLoading = false;
                },
                fmt(v) {
                    if (!v) return '';
                    const d = new Date(v);
                    return d.toLocaleDateString('vi-VN');
                },
                fmtIso(v) {
                    if (!v) return '';
                    const d = new Date(v);
                    return d.toLocaleDateString('vi-VN');
                },
                money(v) {
                    if (v == null || v === '') return '0 đ';
                    return Number(v).toLocaleString('vi-VN') + ' đ';
                },
                openFlow(id) {
                    this.activeId = id;
                    this.step = 1;
                    this.open = true;
                    document.body.classList.add('overflow-hidden');
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                },
                closeFlow() {
                    this.open = false;
                    if (!this.annexOpen) document.body.classList.remove('overflow-hidden');
                    this.step = 1;
                },
                openAnnexFlow() {
                    if (!this.orderAnnex) return;
                    this.annexStep = 1;
                    this.annexOpen = true;
                    document.body.classList.add('overflow-hidden');
                    this.loadAnnexPreview();
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                },
                closeAnnexFlow() {
                    this.annexOpen = false;
                    this.annexStep = 1;
                    if (!this.open) document.body.classList.remove('overflow-hidden');
                },
                clearSig() {
                    const c = document.getElementById('contract-sig-canvas');
                    if (!c) return;
                    const ctx = c.getContext('2d');
                    ctx.clearRect(0, 0, c.width, c.height);
                },
                clearAnnexSig() {
                    const c = document.getElementById('order-annex-sig-canvas');
                    if (!c) return;
                    const ctx = c.getContext('2d');
                    ctx.clearRect(0, 0, c.width, c.height);
                },
                submitSig() {
                    const c = document.getElementById('contract-sig-canvas');
                    const hidden = document.getElementById('contract-digital-signature');
                    if (!c || !hidden) return;
                    const blank = document.createElement('canvas');
                    blank.width = c.width; blank.height = c.height;
                    if (blank.toDataURL() === c.toDataURL()) {
                        alert('Vui lòng ký trước khi gửi.');
                        return;
                    }
                    hidden.value = c.toDataURL('image/png');
                    document.getElementById('contract-sign-form').submit();
                },
                submitAnnexSig() {
                    const c = document.getElementById('order-annex-sig-canvas');
                    const hidden = document.getElementById('order-annex-digital-signature');
                    if (!c || !hidden) return;
                    const blank = document.createElement('canvas');
                    blank.width = c.width; blank.height = c.height;
                    if (blank.toDataURL() === c.toDataURL()) {
                        alert('Vui lòng ký trước khi gửi.');
                        return;
                    }
                    hidden.value = c.toDataURL('image/png');
                    document.getElementById('order-annex-sign-form').submit();
                },
                bindAnnexCanvas() {
                    const c = document.getElementById('order-annex-sig-canvas');
                    if (!c || c.dataset.bound === '1') return;
                    c.dataset.bound = '1';
                    wireCanvas(c);
                }
            };
        }
        function wireCanvas(c) {
            const ctx = c.getContext('2d');
            let d = false, lx = null, ly = null;
            function pos(e) {
                const r = c.getBoundingClientRect();
                const t = e.touches ? e.touches[0] : e;
                return { x: (t.clientX - r.left) * (c.width / r.width), y: (t.clientY - r.top) * (c.height / r.height) };
            }
            c.addEventListener('mousedown', e => { d = true; const p = pos(e); lx = p.x; ly = p.y; });
            c.addEventListener('mouseup', () => { d = false; lx = ly = null; });
            c.addEventListener('mouseleave', () => { d = false; lx = ly = null; });
            c.addEventListener('mousemove', e => {
                if (!d || lx == null) return;
                const p = pos(e);
                ctx.strokeStyle = '#0f172a'; ctx.lineWidth = 2; ctx.lineCap = 'round';
                ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p.x, p.y); ctx.stroke();
                lx = p.x; ly = p.y;
            });
            c.addEventListener('touchstart', e => { d = true; const p = pos(e); lx = p.x; ly = p.y; e.preventDefault(); }, { passive: false });
            c.addEventListener('touchend', () => { d = false; lx = ly = null; });
            c.addEventListener('touchmove', e => {
                if (!d || lx == null) return;
                const p = pos(e);
                ctx.strokeStyle = '#0f172a'; ctx.lineWidth = 2; ctx.lineCap = 'round';
                ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p.x, p.y); ctx.stroke();
                lx = p.x; ly = p.y; e.preventDefault();
            }, { passive: false });
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('#contract-sig-canvas, #order-annex-sig-canvas').forEach(c => {
                if (c && !c.dataset.bound) { c.dataset.bound = '1'; wireCanvas(c); }
            });
        });
    </script>
}
