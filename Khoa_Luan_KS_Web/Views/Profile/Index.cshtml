@model Khoa_Luan_KS_Web.Models.CompanyProfilePageViewModel
@using Khoa_Luan_KS_Web.Services
@{
    ViewData["Title"] = "Hồ sơ doanh nghiệp";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var org = Model.Organization;
    var user = Model.User;
    var displayName = org?.Name ?? user?.Unit?.Name ?? user?.FullName ?? "Đơn vị";
    var initial = string.IsNullOrEmpty(displayName) ? "?" : displayName.Trim()[0].ToString().ToUpperInvariant();
    var logoUrl = org?.LogoUrl;
}

<style>
    .profile-page {
        background:
            radial-gradient(900px 380px at 100% 0%, rgba(249, 115, 22, 0.1), transparent 55%),
            radial-gradient(700px 320px at 0% 40%, rgba(15, 23, 42, 0.05), transparent 50%),
            linear-gradient(180deg, #f8fafc 0%, #fff 40%, #f1f5f9 100%);
    }
    .profile-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 24px -6px rgba(15, 23, 42, 0.08);
    }
    .field-input {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.625rem 0.875rem;
        font-size: 0.875rem;
        color: #0f172a;
        transition: border-color .15s, box-shadow .15s;
    }
    .field-input:focus {
        outline: none;
        border-color: #f97316;
        box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
    }
    .doc-drop {
        border: 2px dashed #cbd5e1;
        transition: border-color .2s, background .2s;
    }
    .doc-drop.dragover {
        border-color: #f97316;
        background: #fff7ed;
    }
    .doc-row:hover { background: #f8fafc; }
    .avatar-upload {
        position: relative;
        width: 5.5rem;
        height: 5.5rem;
        border-radius: 1.25rem;
        overflow: hidden;
        flex-shrink: 0;
        cursor: pointer;
        border: 3px solid #fff;
        box-shadow: 0 8px 24px -4px rgba(249, 115, 22, 0.35);
    }
    .avatar-upload img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-upload .avatar-fallback {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #f97316, #f59e0b);
        font-size: 1.75rem; font-weight: 800; color: #fff;
    }
    .avatar-upload .avatar-overlay {
        position: absolute; inset: 0;
        background: rgba(15, 23, 42, 0.45);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        opacity: 0; transition: opacity .2s;
        color: #fff; font-size: 10px; font-weight: 700;
    }
    .avatar-upload:hover .avatar-overlay { opacity: 1; }
</style>

<div class="profile-page min-h-screen pb-16">
    <div class="w-full max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-10 pt-8 md:pt-10">

        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6">
            <a href="/Customer/Index" class="hover:text-orange-600 transition">Trang chủ</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-slate-700">Hồ sơ doanh nghiệp</span>
        </nav>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="mb-5 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
                <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5"></i>
                <span>@Model.SuccessMessage</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.LoadError))
        {
            <div class="profile-card rounded-2xl p-10 text-center">
                <i data-lucide="wifi-off" class="w-12 h-12 text-slate-300 mx-auto mb-3"></i>
                <p class="font-bold text-slate-800">Không tải được hồ sơ</p>
                <p class="text-sm text-slate-500 mt-2">@Model.LoadError</p>
                <a href="/Profile/Index" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white hover:bg-orange-600 transition">
                    Thử lại
                </a>
            </div>
        }
        else if (!Model.IsOrganizationAccount || org == null)
        {
            <div class="profile-card rounded-2xl p-10 text-center max-w-lg mx-auto">
                <i data-lucide="building-2" class="w-12 h-12 text-orange-400 mx-auto mb-3"></i>
                <h1 class="text-lg font-bold text-slate-900">Tài khoản chưa gán đơn vị</h1>
                <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                    Trang này dành cho khách hàng doanh nghiệp. Vui lòng liên hệ HuitMeal để được gán đơn vị trên hệ thống.
                </p>
            </div>
        }
        else
        {
            <!-- Header -->
            <div class="profile-card rounded-2xl p-6 md:p-8 mb-6 flex flex-col lg:flex-row lg:items-center gap-6">
                <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" class="shrink-0" id="logo-upload-form">
                    @Html.AntiForgeryToken()
                    <label class="avatar-upload block" title="Bấm để đổi ảnh đại diện">
                        @if (!string.IsNullOrEmpty(logoUrl))
                        {
                            <img src="@logoUrl" alt="@displayName" id="org-logo-preview" />
                        }
                        else
                        {
                            <div class="avatar-fallback" id="org-logo-fallback">@initial</div>
                        }
                        <span class="avatar-overlay">
                            <i data-lucide="camera" class="w-5 h-5 mb-0.5"></i>
                            Đổi ảnh
                        </span>
                        <input type="file" name="logoFile" id="logo-file-input" class="hidden" accept="image/jpeg,image/png,image/webp" />
                    </label>
                    <p class="text-[10px] text-slate-400 mt-2 text-center max-w-[100px]">JPG/PNG/WEBP · 3MB</p>
                </form>
                <div class="flex-1 min-w-0">
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-600 mb-1">Hồ sơ đơn vị</p>
                    <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight truncate">@displayName</h1>
                    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 font-bold text-slate-600">
                            <i data-lucide="hash" class="w-3 h-3"></i> ID @org.OrganizationId
                        </span>
                        @if (org.IsActive)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100 px-2.5 py-1 font-bold">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đang hoạt động
                            </span>
                        }
                        <span class="rounded-full bg-orange-50 text-orange-800 border border-orange-100 px-2.5 py-1 font-bold">@org.UnitType</span>
                    </div>
                </div>
                <div class="flex flex-col items-stretch sm:items-end gap-2 sm:max-w-[220px]">
                    <a href="/Profile/Security"
                       class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs font-bold text-slate-700 hover:border-orange-300 hover:text-orange-600 transition">
                        <i data-lucide="shield" class="w-4 h-4"></i> Đổi mật khẩu
                    </a>
                    <p class="text-xs text-slate-500 text-right leading-relaxed">
                        Chỉnh sửa trực tiếp — thay đổi có hiệu lực ngay.
                    </p>
                </div>
            </div>

            <div class="grid xl:grid-cols-12 gap-6 lg:gap-8">
                <!-- Form thông tin -->
                <div class="xl:col-span-7 space-y-6">
                    <form asp-action="UpdateOrganization" method="post" class="profile-card rounded-2xl p-6 md:p-7">
                        @Html.AntiForgeryToken()
                        <div class="flex items-center justify-between gap-3 mb-6">
                            <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
                                <i data-lucide="building" class="w-5 h-5 text-orange-500"></i>
                                Thông tin pháp lý & liên hệ
                            </h2>
                            <button type="submit"
                                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-orange-600 transition shadow-sm">
                                <i data-lucide="save" class="w-4 h-4"></i> Lưu hồ sơ
                            </button>
                        </div>

                        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            <div class="sm:col-span-2 lg:col-span-3">
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Tên đơn vị / doanh nghiệp <span class="text-red-500">*</span></label>
                                <input name="Name" value="@org.Name" required class="field-input" placeholder="VD: Trường THPT XYZ" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Mã số thuế</label>
                                <input name="TaxCode" value="@org.TaxCode" class="field-input" placeholder="0123456789" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Người đại diện pháp luật</label>
                                <input name="LegalRepresentative" value="@org.LegalRepresentative" class="field-input" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Người liên hệ</label>
                                <input name="ContactPerson" value="@org.ContactPerson" class="field-input" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Điện thoại</label>
                                <input name="Phone" value="@org.Phone" type="tel" class="field-input" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Email đặt hàng / hỗ trợ</label>
                                <input name="ContactEmail" value="@org.ContactEmail" type="email" class="field-input" />
                            </div>
                            <div class="sm:col-span-2 lg:col-span-3">
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Địa chỉ giao suất / giao dịch</label>
                                <textarea name="Address" rows="2" class="field-input resize-none">@org.Address</textarea>
                            </div>
                            <div class="sm:col-span-2 lg:col-span-3">
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Website (tuỳ chọn)</label>
                                <input name="Website" value="@org.Website" type="url" class="field-input" placeholder="https://..." />
                            </div>
                        </div>
                    </form>

                    <!-- Tài khoản đăng nhập (readonly) -->
                    @if (user != null)
                    {
                        <div class="profile-card rounded-2xl p-6 border-dashed">
                            <h3 class="text-sm font-bold text-slate-700 mb-3 flex items-center gap-2">
                                <i data-lucide="user-circle" class="w-4 h-4 text-slate-400"></i>
                                Tài khoản đăng nhập
                            </h3>
                            <div class="grid sm:grid-cols-2 gap-3 text-sm">
                                <div class="rounded-lg bg-slate-50 px-3 py-2.5 border border-slate-100">
                                    <p class="text-[10px] font-bold uppercase text-slate-400">Email</p>
                                    <p class="font-semibold text-slate-800 truncate">@user.Email</p>
                                </div>
                                <div class="rounded-lg bg-slate-50 px-3 py-2.5 border border-slate-100">
                                    <p class="text-[10px] font-bold uppercase text-slate-400">Họ tên người dùng</p>
                                    <p class="font-semibold text-slate-800 truncate">@user.FullName</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Upload + danh sách tài liệu -->
                <div class="xl:col-span-5 space-y-6" x-data="{ fileName: '' }">
                    <div class="profile-card rounded-2xl p-6">
                        <h2 class="text-base font-black text-slate-900 mb-1 flex items-center gap-2">
                            <i data-lucide="file-up" class="w-5 h-5 text-orange-500"></i>
                            Tải tài liệu pháp lý
                        </h2>
                        <p class="text-xs text-slate-500 mb-4">PDF hoặc ảnh (JPG, PNG), tối đa 10MB.</p>

                        <form asp-action="UploadLegalDocument" method="post" enctype="multipart/form-data" class="space-y-3">
                            @Html.AntiForgeryToken()
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Loại tài liệu</label>
                                <select name="documentType" class="field-input">
                                    <option value="business_license">Giấy đăng ký kinh doanh</option>
                                    <option value="tax">Giấy xác nhận MST</option>
                                    <option value="authorization">Giấy ủy quyền / QĐ bổ nhiệm</option>
                                    <option value="other">Tài liệu khác</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Tiêu đề hiển thị</label>
                                <input name="title" class="field-input" placeholder="VD: GPKD 2024" />
                            </div>
                            <div class="doc-drop rounded-xl p-5 text-center cursor-pointer"
                                 @@click="$refs.fileInput.click()"
                                 @@dragover.prevent="$el.classList.add('dragover')"
                                 @@dragleave.prevent="$el.classList.remove('dragover')"
                                 @@drop.prevent="$el.classList.remove('dragover'); $refs.fileInput.files = $event.dataTransfer.files; fileName = $event.dataTransfer.files[0]?.name || ''">
                                <input x-ref="fileInput" type="file" name="file" class="hidden" required accept=".pdf,image/jpeg,image/png,image/webp"
                                       @@change="fileName = $event.target.files[0]?.name || ''" />
                                <i data-lucide="upload-cloud" class="w-8 h-8 text-slate-300 mx-auto mb-2"></i>
                                <p class="text-sm font-bold text-slate-700">Kéo thả hoặc bấm để chọn file</p>
                                <p class="text-xs text-slate-400 mt-1" x-text="fileName || 'Chưa chọn file'"></p>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Ngày cấp</label>
                                    <input type="date" name="issuedDate" class="field-input text-xs" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Hết hạn</label>
                                    <input type="date" name="expiryDate" class="field-input text-xs" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Ghi chú</label>
                                <input name="description" class="field-input text-xs" placeholder="Tuỳ chọn" />
                            </div>
                            <button type="submit"
                                    class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-orange-500 py-2.5 text-sm font-bold text-white hover:bg-orange-600 transition shadow-md shadow-orange-500/20">
                                <i data-lucide="upload" class="w-4 h-4"></i> Tải lên
                            </button>
                        </form>
                    </div>

                    <div class="profile-card rounded-2xl overflow-hidden">
                        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                            <h2 class="text-sm font-black text-slate-900">Hồ sơ đã tải</h2>
                            <span class="text-[10px] font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">@(org.Documents?.Count ?? 0)</span>
                        </div>
                        @if (org.Documents == null || org.Documents.Count == 0)
                        {
                            <div class="px-5 py-10 text-center text-sm text-slate-400">
                                <i data-lucide="folder-open" class="w-10 h-10 mx-auto mb-2 opacity-40"></i>
                                Chưa có tài liệu nào
                            </div>
                        }
                        else
                        {
                            <ul class="divide-y divide-slate-100 max-h-[420px] overflow-y-auto">
                                @foreach (var doc in org.Documents)
                                {
                                    <li class="doc-row px-4 py-3 flex gap-3 items-start">
                                        <div class="w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center shrink-0">
                                            <i data-lucide="@(doc.ContentType?.Contains("pdf") == true ? "file-text" : "image")" class="w-4 h-4 text-orange-600"></i>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold text-slate-900 truncate">@doc.Title</p>
                                            <p class="text-[10px] text-slate-500">@doc.DocumentTypeLabel · @doc.CreatedAt.ToString("dd/MM/yyyy")</p>
                                            @if (doc.ExpiryDate.HasValue)
                                            {
                                                <p class="text-[10px] text-amber-600 font-semibold mt-0.5">Hết hạn: @doc.ExpiryDate.Value.ToString("dd/MM/yyyy")</p>
                                            }
                                        </div>
                                        <div class="flex flex-col gap-1 shrink-0">
                                            <a href="@doc.FileUrl" target="_blank" rel="noopener"
                                               class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 text-slate-600 hover:border-orange-200 hover:text-orange-600 transition"
                                               title="Xem">
                                                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                            </a>
                                            <form asp-action="DeleteLegalDocument" method="post" class="inline"
                                                  onsubmit="return confirm('Xóa tài liệu này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="documentId" value="@doc.Id" />
                                                <button type="submit"
                                                        class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-red-100 text-red-500 hover:bg-red-50 transition"
                                                        title="Xóa">
                                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        const input = document.getElementById('logo-file-input');
        const form = document.getElementById('logo-upload-form');
        if (input && form) {
            input.addEventListener('change', () => {
                if (input.files?.[0]) form.submit();
            });
        }
    });
</script>
