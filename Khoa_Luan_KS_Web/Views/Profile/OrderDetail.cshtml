@model Khoa_Luan_KS_Web.Services.OrderDetailClientDto
@using System
@using Khoa_Luan_KS_Web.Models
@using Khoa_Luan_KS_Web.Helpers
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "_LayoutCustomer";
    var sig = ViewBag.SignatureDataUrl as string;
    var signedPdfUrl = OrderSignedDocumentHelper.GetSignedPdfUrl(Model);
}

<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    @if (TempData["OrderSuccess"] is string os && !string.IsNullOrEmpty(os))
    {
        <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">@os</div>
    }
    @if (TempData["OrgMealError"] is string ome && !string.IsNullOrEmpty(ome))
    {
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-900">@ome</div>
    }
    @if (TempData["AnnexSignWarning"] is string aw && !string.IsNullOrEmpty(aw))
    {
        <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-950">@aw</div>
    }

    <h1 class="mb-1 text-2xl font-black text-slate-900">Chi tiết đơn</h1>
    <p class="mb-6 font-mono text-sm text-slate-600">@(string.IsNullOrEmpty(Model.InvoiceCode) ? "#" + Model.Id : Model.InvoiceCode)</p>

    @{
        var deliveryNotes = ViewBag.OrderDeliveryNotes as List<OrderDeliveryNoteLine>;
        var isOrg = User.IsInRole("Organization") || User.IsInRole("Company") || User.IsInRole("Khách hàng doanh nghiệp");
        var isDelivered = string.Equals(Model.Status, "delivered", StringComparison.OrdinalIgnoreCase);
        var todayVn = OrganizationMealContractDateRules.TodayVietnam();
        var placeMealLink = OrderMealPlacementDisplay.TryGetPlaceMealLink(Model, isOrg, todayVn);
    }
    @if (deliveryNotes is { Count: > 0 })
    {
        <div class="mb-6 rounded-2xl border border-sky-200 bg-sky-50/80 p-5 text-sm shadow-sm">
            <p class="mb-3 text-xs font-black uppercase tracking-wider text-sky-900">Lịch giao đã ghi nhận</p>
            <ul class="space-y-2">
                @foreach (var d in deliveryNotes.OrderBy(x => x.DateKey, StringComparer.Ordinal))
                {
                    <li class="rounded-xl border border-white/60 bg-white/80 px-3 py-2">
                        <span class="font-bold text-slate-900">@d.DisplayLabel</span>
                        <span class="mx-2 text-slate-300">·</span>
                        <span class="text-slate-700">@d.Address</span>
                        @if (!string.IsNullOrWhiteSpace(d.DeliveryTime))
                        {
                            <span class="mt-1 block text-xs font-semibold text-orange-700">Giờ giao: @d.DeliveryTime</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <div class="mb-6 flex flex-wrap gap-2">
        @if (!string.IsNullOrEmpty(signedPdfUrl))
        {
            <a href="@signedPdfUrl" target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-800 sm:text-sm">
                <i data-lucide="file-text" class="h-4 w-4"></i> Xem / tải PDF hợp đồng đã ký
            </a>
        }
        else if (User.IsInRole("Organization") || User.IsInRole("Company") || User.IsInRole("Khách hàng doanh nghiệp"))
        {
            <a asp-action="Contracts" asp-route-orderId="@Model.Id"
               class="inline-flex items-center gap-2 rounded-xl border border-violet-300 bg-violet-50 px-4 py-2.5 text-xs font-bold text-violet-900 hover:bg-violet-100 sm:text-sm">
                Ký phụ lục đặt hàng
            </a>
        }
        else
        {
            <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank"
               class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-800 sm:text-sm">
                Xuất hóa đơn (in / PDF)
            </a>
        }
        @if ((User.IsInRole("Organization") || User.IsInRole("Company") || User.IsInRole("Khách hàng doanh nghiệp"))
             && OrderPaymentStatusDisplay.CanPayDeposit(Model.PaymentStatus, Model.AnnexPdfUrl))
        {
            <form asp-controller="OrganizationMealOrder" asp-action="PayDeposit" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 px-4 py-2.5 text-xs font-black text-white shadow-lg hover:from-orange-600 hover:to-amber-600 sm:text-sm">
                    <i data-lucide="credit-card" class="h-4 w-4"></i> Thanh toán đặt cọc
                </button>
            </form>
        }
        @if (placeMealLink != null)
        {
            <a asp-controller="@placeMealLink.Controller"
               asp-action="@placeMealLink.Action"
               asp-all-route-data="@placeMealLink.RouteValues"
               class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 px-4 py-2.5 text-xs font-black text-white shadow-lg hover:from-orange-600 hover:to-amber-600 sm:text-sm"
               title="@placeMealLink.Title">
                <i data-lucide="utensils" class="h-4 w-4"></i> @OrderMealPlacementDisplay.ButtonLabel
            </a>
        }
        @if (OrderCustomerCancelDisplay.CanCancel(Model.Status, Model.PaymentStatus, Model.ScheduledDate))
        {
            <form asp-action="CancelOrder" method="post" class="inline"
                  onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-xs font-bold text-red-700 hover:bg-red-100 sm:text-sm">
                    <i data-lucide="x-circle" class="h-4 w-4"></i> Hủy đơn hàng
                </button>
            </form>
        }
        @if (isOrg && isDelivered)
        {
            <a asp-action="ComplaintCreate" asp-route-orderId="@Model.Id"
               class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-xs font-bold text-red-800 hover:bg-red-100 sm:text-sm">
                <i data-lucide="alert-circle" class="h-4 w-4"></i> Khiếu nại (24h)
            </a>
        }
        @if (isOrg)
        {
            <a asp-action="Complaints" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50 sm:text-sm">Khiếu nại của tôi</a>
        }
        <a asp-action="Orders" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50 sm:text-sm">Danh sách đơn</a>
        <a asp-controller="Menu" asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-xs font-bold text-orange-800 hover:bg-orange-100 sm:text-sm">Tiếp tục mua</a>
    </div>

    @if (isOrg && isDelivered)
    {
        <div id="delivery-otp-panel" class="mb-6 rounded-2xl border border-sky-200 bg-sky-50/90 p-5 text-sm hidden">
            <p class="text-xs font-black uppercase tracking-wider text-sky-900">Mã OTP giao hàng</p>
            <p id="delivery-otp-code" class="text-2xl font-black text-sky-800 tracking-widest mt-1"></p>
            <p id="delivery-otp-expires" class="text-xs text-sky-700 mt-1"></p>
        </div>
    }

    <div class="space-y-3 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm text-sm">
        <div class="flex justify-between border-b border-slate-100 py-2"><span class="text-slate-500">Ngày đặt</span><span class="font-bold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span></div>
        <div class="flex justify-between border-b border-slate-100 py-2"><span class="text-slate-500">Ngày giao dự kiến</span><span class="font-bold">@Model.ScheduledDate.ToString("dd/MM/yyyy")</span></div>
        <div class="flex justify-between border-b border-slate-100 py-2">
            <span class="text-slate-500">Trạng thái</span>
            <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-bold @OrderStatusHelper.BadgeClass(Model.Status)">
                @OrderStatusHelper.ToDisplay(Model.Status)
            </span>
        </div>
        <div class="flex justify-between py-2">
            <span class="text-slate-500">Thanh toán</span>
            <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-black @OrderPaymentStatusDisplay.BadgeClass(Model.PaymentStatus)">
                @OrderPaymentStatusDisplay.Label(Model.PaymentStatus)
            </span>
        </div>
    </div>

    <h2 class="mb-2 mt-8 text-lg font-black text-slate-900">Món trong đơn</h2>
    <ul class="divide-y divide-slate-100 rounded-2xl border border-slate-100 bg-white shadow-sm">
        @foreach (var it in Model.Items)
        {
            <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
                <span class="font-medium text-slate-800">@it.DishName</span>
                <span class="text-slate-600">x @it.Quantity</span>
                <span class="font-bold text-orange-600">@it.TotalPrice.ToString("N0") đ</span>
            </li>
        }
    </ul>
    <p class="mt-4 text-right text-lg font-black text-slate-900">Tổng: @Model.TotalAmount.ToString("N0") đ</p>

    @if (!string.IsNullOrEmpty(sig))
    {
        <div class="mt-8 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
            <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">Chữ ký xác nhận đã lưu</p>
            <img src="@sig" alt="Chữ ký" class="max-h-40 rounded-lg border border-slate-100 bg-slate-50" />
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) lucide.createIcons();
        @if (isOrg && isDelivered)
        {
            @:fetch('@Url.Action("DeliveryOtp", "Profile")?orderId=@Model.Id')
            @:  .then(function (r) { return r.ok ? r.json() : null; })
            @:  .then(function (d) {
            @:    if (!d || !d.isActive || !d.deliveryOtp) return;
            @:    var panel = document.getElementById('delivery-otp-panel');
            @:    if (!panel) return;
            @:    panel.classList.remove('hidden');
            @:    document.getElementById('delivery-otp-code').textContent = d.deliveryOtp;
            @:    var exp = d.deliveryOtpExpiresAt ? new Date(d.deliveryOtpExpiresAt).toLocaleString('vi-VN') : '';
            @:    document.getElementById('delivery-otp-expires').textContent = 'Hết hạn: ' + exp;
            @:  }).catch(function () {});
        }
    });
</script>
