@model Khoa_Luan_KS_Web.Models.ProfileOrderDetailPageVm
@using System.Globalization
@using Khoa_Luan_KS_Web.Models
@using Khoa_Luan_KS_Web.Helpers
@{
    ViewData["Title"] = Model.IsPeriodBased ? "Chi tiết đơn & suất ăn theo tuần" : "Chi tiết đơn hàng";
    Layout = "_LayoutCustomer";
    var order = Model.Order;
    var sig = ViewBag.SignatureDataUrl as string;
    var signedPdfUrl = OrderSignedDocumentHelper.GetSignedPdfUrl(order);
    var deliveryNotes = ViewBag.OrderDeliveryNotes as List<OrderDeliveryNoteLine>;
    var isOrg = User.IsInRole("Organization") || User.IsInRole("Company") || User.IsInRole("Khách hàng doanh nghiệp");
    var isDelivered = string.Equals(order.Status, "delivered", StringComparison.OrdinalIgnoreCase);
    var todayVn = OrganizationMealContractDateRules.TodayVietnam();
    var placeMealLink = OrderMealPlacementDisplay.TryGetPlaceMealLink(order, isOrg, todayVn);
    var contract = Model.Contract;
    var weekly = Model.Weekly;
    var contractId = OrderMealPlacementDisplay.ResolveContractId(order);
    var progress = weekly?.TotalServiceWeeks > 0
        ? (int)Math.Round(100.0 * weekly!.FilledServiceWeeks / weekly.TotalServiceWeeks)
        : 0;
}

@if (Model.IsPeriodBased && contract != null && weekly != null)
{
    <div class="min-h-screen bg-slate-100/90" style="background-image: radial-gradient(circle at 1px 1px, rgba(148,163,184,0.2) 1px, transparent 0); background-size: 24px 24px;">
        <section class="relative h-[200px] overflow-hidden sm:h-[220px]">
            <img src="https://images.unsplash.com/photo-1555244162-803834f70033?q=80&w=1920&auto=format&fit=crop"
                 alt="" class="absolute inset-0 h-full w-full object-cover brightness-[0.45]" />
            <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/65 to-slate-900/25"></div>
            <div class="relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-end px-4 pb-8 pt-24 sm:px-6">
                <nav class="mb-3 flex flex-wrap items-center gap-2 text-xs font-semibold text-white/70">
                    <a asp-action="Orders" class="hover:text-orange-300">Lịch sử đơn</a>
                    <span class="text-white/30">/</span>
                    <span class="text-white/90">Chi tiết đơn đặt cọc</span>
                </nav>
                <h1 class="text-2xl font-black text-white sm:text-3xl">@(string.IsNullOrEmpty(order.InvoiceCode) ? $"#{order.Id}" : order.InvoiceCode)</h1>
                <p class="mt-2 text-sm text-slate-300">
                    Hợp đồng @(contract.ContractNumber ?? $"#{contractId}") · @(contract.OrganizationName ?? order.OrganizationName)
                </p>
            </div>
        </section>

        <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-10">
            @if (TempData["OrderSuccess"] is string os && !string.IsNullOrEmpty(os))
            {
                <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">@os</div>
            }
            @if (TempData["OrgMealError"] is string ome && !string.IsNullOrEmpty(ome))
            {
                <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-900">@ome</div>
            }

            <div class="mb-6 flex flex-wrap gap-2">
                @if (!string.IsNullOrEmpty(signedPdfUrl))
                {
                    <a href="@signedPdfUrl" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-800 sm:text-sm">
                        <i data-lucide="file-text" class="h-4 w-4"></i> PDF hợp đồng đã ký
                    </a>
                }
                @if (placeMealLink != null)
                {
                    <a asp-controller="@placeMealLink.Controller" asp-action="@placeMealLink.Action" asp-all-route-data="@placeMealLink.RouteValues"
                       class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 px-4 py-2.5 text-xs font-black text-white shadow-lg hover:from-orange-600 hover:to-amber-600 sm:text-sm"
                       title="@placeMealLink.Title">
                        <i data-lucide="utensils" class="h-4 w-4"></i> @OrderMealPlacementDisplay.ButtonLabel
                    </a>
                }
                @if (contractId > 0)
                {
                    <a asp-controller="OrganizationMealContractOrder" asp-action="Detail" asp-route-id="@contractId"
                       class="inline-flex items-center gap-2 rounded-xl border border-orange-200 bg-white px-4 py-2.5 text-xs font-bold text-orange-700 hover:bg-orange-50 sm:text-sm">
                        <i data-lucide="layout-list" class="h-4 w-4"></i> Quản lý HĐ đầy đủ
                    </a>
                }
                <a asp-action="Orders" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50 sm:text-sm">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i> Danh sách đơn
                </a>
            </div>

            <div class="mb-8 grid gap-4 lg:grid-cols-3">
                <div class="rounded-3xl border border-slate-200/80 bg-white p-6 shadow-lg lg:col-span-2">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Đơn đặt cọc (nguồn HĐ)</p>
                    <dl class="mt-4 grid gap-3 sm:grid-cols-2 text-sm">
                        <div>
                            <dt class="text-slate-500">Ngày đặt</dt>
                            <dd class="font-bold text-slate-900">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Bắt đầu phục vụ</dt>
                            <dd class="font-bold text-slate-900">@order.ScheduledDate.ToString("dd/MM/yyyy")</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Trạng thái đơn cọc</dt>
                            <dd class="mt-1">
                                <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-bold @OrderStatusHelper.BadgeClass(order.Status)">
                                    @OrderStatusHelper.ToDisplay(order.Status)
                                </span>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Thanh toán</dt>
                            <dd class="mt-1">
                                <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-black @OrderPaymentStatusDisplay.BadgeClass(order.PaymentStatus)">
                                    @OrderPaymentStatusDisplay.Label(order.PaymentStatus)
                                </span>
                            </dd>
                        </div>
                        <div class="sm:col-span-2">
                            <dt class="text-slate-500">Tổng giá trị HĐ</dt>
                            <dd class="text-xl font-black text-orange-600">@order.TotalAmount.ToString("N0") đ</dd>
                        </div>
                    </dl>
                </div>
                <div class="rounded-3xl border border-orange-200/80 bg-gradient-to-br from-orange-50 to-amber-50 p-6 shadow-lg">
                    <p class="text-[10px] font-black uppercase tracking-wider text-orange-700">Tiến độ chọn món tuần</p>
                    <p class="mt-2 text-3xl font-black text-slate-900">@weekly.FilledServiceWeeks<span class="text-lg text-slate-500">/@weekly.TotalServiceWeeks</span></p>
                    <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/80">
                        <div class="h-full rounded-full bg-gradient-to-r from-orange-500 to-amber-500" style="width:@(progress)%"></div>
                    </div>
                    @if (contract.EndDate.HasValue)
                    {
                        <p class="mt-3 text-xs text-slate-600">
                            Kỳ HĐ: @contract.StartDate.ToString("dd/MM/yyyy") – @contract.EndDate.Value.ToString("dd/MM/yyyy")
                        </p>
                    }
                </div>
            </div>

            <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl">
                <div class="border-b border-slate-100 bg-slate-50/80 px-6 py-4">
                    <h2 class="text-lg font-black text-slate-900">Suất ăn theo từng tuần</h2>
                    <p class="mt-1 text-sm text-slate-500">Món đã chọn, trạng thái giao hàng từng tuần. Mỗi tuần chỉ đặt một lần.</p>
                </div>

                @if (weekly.Weeks.Count == 0)
                {
                    <div class="p-10 text-center text-sm text-slate-500">Chưa có tuần phục vụ trong hợp đồng.</div>
                }
                else
                {
                    <div class="divide-y divide-slate-100" x-data="{ openWeek: '@(weekly.Weeks.FirstOrDefault(w => w.IsOpenWeek)?.WeekMonday.ToString("yyyy-MM-dd") ?? weekly.Weeks.FirstOrDefault(w => w.IsFilled)?.WeekMonday.ToString("yyyy-MM-dd") ?? "")' }">
                        @foreach (var w in weekly.Weeks)
                        {
                            var weekKey = w.WeekMonday.ToString("yyyy-MM-dd");
                            var weekLabel = $"Tuần {w.WeekMonday:dd/MM} – {w.WeekEnd:dd/MM/yyyy}";
                            <div class="@(w.IsOpenWeek ? "bg-orange-50/30" : "")">
                                <button type="button"
                                        class="flex w-full flex-col gap-3 px-6 py-5 text-left sm:flex-row sm:items-center sm:justify-between"
                                        @@click="openWeek = openWeek === '@weekKey' ? '' : '@weekKey'">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            @if (w.IsOpenWeek)
                                            {
                                                <span class="rounded-full bg-orange-500 px-2 py-0.5 text-[10px] font-black uppercase text-white">Tuần mở</span>
                                            }
                                            <span class="rounded-full px-2.5 py-0.5 text-[10px] font-bold @ContractWeeklySelectionDisplay.StatusBadgeClass(w.Status)">
                                                @ContractWeeklySelectionDisplay.StatusLabel(w.Status)
                                            </span>
                                            @if (w.IsFilled && !string.IsNullOrEmpty(w.FulfillmentOrderStatus))
                                            {
                                                <span class="rounded-full border px-2.5 py-0.5 text-[10px] font-bold @OrderStatusHelper.BadgeClass(w.FulfillmentOrderStatus)">
                                                    Giao: @OrderStatusHelper.ToDisplay(w.FulfillmentOrderStatus)
                                                </span>
                                            }
                                        </div>
                                        <p class="mt-1 font-black text-slate-900">@weekLabel</p>
                                        <p class="mt-0.5 text-xs text-slate-500">
                                            @w.Days.Count ngày ăn
                                            @if (w.SelectedAt.HasValue)
                                            {
                                                <span> · Chọn lúc @w.SelectedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                            @if (!string.IsNullOrEmpty(w.FulfillmentInvoiceCode))
                                            {
                                                <span> · @w.FulfillmentInvoiceCode</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                                        @if (w.CanSelect)
                                        {
                                            <a asp-controller="OrganizationMealContractOrder" asp-action="Weekly" asp-route-id="@contractId"
                                               class="inline-flex items-center gap-1.5 rounded-xl bg-orange-500 px-3 py-2 text-[11px] font-black text-white hover:bg-orange-600"
                                               @@click.stop>
                                                @ContractWeeklySelectionDisplay.SelectWeekButtonLabel
                                            </a>
                                        }
                                        else if (w.IsFilled)
                                        {
                                            <a asp-controller="OrganizationMealContractOrder" asp-action="WeeklyTrack" asp-route-id="@contractId" asp-route-weekStart="@weekKey"
                                               class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-[11px] font-black text-emerald-800 hover:bg-emerald-100"
                                               @@click.stop>
                                                @ContractWeeklySelectionDisplay.TrackWeekButtonLabel
                                            </a>
                                        }
                                        else if (w.IsOpenWeek)
                                        {
                                            <span class="text-[11px] font-bold text-amber-700">Chờ chọn / tự động</span>
                                        }
                                        <i data-lucide="chevron-down" class="h-5 w-5 text-slate-400 transition-transform"
                                           :class="openWeek === '@weekKey' ? 'rotate-180' : ''"></i>
                                    </div>
                                </button>

                                <div x-show="openWeek === '@weekKey'" x-cloak class="border-t border-slate-100 bg-slate-50/50 px-6 py-4">
                                    @if (!w.IsFilled || w.Days.All(d => d.Main.Count == 0))
                                    {
                                        <p class="text-sm text-slate-500 py-2">
                                            @(w.IsOpenWeek
                                                ? "Chưa chọn món cho tuần này. Bấm «Chọn món tuần này» trước hạn (3 ngày trước đầu tuần)."
                                                : "Chưa có thực đơn tuần này.")
                                        </p>
                                    }
                                    else
                                    {
                                        <div class="grid gap-4 md:grid-cols-2">
                                            @foreach (var day in w.Days)
                                            {
                                                <article class="rounded-2xl border border-white bg-white p-4 shadow-sm">
                                                    <p class="text-sm font-black text-slate-900">
                                                        @day.ServiceDate.ToString("dddd", new CultureInfo("vi-VN"))
                                                        <span class="font-bold text-slate-600"> · @day.ServiceDate.ToString("dd/MM/yyyy")</span>
                                                    </p>
                                                    <p class="mt-0.5 text-xs text-slate-500">@(day.Main.Sum(l => l.Quantity))/@(day.RequiredMeals) suất</p>
                                                    <ul class="mt-3 space-y-2">
                                                        @foreach (var line in day.Main)
                                                        {
                                                            <li class="flex items-center justify-between text-sm">
                                                                <span class="text-slate-800">@line.DishName</span>
                                                                <span class="rounded-full bg-orange-100 px-2 py-0.5 text-xs font-black text-orange-800">×@line.Quantity</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                </article>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (deliveryNotes is { Count: > 0 })
            {
                <div class="mt-6 rounded-2xl border border-sky-200 bg-sky-50/80 p-5 text-sm shadow-sm">
                    <p class="mb-3 text-xs font-black uppercase tracking-wider text-sky-900">Địa chỉ giao (đơn cọc)</p>
                    <ul class="space-y-2">
                        @foreach (var d in deliveryNotes.OrderBy(x => x.DateKey, StringComparer.Ordinal))
                        {
                            <li class="rounded-xl border border-white/60 bg-white/80 px-3 py-2">
                                <span class="font-bold text-slate-900">@d.DisplayLabel</span>
                                <span class="mx-2 text-slate-300">·</span>
                                <span class="text-slate-700">@d.Address</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
        @if (TempData["OrderSuccess"] is string os2 && !string.IsNullOrEmpty(os2))
        {
            <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">@os2</div>
        }
        @if (TempData["OrgMealError"] is string ome2 && !string.IsNullOrEmpty(ome2))
        {
            <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-900">@ome2</div>
        }
        @if (TempData["AnnexSignWarning"] is string aw && !string.IsNullOrEmpty(aw))
        {
            <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-950">@aw</div>
        }

        <h1 class="mb-1 text-2xl font-black text-slate-900">Chi tiết đơn</h1>
        <p class="mb-6 font-mono text-sm text-slate-600">@(string.IsNullOrEmpty(order.InvoiceCode) ? "#" + order.Id : order.InvoiceCode)</p>

        @if (deliveryNotes is { Count: > 0 })
        {
            <div class="mb-6 rounded-2xl border border-sky-200 bg-sky-50/80 p-5 text-sm shadow-sm">
                <p class="mb-3 text-xs font-black uppercase tracking-wider text-sky-900">Lịch giao đã ghi nhận</p>
                <ul class="space-y-2">
                    @foreach (var d in deliveryNotes.OrderBy(x => x.DateKey, StringComparer.Ordinal))
                    {
                        <li class="rounded-xl border border-white/60 bg-white/80 px-3 py-2">
                            <span class="font-bold text-slate-900">@d.DisplayLabel</span>
                            <span class="mx-2 text-slate-300">·</span>
                            <span class="text-slate-700">@d.Address</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="mb-6 flex flex-wrap gap-2">
            @if (!string.IsNullOrEmpty(signedPdfUrl))
            {
                <a href="@signedPdfUrl" target="_blank" rel="noopener"
                   class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-800 sm:text-sm">
                    <i data-lucide="file-text" class="h-4 w-4"></i> Xem / tải PDF hợp đồng đã ký
                </a>
            }
            else if (isOrg)
            {
                <a asp-action="Contracts" asp-route-orderId="@order.Id"
                   class="inline-flex items-center gap-2 rounded-xl border border-violet-300 bg-violet-50 px-4 py-2.5 text-xs font-bold text-violet-900 hover:bg-violet-100 sm:text-sm">
                    Ký phụ lục đặt hàng
                </a>
            }
            else
            {
                <a asp-action="Invoice" asp-route-id="@order.Id" target="_blank"
                   class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-800 sm:text-sm">
                    Xuất hóa đơn (in / PDF)
                </a>
            }
            @if (isOrg && OrderPaymentStatusDisplay.CanPayDeposit(order.PaymentStatus, order.AnnexPdfUrl))
            {
                <form asp-controller="OrganizationMealOrder" asp-action="PayDeposit" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 px-4 py-2.5 text-xs font-black text-white shadow-lg sm:text-sm">
                        <i data-lucide="credit-card" class="h-4 w-4"></i> Thanh toán đặt cọc
                    </button>
                </form>
            }
            @if (placeMealLink != null)
            {
                <a asp-controller="@placeMealLink.Controller" asp-action="@placeMealLink.Action" asp-all-route-data="@placeMealLink.RouteValues"
                   class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 px-4 py-2.5 text-xs font-black text-white shadow-lg sm:text-sm">
                    <i data-lucide="utensils" class="h-4 w-4"></i> @OrderMealPlacementDisplay.ButtonLabel
                </a>
            }
            <a asp-action="Orders" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50 sm:text-sm">Danh sách đơn</a>
        </div>

        <div class="space-y-3 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm text-sm">
            <div class="flex justify-between border-b border-slate-100 py-2"><span class="text-slate-500">Ngày đặt</span><span class="font-bold">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span></div>
            <div class="flex justify-between border-b border-slate-100 py-2"><span class="text-slate-500">Ngày giao dự kiến</span><span class="font-bold">@order.ScheduledDate.ToString("dd/MM/yyyy")</span></div>
            <div class="flex justify-between border-b border-slate-100 py-2">
                <span class="text-slate-500">Trạng thái</span>
                <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-bold @OrderStatusHelper.BadgeClass(order.Status)">
                    @OrderStatusHelper.ToDisplay(order.Status)
                </span>
            </div>
            <div class="flex justify-between py-2">
                <span class="text-slate-500">Thanh toán</span>
                <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-black @OrderPaymentStatusDisplay.BadgeClass(order.PaymentStatus)">
                    @OrderPaymentStatusDisplay.Label(order.PaymentStatus)
                </span>
            </div>
        </div>

        <h2 class="mb-2 mt-8 text-lg font-black text-slate-900">Món trong đơn</h2>
        <ul class="divide-y divide-slate-100 rounded-2xl border border-slate-100 bg-white shadow-sm">
            @foreach (var it in order.Items)
            {
                <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
                    <span class="font-medium text-slate-800">@it.DishName</span>
                    <span class="text-slate-600">x @it.Quantity</span>
                    <span class="font-bold text-orange-600">@it.TotalPrice.ToString("N0") đ</span>
                </li>
            }
        </ul>
        <p class="mt-4 text-right text-lg font-black text-slate-900">Tổng: @order.TotalAmount.ToString("N0") đ</p>

        @if (!string.IsNullOrEmpty(sig))
        {
            <div class="mt-8 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">Chữ ký xác nhận đã lưu</p>
                <img src="@sig" alt="Chữ ký" class="max-h-40 rounded-lg border border-slate-100 bg-slate-50" />
            </div>
        }
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) lucide.createIcons();
        @if (isOrg && isDelivered && !Model.IsPeriodBased)
        {
            @:fetch('@Url.Action("DeliveryOtp", "Profile")?orderId=@order.Id')
            @:  .then(function (r) { return r.ok ? r.json() : null; })
            @:  .then(function (d) {
            @:    if (!d || !d.isActive || !d.deliveryOtp) return;
            @:  }).catch(function () {});
        }
    });
</script>
