@{
    ViewData["Title"] = "Khiếu nại của tôi";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

@Html.AntiForgeryToken()
<div class="max-w-5xl mx-auto px-4 py-10" x-data="orgComplaintList()">
    <nav class="mb-6 text-sm text-gray-500">
        <a href="/Profile/Orders" class="font-medium hover:text-orange-600">Đơn hàng</a>
        <span class="mx-2">/</span>
        <span class="text-gray-800 font-bold">Khiếu nại</span>
    </nav>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-black text-gray-900">Khiếu nại đơn hàng</h1>
            <p class="text-sm text-gray-500 mt-1">Chỉ áp dụng đơn đã giao — trong vòng 24 giờ kể từ lúc giao.</p>
        </div>
        <a href="/Profile/Orders" class="inline-flex items-center gap-2 rounded-xl bg-orange-500 px-4 py-2 text-sm font-bold text-white hover:bg-orange-600">
            Chọn đơn để khiếu nại
        </a>
    </div>

    <div x-show="loadError" class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" x-text="loadError"></div>
    <div x-show="loading" class="text-center py-12 text-gray-400">Đang tải...</div>

    <div class="space-y-3" x-show="!loading">
        <template x-for="c in items" :key="c.id">
            <a :href="'/Profile/ComplaintDetail/' + c.id" class="block bg-white rounded-2xl border border-gray-100 p-5 shadow-sm hover:border-orange-200 transition-colors">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="font-black text-gray-900" x-text="c.code || ('#' + c.id)"></span>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full border" :class="statusClass(c.status)" x-text="statusLabel(c.status)"></span>
                </div>
                <p class="text-sm font-bold text-gray-700 mt-1" x-text="reasonLabel(c.reason)"></p>
                <p class="text-xs text-gray-500 mt-2">Đơn #<span x-text="c.orderId"></span> · <span x-text="formatDate(c.submittedAt || c.createdAt)"></span></p>
                <p x-show="c.finalRefundAmount" class="text-sm font-bold text-emerald-600 mt-2">Hoàn: <span x-text="formatMoney(c.finalRefundAmount)"></span></p>
            </a>
        </template>
        <div x-show="items.length === 0" class="text-center py-16 rounded-2xl border border-dashed border-gray-200 text-gray-500">
            Chưa có khiếu nại. Từ đơn đã giao, bấm <strong>Khiếu nại</strong> trong vòng 24h.
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('orgComplaintList', () => ({
        items: [], loading: true, loadError: '',
        init() { this.load(); },
        statusLabel(s) { const m = { draft: 'Nháp', pending_review: 'Chờ duyệt', resolved: 'Đã xử lý', rejected: 'Từ chối' }; return m[(s||'').toLowerCase()] || s; },
        statusClass(s) { const m = { draft: 'bg-slate-100 text-slate-700', pending_review: 'bg-amber-50 text-amber-800', resolved: 'bg-emerald-50 text-emerald-800', rejected: 'bg-red-50 text-red-800' }; return m[(s||'').toLowerCase()] || ''; },
        reasonLabel(r) { const m = { missing_portions: 'Thiếu suất', spoiled_rice: 'Cơm hỏng', wrong_dish: 'Sai món', food_quality: 'Chất lượng' }; return m[(r||'').toLowerCase()] || r; },
        formatDate(iso) { if (!iso) return ''; const d = new Date(iso); return isNaN(d) ? '' : d.toLocaleString('vi-VN'); },
        formatMoney(n) { return new Intl.NumberFormat('vi-VN').format(n) + ' đ'; },
        async load() {
            this.loading = true;
            try {
                const res = await fetch('@Url.Action("ComplaintListJson", "Profile")');
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || 'Lỗi');
                this.items = data.data || [];
            } catch (e) { this.loadError = e.message; }
            finally { this.loading = false; }
        }
    }));
});
</script>
}
