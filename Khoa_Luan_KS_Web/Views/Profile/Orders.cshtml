@model Khoa_Luan_KS_Web.Services.GetOrdersClientResponse
@using Khoa_Luan_KS_Web.Helpers
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var orders = Model?.Items ?? new List<Khoa_Luan_KS_Web.Services.OrderDetailClientDto>();
    var isOrg = User.IsInRole("Organization") || User.IsInRole("Company") || User.IsInRole("Khách hàng doanh nghiệp");
}

<style>
    .orders-table .status-badge,
    .orders-table .payment-badge {
        white-space: nowrap;
    }
</style>

<div class="max-w-7xl mx-auto px-6 py-12">
    <nav class="mb-6 flex text-sm text-gray-500" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/Customer/Index" class="flex items-center gap-1 font-medium transition hover:text-orange-500">
                    <i data-lucide="home" class="h-4 w-4"></i> Trang chủ
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <i data-lucide="chevron-right" class="h-4 w-4 text-gray-300"></i>
                    <span class="ml-1 font-medium text-gray-700 md:ml-2">Lịch sử đơn hàng</span>
                </div>
            </li>
        </ol>
    </nav>

    @if (TempData["OrderSuccess"] is string ok && !string.IsNullOrEmpty(ok))
    {
        <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900">@ok</div>
    }
    @if (TempData["OrgMealError"] is string ome && !string.IsNullOrEmpty(ome))
    {
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800">@ome</div>
    }
    @if (TempData["Error"] is string err && !string.IsNullOrEmpty(err))
    {
        <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">@err</div>
    }

    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900">Đơn hàng của tôi</h1>
        <div class="flex flex-wrap gap-2">
            @if (isOrg)
            {
                <a asp-controller="OrganizationMealOrder" asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-orange-200 bg-orange-50 px-4 py-2 text-sm font-bold text-orange-800 hover:bg-orange-100">
                    Đặt suất doanh nghiệp
                </a>
            }
            <a asp-controller="Menu" asp-action="Index" class="inline-flex items-center gap-2 rounded-xl bg-orange-500 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-orange-600">
                Đặt thêm từ thực đơn
            </a>
        </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="orders-table w-full min-w-[960px] border-collapse text-left">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 text-[11px] font-bold uppercase tracking-wider text-gray-500">
                        <th class="px-4 py-4 lg:px-6">Mã đơn</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Ngày đặt</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Ngày giao dự kiến</th>
                        <th class="px-4 py-4 text-right whitespace-nowrap lg:px-6">Tổng (VND)</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Trạng thái</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Thanh toán</th>
                        <th class="min-w-[220px] px-4 py-4 text-right lg:px-6">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (!orders.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                                Chưa có đơn nào.
                                @if (isOrg)
                                {
                                    <a asp-controller="OrganizationMealOrder" asp-action="Index" class="font-bold text-orange-600 hover:text-orange-700">Đặt suất doanh nghiệp</a>
                                }
                                else
                                {
                                    <a asp-controller="Menu" asp-action="Index" class="font-bold text-orange-600 hover:text-orange-700">Xem thực đơn</a>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in orders)
                        {
                            var signedPdfUrl = OrderSignedDocumentHelper.GetSignedPdfUrl(o);
                            <tr class="transition-colors hover:bg-gray-50/80">
                                <td class="px-6 py-4 font-bold text-gray-900">@(string.IsNullOrEmpty(o.InvoiceCode) ? "#" + o.Id : o.InvoiceCode)</td>
                                <td class="px-6 py-4 text-gray-600">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-6 py-4 text-gray-600">@o.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-4 text-right font-bold text-orange-600">@o.TotalAmount.ToString("N0")</td>
                                <td class="px-4 py-4 lg:px-6">
                                    <span class="status-badge inline-flex shrink-0 rounded-md border px-2.5 py-1 text-xs font-bold whitespace-nowrap @OrderStatusHelper.BadgeClass(o.Status)">
                                        @OrderStatusHelper.ToDisplay(o.Status)
                                    </span>
                                </td>
                                <td class="px-4 py-4 lg:px-6">
                                    <span class="payment-badge inline-flex shrink-0 rounded-full px-2.5 py-1 text-xs font-bold whitespace-nowrap @OrderPaymentStatusDisplay.BadgeClass(o.PaymentStatus)">
                                        @OrderPaymentStatusDisplay.Label(o.PaymentStatus)
                                    </span>
                                </td>
                                <td class="px-4 py-4 lg:px-6">
                                    @{
                                        var canPayDeposit = isOrg && OrderPaymentStatusDisplay.CanPayDeposit(o.PaymentStatus, o.AnnexPdfUrl);
                                        var showSignAnnex = isOrg && string.Equals(o.PaymentStatus, "unpaid", StringComparison.OrdinalIgnoreCase) && string.IsNullOrEmpty(o.AnnexPdfUrl);
                                        var canCancel = OrderCustomerCancelDisplay.CanCancel(o.Status, o.PaymentStatus, o.ScheduledDate);
                                        var hasPrimaryActions = canPayDeposit || showSignAnnex || canCancel;
                                    }
                                    <div class="flex flex-col items-end gap-2">
                                        @if (hasPrimaryActions)
                                        {
                                            <div class="flex flex-wrap items-center justify-end gap-2">
                                                @if (canPayDeposit)
                                                {
                                                    <form asp-controller="OrganizationMealOrder" asp-action="PayDeposit" method="post" class="inline-flex m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@o.Id" />
                                                        <button type="submit" class="inline-flex items-center gap-1 rounded-lg bg-gradient-to-r from-orange-500 to-amber-500 px-3 py-1.5 text-xs font-black text-white shadow hover:from-orange-600 hover:to-amber-600 whitespace-nowrap">
                                                            <i data-lucide="credit-card" class="h-3.5 w-3.5 shrink-0"></i> Thanh toán cọc
                                                        </button>
                                                    </form>
                                                }
                                                else if (showSignAnnex)
                                                {
                                                    <a asp-action="Contracts" asp-route-orderId="@o.Id"
                                                       class="inline-flex items-center rounded-lg border border-violet-200 bg-violet-50 px-3 py-1.5 text-xs font-bold text-violet-800 hover:bg-violet-100 whitespace-nowrap">
                                                        Ký phụ lục
                                                    </a>
                                                }
                                                @if (canCancel)
                                                {
                                                    <form asp-action="CancelOrder" method="post" class="inline-flex m-0"
                                                          onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn @(string.IsNullOrEmpty(o.InvoiceCode) ? "#" + o.Id : o.InvoiceCode)? Hành động này không thể hoàn tác.');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@o.Id" />
                                                        <input type="hidden" name="page" value="@(Model?.Page ?? 1)" />
                                                        <button type="submit" class="inline-flex items-center gap-1 rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700 hover:bg-red-100 whitespace-nowrap">
                                                            <i data-lucide="x-circle" class="h-3.5 w-3.5 shrink-0"></i> Hủy đơn
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                        <div class="flex flex-wrap items-center justify-end gap-x-2 gap-y-1 text-xs">
                                            <a asp-action="OrderDetail" asp-route-id="@o.Id" class="font-bold text-orange-600 hover:text-orange-800 whitespace-nowrap">Chi tiết</a>
                                            @if (isOrg && string.Equals(o.Status, "delivered", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-gray-300 select-none" aria-hidden="true">|</span>
                                                <a asp-action="ComplaintCreate" asp-route-orderId="@o.Id" class="font-bold text-red-600 hover:text-red-800 whitespace-nowrap" title="Trong vòng 24h sau khi giao">Khiếu nại</a>
                                            }
                                            <span class="text-gray-300 select-none" aria-hidden="true">|</span>
                                            @if (!string.IsNullOrEmpty(signedPdfUrl))
                                            {
                                                <a href="@signedPdfUrl" target="_blank" rel="noopener" class="font-bold text-slate-600 hover:text-slate-900 whitespace-nowrap">Hóa đơn</a>
                                            }
                                            else if (isOrg)
                                            {
                                                <a asp-action="Contracts" asp-route-orderId="@o.Id" class="font-bold text-slate-600 hover:text-slate-900 whitespace-nowrap" title="Ký phụ lục để tạo PDF">Hóa đơn</a>
                                            }
                                            else
                                            {
                                                <a asp-action="Invoice" asp-route-id="@o.Id" target="_blank" class="font-bold text-slate-600 hover:text-slate-900 whitespace-nowrap">Hóa đơn</a>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (Model != null && Model.TotalCount > Model.PageSize)
        {
            <div class="border-t border-gray-100 bg-gray-50/50 px-6 py-3 text-sm text-gray-600">
                Trang @Model.Page — tổng @Model.TotalCount đơn (hiển thị tối đa @Model.PageSize mỗi trang).
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) lucide.createIcons();
    });
</script>
