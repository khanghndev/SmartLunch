@model Khoa_Luan_KS_Web.Models.ProfileOrdersPageVm
@using Khoa_Luan_KS_Web.Helpers
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var orders = Model?.Orders?.Items ?? new List<Khoa_Luan_KS_Web.Services.OrderDetailClientDto>();
    var totalCount = Model?.Orders?.TotalCount ?? 0;
    var pageSize = Model?.Orders?.PageSize > 0 ? Model.Orders.PageSize : 20;
    var currentPage = Model?.Page ?? 1;
    var totalPages = pageSize > 0 ? Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize)) : 1;
    var hasFilters = !string.IsNullOrWhiteSpace(Model?.FilterStatus)
        || !string.IsNullOrWhiteSpace(Model?.FilterPaymentStatus)
        || !string.IsNullOrWhiteSpace(Model?.Search)
        || Model?.ScheduledOn != null;
    var isOrg = User.IsInRole("Organization") || User.IsInRole("Company") || User.IsInRole("Khách hàng doanh nghiệp");
    var todayVn = OrganizationMealContractDateRules.TodayVietnam();
}

<style>
    .orders-table .status-badge,
    .orders-table .payment-badge {
        white-space: nowrap;
    }
</style>

<div class="max-w-7xl mx-auto px-6 py-12">
    <nav class="mb-6 flex text-sm text-gray-500" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/Customer/Index" class="flex items-center gap-1 font-medium transition hover:text-orange-500">
                    <i data-lucide="home" class="h-4 w-4"></i> Trang chủ
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <i data-lucide="chevron-right" class="h-4 w-4 text-gray-300"></i>
                    <span class="ml-1 font-medium text-gray-700 md:ml-2">Lịch sử đơn hàng</span>
                </div>
            </li>
        </ol>
    </nav>

    @if (TempData["OrderSuccess"] is string ok && !string.IsNullOrEmpty(ok))
    {
        <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900">@ok</div>
    }
    @if (TempData["OrgMealError"] is string ome && !string.IsNullOrEmpty(ome))
    {
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800">@ome</div>
    }
    @if (TempData["Error"] is string err && !string.IsNullOrEmpty(err))
    {
        <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">@err</div>
    }

    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900">Đơn hàng của tôi</h1>
        <div class="flex flex-wrap gap-2">
            @if (isOrg)
            {
                <a asp-controller="OrganizationMealOrder" asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-orange-200 bg-orange-50 px-4 py-2 text-sm font-bold text-orange-800 hover:bg-orange-100">
                    Đặt suất doanh nghiệp
                </a>
            }
            <a asp-controller="Menu" asp-action="Index" class="inline-flex items-center gap-2 rounded-xl bg-orange-500 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-orange-600">
                Đặt thêm từ thực đơn
            </a>
        </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm">
        <form method="get" asp-action="Orders" class="border-b border-gray-100 bg-gray-50/80 px-4 py-4 lg:px-6">
            <input type="hidden" name="page" value="1" />
            <div class="flex flex-col gap-4 lg:flex-row lg:flex-wrap lg:items-end">
                <div class="min-w-[200px] flex-1">
                    <label class="mb-1 block text-[11px] font-bold uppercase tracking-wide text-gray-500">Tìm mã đơn</label>
                    <input type="text" name="search" value="@Model?.Search" placeholder="Mã HĐ, #ID đơn..."
                           class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-400" />
                </div>
                <div>
                    <label class="mb-1 block text-[11px] font-bold uppercase tracking-wide text-gray-500">Trạng thái đơn</label>
                    <select name="status" class="min-w-[160px] rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium outline-none focus:border-orange-400">
                        <option value="">Tất cả</option>
                        <option value="pending" selected="@(Model?.FilterStatus == "pending")">Chờ xác nhận</option>
                        <option value="confirmed" selected="@(Model?.FilterStatus == "confirmed")">Đã xác nhận</option>
                        <option value="preparing" selected="@(Model?.FilterStatus == "preparing")">Đang chuẩn bị</option>
                        <option value="delivered" selected="@(Model?.FilterStatus == "delivered")">Đã giao hàng</option>
                        <option value="cancelled" selected="@(Model?.FilterStatus == "cancelled")">Đã hủy</option>
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-[11px] font-bold uppercase tracking-wide text-gray-500">Thanh toán</label>
                    <select name="paymentStatus" class="min-w-[180px] rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium outline-none focus:border-orange-400">
                        <option value="">Tất cả</option>
                        <option value="unpaid" selected="@(Model?.FilterPaymentStatus == "unpaid")">Chưa thanh toán</option>
                        <option value="awaiting_payment" selected="@(Model?.FilterPaymentStatus == "awaiting_payment")">Chờ thanh toán cọc</option>
                        <option value="deposit_paid" selected="@(Model?.FilterPaymentStatus == "deposit_paid")">Đã đặt cọc</option>
                        <option value="partial" selected="@(Model?.FilterPaymentStatus == "partial")">Thanh toán một phần</option>
                        <option value="paid" selected="@(Model?.FilterPaymentStatus == "paid")">Đã thanh toán đủ</option>
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-[11px] font-bold uppercase tracking-wide text-gray-500">Ngày giao dự kiến</label>
                    <input type="date" name="scheduledOn" value="@(Model?.ScheduledOn?.ToString("yyyy-MM-dd"))"
                           class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium outline-none focus:border-orange-400" />
                </div>
                <div class="flex flex-wrap gap-2">
                    <button type="submit" class="rounded-lg bg-orange-500 px-4 py-2 text-sm font-bold text-white hover:bg-orange-600">Lọc</button>
                    @if (hasFilters)
                    {
                        <a asp-action="Orders" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-bold text-gray-600 hover:bg-gray-50">Xóa lọc</a>
                    }
                </div>
            </div>
            @if (hasFilters && totalCount > 0)
            {
                <p class="mt-3 text-xs text-gray-500">Tìm thấy <span class="font-bold text-gray-700">@totalCount</span> đơn phù hợp — sắp xếp mới nhất trước.</p>
            }
        </form>

        <div class="overflow-x-auto">
            <table class="orders-table w-full min-w-[960px] border-collapse text-left">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 text-[11px] font-bold uppercase tracking-wider text-gray-500">
                        <th class="px-4 py-4 lg:px-6">Mã đơn</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Ngày đặt</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Ngày giao dự kiến</th>
                        <th class="px-4 py-4 text-right whitespace-nowrap lg:px-6">Tổng (VND)</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Trạng thái</th>
                        <th class="px-4 py-4 whitespace-nowrap lg:px-6">Thanh toán</th>
                        <th class="min-w-[220px] px-4 py-4 text-right lg:px-6">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (!orders.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                                @(hasFilters ? "Không có đơn phù hợp bộ lọc." : "Chưa có đơn nào.")
                                @if (!hasFilters)
                                {
                                    if (isOrg)
                                    {
                                        <a asp-controller="OrganizationMealOrder" asp-action="Index" class="font-bold text-orange-600 hover:text-orange-700">Đặt suất doanh nghiệp</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Menu" asp-action="Index" class="font-bold text-orange-600 hover:text-orange-700">Xem thực đơn</a>
                                    }
                                }
                                else
                                {
                                    <a asp-action="Orders" class="ml-1 font-bold text-orange-600 hover:text-orange-700">Xem tất cả đơn</a>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in orders)
                        {
                            var signedPdfUrl = OrderSignedDocumentHelper.GetSignedPdfUrl(o);
                            <tr class="transition-colors hover:bg-gray-50/80">
                                <td class="px-6 py-4 font-bold text-gray-900">@(string.IsNullOrEmpty(o.InvoiceCode) ? "#" + o.Id : o.InvoiceCode)</td>
                                <td class="px-6 py-4 text-gray-600">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-6 py-4 text-gray-600">@o.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-4 text-right font-bold text-orange-600">@o.TotalAmount.ToString("N0")</td>
                                <td class="px-4 py-4 lg:px-6">
                                    <span class="status-badge inline-flex shrink-0 rounded-md border px-2.5 py-1 text-xs font-bold whitespace-nowrap @OrderStatusHelper.BadgeClass(o.Status)">
                                        @OrderStatusHelper.ToDisplay(o.Status)
                                    </span>
                                </td>
                                <td class="px-4 py-4 lg:px-6">
                                    <span class="payment-badge inline-flex shrink-0 rounded-full px-2.5 py-1 text-xs font-bold whitespace-nowrap @OrderPaymentStatusDisplay.BadgeClass(o.PaymentStatus)">
                                        @OrderPaymentStatusDisplay.Label(o.PaymentStatus)
                                    </span>
                                </td>
                                <td class="px-4 py-4 lg:px-6">
                                    @{
                                        var canPayDeposit = isOrg && OrderPaymentStatusDisplay.CanPayDeposit(o.PaymentStatus, o.AnnexPdfUrl);
                                        var showSignAnnex = isOrg && string.Equals(o.PaymentStatus, "unpaid", StringComparison.OrdinalIgnoreCase) && string.IsNullOrEmpty(o.AnnexPdfUrl);
                                        var canCancel = OrderCustomerCancelDisplay.CanCancel(o.Status, o.PaymentStatus, o.ScheduledDate);
                                        var placeMealLink = OrderMealPlacementDisplay.TryGetPlaceMealLink(o, isOrg, todayVn);
                                        var hasPrimaryActions = canPayDeposit || showSignAnnex || canCancel;
                                    }
                                    <div class="flex flex-col items-end gap-2">
                                        @if (hasPrimaryActions)
                                        {
                                            <div class="flex flex-wrap items-center justify-end gap-2">
                                                @if (canPayDeposit)
                                                {
                                                    <form asp-controller="OrganizationMealOrder" asp-action="PayDeposit" method="post" class="inline-flex m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@o.Id" />
                                                        <button type="submit" class="inline-flex items-center gap-1 rounded-lg bg-gradient-to-r from-orange-500 to-amber-500 px-3 py-1.5 text-xs font-black text-white shadow hover:from-orange-600 hover:to-amber-600 whitespace-nowrap">
                                                            <i data-lucide="credit-card" class="h-3.5 w-3.5 shrink-0"></i> Thanh toán cọc
                                                        </button>
                                                    </form>
                                                }
                                                else if (showSignAnnex)
                                                {
                                                    <a asp-action="Contracts" asp-route-orderId="@o.Id"
                                                       class="inline-flex items-center rounded-lg border border-violet-200 bg-violet-50 px-3 py-1.5 text-xs font-bold text-violet-800 hover:bg-violet-100 whitespace-nowrap">
                                                        Ký phụ lục
                                                    </a>
                                                }
                                                @if (canCancel)
                                                {
                                                    <form asp-action="CancelOrder" method="post" class="inline-flex m-0"
                                                          onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn @(string.IsNullOrEmpty(o.InvoiceCode) ? "#" + o.Id : o.InvoiceCode)? Hành động này không thể hoàn tác.');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@o.Id" />
                                                        <input type="hidden" name="page" value="@currentPage" />
                                                        <input type="hidden" name="status" value="@Model?.FilterStatus" />
                                                        <input type="hidden" name="paymentStatus" value="@Model?.FilterPaymentStatus" />
                                                        <input type="hidden" name="search" value="@Model?.Search" />
                                                        @if (Model?.ScheduledOn != null)
                                                        {
                                                            <input type="hidden" name="scheduledOn" value="@Model.ScheduledOn.Value.ToString("yyyy-MM-dd")" />
                                                        }
                                                        <button type="submit" class="inline-flex items-center gap-1 rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700 hover:bg-red-100 whitespace-nowrap">
                                                            <i data-lucide="x-circle" class="h-3.5 w-3.5 shrink-0"></i> Hủy đơn
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                        <div class="flex flex-wrap items-center justify-end gap-x-2 gap-y-1 text-xs">
                                            <a asp-action="OrderDetail" asp-route-id="@o.Id" class="font-bold text-orange-600 hover:text-orange-800 whitespace-nowrap">Chi tiết</a>
                                            @if (isOrg && string.Equals(o.Status, "delivered", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-gray-300 select-none" aria-hidden="true">|</span>
                                                <a asp-action="ComplaintCreate" asp-route-orderId="@o.Id" class="font-bold text-red-600 hover:text-red-800 whitespace-nowrap" title="Trong vòng 24h sau khi giao">Khiếu nại</a>
                                            }
                                            <span class="text-gray-300 select-none" aria-hidden="true">|</span>
                                            @if (!string.IsNullOrEmpty(signedPdfUrl))
                                            {
                                                <a href="@signedPdfUrl" target="_blank" rel="noopener" class="font-bold text-slate-600 hover:text-slate-900 whitespace-nowrap">Hóa đơn</a>
                                            }
                                            else if (isOrg)
                                            {
                                                <a asp-action="Contracts" asp-route-orderId="@o.Id" class="font-bold text-slate-600 hover:text-slate-900 whitespace-nowrap" title="Ký phụ lục để tạo PDF">Hóa đơn</a>
                                            }
                                            else
                                            {
                                                <a asp-action="Invoice" asp-route-id="@o.Id" target="_blank" class="font-bold text-slate-600 hover:text-slate-900 whitespace-nowrap">Hóa đơn</a>
                                            }
                                            @if (placeMealLink != null)
                                            {
                                                <span class="text-gray-300 select-none" aria-hidden="true">|</span>
                                                <a asp-controller="@placeMealLink.Controller"
                                                   asp-action="@placeMealLink.Action"
                                                   asp-all-route-data="@placeMealLink.RouteValues"
                                                   class="inline-flex items-center gap-1 rounded-md bg-gradient-to-r from-orange-500 to-amber-500 px-2.5 py-1 text-[11px] font-black text-white shadow-sm hover:from-orange-600 hover:to-amber-600 whitespace-nowrap"
                                                   title="@placeMealLink.Title">
                                                    <i data-lucide="utensils" class="h-3 w-3 shrink-0"></i>
                                                    @OrderMealPlacementDisplay.ButtonLabel
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (totalCount > pageSize)
        {
            var pageNumbers = new List<int?>();
            if (totalPages <= 7)
            {
                for (int i = 1; i <= totalPages; i++)
                {
                    pageNumbers.Add(i);
                }
            }
            else
            {
                if (currentPage <= 4)
                {
                    for (int i = 1; i <= 5; i++)
                    {
                        pageNumbers.Add(i);
                    }
                    pageNumbers.Add(null); // "..."
                    pageNumbers.Add(totalPages);
                }
                else if (currentPage >= totalPages - 3)
                {
                    pageNumbers.Add(1);
                    pageNumbers.Add(null); // "..."
                    for (int i = totalPages - 4; i <= totalPages; i++)
                    {
                        pageNumbers.Add(i);
                    }
                }
                else
                {
                    pageNumbers.Add(1);
                    pageNumbers.Add(null); // "..."
                    pageNumbers.Add(currentPage - 1);
                    pageNumbers.Add(currentPage);
                    pageNumbers.Add(currentPage + 1);
                    pageNumbers.Add(null); // "..."
                    pageNumbers.Add(totalPages);
                }
            }

            <div class="flex flex-col items-center justify-between gap-3 border-t border-gray-100 bg-gray-50/50 px-6 py-4 text-sm text-gray-600 sm:flex-row">
                <span>Trang @currentPage / @totalPages — tổng @totalCount đơn</span>
                <div class="flex items-center gap-1.5">
                    @if (currentPage > 1)
                    {
                        <a asp-action="Orders" asp-route-page="@(currentPage - 1)" asp-route-status="@Model?.FilterStatus" asp-route-paymentStatus="@Model?.FilterPaymentStatus" asp-route-search="@Model?.Search" asp-route-scheduledOn="@Model?.ScheduledOn?.ToString("yyyy-MM-dd")"
                           class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-bold text-gray-700 hover:bg-gray-100 transition-colors">← Trước</a>
                    }
                    else
                    {
                        <span class="rounded-lg border border-gray-100 bg-gray-50 px-3 py-1.5 text-xs font-bold text-gray-400 cursor-not-allowed select-none">← Trước</span>
                    }

                    @foreach (var p in pageNumbers)
                    {
                        if (p == null)
                        {
                            <span class="px-2 py-1.5 text-xs font-bold text-gray-400 select-none">...</span>
                        }
                        else if (p == currentPage)
                        {
                            <span class="rounded-lg border border-orange-500 bg-orange-500 px-3 py-1.5 text-xs font-bold text-white select-none">@p</span>
                        }
                        else
                        {
                            <a asp-action="Orders" asp-route-page="@p" asp-route-status="@Model?.FilterStatus" asp-route-paymentStatus="@Model?.FilterPaymentStatus" asp-route-search="@Model?.Search" asp-route-scheduledOn="@Model?.ScheduledOn?.ToString("yyyy-MM-dd")"
                               class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-bold text-gray-700 hover:bg-gray-100 transition-colors">@p</a>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-action="Orders" asp-route-page="@(currentPage + 1)" asp-route-status="@Model?.FilterStatus" asp-route-paymentStatus="@Model?.FilterPaymentStatus" asp-route-search="@Model?.Search" asp-route-scheduledOn="@Model?.ScheduledOn?.ToString("yyyy-MM-dd")"
                           class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-bold text-gray-700 hover:bg-gray-100 transition-colors">Sau →</a>
                    }
                    else
                    {
                        <span class="rounded-lg border border-gray-100 bg-gray-50 px-3 py-1.5 text-xs font-bold text-gray-400 cursor-not-allowed select-none">Sau →</span>
                    }
                </div>
            </div>
        }
        else if (totalCount > 0)
        {
            <div class="border-t border-gray-100 bg-gray-50/50 px-6 py-3 text-xs text-gray-500">
                @totalCount đơn — mới nhất hiển thị trước.
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) lucide.createIcons();
    });
</script>
