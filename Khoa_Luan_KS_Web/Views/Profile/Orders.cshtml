@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="max-w-7xl mx-auto px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/Customer/Index" class="hover:text-orange-500 font-medium transition flex items-center gap-1">
                    <i data-lucide="home" class="w-4 h-4"></i> Trang chủ
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300"></i>
                    <span class="ml-1 md:ml-2 font-medium text-gray-700">Lịch sử đơn hàng</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Lịch sử Báo suất (Đơn hàng)</h1>
        
        <!-- Filters -->
        <div class="flex gap-2">
            <select class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 bg-white font-medium text-gray-700">
                <option>Tháng này (04/2026)</option>
                <option>Tháng trước</option>
                <option>Tất cả thời gian</option>
            </select>
            <select class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 bg-white font-medium text-gray-700">
                <option>Tất cả trạng thái</option>
                <option>Đã giao đủ</option>
                <option>Đang duyệt</option>
                <option>Đã hủy</option>
            </select>
        </div>
    </div>

    <div class="flex flex-col md:flex-row gap-8 items-stretch">
        <!-- Sidebar Navigation -->
        <div class="w-full md:w-64 flex-shrink-0">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 h-full">
                <div class="flex items-center gap-3 mb-6 pb-6 border-b border-gray-100">
                    <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center text-orange-600 font-bold text-xl shadow-sm">
                        K
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900">TRƯỜNG THPT HOÀNG VĂN THỤ</h3>
                        <p class="text-xs text-gray-500">Khách hàng Doanh nghiệp</p>
                    </div>
                </div>

                <nav class="space-y-1 text-sm font-medium">
                    <a href="/Profile/Index" class="flex items-center gap-3 px-3 py-2.5 text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-lg transition-colors">
                        <i data-lucide="user" class="w-4 h-4 text-gray-400"></i> Hồ sơ doanh nghiệp
                    </a>
                    <a href="/Profile/Orders" class="flex items-center gap-3 px-3 py-2.5 bg-orange-50 text-orange-700 rounded-lg transition-colors">
                        <i data-lucide="shopping-bag" class="w-4 h-4"></i> Lịch sử đơn hàng
                    </a>
                    <a href="/Profile/Contracts" class="flex items-center gap-3 px-3 py-2.5 text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-lg transition-colors">
                        <i data-lucide="file-signature" class="w-4 h-4 text-gray-400"></i> Hợp đồng điện tử
                    </a>
                </nav>
            </div>
        </div>

        <div class="flex-1 flex flex-col">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex-1">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-100 text-[11px] text-gray-500 uppercase tracking-wider font-bold">
                                <th class="px-6 py-4">Mã Phiếu Báo</th>
                                <th class="px-6 py-4">Thời Gian Giao Suất</th>
                                <th class="px-6 py-4 text-right">TK Cơm NV</th>
                                <th class="px-6 py-4 text-right">TK Suất VIP</th>
                                <th class="px-6 py-4 text-right">Thành Tiền (VND)</th>
                                <th class="px-6 py-4">Trạng Thái</th>
                                <th class="px-6 py-4 text-center">Tác Vụ</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm divide-y divide-gray-100">
                            <!-- Phiếu đang mở -->
                            <tr class="hover:bg-gray-50/50 transition-colors bg-orange-50/20">
                                <td class="px-6 py-4 font-bold text-gray-900">#PX-260401</td>
                                <td class="px-6 py-4"><span class="font-medium text-gray-900">Ngày Mai</span> - 26/04/2026</td>
                                <td class="px-6 py-4 text-right font-bold text-gray-900">1,250</td>
                                <td class="px-6 py-4 text-right font-bold text-gray-900">15</td>
                                <td class="px-6 py-4 text-right font-bold text-orange-600">~ 31,400,000</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-amber-100 text-amber-800">
                                        Hệ thống Đang chốt
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <a href="#" class="inline-flex items-center gap-1 text-sm font-bold text-orange-600 hover:text-orange-800 transition">Điều chỉnh báo suất</a>
                                </td>
                            </tr>
                            <!-- Phiếu hôm trước -->
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 font-bold text-gray-900">#PX-250400</td>
                                <td class="px-6 py-4 text-gray-600">Hôm nay - 25/04/2026</td>
                                <td class="px-6 py-4 text-right font-medium text-gray-900">1,310</td>
                                <td class="px-6 py-4 text-right font-medium text-gray-900">10</td>
                                <td class="px-6 py-4 text-right font-bold text-gray-900">32,750,000</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-green-100 text-green-800 border border-green-200">
                                        <i data-lucide="check" class="w-3 h-3"></i> Đã giao đủ
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <a href="#" class="inline-flex items-center gap-1 text-sm font-bold text-blue-600 hover:text-blue-800 transition">Xem chi tiết</a>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 font-bold text-gray-900">#PX-240499</td>
                                <td class="px-6 py-4 text-gray-600">Hôm qua - 24/04/2026</td>
                                <td class="px-6 py-4 text-right font-medium text-gray-900">1,100</td>
                                <td class="px-6 py-4 text-right font-medium text-gray-900">20</td>
                                <td class="px-6 py-4 text-right font-bold text-gray-900">27,500,000</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-green-100 text-green-800 border border-green-200">
                                        <i data-lucide="check" class="w-3 h-3"></i> Đã giao đủ
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <a href="#" class="inline-flex items-center gap-1 text-sm font-bold text-blue-600 hover:text-blue-800 transition">Xem chi tiết</a>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 font-bold text-gray-500 line-through">#PX-230498</td>
                                <td class="px-6 py-4 text-gray-400">Chủ Nhật - 23/04/2026</td>
                                <td class="px-6 py-4 text-right text-gray-400 font-medium">-</td>
                                <td class="px-6 py-4 text-right text-gray-400 font-medium">-</td>
                                <td class="px-6 py-4 text-right text-gray-400">-</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200">
                                        <i data-lucide="x" class="w-3 h-3"></i> Tạm ngưng
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="text-gray-400 text-xs font-medium">Lịch bảo trì NSX</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <div class="px-6 py-4 border-t border-gray-100 bg-gray-50/50 flex flex-col md:flex-row items-center justify-between gap-4">
                    <span class="text-sm font-medium text-gray-600">Đang hiển thị 1 đến 4 phần tử trong số 153 phiếu dự giao</span>
                    <div class="flex gap-1">
                        <button class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-gray-500 hover:bg-gray-50 disabled:opacity-50 font-medium bg-white" disabled>Trước</button>
                        <button class="px-3 py-1.5 bg-gray-800 text-white rounded-md text-sm font-bold shadow-sm">1</button>
                        <button class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-gray-700 hover:bg-gray-50 bg-white font-medium">2</button>
                        <button class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-gray-700 hover:bg-gray-50 bg-white font-medium">3</button>
                        <button class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-gray-700 hover:bg-gray-50 bg-white font-medium">Sau</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        if(window.lucide) {
            lucide.createIcons();
        }
    });
</script>
