###############################################
# SMARTLUNCH BACKEND SERVICE API
# HTTP Client Test File
###############################################
#
# HOW TO RUN THIS FILE:
# 1. Install REST Client extension in VS Code (humao.rest-client)
# 2. Make sure the backend service is running on http://localhost:5001
# 3. Click the "Send Request" button above each request, or use Ctrl+Alt+R
# 4. View responses in the output panel
#
# API VERSIONING:
# Controller route: api/v{version:apiVersion}/[controller] = api/v1/auth
# Both formats work (default version is v1.0):
#   - /api/auth/... (defaults to v1)
#   - /api/v1/auth/... (explicit version)
# This file uses explicit version format to match controller exactly
#
###############################################

@smartlunch_backend_HostAddress = http://localhost:5001

### Variables
@accessToken = 
@refreshToken = 
@firebaseIdToken = YOUR_FIREBASE_ID_TOKEN_HERE

###############################################
# AUTH ENDPOINTS
###############################################

### Register - Create new user account
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Password123!",
  "confirmPassword": "Password123!"
}

### Register - Invalid (password mismatch)
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "Password123!",
  "confirmPassword": "DifferentPassword123!"
}

### Register - Invalid (missing fields)
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "",
  "password": "",
  "confirmPassword": ""
}

###

### Login - Authenticate user
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "user@example.com",
  "password": "Password123!"
}

### Login - Invalid credentials
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "invalid@example.com",
  "password": "WrongPassword123!"
}

### Login - Missing fields
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "",
  "password": ""
}

###

###############################################
# FIREBASE LOGIN ENDPOINTS
###############################################
# 
# HOW TO GET FIREBASE ID TOKEN FOR TESTING:
# 
# Option 1: Using Test HTML Page (Recommended - Supports Google Login!)
# 1. Open test-firebase-login.html in your browser
# 2. Update Firebase config in the HTML file with your Firebase project config
# 3. Choose sign-in method:
#    - Click "Sign in with Google" button for Google OAuth login
#    - OR use Email/Password form for email-based login
# 4. After signing in, copy the Firebase ID Token displayed
# 5. Paste the token in @firebaseIdToken variable above
# 
# Option 2: Using Firebase Console
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Select your project: smartlunch-2b5a7
# 3. Go to Authentication > Users
# 4. Create a test user or use existing user
# 5. Use Firebase Web SDK to sign in and get ID token
# 
# Option 3: Using Firebase CLI
# 1. Install Firebase CLI: npm install -g firebase-tools
# 2. Login: firebase login
# 3. Use Firebase Auth REST API to get token
# 
# Option 4: Using Postman/Insomnia with Firebase Auth API
# POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=YOUR_API_KEY
# Body: { "email": "test@example.com", "password": "password", "returnSecureToken": true }
# Response will contain "idToken" field
#
# NOTE: Google Sign-In requires Firebase Authentication to be enabled with Google provider
# Configure in Firebase Console > Authentication > Sign-in method > Google
#
###############################################

### Firebase Login - Authenticate with Firebase ID token
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/firebase-login
Content-Type: application/json

{
  "idToken": "{{firebaseIdToken}}"
}

### Firebase Login - Invalid token
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/firebase-login
Content-Type: application/json

{
  "idToken": "invalid-firebase-token-here"
}

### Firebase Login - Missing token
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/firebase-login
Content-Type: application/json

{
  "idToken": ""
}

###

### Refresh Token - Get new access token using refresh token
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Refresh Token - Invalid refresh token
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "invalid-refresh-token-here"
}

### Refresh Token - Missing refresh token
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": ""
}

###

### Logout - Revoke access token (Requires Authorization)
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "token": "{{accessToken}}"
}

### Logout - Without Authorization header (should fail)
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/logout
Content-Type: application/json

{
  "token": "some-token-here"
}

### Logout - Invalid token
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/logout
Content-Type: application/json
Authorization: Bearer invalid-token

{
  "token": "invalid-token"
}

###

###############################################
# EXAMPLE WORKFLOW
###############################################

### Step 1: Register a new user
# @name register
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "SecurePassword123!",
  "confirmPassword": "SecurePassword123!"
}

### Step 2: Login with registered credentials
# @name login
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "newuser@example.com",
  "password": "SecurePassword123!"
}

### Step 3: Extract tokens from login response and use them
# After login, copy the accessToken and refreshToken from response
# Then update the variables at the top of this file:
# @accessToken = <paste-access-token-here>
# @refreshToken = <paste-refresh-token-here>

### Step 4: Use protected endpoint with access token
# GET {{smartlunch_backend_HostAddress}}/api/v1/some-protected-endpoint
# Authorization: Bearer {{accessToken}}

### Step 5: Refresh token when access token expires
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Step 6: Logout when done
POST {{smartlunch_backend_HostAddress}}/api/v1/auth/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "token": "{{accessToken}}"
}
