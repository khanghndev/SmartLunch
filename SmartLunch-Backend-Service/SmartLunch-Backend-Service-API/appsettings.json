{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/smartlunch-backend-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SmartLunch-Backend-Service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartLunchDatabase": "Server=localhost;Port=3307;Database=SmartLunch;User=root;Password=DevMySQLRoot@SmartLunch2026;"
  },
  "Database": {
    "ConnectionString": "",
    "AutoMigrate": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 30,
    "EnableQuerySplitting": true,
    "PoolSize": 128,
    "EnableHealthChecks": true,
    "HealthCheckInterval": 5
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyForJWTTokenGenerationMustBeAtLeast32CharactersLong",
    "Issuer": "SmartLunch-API",
    "Audience": "SmartLunch-Users",
    "TokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "smartlunch-backend-service",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": true
  },
  "Firebase": {
    "ConfigPath": "smartlunch-2b5a7-firebase-adminsdk-fbsvc-93e6045e22.json",
    "ProjectId": "smartlunch-2b5a7",
    "StorageBucket": ""
  },
  "Media": {
    "SignedUrlExpireMinutes": 10,
    "DownloadUrlExpireMinutes": 15,
    "MaxImageBytes": 10485760,
    "MaxVideoBytes": 209715200
  }
}
